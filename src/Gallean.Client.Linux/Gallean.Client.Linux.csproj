<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Gallean</AssemblyName>
    <IsPublishable>$([MSBuild]::IsOSPlatform('Linux'))</IsPublishable>
    <PublishTrimmed>$(IsPublishable)</PublishTrimmed>
    <PublishAot>$(IsPublishable)</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gallean.Client\Gallean.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <Import Project="..\..\Publish.targets" />

</Project>
