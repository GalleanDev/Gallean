    },
    {
      "NO_SCEN": "S212SC0000",
      "ID_OBJECT": "S212EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Advisor \n\u0022In order to spread the word of the Highfather over these lands. We must rid ourselves of the Legions champion.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S212SC0000",
      "ID_OBJECT": "S212UN0028",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Centaur Lancer",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S212SC0000",
      "ID_OBJECT": "S212EV0005",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Emp CaptureNisseland",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S212SC0000",
      "ID_OBJECT": "S212EV0005",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Advisor \n\u0022We must prepare for battle and be rid of these miscreants!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S212SC0000",
      "ID_OBJECT": "S212EV0009",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Leg Intro",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S212SC0000",
      "ID_OBJECT": "S212EV0009",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Advisor \n\u0022For many years the Empire have thwarted our ambitions. They shall fall, for on this day the Legions Of The Damned will be triumphant!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S212SC0000",
      "ID_OBJECT": "S212EV000a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Loc Elves\u0027 Moribund",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S212SC0000",
      "ID_OBJECT": "S212EV000a",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Advisor \n\u0022This place is strangely quiet... Tales have been told of ancient Elves entering this place, and never returning...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S212SC0000",
      "ID_OBJECT": "S212EV000a",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Advisor \n\u0022The dead are rising from the ground!\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S212SC0000",
      "ID_OBJECT": "S212UN002e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Centaur Lancer",
