    {
      "NO_SCEN": "S212SC0000",
      "ID_OBJECT": "S212EV0025",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Advisor \n\u0022Go on search the lands for any weapon that will press our advantage over our enemies!.\u0022",
      "SEQ_NUM": 0
