      "NO_SCEN": "S212SC0000",
      "ID_OBJECT": "S212EV001f",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Forest Elf   \n\u0022Even if my Elven kin won\u0027t talk to you, I\u0027 ll still sell to you.\u0022",
