    },
    {
      "NO_SCEN": "S212SC0000",
      "ID_OBJECT": "S212EV0010",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Leg Capture Kanna",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S212SC0000",
      "ID_OBJECT": "S212EV0010",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "City Inhabitants \n\u0022Finally you have come to rescue us! We will forever worship you as our true Master!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S212SC0000",
      "ID_OBJECT": "S212UN0035",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Forest Elf",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S212SC0000",
      "ID_OBJECT": "S212EV0013",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Emp Loc Dullahan",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S212SC0000",
      "ID_OBJECT": "S212EV0013",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Advisor \n\u0022Be prepared at all times. We cannot afford to be weak even for a moment. The Legions Of The Damned will capitalize in an instant.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S212SC0000",
      "ID_OBJECT": "S212UN0039",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Centaur Lancer",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S212SC0000",
      "ID_OBJECT": "S212EV0017",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Emp Forest Warning",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S212SC0000",
      "ID_OBJECT": "S212EV0017",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Advisor \n\u0022During the invasions a number of traps were set. Proceed with caution.\u0022",
