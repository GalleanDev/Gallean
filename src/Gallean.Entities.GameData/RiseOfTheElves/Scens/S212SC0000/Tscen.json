    {
      "NO_SCEN": "S212SC0000",
      "ID_OBJECT": "S212EV0026",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Witch \n\u0022The city of Kanna will never be oppressed by Empire forces... We will fight this invasion!\u0022\u0001",
      "SEQ_NUM": 0
