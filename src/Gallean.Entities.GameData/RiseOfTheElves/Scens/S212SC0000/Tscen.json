    {
      "NO_SCEN": "S212SC0000",
      "ID_OBJECT": "S212EV0029",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Advisor \n\u0022The city of Dullahan is ahead, Master. The heavy fortifications on the city will not stop us. We will plan our strategy and then conquer the city.\u0022",
