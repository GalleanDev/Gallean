    {
      "NO_SCEN": "S212SC0000",
      "ID_OBJECT": "S212EV002b",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Advisor \n\u0022We must use this artifact to our advantage and not let it fall into the hands of the Legions Of The Damned!\u0022",
