    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211SI0001",
      "ID_STRING": "TXT_TITLE",
      "TEXT": "Mithikor\u0027s Shop",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211SI0001",
      "ID_STRING": "TXT_DESC",
      "TEXT": "You look like you want to buy something and I most certainly am the man to sell it to you.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211SI0002",
      "ID_STRING": "TXT_TITLE",
      "TEXT": "Kigger\u0027s Camp",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211SI0002",
      "ID_STRING": "TXT_DESC",
      "TEXT": "I can summon air elementals for you and if you are wealthy enough you may hire one of my students?",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211PL0000",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Neutrals",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211PL0000",
