      "TEXT": "Kraken",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211UN0024",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Mithikor",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211EV0001",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Empire help",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Mithikor \n\u0022I have just arrived from our far away land and I bring items that will help us fight the demons!\u0022",
      "SEQ_NUM": 5
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211EV0002",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Intro Empire",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211EV0002",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Advisor \n\u0022Good day my Lord, I must advise you that this region is plagued by a number of Rangers and Priests who have betrayed the Empire. I suggest we deal with them before we take care of the Legions so that they do not come back to sting us later.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211EV0003",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Legion help",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211EV0003",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Demon \n\u0022My veins pulse with hatred for the Empire and what it stands for. Help me have my revenge.\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211UN0027",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Mermaid",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211EV0005",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Intro Legion",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211EV0005",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Advisor \n\u0022Now is the time to fulfill the ancient prophecy and spread the reign of the demons. First, we are told we must destroy Gorgoth and Bhaarth. The traitorous demons must be slain for the prophecy to continue !\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211EV0006",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Priests dead",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211EV0006",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Priest \n\u0022The treacherous priests have paid for betraying the Highfather. Let this battle demonstrate the Empire\u0027s might!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211EV0007",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Ranger dead",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211EV0007",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Advisor \n\u0022Now that we have taken care of this..insult...to the Rangers, we might have an easier time recruiting archers...\u0022 ",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211UN002b",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Mermaid",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211EV0008",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Orc warning",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211EV0008",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Orc Scout \n\u0022Nobody enter our territory! Go back to where you belong to!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211EV000a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Tell about Living armor",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211EV000a",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Advisor \n\u0022It is said that if you take time to pray to the Highfather near ancient statues, he may aid your quest. There is a rumor that such a statue lies to the east.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211UN002e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Sea Serpent",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211EV000b",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Casting living armor",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211EV000b",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Living Armor \n\u0022I am here to serve the Highfather! The time has come to remove the Legions from his sight as well as any who would stand against him!\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211EV000d",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Dwarf city warning",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211EV000d",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Brotherhood Guard \n\u0022You have no right to occupy a city owned by the Brotherhood of the North ! We will fight until we are slain and for every fallen Brother, three more will take his place!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211UN0030",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Mermaid",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211EV000e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Dead demons",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211EV000e",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Advisor \n\u0022Here is a small token of our appreciation for killing those rebel demons. Continue to serve us well and you will be greatly rewarded!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211EV000f",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Dwarf renfort",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S211SC0000",
      "ID_OBJECT": "S211EV0010",
