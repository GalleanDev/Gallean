    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV0018",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Spectre",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV0018",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Specter \n\u0022You have trespassed upon our land and now you will be buried within it!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV0019",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Tower Guard",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV0019",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Loyal Spearman \n\u0022Come any closer and you\u0027ll walk away with a nasty scar to remember me! That\u0027s assuming you can walk away at all...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV001a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Tower II",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV001a",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Angel of Mercy \n\u0022Devil\u0027s Night will not come to pass. Order shall triumph once more against chaos. It has always been the way of things.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213UN003e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Squire",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV001c",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Rock Soldiers",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV001d",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Herald Angel",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV001d",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Angel of Mercy\n\u0022In the name of order, you shall be removed from this city!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV001e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "MC Winning Event",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV001e",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Vithar \n\u0022Prowess has been liberated from the Angels of Mercy. We will continue to trade with Prowess as we did before. Today we shall feast and celebrate our triumphant victory! Wench, bring me some ale!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213UN0042",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Spearman",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV0020",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Hammer Hurt Em",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV0020",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Wizard \n\u0022There is a curse upon Mjornir\u0027s Hammer. Should the unworthy seek to possess the hammer, the Angels will appear and destroy the wicked. I shall protect the hammer from all those who would possess it.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV0021",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Primera Text",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV0021",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Primera Rebel \n\u0022The so called Angels Of Mercy have wrought misssery upon the very people they claim to protect! The Angles tell us that it isss our conflicting wants that are tearing Prowesss apart. We will help take down Bitter Blisss!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV0023",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Primera Text Legions",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV0023",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Primera Rebel \n\u0022Praise Devil\u0027s Night! Let the ritual begin with the destruction of Bitter Bliss! Our humanity has been stripped by those who promised to protect us! We will aid you in your quest to defeat the Angels of Mercy.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV0025",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Primerians Defense",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV0025",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Angel of Mercy \n\u0022For the peace and security of Prowess, all intruders and agressors are to be defeated. Praise the Mourning Star!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV0026",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Spearman Message",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV0026",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Messenger \n\u0022Leave! You are not welcome here!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV0027",
      "ID_STRING": "NAME_TXT",
      "TEXT": "New Event",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV0027",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Noble Knight of March Fort \n\u0022Even though we have lost this battle, our war rages onward! So long as we are under the watchful eyes of our Angels, we will prevail!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV0028",
      "ID_STRING": "NAME_TXT",
      "TEXT": "March Fort Legions",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV0028",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Noble Knight of March Fort \n\u0022Ghhhhhhuuuu...your end  is near...all of your miserable kind is doomed! Finish me off, but heed my words, blasphemous fiend... the great sanctity is waiting for you and it will end your reign of terror!\u0022 \n",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV0028",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Cultist \n\u0022Ha ha ha ha! Silence, knave! The great sanctity of which you speak shall suffer the same fate as you - a slow and painful death! Now die knowing you accomplished nothing!\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV0029",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Virago Victory Text",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV0029",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Axe Thrower \n\u0022Let it be known that the Mountain Clans will fight onward. Victory shall be ours for we are brave as we are strong.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV002a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Virago Legions",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV002a",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Duke \n\u0022Yet one more pawn has been discarded. Devils night will soon be upon us and the world will bow to our might!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV002c",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Vinusi Healing Clans",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV002c",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Tenderfoot \n\u0022My Lord, I have learned that the city of Vinusi has an unusual history. In a previous era the city was home to many mystical beings known as the Celestes. The Celestes would bury their people around the city.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV002c",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Tenderfoot \n\u0022I believe that the land around Vinusi is enchanted. We must be on the look out for some sort of land mark. There we can benefit from the Celestes healing enchantment.\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV002d",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Vinusi Legions",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV002d",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Cultist \n\u0022My Lord, I must tell you what you I have learned about this region. In a time gone by there were a group of people known as the Celestes.\u0022 \n",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV002d",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Duke \n\u0022Be silent ignorant fool I care not for your stories! To many I am the embodiment of fear. I deliver my enemies to oblivion you little one. You would be wise not to incur my wrath.\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV002d",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Cultist \n\u0022A thousand pardons my Master! I only wish to inform you that the city Vinusi was once home to the Celestes. The land is believed to be enchanted. All those who step foot upon their soil shall be healed.\u0022 \n",
      "SEQ_NUM": 2
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV002d",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Duke \n\u0022Very well little one your point is taken. Understand that my words are not to be taken lightly. Should you or anyone displease me you shall be delivered to damnation. Devils night is upon us and the world will bow down to our might!\u0022 \n",
      "SEQ_NUM": 3
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV002e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Rock Castle ML",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV002e",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Noble Knight Of Rock Castle \n\u0022 There is a Celestes burial ground north of here. The burial ground is under the watchful eye of its guardian.\u0022 \n",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV002f",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Leave This Place",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S213SC0000",
      "ID_OBJECT": "S213EV002f",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Squire \n\u0022We have been intstucted to inform you that you are not welcomed here. The state of Prowess will not do trade with the Mountian Clans any longer. Begone you have been warned.\u0022 \n",
      "SEQ_NUM": 0
    },
