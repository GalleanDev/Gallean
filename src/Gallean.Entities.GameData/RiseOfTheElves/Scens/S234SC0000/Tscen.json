      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S234SC0000",
      "ID_OBJECT": "S234PL0009",
      "ID_STRING": "DESC_TXT",
      "TEXT": "Highest lord of the dwarf lords, he is known for his intensity in battle and his courage in the face of overwhelming odds. He once fought seven days and nights against the mighty red dragon ARFURUZON to finally defeat him.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S234SC0000",
      "ID_OBJECT": "S234PL000a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Asumuel",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S234SC0000",
      "ID_OBJECT": "S234PL000a",
      "ID_STRING": "DESC_TXT",
      "TEXT": "Every child trembles at the hearing of this most infamous name. This lord of hell is known for his blood thirsts. It is said that he once ate 1000 slaves at a banquet given by Bethrezen for a victory against the kingdom of light.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S234SC0000",
      "ID_OBJECT": "S234PL000b",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Zythaar",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S234SC0000",
      "ID_OBJECT": "S234PL000b",
      "ID_STRING": "DESC_TXT",
      "TEXT": "Known in his times as the mightiest of all adepts of the black art, this lord was slain by the inquisitor Vorgel who ended his reign of terror. He is now resurrected as an undead with the intention to subjugate every mortal to his will.",
      "SEQ_NUM": 0
    },
