    },
    {
      "NO_SCEN": "S234SC0000",
      "ID_OBJECT": "S234EV000b",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Forest Keep Text",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S234SC0000",
      "ID_OBJECT": "S234EV000b",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Forest Elf \n\u0022The Orcs are violent creatures. They attack without reason.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S234SC0000",
      "ID_OBJECT": "S234EV000c",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Spear man says leave",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S234SC0000",
      "ID_OBJECT": "S234EV000c",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Orc  \n\u0022I smash you like the weak humans!\u0022 \n",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S234SC0000",
      "ID_OBJECT": "S234EV000e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Avonia Says Leave",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S234SC0000",
      "ID_OBJECT": "S234EV000e",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Orc \n\u0022Go away, or I will smash!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S234SC0000",
      "ID_OBJECT": "S234EV000f",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Mountain Clans Day One",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S234SC0000",
      "ID_OBJECT": "S234EV000f",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hill Giant \n\u0022Long ago, a young group of travellers were ambushed here. The bones mark their death trail.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S234SC0000",
      "ID_OBJECT": "S234EV0010",
      "ID_STRING": "NAME_TXT",
      "TEXT": "MClans Day Ten",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S234SC0000",
      "ID_OBJECT": "S234EV0010",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hill Giant \n\u0022The Orcs brute strength can weaken our front line. By having a strong front line our axe throwers will be unharmed.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S234SC0000",
      "ID_OBJECT": "S234EV0011",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Legions Day One",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S234SC0000",
      "ID_OBJECT": "S234EV0011",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ashkael \n\u0022Human bones are scattered across the land; the Empire must have been here at one time.This is the sign that the Orcs were too aggressive for the weak humans!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S234SC0000",
      "ID_OBJECT": "S234EV0012",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Legions Day 12",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S234SC0000",
      "ID_OBJECT": "S234EV0012",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Baroness \n\u0022I believe that more Orcs will appear as our Quest continues. I do not fear these green simpletons for we are mighty.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S234SC0000",
      "ID_OBJECT": "S234EV0013",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Undead Message",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S234SC0000",
      "ID_OBJECT": "S234EV0013",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ghost \n\u0022Master I sense that there are many Goblins and Orcs. They watch us now as I speak to you.\u0022 \n",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S234SC0000",
      "ID_OBJECT": "S234EV0014",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Undead Fourteen",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S234SC0000",
      "ID_OBJECT": "S234EV0014",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ghost \n\u0022I sense that we have disturbed an Orc rites of passage! The Orcs and Goblins will attack us, we must be prepared at all times.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S234SC0000",
      "ID_OBJECT": "S234EV0016",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Barbarian Message",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S234SC0000",
      "ID_OBJECT": "S234EV0016",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Orc \n\u0022Orc you must go or Orc will get mad!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S234SC0000",
      "ID_OBJECT": "S234EV0017",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Loc leave our land",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S234SC0000",
      "ID_OBJECT": "S234EV0017",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Orc \n\u0022Go you must go or I will smash you with my Mace!\u0022",
      "SEQ_NUM": 0
    },
