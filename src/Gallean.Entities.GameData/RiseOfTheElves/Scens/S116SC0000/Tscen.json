    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Dwarf \n\u0022What?! Look! The dead have arisen! It is sorcery, Milord! Sorcery!\u0022",
      "SEQ_NUM": 3
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0004",
      "ID_STRING": "NAME_TXT",
      "TEXT": "e elevil arrival",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Cultist\r\u0022You dare to disturb our experiments, ignorant Dwarves!? Leave this place or I shall invite all my friends from the graves yonder to join us!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116UN0027",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Thug",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0006",
      "ID_STRING": "NAME_TXT",
      "TEXT": "e gondor thanks",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0006",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Mage Gandor\r\u0022Welcome Dwarves! I\u0027ve had many strange visitors lately! They come to scavenge treasure in the wreckage left by the Great Wars. The interlopers are everywhere these days, beware! Take this as thanks for fighting the fiends... Visit my tower!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0007",
      "ID_STRING": "NAME_TXT",
      "TEXT": "loot elevil",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0007",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Axethrower\n\u0022I wonder what civilization made their home here? The buildings are ancient and of wonderous make... The heretics have destroyed the west wing of the hall with their revels, sire. And look, runic writings etched on the floor!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0007",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Tenderfoot\n\u0022We must find the runes before heathens discover their secrets! These scribblings are but misguided play, thank Wotan! Let us be on our way with haste, our task is urgent!\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0007",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Axethrower\n\u0022Wait! Look sire... We found this amongst the wreckage.\u0022",
      "SEQ_NUM": 2
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116UN002a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Thug",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0008",
      "ID_STRING": "NAME_TXT",
      "TEXT": "e party 1",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0008",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Engineer\n\u0022King Morok! Come Quickly! We have returned and the news we bring is not favorable...\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0008",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Engineer\r\u0022My lord, the Legions of the Damned have returned to Nevendaar! We came across your son South of here... lying dead amongst fire and burning rock! He had this Rune clenched between his fingers.\u0022",
      "SEQ_NUM": 2
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0008",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Morok\r\u0022O my son! Gymner! He lies lifeless! I wouldn\u0027t have permitted his undertaking this quest if I\u0027d known... How... did this horrible thing happen?!\u0022",
      "SEQ_NUM": 4
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0008",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Morok\r\u0022Then Gymner has failed his mission... By the use of this rune, Bethrezen should have been sealed forevermore in his mountain prison!  Please scout the area, find out what is afoot! I fear...\u0022",
      "SEQ_NUM": 5
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0009",
      "ID_STRING": "NAME_TXT",
      "TEXT": "e party 2",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0009",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Engineer\n\u0022King Morok! Come Quickly! We have returned and the news we bring is not favorable...\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0009",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Morok\r\u0022O my son! He lies lifeless! I wouldn\u0027t have permitted his undertaking this quest if I\u0027d known... How... did this horrible thing happen?!\u0022",
      "SEQ_NUM": 2
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0009",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Engineer\r\u0022My lord, the Legions of the Damned have returned to Nevendaar! We came across your son South of here... lying dead amongst fire and burning rock! He had this Rune clenched between his fingers.\u0022",
      "SEQ_NUM": 3
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0009",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Morok\r\u0022Then Gymner has failed his mission... By the use of this rune, Bethrezen should have been sealed forevermore in his mountain prison!  Please scout the area, find out what is afoot! I fear...\u0022",
      "SEQ_NUM": 5
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116UN002e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Thug",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV000c",
      "ID_STRING": "NAME_TXT",
      "TEXT": "e greenskins pit",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV000c",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Troll\r\u0022Ha Ha Ha! You think you welcome here? No!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116UN002f",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Orc",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV000d",
      "ID_STRING": "NAME_TXT",
      "TEXT": "day 1",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV000d",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Morok\n\u0022I depend on you to seek out the clans which fell during the First Great Wars... The clans Springfrost, Cragwell and Skymine lie closest, salvage the runes from the ruins of their once great cities and return them to me.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116UN0030",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116UN0031",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV000e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "day 3",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV000e",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Tenderfoot\n\u0022My Lord, how did the runes ever become lost? Will Wotan not be angry if we treat his gifts thus?\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV000e",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Dwarf\n\u0022After the Great Wars, much was lost. Whole cities were burned and Clans extinguished. We had no way to protect the runes then, but now we must show strength.\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116UN0032",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV000f",
      "ID_STRING": "NAME_TXT",
      "TEXT": "day 10",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV000f",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Engineer\r\u0022I have seen it with my own eyes! Bethrezen has escaped the mountain prison where we trapped him 10 years ago! The runic seal has been breached: your Gymner died trying to prevent this, brave soul!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0010",
      "ID_STRING": "NAME_TXT",
      "TEXT": "own Fronde",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0010",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Peasant\r\u0022Thank you for saving our city! A rogue noble sent armies to make us accept his rule. He took everything from us, anything that could help his campaign...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116UN0033",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Squire",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0011",
      "ID_STRING": "NAME_TXT",
      "TEXT": "own Fichdaer",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0011",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Peasant\n\u0022Many thanks for bringing order to our city. Perhaps now we can live in peace... A noble called Hubert de Lalye had forbidden communications with the Empire, forcing us to live under his immoral law. We could not contact the Emperor for help!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116UN0034",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116UN0035",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0012",
      "ID_STRING": "NAME_TXT",
      "TEXT": "loot samur",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0012",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Dwarf\r\u0022I see that this was never a Clan city, my liege. It seems to be a minor fortification used by the Empire at some time or another, now abandoned.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0012",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Axethrower\r\u0022Yes, the goblins who took over the ruin didn\u0027t have any use for these I see...\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116UN0036",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0013",
      "ID_STRING": "NAME_TXT",
      "TEXT": "loot cragwell",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0013",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "King\u0027s Guard\r\u0022See the crest above the entrance? The Bear can be seen faintly... The Cragwell Clan was once very powerful. They were fearsome warriors, and the first conquered in the Wars. The Undead Hordes wisely felled the strongest clan first!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0013",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Dwarf\r\u0022We found it! Fregga\u0027s Healing Rune is ours once more! Morok and Wotan both will be pleased! Who will return it to the Loremasters at the capital?!\u0022",
      "SEQ_NUM": 2
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116UN0037",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Peasant",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116UN0038",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0015",
      "ID_STRING": "NAME_TXT",
      "TEXT": "loot springfrost",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0015",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Dwarf\r\u0022Springfrost guarded Aurva\u0027s Rune of Potency, which was once used in magical practices to preserve the vigor of the Clans...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0015",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Tenderfoot\r\u0022The rune is here! It was housed in what I believe was a shrine. Engineer, take it to the capital at once! Morok will be pleased!\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S116SC0000",
      "ID_OBJECT": "S116EV0016",
      "ID_STRING": "NAME_TXT",
      "TEXT": "e one more 1 - skymine",
      "SEQ_NUM": 0
    },
    {
