      "TEXT": "Mystash Text",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S227SC0000",
      "ID_OBJECT": "S227EV0008",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Citizen of Mystash \n\u0022Thank you for liberating us from Wynfeld. Prince Daxam has bought his men the best equipment in the land.  With his incredible wealth, he has also secured an unseen weapon. Nobody knows what it is, but we\u0027re all frightened...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S227SC0000",
      "ID_OBJECT": "S227EV0009",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Rotting Damn",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S227SC0000",
      "ID_OBJECT": "S227EV0009",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Mage \n\u0022Prince Daxam wealth reaches across the entire state and beyond. The Prince has managed to acquire a White Dragon from a travelling merchant. The Dragon\u0027s resistance is low but its breathe is stronger than any other of its kind.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S227SC0000",
      "ID_OBJECT": "S227EV000a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Rotting Damn Message Two",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S227SC0000",
      "ID_OBJECT": "S227EV000a",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Squire \n\u0022Death to the Legions! Prince Daxam\u0027s army is now backed by a beast unmatched by his brethren. I will raise a glass to your corpses after it removes you from this world!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S227SC0000",
      "ID_OBJECT": "S227UN002d",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Orc",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S227SC0000",
      "ID_OBJECT": "S227UN002e",
