    },
    {
      "NO_SCEN": "S227SC0000",
      "ID_OBJECT": "S227EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Phonycian Insurrectionist \n\u0022Phonycians, the misfits of Bythazar, shall raid the kingdom. When we do, no one shall be safe as we spread our...message...to their homes and families!\u0022",
