    },
    {
      "NO_SCEN": "S254SC0000",
      "ID_OBJECT": "S254EV002a",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Advisor \n\u0022The Eye!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S254SC0000",
      "ID_OBJECT": "S254UN004e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Elf Guard",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S254SC0000",
      "ID_OBJECT": "S254EV002b",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Loot Grubbery Empire",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S254SC0000",
      "ID_OBJECT": "S254EV002b",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Advisor \n\u0022We must bring the Eye to Vaglan before the Legions attempt to steal it from us. He said to meet him in front of his mountain hideout, within the Legions territories.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S254SC0000",
      "ID_OBJECT": "S254EV002c",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Loot Grubbery Legions",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S254SC0000",
      "ID_OBJECT": "S254EV002c",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Advisor \n\u0022Finally, we have it! Now, all we have to do is meet Vaglan in front of his mountain hideout, and then escort him to our capital. The pitiful Empire doesn\u0027t stand a chance!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S254SC0000",
      "ID_OBJECT": "S254EV002d",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Emp Loc Taura",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S254SC0000",
      "ID_OBJECT": "S254EV002d",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Advisor \n\u0022The city of Taura is ahead. It is a small Elven town and will not pose much a threat to our experienced troops.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S254SC0000",
      "ID_OBJECT": "S254EV002e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Leg Loc Taura",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S254SC0000",
      "ID_OBJECT": "S254EV002e",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Advisor \n\u0022This is the city of Taura, master. We have been waiting for years to capture it, as its citizens have raiding our lands for some time. Now they will feel our wrath!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S254SC0000",
      "ID_OBJECT": "S254EV002f",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Leg Loc Grubbery",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S254SC0000",
      "ID_OBJECT": "S254EV002f",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Elf \n\u0022Do not dare to come any closer, demons! The Grubbery will be defended with all our might if you dare enter!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S254SC0000",
      "ID_OBJECT": "S254EV0030",
