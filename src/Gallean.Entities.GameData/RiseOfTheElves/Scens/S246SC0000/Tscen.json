      "TEXT": "Defeat the Kraken ",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S246SC0000",
      "ID_OBJECT": "S246EV0007",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "\u0022If we defeat this foul sea creature we will be rewarded.  The monster holds a ring that will give us treasure if we bring it to the volcanic earth rift!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S246SC0000",
      "ID_OBJECT": "S246EV0009",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Undead Knights ",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S246SC0000",
      "ID_OBJECT": "S246EV000a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Healing ",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S246SC0000",
