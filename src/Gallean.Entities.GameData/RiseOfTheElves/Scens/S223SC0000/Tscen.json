      "TEXT": "Thorne",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223UN0010",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Thug Guard",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223UN0011",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Thug",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223EV0000",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Thug Guard",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223EV0000",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Thug Guard \n\u0022You expect to stroll right through our domain unchallenged?!\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223UN0023",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Orc Champion",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223EV0001",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Objective Undead",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223EV0002",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Objective Elves",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223EV0003",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Begin Elf",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223EV0003",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ruthllak \n\u0022Milord! We have information about the whereabouts of Mortis\u0027 cult. They have found a way to enslave the Greenskins.\u0022\r \n",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223EV0003",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Oracle \n\u0022Treacherous Dark Elves! What are they doing? What business do they have with the Greenskins?\u0022\r \n",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223EV0003",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ruthllak \n\u0022We can\u0027t allow this...I will send out the scouts at once! We must not allow this filth to reach our forests.\u0022\r \n",
      "SEQ_NUM": 2
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223EV0004",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Begin Undead",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Zombie \n\u0022Euuuuuuuuuuughhhhhhhhh\u2026\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Shr\u0027ullen \n\u0022Who let that stupid zombie in here?!? We have no time to deal with this! Destroy it\u2026\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Vampire \n\u0022Yes, Shr\u0027ullen.\u0022\r \n",
      "SEQ_NUM": 2
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Shr\u0027ullen \n\u0022Those treacherous Dark Elves! How could they turn their backs on Mortis? What are they trying to achieve?\u0022",
      "SEQ_NUM": 3
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Shr\u0027ullen \n\u0022Send out the troops! Their purpose is of no interest to us. Mortis would like us to clean up her...indiscretions.\u0022\r \n",
      "SEQ_NUM": 4
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223EV0005",
      "ID_STRING": "NAME_TXT",
      "TEXT": "T 11 Dark Elf Message",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223EV0005",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Dark Elf \n\u0022You have not seen the Beast\u0027s power...If you attempt to stop us, you will be destroyed. Gallean\u0027s Beast will live again!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223EV0006",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Near Ruin Spell",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223EV0006",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Dark Elf \n\u0022You have made a grave mistake coming here. Our god\u0027s revival will not be prevented by you!\u0022\r \n",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223EV0006",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "\u0022Beware!\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223EV0007",
      "ID_STRING": "NAME_TXT",
      "TEXT": "T 11 Elf Reply",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223EV0007",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ruthllak \n\u0022Those disgusting Dark Elves! They are trying to bring the abomination back - they are trying to revive Gallean\u0027s Beast!\u0022 \r \n",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223EV0007",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Oracle \n\u0022They must be stopped, Ruthllak! Gallean would not want this!\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223EV0007",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ruthllak \n\u0022It will be done! We must destroy all  the Dark Elves in the region! The Greenskins will fall soon after...\u0022",
      "SEQ_NUM": 2
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223UN002c",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Ogre",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223EV0009",
      "ID_STRING": "NAME_TXT",
      "TEXT": "T 11 Undead reply",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223EV0009",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Shr\u0027ullen \n\u0022Gallean\u0027s Beast?!? How dare they worship such a thing? Betraying Mortis for Gallean\u0027s crumbs\u2026\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223EV0009",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Vampire \n\u0022What must be done, Shr\u0027ullen?\u0022\r \n",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223EV0009",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Shr\u0027ullen \n\u0022Mortis wants them destroyed. What are you waiting for? Begone!\u0022",
      "SEQ_NUM": 2
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223EV0009",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Vampire \n\u0022Yes, Shr\u0027ullen...\u0022",
      "SEQ_NUM": 3
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223UN002e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Orc",
