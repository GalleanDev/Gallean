    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223PL0001",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Zythaar",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223PL0001",
      "ID_STRING": "DESC_TXT",
      "TEXT": "Known in his times as the mightiest of all adepts of the black art, this lord was slain by the inquisitor Vorgel who ended his reign of terror. He is now resurrected as an undead with the intention to subjugate every mortal to his will.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223PL0002",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Thorne",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223PL0002",
      "ID_STRING": "DESC_TXT",
      "TEXT": "A veteran in the struggle to reclaim Elven glory, nobody enters the forest without his knowledge.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223UN0001",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Pradesh",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S223SC0000",
      "ID_OBJECT": "S223UN0003",
