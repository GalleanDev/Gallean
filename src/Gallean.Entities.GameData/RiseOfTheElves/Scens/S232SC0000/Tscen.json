      "TEXT": "Thom\u0027s Slave Market",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S232SC0000",
      "ID_OBJECT": "S232SI0002",
      "ID_STRING": "TXT_DESC",
      "TEXT": "Taken fresh and young just for you! They are yours to treat as you please for a price! NO refunds...",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S232SC0000",
      "ID_OBJECT": "S232PL0000",
