      "NO_SCEN": "S235SC0000",
      "ID_OBJECT": "S235EV0016",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Orc \n\u0022Orc you must go or Orc will get mad!\u0022",
      "SEQ_NUM": 0
