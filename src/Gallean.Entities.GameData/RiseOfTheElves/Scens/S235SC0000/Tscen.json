    {
      "NO_SCEN": "S235SC0000",
      "ID_OBJECT": "S235EV0017",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Orc \n\u0022Go you must go or I will smash you with my Mace!\u0022",
      "SEQ_NUM": 0
