      "TEXT": "Mclans Spawn ",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S259SC0000",
      "ID_OBJECT": "S259EV0005",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Dwarf King \n\u0022Heed my word! The Mountain Clans will fight on! Go my warrior and make your Dwarf King proud!\u0022 \n \n",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S259SC0000",
