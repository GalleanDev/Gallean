      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221EV0010",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Shamaness \n\u0022This robbery will not go unanswered! More Barbarians will arrive!\u0022 \n",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221EV0011",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Elves Day 1 ",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221EV0011",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Elf Lord Archon  \n\u0022The Grystrom Elves must join the Alliance. I fear that they do not trust us. The only way for us to win them over is to end this battle once and for all. We must find the holy artifact and return it to the magical well!\u0022  \n",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221UN0034",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Cultist",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221EV0012",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Elf Threaten ",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221EV0012",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Death \n\u0022Little Elves! Have you not forgotten the destruction that we have delivered upon your kind! Gallean\u0027s children will once again suffer! From realm to realm we have tortured little Elves and this Alliance will be no different!\u0022 \n",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221EV0013",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Demon Is Coming ",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221EV0013",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Demon \n\u0022The precious Holy Artifact! This Artifact shall be mine! Grystrom Realm will burn! This war for the Artifact has a new force to fear!\u0022 \n \n",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221UN0036",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Cultist",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221EV0014",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Undead Day 1 ",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221EV0014",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Death Knight \n\u0022The Holy Artifact must be ours! We will find this artifact and return it to the well and claim its power as our own! If you see any Elves be sure to make them suffer. That miserable Alliance will be a failure yet!\u0022 \n",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221EV0015",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Undead Threat ",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221EV0015",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Elf Lord Archon \n\u0022The Elven Alliance will see to your defeat foul creature! We have not forgotten how the Undead Hordes have tortured so many of our kind. By the strength of Gallean we will see to it that Mortis and the Undead Hordes are defeated!\u0022 \n \n",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221UN0038",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Cultist",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221EV0016",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Undead Healing Message ",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221EV0016",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "\u0022The magic from the well must be out of control. This area will heal our weak! No need anymore to slaughter the weak. There may be more magical areas to exploit! Now lets us find this artifact and claim this realm in the name of the Hordes!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221EV0017",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Elves Healing Message ",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221EV0017",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "\u0022The magical well must be responsible for this. There is much magic in this realm. The magic in this area will heal our battered and needy. We must use it wisely. Be on the look out. There may be other areas of magic. Victory for the Alliance!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221EV0018",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Legions Message ",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221EV0018",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Duke \n\u0022Fighting against us is useless! We will never stop! The artifact will be ours to use to raise and control the dead!\u0022 \n",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221UN003c",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Orc",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221EV0019",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Citymessage Grysborg",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221EV0019",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Adept \n\u0022The Barbarians will never let you leave with the artifact! They will hunt you down!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221EV001a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "city message Asmara ",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221EV001a",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Orc \n\u0022Vengeance! Orcs will fight forever!\u0022 \n",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221UN003e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Orc",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221EV001b",
      "ID_STRING": "NAME_TXT",
      "TEXT": "city message\u002Bgrystrent ",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221EV001b",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "\u0022The Barbarians have the artifact in a northern tower! We must get there quickly!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221UN0040",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Thorne",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221EV001d",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Shaman_Undead ",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S221SC0000",
      "ID_OBJECT": "S221EV001d",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "\u0022The Holy Artifact is mine! Off to the Magical Well!\u0022",
      "SEQ_NUM": 0
