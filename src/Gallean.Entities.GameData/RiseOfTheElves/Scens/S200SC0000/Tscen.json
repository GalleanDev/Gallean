    },
    {
      "NO_SCEN": "S200SC0000",
      "ID_OBJECT": "S200EV0007",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "\u0022Our city will not remain in the hands of the Elven Alliance for very long!\u0022",
      "SEQ_NUM": 1
