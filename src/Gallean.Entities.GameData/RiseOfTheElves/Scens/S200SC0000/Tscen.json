      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S200SC0000",
      "ID_OBJECT": "S200EV0005",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Centaur Charger \n\u0022Halt! The Elven Alliance is not welcomed here. I am on a mission of peace. Despite our differences I am willing to give you a chance to leave once and for all. Now go before I am forced to strike you down!\u0022 \n",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S200SC0000",
      "ID_OBJECT": "S200EV0006",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Undead-GFC threat ",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S200SC0000",
      "ID_OBJECT": "S200EV0006",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Centaur Charger \n\u0022Evil creature of the night! We know what you have done to the Dark Elves. Great Gallean shall punish you!\u0022 \n",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S200SC0000",
      "ID_OBJECT": "S200EV0007",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Elves_Rotturdam",
