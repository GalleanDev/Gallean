      "TEXT": "Ildest",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S203SC0000",
      "ID_OBJECT": "S203PL0002",
      "ID_STRING": "DESC_TXT",
      "TEXT": "A veteran in the struggle to reclaim Elven glory, nobody enters the forest without his knowledge.",
