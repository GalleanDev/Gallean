      "TEXT": "Orc",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S247SC0000",
      "ID_OBJECT": "S247EV0000",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Elves Dragon ",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S247SC0000",
      "ID_OBJECT": "S247EV0000",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Centaur Lancer \n\u0022Our party has returned. At great expense and sacrifice they have brought back a Dragon! This powerful beast will be a great weapon to use against our enemies.\u0022 \n",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S247SC0000",
      "ID_OBJECT": "S247UN0023",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Orc",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S247SC0000",
      "ID_OBJECT": "S247EV0001",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Legions Dragon ",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S247SC0000",
      "ID_OBJECT": "S247EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Succubus \n\u0022My Liege, at great expense we have manage to complete the Quest. We have brought back and tamed a great Dragon. This magnificent creature will help us eradicate the realm!\u0022 \n",
      "SEQ_NUM": 0
    },
