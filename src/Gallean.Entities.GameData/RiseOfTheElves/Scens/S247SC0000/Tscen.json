    {
      "NO_SCEN": "S247SC0000",
      "ID_OBJECT": "S247PL0001",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Baalhu",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S247SC0000",
      "ID_OBJECT": "S247PL0001",
      "ID_STRING": "DESC_TXT",
      "TEXT": "Every child trembles at the hearing of this most infamous name. This lord of hell is known for his blood thirsts. It is said that he once ate 1000 slaves at a banquet given by Bethrezen for a victory against the kingdom of light.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S247SC0000",
      "ID_OBJECT": "S247PL0002",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Thorne",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S247SC0000",
      "ID_OBJECT": "S247PL0002",
      "ID_STRING": "DESC_TXT",
      "TEXT": "A veteran in the struggle to reclaim Elven glory, nobody enters the forest without his knowledge.",
      "SEQ_NUM": 0
    },
    {
