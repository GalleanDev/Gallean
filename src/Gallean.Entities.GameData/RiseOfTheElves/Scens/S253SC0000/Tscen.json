      "TEXT": "Goar",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S253SC0000",
      "ID_OBJECT": "S253PL0009",
      "ID_STRING": "DESC_TXT",
      "TEXT": "In his youth, this mighty lord once stood fast against an army from hell and single-handedly defeated them by sealing the gateway that spew them. He then became sovereign of his realm.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S253SC0000",
      "ID_OBJECT": "S253UN0001",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Jagare",
      "SEQ_NUM": 0
    },
    {
