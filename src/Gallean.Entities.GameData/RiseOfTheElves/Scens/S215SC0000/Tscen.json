      "NO_SCEN": "S215SC0000",
      "ID_OBJECT": "S215EV002f",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Drega Zul \n\u0022I understand now, my Krath\u0027du... it is our destiny to be together.\u0022",
