      "TEXT": "Orc Reward",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0016",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Orc \n\u0022GHOOOOAAR! Orc...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0016",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Orc \n\u0022Brother back. We give ghyou help... Look in big city for treasure...\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0016",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Orc \n\u0022We like hot-skins. We help you...\u0022",
