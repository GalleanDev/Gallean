    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000b",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Destroy Cultists",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000b",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Pandemoneus \n\u0022We have destroyed the summoning circle, Master. The demons will spawn no more...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000c",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Destroy Demonol",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000c",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Pandemoneus \n\u0022We have destroyed the summoning circle, Master. The demons will spawn no more...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000d",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Water Warning",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000d",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Counselor \n\u0022Be cautious, Master... The seas here are controlled by sea-witches. They prey upon anything which enters their realm.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Asteroth T2",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000f",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Situation zone",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000f",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Duke \n\u0022The Empire has joined Asteroth\u0027s cause! They have concluded some kind of alliance! It seems that Uther has bewitched the Empire. Hubert de Lalye is probably behind this...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0032",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Cultist",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0010",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Asteroth Near",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0010",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Asteroth \n\u0022Another mistake mortal... I will destroy you myself! Bethrezen\u0027s reign has past...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0034",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Cultist",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0011",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Onyx Move T15",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0012",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Win Quest",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0012",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Asteroth \n\u0022Ghhhooarrr! You are fortunate to have escaped my wrath, Demons! But I cannot be destroyed...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0012",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Demonologist \n\u0022Asteroth has disappeared in a burst of flame! He has fled! But, we are  victorious...\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0036",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Ogre",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0014",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Asteroth T40",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0014",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Asteroth \n\u0022Cowards! I will destroy you myself... You will regret your treasonous acts!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0015",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Orc Quest",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0015",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Orc \n\u0022Hot-skin... We ask help... Orc brother lost... You help us?\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0015",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Duke \n\u0022What do you need from us?\u0022",
      "SEQ_NUM": 2
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0015",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Orc \n\u0022Bring Orc here... We give something for ghyou...\u0022",
      "SEQ_NUM": 4
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0039",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Imperial Assassin",
