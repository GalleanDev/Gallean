    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0000",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar T1",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0000",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar the Traveler\n\u0022Greetings Milord! Glad to see you made it safely. The Inquisitor Philip d\u0027Agincourt is waiting for you in the city of Fhindar up North. I will guide you...\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0023",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Spearman",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0001",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar T2",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar the Traveler \n \u0022Beware! These rivers are inhabited by sea-witches who prey upon unwary travelers! Do not stay in the water!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0024",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0002",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar Dead",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0025",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0026",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0003",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar Middle 1",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0003",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Spearman\n\u0022Sorry Nobar... Except you, none can pass here. Philip\u0027s orders!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0027",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0004",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar Middle 2",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Spearman \n\u0022Greetings, Nobar. Else than you, none can pass here. Those are Philip d\u0027Agincourt\u0027s orders...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0005",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Spider Roam T10",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0028",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0029",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0007",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Hubert\u0027s Army T30",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0007",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hubert de Lalye\n\u0022Did you like my silky friends? You should have joined me like the others... Now you will die, and Fhindar will be mine! Ha ha aha ha... \u0022",
      "SEQ_NUM": 3
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0007",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ranger \n\u0022Master, we must stop Hubert de Lalye before he captures the city of Fhindar!\u0022",
      "SEQ_NUM": 5
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0007",
      "ID_STRING": "OBJECT_TXT",
      "TEXT": "Destroy Hubert de Lalye before he captures the city of Fhindar. Uther must not die.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0008",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Spiders Roam T20",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0008",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ranger\n\u0022Something is driving the Spiders out of their lair! Our scouts saw smoke coming out of the Silk Forest... Who could have done such a thing?\u0022",
      "SEQ_NUM": 5
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0009",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Uther Arrive T33",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0009",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Uther\n\u0022I will cleanse the Empire  of your filthy kind, Hubert de Lalye! Prepare yourself to die... I will restore the Empire to its rightful owner!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0009",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hubert de Lalye \n\u0022A boy?! Ha ha ha! Is that all the Empire has for protection! Demosthene is a coward...\u0022",
      "SEQ_NUM": 4
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN002c",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Spearman",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Silk Wood warning",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000a",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar the Traveler\n\u0022The woods below are called the Silk Woods. Few venture near, for they fear the fierce creatures which lurk there...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN002d",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN002e",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000c",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Enter Fhindar",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000c",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar the Traveler\n\u0022Fhindar is near! You must go West. There is more than one passage leading to it...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN002f",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Spearman",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000d",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar T5",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000d",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar the Traveler\n\u0022Philip d\u0027Agincourt is very cautious... He blocked all the passages to Fhindar. I hope he will let you pass!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0030",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0031",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Spearman low dies",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0032",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000f",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Spearman high dies",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0010",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Win Q (Kill Hubert)",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0010",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hubert de Lalye\n\u0022You... you... defeated me! How is that possible? Curse you, Uther!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0010",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Uther \n\u0022All the enemies of the Empire will suffer the same fate. I will help my father restore peace to the realm of Nevendaar!\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0034",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Polar Bear",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0011",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Hubert Wins",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0011",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hubert de Lalye\n\u0022Ha ha ha! Now that I possess the city of Fhindar, you can never resist me... Uther\u0027s arrival was of no consequence!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0012",
      "ID_STRING": "NAME_TXT",
      "TEXT": "City Khazan Keep text",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0012",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Archer\n\u0022Many fishermen have disappeared at sea... The peasants think that they were devoured by sea creatures!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0036",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Mermaid",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0013",
      "ID_STRING": "NAME_TXT",
      "TEXT": "City Silveria Text",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0013",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Spearman\n\u0022Fhindar is a bit further North. We hope the Emperor wins this war... Hubert has sent militia to secure all the cities on these lands!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0014",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Lofemyr Move T8",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0037",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0038",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0017",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar T30",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0017",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar the Traveler\n\u0022Philip d\u0027Agincourt has trapped you! This was all a trick, beware Milord...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN003a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Kraken",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0018",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Uther Dies",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0018",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Cleric\n\u0022What have we done? Uther, the Emperor\u0027s lost son has died! The Empire is now doomed!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0019",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Fhindar Area",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
