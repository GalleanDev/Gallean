    {
      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV000e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Clans Wizard Warning",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV000e",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Walos \n\u0022Greetings, err...friends! The Empire has received your message and we are here in the name of the Highfather and all that nonsense. Lead on, we shall cover the trail behind you. Why do you hesitate? I said move!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV000f",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Clans Kill Walos",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV000f",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Daeron \n\u0022I can sense it...the Humans were possessed! We cannot assume that the message ever reached the Empire now!\u0022",
      "SEQ_NUM": 0
