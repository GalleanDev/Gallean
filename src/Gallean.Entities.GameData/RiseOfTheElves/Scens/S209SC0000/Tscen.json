    {
      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV0016",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Clans Day 4",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV0016",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Frug Brenstout \n\u0022I leave now, Sire, with a message for the Humans. We\u0027ll be needing all the manpower we can get if we\u0027re to succeed. If we do not cross paths again, \u0027tis sure we will on the other side.  May Wotan guide your blades!\u0022",
      "SEQ_NUM": 0
