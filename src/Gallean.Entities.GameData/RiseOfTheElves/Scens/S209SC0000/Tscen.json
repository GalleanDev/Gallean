      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV0018",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Scout \n\u0022Egh...can you smell it? Where have my people gone? Something is not right here...\u0022",
