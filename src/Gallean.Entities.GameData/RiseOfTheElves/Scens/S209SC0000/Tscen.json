    {
      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Amzin \n\u0022Retreat! Back into the Maw!\u0022",
      "SEQ_NUM": 1
