      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV0010",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Legions Kill Walos",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV0010",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Amzin \n\u0022Buffoons! I told you not to touch Walos! You\u0027ve spoiled a brilliant trap!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV0011",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Elfnapping",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV0011",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Master Thug \n\u0022Ah, yes. You\u0027ve brought us the legendary Norwyndar. He will bring us a nice little price! You may pass.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV0011",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Norwyndar \n\u0022I understand your reasoning, Sire. Fear not, I shall free myself from these rogues when the opportunity arises.\u0022",
      "SEQ_NUM": 5
    },
    {
      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV0013",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Thugs North",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV0013",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Master Thug \n\u0022Dwarves...bring us the Elf Norwynder and we will lower the wall to the south. The Legions will never expect you. Think about it, it\u0027s a very nice deal, sacrifice one Elf and win the war...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV0015",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Napped",
