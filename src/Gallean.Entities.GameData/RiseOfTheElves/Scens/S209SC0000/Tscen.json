      "ID_OBJECT": "S209EV000d",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Legions Wizard Warning",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV000d",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Amzin \n\u0022Do not kill this Human wizard! He is possessed by the Legions and we are using him as bait.  You may pass through this area unharmed but the Dwarves...hahaha...may not be so lucky!\u0022",
      "SEQ_NUM": 0
