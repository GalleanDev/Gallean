      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV001c",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Fighter \n\u0022Thessse wallsss will not protect you from Mortisss. She will taste your fleshhh...\u0022",
