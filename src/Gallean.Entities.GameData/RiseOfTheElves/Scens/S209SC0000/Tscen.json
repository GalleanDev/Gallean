    {
      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV001b",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hermit \n\u0022What makes you think you can simply take whatever resources suit your needs? This is our mine; our people live within its walls. Leave us be.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S209SC0000",
