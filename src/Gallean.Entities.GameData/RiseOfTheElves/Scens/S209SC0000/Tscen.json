    {
      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV0033",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Jonderuk",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV0033",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Jonderuk \n\u0022Ahhh...this world is so plain. And far too cold for my tastes.\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV0033",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Amzin \n\u0022Ahhh, I see we have another recruit. Don\u0027t you think your choice in hosts is a little...mangy?\u0022",
      "SEQ_NUM": 2
    },
    {
      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV0033",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Jonderuk \n\u0022The art of possession is not an easy task, sire. When I sensed a weak mind, I was eager to make the journey.\u0022",
      "SEQ_NUM": 3
    },
    {
      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV0034",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Blackeye",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV0034",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Blackeye \n\u0022We are here, master. We hunger for the death of the dwarf mystic...\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV0034",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Amzin \n\u0022Ahhh..there you are, my unholy triplets. I was wondering when you\u0027d be joining us. I trust the possession was extremely painful?\u0022",
      "SEQ_NUM": 2
    },
    {
      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV0034",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Blackeye \n\u0022Deliciously so, master.\u0022",
      "SEQ_NUM": 3
    },
    {
      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV0035",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Protect",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV0036",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Empire Arrives",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV0036",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Lodrimoore \n\u0022I fear we may be too late, but the Empire is ready to fight back the demons! Hang on lads, we\u0027ll stand by you shortly!\u0022",
      "SEQ_NUM": 1
