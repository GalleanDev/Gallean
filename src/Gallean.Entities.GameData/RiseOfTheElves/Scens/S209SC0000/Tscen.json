      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV0017",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Clans Eldrooke",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S209SC0000",
      "ID_OBJECT": "S209EV0017",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Wounded Goblin \n\u0022Please stop hurt! I tell! I tell! We take city from Elves! Elves locked up in green ruins! You not get in! No no no no no you not get in...\u0022",
