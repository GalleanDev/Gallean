    {
      "NO_SCEN": "S228SC0000",
      "ID_OBJECT": "S228EV0000",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Knight Humphrey\n\u0022We have taken over the three damned cities. Kadrath has now lost most of its power and cannot sustain the magic meeded for his guardian anymore. We must strike now my Lord!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S228SC0000",
      "ID_OBJECT": "S228EV0004",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Emp Intro chaos",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S228SC0000",
      "ID_OBJECT": "S228EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Knight Humphrey\n\u0022Since the great war, chaos and desolation have spread rapidly through realm. Thieves and Greenskins are now roaming our lost lands, abusing the law.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S228SC0000",
      "ID_OBJECT": "S228EV0005",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Emp Day 5 Trig puzzle 1",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S228SC0000",
      "ID_OBJECT": "S228EV0005",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Advisor\n\u0022Priests of the temple of Aptha believe that the Guardian of the tower gathers his power from the magical trigonal. They say that the trigonal may be formed by the three damned cities, Baphomet, Babalon and Menkhaos.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S228SC0000",
      "ID_OBJECT": "S228EV0006",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Emp Day 7 Trigl puzzle 2",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S228SC0000",
      "ID_OBJECT": "S228EV0006",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Advisor\n\u0022Only the one that controls the three sides of a trigonal can cast out the demon contained within.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S228SC0000",
      "ID_OBJECT": "S228EV0007",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Emp Loc Tower entrance",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S228SC0000",
      "ID_OBJECT": "S228EV0007",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Elf \n\u0022South of here is the entrance of Kadrath\u0027s tower. Beware, it is said that his guardian has mighty powers and that he is almost immortal.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S228SC0000",
      "ID_OBJECT": "S228EV000a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Spawn Demonologist 1",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S228SC0000",
      "ID_OBJECT": "S228EV000a",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Demonologists \n\u0022By Anthael\u0027s power, we will consume you with fire!\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S228SC0000",
      "ID_OBJECT": "S228EV000b",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Spawn Demonologist 2",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S228SC0000",
      "ID_OBJECT": "S228EV000b",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Demonologists \n\u0022You cannot resist the will of Anthael!\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S228SC0000",
      "ID_OBJECT": "S228EV000c",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Spawn Demonologist 3",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S228SC0000",
      "ID_OBJECT": "S228EV000c",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Demonologists \n\u0022Your efforts to resist us serve only to weaken you. You will be converted into servants of Anthael!\u0022",
