    {
      "NO_SCEN": "S255SC0000",
      "ID_OBJECT": "S255EV000a",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Advisor \n\u0022Milord, there is a foul stench coming from the tower, and Zombies crawling the grounds... Some unusual necromancy must be taking place there!\u0022",
      "SEQ_NUM": 0
