    {
      "NO_SCEN": "S255SC0000",
      "ID_OBJECT": "S255EV0015",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Dwarves\r\u0022Don\u0027t think you can win this! We\u0027ll fight to the bitter end! Our troops will be back soon to liberate us!\u0022\r \n",
