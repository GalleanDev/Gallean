    {
      "NO_SCEN": "S255SC0000",
      "ID_OBJECT": "S255EV000b",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Advisor \n\u0022Master, our control over the land is slipping... many necromancer lords have started their own cults around the city. They must be punished by our might!\u0022",
