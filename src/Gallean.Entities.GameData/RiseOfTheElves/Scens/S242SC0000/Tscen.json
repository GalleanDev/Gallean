      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S242SC0000",
      "ID_OBJECT": "S242EV0002",
      "ID_STRING": "NAME_TXT",
      "TEXT": "MC Capture Kwelia",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S242SC0000",
      "ID_OBJECT": "S242EV0002",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Clan Arhigos\r\u0022Our Clan wishes to live in peace, why can\u0027t you let us be? We don\u0027t want anything to do with your kind!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S242SC0000",
      "ID_OBJECT": "S242EV0003",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Emp Capture Kwelia",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S242SC0000",
      "ID_OBJECT": "S242EV0003",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Clan Arhigos\r\u0022Our Clan posed no threat to you! Why have you come here and taken our village from us?\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S242SC0000",
      "ID_OBJECT": "S242EV0004",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Emp Capture Dimmel",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S242SC0000",
      "ID_OBJECT": "S242EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Advisor \n\u0022Careful Milord, the creatures of the Undead often attack Dimmel.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S242SC0000",
      "ID_OBJECT": "S242EV0006",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Capture Confluence",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S242SC0000",
      "ID_OBJECT": "S242EV0006",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Zombie \n\u0022Bastel Royas will make you pay for this!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S242SC0000",
      "ID_OBJECT": "S242EV0007",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Capture Tesley",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S242SC0000",
      "ID_OBJECT": "S242EV0007",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Captured Barbarians\r\u0022Our southern cousins tell us the Vampire Bastel Royas is hiding in a mountain fortress somewhere in the south. It is he you should be harassing, not us!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S242SC0000",
      "ID_OBJECT": "S242EV0009",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Capture Koulouria",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S242SC0000",
      "ID_OBJECT": "S242EV0009",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Villagers\r\u0022You have freed us! This information may help you: to the East of here, you\u0027ll find Sangleton. That is where the terrible Vampire Bastel Royas can be found!\u0022\r \n",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S242SC0000",
      "ID_OBJECT": "S242EV000d",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Emp Loc Bastel Message",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S242SC0000",
      "ID_OBJECT": "S242EV000d",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Bastel Royas\r\u0022Welcome! Allow me to introduce myself; my name is Bastel Royas, soon to be ruler of all Nevendaar. Go back, and spread this news to all that serve the Highfather!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S242SC0000",
      "ID_OBJECT": "S242EV000e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "MC Loc Bastel Message",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S242SC0000",
      "ID_OBJECT": "S242EV000e",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Bastel Royas\r\u0022Ha! You\u0027re no match for the great vampire Bastel Royas! The time has come for you to feel my wrath! Tell Wotan that he is a fool for sending your pitiful army!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S242SC0000",
      "ID_OBJECT": "S242EV000f",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Emp Cemetary",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S242SC0000",
      "ID_OBJECT": "S242EV000f",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Advisor \n\u0022Milord, we should leave this place at once... The air is impure... Thick with death...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S242SC0000",
      "ID_OBJECT": "S242EV000f",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Advisor \n\u0022The dead are rising from their graves!\u0022",
      "SEQ_NUM": 2
    },
