    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140EV001b",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "\u0022This is the Empire\u0027s fleet tender! Once we have dealt with him, it will only be a mater of time before the Empire loses Mercantile!\u0022",
