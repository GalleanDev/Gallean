    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140EV001b",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Fleet tender \n\u0022You must be the fools disrupting the Mercantile trade route. You do realize it is hopeless? Elves are no sailors, go back to your woods!\u0022",
