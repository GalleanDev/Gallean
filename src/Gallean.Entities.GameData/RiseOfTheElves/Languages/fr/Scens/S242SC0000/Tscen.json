    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0000", "ID_STRING": "NAME_TXT", "TEXT": "MC Victoire", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0002", "ID_STRING": "NAME_TXT", "TEXT": "MC Capture Kwelia", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Clan Arhigos\n\"Notre clan souhaite vivre en paix, pourquoi ne pouvez-vous pas nous laisser tranquille ? Nous ne voulons rien avoir à faire avec vous !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Emp Capture Kwelia", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Clan Arhigos\n\"Notre clan ne représentait pour vous aucun danger. Pourquoi alors avoir capturé notre village ?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Emp Capture Dimmel", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Prudence, Seigneur, les Hordes des Mort-Vivants attaquent souvent au crépuscule.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Capturer Confluence", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Zombie \n\"Bastel Royas vous fera payer ça !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Capturer Tesley", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Barbares Capturés\n\"Nos cousins du sud nous ont appris que le Vampire Bastel Royas se cachait dans une forteresse quelque part au sud. C'est lui que vous devriez harceler, pas nous !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Capturer Koulouria", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "'Villageois\n\"Vous nous avez libérés ! Cette information peut vous être utile : à l'Est d'ici, vous trouverez Sangleton. C'est là que se cache le terrible Vampire, Bastel Royas !\" \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loc Message de Bastel", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Bastel Royas\n\"Bienvenue ! Permettez-moi de me présenter, mon nom est Bastel Royas et bientôt, je régnerai sur tout Nevendaar. Allez, et répandez la nouvelle parmi tous les fidèles du Haut-Père !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV000e", "ID_STRING": "NAME_TXT", "TEXT": "MC Loc Message de Bastel", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Bastel Royas\n\"Ha ! Vous ne faites pas le poids contre le grand vampire Bastel Royas ! L'heure est venue pour vous de subir mon courroux ! Dîtes à Wotan combien il a été stupide de m'envoyer cette armée ridicule !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Emp Cimetière", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Seigneur, nous devrions quitter cet endroit... L'air y est malsain... Empli de l'odeur de la mort...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Les trépassés quittent leurs tombeaux !\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loc Royaume des Elfes", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Il n'y a rien ici qui en vaille la peine, Seigneur. Poursuivons nos recherches vers le sud.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Emp Aide des Elfes", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Centaure\n\"Aidez-nous à nous débarrasser d'Itlha, braves gens, et nous vous aiderons en retour !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001a", "ID_STRING": "NAME_TXT", "TEXT": "MC Aide des Elfes", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Centaure \n\"Aidez-nous à nous débarrasser d'Itlha, braves gens, et nous vous aiderons en retour !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Capturer Ithla", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Centaure\n\"Merci pour votre aide. Je serais heureux de me mettre à votre service après ce que vous avez fait pour les Elfes. Vous pouvez occuper Itlha aussi longtemps qu'il faudra pour débarrasser le pays de la Peste !\"\r \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Emp Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller\n\"L'invasion de la Vallée Chantelune par les Mort-Vivants a frappé les habitants tel un véritable fléau. Ceux-ci vivent dans une terreur absolue, d'autant que nombre de leurs connaissances figurent parmi les victimes de ces infâmes créatures.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Nous devons trouver la cause de cette invasion avant qu'il ne soit trop tard !\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Loc Attaque de l'Ecuyer", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Ecuyer en colère\\n\"Quittez cet endroit sur le champ. C'est un lieu de repos pour les victimes des mort-vivants. Si vous ne partez pas immédiatement, je devrai vous affronter !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Emp Capture Canouria", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Seigneur, je vous enjoins de dépenser un peu de votre richesse pour défendre cette ville. Les citoyens racontent que fréquentes sont les attaques du fléau mort-vivant.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Capturer Enthras", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Villageois\n\"Nos défenses ont été complètement décimées par les attaques constantes de la peste des Mort-Vivants !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0020", "ID_STRING": "NAME_TXT", "TEXT": "MC Capture Canouria", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Seigneur, je vous enjoins de dépenser un peu de votre richesse pour défendre cette ville. Les citoyens racontent que fréquentes sont les attaques du fléau mort-vivant.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Echoppe de Neffin", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Tout ce que je possède est à vendre.", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0022", "ID_STRING": "NAME_TXT", "TEXT": "Capturer Manris", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0022", "ID_STRING": "POPUP_TXT", "TEXT": "Mages asservis\n\"Vous devez mettre un terme à cette folie. C'est Bastel Royas qui est à l'origine de cette peste. Eliminez-le et ramenez la paix à Chantelune.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Camp de Renman", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Nous rejoindrons votre armée si vous y mettez le prix.", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Spectre de Canouria", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Camp de Metars", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Entrez ici, pleutres, et je ferai de vous des héros !", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Tour d'Ilan", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Je possède de nombreux sortilèges.", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Zombie de Kwelia", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Nécromancien de Dimmel", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Confluence Doomdrak", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0006", "ID_STRING": "TXT_TITLE", "TEXT": "Echoppe de Ralar", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0006", "ID_STRING": "TXT_DESC", "TEXT": "Mes objets sont les meilleurs de tout le royaume.", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Liche de Koularia", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Champion Squelette d'Ithla", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Fauchedragon de Manris", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002b", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Loup-garou Berserk", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Apparition du Vampire", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002d", "ID_STRING": "NAME_TXT", "TEXT": "Les Elfes attaquent le MC", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller Elfe\n\"Vous n'avez pas réussi à débarrasser cette vallée de Bastel Royas et vous ne nous avez pas restitué notre ville. Si c'est ainsi que les Clans pensent traiter avec nous, attendez-vous à en subir les conséquences.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002e", "ID_STRING": "NAME_TXT", "TEXT": "MC Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002e", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller\n\"L'invasion de la Vallée Chantelune par les Mort-Vivants a frappé les habitants tel un véritable fléau. Ceux-ci vivent dans une terreur absolue, d'autant que nombre de leurs connaissances figurent parmi les victimes de ces infâmes créatures.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002e", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Nous devons trouver la cause de cette invasion avant qu'il ne soit trop tard !\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002f", "ID_STRING": "NAME_TXT", "TEXT": "MC Capture Dimmel", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Prudence, Seigneur, les Hordes des Mort-Vivants attaquent souvent au crépuscule.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0030", "ID_STRING": "NAME_TXT", "TEXT": "MC Loc Territoire des Elfes", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0030", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Il n'y a rien ici qui en vaille la peine, Seigneur. Poursuivons nos recherches vers le sud.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0031", "ID_STRING": "NAME_TXT", "TEXT": "Emp Victoire", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0032", "ID_STRING": "NAME_TXT", "TEXT": "Loc Kendall", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0032", "ID_STRING": "POPUP_TXT", "TEXT": "Mage Kendall\n\"Je suis le mage itinérant Kendall, et je suis venu vous parler des grands vampires du Sud... C'est la mort qui règne là-bas ; vous devez y aller pour éliminer ces abominations !\"", "SEQ_NUM": 0},
