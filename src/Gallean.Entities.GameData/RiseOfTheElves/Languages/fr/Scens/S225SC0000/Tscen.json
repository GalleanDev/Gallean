    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Echoppe de Tralar", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Tout ce que je possède est à vendre.", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Camp de Righon", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Mes soldats sont les plus valeureux de la région.", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0004", "ID_STRING": "TXT_TITLE", "TEXT": "Marchandises de Gruntwort", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0004", "ID_STRING": "TXT_DESC", "TEXT": "Je suis prêt à commercer avec n'importe qui, il suffit d'y mettre le prix.", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutres", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Pas de description de race", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Calderic", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Le plus grand seigneur parmi les seigneurs Nains, il est connu pour sa rage au combat et son courage. Il s'est battu une fois sept jours et sept nuits durant contre le puissant dragon rouge ARFURUZON avant de parvenir à le vaincre.", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Gunther", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Dans sa jeunesse, ce puissant seigneur tenu bon contre une armée venue de l'enfer et l'a repoussée seul en scellant la porte qui vomissait ces créatures dans notre monde. Il est ensuite devenu souverain de notre royaume.", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Jagare", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN0017", "ID_STRING": "NAME_TXT", "TEXT": "Thalrisa", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN001a", "ID_STRING": "NAME_TXT", "TEXT": "Gobelin", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN0021", "ID_STRING": "NAME_TXT", "TEXT": "Gobelin", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN0024", "ID_STRING": "NAME_TXT", "TEXT": "Ogre", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0001", "ID_STRING": "NAME_TXT", "TEXT": "MC Tue Thalrisa", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"On dirait que le fantôme de Thalrisa protégeait l'accès à cette vallée secrète. Je n'ose imaginer quelles autres abominations tout cela peut bien cacher... \"", "SEQ_NUM": 1},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Loc Avertissement Orque", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Champion Orque\n\"Personne ne doit contrôler ces terres maudites... La Magie est maléfique !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN0026", "ID_STRING": "NAME_TXT", "TEXT": "Orque", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0003", "ID_STRING": "NAME_TXT", "TEXT": "MC Cap Runia", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Enfin avons-nous réussi à assiéger Runia. Elle avait une importance stratégique pour les Peaux-Vertes... Restons sur nos gardes, ils pourraient user de représailles.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0006", "ID_STRING": "NAME_TXT", "TEXT": "MC Histoire de Thalrisa", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Thalrisa \n\"Maintenant, je vais pouvoir me venger de ceux qui m'ont persécuté et je me débarrasserai de vous comme vous avez tenté de vous débarrasser de moi.... Même si mes pauvres Gardiens Elémentaires ont été vaincus, j'aurai ma revanche !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN002a", "ID_STRING": "NAME_TXT", "TEXT": "Ogre", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0008", "ID_STRING": "NAME_TXT", "TEXT": "MC Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Nous avons été dépêchés par le Haut-Roi pour coloniser cette vallée et y collecter d'importantes quantités de mana.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Malheureusement, les Peaux-Vertes, qui craignent la magie, ont découvert nos plans et sont bien déterminé à nous chasser de la vallée. De son côté, l'Empire souhaite revendiquer cette vallée comme faisant partie de ses terres.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Ils ont assiégé notre vallée pour nous contraindre à la reddition. Si nous voulons qu'ils se retirent, nous devons envoyer chercher du renfort auprès des Clans voisins. Le messager devra passer par l'entrée au sud-est de la vallée.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN002d", "ID_STRING": "NAME_TXT", "TEXT": "Gobelin", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Loc Piège Orque", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000b", "ID_STRING": "NAME_TXT", "TEXT": "MC Rencontre des Orques", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Champion Orque \n\"Grr ! Vous ne survivrez pas longtemps ici, sales Nains ! Nous vous avions avertis mais vous avez fait l'erreur de venir malgré tout. Vous ne repartirez pas d'ici vivants !\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000c", "ID_STRING": "NAME_TXT", "TEXT": "MC Entrée de Runia", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Garde Orque\n\"Vous envahissez cette vallée et maintenant vous pensez aussi prendre possession de nos villages ? Vous autres nains êtes bien plus stupides que nous le pensions !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Spawn1", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Activer Spawn 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Spawn2", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Loc Magie de Thalrisa", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Orque \n\"Vous êtes à la recherche du savoir magique de Thalrisa, mais nous ne vous laisserons jamais l'avoir. Vous ne ferez pas de mal aux Peaux-Vertes !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0011", "ID_STRING": "NAME_TXT", "TEXT": "MC Pillage de la Ferme Abandonnée", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Cette construction est très ancienne, Seigneur ! De toute évidence, les Peaux-Vertes peuplent cette vallée depuis maintenant fort longtemps. Mais pourquoi ? La magie ?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Entrée de la Vallée des Horreurs", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "\"Les domestiques de Thalrisa sont toujours en vie ! Ils doivent sûrement fomenter leur vengeance !\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0013", "ID_STRING": "NAME_TXT", "TEXT": "MC Pillage du Temple de Thalrisas", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Nous avons arrêté Thalrisa dans son élan. Elle est retournée à la force diabolique qui lui avait donné la vie. Nous pouvons désormais recueillir le mana en toute quiétude sans subir son influence.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Emp Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Les éclaireurs de l'Empire ont fait état de l'arrivée des Clans des Nains dans cette vallée. Après avoir découvert la raison de l'installation des Clans dans la région, nous prîmes conscience de la nécessité pour l'Empire d'intervenir.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Les ressources magiques ont ici une valeur inestimable. Les Clans vont sans doute tenter d'envoyer de l'aide. C'est pour cela que nous assiégeons l'entrée de la vallée. Sans réserves, leur reddition n'est plus qu'une question de temps.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Sir Glorcliff, un guerrier expérimenté, est sur le point de donner l'assaut sur la capitale. Nous devons contre-attaquer sans délai.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Emp Entrée de Runia", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Orque\n\"Vous envahissez cette vallée et maintenant vous pensez envahir aussi nos villages ? Vous autres humains êtes bien plus stupides que nous le pensions !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0016", "ID_STRING": "NAME_TXT", "TEXT": "MC Victoire1", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN003a", "ID_STRING": "NAME_TXT", "TEXT": "Espion Gobelin", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0017", "ID_STRING": "NAME_TXT", "TEXT": "MC Victoire3", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0018", "ID_STRING": "NAME_TXT", "TEXT": "MC Victoire2", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Emp Victoire", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Emp Entrée de la Vallée", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Ogre \n\"Vous autres humains pensez pouvoir conquérir cette vallée ? C'est le territoire des Peaux-Vertes ! Allez-vous en !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Emp Cap Gnarthwood", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Cette ville constitue un important point stratégique pour qui règne sur la vallée. Si les Clans venaient à en prendre le contrôle, notre campagne s'en verrait fortement affectée...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Les Peaux-Vertes étaient bien équipés, nous avons retrouvé le Grimoire de Guerre dans leurs chambres fortes.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN003e", "ID_STRING": "NAME_TXT", "TEXT": "Gobelin", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Emp Cap Runia", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Enfin avons-nous réussi à assiéger Runia. Elle avait une importance stratégique pour les Peaux-Vertes... Restons sur nos gardes, ils pourraient user de représailles.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN0040", "ID_STRING": "NAME_TXT", "TEXT": "Orque", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Emp tue Thalrisa", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"On dirait que le fantôme de Thalrisa protégeait l'accès à cette vallée secrète. Je n'ose imaginer quelles autres abominations tout cela peut bien cacher... \"", "SEQ_NUM": 1},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loot Ferme abandonnée", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Cette construction est très ancienne, Seigneur ! De toute évidence, les Peaux-Vertes peuplent cette vallée depuis maintenant fort longtemps. Mais pourquoi ? La magie ?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loot Temple de Thalrisa", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Nous avons arrêté Thalrisa dans son élan. Elle est retournée à la force diabolique qui lui avait donné la vie. Nous pouvons désormais recueillir le mana en toute quiétude sans subir son influence.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN0043", "ID_STRING": "NAME_TXT", "TEXT": "Champion Orque", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0020", "ID_STRING": "NAME_TXT", "TEXT": "MC Spawn2 Message", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Eclaireur\n\"Nous avons appris que des renforts orques étaient en train d'arriver. Ils se dirigent peut-être sur notre capitale !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Emp Spawn 2 Message", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Eclaireur\n\"Nous avons appris que les renforts orques étaient en train d'arriver. Ils se dirigent peut-être sur notre capitale !\"", "SEQ_NUM": 0},
