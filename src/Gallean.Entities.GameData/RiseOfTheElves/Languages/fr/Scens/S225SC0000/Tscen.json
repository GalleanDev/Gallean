    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0022", "ID_STRING": "POPUP_TXT", "TEXT": "Thalrisa \n\"Maintenant, je vais pouvoir me venger de ceux qui m'ont persécuté et je me débarrasserai de vous comme vous avez tenté de vous débarrasser de moi.... Même si mes pauvres Gardiens Elémentaires ont été vaincus, j'aurai ma revanche !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Activer Spawn 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0024", "ID_STRING": "NAME_TXT", "TEXT": "MC Spawn1 Message", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0024", "ID_STRING": "POPUP_TXT", "TEXT": "Eclaireur\n\"Des Trolls envoyés par les Peau-Vertes se dirigent vers nos villes, Seigneur. Nous devons préparer de solides défenses !\"", "SEQ_NUM": 0},
