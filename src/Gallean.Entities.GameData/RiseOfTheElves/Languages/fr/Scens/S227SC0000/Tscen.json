    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Calderic", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Le plus grand seigneur parmi les seigneurs Nains, il est connu pour sa rage au combat et son courage. Il s'est battu une fois sept jours et sept nuits durant contre le puissant dragon rouge ARFURUZON avant de parvenir à le vaincre.", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Asumuel", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Les enfants tremblent dès que l'on prononce son nom. Ce dignitaire de l'enfer est connu pour son insatiable soif de sang. On raconte qu'il dévora un jour 1000 esclaves à un banquet donné par Bethrezen.", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Heiric", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Zaorish", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0008", "ID_STRING": "NAME_TXT", "TEXT": "Prince Daxam", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0016", "ID_STRING": "NAME_TXT", "TEXT": "Sceptre de l'Araignée", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0019", "ID_STRING": "NAME_TXT", "TEXT": "Vampire", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN001d", "ID_STRING": "NAME_TXT", "TEXT": "Nécromancien", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0022", "ID_STRING": "NAME_TXT", "TEXT": "Wynfeld Lynx", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Conditions de Victoire des Légions", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Bête", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0002", "ID_STRING": "NAME_TXT", "TEXT": "C1", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0003", "ID_STRING": "NAME_TXT", "TEXT": "C2", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Attaque du Nécromancien", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Insurgé Phonycien \n\"Les Phonyciens, les bons à rien de Bythazar, attaqueront sous peu le royaume. Personne ne sera alors à l'abri du... message... que nous répandrons dans les foyers et auprès des familles !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Soigner Clans", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Soin des Légions", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Texte de Mystash", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Citoyen de Mystash \n\"Merci de nous avoir libérés de Wynfeld. Daxam a fourni à ses hommes le meilleur équipement disponible et on raconte que son immense fortune lui a même permis de se procurer une arme secrète. Nous sommes tous très inquiets...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Rotting Damn", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Mage \n\"La fortune de Daxam s'étend loin au delà des frontières de cet état. Le Prince a réussi à acheter un Dragon Blanc à un marchand. Même ce Dragon est plus faible que ses cousins, son souffle ne connaît pas d'égal.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Message de Rotting Damn Deux", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Ecuyer\n\"Mort aux Légions ! L'armée du Prince Daxam est maintenant soutenue par une créature à nulle autre pareille. Elle vous éliminera et je festoierai sur vos tombes !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN002d", "ID_STRING": "NAME_TXT", "TEXT": "Orque", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN002e", "ID_STRING": "NAME_TXT", "TEXT": "Orque", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Mc Conditions de Victoire", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0030", "ID_STRING": "NAME_TXT", "TEXT": "Orque", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Histoire de la Légion", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Ashkael \n\"Les terres du royaume de Bythazar renferment de nombreux gisements d'or. La région est gardée par les Orques, mais nous devons tout de même prendre le contrôle de Bythazar. Nous allons montrer à Daxam ce qu'il en coûte d'insulter les Légions !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Histoire des Clans des Nains", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller\\n\"En tuant Daxam, nous risquons une révolte populaire. Bien que furieux contre leur souverain, le pueple n'en acceptera pas facilement un nouveau. Le prince éliminé, nous capturerons Bythazar sur le champ et rétablirons l'ordre.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Garde d'élite", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Bragon des Collines \n\"Daxam finance sa garde d'élite au moyen de lourds impôts qu'il prélève sur les habitants de Bythazar. Les gardes du château possèdent les plus belles armures et les meilleurs armes que l'on puisse se procurer avec de l'or.\"\n", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0033", "ID_STRING": "NAME_TXT", "TEXT": "Gobelin", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Message des Maraudeurs", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Ashkael \n\"Un des sujets de Daxam a été vu en train de négocier avec un marchand membre d'une guilde puissante connue sous  le nom de \"Guilde des Maraudeurs\". Le bruit court que le prince a décidé de renforcer la garde de son château.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Avertissement", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Spectre \n\"Faites demi-tour et quittez ces lieux. A moins bien sssur que vous ne vouliez me rejoindre dans la mort.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0037", "ID_STRING": "NAME_TXT", "TEXT": "Attaque des Gobelins", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Zombie Berserk", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Texte de Mystash", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Soldat d'élite de l'Armée\n\"Les Damnés, ici ? Votre puissance nous force à déposer les armes mais le Prince Daxam ne se laissera pas impressionner aussi facilement. Il a été consulter d'étranges marchands... Qui sait ce qu'il ramènera ?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Attaque du Brigand", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN003b", "ID_STRING": "NAME_TXT", "TEXT": "Orque", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Phonycien", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Phonycien  \n\"Le Sssceptre des Araignées... le Sssceptre des Araignées. Que c'est bon d'être mort. Trouvez le sssceptre ou l'araignée et rejoignez-nous. La douleur dissssparaîtra...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Message Phonycien pour LD", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Phonycien \n\"Le Prince Daxam est un imbécile et le royaume de son père tombera aux mains des Hordes de Mort-Vivants. Ohhh... Vous cherchez le bouclier ? Le Vampire sera content d'avoir de la visite.\"\u0013", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Message de la Légion", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Archidémon\\n\"Nous avons appris que dans cette région se trouve la statue sacrée des Clans. Seuls les membres des Clans peuvent résister à sa présence, tout intrus étant immédiatement anéanti par le pouvoir de leur pitoyable divinité.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Punition de la Légion", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Message de la Montagne", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Géant des Collines\n\"Cette statue pour démons seulement. Seules Légions pouvoir utiliser pouvoirs. Nous approcher, nous maudits !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Punition de la Montagne", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Message de demi-tour", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Brigand\n\"Comme je vous ai sauvé d'une mort certaine en bloquant le passage, j'estime que vous me devez une coquette somme. Si vous ne vous sentez pas l'âme charitable aujourd'hui, j'ai deux amis qui pourraient bien vous faire changer d'avis.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Garde de la Ville", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Lancier d'élite\n\"Halte ! Sur ordre du roi Virgil, père de Daxam, nul ne peut franchir cette porte car le château Phonycien sert de repaire aux traîtres de Bythazar !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Araignée Géante II", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Araignée Géante III", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0044", "ID_STRING": "NAME_TXT", "TEXT": "Orque", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0022", "ID_STRING": "NAME_TXT", "TEXT": "Avertissement du Marchand", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0022", "ID_STRING": "POPUP_TXT", "TEXT": "Paysan\n\"Le danger rôde partout ici ! Des dragons et d'autres créatures abominables attaquent une fois la nuit tombée. Vous auriez dû écouter l'avertissement de la créature !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Roi Orque", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0023", "ID_STRING": "POPUP_TXT", "TEXT": "Orque\n\"Vous apportez des nouvelles du Roi des Orques ? Non ? Alors vous venez vous faire couper en morceaux, c'est ça ?\"", "SEQ_NUM": 0}
  ]
}
