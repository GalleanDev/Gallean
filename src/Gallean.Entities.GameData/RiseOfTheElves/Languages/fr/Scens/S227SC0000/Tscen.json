{
  "formatVersion": 1,
  "rows": [
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0024", "ID_STRING": "NAME_TXT", "TEXT": "Vampire", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0024", "ID_STRING": "POPUP_TXT", "TEXT": "Vampire \n\"Approchez-vous... encore un peu plus près... et vous contemplerez dans mes yeux le destin dont vous rêvez. Approchez-vous et vous apprendrez où se trouve l'artefact infernal.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0047", "ID_STRING": "NAME_TXT", "TEXT": "Orque", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Message du Vampire II", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Vampire \n\"Approchez-vous... encore un peu... et je vous dirai comment vaincre le Prince Daxam. Approchez-vous et vous apprendrez l'emplacement d'un grand trésor... Avez-vous peur ?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Quittez nos terres", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0026", "ID_STRING": "POPUP_TXT", "TEXT": "Zombie Phonycien\n\"Quittez cet endroit sssi vous tenez à la vie. Ressstez et vous deviendrez l'un des nôtres, un des exclus de Bythazar... un Phonycien !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Tour Un", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Seigneur, les Orques ont réussi à pénétrer nos cavernes. Ils ont scellé nos passages. Les Orques sont incapables de concevoir un tel plan, il y a quelqu'un qui les manipule. Mon instinct me dit que Daxam se cache derrière tout cela...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0028", "ID_STRING": "NAME_TXT", "TEXT": "C'est moi", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "Insurgé Phonycien \n\"C'est moi qui ait dressé les plus bornés contre vous. Daxam et son père sont des imbéciles ! Les Phonyciens seront bientôt les maîtres de ce pays et des Hordes de Mort-Vivants répandront partout la mort et la désolation !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN004c", "ID_STRING": "NAME_TXT", "TEXT": "Ecuyer", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Je ne suis pas un paysan", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0029", "ID_STRING": "POPUP_TXT", "TEXT": "Général \n\"Affrontez-moi et votre défaite est assurée. J'espère que vous avez apprécié mes orques. Peu malins, ils sont faciles à acheter. La fortune de Daxam réserve encore bien des surprises mais vous n'aurez pas le plaisir d'en profiter.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Tour Un MC", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002a", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Les Orques se sont frayés un chemin dans notre repaire montagneux. Ils ont réussi à sceller presque toutes les entrées. Les Orques ne sont pas assez intelligents pour avoir échafaudé seuls un tel plan. Quelqu'un qui les dirige... Daxam ?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Prince Assassin", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002c", "ID_STRING": "POPUP_TXT", "TEXT": "Soldat d'élite de l'Armée\n\"Le prince Daxam a donné l'ordre d'exécuter tous les ennemis de l'état. Et devinez quoi ? Vous en faites partie !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN004f", "ID_STRING": "NAME_TXT", "TEXT": "Ecuyer", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002d", "ID_STRING": "NAME_TXT", "TEXT": "Nouvel événement", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Ashkael \n\"Le prince constitue une nouvelle garde d'élite. Ces soldats, destinés à protéger le château, seront équipés des plus belles armures et des armes les plus puissantes. Je crains fort que quelques autres surprises ne lui soient réservées.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002e", "ID_STRING": "NAME_TXT", "TEXT": "Clans des Maraudeurs", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002e", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller\n\"Un membre de la famille royale a été vu en compagnie de marchands. Ceux-ci sont appelés les Maraudeurs dans certaines contrées. Ces marchands vendent de tout, même des mercenaires. Soyons sur nos gardes, le prince peut avoir besoin d'aide.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0052", "ID_STRING": "NAME_TXT", "TEXT": "Paysan", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002f", "ID_STRING": "NAME_TXT", "TEXT": "Message Phonycien", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "Phonycien  \n\"Nous autres, Phonyciens, nous vengerons de Daxam et de ses mercenaires étrangers. Quiconque tentera de s'interposer accompagnera le prince dans sa chute\". \n", "SEQ_NUM": 0},
