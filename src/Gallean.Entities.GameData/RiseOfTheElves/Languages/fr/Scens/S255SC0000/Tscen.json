    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0007", "ID_STRING": "TXT_DESC", "TEXT": "Mes soldats sont les plus valeureux de la région.", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0008", "ID_STRING": "TXT_TITLE", "TEXT": "Camp du Seigneur Kyn", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0008", "ID_STRING": "TXT_DESC", "TEXT": "Venez, apprenez  l'art de la guerre !", "SEQ_NUM": 0},
