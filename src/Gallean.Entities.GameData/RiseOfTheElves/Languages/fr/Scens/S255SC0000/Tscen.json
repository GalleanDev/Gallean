    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loc Village de Paysans", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Paysans\n\"L'Empire n'a plus le contrôle de ces paysans ! Nous avons enfin trouvé la liberté sous la bannière du Seigneur Kyn !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loc Manoir du Seigneur Kyn", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Ecuyer Renégat\n\"Ne vous approchez pas de nous ! Laissez le bon Seigneur Kyn tranquille. C'est un chef qui sait prendre bien soin de son peuple !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loc Lancier près du mur", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Lancier\n\"Le règne de l'Empire a pris fin ! Le seigneur Kyn a interdit l'entrée des Hautes Terres aux soldats de l'Empire jusqu'à notre indépendance !\"\r\n", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loc Guetteur Lancier", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Lancier  \n\"Attendez ! Je vous déconseille d'aller plus loin ! Les légions vous réduiront en cendres !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Loc Guetteur Lancier", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Lancier\n\"Alertez les gardes ! Troupes ennemies en approche !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Emp Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Après que nous eûmes convaincu le légendaire Vaglan de partager notre vision des choses, nous nous attelâmes à la préparation de notre assaut sur les Légions par la frontière nord.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Sur les conseils stratégiques de Vaglan, nous avons placé quatre de nos plus vaillants guerriers sur les premières lignes de nos formations d'attaque, prêts à se lancer à l'assaut des villes ennemies.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Tout a été organisé pour voir si les Légions font appel aux Hordes des Mort-Vivants, qui vivent loin vers l'est. Si cela se confirme, le combat sera plus rude que prévu.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Und Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Notre stratégie d'attente et d'observation a finalement porté ses fruits, Seigneur. Il semblerait que les Légions n'aient pas pu résister à l'assaut frontal mené par l'Empire.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Tout cela a contribué à faire régner le chaos dans les Hautes Terres. Nous avons désormais la possibilité de repousser tous nos adversaires alors qu'ils sont encore faibles et que leurs forces ne sont que peu déployées.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Nous avons envoyé de nombreux espions enquêter en ces terres sur les événements qui s'y déroulent afin de pouvoir déterminer le moment idéal pour attaquer.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Leg Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Lorsque Vaglan ne voulut plus collaborer avec nous, notre empire sombra dans un profond marasme. Même les réunions d'urgence avec les seigneurs des villes alliées n'ont pas suffi à proposer des solutions précises.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Ainsi fut formée l'Alliance des Démons Inférieurs. Sans se soucier de savoir si les puissantes Légions des Damnés pourraient les protéger, ils se séparèrent de nous. Nous nous en trouvâmes considérablement affaiblis.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Nous devons reconquérir ces villes d'une façon ou d'une autre et faire tomber l'Alliance afin de montrer au peuple qui est son vrai souverain !\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Loc Territoire des Brigands 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Brigands\n\"Halte ! Ce territoire nous appartient. Si vous tenez à la vie, faites demi-tour immédiatement et dépêchez-vous de rentrez chez vous.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Loc Territoire des Brigands 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Brigands\n\"Halte ! Ce territoire nous appartient. Si vous tenez à la vie, faites demi-tour immédiatement et dépêchez-vous de rentrez chez vous.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loc Tour des Zombies", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Seigneur, une odeur nauséabonde émane de la tour, et des Zombies arpentent les terres de leurs pas lourds et traînants... Un culte nécromancien inhabituel doit y avoir lieu !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Und Loc Contrôle des Mort-Vivants", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Seigneur, nous sommes en train de perdre le contrôle de nos propres terres... De nombreux Nécromanciens ont créé leur propre culte aux abords de la ville. Leur châtiment sera à la mesure de notre pouvoir !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Loc Piège des Araignées", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "\"Attention seigneur, c'est un piège ! Les Araignées nous ont tendu une embuscade !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Emp Victoire", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Leg Victoire", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Emp Capture le Val du Dragon", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Démons \n\"Nous ne permettrons pas que de la vermine humaine prenne le contrôle de nos terres ! Ne vous installez pas trop confortablement...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Capturer le donjon d'Indrus", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Und Loc Zombies Renégats", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Ces Zombies sont gouvernés par quelques Occultistes devenus fous ! Nous devrions en trouver la source et la détruire !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Désactiver les Zombies Renégats", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loc Val du Dragon", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Non loin d'ici se trouve Valdragon. La légende dit que c'était une ville prospère, dirigée par les Grands Dragons. Au cours de la Grande Guerre, elle fut dévastée par les Légions. Désormais, les esprits des dragons hantent ces terres.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Capturer Allantyr", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Nains\n\"N'espérez pas remporter la victoire ! Nous nous battrons jusqu'au bout ! Nos troupes viendront nous libérer sous peu !\"\r\n", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Capturer la ville naine", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Nains\n\"Les Nains ont toujours été des guerriers et nous avons une mémoire infaillible. Par Wotan, nous récupérerons notre capitale, quoi qu'il en coûte !\"\r \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Les Nains attaquent la ville Naine", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Loc Siège Nain", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Soldats Nains \n\"Quittez ces lieux. Nous autres, Nains, faisons le siège de cette ville !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Loc Cité Naine du Nord", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Garde de la Ville Naine\n\"Ces terres appartiennent aux Nains. Vous n'êtes pas les bienvenus ici !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Loc Entrée orientale de la Ville Naine", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Géant des pierres\n\"Ces terres appartiennent aux Nains et vous n'êtes pas les bienvenus ici !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Activer Spawn Démon", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Démon", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Und Victoire", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Leg Capture Troya", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Il est dorénavant de la plus haute importance que nous maintenions cette ville sous nos ordres. Ensuite, nous n'aurons plus qu'à prendre le contrôle du Val du Dragon.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Leg Capture le Val du Dragon", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Il est dorénavant de la plus haute importance que nous maintenions cette ville sous notre contrôle. Ensuite, nous n'aurons plus qu'à capturer Troya.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Capturer Kanna", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Echoppe de Kilgen", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Je crois que je peux vous aider.", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Leg Alliance avec les Démons Mineurs", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Seigneur, un groupe de Démons Inférieurs dissidents souhaite rallier nos troupes. S'ils peuvent nous rejoindre du côté de la ville de Troya, la force qu'ils feront gagner à notre armée nous sera certainement d'une aide précieuse...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0022", "ID_STRING": "NAME_TXT", "TEXT": "Leg Loc Alliés Démons", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0022", "ID_STRING": "POPUP_TXT", "TEXT": "Hazky'la\n\"Oui, nous ne voulons pas encourir la colère de Bethrezen ! Nous servirons votre armée loyalement !\"\n", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Provisions du Seigneur Kyn", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Nous avons tout ce dont le peuple a besoin !", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Und Loc Val du Dragon", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0023", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Non loin d'ici se trouve Valdragon. La légende dit que c'était une ville prospère, dirigée par les Grands Dragons. Au cours de la Grande Guerre, elle fut dévastée par les Légions. Désormais, les esprits des dragons hantent ces terres.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Echoppe d'Allar", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Je vends tout... pour peu qu'on y mette le prix.", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0024", "ID_STRING": "NAME_TXT", "TEXT": "Leg Loc Tour des Zombies", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0024", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Seigneur, une odeur nauséabonde émane de la tour, et des Zombies arpentent les terres de leurs pas lourds et traînants... Un culte nécromancien inhabituel doit y avoir lieu !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0005", "ID_STRING": "TXT_TITLE", "TEXT": "Echoppe d'Yggar", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0005", "ID_STRING": "TXT_DESC", "TEXT": "Mes marchandises peuvent vous aider dans votre quête.", "SEQ_NUM": 0},
