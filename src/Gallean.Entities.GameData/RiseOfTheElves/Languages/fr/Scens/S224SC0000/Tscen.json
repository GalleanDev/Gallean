    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0061", "ID_STRING": "NAME_TXT", "TEXT": "Ecuyer", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0066", "ID_STRING": "NAME_TXT", "TEXT": "Zombie", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN006b", "ID_STRING": "NAME_TXT", "TEXT": "Démon", "SEQ_NUM": 0},
