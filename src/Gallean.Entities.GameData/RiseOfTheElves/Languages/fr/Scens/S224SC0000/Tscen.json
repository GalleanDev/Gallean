    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224LO0015", "ID_STRING": "NAME_TXT", "TEXT": "Destination du Paysan", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Camp d'Yggar", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Les plus grands guerriers du royaume se sont entraînés ici.", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Echoppe de Sallat", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Comment puis-je vous aider, étranger ?", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Echoppe de Warwick", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Mes marchandises peuvent vous aider dans votre quête.", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Tour d'Othon", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Je peux vous aider à combattre l'invasion des démons !", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0004", "ID_STRING": "TXT_TITLE", "TEXT": "Echoppe de Furren", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0004", "ID_STRING": "TXT_DESC", "TEXT": "Je vends tout... pour peu qu'on y mette le prix.", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutres", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Pas de description de race", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Winfrid", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Dans sa jeunesse, ce puissant seigneur tenu bon contre une armée venue de l'enfer et l'a repoussée seul en scellant la porte qui vomissait ces créatures dans notre monde. Il est ensuite devenu souverain de notre royaume.", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Baldaric", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Le plus grand seigneur parmi les seigneurs Nains, il est connu pour sa rage au combat et son courage. Il s'est battu une fois sept jours et sept nuits durant contre le puissant dragon rouge ARFURUZON avant de parvenir à le vaincre.", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Emery", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Lantfrid", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0008", "ID_STRING": "NAME_TXT", "TEXT": "Brigand", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0023", "ID_STRING": "NAME_TXT", "TEXT": "Lancier", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Capturer Inferno", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "\"Regardez ! On dirait que notre présence libère le sol de son emprise maléfique ! Nous sommes en passe de vaincre cette force diabolique.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0001", "ID_STRING": "NAME_TXT", "TEXT": "MC Victoire", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "\"Le Clan a triomphé des maux répandus par le malin dans ce pays.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Capturer Avgrundskval", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "\"C'est extraordinaire ! Le sol que nous foulons se transforme et les infernaux trous de lave se referment sous nos pas... Nos troupes retrouvent le courage de poursuivre !\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Pluie de Démons", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Cimetière", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "\"Les Démons ont pillé le sanctuaire sacré que nous avions construit pour nos morts ! Notre vengeance sera terrible !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0028", "ID_STRING": "NAME_TXT", "TEXT": "Lancier", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Nécromancien", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Nécromancien : \"Ha ha ha ! A genoux devant votre nouveau maître, misérables mortels ! Le Seigneur Dragon vous réduira en cendres d'un seul souffle !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Garde-paysan de l'Empire", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "\"Nous ne sommes plus dévoués à l'Empire. Nous assumerons seuls notre destin. Soldats, veuillez quitter nos terres !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN002b", "ID_STRING": "NAME_TXT", "TEXT": "Paysan", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Sort du Démonologue", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "\"Malheur à vous, pauvres mortels ! Ce royaume est nôtre désormais ! Comment osez-vous encore entacher ce pays de votre seule présence ?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN002c", "ID_STRING": "NAME_TXT", "TEXT": "Paysan", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Portail Infernal", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Démons \n\"La Mort vient à tous ceux qui la cherche et vous venez juste de la trouver !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Visite du Camp Impérial", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Lorn : \"Attendez, je vous en prie ! Laissez-nous rejoindre vos rangs. Nous ne voulons plus servir le Seigneur Dragon plus longtemps !\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000d", "ID_STRING": "NAME_TXT", "TEXT": "MC Visite des Nains", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Nain : \"Enfin ! Quelqu'un pour continuer la croisade contre le diabolique Seigneur Dragon ! Je suis trop fatigué pour aller plus loin... Prenez ceci, ça vous aidera grandement...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000e", "ID_STRING": "NAME_TXT", "TEXT": "MC Garde Paysan", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "\"Nains, vous êtes stupides ! N'approchez pas notre village ! Seuls les Humains ont ici droit de cité !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Désactiver Garde paysan MC", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "\"Guerriers des Clans, nous combattrons jusqu'à la mort !\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0032", "ID_STRING": "NAME_TXT", "TEXT": "Lancier", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Victoire de l'Empire", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "\"Au nom du Haut-Père, nous avons vaincu le Mal en ces terres !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Intro de l'Empire", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "\"Nous avons vécu en paix sur ces terres aux côtés des Clans des Nains aussi loin que remontent nos souvenirs. Puis, un jour, le ciel au sud s'est assombri et une étouffante chaleur est montée des entrailles de la terre.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "\"Hélas, nous n'avons pas su agir avant qu'il ne soit trop tard. Maintenant, la panique a gagné nos concitoyens : le pays tout entier a sombré dans le chaos. Nous devons absolument trouver et détruire la source diabolique de tous ces maux !\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0035", "ID_STRING": "NAME_TXT", "TEXT": "Lancier", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0012", "ID_STRING": "NAME_TXT", "TEXT": "MC Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "\"Nous avons vécu en paix sur ces terres aux côtés de l'Empire aussi loin que remontent nos souvenirs. Puis, un jour, le ciel au sud s'est assombri et une étouffante chaleur est montée des entrailles de la terre.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "\"Hélas, nous n'avons pas su agir avant qu'il ne soit trop tard. Maintenant, la panique a gagné nos concitoyens : le pays tout entier a sombré dans le chaos. Nous devons absolument trouver et détruire la source diabolique de tous ces maux !\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Activer la pluie de Démons", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "\"Les Démons surgissent des entrailles de la Terre ! Il faut les arrêter !\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0014", "ID_STRING": "NAME_TXT", "TEXT": "MC A l'ouest du Donjon du Nord", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "\"N'approchez pas de notre ville ! Nous n'aimons pas les gens de votre espèce, seuls les humains peuvent pénétrer sur nos terres !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0015", "ID_STRING": "NAME_TXT", "TEXT": "MC A l'est du Donjon du nord", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "\"N'approchez pas de notre ville ! Nous n'aimons pas les gens de votre espèce, seuls les humains peuvent pénétrer sur nos terres !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0039", "ID_STRING": "NAME_TXT", "TEXT": "Paysan", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0016", "ID_STRING": "NAME_TXT", "TEXT": "A l'Est du Donjon du Nord de l'Empire", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "\"Soldats de l'Empire, vous n'avez pu nous protéger des Démons, nous nous défendrons donc nous-mêmes ! A présent, repliez-vous avant que nous donnions l'assaut !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0017", "ID_STRING": "NAME_TXT", "TEXT": "A l'Ouest du Donjon du Nord de l'Empire", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "\"Soldats de l'Empire, vous n'avez pu nous protéger des Démons, nous nous défendrons donc nous-mêmes ! A présent, repliez-vous avant que nous donnions l'assaut !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0018", "ID_STRING": "NAME_TXT", "TEXT": "MC A proximité du Portail Infernal", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "\"Seigneur ! Nous sentons la présence d'un piège diabolique très puissant ! Du sol émanent des vagues d'une intense chaleur. Apprêtons-nous à jeter nos meilleurs sorts !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Empire Près du Portail Maudit", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "\"Seigneur ! Nous sentons la présence d'un piège diabolique très puissant ! Tenons-nous prêts, nous ressentons comme l'émanation d'une intense chaleur. Que le Haut-Père soit avec nous.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001a", "ID_STRING": "NAME_TXT", "TEXT": "L'Empire rend visite aux Nains", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "\"Etes-vous venus pour terrasser ce dragon maléfique ? Pitié, aidez-moi, j'ai été gravement touché et je ne peux plus marcher. Tenez, prenez ceci et terrassez le dragon...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001b", "ID_STRING": "NAME_TXT", "TEXT": "A proximité de l'Ecuyer", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "\"Arrière ! Nous exterminerons ces créatures sans votre aide ! Nous sommes armés jusqu'aux dents !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001c", "ID_STRING": "NAME_TXT", "TEXT": "A proximité du Zombie", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "\"Seigneur ! Voici les terrifiants démons dont les paysans nous ont parlé !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN003f", "ID_STRING": "NAME_TXT", "TEXT": "Paysan", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001d", "ID_STRING": "NAME_TXT", "TEXT": "A proximité du Spectre", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "\"Seigneur ! Voici les terrifiants démons dont les paysans nous ont parlé !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0042", "ID_STRING": "NAME_TXT", "TEXT": "Lancier", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Paysan en fuite", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "\"Au secours, Seigneur ! A l'aide ! Sauvez-nous ! Nous marchions tranquillement dans la vallée lorsque d'horribles démons se sont lancés à nos trousses ! Tuez-les ! A l'aide !\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Capturer Fort March Empire", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Villageois\n\"Sauvez-nous des Démons ! Ils ont juré de nous sacrifier au Seigneur Dragon !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Capturer March Fort MC", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Villageois\n\"D'abord l'invasion des démons et maintenant les Clans des Nains ! Ayez pitié de nous !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0049", "ID_STRING": "NAME_TXT", "TEXT": "Ecuyer", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN004f", "ID_STRING": "NAME_TXT", "TEXT": "Ecuyer", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0054", "ID_STRING": "NAME_TXT", "TEXT": "Lancier", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0057", "ID_STRING": "NAME_TXT", "TEXT": "Démon", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0058", "ID_STRING": "NAME_TXT", "TEXT": "Démon", "SEQ_NUM": 0},
