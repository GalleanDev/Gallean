      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0022",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Sir\u00E8ne",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0000",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Avertissement rituel",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0000",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Invocateur\n\u0022Ma\u00EEtre ! D\u0027\u00E9tranges forces occultes sont \u00E0 l\u0027oeuvre en ces lieux... Des d\u00E9mons jaillissent sans cesse pour nous attaquer ! Il faut clore ce Portail infernal...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0024",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Sir\u00E8ne",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0001",
      "ID_STRING": "NAME_TXT",
      "TEXT": "T 1 Drame",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Conseiller\n\u0022Nos \u00E9claireurs ont quadrill\u00E9 la r\u00E9gion \u00E0 la recherche de Mort-vivants ... Ils n\u0027en ont trouv\u00E9 aucune trace.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Bethrezen\n\u0022Qu\u0027il n\u0027existe aucune cr\u00E9ature non-vivante sur ces terres est une \u00E9vidence...\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Conseiller\n\u0022Que voulez-vous dire, ma\u00EEtre Bethrezen ? Ne sommes-nous pas venus en ces lieux pour leur tendre une embuscade ?\u0022",
      "SEQ_NUM": 2
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Uther\n\u0022Je ne suis pas Bethrezen...\u0022",
      "SEQ_NUM": 3
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Conseiller\n\u0022Vous n\u0027\u00EAtes pas Bethrezen ? Mais vous disiez...\u0022",
      "SEQ_NUM": 4
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Uther\n\u0022Vous comprendrez bien assez vite... Asteroth ! Ecrase ces d\u00E9mons des plans inf\u00E9rieurs. Nous n\u0027en avons plus besoin, n\u0027est-ce pas ?\u0022",
      "SEQ_NUM": 5
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0002",
      "ID_STRING": "NAME_TXT",
      "TEXT": "T 1-2 Drame",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0002",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Asteroth\n\u0022Oui, nous r\u00E9gnerons ensemble ! Nul ne pourra plus nous d\u00E9fier !\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0002",
      "ID_STRING": "OBJECT_TXT",
      "TEXT": "Tuer le seigneur d\u00E9mon Asteroth.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0027",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Sir\u00E8ne",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0004",
      "ID_STRING": "NAME_TXT",
      "TEXT": "T 1-3 Drame",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "D\u00E9mon des Abysses \n\u0022Nous n\u0027avons pas besoin de vous, d\u00E9mons asservis !\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "D\u00E9mon des Abysses \n\u0022Nous resterons loyaux envers notre seul ma\u00EEtre, Bethrezen ! Il vous fera payer cette trahison...\u0022",
      "SEQ_NUM": 4
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0006",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Texte Gromdam",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0006",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Archer d\u0027\u00E9lite \n\u0022N\u0027abandonnez-vous donc jamais, d\u00E9mons ? Uther r\u00E9gnera sur ces terres et vous devrez partir \u00E0 jamais !\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0007",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Texte Rottudam",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0007",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Chevalier \n\u0022Arri\u00E8re, d\u00E9mons ! Nous attendons notre sauveur, Uther... Quand il arrivera, il saura vous montrer la puissance du glaive de la justice !\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN002a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Gargouille d\u0027onyx",
      "SEQ_NUM": 0
    },
    {
