    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN002e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Gargouille d\u0027onyx",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000b",
      "ID_STRING": "NAME_TXT",
      "TEXT": "D\u00E9truire les Adeptes.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000b",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Pand\u00E9mon\u00E9us \n\u0022Nous avons d\u00E9truit le cercle d\u0027invocation, ma\u00EEtre. Les d\u00E9mons n\u0027en surgiront plus...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000c",
      "ID_STRING": "NAME_TXT",
      "TEXT": "D\u00E9truire Demonol",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000c",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Pand\u00E9mon\u00E9us \n\u0022Nous avons d\u00E9truit le cercle d\u0027invocation, ma\u00EEtre. Les d\u00E9mons n\u0027en surgiront plus...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000d",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Avertissement eau",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000d",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Conseiller \n\u0022Prudence, ma\u00EEtre... Les oc\u00E9ans sont sous le contr\u00F4le des sorci\u00E8res des mers ; elles s\u0027attaquent \u00E0 tout inconscient qui p\u00E9n\u00E8tre dans leur domaine...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Asteroth T2",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000f",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Situation zone",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000f",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Duc \n\u0022L\u0027Empire s\u0027est ralli\u00E9 \u00E0 la cause d\u0027Asteroth ! Ils ont conclu une sorte d\u0027alliance ! Uther semble contr\u00F4ler les forces de l\u0027Empire. Hubert de Lalye est probablement derri\u00E8re tout cela...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0032",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Adepte",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0010",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Asteroth Proche",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0010",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Asteroth \n\u0022Encore une erreur, mortel ! Je vous an\u00E9antirai de mes propres mains... Le r\u00E8gne de Bethrezen n\u0027est plus qu\u0027un souvenir !\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0034",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Adepte",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0011",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Onyx Move T15",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0012",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Victoire qu\u00EAte",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0012",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Asteroth \n\u0022Ghhhooarrr ! Vous avez eu de la chance d\u0027\u00E9chapper \u00E0 ma fureur, d\u00E9mons ! Mais vous ne parviendrez pas \u00E0 me d\u00E9truire ...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0012",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "D\u00E9monologue \n\u0022Asteroth a disparu dans une gerbe de flammes ! Il a fui ! Mais, nous sommes victorieux...\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0036",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Ogre",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0014",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Asteroth T40",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0014",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Asteroth \n\u0022L\u00E2ches ! Je veillerai en personne \u00E0 ce que mourriez... Vous allez regretter votre trahison !\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0015",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Qu\u00EAte orque",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0015",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Orque \n\u0022Peaux-Br\u00FBlantes... Nous besoin aide... Fr\u00E8re orque perdu... Vous nous aider ?\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0015",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Duc \n\u0022Qu\u0027attendez-vous de nous ?\u0022",
      "SEQ_NUM": 2
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0015",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Orque \n\u0022Amenez orque ici... Nous donner r\u00E9compense...\u0022",
      "SEQ_NUM": 4
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0039",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Assassin Imp\u00E9rial",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0016",
      "ID_STRING": "NAME_TXT",
      "TEXT": "R\u00E9compense orque",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0016",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Orque \n\u0022GHOOOOAAR ! Orque...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0016",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Orque \n\u0022Fr\u00E8re revenu. Vous aider nous... Vous trouver tr\u00E9sor dans grosse ville !\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0016",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Orque \n\u0022Peaux-Br\u00FBlantes amis ! Nous aider vous !\u0022",
      "SEQ_NUM": 4
    },
