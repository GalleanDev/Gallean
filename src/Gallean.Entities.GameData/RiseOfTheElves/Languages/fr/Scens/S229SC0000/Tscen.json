    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Perte des Mort-Vivants", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0002", "ID_STRING": "NAME_TXT", "TEXT": "MC Loc Territoire des Humains", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "\"Seigneur, soyez prudent si vous pénétrez en territoire humain... Ils n'hésiteront pas à se défendre !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Loc R Attaque de Jack", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Capturer Freedom Point 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Villageois\n\"On raconte que la Vieille Eglise serait hantée par des loups-garous et des vampires...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229UN0027", "ID_STRING": "NAME_TXT", "TEXT": "Déserteurs", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Désactiver la Vielle église mise à sac", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Loc Embuscade des Voleurs", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Chef de bande\n\"Ha ha! Vous êtes tombé dans notre embuscade ! Vous allez périr ici !\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229UN002b", "ID_STRING": "NAME_TXT", "TEXT": "Krnak le Fort", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0008", "ID_STRING": "NAME_TXT", "TEXT": "MC Loc Avertissement du Lézard 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "\"Seigneur, nous sommes sur le point de pénétrer une terre inhospitalière ! Les Lézards sont un peuple extrêmement dangereux... Peut-être vaudrait-il mieux faire demi-tour ?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0009", "ID_STRING": "NAME_TXT", "TEXT": "MC Loc Avertissement du Lézard 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "\"Seigneur, nous allons bientôt pénétrer en territoire ennemi. Les Lézards sont des créatures sournoises... Peut-être devrions-nous faire demi-tour ?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Capturer Hg'nufy", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Peuple des Marais\n\"Pourquoi nous attaquez-vous ? Nous étions un peuple pacifique avant votre venue !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Loc Avertissement Passe 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Dragon \n\"Approchez-vous, honorez le Dragon... et laissez-moi goûter votre chair !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Loc Avertissement Passe 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Dragon \n\"Approchez-vous, honorez le Dragon... et laissez-moi goûter votre chair !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Mort-Vivants Loc Territoire Elfe 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "\"Seigneur, il semblerait qu'il y ait un campement elfe droit devant !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Mort-Vivants Loc Territoire Elfe 2", "SEQ_NUM": 0},
