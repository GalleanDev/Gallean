{
  "formatVersion": 1,
  "rows": [
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Echoppe de Hemlock", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Mes marchandises peuvent vous aider dans votre quête.", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Echoppe de Herlick", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Regardez mes marchandises, j'ai peut-être quelque chose qui pourrait vous intéresser.", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Tour de Garkath", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Avez-vous besoin de sorts plus intéressants ?", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0005", "ID_STRING": "TXT_TITLE", "TEXT": "Camp de Metaca", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0005", "ID_STRING": "TXT_DESC", "TEXT": "Entrez et je ferai de vous des cadavres dignes de ce nom.", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutres", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Pas de description de race", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Goar", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Dans sa jeunesse, ce puissant seigneur tenu bon contre une armée venue de l'enfer et l'a repoussée seul en scellant la porte qui vomissait ces créatures dans notre monde. Il est ensuite devenu souverain de notre royaume.", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Jagare", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN000c", "ID_STRING": "NAME_TXT", "TEXT": "Gobelin", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN000e", "ID_STRING": "NAME_TXT", "TEXT": "Gobelin", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0010", "ID_STRING": "NAME_TXT", "TEXT": "Paysan", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0012", "ID_STRING": "NAME_TXT", "TEXT": "Chef des villageois", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0018", "ID_STRING": "NAME_TXT", "TEXT": "Gobelin", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN001c", "ID_STRING": "NAME_TXT", "TEXT": "Paysan", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN001e", "ID_STRING": "NAME_TXT", "TEXT": "Paysan", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Intro 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Seigneur, l'heure est grave. Le royaume souffre, il semblerait qu'une insurrection ait éclaté dans tous les villages sous notre contrôle !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Nous devons reprendre nos positions par la force et trouver ce qui est à l'origine de tout ceci ! Nous devons en premier lieu rencontrer le Chancelier de Clovis afin de nous entretenir des stratégies offensives.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Intro 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller Impérial\n\"Bienvenue, Seigneur. Je suis votre Conseiller. Je suis ici pour vous aider à appréhender les subtilités de la gestion d'un royaume.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller Impérial\n\"Je vous suggère de rassembler un groupe en déplaçant des unités de la garnison vers le groupe actif. Vous pourrez ensuite choisir de déposer ou récupérer des objets dans la chambre forte.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Conseil de la Tour de l'Ensorceleuse", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Seigneur ! N'entendez-vous pas cet horrible cri provenant de la Tour des Ensorceleuses ? On y torture une âme innocente, cela ne fait aucun doute ! Il est de notre devoir de voler à son secours !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Pillage de la Tour de la Vielle", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Isuel \n\"Merci de m'avoir délivré ; j'ai bien cru ne jamais retrouver la liberté. Pour vous remercier, permettez-moi de répandre la parole de l'Empire en plantant des sceptres partout où s'étend votre pouvoir\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Nous pouvons envoyer l'Archange qui, à tire d'aile, va planter des drapeaux près des sources de pouvoir qui seront ainsi nôtres. De cette façon, nous pouvons amasser de l'or et du mana sans avoir de ville sous nos ordres à proximité.\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0029", "ID_STRING": "NAME_TXT", "TEXT": "Paysan", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Conseil3 - Empire Gobelin", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Gobelins \n\"Hé ! Eloignez-vous ! C'est notre trésor et il est spécial ! Vous ne pouvez pas l'avoir ! Ne nous mettez pas en colère !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Défendre le Village", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Villageois\n\"Si vous tenez à votre peau, courez !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Conseil4 - Voyage Maritime", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Voyager par-delà les mers est lent et périlleux pour ceux qui ne savent voler, Seigneur.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Conseil4 - Voyage Maritime 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Voyager par-delà les mers est lent et périlleux pour ceux qui ne savent voler, Seigneur.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Cimetière", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Maraudeur du Cimetière\n\"Venez dans notre cimetière...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Mana de pierre runique", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Seigneur, là-bas ! Une source de mana de pierre runique ! Envoyons un Archange y planter un sceptre !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0032", "ID_STRING": "NAME_TXT", "TEXT": "Brigand", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Conseil du 4e jour", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Seigneur, nos éclaireurs signalent l'existence au nord d'un petit village. Peut-être devrions nous aller voir si sa conquête nous permettrait d'étendre notre influence.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0037", "ID_STRING": "NAME_TXT", "TEXT": "Brigand", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Guérison Impériale", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Message de guérison de l'Empire", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Statue \n\"Benis soient ceux qui se battent pour le Haut-Père... Si vous êtes blessés, vous serez soignés en son nom. Revenez quand bon vous semble.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Gobelin", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0046", "ID_STRING": "NAME_TXT", "TEXT": "Gobelin", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0024", "ID_STRING": "NAME_TXT", "TEXT": "Passage du Brigand", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0024", "ID_STRING": "POPUP_TXT", "TEXT": "Brigand\n\"Ca vous coûtera une petite fortune si vous voulez passer ici !\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN004b", "ID_STRING": "NAME_TXT", "TEXT": "Chef de bande", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Capturer Nepheris", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "\"Si vous voulez améliorer les défenses de cette ville, vous devez l'agrandir. Chaque niveau de croissance vous permet d'ajouter une unité à la garnison de la ville. Ainsi, vous le bonus de défense des unités présentes dans la ville augmente.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN004d", "ID_STRING": "NAME_TXT", "TEXT": "Chef de bande", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Capturer Fort Davon", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV002a", "ID_STRING": "POPUP_TXT", "TEXT": "Villageois \n\"Vous pouvez nous prendre nos terres mais nous nous vengerons tôt ou tard !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN004f", "ID_STRING": "NAME_TXT", "TEXT": "Lancier", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Avertissement des Orques", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV002c", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Seigneur, soyez prudent ! Les Orques sont extrêmement agressifs, ils terrorisent leur adversaire au combat. Ils nous attaqueront sûrement si nous nous arrêtons trop près d'eux.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV002d", "ID_STRING": "NAME_TXT", "TEXT": "Cachette Peau-Verte", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Forteresse Peau-verte en vue, Seigneur. Leurs coffres regorgent de tout l'or dont ils détroussent les voyageurs. Mais ils se défendent aussi très bien...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0052", "ID_STRING": "NAME_TXT", "TEXT": "Chef de bande", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0030", "ID_STRING": "NAME_TXT", "TEXT": "Jour de l'apparition des Gobelins", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0030", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Une foule de goblins traverse actuellement les Terres du Nord, ils font route vers notre région pour affaires. Soyons prudents, ils pourraient avoir des intentions hostiles !\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0032", "ID_STRING": "NAME_TXT", "TEXT": "Mana de Vie", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0032", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"L'étrange cristal que vous voyez là-bas, seigneur, est le mana de vie. C'est en lui que nous puisons nos pouvoirs magiques.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0032", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Pour gagner une source de pouvoir comme une mine d'or ou un cristal de mana qui n'est pas encore en notre possession,  nous devons envoyer un Archange y planter un sceptre.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0033", "ID_STRING": "NAME_TXT", "TEXT": "Géant des Collines", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0033", "ID_STRING": "POPUP_TXT", "TEXT": "Géant des Collines\n\"Que vous vouloir ? Moi décider qui s'entraîne ici et vous pas avoir l'air d'avoir chance ! Ah !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0035", "ID_STRING": "NAME_TXT", "TEXT": "Conseil des Potions", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0035", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Quiconque est blessé en combat peut être guéri par une potion ou ressuscité grâce avec une potion de vie. Avec un temple dans la capitale, les unités peuvent être guéries et ressuscitées dans la capitale et toute autre ville.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0036", "ID_STRING": "NAME_TXT", "TEXT": "Conseil des Sorts", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0036", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Seigneur, après avoir recueilli beaucoup de mana, nous devrions jeter des sorts pour nous protéger et faire obstacle à nos ennemis. Pour cela, et si cela n'a pas déjà été fait, nous devons tout d'abord construire la Tour de Magie.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0036", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Nous pourrons augmenter le nombre de sorts en notre possession en les recherchant dans la capitale. Cependant, nous ne pourrons rechercher des sorts qu'après avoir rassemblé la quantité de mana requis.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0037", "ID_STRING": "NAME_TXT", "TEXT": "Conseil d'amélioration", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0037", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Lorsque vous aurez acquis suffisamment d'expérience, vos unités de combat pourront devenir plus puissantes. Cependant, la structure d'amélioration de chaque unité devra être construite dans la capitale.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0038", "ID_STRING": "NAME_TXT", "TEXT": "Conseil Artefact", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0038", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Seigneur, restons aux aguets ! Nous pourrions découvrir moults coffres emplis de trésors, d'artefacts, de pouvoirs spéciaux ou d'objets de valeurs. On dirait qu'il y en a un droit devant nous !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0039", "ID_STRING": "NAME_TXT", "TEXT": "Désactiver les Améliorations", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003a", "ID_STRING": "NAME_TXT", "TEXT": "Conseil Recrutement", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003a", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Seigneur, que la perte d'un grand chef ne soit pas source de tourments. Nous pourrons en engager un autre contre une somme modique à la capitale.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003b", "ID_STRING": "NAME_TXT", "TEXT": "Trésor Gobelin 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003b", "ID_STRING": "POPUP_TXT", "TEXT": "Gobelin \n\"Oh ! Hé ! Ne vous approchez pas de notre trésor ! Partez !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003c", "ID_STRING": "NAME_TXT", "TEXT": "Conseil du Marchand", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003c", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Non loin d'ici se trouve l'échoppe d'un marchand. C'est bon à savoir, au cas où nous aurions besoin de quoi que ce soit comme des potions de guérison ou n'importe quoi d'autre.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003d", "ID_STRING": "NAME_TXT", "TEXT": "Bonjour Chancelier", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003d", "ID_STRING": "POPUP_TXT", "TEXT": "Chancelier de Clovis \n\"Bienvenue. Je suis le Chancelier de Clovis et je suis ici pour vous instruire dans l'art de la guerre. Ecoutez-moi bien car je n'ai que peu de temps à vous consacrer ; je dois me rendre d'urgence dans les villes frontalières.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003d", "ID_STRING": "POPUP_TXT", "TEXT": "Chancelier de Clovis\n\"Les unités capables d'attaquer à distance comme les Archers, les Apprentis et les Acolytes seront plus en sécurité à l'arrière, bien à l'abri derrière d'autres unités plus endurcies comme les Ecuyers ou les Chevaliers Pégase.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003d", "ID_STRING": "POPUP_TXT", "TEXT": "Chancelier de Clovis\\n\"Certaines unités ne se battent qu'au contact et doivent être placées en première ligne. D'autres attaquent à distance mais elles sont plus faibles ; placez-les à l'arrière. Ne quittez la capitale qu'avec un groupe au complet.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003d", "ID_STRING": "POPUP_TXT", "TEXT": "Chancelier de Clovis \n\"Une dernière chose : pour accéder aux différents éléments comme les chefs ou la capitale, double-cliquez dessus. Pour obtenir des informations les concernant, cliquez dessus avec le bouton droit.\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003e", "ID_STRING": "NAME_TXT", "TEXT": "Au revoir, Chancelier.", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003f", "ID_STRING": "NAME_TXT", "TEXT": "Combattre les Paysans", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003f", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Les paysans mutins approchent, ils tentent d'assiéger la capitale ! Au nom du Haut-Père, nous devons arrêter leur progression ! Rappelez-vous les conseils du Chancelier !", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0041", "ID_STRING": "NAME_TXT", "TEXT": "Mine d'Or", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0041", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Seigneur, une mine d'or ! Elle est déjà sous le contrôle de nos forces.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0043", "ID_STRING": "NAME_TXT", "TEXT": "Victoire", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0043", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Les paysans rebelles ont été soumis ! L'Empire règne sur ces terres !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0067", "ID_STRING": "NAME_TXT", "TEXT": "Gobelin", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0045", "ID_STRING": "NAME_TXT", "TEXT": "Conseil du Camp d'entraînement", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0045", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Seigneur, non loin d'ici se trouve un camp d'entraînement. En échange de quelque argent, vos troupes pourront suivre un entraînement. Elles y gagneraient autant d'expérience et d'assurance qu'au combat.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0046", "ID_STRING": "NAME_TXT", "TEXT": "Conseil de la Tour du Mage", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0046", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Il s'agit de la tour d'un mage, Seigneur. Un mage peut nous y vendre de nouveaux sorts contre une modique somme d'or.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0047", "ID_STRING": "NAME_TXT", "TEXT": "Rencontre Orque", "SEQ_NUM": 0},
