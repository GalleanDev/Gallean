    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100SI0001",
      "ID_STRING": "TXT_TITLE",
      "TEXT": "Tour de Malavien",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100SI0001",
      "ID_STRING": "TXT_DESC",
      "TEXT": "J\u0027ai quelques nouveaux sorts puissants qui pourraient vous int\u00E9resser.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100PL0000",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Begrezen",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100PL0000",
      "ID_STRING": "DESC_TXT",
      "TEXT": "Chaque enfant tremble \u00E0 la simple mention de son nom. Ce seigneur des Enfers est connu pour son app\u00E9tit sanguinaire et insatiable. Il aurait englouti 1000 esclaves \u00E0 un banquet donn\u00E9 par Bethrezen.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100PL0001",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Athaulf",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100PL0001",
      "ID_STRING": "DESC_TXT",
      "TEXT": "Grand seigneur des Nains, il est connu pour sa f\u00E9rocit\u00E9 au combat et son courage face \u00E0 des rapports de force tr\u00E8s d\u00E9favorables. Il combattit une fois sept jours et nuits d\u0027affil\u00E9e contre le puissant dragon rouge Arfuruzon, pour enfin le vaincre.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100PL0004",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Joueur neutre",
      "SEQ_NUM": 0
