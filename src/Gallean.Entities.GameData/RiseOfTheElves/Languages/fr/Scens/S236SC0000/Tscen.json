    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Emp Statue Guérisseuse", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Emp Victoire", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Intro des Légions", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller\n\"Des nouvelles des Terres Médianes, Maître. Des Légions de Démons Déchaînés se dirigent dans notre direction. Les Mort-Vivants ont réussi à les repousser jusque sur nos terres.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Ils ne sont certainement pas conscients du fait que ces terres sont les nôtres et que NOUS y vivons. Nous allons leur faire amèrement regretter leur intrusion...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller\n\"En outre, nos espions ont localisé le parchemin de Wotan du côté des territoires nordiques. Il faut envoyer un éclaireur le reprendre aux Elfes ainsi que d'autres espions pour localiser la Rune du Vice, Maître.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Intro des Mort-Vivants", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Seigneur, nous avons repoussé avec succès les Démons Déchaînés hors de nos terres. Ils se sont retirés vers l'ouest, sur le territoire des Légions. Et pourtant, les humains persistent à croire en  leurs piètres assauts.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Gardons à l'esprit que ce sont les Dragons qui détiennent actuellement la Rune du Vice. Nous devons trouver un moyen de la récupérer et repérer le parchemin de Wotan, et enfin, nous pourrons prendre possession de tout le pays.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Capturer Aragonia", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Capturer Aragonia", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Elfes \n\"Les Elfes ne laisseront pas sombrer leur royaume sans réagir, soyez-en sûr !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Loc Hermite", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Ermite \n\"Ne vous approchez pas ! Je ne vous le donnerai pas ! Je vous avertis, ne faites pas un pas de plus !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0008", "ID_STRING": "NAME_TXT", "TEXT": "MC Mutinerie des Nains", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Seigneur, les mineurs refusent de travailler ! Ils affirment que leur travail ne sera utile très longtemps. Nous devons réprimer ces infidèles. La discipline est le seul langage qui leur soit parlant !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0009", "ID_STRING": "NAME_TXT", "TEXT": "MC Soins de la Statue", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Loc Dragon de l'Est", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Dragons \n\"Faites demi-tour si vous tenez à la vie, étrangers, car ici commence le Domaine des Dragons. Tout intrus sera dévoré vif !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Loc Dragon de l'Ouest", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Dragons \n\"Ne vous approchez pas si vous tenez à vos vies, intrus. A partir d'ici s'étend le Domaine des Dragons et nous ne tolérons pas les étrangers !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Capturer Salle des Voleurs", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Voleurs \n\"Libre à vous de penser que vous nous avez arrêtés mais nous somme partout... et quand vous vous y attendrez le moins...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Capturer Burnt", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Chef de bande\n\"N'espérez pas en avoir fini si facilement avec nous. Les voleurs qui nous sont loyaux vous combattrons jusqu'au bout...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Obtenir la Rune", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Nous possédons enfin la Rune du Vice. Nous devons maintenant partir à la recherche du Parchemin légendaire !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Obtenir le Parchemin", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Nous avons le Parchemin ! Nous devons maintenant trouver la Rune.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loc Orque", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller\n\"Seigneur, il semblerait qu'une troupe d'Orques ait installé son campement un peu plus loin. Soyons prudents, il n'est pas rare qu'ils se montrent très agressifs.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loot Tour en ruine", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Les voleurs ont perdu une carte, Seigneur... Il semblerait qu'il y ait bien d'autres retranchements de brigands vers le sud.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Capturer Timoria", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Défenseurs de la Foi\n\"Lorsque les Dragons libéreront la Rune, les infidèles dans votre genre ne seront pas épargnés !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Loc Adeptes", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Les adorateurs de l'Infâme ont incendié nos villes... Ils doivent être châtiés sur le champ.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Pillage de la Prison en Ruine", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Cette tour servait de prison pour les hérétiques et les aliénés... Les murs portent d'étranges inscriptions runiques, tracées avec du sang...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Capturer Khu'brah", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Géants primitifs\n\"Arghhh ! Pourquoi venir voir nous ? Nous vouloir manger vous !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Loc Elfes", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"On nous signale la présence d'Elfes dans cette région ; ils épient chacun de nos mouvements, cela ne fait aucun doute.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Loc Défenseurs de la Foi", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Défenseurs de la Foi\n\"Halte, infidèles ! Rendez-vous et nous vous montrerons la voie de la vérité !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Loc Géant Primitif", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Géant primitif\n\"Arrrgh !, approchez, vous être nourriture maintenant !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Loc Infidèle", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Infidèle\n\"J'ai voyagé loin pour essayer de retrouver la foi et je n'ai trouvé que poussière. Je ne cherche plus maintenant qu'abri et nourriture... Permettez-moi de vous servir et vous ne le regretterez pas...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Emp Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Nombreux sont les Humains infidèles qui peuplent les contrées environnantes, Seigneur. Ils échafaudent leurs plans et accomplissent leurs sombres desseins sur nos terres avec les crapules des environs.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Un humain nous a livré sous la torture que la Rune que nous recherchons pourrait en réalité se trouver chez les Elfes, loin au nord-est. Nous devons immédiatement envoyer un détachement chargé de la récupérer.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001d", "ID_STRING": "NAME_TXT", "TEXT": "MC Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Seigneur, les Ermites des régions avoisinantes envisagent de s'associer aux Géants du Nord pour lancer une offensive sur nos terres. Nous devons absolument parlementer avec eux le plus vite possible !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Quelques-uns de nos colporteurs ont entendu dire que la Rune que nous recherchons est entre les griffes de puissants Dragons. Seigneur, je crains que nous ne soyons obligés de la leur prendre de force...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Victoire des Mort-Vivants", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001f", "ID_STRING": "NAME_TXT", "TEXT": "MC Victoire", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Victoire des Légions", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Camp d'entraînement Draco", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Tous les plus célèbres Guerriers Dragons se sont entraînés ici !", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Echoppe de Chrulen", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Je crois que nous pouvons faire affaire...", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Aux Curiosités Magiques de Leif", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Si vous cherchez une protection magique, vous êtes venus au bon endroit.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Echoppe de Thurin", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Mes objets sont les meilleurs de tout le royaume.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0004", "ID_STRING": "TXT_TITLE", "TEXT": "Camp de Dennar", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0004", "ID_STRING": "TXT_DESC", "TEXT": "Nous rejoindrons votre armée si vous y mettez le prix.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0005", "ID_STRING": "TXT_TITLE", "TEXT": "Echoppe de Thurin", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0005", "ID_STRING": "TXT_DESC", "TEXT": "Comment puis-je vous aider, étranger ?", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0006", "ID_STRING": "TXT_TITLE", "TEXT": "Sanctuaire de Leia", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0006", "ID_STRING": "TXT_DESC", "TEXT": "Je suis spécialisé dans les sorts d'invocation.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0007", "ID_STRING": "TXT_TITLE", "TEXT": "Echoppe de Furren", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0007", "ID_STRING": "TXT_DESC", "TEXT": "Regardez mes marchandises, j'ai peut-être quelque chose qui pourrait vous intéresser.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0008", "ID_STRING": "TXT_TITLE", "TEXT": "Taverne de Laetes", "SEQ_NUM": 0},
