    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutres", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Pas de description de race", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Galarth", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Dans sa jeunesse, ce puissant seigneur tenu bon contre une armée venue de l'enfer et l'a repoussée seul en scellant la porte qui vomissait ces créatures dans notre monde. Il est ensuite devenu souverain de notre royaume.", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Fedroth", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Plus puissante adepte des arts maléfiques de son époque, elle a été tué par l'inquisiteur Vorgel. Mais elle est hélas revenue d'entre les morts et compte bien, comme mort-vivante, soumettre les mortels à ses desseins.", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Dagar", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Zythaar", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Emp obtient le Kraken", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller\n\"Seigneur, la Relique Sacrée nous autorise à prendre le contrôle du légendaire Kraken !\" \n", "SEQ_NUM": 2},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Les Mort-Vivants obtiennent le Kraken", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller\n\"Seigneur, la Relique Sacrée nous autorise à prendre le contrôle du légendaire Kraken !\" \n", "SEQ_NUM": 2},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Emp obtient le Serpent", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \"Seigneur, la Relique Sacrée nous autorise à prendre le contrôle du légendaire Serpent de Mer !\" \n", "SEQ_NUM": 2},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Les Mort-Vivants obtiennent le serpent", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \"Seigneur, la Relique Sacrée nous autorise à prendre le contrôle du légendaire Serpent de Mer !\" \n", "SEQ_NUM": 2},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Emp Intro Créature Marine", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Il y a fort de cela longtemps, avant que n'arrivent les forces de l'Empire et les Hordes des Mort-Vivants, le peuple des Marais et les Barbares se livraient une lutte sans merci pour le contrôle de la région.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "\"Les habitants de l'île racontent comment ils sont parvenus à apprivoiser les créatures légendaires qui peuplent les océans et à les dresser au combat.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Intro des Mort-Vivants", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Il y a fort de cela longtemps, avant que n'arrivent les forces de l'Empire et les Hordes des Mort-Vivants, le peuple des Marais et les Barbares se livraient une lutte sans merci pour le contrôle de la région.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "\"Les habitants de l'île racontent comment ils sont parvenus à apprivoiser les créatures légendaires qui peuplent les océans et à les dresser au combat.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Convoi Mort-Vivants passé", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Seigneur, le convoi est parvenu sans encombre à destination.\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Emp Convoi arrivé à destination", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Seigneur, le convoi est parvenu sans encombre à destination.\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV000a", "ID_STRING": "NAME_TXT", "TEXT": "7e jour : Alerte Emp", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller\n\"Seigneur, l'un de nos convois est en difficulté du côté de la ville de Galdarth ! Le chargement qu'il transporte est de très grande valeur et nous devons nous assurer que celui-ci parvienne sans encombre à destination.\" \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV000e", "ID_STRING": "NAME_TXT", "TEXT": "7e jour : Alerte Convoi de Mort-Vivants", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller\n\"Seigneur, l'un de nos convois est en difficulté aux abords de la ville d'Arkenaso ! Le chargement qu'il transporte est de très grande valeur et nous devons nous assurer qu'il parvienne bien à destination.\" \n", "SEQ_NUM": 0},
