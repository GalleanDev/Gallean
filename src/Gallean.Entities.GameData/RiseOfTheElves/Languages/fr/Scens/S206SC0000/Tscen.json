    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Eclaireur\n\"Seigneur, nous approchons de la ville de Siria. Elle est principalement peuplée de marchands et de marins qui y font escale. Elle est en ce moment sous le contrôle du Peuple du Marais.\"", "SEQ_NUM": 0},
