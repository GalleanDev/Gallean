    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loc Histoire d'Arkenaso", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Eclaireur\n\"Voici la ville d'Arkenaso qui fut autrefois la plus brillante cité du Peuple des Marais ; avant la guerre contre les Barbares du moins... On raconte qu'un objet magique leur donnait un grand contrôle sur les créatures marines.\"", "SEQ_NUM": 0},
