    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loc Histoire de Galdarth", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Eclaireur\n\"Maître, nous approchons de la ville de Galdarth. On raconte que le chef du clan local possède un objet magique lui donnant le contrôle d'une puissante créature...\"", "SEQ_NUM": 0},
