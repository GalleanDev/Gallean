    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO000c", "ID_STRING": "NAME_TXT", "TEXT": "Lieu Saint de l'Ermite", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO000d", "ID_STRING": "NAME_TXT", "TEXT": "Attaque de l'Ecuyer", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO000e", "ID_STRING": "NAME_TXT", "TEXT": "Loups", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO000f", "ID_STRING": "NAME_TXT", "TEXT": "Tour de Zimraan", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO0010", "ID_STRING": "NAME_TXT", "TEXT": "Cachette de Drega Zul", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO0011", "ID_STRING": "NAME_TXT", "TEXT": "Avertissement du Kraken", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Entraînement des Troupes", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Entrez et je ferai de vous des cadavres dignes de ce nom.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Forgeron de Kekkut", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Vous trouverez ici tout l'équipement nécessaire à un guerrier.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Marché de Rivend", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Nous avons toute sorte de marchandises !", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Tour de Zimraan", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0003", "ID_STRING": "TXT_DESC", "TEXT": "J'ai de nombreux sorts d'origine infernale", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutres", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Pas de description de race", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Breasal", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Dans sa jeunesse, ce puissant seigneur tenu bon contre une armée venue de l'enfer et l'a repoussée seul en scellant la porte qui vomissait ces créatures dans notre monde. Il est ensuite devenu souverain de notre royaume.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Uallgarg", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Connu à son époque comme le plus puissant des adeptes des arts maléfiques, ce seigneur a été tué par l'inquisiteur Vorgel. Il est hélas revenu d'entre les morts et compte, bien comme mort-vivant, soumettre les mortels à ses desseins.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Cathal", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Conall", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN000d", "ID_STRING": "NAME_TXT", "TEXT": "Nain", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0019", "ID_STRING": "NAME_TXT", "TEXT": "Ours Polaire", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Emp Le Kraken apparaît", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul \n\"Seigneur ! Nous avons éveillé un monstre des profondeurs ! Fuyons !\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Capturer Fendhil", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Villageois\n\"Le nom de Krath'du... évoque d'horribles souvenirs empreints de douleur et de souffrances !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Capturer Rivend Empire", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Villageois\n\"Nous avons déjà entendu le nom de Krath'du. On dit que pendant les années de terreur, alors qu'il pillait un village, il prit pitié d'une jeune femme...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "\"Elle se tenait là, son ventre comme preuve de l'enfant qu'elle portait. Au lieu de l'occire, il étendit sur elle son influence. Son corps, témoin de la lutte de l'enfant contre l'invasion vampirique, ne put pourtant être changé... Ainsi mourut-elle.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul \n\"Cette histoire semble... un peu trop familière...\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Capturer Kekkut", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Villageois\n\"Vous paierez pour l'invasion du territoire de ce Clan ! J'espère que les Démons que vous recherchez vous dévoreront !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0028", "ID_STRING": "NAME_TXT", "TEXT": "Brigand", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Capturer Kalajit", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Villageois\n\"Les Clans auront vos peaux pour ce que vous avez fait ! Aucune recherche de Démons ne peut justifier un tel saccage... Vous paierez pour cela !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Approache Rivend Empire", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul \n\"Nous approchons de la ville de Rivend, Seigneur. Elle a été lourdement fortifiée ces dernières années pour résister aux attaques des Mort-Vivants. Elle sera difficile à capturer car ses habitants sont habitués à la guerre !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Approache Mort-Vivants Empire", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul \n\"Ceci est l'accès au royaume des Mort-Vivants, Seigneur. Prenez garde ! Les créatures de la nuit sont redoutables... \"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Pillage de le Tour de guet Empire", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "\"La tour porte une inscription en partie illisible... Il est écrit : 'Quand le regard du Nosferat Krath'du s'est posé sur Dame Spectre, le Nosferat déclara : Sois mienne.'  \nSeigneur, quel message ces lignes peuvent-elles transmettre ?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Pillage de l'Abri Abandonné Em", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul \n\"Un ours a trouvé refuge ici récemment mais cette oppressante sensation de mort et les crânes alignés le long du mur du fond prouvent aussi qu'un Vampire s'est installé ici !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Pillage du Labo de l'Alchimiste Empi", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul \n\"Nous n'avons pas de preuves que Krath'du ait pactisé avec les Nains, Seigneur... Nous avons uniquement trouvé de banals instruments magiques claniques.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Pillage du Château en Ruine Emp 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Krath'du \n\"Je t'ai attendue si longtemps, Drega Zul...  Nous devons être semble, comprends-tu ? C'est notre destin de régner sur ce royaume, ensemble !\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Message des Mort-Vivants", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "\"Seigneur, l'Empire a retrouvé Krath'du... Nous devons le capturer sur le champ, de crainte que les troupes affaiblies de l'Empire ne le laissent s'échapper !\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Lendemain du Pillage de l'Empire", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Sire Geldwin \n\"Nous avons appris la perte de l'un de vos précieux chefs ! Nous sommes ici pour remplacer ceux qui sont tombés au combat, seigneur.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Intro des Mort-Vivants", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "\"Seigneur ! Le Nosferat Krath'du a pris la fuite ! Il a quitté la ville dans la journée, accompagné de ses affidés... Ses domestiques affirment qu'il est parti rendre visite à son amie, Drega Zul, pauvre hère mi-humain, mi-mort-vivant née de sa main.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "\"Il y a de cela longtemps, il a jeté un sort à la mère de la créature alors qu'elle portait l'enfant. L'embryon mortel est alors devenu le monstre qu'il est aujourd'hui. Nous devons l'arrêter avant qu'il ne répande davantage le poison des ténèbres !\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Intro de l'Empire", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul \n\"Seigneur, je vous ai entraîné et servi pendant des années mais l'heure est venue pour moi de venger la mort de mon père...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "\"Il y a déjà plusieurs années que le Nosferat l'a sauvagement assassiné et qu'il a fait de moi ce que je suis aujourd'hui... Je dois venger sa mort ! Je vous en conjure, aidez-moi à trouver ce démon !\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Elle a raison, Seigneur. Escaladons ce mur, nous devons nous lancer à l'assaut des Mort-Vivants. Ils sont coupables de tant de crimes atroces contre notre peuple, à eux maintenant de subir notre courroux !\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Tour de guet de l'Empire", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Ecuyer Renégat\n\"Cette tour n'est pas ouverte aux soldats de l'Empire !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Tour de guet des Mort-Vivants", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Ecuyer Renégat\n\"Alerte ! Dégainez vos armes, les Mort-Vivants nous attaquent !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Approache Rivend Mort-Vivants", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Gardes Lanciers\n\"Sonnez l'alarme ! Les Mort-Vivants approchent ! Alertez les Mages !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0036", "ID_STRING": "NAME_TXT", "TEXT": "Lancier de Rivend", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Passe des Clans", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Géant des pierres\n\"Vous être sur le territoire des Clans et vous n'avez rien à y faire... Partez ou vous subirez les conséquences de votre obstination !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN003a", "ID_STRING": "NAME_TXT", "TEXT": "Ecuyer Renégat", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Approache Fendhil Empire", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Ecuyer Renégat\n\"Ne vous approchez pas de notre cité, soldat de l'Empire ! Notre peuple n'acceptera pas de plier l'échine sous votre tyrannie !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Approache Fendhil Mort-Vivants", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Ecuyer Renégat\n\"N'espérez pas que les habitants de cette ville accepteront de se rendre sans combattre ! Préparez-vous à mourir, vermine de l'au-delà !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN003c", "ID_STRING": "NAME_TXT", "TEXT": "Lancier", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Lieux Saints de l'Ermite", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Ermite \n\"Ceux dont les cours sont impurs ne peuvent fouler ce sol sacré ! Il est réservé aux guerriers choisis par Wotan... Et je vais purifier ces lieux de votre présence !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001a", "ID_STRING": "NAME_TXT", "TEXT": "L'écuyer attaque les Mort-Vivants", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Ecuyer Renégat\n\"Puissent les forces de la lumière vous détruire, ignoble Mort-Vivants !\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN003e", "ID_STRING": "NAME_TXT", "TEXT": "Chef de bande", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Avertissement du Loup", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "\"Seigneur, les gens du village croient en une légende selon laquelle un loup-garou erre sur ces terres\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Empire Jour 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"L'informateur que nous avons envoyé chez les Mort-Vivants nous fait savoir qu'un certain Seigneur Krath'du aurait disparu récemment... Il s'agit peut-être de l'abominable boucher que nous recherchons !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Victoire de l'Empire", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0041", "ID_STRING": "NAME_TXT", "TEXT": "Ecuyer Renégat", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Pillage de l'Abri Abandonné Mo", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "\"Krath'du est passé par ici ! Les crânes des cadavres dont il s'est repu ornent les murs. Quoi qu'il en soit, rien ici ne semble indiquer la direction qu'il a prise.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Pillage du Labo de l'Alchimiste Mort", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "\"Rien à signaler, Seigneur. Seulement quelques objets magiques appartenant aux Nains.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Pillage du Château en Ruine Mor 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Krath'du \n\"Ne pensez pas que vos traditions archaïques vous sauveront, Mort-Vivants ! Je suis en train de créer une race supérieure avec mon aimée, Drega Zul. Je l'attends, et quand elle sera là, vous périrez tous !\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0044", "ID_STRING": "NAME_TXT", "TEXT": "Ecuyer Renégat", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Message de l'Empire", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "\"Les armées des Mort-Vivants ont repéré Krath'du ! A l'attaque !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Pillage du Château en Ruine Emp 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul transformé\n\"Je comprends mieux maintenant, mon tendre Krath'du... Notre destin est de rester ensemble. \"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Seigneur ! Krath'du le Diabolique avait prévu depuis le début de nous attirer dans ce piège et d'ensorceler Drega Zul ! Nous devons persister malgré notre faiblesse... Nous devons exterminer Krath'du pour briser le sort qu'il lui a jeté !\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "\"Il faut garder espoir, seigneur, les renforts arrivent.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0049", "ID_STRING": "NAME_TXT", "TEXT": "Chef de bande", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Attaque Gardes Rivend1", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0026", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul \n\"Maintenant que nous avons porté le premier coup, les représailles Humaines ne devraient plus tarder... Nous ferions mieux de quitter cet endroit à moins d'être prêts à la guerre !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Attaque Gardes Rivend2", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul \n\"Maintenant que nous avons porté le premier coup, les représailles Humaines ne devraient plus tarder... Nous ferions mieux de quitter cet endroit à moins d'être prêts à la guerre !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Capturer Rivend Mort-Vivant", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "\"Les Humains savent tout des agissements de Krath'du... Il se pourrait qu'il ait contaminé beaucoup plus d'innocents que nous n'en avions comptés ! Nous devons à tout prix poursuivre nos efforts.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Capturer Fendhil Mort-Vivant", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0029", "ID_STRING": "POPUP_TXT", "TEXT": "\"Seigneur, ces villageois ignorent tout des derniers agissements de Krath'du... Personne ici ne l'a vu depuis plusieurs années.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN004c", "ID_STRING": "NAME_TXT", "TEXT": "Lancier", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Pertes des Mort-Vivants", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002a", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller \n\"Krath'du est toujours en vie, et il ne fera route vers l'au-delà avant d'avoir occis Drega Zul. Il a l'intention de semer la panique au sein des Hordes des Mort-Vivants ! Nous devons dès à présent veiller à notre protection...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002b", "ID_STRING": "NAME_TXT", "TEXT": "Drega Zul Capture Fendhil", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN004f", "ID_STRING": "NAME_TXT", "TEXT": "Loup", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Victoire2 des Mort-Vivants", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002c", "ID_STRING": "POPUP_TXT", "TEXT": "\"Krath'du l'infâme est passé de vie à trépas... Le sang sacré de notre race ne coulera plus désormais.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0050", "ID_STRING": "NAME_TXT", "TEXT": "Loup", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002f", "ID_STRING": "NAME_TXT", "TEXT": "Drega s'approche de Krath'du", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "Krath'du \n\"Je t'ai attendue si longtemps, Drega Zul...  Nous devons être semble, comprends-tu ? C'est notre destin de régner sur ce royaume, ensemble !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul \n\"Je comprends mieux maintenant, mon Krath'du... Nous sommes destinés à rester ensemble.\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "\"Seigneur ! Krath'du le démoniaque avait prévu depuis le début de nous attirer dans ce piège et d'ensorceler Drega Zul ! Nous devons persister malgré notre faiblesse. Nous devons conjurer le sort qu'il lui a jeté !\"", "SEQ_NUM": 5},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0030", "ID_STRING": "NAME_TXT", "TEXT": "Pillage du Château Neutralisé Mort-", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0031", "ID_STRING": "NAME_TXT", "TEXT": "Und Apparition du Kraken", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0031", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller\n\"Seigneur ! Nous avons tiré un monstre des profondeurs de son sommeil ! Vite, fuyons !\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0032", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loc Conseil de Krath'du", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0032", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul \n\"Cette zone a été dévastée par quelque force maléfique, Seigneur... Approcherions-nous de Krath'du ?\"\r \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0033", "ID_STRING": "NAME_TXT", "TEXT": "Und Loc Krath'du", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0033", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller\n\"Seigneur, cette région a été ravagée par les légions des mort-vivants... Krath'du est sûrement dans les parages.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0058", "ID_STRING": "NAME_TXT", "TEXT": "Ermite", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0035", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loc Avertissement du Kraken", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0035", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul \n\"Attention, Seigneur. Des Krakens ont été repérés dans la région. Nous ferions mieux de faire demi-tour !\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0059", "ID_STRING": "NAME_TXT", "TEXT": "Nain", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0036", "ID_STRING": "NAME_TXT", "TEXT": "Und Loc Avertissement du Kraken", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0036", "ID_STRING": "POPUP_TXT", "TEXT": "Conseiller\n\"Attention, seigneur ! Des Krakens ont été repérés dans cette région. Nous devrions faire demi-tour !\"", "SEQ_NUM": 0},
