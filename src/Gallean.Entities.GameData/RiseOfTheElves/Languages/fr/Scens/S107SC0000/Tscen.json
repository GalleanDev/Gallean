      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107PL0000",
      "ID_STRING": "DESC_TXT",
      "TEXT": "Dans sa jeunesse, ce puissant seigneur repoussa, seul, une arm\u00E9e des Enfers jusqu\u0027\u00E0 la faille dont elle avait jailli. Il devint ainsi le souverain de ces terres.",
