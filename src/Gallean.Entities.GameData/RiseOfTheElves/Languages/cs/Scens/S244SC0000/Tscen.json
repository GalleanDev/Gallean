    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244LO0005", "ID_STRING": "NAME_TXT", "TEXT": "Zpráva od Paní", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244LO0006", "ID_STRING": "NAME_TXT", "TEXT": "Černokněžník", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244LO0007", "ID_STRING": "NAME_TXT", "TEXT": "Nebeský blesk", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244LO0008", "ID_STRING": "NAME_TXT", "TEXT": "Nebeský blesk dvě", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244LO0009", "ID_STRING": "NAME_TXT", "TEXT": "Lady Spektra jedna", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244LO000a", "ID_STRING": "NAME_TXT", "TEXT": "Odejít z ostrova", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244LO000b", "ID_STRING": "NAME_TXT", "TEXT": "Legie převlékají kabát", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244LO000c", "ID_STRING": "NAME_TXT", "TEXT": "Skřeti se objevují", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Sllatův obchod", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Moje zboží ti v tvém poslání pomůže.", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Niborova věž", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244SI0003", "ID_STRING": "TXT_DESC", "TEXT": "\"Mohu tě ochránit před paní Spektrou a Králem nebes.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutrální", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Žádný popis", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Goar", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Tento mocný pán se zamlada samojediný postavil armádě pekelné a jednou rukou ji zničil, neboť zapečetil bránu, jež vojska na tento svět přiváděla. Poté se stal nezávislým vládcem říše.", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Ekrezem", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Každé dítě se třese, zaslechne-li toto neblahé jméno - tento vládce pekel totiž proslul nezřízenou krvežíznivostí. Na jedné hostině, pořádané na počest Bethrezena a jeho vítězství nad královstvím světla, prý pozřel 1000 otroků.", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Ardobert", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN000f", "ID_STRING": "NAME_TXT", "TEXT": "Velký skřet", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN0017", "ID_STRING": "NAME_TXT", "TEXT": "Lupič", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN0019", "ID_STRING": "NAME_TXT", "TEXT": "Lupič", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN001b", "ID_STRING": "NAME_TXT", "TEXT": "Lupič", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN001c", "ID_STRING": "NAME_TXT", "TEXT": "Lesní elf", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN001f", "ID_STRING": "NAME_TXT", "TEXT": "Kentauří kopiník", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN0021", "ID_STRING": "NAME_TXT", "TEXT": "Kentauří kopiník", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Blahopřejeme", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Rytíř na Pegasovi\n\"Bitva zuřila, dokud bezduché tělo Krále nebes nepadlo na zem! Lidská říše dokázala svou sílu a přibrala pod svou správu další království. Ale co to? Tělo Krále nebes mizí!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN0029", "ID_STRING": "NAME_TXT", "TEXT": "Lesní elf", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Kentaur útočí", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Kentauří kopiník\n\"Zničte Říši lidí! Útočte nelítostně!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Text vítězství", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Učedník\n\"Nebeská znamení králi cosi vzkazují - zjistili jsme, že Říše lidí je skrznaskrz zkažená! Uctívej Xenose, Krále nebes!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Elfí varování", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Temný pán\n\"Král nebes? To je slabý pomatenec! Přebývá za lesem! Hádám ale, že tě elfové nenechají naživu dost dlouho, aby ses s ním mohl setkat. Cha, cha, cha, chá!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Skřetí stráž", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Skřetí stráž DVĚ", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Nový Gamor", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Ashkael\n\"Když jsme porazili Lady Spektru z Nového Gamoru, získali jsme zpět i tajemství kacířských mágů.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN0032", "ID_STRING": "NAME_TXT", "TEXT": "Mistrovský lupič", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Zpráva z Nového Gamoru jedna", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Lady Spektra\n\"My... ssse... vzdáváme.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Xenoxův hrad, zpráva jedna", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Lovec čarodějnic\n\"Legie zatracenců představují vše, proti čemu jsme bojovali. Ještě to neskončilo!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Útok bleskem", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Prokletí Nového Gamoru", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Lady Spektra\n\"Nový Gamor nikdy nepadne do rukou cizinců! Ochutnej hněv zakázaného měsssta, kam nikdy nevkročíš!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Sorenburg", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Elfí hraničář\n\"Elfů je mnoho a jsou nelítostní! Vyženeme vás z našeho panství!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Přízračná zpráva", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Duch\n\"Obrať ssse zpět, mladíku, a můžeš ještě ssspatřit východ ssslunce. Přissstup blíž, a nedožiješ ssse ani dnešního sssoumraku!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Přízračná zpráva Legiím", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Duch\n\"Lady Ssspektra nemůže prohrát! Násssleduj její temnou ssslávu v Novém Gamoru, ssstaň ssse jedním z nás! Vzdej ssse kacířssského života! Nejdříve rozbijeme tvou ssstávající podobu a učiníme z tebe něco nádherného! Neboj ssse!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Zvláštní pobyt dvě", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Temný pán\n\"Znič démony! Pošli je zpátky do jejich ubohého vězení!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Lady Spektra", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Lady Spektra\n\"Vzdejte hold paní Ssspektře z Nového Gamoru! Uvědomte sssi sssílu sssvých kouzel a ssskloňte ssse před mou temnou mocí, kacíři!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Černokněžník", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Černokněžník\n\"Této věže jsme se zmocnili ve jménu chaosu. Lidská říše nikdy nemůže zvítězit nad silami zla!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Příběh Říše lidí", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Paladin\n\"Musíme najít a zničit Xenovo království! Xenos, zvaný Král nebes, je nepřítelem Říše lidí! Napovídal elfům, že se chystáme zničit jejich lesní domovy, jen abychom se k němu nedostali. Musíme se připravit na útok.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Pegas", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Lovec čarodějnic\n\"Král nebes nás pomstí!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Druhá zpráva od Pegase", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Lovec čarodějnic\n\"Legie zatracenců? To jsme měli vědět! Poté, co ta liška podšitá zabrala Nový Gamor, začaly po nás určitě pátrat zlé síly!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Varování před Novým Gamorem", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Lady Spektra\n\"Nový Gamor sssi ssstřeží sssvé hranice a každý, kdo je překročí, bude proklet!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Nebeský blesk", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Nebeský blesk dvě", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Rytíř na Pegasovi\n\"Král nebes ví, že jsme tady! Pospěš si!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Lady Spektra jedna", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0023", "ID_STRING": "POPUP_TXT", "TEXT": "Arciďábel\n\"Lady Spektra ví, že po ní jdeme! Nevadí, najdeme ji a vezmeme si, co nám náleží.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0024", "ID_STRING": "NAME_TXT", "TEXT": "Příběh Legií", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0024", "ID_STRING": "POPUP_TXT", "TEXT": "Ashkael\n\"Jen blázen, který dlouho nepřežije, mohl spáchat nemyslitelné - okrást Legie zatracenců! Naši mágové postrádají nejvzácnější svitky. Ta ztráta velmi oslabila magický řád! Musíme své věci získat zpět!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Odhalení 7", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Mág\n\"Král nebes vytváří určitou energii. Téměř cítím, že jeho přítomnost nám zabraňuje dosáhnout plného magického potenciálu!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Odejít z ostrova", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0026", "ID_STRING": "POPUP_TXT", "TEXT": "Mág\n\"Okamžitě opusťte náš ostrov! Jsme věrní Králi nebes a cizince tu nestrpíme. Už jsem tvým znaveným nohám dal sílu k pohybu - používej ji moudře. A nyní odejdi!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Vévoda převléká kabát", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Vévoda\n\"Blázni! Vědět, kým Lady je, znamená poznat to nejčistší zlo! Její božský dotyk přináší extázi a vyhýbat se mu je čiré bláznovství! Legie zatracenců padnou do rukou jedinečné Lady Spektry!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí převléká kabát", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "Arcimág\n\"Proč útočíme na tohle království? Král nebes je přece milý a spravedlivý člověk. Věřím, že útočníkem je Říše lidí! Ve vašem nespravedlivém poslání vám nemohu a ani nechci pomoci!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Nová událost", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN0058", "ID_STRING": "NAME_TXT", "TEXT": "Kopiník", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN005c", "ID_STRING": "NAME_TXT", "TEXT": "Skřetí stráž", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN0061", "ID_STRING": "NAME_TXT", "TEXT": "Kopiník", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN006c", "ID_STRING": "NAME_TXT", "TEXT": "Kultista", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN0070", "ID_STRING": "NAME_TXT", "TEXT": "Spektra", "SEQ_NUM": 0},
