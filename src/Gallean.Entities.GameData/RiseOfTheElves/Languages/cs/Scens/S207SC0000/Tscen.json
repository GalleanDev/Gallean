    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Zpráva z Avonie A", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Lovec čarodějnic z Avonie\n\"To snad ne! Když jsem posledně zahlédl takového jako ty, vypukla válka!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Zpráva z Avonie B", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Lovec čarodějnic z Avonie\n\"Skřeti už obsadili nížiny!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Zpráva z Avonie C", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Lovec čarodějnic z Avonie\n\"Barbaři, jimž pomáhal někdo zvenčí, dobyli vysočinu!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Zpráva z Aragonie", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Obyvatel Aragonie\n\"Před dávnými časy se toto území pokusili osídlit lidé, ale nepovedlo se jim to ani na druhý pokus. Víme, že první kolonie se chtěla vrátit do vlasti, její obyvatelé však byli prohlášeni za rebely a vlastní bratři je odsoudili k smrti.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Edras", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Páže \n\"Původně jsme tu chtěli dolovat a využívat veškeré bohatství země, která je bohatá na zlato a drahokamy. Bývalo to mírumilovné místo - než sem přišel ten cizinec. Doma se už nudil a tak se rozhodl, že se usadí právě tady!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Vítězná událost 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Vítězná událost 3", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Lesní tvrz - text", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "\n\"Sousednímu násilnickému kmeni vládne tajemný cizinec z jiného světa. Víme o něm jen málo a nikdo, koho jsme poslali na výzvědy, se nikdy nevrátil!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Kopiník nabádá k ústupu", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Kopiník  \n\"Tomuto území vládnu já, vetřelče! Ihned odejdi - mezi vlky a pavouky!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Avonia nabádá k ústupu", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Lovec čarodějnic z Avonie\n\"Do našeho města tě nikdy nepustíme! Jestli tam zkusíš vniknout, rozpoutáš strašlivou bitvu!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Horské kmeny, den první", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Bragon Silák \n\"Kdysi dávno se tu lidská říše pokoušela vybudovat osadu, ale její obyvatelé navzdory rozkazům uprchli a nikdy se už nevrátili. Byla vyslána druhá kolonie, ale po té se také slehla země!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0010", "ID_STRING": "NAME_TXT", "TEXT": "HK den desátý", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Kopcový obr \n\"Je mi tu něco povědomé, ale nevím přesně co... někoho či něco tu důvěrně znám!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Legie, den první", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Beliel\n\"Po celé zemi jsou roztroušeny lidské kosti - kdysi tu tedy museli žít lidé. Nyní však po nich není ani vidu ani slechu, jen ty kosti vyprávějí o porážce a neúspěchu!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Legie, den 12", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Baronka\n\"Ty kosti lidských vojáků jsou úplně všude! Podle jedné pověsti tuto zemi kdysi chránil jistý kmen, jemuž vládl nějaký cizinec. Myslím, že lidé narazili právě na tento kmen a jejich pozůstatky napovídají, jak to všechno dopadlo!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Zpráva od nemrtvých", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Kostlivec \n\"Můj pane, země je poseta kostrami koní, které sežehl blesk! Tyto končiny musí chránit jakási mocná síla! Ať je však tím neviditelným strážcem kdokoliv, stejně tahle krajina padne do rukou Zástupů nemrtvých!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví čtrnáct", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Duch\n\"Cítím, že tu někde přebývají duše, které nenalézají klid. Padly rukama svých vlastních soukmenovců z řad Říše lidí. Chtějí nás varovat před těmi, kdož ještě zbyli! Všechny blesky v těchto končinách ovládá nějaký cizinec!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Zpráva od barbarů", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Barbarský válečník \n\"Ten, kdo vládne živlům, žádá, abyste se vzdálili! Ustupte - nebo padněte!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Lok. opuštění země", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Barbarský náčelník \n\"Odejděte odsud jednou provždy! Jestli neustoupíte z vlastní vůle, budete k tomu donuceni! Můj pán vládne všem bleskům a dokáže vás sežehnout na prášek - jestli vás tedy neporazím první já!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0018", "ID_STRING": "NAME_TXT", "TEXT": "HK, den 1b", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "\"Horské věže se zmocnili skřeti! Na samém vrcholku je ukryt pár magických bot, který nám byl v minulosti velmi užitečný. Nevíme však, kolik nepřátel tu na nás čeká, ale stejně bychom se měli pokusit ty boty získat.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Furrenův kvelb", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Jak ti mohu pomoci, cizinče?", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Underův krámek", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Moje zboží je nejlepší široko daleko.", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Luggenův tábor", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Zaplatíš-li, moji žoldnéři se k tobě rádi přidají.", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Xennonův tábor", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Moji zuřiví válečníci jsou vycvičeni, aby poslouchali!", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0004", "ID_STRING": "TXT_TITLE", "TEXT": "Malavienova věž", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0004", "ID_STRING": "TXT_DESC", "TEXT": "Má kouzla jsou nejmocnější v kraji.", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0005", "ID_STRING": "TXT_TITLE", "TEXT": "Metakův tábor", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0005", "ID_STRING": "TXT_DESC", "TEXT": "Za jistý poplatek mohu tvé vojáky vycvičit.", "SEQ_NUM": 0}
  ]
}
