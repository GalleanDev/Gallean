    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Hospoda a zbrojírna", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Nearburtova hospoda a zbrojírna ti nabízí to nejlepší pivo a zbraně v celé zemi.", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Údolní magický obchod", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Vlastním všemožná kouzla a možná že tě některá naučím.", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229SI0004", "ID_STRING": "TXT_TITLE", "TEXT": "Golronův tábor", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229SI0004", "ID_STRING": "TXT_DESC", "TEXT": "Za určenou cenu vycvičím tvé vojáky.", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229SI0005", "ID_STRING": "TXT_TITLE", "TEXT": "Lesní zlodějský obchod", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229SI0005", "ID_STRING": "TXT_DESC", "TEXT": "\"Kapsáři a zloději budou zastřeleni.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutrální", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Žádný popis", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Calderik", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Tento nejvyšší z trpasličích pánů si získal věhlas díky nesmírné síle v boji a odvaze tváří v tvář nesmírné přesile. Jednou po celých sedm dní a nocí bojoval s mocným rudým drakem Arfuruzonem, než nad ním konečně zvítězil.", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Ahndrash", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Tento pán svého času proslul jako nejmocnější z adeptů černého umění. Jeho hrůzovládě sice učinil přítrž inkvizitor Vorgel, který ho zabil, avšak nyní zloduch opět povstal coby nemrtvý, sžírán neutuchající touhou podrobit každého smrtelníka své vůli.", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Cloderik", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Zythaar", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229UN0006", "ID_STRING": "NAME_TXT", "TEXT": "Jonas", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229UN000c", "ID_STRING": "NAME_TXT", "TEXT": "Frederik", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229UN0018", "ID_STRING": "NAME_TXT", "TEXT": "Zvěd", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229UN001e", "ID_STRING": "NAME_TXT", "TEXT": "Vlk", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229UN0021", "ID_STRING": "NAME_TXT", "TEXT": "Kraken", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0000", "ID_STRING": "NAME_TXT", "TEXT": "HK prohrávají", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Prohra nemrtvých", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0002", "ID_STRING": "NAME_TXT", "TEXT": "HK lok. lidské území", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "\"Buď opatrný, když kráčíš po lidském území, pane. Obyvatelé se budou bránit!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Lok. R Jack útočí", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229UN0027", "ID_STRING": "NAME_TXT", "TEXT": "Dezertéři", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí svobodných, bod 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Vesničané\n\"Ten starý kostel je prý plný vlkodlaků a upírů.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Vypnout vyloupený starý kostel", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Lok. přepadení zloději", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Mistrovský lupič\n\"Ha, ha! To je přepadení! Teď tě zabijeme!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0008", "ID_STRING": "NAME_TXT", "TEXT": "HK lok. varování - ještěrané1", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "\"Vstupujeme na nebezpečné území, můj pane. Ještěranský lid je velmi nebezpečný. Co kdybychom se vrátili?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229UN002b", "ID_STRING": "NAME_TXT", "TEXT": "Kmak Silný", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0009", "ID_STRING": "NAME_TXT", "TEXT": "HK lok. varování - ještěrané2", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "\"Vstupujeme na nebezpečné území, můj pane. Ještěranský lid je velmi nebezpečný. Co kdybychom se vrátili?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Hg'nufy", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Obyvatelé bažin\n\"Proč ty na nás teď útočit? Než ty přijít, my bývat mírumilovný lid!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Lok. průchod 1 varování", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Drak\n\"Přistup blíže a úctu drakovi vzdej... a dovol, ať masíčko tvé ochutnám!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Lok. průchod2 varování", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Drak\n\"Přistup blíže a úctu drakovi vzdej... a dovol, ať masíčko tvé ochutnám!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví - lok. elfí území1", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "\"Pane, vypadá to, že před námi leží nějaké elfí sídlo.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229UN0031", "ID_STRING": "NAME_TXT", "TEXT": "Ještěran", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví - lok. elfí území2", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "\"Pane, vypadá to, že před námi leží nějaké elfí sídlo.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví - lok. elfí území3", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "\"Pane, vypadá to, že před námi leží nějaké elfí sídlo.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0010", "ID_STRING": "NAME_TXT", "TEXT": "HK intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Ano, dozrál čas, aby se náš lid ujal tohoto království. Doneslo se k nám, že prý vzrůstá moc oživlých mrtvol. Jejich nový velitel pan Tace už může být příliš silný - teď jej musí zničit princ Bjorn.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví - intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "\"Můj pane, pana Tace jsme postavili do čela vojsk. Vše jde přesně podle plánu - prozatím. Než však budeme moci celou expanzi podniknout, budeme muset pana Tace vyslat, aby zavraždil prince Bjorna.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229UN0035", "ID_STRING": "NAME_TXT", "TEXT": "Ještěran", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Vypnout dračího strážce 1 - mrtev", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Vypnout dračího strážce 2 - mrtev", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí svobodných, bod 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Vesničané\n\"Lidé se nikdy nevzdají! Slibujeme, že se pomstíme za tu nespravedlnost, kterou jste na nás uvrhli!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Lok. průchod1 kouzlo", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Lok. průchod2 kouzlo", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Objevení lupiče", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Zapnout objevení vlka", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Objevení vlka", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV001a", "ID_STRING": "NAME_TXT", "TEXT": "HK obrana Bjorna", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV001b", "ID_STRING": "NAME_TXT", "TEXT": "HK lok. elf1", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "\"Můj pane, vypadá to, že před námi leží nějaké elfí sídlo.\"", "SEQ_NUM": 0},
