    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231UN0019", "ID_STRING": "NAME_TXT", "TEXT": "Kraken", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231UN001a", "ID_STRING": "NAME_TXT", "TEXT": "Lupič", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Konrád", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Tento mocný pán se zamlada samojediný postavil armádě pekelné a jednou rukou ji zničil, neboť zapečetil bránu, jež vojska na tento svět přiváděla. Poté se stal nezávislým vládcem říše.", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Xhmaah", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Každé dítě se třese, zaslechne-li toto neblahé jméno - tato vládkyně pekel totiž proslula nezřízenou krvežíznivostí. Na jedné hostině, pořádané na počest Bethrezena a jeho vítězství nad královstvím světla, prý pozřela 1000 otroků.", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231PL000b", "ID_STRING": "NAME_TXT", "TEXT": "Draashel", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231PL000b", "ID_STRING": "DESC_TXT", "TEXT": "Tato paní svého času proslula jako nejmocnější z adeptů černého umění. Její hrůzovládě sice učinil přítrž inkvizitor Vorgel, který ji zabil, avšak nyní zrůda opět povstala coby nemrtvá, sžírána neutuchající touhou podrobit každého smrtelníka své vůli.", "SEQ_NUM": 0},
