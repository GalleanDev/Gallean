    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231UN0101", "ID_STRING": "NAME_TXT", "TEXT": "Sthlankenský barbar", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231UN0103", "ID_STRING": "NAME_TXT", "TEXT": "Jerellovi ještěranští strážci", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231UN0105", "ID_STRING": "NAME_TXT", "TEXT": "Sthlankenský ještěran", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231UN0107", "ID_STRING": "NAME_TXT", "TEXT": "Mořská panna", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231UN010d", "ID_STRING": "NAME_TXT", "TEXT": "Isuel", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231UN010f", "ID_STRING": "NAME_TXT", "TEXT": "Pendujab", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231UN0111", "ID_STRING": "NAME_TXT", "TEXT": "Maurezen", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231UN0113", "ID_STRING": "NAME_TXT", "TEXT": "Vlk", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231UN0115", "ID_STRING": "NAME_TXT", "TEXT": "Vlk", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231UN0117", "ID_STRING": "NAME_TXT", "TEXT": "Vlk", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231UN011a", "ID_STRING": "NAME_TXT", "TEXT": "Lesní elf", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231UN011c", "ID_STRING": "NAME_TXT", "TEXT": "Draashel", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231UN011e", "ID_STRING": "NAME_TXT", "TEXT": "Mistrovský lupič", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231UN0121", "ID_STRING": "NAME_TXT", "TEXT": "Mořská panna", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí vítězí", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Upíří věž", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "\"Tuto oblast obklopuje všudypřítomný zápach smrti. Není pochyb, že tu přebývají upíři!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Vypnout věž upírů", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Rytíř na Pegasovi\n\"Ve jménu Nejvyššího otce! Jsme tu, abychom přeměnili tyto země a zbavili je barbarských kmenů, které ji poskvrňují!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Rytíř na Pegasovi\n\"Lid barbarského kmene Sthlanken obývá malou část těchto zemí. Žije bok po boku se zrůdnými ještěrany. Musíme jim bez milosti ukázat tu pravou cestu!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Dračí krypta", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "\"Vypráví se, že elfové uctívají padlého draka, v jehož sluji leží mnohé poklady. Prozkoumáme ji, pane?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Místo hnízdiště gryfů", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "\"Měli bychom být opatrní. Nacházíme se v hnízdišti gryfů, kteří jsou velmi agresivní, pokud brání své domovy. Elfové by nám určitě zakázali vstupovat do věže s hnízdy.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Legie - intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Vévoda\n\"S pomocí Bethrezena se zmocníme všech těchto zemí - přetvoříme je k obrazu svému. Spálíme města a vesnice a budeme terorizovat venkov!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví - intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Mrtvý rytíř\n\"Mortis rozkázala, abychom do těchto zemí vnesli mor a zničili vše, co je dobré a čisté. Musíme jí slepě sloužit, a proto bez milosti vyplňme její vůli!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Elfí hrad Legie", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Kentauří stráž\n\"Držte se dál od našeho území, otroci zatracení! Nikdy neuspějete! Náš dračí bůh nás chrání i ze záhrobí a pomstí nás. Odejděte odsud a už se nevracejte!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí elfího hradu", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Elfové\n\"Toho budete litovat, a zjistíte, že zemřete příliš brzy!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Kraken1", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "\"V tomto moři přebývá obrovský kraken, jenž lační po lodích, které zabloudí příliš daleko. Svou kořist si dobře střeží! Měli bychom pokračovat jen s největší opatrností, můj pane.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Hřbitov Říše lidí", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Rytíř na Pegasovi\n\"Tuto prokletou zemi obklopuje strašlivé zlo. Musíme to tu vyčistit!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví k magické věži", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Galrifius\n\"Mortis mi jednou pomohla získat nový život a nyní pomohu já tobě.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Barbarská věž kouzel", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Barbaři\n\"Odstup! Myslíš, že ti jen tak dovolíme, abys nám bez boje bral naši půdu? Ha, ha, ha!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí přináší předmět mágovi", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Galrifius\n\"Nemám žádnou možnost, jak se dostat ke své sestře Hannah, ale kdybys jí donesl tento klíč, byl bych ti nesmírně zavázán. Bezpochyby se ti odmění. Nebudeš litovat, že ses toho zhostil!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - klíč mágovi", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Hannah\n\"Ach, děkuji ti! Prostě ti nemohu dost poděkovat! Prosím, vezmi si tohle jako důkaz mé nehynoucí vděčnosti!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Léčení Legií", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Zabití krakena pro barbara", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Barbar\n\"Modlím se, aby bohové zničili krakena - nestvůru, která povraždila mou rodinu! Já jsem slabý a nemocný, a proto se již nemohu pomstít. Jestli se ti ale tu zrůdu podaří zničit, prokáži věrnost jak tobě, tak i tvému bohu.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Zabití krakena pro barb2", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Barbar\n\"Strašlivý kraken je konečně zabit - jsem ti navěky zavázán!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Cannonu", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Barbaři\n\"Jak se opovažuješ vniknout na území, jež nám po právu náleží?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Vesničan brání zlato", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Vesničané\n\"Hej, vypadni odtud - to je naše zlato a my si je ubráníme!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Zabité obranné síly vesničanů jdou", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Sthlankenské vesnice", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Barbaři\n\"Blázni! Myslíte, že můžete beztrestně pronikat do našich měst a vesnic? Teď pocítíte hněv našich bratří!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Legie přinášejí mágovi předmět", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Galrifius\n\"Ano, myslím, že to zvládneš. Co nejrychleji doruč tento klíč mé sestře do svatyně Hannah ve tvé vlasti a dostane se ti štědré odměny.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Legie - klíč mágovi", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Hannah\n\"Děkuji ti, tvá oddanost mne těší! Jako odměnu za své služby si vezmi tohle!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Dobyto 40% země.", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Přivlastnil sis 40% země.", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Elfí svatá půda", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Elfové\n\"Nevstupujte na naši posvátnou půdu, cizinci. Byli jste varováni!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Dobyti Junfru", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Barbaři\n\"To je naše město! Naši bohové nás ochrání!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Jerellova stráž", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Ještěran\n\"Buďto si prohlédneš Jerellovo zboží, nebo tě rozsekám na maděru!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Navštívit Jerellovo zboží", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Galrifiova kouzla", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Mám tu spoustu vzácných kouzel. Za patřičnou cenu tě je mohu naučit.", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0022", "ID_STRING": "NAME_TXT", "TEXT": "Léčivá kouzla legií", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0022", "ID_STRING": "POPUP_TXT", "TEXT": "\"Vypadá to, že si tu Legie zřídily jakousi svatyni. Měli bychom se od toho nečistého místa raději držet dál...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Elfí hrad Říše lidí", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0023", "ID_STRING": "POPUP_TXT", "TEXT": "Elfové\n\"Nerušte nás, služebníci Říše lidí. Jestli se nás pokusíte napadnout, vaši bohové vás neuchrání před hněvem našeho dračího boha.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Tábor Velké nohy", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0002", "ID_STRING": "TXT_DESC", "TEXT": "U nás se cvičili ti nejlepší gryfové z království.", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0024", "ID_STRING": "NAME_TXT", "TEXT": "Elfí hrad nemrtví", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0024", "ID_STRING": "POPUP_TXT", "TEXT": "Elfí stráže\n\"Ztraťte se, mrtvoly! Střežíme naše dračí bohy a jestli se pokusíte zamořit tyto síně, nezůstaneme nepomstěni!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Kaa'rathovy zásoby", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0003", "ID_STRING": "TXT_DESC", "TEXT": "U nás jsou všichni válečníci spokojeni.", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Vypnout dračí kryptu", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0004", "ID_STRING": "TXT_TITLE", "TEXT": "Elfinin obchůdek", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0004", "ID_STRING": "TXT_DESC", "TEXT": "Zde nalezneš to nejlepší elfí zboží.", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Zabitý kraken", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0005", "ID_STRING": "TXT_TITLE", "TEXT": "Garbertova továrna", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0005", "ID_STRING": "TXT_DESC", "TEXT": "Máme tu spousty zajímavých věcí, jen se tu porozhlédni.", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Legie vítězí", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0006", "ID_STRING": "TXT_TITLE", "TEXT": "Matacův tábor", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0006", "ID_STRING": "TXT_DESC", "TEXT": "Tady se cvičil každý barbarský válečník v kraji.", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví vítězí", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0007", "ID_STRING": "TXT_TITLE", "TEXT": "Jerellovo zboží", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0007", "ID_STRING": "TXT_DESC", "TEXT": "Copak hledáš?", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - vyloupení", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0029", "ID_STRING": "POPUP_TXT", "TEXT": "Rytíř na Pegasovi\n\"Můj pane, vypadá to, že je tady nějaká mapa. Praví, že Lunnarkův poklad najde ten, kdo prozkoumá moře na severovýchodě. Ale cestovatel Lunnark je přece prý pouhou legendou! Že by ty povídačky byly přece jenom pravdivé?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0008", "ID_STRING": "TXT_TITLE", "TEXT": "Svatyně Hannah", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0008", "ID_STRING": "TXT_DESC", "TEXT": "Mám tu mocná kouzla za rozumnou cenu.", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví - vyloupení starobylého", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV002a", "ID_STRING": "POPUP_TXT", "TEXT": "Mrtvý rytíř\n\"Pane, vypadá to, že tady je nějaká mapa. Podle ní je k nalezení Lunnarkova pokladu třeba prozkoumat moře na severovýchodě. Ale cestovatel Lunnark je prý pouhou legendou. Že by ta legenda byla pravdivá?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV002b", "ID_STRING": "NAME_TXT", "TEXT": "Legie - vyloupení staré věže", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV002b", "ID_STRING": "POPUP_TXT", "TEXT": "Vévoda\n\"Pane, vypadá to, že tady je nějaká mapa. Podle ní je k nalezení Lunnarkova pokladu třeba prozkoumat moře na severovýchodě. Ale cestovatel Lunark je prý pouhopouhou legendou! Že by ty povídačky nakonec byly pravdivé?\"", "SEQ_NUM": 0},
