    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255UN0189", "ID_STRING": "NAME_TXT", "TEXT": "Pekelník", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255UN019a", "ID_STRING": "NAME_TXT", "TEXT": "Hazky'la", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - lok. vesnice", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Vesničané\n\"Lidská říše už těmto vesničanům nevládne! Nyní jsme svobodní a vede nás pan Kyn!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - lok. usedlost pana Kyna", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Vzbouřené páže\n\"Drž se od nás dál! Nech nás i našeho pána Kyna na pokoji! Náš velitel se o svůj lid totiž opravdu stará!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - lok. kopiník u zdi", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Kopiník\n\"Vláda Říše lidí je u konce! Pan Kyn zakázal císařským vojákům vstupovat na vysočinu, dokud naše nezávislost nebude vyhlášena!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - lok. kopiník hlídá", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Kopiník\n\"Počkej! Nedoporučoval bych ti, abys pokračoval dál! Legie tě sežehnou na škvarek!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Lok. stráž kopiníků", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Kopiník\n\"Zburcuj stráže! Blíží se nepřátelé!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Když jsme nyní horala Vaglana přiměli, aby se přidal na naši stranu, měli bychom začít plánovat útok na severní hranice Legií.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"S Vaglanovou pomocí jsme na frontových pozicích bojiště strategicky rozmístili čtyři své nejlepší válečníky, kteří jsou připraveni se zmocnit nepřátelských měst.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Zbývá už jen zjistit, zda budou Legie hledat pomoc u Zástupů nemrtvých, které sídlí daleko na východě. Pokud ano, může to být horší, než jsme plánovali.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví - intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Naše politika čekání a pozorování se konečně vyplatila, pane. Vypadá to, že silný frontální útok od Říše lidí může Legiím způsobit pořádnou újmu.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Právě toto na vysočině vytvořilo šťastné ovzduší chaosu. Nyní máme příležitost zničit oba naše soupeře, dokud jsou slabí a rozptýlení.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Do těchto zemí jsme vyslali mnoho zvědů, aby všechny takové případy prošetřili a mohli jsme naplánovat co nejvýhodnější čas k útoku.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Legie - intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Když se nepodařilo přimět Vaglana, aby s námi spolupracoval, nastala v naší říši krize. Ani nouzové schůzky se spřátelenými vládci nepřinesly žádná jasná řešení.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Pak vznikla Aliance nižších démonů. Nevěřili, že je mocné Legie zatracenců dokáží ochránit, a proto se od nás odtrhli. To nás velmi oslabilo.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Abychom lidem ukázali, kdo jim opravdu vládne, musíme nějak dobýt zpět města a rozbít Alianci!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Lok. území lupičů1", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Lupiči\n\"Stát! Toto území náleží nám! Udělejte čelem vzad a vraťte se domů, je-li vám život milý!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Lok. území lupičů2", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Lupiči\n\"Stát! Toto území náleží nám! Udělejte čelem vzad a vraťte se domů, je-li vám život milý!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - lok. věž zombii", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Můj pane, z té věže stoupá nečistý puch a kolem bloumají zombie! Někdo tu musí provozovat nějakou nezvyklou nekromancii!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví - lok. ovládnutí nemrtvých", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Pane, vláda nad touto zemí se nám pomalu vymyká z rukou. V okolí města začali nekromanté zakládat spoustu vlastních kultů. Musíme je potrestat!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Lok. pavoučí pasti", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "\"Je to past, pane! Přepadli nás pavouci!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí vítězí", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Legie vítězí", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Lidé dobývají Dračí údolí", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Démoni\n\"Nedovolíme lidské chátře, aby zabírala naše země! Jen neusni na vavřínech!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Indrusovy Tvrze", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví - lok. vzbouřené zombie", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Tyto zombie ovládal nějaký šílený okultista! Musíme najít zdroj a zničit jej!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Vypnout vzpurné zombie", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - lok. Dračí údolí", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Před námi leží město Doragonské údolí. Kdysi to prý bývalo slavné sídlo velikých draků. Legie je však v dobách Velkých válek zcela zničily a nyní tu obcházejí jen dračí duchové.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Allantyru", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Trpaslíci\n\"Nemysli si, že můžeš zvítězit! Budeme bojovat až do hořkého konce! Naše vojska se brzy vrátí, aby nás osvobodila!\"\n", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí trpasličího města", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Trpaslíci\n\"My trpaslíci jsme bojovný národ a máme dlouhou paměť. U Wotana, své hlavní město získáme zpět!\"\n", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Trpaslíci útočí na trpasličí město", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Lok. trpasličího obležení", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Trpasličí vojáci\n\"Odejdi odsud. Tohle město jsme obklíčili my trpaslíci!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Lok. severního trpasličího města", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Stráž trpasličího města\n\"Tyto země náleží trpaslíkům. Ty zde nejsi vítán!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Lok. vých. vstupu trp. města", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Kamenný obr\n\"Tyto země náleží trpaslíkům. Ty tu nejsi vítán!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Zapnout objevení démona", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Objevení démona", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví vítězí", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Legie dobývají Tróju", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Nyní je podstatné, abychom toto město udrželi pod kontrolou. Pak už nám stačí jen dobýt Dračí údolí.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Legie dobývají Dračí údolí", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Nyní je podstatné, abychom toto město udrželi pod kontrolou. Pak už nám stačí jen dobýt Tróju.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Kanny", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Kilgenův krámek", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Myslím, že ti mohu trochu pomoci.", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Legie - Aliance nižších démonů", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Pane, skupina odpadlých nižších démonů by se ráda opět vrátila do našich řad. Jestliže se s nimi setkáme u města Trója, určitě nám jejich posila velmi pomůže.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0022", "ID_STRING": "NAME_TXT", "TEXT": "Legie - lok. Alian. démonů", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0022", "ID_STRING": "POPUP_TXT", "TEXT": "Hazky'la\n\"Ano, nechceme rozhněvat Bethrezena! Budeme ti věrně sloužit!\"\n", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Zásoby pana Kyna", "SEQ_NUM": 0},
