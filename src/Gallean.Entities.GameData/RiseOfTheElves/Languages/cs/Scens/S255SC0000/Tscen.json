    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví - lok. Dračí údolí", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0023", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Před námi leží město Doragonské údolí. Kdysi to prý bývalo slavné sídlo velikých draků. Legie je však v dobách Velkých válek zcela zničily a nyní tu obcházejí jen dračí duchové.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Allarův krám", "SEQ_NUM": 0},
