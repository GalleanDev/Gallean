    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227LO001b", "ID_STRING": "NAME_TXT", "TEXT": "Princův vrah", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227LO001c", "ID_STRING": "NAME_TXT", "TEXT": "Fónická zpráva", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Turionův tábor", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Potřebuješ nějaké brance?", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Ebhonův obchod", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Moje zboží ti v tvém poslání pomůže.", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Zoltarův tábor", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Za určenou cenu vycvičím tvé vojáky.", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutrální", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Žádný popis", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Calderik", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Tento nejvyšší z trpasličích pánů si získal věhlas díky nesmírné síle v boji a odvaze tváří v tvář nesmírné přesile. Jednou po celých sedm dní a nocí bojoval s mocným rudým drakem Arfuruzonem, než nad ním konečně zvítězil.", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Asumuel", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Každé dítě se třese, zaslechne-li toto neblahé jméno - tento vládce pekel totiž proslul nezřízenou krvežíznivostí. Na jedné hostině, pořádané na počest Bethrezena a jeho vítězství nad královstvím světla, prý pozřel 1000 otroků.", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Heirik", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Zaorish", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0008", "ID_STRING": "NAME_TXT", "TEXT": "Princ Daxam", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0016", "ID_STRING": "NAME_TXT", "TEXT": "Pavoučí žezlo", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0019", "ID_STRING": "NAME_TXT", "TEXT": "Upír", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN001d", "ID_STRING": "NAME_TXT", "TEXT": "Nekromant", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0022", "ID_STRING": "NAME_TXT", "TEXT": "Wynfeld Lynx", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Legie - podmínky vítězství", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Bestie", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0002", "ID_STRING": "NAME_TXT", "TEXT": "C1", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0003", "ID_STRING": "NAME_TXT", "TEXT": "C2", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Útok nekromanta", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Fónický povstalec\n\"Království vyplení Fóničané, vyvrhelové z Bythazaru. Až se tak stane, nikdo nebude v bezpečí! Do každého domu, do každé rodiny dorazí naše... zpráva!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Kmenová léčba", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Léčení Legií", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Mystash - text", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Obyvatel Mystashy\n\"Děkuji, že jsi nás osvobodil od Wynfelda. Princ Daxam nakoupil svým mužům to nejlepší vybavení v zemi. Při svém nezměrném bohatství si též opatřil nějakou neviditelnou zbraň. Nikdo neví, co to je, ale všechny nás to děsí!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Prohnilé zatracení", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Mág\n\"Bohatství prince Daxama obsáhne celou zemi, ba ještě dále. Princ získal od jednoho potulného obchodníka bílého draka, který je sice méně odolný, ale jeho dech je silnější než dech jeho soukmenovců.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN002d", "ID_STRING": "NAME_TXT", "TEXT": "Skřet", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Prohnilé zatracení - zpráva dvě", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Páže\n\"Smrt Legiím! Nestvůra, s níž se nelze měřit, donutila prince Daxama k ústupu! Až vás také sprovodí ze světa, připiji vám na zdraví!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN002e", "ID_STRING": "NAME_TXT", "TEXT": "Skřet", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0030", "ID_STRING": "NAME_TXT", "TEXT": "Skřet", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV000d", "ID_STRING": "NAME_TXT", "TEXT": "HK podmínka vítězství", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Příběh Legií", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Ashkael\n\"Malé královstvíčko Bythazar se velmi soustředí na uchovávání zlata. Celé území silně střeží skřeti a jim podobní, ale my se Bythazaru musíme zmocnit. Naučíme toho Daxama, co to znamená urazit Legie!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Příběh horských kmenů", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Zavražděním Daxama riskujeme, že se jeho lid obrátí proti nám. Jsou sice na svého vladaře rozezleni, ale dost těžko budou přijímat někoho jiného. Jakmile bude princ zavražděn, musíme okamžitě dobýt Bythazar a opět nastolit pořádek.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0033", "ID_STRING": "NAME_TXT", "TEXT": "Skřet", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Elitní garda", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Bragon z vrchů\n\"Princ Daxam financuje svou elitní stráž z krutých daní Bythazarského lidu. Palácová garda dostává tu nejlepší zbroj a zbraně, jež se dají koupit.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Zpráva od nájezdníků", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Ashkael\n\"Jeden z poddaných prince Daxama byl spatřen, jak jedná s obchodníkem. Ten kupec patřil k mocnému společenstvu známému jen jako záškodníci. Říká se, že se princ rozhodl hledat ochranu pro svůj hrad.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Varování", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Spektra\n\"Otoč ssse a odejdi odsssud. Pokud ovšem netoužíš po objetí sssmrti, jež ti mohu dát.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0037", "ID_STRING": "NAME_TXT", "TEXT": "Skřet útočí", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Šílenství zombie", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Mystash - text", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Elitní voják\n\"Zatracenci tady, v našem království? My se vám podvolíme, ale princ Daxam se hned tak lehce nevzdá. Scházel se s obchodníky, kteří se zabývají divotvornými věcmi - kdo ví, co může přinést!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Útok lupičů", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Fóničan", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Fóničan\n\"Pavoučí žezlo, pavoučí žezlo... Je prima být mrtvý - vyhledej pavoučí žezlo a přidej ssse k nám. Všechna bolessst pomine!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN003b", "ID_STRING": "NAME_TXT", "TEXT": "Skřet", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Fónická zpráva pro Legie", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Fóničan\n\"Princ Daxam je blázen a královssství jeho otce ssse rozpadne v prach. Cítím, že král ssskoná rukama Zássstupů nemrtvých! Ááá, ty hledáš štít? Upíři mezi sebou rádi uvítají hosssty!\"\n", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Zpráva od Legií", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Arciďábel\n\"Zjistili jsme, že se v této oblasti nachází socha, již horské kmeny považují za posvátnou. Pouze oni kolem ní mohou projít bez úhony - každého jiného ten jejich ubohý bůh sklátí!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Potrestání Legií", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Zpráva z hor", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Kopcový obr\n\"Tato sócha pouze pro démony. Její moc jenom pro Legie. My pošli blíž a prokletí!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Trest hor", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Zpráva o obrácení", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Lupič\n\"Za to, že jsem ti zastoupil cestu a uchránil tě tak před pavoukem za mnou, mi dlužíš hezkých pár zlaťáků. Pokud však dnes nehodláš konat dobré skutky, mám tu párek ostrých hochů, kteří tě možná přesvědčí, abys změnil názor.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Obránce města", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Elitní kopiník\n\"Stát! Touto branou nikdo neprojde, Fónický hrad je domovem zrádců z Bythazaru! Takový je rozkaz Daxamova otce, krále Virgila!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Obrovský pavouk II", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0044", "ID_STRING": "NAME_TXT", "TEXT": "Skřet", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Obrovský pavouk III", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0022", "ID_STRING": "NAME_TXT", "TEXT": "Obchodníkovo varování", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0022", "ID_STRING": "POPUP_TXT", "TEXT": "Vesničan\n\"Všude číhá nebezpečí! Jsou tu šelmy a draci, kteří útočí pod rouškou noci. Měl by ses mít před těmito tvory na pozoru!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Skřetí král", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0023", "ID_STRING": "POPUP_TXT", "TEXT": "Skřet\n\"Přinášíš zprávy o králi skřetů? Ne? Přicházíš, abys nás rozsekal na kousíčky?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0047", "ID_STRING": "NAME_TXT", "TEXT": "Skřet", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0024", "ID_STRING": "NAME_TXT", "TEXT": "Upír", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0024", "ID_STRING": "POPUP_TXT", "TEXT": "Upír\n\"Pojď blíž... ještě blíž... a v mých očích spatříš osud, jaký si zasloužíš. Přistup blíž a dozvíš se, kde leží ďábelské artefakty.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Zpráva od upíra II", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Upír\n\"Pojď blíž... ještě blíž... a zjistíš, jak zahynul princ Daxam. Přistup blíž a třeba se dozvíš o velikém pokladu... ty máš strach?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Odejít z domova", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0026", "ID_STRING": "POPUP_TXT", "TEXT": "Fónická zombie\n\"Odejdi odsssud, dokud jsssi ještě naživu. Zůssstaň, a ssstaneš se jedním z násss Fóničanů, vyděděnců Bythazaru!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Tah jedna", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Pane, do našich jeskyní se pokoušejí vniknout skřeti a jim podobní! Snaží se uzavřít všechny naše cesty. Skřeti by ale něco takového naplánovat nedokázali - někdo je musí řídit. Můj cit mi napovídá, že za tím vším vězí princ Daxam.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0028", "ID_STRING": "NAME_TXT", "TEXT": "To jsem já", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "Fónický povstalec\n\"Byl jsem to já, kdo proti tobě všechny popudil. Princ Daxam i jeho otec jsou blázni! Fóničané brzy ovládnou celou zemi, a tehdy se objeví Zástupy nemrtvých a všude budou rozsévat smrt a zmar!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Nejsem žádný vesničan", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0029", "ID_STRING": "POPUP_TXT", "TEXT": "Generál\n\"Já nejsem žádný vesničan! Postav se mi a budeš poražen! Doufám, že se ti moji skřeti líbili. Nejsou příliš bystří, ale dají se snadno koupit. Daxamovo bohatství má ještě mnohá překvapení, ale ty už je neuvidíš.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN004c", "ID_STRING": "NAME_TXT", "TEXT": "Páže", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Tah jedna HK", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002a", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Do naší horské základny se vloudili skřeti. Ty tupé kreatury dokázaly obsadit většinu východů! Skřeti nejsou natolik inteligentní, aby naplánovali něco takového. Za tím vězí někdo jiný - že by Daxam?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN004f", "ID_STRING": "NAME_TXT", "TEXT": "Páže", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Princův vrah", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002c", "ID_STRING": "POPUP_TXT", "TEXT": "Elitní voják\n\"Princ Daxam vydal příkaz popravit všechny nepřátele státu. Že neuhádneš, o koho jde? - Ano, jsi to ty!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002d", "ID_STRING": "NAME_TXT", "TEXT": "Nová událost", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Ashkael\n\"Princ sbírá novou brannou sílu - elitní gardu. Tito palácoví vojáci mají být vybaveni tou nejlepší zbrojí a zbraněmi, které se dají zaplatit zlatem, a obávám se, že mají k dispozici i pár dalších překvapení.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002e", "ID_STRING": "NAME_TXT", "TEXT": "Nájezdnické kmeny", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002e", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Člen královské rodiny a skupina obchodníků byli viděni spolu. Takovému sdružení se v některých zemích říká záškodníci. Kupčí se vším včetně žoldnéřů. Můžeme očekávat, že princ bude mít ještě další posily.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002f", "ID_STRING": "NAME_TXT", "TEXT": "Fónická zpráva", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "Fóničan\n\"My Fóničané se pomstíme na Daxamovi a jeho cizích žoldnéřích. Každý, kdo se bude vměšovat, padne spolu s ním.\"", "SEQ_NUM": 0},
