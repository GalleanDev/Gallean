      "ID_STRING": "NAME_TXT",
      "TEXT": "Kraken",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0022",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Mo\u0159sk\u00E1 panna",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0000",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Ritu\u00E1ln\u00ED varov\u00E1n\u00ED",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0000",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Temn\u00FD \u010Darod\u011Bj\n\u0022Pane! Tady pracuj\u00ED podivn\u00E9 okultn\u00ED s\u00EDly, ten ritu\u00E1l na n\u00E1s p\u0159ivol\u00E1v\u00E1 d\u00E9mony! Mus\u00EDme tu \u010F\u00E1belskou br\u00E1nu uzav\u0159\u00EDt!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0024",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Mo\u0159sk\u00E1 panna",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0001",
      "ID_STRING": "NAME_TXT",
      "TEXT": "T 1 Drama",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "R\u00E1dce\n\u0022Na\u0161i zv\u011Bdov\u00E9 zjistili, \u017Ee jsme obkl\u00ED\u010Deni nemrtv\u00FDmi. My v\u0161ak jejich vojska nem\u016F\u017Eeme objevit!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Bethrezen\n\u0022Je jasn\u00E9, \u017Ee tu nejsou \u017E\u00E1dn\u00ED nemrtv\u00ED.\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "R\u00E1dce\n\u0022Co t\u00EDm m\u00EDn\u00ED\u0161, pane Bethrezene? Copak jsme sem nep\u0159it\u00E1hli, abychom na n\u011B ude\u0159ili?\u0022",
      "SEQ_NUM": 2
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Uther\n\u0022J\u00E1 nejsem Bethrezen!.\u0022",
      "SEQ_NUM": 3
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "R\u00E1dce\n\u0022Nejsi Bethrezen? Ale jednal jsi jako on...\u0022",
      "SEQ_NUM": 4
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Uther\n\u0022To brzy pochop\u00ED\u0161. Asterothu! Za\u017Ee\u0148 tyto d\u00E9mony do ni\u017E\u0161\u00EDch sf\u00E9r! U\u017E je nebudeme pot\u0159ebovat!\u0022",
      "SEQ_NUM": 5
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0002",
      "ID_STRING": "NAME_TXT",
      "TEXT": "T 1-2 Drama",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0002",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Asteroth\n\u0022Ano, budeme vl\u00E1dnout spole\u010Dn\u011B! Nikdy n\u00E1s nedok\u00E1\u017E\u00ED porazit!\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0002",
      "ID_STRING": "OBJECT_TXT",
      "TEXT": "Porazit p\u00E1na d\u00E9mon\u016F Asterotha",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0027",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Mo\u0159sk\u00E1 panna",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0004",
      "ID_STRING": "NAME_TXT",
      "TEXT": "T 1-3 Drama",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Pekeln\u00EDk\n\u0022Slu\u017Eebn\u00ED d\u00E9moni, u\u017E v\u00E1s nepot\u0159ebujeme!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Pekeln\u00EDk\n\u0022Stoj\u00EDme p\u0159ed na\u0161\u00EDm skute\u010Dn\u00FDm p\u00E1nem Bethrezenem! A jemu za tu zradu zaplat\u00EDte!\u0022",
      "SEQ_NUM": 4
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0006",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Text m\u011Bsta Gromdam",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0006",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "St\u0159elec\n\u0022Copak nev\u00EDte, kdy ztichnout, d\u00E9moni? Uther bude vl\u00E1dnout t\u011Bmto zem\u00EDm a vy se budete muset dr\u017Eet opod\u00E1l!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0007",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Text m\u011Bsta Rotturdam",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0007",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ryt\u00ED\u0159\n\u0022Odstupte, d\u00E9moni! O\u010Dek\u00E1v\u00E1me na\u0161eho spasitele Uthera. A\u017E doraz\u00ED, potrest\u00E1 v\u00E1s za v\u0161echny h\u0159\u00EDchy!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN002a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Onyxov\u00E1 gargoyla",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0008",
      "ID_STRING": "NAME_TXT",
      "TEXT": "D\u00E9monick\u00FD zplozenec",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN002c",
      "ID_STRING": "NAME_TXT",
      "TEXT": "D\u00E9mon",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0009",
      "ID_STRING": "NAME_TXT",
      "TEXT": "D\u00E9monick\u00FD zplozenec 15",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "D\u00E9monick\u00FD zplozenec 25",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN002e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Onyxov\u00E1 gargoyla",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000b",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Zni\u010Den\u00ED kultist\u016F",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000b",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Pand\u00E9mon\n\u0022Zni\u010Dili jsme vyvol\u00E1vac\u00ED okruh, pane. D\u00E9moni se u\u017E v\u00EDce nebudou rodit.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000c",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Zni\u010Den\u00ED d\u00E9mon\u016F",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000c",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Pand\u00E9mon\n\u0022Zni\u010Dili jsme vyvol\u00E1vac\u00ED okruh, pane. D\u00E9moni se u\u017E v\u00EDce nebudou rodit.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000d",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Varov\u00E1n\u00ED p\u0159ed vodou",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000d",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "R\u00E1dce\n\u0022Dej si pozor, pane, zdej\u0161\u00ED mo\u0159e ovl\u00E1daj\u00ED mo\u0159sk\u00E9 \u010Darod\u011Bjnice, je\u017E hoduj\u00ED na v\u0161em, co se dostane do jejich \u0159\u00ED\u0161e.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Asteroth T2",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000f",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Situa\u010Dn\u00ED z\u00F3na",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000f",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "V\u00E9voda\n\u0022\u0158\u00ED\u0161e lid\u00ED se p\u0159idala k Asterothovi! Uzav\u0159eli jak\u00E9si spojenectv\u00ED! Vypad\u00E1 to, \u017Ee Uther c\u00EDsa\u0159stv\u00ED \u00FApln\u011B o\u010Daroval. Za t\u00EDm v\u0161\u00EDm v\u011Bz\u00ED pravd\u011Bpodobn\u011B Hubert de Lalye.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0032",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Kultista",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0010",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Astoroth je bl\u00EDzko",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0010",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Asteroth\n\u0022Je\u0161t\u011B jedna chyba, smrteln\u00EDku, a zni\u010D\u00EDm t\u011B s\u00E1m! Bethrezenova \u0159\u00ED\u0161e je u\u017E minulost\u00ED!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0034",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Kultista",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0011",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Onyxov\u00FD tah T15",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0012",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Posl\u00E1n\u00ED spln\u011Bno",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0012",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Asteroth\n\u0022Grrrrrrr! M\u00E1te \u0161t\u011Bst\u00ED, \u017Ee jste unikli m\u00E9mu hn\u011Bvu, d\u00E9moni! Ale j\u00E1 nemohu b\u00FDt zni\u010Den!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0012",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "D\u00E9monolog\n\u0022Vy\u0161lehl plamen a Asteroth v n\u011Bm zmizel! Uprchl! Tak\u017Ee jsme zv\u00EDt\u011Bzili!\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0036",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Zlobr",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0014",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Asteroth T40",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0014",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Asteroth\n\u0022Zbab\u011Blci! Zni\u010D\u00EDm v\u00E1s s\u00E1m! Budete litovat sv\u00FDch zr\u00E1dn\u00FDch \u010Din\u016F!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0015",
      "ID_STRING": "NAME_TXT",
      "TEXT": "\u00DAkol pro sk\u0159ety",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0015",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Sk\u0159et\n\u0022Hork\u00E9 k\u016F\u017Ee, my pot\u0159ebovat pomo\u010D, bratr sk\u0159et ztracen. Vy pomo\u010Dit n\u00E1m?\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0015",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "V\u00E9voda\n\u0022Co od n\u00E1s chcete?\u0022",
      "SEQ_NUM": 2
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0015",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Sk\u0159et\n\u0022Ty sem podv\u00E9st sk\u0159eta a my ti pak n\u011Bco d\u00E1t.\u0022",
      "SEQ_NUM": 4
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0039",
      "ID_STRING": "NAME_TXT",
      "TEXT": "C\u00EDsa\u0159sk\u00FD vrah",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0016",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Odm\u011Bna od sk\u0159et\u016F",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0016",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Sk\u0159et\n\u0022GROOOOU\u00C1\u00C1\u00C1R! Sk\u0159et!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0016",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Sk\u0159et\n\u0022Brat\u0159\u00EDk zp\u00E1tky. My ti pomo\u010Dit. Ty nad\u00EDvat se do velk\u00E9ho m\u011Bsta. Tam poklad.\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S105SC0000",
