    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Yggarův tábor", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Zde se cvičili ti největší bojovníci v kraji.", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Sllatův obchod", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Co pro tebe mohu udělat, cizinče?", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Warwickův krámek", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Moje zboží ti v tvém poslání pomůže.", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Othonova věž", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Mohu ti pomoci v boji proti invazi démonů!", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0004", "ID_STRING": "TXT_TITLE", "TEXT": "Furrenův obchod", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0004", "ID_STRING": "TXT_DESC", "TEXT": "Za určitou cenu prodám úplně všechno.", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutrální", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Žádný popis", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Winfríd", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Tento mocný pán se zamlada samojediný postavil armádě pekelné a jednou rukou ji zničil, neboť zapečetil bránu, jež vojska na tento svět přiváděla. Poté se stal nezávislým vládcem říše.", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Baldarik", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Tento nejvyšší z trpasličích pánů si získal věhlas díky nesmírné síle v boji a odvaze tváří v tvář nesmírné přesile. Jednou po celých sedm dní a nocí bojoval s mocným rudým drakem Arfuruzonem, než nad ním konečně zvítězil.", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Emery", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Lanfríd", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0008", "ID_STRING": "NAME_TXT", "TEXT": "Lupič", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Inferna", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "\"Podívej, vypadá to, že pouhá naše přítomnost očišťuje zemi od zla, jež ji prostupuje! Jsme silnější!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0023", "ID_STRING": "NAME_TXT", "TEXT": "Kopiník", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0001", "ID_STRING": "NAME_TXT", "TEXT": "HK vítězí", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "\"Kmeny zvítězily nad zlou nákazou, jež se šířila jejich zemí.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Avgrundskvalu", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "\"To je úžasné! Kam vkročíme, tam se země mění a ďábelské lávové jámy se zavírají! Naši vojáci opět začali věřit!\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Záplava démonů", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Hřbitov", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "\"Démoni vyplenili dokonce i naši svatyni zasvěcenou mrtvým! Musíme se pomstít!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Nekromant", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Nekromant: \"Ha, ha, ha! Skloňte se před novým pánem, nepatrní smrtelníci! Náš dračí pán vás všechny sežehne jedním dechem!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0028", "ID_STRING": "NAME_TXT", "TEXT": "Kopiník", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - vesnická stráž", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "\"Říši lidí už více nesloužíme. Postaráme se o sebe sami, a proto se kliďte z našeho území, vojáci!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Démonologovo kouzlo", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "\"Naneštěstí pro vás, smrtelníci, je tohle teď naše říše! Jak se opovažujete poskvrňovat zem svou přítomností!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN002b", "ID_STRING": "NAME_TXT", "TEXT": "Vesničan", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN002c", "ID_STRING": "NAME_TXT", "TEXT": "Vesničan", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Ďábelský portál", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Démoni\n\"Smrt si přijde pro všechny, kdož ji hledají! A ty jsi ji našel právě teď!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí navštěvuje tábor", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Lorn: \"Počkej, prosím! Dovol, ať se k tobě připojíme, už nechceme dál sloužit dračímu vládci!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000d", "ID_STRING": "NAME_TXT", "TEXT": "HK návštěva trpaslíka", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Trpaslík\n\"Konečně jsi přišel, abys pokračoval v tažení proti zlému dračímu pánovi! Já už jsem příliš unaven, než abych mohl pokračovat. Vezmi si tohle, velmi ti to pomůže.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000e", "ID_STRING": "NAME_TXT", "TEXT": "HK stráž vesničanů", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "\"Přitroublí trpaslíci, držte se dál od naší vesnice! Do ní mohou vstoupit pouze lidé!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0032", "ID_STRING": "NAME_TXT", "TEXT": "Kopiník", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Vypnout HK odměnu vesničanů", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "\"Kmeny, budeme se bránit!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí vítězí", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "\"Přemohli jsme zlo v této zemi, ve jménu Nejvyššího otce!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "\"S lidskou říší po boku jsme si tu mírumilovně žili už od nepaměti. Když tu jednoho dne se nebe na jihu zatáhlo a ze země začala stoupat dusivá pára.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "\"Byli jsme strachy jako ochromení, až už bylo pozdě. Obyvatelé hlavního města v panice prchali a v celé zemi zavládl chaos. Nyní musíme najít původ toho zla a zneškodnit jej!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0012", "ID_STRING": "NAME_TXT", "TEXT": "HK intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "\"S lidskou říší po boku jsme si tu mírumilovně žili už od nepaměti. Když tu jednoho dne se nebe na jihu zatáhlo a ze země začala stoupat dusivá pára.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "\"Byli jsme strachy jako ochromení, až už bylo pozdě. Obyvatelé hlavního města v panice prchali a v celé zemi zavládl chaos. Nyní musíme najít původ toho zla a zneškodnit jej!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0035", "ID_STRING": "NAME_TXT", "TEXT": "Kopiník", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Zapnout záplavu démonů", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "\"Ze země povstávají démoni! Musíme je zastavit!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0014", "ID_STRING": "NAME_TXT", "TEXT": "HK Severní Pevnost - západ", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "\"Držte se dál od našeho města, trpaslíci! Nemáme vás rádi, sem smí jenom lidé!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0015", "ID_STRING": "NAME_TXT", "TEXT": "HK Severní Pevnost - východ", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "\"Držte se dál od našeho města, trpaslíci! Nemáme vás rádi, sem smí jenom lidé!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí východně od Severní Pevnosti", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "\"Vojáci Říše lidí, nemůžete nás ochránit před démony, a tak se budeme bránit sami! Zůstaňte si, kde jste, než budeme muset zakročit!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0039", "ID_STRING": "NAME_TXT", "TEXT": "Vesničan", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí západně od Severní Pevnosti", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "\"Vojáci Říše lidí, nemůžete nás ochránit před démony, a tak se budeme bránit sami! Zůstaňte si, kde jste, než budeme muset zakročit!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0018", "ID_STRING": "NAME_TXT", "TEXT": "HK u ďábelského portálu", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "\"Můj pane! Cítíme tu nějakou mocnou zlou nástrahu! Ze země stoupá spalující horko. Měli bychom si raději připravit ta nejlepší kouzla!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí u ďábelského portálu", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "\"Můj pane! Cítíme tu nějakou mocnou zlou nástrahu! Ze země stoupá spalující horko - musíme být připraveni na nejhorší. Nechť nás Nejvyšší otec ochraňuje!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí navštěvuje trpaslíka", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "\"Jsi tu, abys skolil zlého draka? Prosím, jsem smrtelně zraněn a nemohu jít dál... Vezmi si tohle a zabij tu obludu!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Poblíž pážete", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "\"Tyhle nestvůry dokážeme zničit i bez tebe! Ustup - jsme po zuby ozbrojeni!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN003f", "ID_STRING": "NAME_TXT", "TEXT": "Vesničan", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Poblíž zombie", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "\"Můj pane! To jsou ti krvelační démoni, o nichž se zmiňovali vesničané!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Poblíž Spektry", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "\"Můj pane! To jsou ti krvelační démoni, o nichž se zmiňovali vesničané!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Prchající vesničan", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "\"Pomoc! Pomoc! Můj pane, musíš nás zachránit! Klidně jsme se procházeli dole v údolí, když nás náhle napadli strašliví démoni! Musíš je zabít! Pomoz!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0042", "ID_STRING": "NAME_TXT", "TEXT": "Kopiník", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Pomezního Hradce - lidé", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Vesničané\n\"Prosím, zachraň nás před démony! Jejich přisluhovači přísahali, že nás obětují dračímu pánu!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Pomezního Hradce - HK", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Vesničané\n\"Nejdřív sem vtrhnou démoni, a teď pro změnu zase zrádné horské kmeny! Prosím, mějte kouska slitování!\"", "SEQ_NUM": 0},
