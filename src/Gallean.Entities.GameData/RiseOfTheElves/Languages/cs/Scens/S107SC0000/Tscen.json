    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107SI0002",
      "ID_STRING": "TXT_TITLE",
      "TEXT": "Gunnerova v\u011B\u017E",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107SI0002",
      "ID_STRING": "TXT_DESC",
      "TEXT": "M\u00E1m tu spousty \u010Daromocn\u00FDch kouzel.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107SI0003",
      "ID_STRING": "TXT_TITLE",
      "TEXT": "Thurinovo zbo\u017E\u00ED",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107SI0003",
      "ID_STRING": "TXT_DESC",
      "TEXT": "Moje zbo\u017E\u00ED ti m\u016F\u017Ee na tv\u00FDch cest\u00E1ch pomoci",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107PL0000",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Justin",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107PL0000",
      "ID_STRING": "DESC_TXT",
      "TEXT": "Tento mocn\u00FD p\u00E1n se zamlada samojedin\u00FD postavil arm\u00E1d\u011B pekeln\u00E9 a jednou rukou ji zni\u010Dil, nebo\u0165 zape\u010Detil br\u00E1nu, je\u017E vojska na tento sv\u011Bt p\u0159iv\u00E1d\u011Bla. Pot\u00E9 se stal nez\u00E1visl\u00FDm vl\u00E1dcem \u0159\u00ED\u0161e.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107PL0001",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107PL0001",
      "ID_STRING": "DESC_TXT",
      "TEXT": "Ka\u017Ed\u00E9 d\u00EDt\u011B se t\u0159ese, zaslechne-li toto neblah\u00E9 jm\u00E9no - tento vl\u00E1dce pekel toti\u017E proslul nez\u0159\u00EDzenou krve\u017E\u00EDznivost\u00ED. Na jedn\u00E9 hostin\u011B, po\u0159\u00E1dan\u00E9 na po\u010Dest Bethrezena a jeho v\u00EDt\u011Bzstv\u00ED nad kr\u00E1lovstv\u00EDm sv\u011Btla, pr\u00FD poz\u0159el 1000 otrok\u016F.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107PL0004",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Neutr\u00E1ln\u00ED hr\u00E1\u010D",
      "SEQ_NUM": 0
    },
