    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107UN0020",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Goblin",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0000",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Text m\u011Bsta Milonia",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0000",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Vesni\u010Dan\n\u0022D\u011Bkuji, \u017Ee jsi zachr\u00E1nil na\u0161e m\u011Bsto! Goblini plenili na\u0161i zemi a ni\u010Dili n\u00E1m \u00FArodu. R\u00E1d bych t\u011B ale varoval - na jihu je jich je\u0161t\u011B spousta.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107UN0023",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0001",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Text m\u011Bsta Tanscroul",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "P\u00E1\u017Ee\n\u0022D\u011Bkuji ti, \u017Ee jsi n\u00E1s osvobodil! Ne\u017E jsi sem p\u0159i\u0161el, nebyla tu nikde \u017E\u00E1dn\u00E1 spravedlnost, v\u0161ichni n\u00E1sledovali Erhog - byli jsme donuceni j\u00ED slou\u017Eit!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0002",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Text m\u011Bsta Agreban",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0002",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "M\u00E1g\n\u0022T\u011Bmto kraj\u016Fm vl\u00E1dla rodina Ammenir\u016F, ne\u017Eli je Hubert de Lalye nakazil sv\u00FDm odpadlictv\u00EDm. Od t\u00E9 doby se celou \u0159\u00ED\u0161\u00ED \u0161\u00ED\u0159\u00ED chaos.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107UN0025",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Goblin",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0003",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Text m\u011Bsta P\u0159\u00EDstav Jaignes",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0003",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Kopin\u00EDk\n\u0022Hubert de Lalye, c\u00EDsa\u0159sk\u00FD r\u00E1dce, toto m\u011Bsto \u010Dasto nav\u0161t\u011Bvoval. Pro\u010D n\u00E1m tedy nepomohl proti Erhog? Ob\u00E1v\u00E1m se, \u017Ee c\u00EDsa\u0159 u\u017E tyto zem\u011B opustil!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107UN0026",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0004",
      "ID_STRING": "NAME_TXT",
      "TEXT": "P\u0159ed m\u011Bstem Erhog",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Erhog Temn\u00E1\n\u0022Nebu\u010F tak sebev\u011Bdom\u00FD. Pamatuj, \u017Ee mou pan\u00ED je sama Smrt! A prok\u00E1\u017Eu j\u00ED velkou slu\u017Ebu, kdy\u017E t\u011B zni\u010D\u00EDm. Pokud nejsi bl\u00E1zen, odejdi, dokud m\u016F\u017Ee\u0161!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107UN0027",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107UN0028",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0006",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Ud\u00E1lost 2",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0006",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hrani\u010D\u00E1\u0159\n\u0022C\u00EDt\u00EDm dusiv\u00FD z\u00E1pach s\u00EDry! Postupuj opatrn\u011B, nebo\u0165 tyto zem\u011B ob\u00FDvaj\u00ED d\u00E9monick\u00E9 bestie!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0007",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Ud\u00E1lost 3",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0007",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hrani\u010D\u00E1\u0159\n\u0022Pod\u00EDvej! Kultist\u00E9 sp\u00E1lili v\u0161echno v dohledu.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0008",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Zpr\u00E1va T15",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0008",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nejvy\u0161\u0161\u00ED kn\u011Bz\n\u0022C\u00EDsa\u0159 byl otr\u00E1ven! Pokusili se ho otr\u00E1vit \u0161lechtici, kter\u00E9 podplatila Erhog! \u00DAtok sice p\u0159e\u017Eil, ale brzy zahyne, jestli\u017Ee nenajdeme pat\u0159i\u010Dn\u00FD protijed!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0009",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Ud\u00E1lost 5",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0009",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hrani\u010D\u00E1\u0159\n\u0022P\u0159ed Athlokovou tvrz\u00ED n\u00E1s mnoho vesni\u010Dan\u016F varovalo. Bu\u010F obez\u0159etn\u00FD, m\u016Fj pane! Pr\u00FD tam obch\u00E1zej\u00ED ztracen\u00E9 du\u0161e.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV000a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Zpr\u00E1va T3",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV000a",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nejvy\u0161\u0161\u00ED kn\u011Bz\n\u0022Pane, mnoho \u0161lechtic\u016F opustilo hlavn\u00ED m\u011Bsto. Za t\u00EDm dozajista v\u011Bz\u00ED Erhog a jej\u00ED n\u00E1sledovn\u00EDci! Bu\u010F opatrn\u00FD!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV000b",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Ud\u00E1lost 7",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV000b",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hrani\u010D\u00E1\u0159\n\u0022V tomto m\u011Bst\u011B jsme objevili v\u00FDznamn\u00E9ho mu\u017Ee, jen\u017E si \u0159\u00EDk\u00E1 Wolfgar. Hodl\u00E1 bojovat na na\u0161\u00ED stran\u011B.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107UN002e",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV000c",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Ud\u00E1lost 8",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV000c",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "M\u00E1g\n\u0022V t\u011Bchto z\u0159\u00EDcenin\u00E1ch jsme nalezli kabalistick\u00E9 symboly! Ned\u00E1vno tu n\u011Bkdo va\u0159il n\u011Bjak\u00FD prudk\u00FD jed. Zaj\u00EDmalo by mne, pro\u010D...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107UN002f",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV000d",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Zpr\u00E1va T20",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV000d",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "M\u00E1g\n\u0022M\u016Fj pane, hv\u011Bzdy mi napov\u00EDdaj\u00ED, \u017Ee n\u00E1m p\u0159ijde na pomoc spasitel! A bude poch\u00E1zet z kr\u00E1lovsk\u00E9 krve!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107UN0031",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Kultista",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107UN0032",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107UN0033",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0011",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Erhog T35",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0011",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Erhog Temn\u00E1\n\u0022Pro\u010D se m\u011B je\u0161t\u011B st\u00E1le pokou\u0161\u00ED\u0161 zab\u00EDt? Tv\u016Fj osud je u\u017E zpe\u010Det\u011Bn, slu\u017Eebn\u00EDku Nejvy\u0161\u0161\u00EDho otce! Cha, cha, cha, cha!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0013",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Sk\u0159et",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0013",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Sk\u0159et\n\u0022GROOOO\u00C1\u00C1\u00C1\u00C1R! Vy prdli sk\u0159et\u016Fm do pasti. Vy te\u010F se mnou b\u016Fjovat o pr\u016Fchod p\u0159es ch\u00F3ry!\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0014",
      "ID_STRING": "NAME_TXT",
      "TEXT": "V\u00EDt\u011Bzstv\u00ED ve sc\u00E9n\u00E1\u0159i",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0014",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Kdy\u017E Erhog mizela pod troskami bort\u00EDc\u00ED se v\u011B\u017Ee, vyk\u0159ikla: \u0022Je\u0161t\u011B se setk\u00E1me, vy psi Nejvy\u0161\u0161\u00EDho otce!\u0022 V sutin\u00E1ch jsi pak objevil protijed na uzdraven\u00ED c\u00EDsa\u0159e Demosthena a okam\u017Eit\u011B jsi mu jej poslal.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0015",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Dvojn\u00E1sobn\u00E1 ud\u00E1lost",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0015",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hrani\u010D\u00E1\u0159\n\u0022M\u011Bli bychom vyu\u017E\u00EDt situace. Mysl\u00EDm, \u017Ee p\u0159ed n\u00E1mi le\u017E\u00ED \u00FAzem\u00ED Legi\u00ED zatracenc\u016F!\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107UN0039",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Kopin\u00EDk",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0016",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Po\u010D\u00E1te\u010Dn\u00ED ud\u00E1lost",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0016",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nejvy\u0161\u0161\u00ED kn\u011Bz\n\u0022Kone\u010Dn\u011B jsi dorazil, m\u016Fj pane! Tyto krajiny ovl\u00E1d\u00E1 Erhog Temn\u00E1 a jej\u00ED zl\u00E1 sekta. T\u011Bch n\u011Bkolik, kte\u0159\u00ED se proti n\u00ED postavili, zmizelo. Jej\u00ED chr\u00E1m le\u017E\u00ED kdesi na jihov\u00FDchod\u011B. Mus\u00EDme u\u010Dinit p\u0159\u00EDtr\u017E tomuto \u0161\u00EDlenstv\u00ED!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107UN003a",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0018",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Ud\u00E1lost podru\u017En\u00E9ho \u00FAkolu",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0018",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hrani\u010D\u00E1\u0159\n\u0022M\u016Fj pane, vesni\u010Dan\u00E9 tvrd\u00ED, \u017Ee si zlobr ve sv\u00E9m doup\u011Bti ukryl jakousi d\u016Fle\u017Eitou v\u011Bc. N\u011Bkte\u0159\u00ED se domn\u00EDvaj\u00ED, \u017Ee ten poklad nashrom\u00E1\u017Edil ve stejn\u00E9 dob\u011B, jako byla postavena socha, kter\u00E1 se nach\u00E1z\u00ED d\u00E1l na severov\u00FDchod\u011B.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0019",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Ud\u00E1lost podru\u017En\u00E9ho \u00FAkolu 2",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV0019",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hrani\u010D\u00E1\u0159\n\u0022Ammenir\u016Fv kamenn\u00FD prsten perfektn\u011B padne na ruku t\u00E9to sochy! Pod\u00EDvej, pane - otev\u0159elo to tajn\u00E9 dve\u0159e, a za nimi je jak\u00E1si prastar\u00E1 kniha!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107UN003d",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV001a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Zpr\u00E1va T8",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV001a",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "V\u00E9voda\n\u0022Opus\u0165 tyto kon\u010Diny, lidsk\u00E9 pl\u00E9m\u011B! V\u0161echny, kdo se postav\u00ED Legi\u00EDm zatracenc\u016F, \u010Dek\u00E1 utrpen\u00ED a smrt!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV001a",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Arcim\u00E1g\n\u0022Nesm\u00EDme v\u00E1hat, pane m\u016Fj! Neboj se, i kdy\u017E to vypad\u00E1, \u017Ee se nyn\u00ED Erhog spojila s t\u011Bmito d\u00E9monick\u00FDmi tvory!\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107EV001a",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "V\u00E9voda\n\u0022Byli jste varov\u00E1ni, smrteln\u00EDci! Sp\u00E1l\u00EDme celou zemi, a s n\u00ED i va\u0161e t\u011Bla!\u0022",
      "SEQ_NUM": 2
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107UN003e",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107UN0041",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107UN0042",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107UN0051",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Kultista",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S107SC0000",
      "ID_OBJECT": "S107UN0052",
