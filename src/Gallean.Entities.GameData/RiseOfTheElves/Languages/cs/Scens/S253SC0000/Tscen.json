{
  "formatVersion": 1,
  "rows": [
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Hemlockův obchod", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Moje zboží ti v tvém poslání pomůže.", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Herlickův obchod", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Jen si prohlédni moje zboží, možná ti něco padne do oka.", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Garkathova věž", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Nepotřebuješ nějaká zajímavější kouzla?", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0005", "ID_STRING": "TXT_TITLE", "TEXT": "Matacův tábor", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0005", "ID_STRING": "TXT_DESC", "TEXT": "Pojď dál a já z tvých nedomrlých vojáčků vycvičím zdatné bojovníky.", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutrální", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Žádný popis", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Goar", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Tento mocný pán se zamlada samojediný postavil armádě pekelné a jednou rukou ji zničil, neboť zapečetil bránu, jež vojska na tento svět přiváděla. Poté se stal nezávislým vládcem říše.", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Jagare", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN000c", "ID_STRING": "NAME_TXT", "TEXT": "Skřet", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN000e", "ID_STRING": "NAME_TXT", "TEXT": "Skřet", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0010", "ID_STRING": "NAME_TXT", "TEXT": "Vesničan", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0012", "ID_STRING": "NAME_TXT", "TEXT": "Hlavní vesničan", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0018", "ID_STRING": "NAME_TXT", "TEXT": "Skřet", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN001c", "ID_STRING": "NAME_TXT", "TEXT": "Vesničan", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN001e", "ID_STRING": "NAME_TXT", "TEXT": "Vesničan", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Intro 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Můj pane, v našem království nastala velmi vážná situace. Vypadá to, že vesnice, jež ovládáme, se vzbouřily!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Musíme svá města získat násilím a zjistit, kdo to všechno zavinil! Nejprve se musíme sejít se soudcem z Clovisu a projednat s ním bojovou taktiku.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Itnro 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Císařský rádce\n\"Vítej, můj pane. Jsem tvůj císařský rádce, který ti bude poskytovat cenné rady, co se týče vedení království.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Císařský rádce\n\"Nejprve bych radil, aby sis v hlavním městě připravil družinu tak, že do pohyblivé skupiny přesuneš jednotky z osádky hradu. Pak si můžeš z pokladnice vybrat ještě předměty, které s sebou poneseš.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Tip věže ježibaby", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Můj pane, z té čarodějnické věže se linou příšerné výkřiky! Není pochyb, že tam mučí nějakou nevinnou duši! Je naší povinností všechny oběti zachránit!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Vyloupit věž ježibaby", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Isuel\n\"Díky, že jsi mne zachránil, už jsem myslel, že zůstanu uvězněn navěky. Jako poděkování mi dovol šířit moc Říše lidí tak, že budu umísťovat žezla všude, kde poručíš.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Můžeme rozkázat archandělovi, aby prolétal zemí a poblíž zdrojů umísťoval žezla. Tím můžeme získávat zlato a manu, aniž bychom u daných dolů měli nějaké město.\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0029", "ID_STRING": "NAME_TXT", "TEXT": "Vesničan", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Tip3 - goblinní říše", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Skřeti\n\"Hej! Vypadni odtud! To je náš poklad! Ty ho nedostaneš! Teď jsi nás teda naštval!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Ubránit vesnici", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Vesničané\n\"Utíkejte! Jde o život!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Tip4 - cestování po vodě", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Cesta po vodě je pro ty, kteří nedovedou létat, velmi pomalá a nebezpečná, můj pane.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Tip4 - cestování po vodě2", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Cesta po vodě je pro ty, kteří nedovedou létat, velmi pomalá a nebezpečná, můj pane.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Hřbitov", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Nájezdník ze hřbitova\n\"Jen pojď do vlastního hrobu!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Runová mana", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Můj pane, před námi se nachází zdroj runové many! Měli bychom sem vyslat archanděla, aby poblíž zasadil žezlo!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0032", "ID_STRING": "NAME_TXT", "TEXT": "Lupič", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Den 4 - tip", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Můj pane, naši zvědové hlásí, že na severu leží malá víska. Což kdybychom ji prozkoumali? Možná bychom tak mohli i rozšířit svůj vliv.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0037", "ID_STRING": "NAME_TXT", "TEXT": "Lupič", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí uzdravení", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - zpráva o uzdravení", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Socha\n\"Blahoslaveni jsou ti, kdo bojují ve jménu Nejvyššího otce. Jsi-li zraněn, budeš vyléčen - nyní i pokaždé, kdy se sem navrátíš!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Skřet se objevuje", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0046", "ID_STRING": "NAME_TXT", "TEXT": "Skřet", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0024", "ID_STRING": "NAME_TXT", "TEXT": "Průchod lupičů", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0024", "ID_STRING": "POPUP_TXT", "TEXT": "Lupič\n\"Abys kolem mne mohl projít, budeš muset vysolit pořádnou sumičku!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN004b", "ID_STRING": "NAME_TXT", "TEXT": "Mistrovský lupič", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Neferisu", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "\"Obranyschopnost tohoto města zvýšíš tím, že ho rozšíříš. S každou novou úrovní bude moci mít tvá posádka o jednoho člena více. Také se zvýší obranný bonus všech jednotek za městskými hradbami.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN004d", "ID_STRING": "NAME_TXT", "TEXT": "Mistrovský lupič", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Davonovy Pevnosti", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV002a", "ID_STRING": "POPUP_TXT", "TEXT": "Vesničané\n\"Můžeš nám vzít naše země, ale jednou se ti za to pomstíme!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN004f", "ID_STRING": "NAME_TXT", "TEXT": "Kopiník", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Skřetí varování", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV002c", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Pozor, pane. Skřeti jsou mimořádně útoční a na bojišti z nich jde hrůza! Mohou nás napadnout, když se utáboříme nedaleko od nich.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV002d", "ID_STRING": "NAME_TXT", "TEXT": "Úkryt zelených", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Tady stojí pevnost zelených, pane. Obvykle tam shromažďují zlato, jež odcizí nebohým kolemjdoucím. Ale také se dokáží poměrně dobře bránit.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0052", "ID_STRING": "NAME_TXT", "TEXT": "Mistrovský lupič", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0030", "ID_STRING": "NAME_TXT", "TEXT": "Den, kdy se objeví goblini", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0030", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Mnoho goblinů ze Severozemí k nám přichází za obchodem. Nebudeme-li dost opatrní, mohou nás i napadnout!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0032", "ID_STRING": "NAME_TXT", "TEXT": "Mana života", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0032", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Ten podivný krystal před námi, můj pane, je mana života, zdroj magické síly!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0032", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Zdroje, jako jsou třeba zlatý důl či krystaly many, které nám nepatří, můžeme ovládnout tak, že vyšleme archanděla, aby k nim vetkl své žezlo.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0033", "ID_STRING": "NAME_TXT", "TEXT": "Kopcový obr", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0033", "ID_STRING": "POPUP_TXT", "TEXT": "Kopcový obr\n\"Co chceš? Já rozhoduju, kdo se tu bude cvičit, a ty nevypadáš, že bys měl ňákou šanci! Ha!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0035", "ID_STRING": "NAME_TXT", "TEXT": "Tip - lektvary", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0035", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Je-li někdo v boji zraněn, můžeš ho vyhojit pomocí léčivého nápoje, případně oživit pomocí nápoje života. Pokud máš v hlavním městě vybudován chrám, můžeš všechny jednotky léčit a oživovat v kterémkoliv městě.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0036", "ID_STRING": "NAME_TXT", "TEXT": "Tip - kouzla", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0036", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Můj pane, když už jsme shromáždili dostatek many, můžeme pomocí kouzel pomáhat sobě a škodit nepřátelům. Proto však musíme vystavět magickou věž, která ještě není zbudována.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0036", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Kouzla získáme tak, že je vyvineme v hlavním městě. Nejprve však musíme shromáždit potřebnou manu.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0037", "ID_STRING": "NAME_TXT", "TEXT": "Tip na přestavbu", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0037", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Až získají dostatek zkušeností, mohou tvé bojové jednotky dosáhnout vyšších postů. Aby však mohly postoupit, musí být v hlavním městě postavena odpovídající budova.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0038", "ID_STRING": "NAME_TXT", "TEXT": "Rada k artefaktu", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0038", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Můj pane, měli bychom se vždy dívat po truhlicích s pokladem, které mohou obsahovat artefakty nebo jiné mocné cennosti. Vypadá to, že jedna taková leží přímo před námi!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0039", "ID_STRING": "NAME_TXT", "TEXT": "Vypnout povyšování", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003a", "ID_STRING": "NAME_TXT", "TEXT": "Tip najímání", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003a", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Můj pane, i když jsme ztratili velkého velitele, nesmíme si zoufat. V hlavním městě si za jistý obnos můžeme najmout jiného.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003b", "ID_STRING": "NAME_TXT", "TEXT": "Skřetí poklad2", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003b", "ID_STRING": "POPUP_TXT", "TEXT": "Skřet\n\"Hej, hej! Jdi od toho pokladu! Zmizni!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003c", "ID_STRING": "NAME_TXT", "TEXT": "Obchodníkův tip", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003c", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Před námi je obchodníkův krámek, kde můžeme nakoupit různé zásoby jako léčivé lektvary a podobně.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003d", "ID_STRING": "NAME_TXT", "TEXT": "Soudce Hello", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003d", "ID_STRING": "POPUP_TXT", "TEXT": "Soudce z Clovisu\n\"Vítej. Jsem soudce z Clovisu a naučím tě základy bojové taktiky. Nemohu se zdržet dlouho, neboť spěchám k pohraničním městům, ale podělím se s tebou o vše, co vím.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003d", "ID_STRING": "POPUP_TXT", "TEXT": "Soudce z Clovisu\n\"Střelecké jednotky, jako například střelec, učedník či akolyta, by měly stát v zadní řadě, čímž budou chráněny před silnějšími jednotkami, které bojují na krátkou vzdálenost (například páže či rytíř na Pegasovi).\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003d", "ID_STRING": "POPUP_TXT", "TEXT": "Soudce z Clovisu\n\"Takže si zapamatuj, že některé jednotky mohou bojovat pouze zblízka, a proto je třeba je umístit do předních řad. Jiné mohou střílet a obvykle jsou slabší, a proto by měly stát vzadu. A v hlavním městě měj vždy celou družinu.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003d", "ID_STRING": "POPUP_TXT", "TEXT": "Soudce z Clovisu\n\"A ještě jedna věc. Přístup k objektům i velitelům v hlavním městě získáš poté, co na ně dvakrát klikneš. Informace vyvoláš kliknutím pravým myšítkem.\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003e", "ID_STRING": "NAME_TXT", "TEXT": "Soudcovo rozloučení", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003f", "ID_STRING": "NAME_TXT", "TEXT": "Boj s vesničany", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003f", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Vzpurní vesničané se blíží a pokouší se obklíčit hlavní město! Musíme je zastavit, ve jménu Nejvyššího otce! Pamatuj na soudcovu radu!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0041", "ID_STRING": "NAME_TXT", "TEXT": "Zlatý důl", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0041", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Tohle je zlatý důl, můj pane. Již jej ovládáme.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0043", "ID_STRING": "NAME_TXT", "TEXT": "Vítězství", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0043", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Vzpurní vesničané se museli vzdát! Celá tato země již spadá pod Říši lidí!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0067", "ID_STRING": "NAME_TXT", "TEXT": "Skřet", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0045", "ID_STRING": "NAME_TXT", "TEXT": "Tip cvičiště", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0045", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Můj pane, před námi se nalézá cvičiště. Za jistý peníz zde mohou naši vojáci získat zkušenosti, jako by se bili na bojišti.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0046", "ID_STRING": "NAME_TXT", "TEXT": "Tip magické věže", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0046", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Toto je magická věž, můj pane. Za jistý peníz si od mága, jenž tam sídlí, můžeme nakoupit nová kouzla.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0047", "ID_STRING": "NAME_TXT", "TEXT": "Setkání se skřety", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0047", "ID_STRING": "POPUP_TXT", "TEXT": "Skřet\n\"Co chceš? Tady není nic pro lidi, jenom špinaví démoni! A teď zmiz a nepřibližuj se k mému pokladu!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0048", "ID_STRING": "NAME_TXT", "TEXT": "Ďábelská mana", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0048", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Před námi se nachází ďábelská mana, jež vychází přímo ze země. Můžeme ji sklízet tak, že poblíž vetkneme žezlo.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0049", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - možnost uzdravení", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV004a", "ID_STRING": "NAME_TXT", "TEXT": "Odstranit hory", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV004a", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Můj pane, otevřeli jsme tajný magický průchod!\"", "SEQ_NUM": 0},
