    {"NO_SCEN": "S226SC0000", "ID_OBJECT": "S226UN0016", "ID_STRING": "NAME_TXT", "TEXT": "Náčelník Ledozmaru", "SEQ_NUM": 0},
    {"NO_SCEN": "S226SC0000", "ID_OBJECT": "S226PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutrální", "SEQ_NUM": 0},
    {"NO_SCEN": "S226SC0000", "ID_OBJECT": "S226PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Žádný popis", "SEQ_NUM": 0},
    {"NO_SCEN": "S226SC0000", "ID_OBJECT": "S226PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Isuel", "SEQ_NUM": 0},
    {"NO_SCEN": "S226SC0000", "ID_OBJECT": "S226PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Tato mocná paní se zamlada samojediná postavila armádě pekelné a jednou rukou ji zničila, neboť zapečetila bránu, jež vojska na tento svět přiváděla. Poté se stala nezávislou vládkyní říše.", "SEQ_NUM": 0},
    {"NO_SCEN": "S226SC0000", "ID_OBJECT": "S226PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Xhmaah", "SEQ_NUM": 0},
    {"NO_SCEN": "S226SC0000", "ID_OBJECT": "S226PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Každé dítě se třese, zaslechne-li toto neblahé jméno - tato vládkyně pekel totiž proslula nezřízenou krvežíznivostí. Na jedné hostině, pořádané na počest Bethrezena a jeho vítězství nad královstvím světla, prý pozřela 1000 otroků.", "SEQ_NUM": 0},
    {"NO_SCEN": "S226SC0000", "ID_OBJECT": "S226PL000b", "ID_STRING": "NAME_TXT", "TEXT": "Aurangzeb", "SEQ_NUM": 0},
    {"NO_SCEN": "S226SC0000", "ID_OBJECT": "S226PL000b", "ID_STRING": "DESC_TXT", "TEXT": "Tato paní svého času proslula jako nejmocnější z adeptů černého umění. Její hrůzovládě sice učinil přítrž inkvizitor Vorgel, který ji zabil, avšak nyní zrůda opět povstala coby nemrtvá, sžírána neutuchající touhou podrobit každého smrtelníka své vůli.", "SEQ_NUM": 0},
    {"NO_SCEN": "S226SC0000", "ID_OBJECT": "S226UN0022", "ID_STRING": "NAME_TXT", "TEXT": "Lupič", "SEQ_NUM": 0},
