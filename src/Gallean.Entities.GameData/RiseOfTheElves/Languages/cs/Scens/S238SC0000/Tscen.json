{
  "formatVersion": 1,
  "rows": [
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Heirik", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN001a", "ID_STRING": "NAME_TXT", "TEXT": "Synclaiřin následovník", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN001c", "ID_STRING": "NAME_TXT", "TEXT": "Synclaiřin následovník", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0021", "ID_STRING": "NAME_TXT", "TEXT": "Lesní elf", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Mrtvá zóna", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Přívrženec odpadlého kultu\n\"Nejdeš-li s námi, jdeš proti nám! Synclaiřino kouzlo brzy ovládne vše a kacířský kult ovládne celou zemi!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Mor", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Přívrženec kacířského kultu\n\"Nikdo z živých nespatří Synclaiřinu tvář! Dítě Solaris bude ochráněno! Chvála Scyonovi!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Město Taura", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Mudrc\n\"Řekami Svornosti nyní proudí démonova nenávist ke všemu živému, která je stejně hluboká jako říční vody. Scyon zničí každého, kdo se odváží přiblížit.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0026", "ID_STRING": "NAME_TXT", "TEXT": "Synclaiřin následovník", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Ohnivý útok", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Přívrženec kacířského kultu\n\"Smrt cizincům!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0029", "ID_STRING": "NAME_TXT", "TEXT": "Synclaiřin následovník", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Prokletí zimy", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Přívrženec kacířského kultu \n\"Nechť severák smete všechny, kteří by chtěli ublížit Scyonovi!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Léčivé jezero", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Duch anděla Sófika\n\"Můj duch je spojen s vodou. Kdysi stačil pouhý dotyk a všichni slabí byli vyléčeni! Avšak Synclaira se svým kacířským kultem z vod vysála veškerou moc a kouzlo bylo rozptýleno.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Léčivé vody dva", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Duch anděla Sófika\n\"Nejsem ničím víc než vizí z dávných dob. Nedávno měly právě tyto vody léčivé účinky. Jednoho dne však jejich kouzlo zmizelo! Zjistili jsme, že jejich uzdravující síly se zmocnila Synclaira se svým kacířským kultem.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN002c", "ID_STRING": "NAME_TXT", "TEXT": "Synclaiřin následovník", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Léčivé vody tři", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Duch anděla Svornosti\n\"Scyon a jeho následovníci proměňují dobro ve zlo - pomohu ti pro dobro Svornosti!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Ochrana města", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Léčivé vody čtyři", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Duch anděla Svornosti\n\"Pomohu ti zničit dítko Synclaiřino. Ale pochop jedno, dítě mé - až bude kacířský kult přemožen, musíš odsud odejít!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Příběh horských kmenů", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Nomád Gílgam\n\"Scyon je potomkem čarodějky Synclairy a božského uzdravitele Solara. Do vínku dostal imunitu na mnohé elementy a uzdravitelské schopnosti, což z něj činí velmi nebezpečného soka!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Calderik \n\"Gílgame, proč máme ty lidi hledat? Povídám, že bychom měli spíše prozkoumat zemi a hledat zlato. Potom se můžeme veselit a pít po celou noc!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Nomád Gílgam\n\"To už stačí, Calderiku! A teď poslouchej - dokud neprokážeš své kvality, nedovolím ti velet nikomu z mých mužů!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Příběh nemrtvých", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Hu'lyr ze Zástupů nemrtvých\n\"V téhle říši něco pěkně páchne! Cítím tu něco známého - známého jako starého nepřítele...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Zythaar \n\"Tvůj strach mne ani trochu nezajímá, blázne. Všichni budou dělat, co jim nakáži, neboť nemáme moc času. Nepřátelé se nemohou skrývat navěky!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' lyr \n\"Přikazuji ti, abysss poslouchal! Za tu urážku tě stihne trest - od nynějška máš nad našimi vojsky jen pramalou moc. Pochop, že pro mne nejsi ničím jiným než tělesnou schránkou, kterou mohu ovládat!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Zpráva z Taury", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Mudrc\n\"Tyto knihy vypráví o prokletí, jež postihlo tuto zemi. Pokud se někdo zmocní tohoto hradu, zlé nestvůry ze vrátí a budou jej chtít získat zpět.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Suldon", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Přívrženec kacířského kultu \n\"Scyon nespočine, dokud nenajde všechny nepřátele své matky a nezničí je! Se svými následovníky každého obětuje řece.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Lesní Citadela", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Přívrženec kacířského kultu \n\"Tyto vody kdysi požehnal anděl - kdysi měly ozdravné účinky, ale dnes už tomu tak naštěstí není, díky velkému Scyonovi! Chvalte Scyona a konejte jeho zlou vůli!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Satora", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Přívrženec kacířského kultu \n\"Scyon zničí každého, kdo vstoupí do tohoto města. Všichni chvalte bestii Scyona!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Scyon HK", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Scyon nemrtví", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN003b", "ID_STRING": "NAME_TXT", "TEXT": "Lesní elf", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Vítězství horských kmenů", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Nomád Gílgam\n\"Za cenu velkého úsilí a obrovských obětí horské kmeny nakonec zvítězily. Zbavili jsme tuto zemi kacířského kultu. Lid Svornosti může opět žít v míru, tak jako dříve. Kéž by naše jméno přetrvalo navěky!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Vítězství nemrtvých", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' lyr \n\"Vypudili jsme kacířský kult a porazili Scyona! Po vládkyni Synclaiře není ani památky. Ode dneška si ona i horské kmeny budou pamatovat, že Zástupy nemrtvých nikdo nezastaví!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Zythaarova zrada", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Přívrženec kacířského kultu\n\"Pošetilí nemrtví! Synclaiřinu volání nikdo neodolá! Přidej se k nám! Přidej se k nám a poznej sílu! Jinak tě opustí i poslední z věrných!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Zythaar \n\"Uvidíme, kdo se bude smát naposled! A ukáže se také, kdo je níže postaven!! Já svým mečem dokáži rozsekat celé Zástupy nemrtvých!\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Calderikova zrada", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Přívrženec kacířského kultu \n\"Přidej se k nám, přidej se k nám - v žilách ti bude proudit velká moc! Přidej se k nám - poznej krásu Synclaiřinu! Zbav se všeho rozumu a odevzdej se Synclaiře!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Calderik \n\"Gílgame, nyní tvrdě pomstíme tvou nezpůsobilost. Všichni tvoji věrní ochutnají ostří mé sekyry. Budu to já, kdo bude slavit po boku kacířů!\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví, příběh, den 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Hu'Lyr  \n\"Tihle obyvatelé jsou mi nějak povědomí. Cítím, že je to práce těch zpropadených Legií. Něco tu není v pořádku - a já chci zjistit co.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Zythaar \n\"Jediné, co tu není v pořádku, je tvoje vedení. Při Mortisině moci, nejsi nic víc než pošetilec!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Hu'lyr \n\"Zythaare, varoval jsem tě, abys neurážel mou autoritu! Až svůj úkol splníme, budeš tisíckrát potrestán. A Mortisino jméno už nikdy nevyslovuj, slabochu!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví, příběh, den 5", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' Lyr \n\"Teď už vím, o co jde! Na občany Svornosti stejně jako na nás působí ten kacířský kult! Musíme najít a zničit Scyona, než bude náš osud zpečetěn!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0020", "ID_STRING": "NAME_TXT", "TEXT": "HK příběh 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Nomád Gílgam\n\"Ten pach poznávám - síru kdysi ke svým obřadům používal jistý kult, který dokázal ovládat mysl druhých. A právě tento kult tu teď musí být! Musíme se postarat o ochranu našeho lidu!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Calderik \n\"Jediný zápach, který rozeznávám, je puch tvého diletantství. Závan snahy pošpinit mé vůdčí postavení a přede všemi mne napomínat! Snáším tě jenom pro slávu Wotanovu!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Nomád Gílgam\n\"Calderiku, ty pokoušíš mou trpělivost. Mou autoritu už vícekrát nezpochybňuj! Já mám zodpovědnost, protože jsem v těchto končinách byl už předtím. Až naše poslání skončí, můžeš se vrátit domů, zatímco ostatní budou popíjet a radovat se!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Calderik \n\"....\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0021", "ID_STRING": "NAME_TXT", "TEXT": "HK, den 6", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Mudrc\n\"Ten puch je čím dál silnější! Kacířský kult nemůžeme brát na lehkou váhu. Už jsme ztratili Calderika a předpokládám, že nás brzy napadnou nepřátelé.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0044", "ID_STRING": "NAME_TXT", "TEXT": "Páže", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Taura", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0047", "ID_STRING": "NAME_TXT", "TEXT": "Páže", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0024", "ID_STRING": "NAME_TXT", "TEXT": "Bestie řádí", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0024", "ID_STRING": "POPUP_TXT", "TEXT": "Přívrženec kacířského kultu \n\"Nastala naše hodina! Přijď, bestie Scyone, přijď a znič naše nepřátele! Veleben buď Scyon!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0025", "ID_STRING": "NAME_TXT", "TEXT": "HK, tah 10", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Nomád Gílgam\n\"Zjistil jsem, že musíme dobýt tři města - až je ovládneme, zjeví se samotný Scyon!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví, příběh, tah 10", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0026", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' Lyr \n\"Musíme dobýt tři města - jedině potom se objeví Ssscyon. Zničíme tu podlou obludu, jen co ukáže svou odpornou tvář!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Pokud Calderik zemře", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Z zabit", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN004c", "ID_STRING": "NAME_TXT", "TEXT": "Páže", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Zpráva ze Satory", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0029", "ID_STRING": "POPUP_TXT", "TEXT": "Huz' lyr \n\"Tak se ukaž, Ssscyone! Zástupy nemrtvých se tě nebojí - to ty se bojíš nás!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví - útok trolů", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV002c", "ID_STRING": "NAME_TXT", "TEXT": "HK zlobr útočí", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV002d", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví, tah 29", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' Lyr \n\"Kacířský kult na nás chce zaútočit - musíme být tedy připraveni! Chtějí využít toho, že Ashgan tak zeslábl!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV002e", "ID_STRING": "NAME_TXT", "TEXT": "Horský útok", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV002e", "ID_STRING": "POPUP_TXT", "TEXT": "Nomád Gílgam\n\"Kacířský kult chystá útok! Musíme být připraveni na všechno!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV002f", "ID_STRING": "NAME_TXT", "TEXT": "Odstraň láv. jícny", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0053", "ID_STRING": "NAME_TXT", "TEXT": "Mistrovský lupič", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0030", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví, příběh, den 9", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0030", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' Zar  \n\"Hovořil jsem sss nepokojnými mrtvými válečníky. Prozradili mi, že musíme bránit Ashgana. Kacíři mohou našeho strážce napadnout každou chvíli!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0031", "ID_STRING": "NAME_TXT", "TEXT": "HK, den 9", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0031", "ID_STRING": "POPUP_TXT", "TEXT": "Mudrc\n\"Musíme Vithara ochránit před zlou Synclairou! Její žízeň po moci je neuhasitelná! Jestli vyšle své služebníky, aby přemohli Vithara, vysaje z něj životní sílu. Musíme se na ni připravit!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0031", "ID_STRING": "POPUP_TXT", "TEXT": "Vithar \n\"Jen ať ta čarodějnice přijde, už se nemohu dočkat boje!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0056", "ID_STRING": "NAME_TXT", "TEXT": "Páže", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0033", "ID_STRING": "NAME_TXT", "TEXT": "HK, den 60", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0033", "ID_STRING": "POPUP_TXT", "TEXT": "Přívrženec kacířského kultu \n\"Pro slávu Synclaiřinu a chválu Solarova dítka zdoláme všechny nepřátele! Velebena buď Synclaira!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0034", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví, den 60, útok", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0034", "ID_STRING": "POPUP_TXT", "TEXT": "Přívrženec kacířského kultu\n\"Pochválena buď Synclaira a její černé srdce! Nyní je ten pravý čas - skloňte se před našimi spojenými silami! A v boji pohleďte do tváří svých bývalých následovníků a vězte, že vaše dny jsou sečteny!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0035", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví, den 55", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0035", "ID_STRING": "POPUP_TXT", "TEXT": "Přívrženec kacířského kultu \n\"Čas hraje proti vám a brzy vás všechny pohltí! Nyní nastala pravá chvíle, aby si Synclaira a její následovníci vzali zpět, co jim náleží!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0059", "ID_STRING": "NAME_TXT", "TEXT": "Páže", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0036", "ID_STRING": "NAME_TXT", "TEXT": "HK den 55", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0036", "ID_STRING": "POPUP_TXT", "TEXT": "Přívrženec kacířského kultu \n\"Jen tak dál! Bojujte a prohrávejte! S radostí budeme sledovat, jak ti, kteří nás nejdřív odmítali, na kolenou prosí, aby se mohli připojit ke kacířskému kultu! Bojujte a vězte, že konečné vítězství připadne Synclaiře!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0037", "ID_STRING": "NAME_TXT", "TEXT": "HK den 52", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0037", "ID_STRING": "POPUP_TXT", "TEXT": "Mudrc\n\"Musíme být připraveni na všechno! Synclaiřini následovníci mohou zaútočit na naše hlavní město a Vitharovu moc podrobit svým zvrhlým záměrům!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0038", "ID_STRING": "NAME_TXT", "TEXT": "Nemrt., den 52", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0038", "ID_STRING": "POPUP_TXT", "TEXT": "Hun'lyr \n\"Sssynclaira! Jak nenávidím tohle jméno! Její přisssluhovači nás brzy napadnou - musíme Ashgana ochránit před jejími pomýlenými následovníky!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0038", "ID_STRING": "POPUP_TXT", "TEXT": "Ashgan \n\"Žádnou ochranu nepotřebujeme! Jen ať si přijde!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0039", "ID_STRING": "NAME_TXT", "TEXT": "U Day 8", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0039", "ID_STRING": "POPUP_TXT", "TEXT": "Kostlivec \n\"Assshgana cosssi ossslabuje. Něco z něj vysssává sssílu! Zdálky ke mně stále doléhá tichý zlomyslný smích!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003a", "ID_STRING": "NAME_TXT", "TEXT": "HK, den 8", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003a", "ID_STRING": "POPUP_TXT", "TEXT": "Nomád Gílgam\n\"Vithar slábne - něco je ve vzduchu! Ta síra z něj asi vysává energii! Musíme ho ve dne v noci bedlivě střežit - nemáme potuchy, nač tu ukradenou sílu použijí!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003a", "ID_STRING": "POPUP_TXT", "TEXT": "Vithar \n\"Je mi dobře! Nestarej se!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003c", "ID_STRING": "NAME_TXT", "TEXT": "Legie se objevují", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003c", "ID_STRING": "POPUP_TXT", "TEXT": "Přívrženec kacířského kultu\n\"Chvála Scyonovi a jeho bájnému hněvu! Přidej se k nám, nebo tě zničí naši následovníci!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003d", "ID_STRING": "NAME_TXT", "TEXT": "Lid. říše se objevuje", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003d", "ID_STRING": "POPUP_TXT", "TEXT": "Přívrženec kacířského kultu \n\"Moc kacířského kultu každým dnem vzrůstá. Všude je spousta slabomyslných a Synclaiře nikdo neunikne. Až nastane pravý čas, ten váš milovaný Vithar před námi také padne!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003e", "ID_STRING": "NAME_TXT", "TEXT": "Hor. kmeny, den 19", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003e", "ID_STRING": "POPUP_TXT", "TEXT": "Nomád Gílgam \n\"Tauru hlídá zelený drak, který se pravidelně zjevuje. Pokud někdo toto město dobude, po několika dnech se drak objeví, aby je chránil. Taury se však musíme zmocnit za každou cenu!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003f", "ID_STRING": "NAME_TXT", "TEXT": "Drak z Taury", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0040", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví, den 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0040", "ID_STRING": "POPUP_TXT", "TEXT": "Hu'nskel \n\"Zjistil jsem, že Ssscyon pátrá po svém otci Solarovi! Pokusme se ho vyprovokovat - zaberme tři z jeho měssst - Suldon, Satorii a Tauru. Až budou naše, Scyon se je pokusí získat zpět!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0063", "ID_STRING": "NAME_TXT", "TEXT": "Kultista", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0041", "ID_STRING": "NAME_TXT", "TEXT": "HK, den dva", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0041", "ID_STRING": "POPUP_TXT", "TEXT": "Mudrc\n\"Scyona můžeme vylákat jedině tak, že ublížíme jeho zemím! Dobudeme-li města Tauru, Satorii a Lesní Citadelu, Scyon se jistě zjeví a pokusí se je získat zpět!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0042", "ID_STRING": "NAME_TXT", "TEXT": "HK, den 28, rada", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0042", "ID_STRING": "POPUP_TXT", "TEXT": "Nomád Gílgam\n\"Děje se něco nekalého - měli bychom posílit posádku hlavního města - když je Vithar takhle slabý, nemáme příliš nadějné vyhlídky!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0043", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví, den 28, rada", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0043", "ID_STRING": "POPUP_TXT", "TEXT": "Mrtv rytíř Huz' Rala\n\"Kacířský kult je nebezpečný! Trvám na tom, že někdo musí zůstat také vzadu - Ashgan na tom není zrovna nejlépe. V boji s kacířským kultem nelze spoléhat jen na náhodu!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0043", "ID_STRING": "POPUP_TXT", "TEXT": "Ashgan \n\"Vše je v pořádku. Přinesss nám massso!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0044", "ID_STRING": "NAME_TXT", "TEXT": "HK, den 40", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0044", "ID_STRING": "POPUP_TXT", "TEXT": "Nomád Gílgam\n\"Musíme být neustále ve střehu - nepřátelé ví, že Vithar je oslaben, a určitě se toho pokusí využít! Jejich temná umění jsou pro nás velkou hrozbou. Každou chvíli na nás mohou zaútočit!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0047", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví 41, varování", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0047", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' Zar \n\"Ashgan je slabý a naši nepřátelé toho dozajista využijí! Nemůžeme prohrát, protože jsme Zástupy nemrtvých, ale připravte se na pošetilé útoky na Ashgana!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV004b", "ID_STRING": "NAME_TXT", "TEXT": "HK, den 57", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV004d", "ID_STRING": "NAME_TXT", "TEXT": "HK, den 31", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV004d", "ID_STRING": "POPUP_TXT", "TEXT": "Nomád Gílgam\n\"Kacířský kult možná prohrál tuto bitvu, ale zase se vrátí! Zástupy nemrtvých jsou bezpochyby také napadeny. Pokud padne jejich hlavní město, Synclairu už nikdo nezastaví!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV004e", "ID_STRING": "NAME_TXT", "TEXT": "Den 31", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV004e", "ID_STRING": "POPUP_TXT", "TEXT": "Kostlivec \n\"V boji máme převahu! Věřím, že brzy už nikoho z toho kacířssského kultu neuvidíme! Horssské kmeny čelí stejné hrozbě - jessstli padne jejich hlavní město, kacířský kult bude nezastavitelný!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV004f", "ID_STRING": "NAME_TXT", "TEXT": "Suldon Satoria", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV004f", "ID_STRING": "POPUP_TXT", "TEXT": "Přívrženec kacířského kultu \n\"Bídná nemrtvá stvoření! Je mi nanic z toho, že jste se objevila v našich městech! Za tu drzost vás čeká věčné utrpení!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0050", "ID_STRING": "NAME_TXT", "TEXT": "Nová událost", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0051", "ID_STRING": "NAME_TXT", "TEXT": "Den 51", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0051", "ID_STRING": "POPUP_TXT", "TEXT": "Přívrženec kacířského kultu\n\"Nikdo nepřežije! Nikdo nemůže zničit Scyona - bestii, na niž pozemská síla nijak nepůsobí! Jen si to zkus a vychutnej si vlastní drtivou porážku!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0052", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví, den 46", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0052", "ID_STRING": "POPUP_TXT", "TEXT": "Přívrženec kacířského kultu\n\"Zničme Zástupy nemrtvých a vítězství bude naše! Tak praví Scyon!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0053", "ID_STRING": "NAME_TXT", "TEXT": "HK, den 46", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0053", "ID_STRING": "POPUP_TXT", "TEXT": "Přívrženec kacířského kultu \n\"Nastal čas, abychom rozdrtili kdysi mocné horské kmeny! Zničíme jejich milovaného Vithara a Synclaira si bude užívat veškeré jeho moci!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0055", "ID_STRING": "NAME_TXT", "TEXT": "Test anděla Svornosti", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0055", "ID_STRING": "POPUP_TXT", "TEXT": "Svornost\n\"Mnozí mne znají jako anděla Svornosti. Kacířský kult uvěznil mého ducha v kameni. Nyní požehnám této zemi a čas od času vyhojím všechny tvé rány. Budeš-li sláb, obrať své kroky sem a tvá zranění budou vyléčena.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0078", "ID_STRING": "NAME_TXT", "TEXT": "Démonolog", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0057", "ID_STRING": "NAME_TXT", "TEXT": "Území nekonečného uzdravení", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN007a", "ID_STRING": "NAME_TXT", "TEXT": "Démonolog", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0058", "ID_STRING": "NAME_TXT", "TEXT": "Zničení Svornosti - kultista", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0058", "ID_STRING": "POPUP_TXT", "TEXT": "Sófik\n\"Jsem Sófik, anděl života. Děkuji, že jsi mou duši vysvobodil z té ohnivé jeskyně! Nyní jsem ji očaroval tak, aby si v ní poutníci mohli čas od času odpočinout a uzdravit se.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0059", "ID_STRING": "NAME_TXT", "TEXT": "Nekonečné zdraví dvě", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV005b", "ID_STRING": "NAME_TXT", "TEXT": "Historie hor. anděla", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV005b", "ID_STRING": "POPUP_TXT", "TEXT": "Mudrc\n\"Jednou jsem četl pověst o Svornosti: kdysi žili dva andělé, kteří už nesnesli utrpení, jež sužuje tento svět, a proto proměnili obyčejnou řeku v magické místo - nemocní, kteří se omyli v jejích vodách, se zázračně uzdravili!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV005c", "ID_STRING": "NAME_TXT", "TEXT": "Anděl. historie - nemrtví", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV005c", "ID_STRING": "POPUP_TXT", "TEXT": "Černokněžník\n\"Toto místo, zvané Svornost, kdysi chránili dva andělé, kteří věřili, že je zapotřebí pomáhat nemocným a slabým, a proto zdejší řeku obdařili zázračnou léčivou silou!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0080", "ID_STRING": "NAME_TXT", "TEXT": "Kultista", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV005d", "ID_STRING": "NAME_TXT", "TEXT": "Pokud Zythaar zemře", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV005e", "ID_STRING": "NAME_TXT", "TEXT": "Bestie Scyon získává Scyona B", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0086", "ID_STRING": "NAME_TXT", "TEXT": "Kultista", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0089", "ID_STRING": "NAME_TXT", "TEXT": "Zuřivý válečník", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238FT0000", "ID_STRING": "NAME_TXT", "TEXT": "Město Fergal", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238FT0001", "ID_STRING": "NAME_TXT", "TEXT": "Suldon", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238FT0002", "ID_STRING": "NAME_TXT", "TEXT": "Taura", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238FT0004", "ID_STRING": "NAME_TXT", "TEXT": "Timoria", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238FT0006", "ID_STRING": "NAME_TXT", "TEXT": "Lesní Citadela", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238FT0007", "ID_STRING": "NAME_TXT", "TEXT": "Satoria", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0095", "ID_STRING": "NAME_TXT", "TEXT": "Démonolog", "SEQ_NUM": 0},
