    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN00b4", "ID_STRING": "NAME_TXT", "TEXT": "Zuřivý válečník", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN00b8", "ID_STRING": "NAME_TXT", "TEXT": "Spojení kultistů", "SEQ_NUM": 0},
