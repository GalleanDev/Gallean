    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Moje zboží ti může pomoci na cestách.", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Othonova věž", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Má kouzla jsou nejmocnější v kraji.", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutrální", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Žádný popis", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Calderik", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Tento nejvyšší z trpasličích pánů si získal věhlas díky nesmírné síle v boji a odvaze tváří v tvář nesmírné přesile. Jednou po celých sedm dní a nocí bojoval s mocným rudým drakem Arfuruzonem, než nad ním konečně zvítězil.", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Khagrael", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Tento pán svého času proslul jako nejmocnější z adeptů černého umění. Jeho hrůzovládě sice učinil přítrž inkvizitor Vorgel, který ho zabil, avšak nyní zloduch opět povstal coby nemrtvý, sžírán neutuchající touhou podrobit každého smrtelníka své vůli.", "SEQ_NUM": 0}
