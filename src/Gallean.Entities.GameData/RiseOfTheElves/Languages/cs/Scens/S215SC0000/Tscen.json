{
  "formatVersion": 1,
  "rows": [
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Vyloupit zřícený hrad - lidé2", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Přetvořená Drega Zul\n\"Nyní rozumím, můj Krath'du. Naším osudem je být spolu.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Můj pane! Zlý Krath'du tohle všechno plánoval - vlákal nás do pasti a uhranul Dregu Zul! I když jsme oslabeni, musíme vytrvat. Musíme Krath'du zabít a zlomit tak kouzlo, jež na ni seslal!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "\"Nezoufej, už jsem vzkázal pro posily, pane.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Útok na Rivendskou stráž1", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0026", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul\n\"Když jsme teď zasadili první úder, lidé na něj pravděpodobně brzy odpoví. Pokud nejsme připraveni na válku, měli bychom odsud odejít!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0049", "ID_STRING": "NAME_TXT", "TEXT": "Mistrovský lupič", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Útok na Rivendskou stráž2", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul\n\"Když jsme teď zasadili první úder, lidé na něj pravděpodobně brzy odpoví. Pokud nejsme připraveni na válku, měli bychom odsud odejít!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Rivendu - nemrtví", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "\"Tito lidé vědí, co Krath'du dělal. Mohl nakazit více nevinných, než si dokážeme představit! Měli bychom pokračovat ve svém úsilí.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN004c", "ID_STRING": "NAME_TXT", "TEXT": "Kopiník", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Dobutí Fendhilu - nemrtví", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0029", "ID_STRING": "POPUP_TXT", "TEXT": "\"Pane, tito vesničané netuší, co teď Krath'du činí. Neviděli ho tu už hezkých pár let.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví prohrávají", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002a", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Krath'du stále žije a nespočine, dokud nepomstí smrt Drega Zul. Ve svém hněvu rozmetá celé uspořádání Zástupů nemrtvých! Musíme se nyní soustředit na vlastní obranu!\"\n", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002b", "ID_STRING": "NAME_TXT", "TEXT": "Drega Zul dobývá Fendhil", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví vítězí2", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002c", "ID_STRING": "POPUP_TXT", "TEXT": "\"Šílený Krath'du je konečně mrtev. Už více nebude prolévat naši posvátnou krev.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN004f", "ID_STRING": "NAME_TXT", "TEXT": "Vlk", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0050", "ID_STRING": "NAME_TXT", "TEXT": "Vlk", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002f", "ID_STRING": "NAME_TXT", "TEXT": "Drega se blíží ke Krath'du", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "Krath'du\n\"Čekal jsem na tebe tak dlouho, Drego Zul! Musíme být spolu, chápeš? Naším osudem je vládnout těmto zemím - společně!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul\n\"Nyní rozumím, můj Krath'du... je naším osudem být spolu!\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "\"Můj pane! Zlý Krath'du to celé naplánoval - aby nás lapil do pasti a očaroval Dregu Zul! I když jsme unaveni, musíme vytrvat. Musíme prolomit kouzlo, které na ni seslal!\"", "SEQ_NUM": 5},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0030", "ID_STRING": "NAME_TXT", "TEXT": "Vyloupit hrad, ničit nemrtvé", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0031", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví - objevení krakena", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0031", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Pane! V hlubinách jsme probudili nějakou nestvůru! Musíme utéci!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0032", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - lok. tip Krath'du", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0032", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul\n\"Tuto oblast zpustošila nějaká temná síla, můj pane. Možná že Krath'du bude už blízko!\"\n", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0033", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví - lok. Krath'du", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0033", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Tuto oblast zpustošili nemrtví, pane. Krath'du už musí být blízko.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0035", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - lok. varování před Krakenem", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0035", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul\n\"Poslyš toto varování, můj pane: v této oblasti byli spatřeni krakeni. Měli bychom se raději vrátit!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0058", "ID_STRING": "NAME_TXT", "TEXT": "Poustevník", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0036", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví - lok. varování před krakenem", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0036", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Dbej mého varování, pane: v této oblasti byli spatřeni krakenové. Měli bychom se vrátit!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0059", "ID_STRING": "NAME_TXT", "TEXT": "Trpaslík", "SEQ_NUM": 0},
