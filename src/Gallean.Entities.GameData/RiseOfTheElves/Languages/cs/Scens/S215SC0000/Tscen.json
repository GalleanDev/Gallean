    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO000c", "ID_STRING": "NAME_TXT", "TEXT": "Poustevník na svaté půdě", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO000d", "ID_STRING": "NAME_TXT", "TEXT": "Páže útočí", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO000e", "ID_STRING": "NAME_TXT", "TEXT": "Vlci", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO000f", "ID_STRING": "NAME_TXT", "TEXT": "Zimraanova věž", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO0010", "ID_STRING": "NAME_TXT", "TEXT": "Drega Zul skrytá", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO0011", "ID_STRING": "NAME_TXT", "TEXT": "Varování před krakenem", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Výcvik jednotek", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Pojď dál a já z tvých nedomrlých vojáčků vycvičím zdatné bojovníky.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Kovář Kekkut", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0001", "ID_STRING": "TXT_DESC", "TEXT": "U nás najdeš to nejdůležitější pro každého válečníka.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Rivendský trh", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0002", "ID_STRING": "TXT_DESC", "TEXT": "U nás můžeš nakoupit všechny druhy zboží!", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Zimraanova věž", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Mám tu mnohá ďábelská kouzla.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutrální", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Žádný popis", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Breasal", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Tento mocný pán se zamlada samojediný postavil armádě pekelné a jednou rukou ji zničil, neboť zapečetil bránu, jež vojska na tento svět přiváděla. Poté se stal nezávislým vládcem říše.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Uallgarg", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Tento pán svého času proslul jako nejmocnější z adeptů černého umění. Jeho hrůzovládě sice učinil přítrž inkvizitor Vorgel, který ho zabil, avšak nyní zloduch opět povstal coby nemrtvý, sžírán neutuchající touhou podrobit každého smrtelníka své vůli.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Cathal", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Conall", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN000d", "ID_STRING": "NAME_TXT", "TEXT": "Trpaslík", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0019", "ID_STRING": "NAME_TXT", "TEXT": "Lední medvěd", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - objevení krakena", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul\n\"Můj pane! V hlubinách jsme probudili nějakou obludu! Musíme prchnout!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Dobutí Fendhilu", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Vesničané\n\"Jméno Krath'du, které vyvolává hrůzné vzpomínky na bolest a utrpení!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Rivendu - lidé", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Vesničané\n\"Jméno Krath'du jsme zaslechli už předtím. V těch hrůzných letech se prý při drancování jedné vesnice smiloval nad mladou nevěstou...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "\"Byla tak krásná, a čekala dítě. Proto ji nezavraždil, ale objal ji svým pláštěm smrti! Dívčí tělo však cítilo, jak nenarozené dítě upířímu útoku odolává a nelze je proměnit. A tak dívka vydechla naposledy.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul\n\"Ten příběh! Zní mi až příliš povědomě!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Kekkufu", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Vesničané\n\"Vpád do tohoto kmene si šeredně odskáčeš! Kéž by tě ti démoni, které hledáš, sežrali!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Dobyti Kalajitu", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Vesničané\n\"Za to, co jsi udělal, z tebe kmeny zaživa stáhnou kůži! Takovou zkázu nemůže omluvit žádné démonické poslání! Za to zaplatíš!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0028", "ID_STRING": "NAME_TXT", "TEXT": "Lupič", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Poblíž Rivendu - lidé", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul\n\"Blížíme se ke městu Rivend, můj pane. Bylo velmi dobře opevněno a po léta odolávalo útokům nemrtvých. Nebude snadné je dobýt, neboť jeho obyvatelé jsou na válku zvyklí!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Poblíž nemrtvých - lidé", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul\n\"Toto je vstup na území nemrtvých, můj pane. Buď opatrný! Stvůry noci jsou velmi nebezpečné!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Vyloupit pozorovatelnu Říše lidí", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "\"Na věži je patrný nějaký nápis, ale jen část zůstala ještě čitelná. Praví:\n'A když nosferatu Krath'du upřel oči na dámu, pravil k ní: Buď mou'\nCo ty řádky asi značí, pane?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Vyloupit opuštěný přístřešek - lidé", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul\n\"V této svatyni sice naposledy sídlil medvěd, ale vše prostupující duch smrti a lebky vyrovnané podél stěny hovoří samy za sebe. Není pochyb, že se tu ukrýval upír.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Vyloupit alchymistickou lab. - lidé", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul\n\"Nevidím žádnou známku toho, že by se Krath'du nějak stýkal s trpaslíky, můj pane. Našla jsem tu pouze obvyklé magické nástroje horských kmenů.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Vyloupit zřícený hrad - lidé1", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Krath'du\n\"Čekal jsem na tebe tak dlouho, Drego Zul! Musíme být spolu, chápeš? Naším osudem je vládnout těmto zemím - společně!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Zpráva nemrtvých", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "\"Říše lidí vypátrala Krath'du, pane. Musíme ho okamžitě zajmout, nebo ho ti slabí císařští vojáci ještě nechají uprchnout!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Den po vyloupení lidské říše", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "SIr Geldwin\n\"Chápeme, že jsi ztratil cenného velitele. Jsme tu, abychom nahradili tvé ztráty, můj pane!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví - intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "\"Pane! Šílený nosferatu Krath'du uprchl z hlavního města! Opustil je ve dne, když se mu podařilo přesvědčit několik vojáků. Jeho služebníci praví, že se vydal hledat svou věrnou družku - bídnou napůl lidskou a napůl nemrtvou bytost, již sám vytvořil a kt", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "\"Před mnoha lety se pokusil přetvořit smrtelnou matku, která nosila dítě. Nenarozené smrtelné tělo pak bylo samozřejmě přetvořeno do zrůdy, kterou nyní je. Musíme ho zastavit, než rozšíří svou moc! Už žádný další temný dar!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul\n\"Můj pane, dosud jsem se v tvých řadách cvičila a věrně ti sloužila. Nyní však nastal čas, abych pomstila smrt svého otce.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "\"Před mnoha lety ho zrůdně zavraždil nosferatu, který na mne uvrhl pominutí smyslů. Musím pomstít jeho smrt! Zapřísahám tě, pomoz mi najít toho démona!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Má pravdu, můj pane. Měli bychom rozhodně udeřit na nemrtvá vojska, která spáchala bezpočet ukrutností na našem lidu. Nyní musí zloduchové pocítit náš hněv!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Pozorovatelna Říše lidí", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Vzbouřené páže\n\"Vojáci z Říše lidí nesmějí vstoupit do této věže!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Pozorovatelna nemrtvých", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Vzbouřené páže\n\"Pozor! Zbraně připravit! Nemrtví útočí!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Poblíž Rivendu - nemrtví", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Stráž kopiníků\n\"Zvoňte na poplach! Nemrtví se blíží! Zalarmujte mágy!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0036", "ID_STRING": "NAME_TXT", "TEXT": "Rivenský kopiník", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Kmenový průsmyk", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Kamenný obr\n\"Toto je kmenové území a ty tu nemáš co pohledávat. Obrať se zpět, nebo pocítíš následky!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Poblíž Fendhilu - lidé", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Vzbouřené páže\n\"Odstup od našeho města, císařský vojáku! Náš lid už netrpí pod vaším útlakem!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN003a", "ID_STRING": "NAME_TXT", "TEXT": "Vzbouřené páže", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Poblíž Fendhilu - nemrtví", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Vzbouřené páže\n\"Ani nepomysli na to, že by se obyvatelé tohoto města nechali jen tak zabít! Připrav se na smrt, nemrtvá svině!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Poustevník na svaté půdě", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Poustevník\n\"Ti, jejichž srdce není čisté, nemají na tomto místě odpočinku co dělat! Je vyhrazeno pouze pro Wotanovy vyvolené válečníky! Očistím je od vaší přítomnosti!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN003c", "ID_STRING": "NAME_TXT", "TEXT": "Kopiník", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Páže útočí - nemrtví", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Vzbouřené páže\n\"Nechť vás síly světla zničí, nečistí nemrtví!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Varování před vlčí bestií", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "\"Můj pane, místní obyvatelé mají jakousi pověru o vlčí bestii, která obývá toto území.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN003e", "ID_STRING": "NAME_TXT", "TEXT": "Mistrovský lupič", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí den 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Náš informátor mezi nemrtvými nás upozornil, že nedávno zmizel jistý pán jménem Krath'du. Možná že to je ten krutý zabiják, jakého hledáme!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí vítězí", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Vyloupit opuštěný přístřešek - nemrtví", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "\"Krath'du byl tady! Po stěnách rozvěsil lebky těch, jež pozřel. Avšak nevidím tu žádný náznak, kam se poté obrátil.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0041", "ID_STRING": "NAME_TXT", "TEXT": "Vzbouřené páže", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Vyloupit alchymistickou lab. - nemrtví", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "\"Tady nic moc není, pane. Jen prosté magické trpasličí zboží.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Vyloupit zřícený hrad - nemrtví1", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Krath'du\n\"Nemyslete si, že vám teď pomohou ty vaše zastaralé způsoby, nemrtví! Spolu se svou milovanou Dregou Zul vytvoříme nový lepší národ. Čekám na ni, a až přijde, všichni zahynete!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Zpráva od Říše lidí", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "\"Nemrtví zjistili, kde se Krath'du nachází! Pospěšme do útoku!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0044", "ID_STRING": "NAME_TXT", "TEXT": "Vzbouřené páže", "SEQ_NUM": 0}
  ]
}
