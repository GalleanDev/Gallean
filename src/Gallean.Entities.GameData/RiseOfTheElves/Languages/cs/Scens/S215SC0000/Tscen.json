    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO0009", "ID_STRING": "NAME_TXT", "TEXT": "Zásoby démonů", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO000a", "ID_STRING": "NAME_TXT", "TEXT": "Kmenový průsmyk", "SEQ_NUM": 0},
