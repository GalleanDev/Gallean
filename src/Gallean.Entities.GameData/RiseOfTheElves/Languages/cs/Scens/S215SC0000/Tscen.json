    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO0006", "ID_STRING": "NAME_TXT", "TEXT": "T Drega Zul se objevuje", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO0007", "ID_STRING": "NAME_TXT", "TEXT": "Vyčištění lokace", "SEQ_NUM": 0},
