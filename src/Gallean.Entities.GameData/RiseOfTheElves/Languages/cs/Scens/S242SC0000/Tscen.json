    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Tento mocný pán se zamlada samojediný postavil armádě pekelné a jednou rukou ji zničil, neboť zapečetil bránu, jež vojska na tento svět přiváděla. Poté se stal nezávislým vládcem říše.", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Theodemis", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Tento nejvyšší z trpasličích pánů si získal věhlas díky nesmírné síle v boji a odvaze tváří v tvář nesmírné přesile. Jednou po celých sedm dní a nocí bojoval s mocným rudým drakem Arfuruzonem, než nad ním konečně zvítězil.", "SEQ_NUM": 0},
