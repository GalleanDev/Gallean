    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242UN0154", "ID_STRING": "NAME_TXT", "TEXT": "Skřet", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242UN015f", "ID_STRING": "NAME_TXT", "TEXT": "Brodulf", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242UN0162", "ID_STRING": "NAME_TXT", "TEXT": "Marileif", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242UN0166", "ID_STRING": "NAME_TXT", "TEXT": "Lední medvěd", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0000", "ID_STRING": "NAME_TXT", "TEXT": "HK vítězí", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0002", "ID_STRING": "NAME_TXT", "TEXT": "HK dobytí Kwelie", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Kmen Arhigos\n\"Náš kmen míní žít v míru, proč nás tedy nenecháš na pokoji? Nechceme s tebou mít nic společného!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Lidé dobývají Kwelii", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Kmen Arhigos\n\"Náš kmen ti nijak neublížil! Proč jsi přišel a zabral nám naši vesnici?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Lidé dobývají Dimmel", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Opatrně, pane, na Dimmel často útočí nemrtvé stvůry.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Confluence", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Zombie \n\"Bastel Royas vám to spočítá!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Tesley", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Zajatí barbaři\n\"Naši jižní bratranci nám vyprávěli, že upír Bastel Royas se skrývá v horské tvrzi kdesi na jihu. Jeho bys měl obtěžovat, a ne nás!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Dobyti Koulouria", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Vesničané\n\"Osvobodil jsi nás! Možná ti pomůže tato informace: na východ odsud nalezneš Sangleton. Právě tam sídlí hrozivý upír Bastel Royas!\"\n", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - lok. Bastelova zpráva", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Bastel Royas\n\"Vítej! Dovol, abych se představil, jmenuji se Bastel Royas a brzy se stanu vládcem celého Nevendaaru. Vrať se zpět a vyřiď tuto zprávu všem, kdož slouží Nejvyššímu otci!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV000e", "ID_STRING": "NAME_TXT", "TEXT": "HK lok. zpráva od Bastela", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Bastel Royas\n\"Ha! Nemůžeš se měřit s velkým upírem Bastelem Royem! Nastal čas, abys okusil můj hněv! Vyřiď Wotanovi, že je blázen, když sem poslal tvou ubohou armádu!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Hřbitov Říše lidí", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Můj pane, měli bychom odsud nadobro odejít. Vzduch je nečistý, nasycený smrtí!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Mrtví povstávají z hrobů!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - lok. elfí země", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Nevypadá to, že by v této oblasti bylo něco cenného, pane. Hledejme dále na jihu.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - pomoc elfů", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Kentaur\n\"Dobří lidé, pomozte nám očistit Itlhu od těch zlých stvoření. Na oplátku vám pomůžeme ve vašem poslání!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001a", "ID_STRING": "NAME_TXT", "TEXT": "HK pomoc elfů", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Kentaur\n\"Dobří lidé, pomozte nám očistit Itlhu od těch zlých stvoření. Na oplátku vám pomůžeme ve vašem poslání!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Dobyti Ithly", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Kentaur\n\"Děkuji vám za pomoc. Rád vám oplatím laskavost, již jste prokázali elfímu lidu. Můžete si Itlhu přivlastnit, stejně jako zcela zbavit tyto země toho moru!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"V posledních několika měsících napadla Údolí měsíční písně mračna nemrtvých. Za oběť jim padlo mnoho lidí, jejichž příbuzní teď žijí v neustálém strachu.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Musíme objevit původ té invaze, než bude příliš pozdě!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Lok. pážecího útoku", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Rozzlobené páže\n\"Žádám tě, abys odsud okamžitě odešel. Zde odpočívají ti, kteří padli za oběť nemrtvým. Jestli neodejdeš, budu ti to muset vysvětlit násilím!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Lidé dobývají Canourii", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Můj pane, předpokládám, že část zlata vynaložíme i na obranu tohoto města. Měšťané hovoří o častých útocích nemrtvých.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Enthrasu", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Vesničané\n\"Naše obrana je zcela zničena neustálými útoky nemrtvých!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0020", "ID_STRING": "NAME_TXT", "TEXT": "HK dobytí Canourie", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Můj pane, předpokládám, že část zlata vynaložíme i na obranu tohoto města. Měšťané hovoří o častých útocích nemrtvých.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Neffinův kvelb", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Všechno, co mám, prodávám.", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0022", "ID_STRING": "NAME_TXT", "TEXT": "Dobyti Manrisu", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0022", "ID_STRING": "POPUP_TXT", "TEXT": "Porobení mágové\n\"Musíš ukončit tohle šílenství a zabít Bastela Roya! To on je příčinou tohoto moru. Znič ho a navrať do Měsíční písně opět mír.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Renmanův tábor", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Zaplatíš-li, přidáme se ke tvému vojsku.", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Objevení spektry v Canourii", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Metarsův tábor", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Vstupte, zbabělci, ať z vás mohu udělat hrdiny!", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Ilanova věž", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0003", "ID_STRING": "TXT_DESC", "TEXT": "U mne najdeš mnoho čarodějných kouzel.", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Objevení zombie z Kwelie", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Objevení nekromanta Dimmela", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Objevení setkání se zatraceným drakem", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0006", "ID_STRING": "TXT_TITLE", "TEXT": "Ralarův obchod", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0006", "ID_STRING": "TXT_DESC", "TEXT": "Moje zboží je nejlepší široko daleko.", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Objevení licha z Koularie", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Objevení elit. kostl. z Ithly", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Objevení manriského mrt. draka", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002b", "ID_STRING": "NAME_TXT", "TEXT": "Objevení šíleného vlkodlaka", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Objevení upíra", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002d", "ID_STRING": "NAME_TXT", "TEXT": "Elfové útočí HK", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Elfí rada\n\"Nedokázal jsi toto údolí zbavit hrozby Bastela Roya a nenavrátil jsi nám naše město. Jestli se k nám kmeny chtějí chovat takto, pak ať se připraví nést následky!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002e", "ID_STRING": "NAME_TXT", "TEXT": "HK intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002e", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"V posledních několika měsících napadla Údolí měsíční písně mračna nemrtvých. Za oběť jim padlo mnoho lidí, jejichž příbuzní teď žijí v neustálém strachu.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002e", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Musíme objevit původ té invaze, než bude příliš pozdě!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002f", "ID_STRING": "NAME_TXT", "TEXT": "HK dobytí Dimmelu", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Opatrně, pane, na Dimmel často útočí nemrtvé stvůry.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0030", "ID_STRING": "NAME_TXT", "TEXT": "HK lok. elfí země", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0030", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Nevypadá to, že by v této oblasti bylo něco cenného, pane. Hledejme dále na jihu.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0031", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí vítězí", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0032", "ID_STRING": "NAME_TXT", "TEXT": "Lok. Kendallu", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0032", "ID_STRING": "POPUP_TXT", "TEXT": "Mág Kendall\n\"Jsem potulný mág Kendall a přišel jsem ti říci, že na jihu sídlí mocní upíři. S nimi tam pobývá pouze smrt - musíš se tam vypravit a zničit je!\"", "SEQ_NUM": 0},
