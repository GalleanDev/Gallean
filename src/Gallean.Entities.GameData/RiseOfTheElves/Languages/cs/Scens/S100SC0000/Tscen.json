    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0000",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Trpasl\u00EDk\n\u0022Gymner Str\u00E1\u017Ece oblak je synem Moroka, nejjasn\u011Bj\u0161\u00EDho kr\u00E1le horsk\u00FDch kmen\u016F. Jestli mu ubl\u00ED\u017E\u00ED\u0161, Morok t\u011B rozdrt\u00ED!\u0022",
