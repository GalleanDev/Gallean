    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100SI0000",
      "ID_STRING": "TXT_TITLE",
      "TEXT": "Under\u016Fv kvelb",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100SI0000",
      "ID_STRING": "TXT_DESC",
      "TEXT": "Za ur\u010Ditou cenu m\u00E1m na prodej v\u0161echno.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100SI0001",
      "ID_STRING": "TXT_TITLE",
      "TEXT": "Malavienova v\u011B\u017E",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100SI0001",
      "ID_STRING": "TXT_DESC",
      "TEXT": "M\u00E1m tu jist\u00E1 mocn\u00E1 kouzla, kter\u00E1 by t\u011B mohla zaj\u00EDmat.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100PL0000",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Begrezen",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100PL0000",
      "ID_STRING": "DESC_TXT",
      "TEXT": "Ka\u017Ed\u00E9 d\u00EDt\u011B se t\u0159ese, zaslechne-li toto neblah\u00E9 jm\u00E9no - tento vl\u00E1dce pekel toti\u017E proslul nez\u0159\u00EDzenou krve\u017E\u00EDznivost\u00ED. Na jedn\u00E9 hostin\u011B, po\u0159\u00E1dan\u00E9 na po\u010Dest Bethrezena a jeho v\u00EDt\u011Bzstv\u00ED nad kr\u00E1lovstv\u00EDm sv\u011Btla, pr\u00FD poz\u0159el 1000 otrok\u016F.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100PL0001",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Athaulf",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100PL0001",
      "ID_STRING": "DESC_TXT",
      "TEXT": "Tento nejvy\u0161\u0161\u00ED z trpasli\u010D\u00EDch p\u00E1n\u016F si z\u00EDskal v\u011Bhlas d\u00EDky nesm\u00EDrn\u00E9 s\u00EDle v boji a odvaze tv\u00E1\u0159\u00ED v tv\u00E1\u0159 nesm\u00EDrn\u00E9 p\u0159esile. Jednou po cel\u00FDch sedm dn\u00ED a noc\u00ED bojoval s mocn\u00FDm rud\u00FDm drakem Arfuruzonem, ne\u017E nad n\u00EDm kone\u010Dn\u011B zv\u00EDt\u011Bzil.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100PL0004",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Neutr\u00E1ln\u00ED hr\u00E1\u010D",
