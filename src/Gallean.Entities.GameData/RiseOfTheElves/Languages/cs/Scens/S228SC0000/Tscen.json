    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228PL0009", "ID_STRING": "DESC_TXT", "TEXT": "In his youth, this mighty lord once stood fast against an army from hell and single-handedly defeated them by sealing the gateway that spew them. He then became sovereign of his realm.", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Orthamis", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Highest lord of the dwarf lords, he is known for his intensity in battle and his courage in the face of overwhelming odds. He once fought seven days and nights against the mighty red dragon ARFURUZON to finally defeat him.", "SEQ_NUM": 0},
