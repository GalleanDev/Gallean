    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228UN022e", "ID_STRING": "NAME_TXT", "TEXT": "Démonolog", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228UN0233", "ID_STRING": "NAME_TXT", "TEXT": "Zombie", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228UN0238", "ID_STRING": "NAME_TXT", "TEXT": "Velký skřet", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228UN023e", "ID_STRING": "NAME_TXT", "TEXT": "Zombie", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228UN0243", "ID_STRING": "NAME_TXT", "TEXT": "Zombie", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228UN0247", "ID_STRING": "NAME_TXT", "TEXT": "Nekromant", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228UN024b", "ID_STRING": "NAME_TXT", "TEXT": "Mořská panna", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228UN0255", "ID_STRING": "NAME_TXT", "TEXT": "Rainon", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228UN025a", "ID_STRING": "NAME_TXT", "TEXT": "Baldarik", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228UN0264", "ID_STRING": "NAME_TXT", "TEXT": "Goblin", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228UN0267", "ID_STRING": "NAME_TXT", "TEXT": "Kentauří kopiník", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Lidé - ovládnutí měst", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Rytíř Hubert \n\"Zmocnili jsme se všech tří prokletých měst. Kadrath nyní přišel o většinu moci a už nedokáže udržet svého strážce. Musíme ihned udeřit, můj pane!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Lidé - úvod - chaos", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Rytíř Hubert \n\"Již od dob velké války se říší rychle šíří chaos a rozklad. Našimi ztracenými zeměmi se potulují lupiči a zelení, kteří odmítají veškeré zákony.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0005", "ID_STRING": "NAME_TXT", "TEXT": "L - den 5, hádanka 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Kněží z Apthina chrámu věří, že Strážce věže své síly čerpá z magického trojúhelníku, který prý tvoří tři prokletá města - Bafomet, Babalon a Menchaos.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0006", "ID_STRING": "NAME_TXT", "TEXT": "L, den 7, hádanka 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Pouze ten, kdo se zmocní všech tří vrcholů onoho trojúhelníku, má moc vypudit démona, jenž sídlí uvnitř.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0007", "ID_STRING": "NAME_TXT", "TEXT": "L - lok. vstupu do věže", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Elf \n\"Jižně odsud najdeš vstup do Kadrathovy věže. Buď však opatrný - jeho strážce je prý nesmírně silný a téměř nesmrtelný!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Vytv. démonologa 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Démonolog \n\"S přispěním moci Anthaelovy tě sežehneme plameny!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Vytv. démonologa 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Démonolog \n\"Anthaelově vůli nedokážeš odolat!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Vytv. démonologa 3", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Démonolog \n\"Snažíš se nám odolávat, ale to tě pouze oslabuje. Stejně se staneš Anthaelovým služebníkem!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Vytvoř. démona 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Vytvoř. démona 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Vytvoř. démona 3", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Vytv. strašlivého wyrma", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Aktivace strašlivého wyrm", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Vypnutí strašlivého wyrma", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Vytvoření vlků", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Vytv. hvozdu s lupiči-HK", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Vytv. hvozdu s lupiči - L", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Aktivace vytvoření lupičů", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Vypnout vytvoření lupičů", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Lok Bafomet", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Strážce Bafometu \n\"Obětujte duše Anthaelovi, nebo zhyňte!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Lok. Babalon", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Stráž Babalonu \n\"Ty nesloužíš Anthaelovi! Proč chceš tedy zemřít?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Lok. Menchaos", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Stráž Menchaosu \n\"Ukážeme ti moc Anthaelovu!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0022", "ID_STRING": "NAME_TXT", "TEXT": "Vytv. menší hrozby - lidé", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Jolanova věž", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Mám tu spoustu mocných kouzel za rozumnou cenu.", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Vytv. menší hrozby - HK", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0024", "ID_STRING": "NAME_TXT", "TEXT": "HK - úvod - chaos", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0024", "ID_STRING": "POPUP_TXT", "TEXT": "Veterán Gordoth\n\"Od velké války se tu říší šíří pouze chaos a rozklad. Našimi ztracenými zeměmi nyní obcházejí zloději a zelení, kteří neuznávají žádné zákony.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0025", "ID_STRING": "NAME_TXT", "TEXT": "HK, den 5, hádanka 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Kněží z Apthina chrámu věří, že strážce věže svou moc čerpá z magického trojúhelníku, který prý tvoří tři prokletá města - Bafomet, Babalon and Menchaos\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0026", "ID_STRING": "NAME_TXT", "TEXT": "HK, den 7, hádanka 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0026", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Pouze ten, kdo ovládne všechny tři vrcholy trojúhelníku, může odsud vypudit démona, který sídlí uvnitř.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228SI0005", "ID_STRING": "TXT_TITLE", "TEXT": "Furrenův kvelb", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228SI0005", "ID_STRING": "TXT_DESC", "TEXT": "Mohu ti nějak pomoci, cizinče?", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228SI0006", "ID_STRING": "TXT_TITLE", "TEXT": "Oro's Camp", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228SI0006", "ID_STRING": "TXT_DESC", "TEXT": "My men are among the strongest of these lands.", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0028", "ID_STRING": "NAME_TXT", "TEXT": "L - vstup do zóny obch. 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce \n\"Můj pane, to zlo je příliš silné - pokud tu zůstaneme ještě chvíli, úplně nás to zabije!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228SI0007", "ID_STRING": "TXT_TITLE", "TEXT": "Sallatovo zboží", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228SI0007", "ID_STRING": "TXT_DESC", "TEXT": "Mé zboží ti na tvé pouti určitě pomůže!", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0029", "ID_STRING": "NAME_TXT", "TEXT": "L - vstup do zóny obch. 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0029", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce \n\"Můj pane! To zlo je zde příliš silné - pokud tu zůstaneme ještě chvilku, určitě nás to zabije!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228SI0008", "ID_STRING": "TXT_TITLE", "TEXT": "Yggarova věž", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228SI0008", "ID_STRING": "TXT_DESC", "TEXT": "Domnívám se, že moje magická knihovna ti může pomoci.", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV002a", "ID_STRING": "NAME_TXT", "TEXT": "L - vstup do zóny obch. 3", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV002a", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce \n\"Můj pane, to zlo je v těchto místech příliš silné! Jestli se tu zdržíme ještě o chvilku déle, zabije nás to!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228SI000a", "ID_STRING": "TXT_TITLE", "TEXT": "Hunderův krámek", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228SI000a", "ID_STRING": "TXT_DESC", "TEXT": "Jen si prohlédni moje zboží - třeba ti něco padne do oka!", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228SI000b", "ID_STRING": "TXT_TITLE", "TEXT": "Werrikův kvelb", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228SI000b", "ID_STRING": "TXT_DESC", "TEXT": "Mám tu úplně všechny lektvary, a za rozumnou cenu!", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV002d", "ID_STRING": "NAME_TXT", "TEXT": "HK - ovládnutí měst", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Veterán Gordoth\n\"Zmocnili jsme se všech tří prokletých měst. Kadrath přišel o většinu své moci a už tu nedokáže udržet svého strážce. Musíme okamžitě udeřit, můj pane!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0031", "ID_STRING": "NAME_TXT", "TEXT": "HK - lok.obelisk Legií", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0031", "ID_STRING": "POPUP_TXT", "TEXT": "Zvěd\n\"Pane, cítím, že z východu vyzařuje něco zlého, ale nevidím nic. Měli bychom postupovat jen s nejvyšší opatrností!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0032", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Bafometu", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0032", "ID_STRING": "POPUP_TXT", "TEXT": "Vesničan\n\"Děkuji, že jsi nás osvobodil od Kagathovy zlé moci. Doufejme, že s pomocí našich modliteb přemůžeš i jeho!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0033", "ID_STRING": "NAME_TXT", "TEXT": "L - příběh lok. hoř.města", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0033", "ID_STRING": "POPUP_TXT", "TEXT": "Vesničan\n\"Kadrath naše město zničil, neboť jsme se nechtěli vzdát. Život daroval pouze těm, kteří se mu podrobili. Pomsti nás prosím, můj pane!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0035", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Babalonu", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0035", "ID_STRING": "POPUP_TXT", "TEXT": "Měšťan\n\"Konečně naše utrpení skončilo! Navždy ti budeme zavázáni, můj pane!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0036", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Menchaosu", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0036", "ID_STRING": "POPUP_TXT", "TEXT": "Měšťan\n\"Byli jsme tak zoufalí, můj pane! Neměli jsme jinou možnost než se podrobit Kadrathově moci. Ale díky tobě jsme své životy získali zpět!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0037", "ID_STRING": "NAME_TXT", "TEXT": "Den 9 magické kruhy", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0037", "ID_STRING": "POPUP_TXT", "TEXT": "Elfí posel \n\"Můj pane, zjistili jsme, že Kadrath k vyvolávání svých příšer používá magické kruhy, které obklopuje silné zlo, jež pro nás může být smrtící. Jeden z našich zvědů do jednoho takového kruhu vkročil a jen stěží se mu podařilo uniknout.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0039", "ID_STRING": "NAME_TXT", "TEXT": "L- příběh Menchaosu 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0039", "ID_STRING": "POPUP_TXT", "TEXT": "Zvěd\n\"Severovýchodně leží město Baldara, jež Kadrath po velké válce přejmenoval podle svého druhého démonického dítka na Menchaos.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV003a", "ID_STRING": "NAME_TXT", "TEXT": "L - příběh Menchaosu 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV003a", "ID_STRING": "POPUP_TXT", "TEXT": "Zvěd\n\"Jižně odsud leží město Baldara, které Kadrath po válce přejměnoval podle svého druhého démonického dítka na Menchaos.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV003b", "ID_STRING": "NAME_TXT", "TEXT": "HK - příběh Menchaosu 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV003b", "ID_STRING": "POPUP_TXT", "TEXT": "Zvěd\n\"Severovýchodně odsud leží město Baldara, které Kadrath po velké válce přejmenoval podle svého druhého démonického dítka na Menchaos.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV003c", "ID_STRING": "NAME_TXT", "TEXT": "HK - příběh Menchaosu 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV003c", "ID_STRING": "POPUP_TXT", "TEXT": "Zvěd\n\"Jižně odsud leží město Baldara, které Kadrath po velké válce přejmenoval podle svého druhého démonického dítka na Menchaos.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV003d", "ID_STRING": "NAME_TXT", "TEXT": "HK - zóna obcházení 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV003d", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce \n\"Můj pane, zlé síly jsou tu příliš mocné! Setrváme-li tu ještě chvíli, zabije nás to!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV003e", "ID_STRING": "NAME_TXT", "TEXT": "HK - zóna obcházení 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV003e", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce \n\"Můj pane, zlé síly jsou tu příliš mocné! Setrváme-li tu ještě chvíli, zabije nás to!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV003f", "ID_STRING": "NAME_TXT", "TEXT": "HK - zóna obcházení 3", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV003f", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce \n\"Můj pane, zlé síly jsou tu příliš mocné! Setrváme-li tu ještě chvíli, zabije nás to!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0041", "ID_STRING": "NAME_TXT", "TEXT": "L - příběh lok. Babalon", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0041", "ID_STRING": "POPUP_TXT", "TEXT": "Zvěd\n\"Jižně odsud leží město Maldrik. Kdysi to bývalo jedno z největších sídel v říši, ale po válce je Kadrath přejmenoval podle svého třetího démonického dítka na Babalon.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0043", "ID_STRING": "NAME_TXT", "TEXT": "HK - příběh Babalonu", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0043", "ID_STRING": "POPUP_TXT", "TEXT": "Zvěd\n\"Jižně odsud leží město Maldrik, jež kdysi bývalo jedním z nejbohatších sídel říše. Po válce je však Kadrath přejmenoval po svém třetím démonickém dítku na Babalon.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0044", "ID_STRING": "NAME_TXT", "TEXT": "HK - lok. vstup do věže", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0044", "ID_STRING": "POPUP_TXT", "TEXT": "Elf\n\"Jižně odsud se nachází vstup do Kadrathovy věže. Buď opatrný - její strážce je prý velmi mocný a téměř nesmrtelný!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0045", "ID_STRING": "NAME_TXT", "TEXT": "HK - příběh hoř. města", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0045", "ID_STRING": "POPUP_TXT", "TEXT": "Vesničan\n\"Kadrath zničil naše město, neboť jsme se nehodlali vzdát. Život daroval pouze těm, kteří se mu podrobili. Pomsti nás prosím, můj pane!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0046", "ID_STRING": "NAME_TXT", "TEXT": "L - příběh lok. Bafomet", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0046", "ID_STRING": "POPUP_TXT", "TEXT": "Zvěd\n\"Severně odsud se nachází město Andragard. Za války sem Kadrath vyslal  první démonické dítě jménem Bafomet, aby zničilo nevěřící. Když město ovládl, dal mu jméno právě po tomto svém zvrhlém potomkovi.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0047", "ID_STRING": "NAME_TXT", "TEXT": "HK - příběh Bafometu", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0047", "ID_STRING": "POPUP_TXT", "TEXT": "Zvěd\n\"Severně odsud leží město Andragard. Za války sem Kadrath vyslal první démonické dítko Bafometa, aby si podrobilo všechny nevěřící. Poté, co se zmocnil města, přejmenoval je právě po tomto svém zvrhlém potomkovi.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0048", "ID_STRING": "NAME_TXT", "TEXT": "L - dob. Kadrathovy pevn.", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0049", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Bafometu", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV004a", "ID_STRING": "NAME_TXT", "TEXT": "HK dob. Kadrathovy pevn.", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV004b", "ID_STRING": "NAME_TXT", "TEXT": "L - lok. obelisku", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV004b", "ID_STRING": "POPUP_TXT", "TEXT": "Zvěd \n\"Pane, cítím, že z východu přichází nějaké zlo, i když je nevidím. Musíme postupovat jen s největší opatrností!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV004c", "ID_STRING": "NAME_TXT", "TEXT": "L - vytvořní mrt. draka", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV004d", "ID_STRING": "NAME_TXT", "TEXT": "HK-stvoření mrtvého draka", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV004f", "ID_STRING": "NAME_TXT", "TEXT": "L - Strážcovo varování", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV004f", "ID_STRING": "POPUP_TXT", "TEXT": "Zvěd \n\"Před námi stojí strážce věže, jehož nelze přemoci, můj pane. Zranitelný bude až poté, co se zmocníme tří prokletých měst. Pak už Kadrath nebude mít dost sil, aby démona udržel v naší dimenzi.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0050", "ID_STRING": "NAME_TXT", "TEXT": "HK - varování před Stráž.", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0050", "ID_STRING": "POPUP_TXT", "TEXT": "Zvěd \n\"Před námi stojí strážce věže, jehož nelze zabít, můj pane. Jediný způsob, jak ho přemoci, je ovládnout tři prokletá města. Až tak učiníme, Kadrath už nebude mít dost sil, aby démona ještě udržel v naší dimenzi.\"", "SEQ_NUM": 0},
