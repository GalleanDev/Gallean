    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225LO0010", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - vstup do údolí", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Yugginova věž", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Má kouzla ti mohou v tvém poslání pomoci.", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Tralarův krámek", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Všechno, co mám, prodávám.", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Righonův tábor", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Moji vojáci jsou ti nejlepší v kraji.", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0004", "ID_STRING": "TXT_TITLE", "TEXT": "Gruntworfovo zboží", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0004", "ID_STRING": "TXT_DESC", "TEXT": "Moje zboží je tu pro každého, kdo mi zaplatí.", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutrální", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Žádný popis", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Calderik", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Tento nejvyšší z trpasličích pánů si získal věhlas díky nesmírné síle v boji a odvaze tváří v tvář nesmírné přesile. Jednou po celých sedm dní a nocí bojoval s mocným rudým drakem Arfuruzonem, než nad ním konečně zvítězil.", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Gunther", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Tento mocný pán se zamlada samojediný postavil armádě pekelné a jednou rukou ji zničil, neboť zapečetil bránu, jež vojska na tento svět přiváděla. Poté se stal nezávislým vládcem říše.", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Jagare", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN0017", "ID_STRING": "NAME_TXT", "TEXT": "Thalrisa", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN001a", "ID_STRING": "NAME_TXT", "TEXT": "Skřet", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN0021", "ID_STRING": "NAME_TXT", "TEXT": "Skřet", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0001", "ID_STRING": "NAME_TXT", "TEXT": "HK zabití Thalrisy", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Vypadá to, že ten duch jménem Thalrisa hlídal vchod do skrytého údolí. Netroufám si představit, jaké další hrůzy tam dřímají...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN0024", "ID_STRING": "NAME_TXT", "TEXT": "Zlobr", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Lok. varování před skřety", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Velký skřet\n\"Tuto zlou půdu nesmí nikdo vlastnit - magie je špatná!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0003", "ID_STRING": "NAME_TXT", "TEXT": "HK dobytí Runie", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Konečně jsme dobyli Runii. Pro zelené představovala důležitou základnu. Musíme být však opatrní - mohou se pomstít.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN0026", "ID_STRING": "NAME_TXT", "TEXT": "Skřet", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0006", "ID_STRING": "NAME_TXT", "TEXT": "HK Thalrisin příběh", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Thalrisa\n\"Dlouho jsem čekala, než jsem se postavila nepřátelům. Konečně se pomstím na těch, kteří mne pronásledovali a zbavím se i vás, protože vy jste se pokoušeli zbavit mě. Dokonce i když se moji živelní strážci rozpadnou v prach, bude pomsta má!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN002a", "ID_STRING": "NAME_TXT", "TEXT": "Zlobr", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0008", "ID_STRING": "NAME_TXT", "TEXT": "HK intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Nejjasnější král nás pověřil, abychom obsadili toto údolí a získali tak manu, jež se v něm nachází.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Zelení, kteří mají z magie strach, bohužel odhalili naše plány a jsou rozhodnuti nás z údolí vystrnadit. Říše lidí se oproti tomu snaží toto údolí získat pro sebe.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Usadili se v ústí našeho údolí a pokusili se nás přinutit ke kapitulaci. Abychom mohli obležení prolomit, musíme do jihovýchodního vstupu do údolí vyslat posla, aby získal pomoc sousedních kmenů.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Lok. skřetí pasti", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN002d", "ID_STRING": "NAME_TXT", "TEXT": "Skřet", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000b", "ID_STRING": "NAME_TXT", "TEXT": "HK setkání se skřety", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Velký skřet\n\"Grrrr! Tady dlouho nepřežijete, trpaslíci! Udělali jste chybu, když jste sem přišli, varovali jsme vás! Živí odsud neodejdete!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000c", "ID_STRING": "NAME_TXT", "TEXT": "HK vstup do Runie", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Skřetí stráž\n\"Vtrhl jsi do údolí a teď si myslíš, že budeš plenit i naše vesnice? Vy trpaslíci jste ještě hloupější, než jsme si mysleli!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Objevení1", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Zapnout objevení 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Objevení2", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Lok. Tahlrisiny magie", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Skřet\n\"Toužíš po Thalrisině magii, ale my nikdy nedovolíme, abys ji získal! Zeleným nikdy neublížíš!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0011", "ID_STRING": "NAME_TXT", "TEXT": "HK vyloupení opuštěné farmy", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Tato budova je velice stará, můj pane. Je jasné, že zelení v údolí pobývali velmi dlouho. Ale proč? Že by nějaká magie?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Vstup do Údolí hrůz", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "\"Thalrisini služebníci stále žijí! Musí teď toužit po pomstě!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0013", "ID_STRING": "NAME_TXT", "TEXT": "HK vyloupení Thalrisina chrámu", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Prolomili jsme Thalrisino prokletí. Vrátila se zpět do pekel, kde byla stvořena. Nyní můžeme nerušeně sklízet manu.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Císařští vyzvědači se před nedávnem vrátili s tím, že se v tomto údolí pohybují horské kmeny. Když už jsme zjistili, proč sem kmeny zavítaly, došli jsme k závěru, že by se do toho měla vložit i Říše lidí.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Zdejší magické zdroje jsou velmi cenné. Není pochyb, že si kmeny pošlou pro pomoc. To je důvodem, proč jsme se utábořili v ústí údolí. Nyní jsou zcela odříznuti a je pouze otázkou času, kdy budou muset kapitulovat.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Útok na jejich hlavní město povede zkušený válečník sir Glorcliff. Nesmíme už dále ztrácet čas.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - vstup do Runie", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Skřet\n\"Už jste vtrhli do našeho údolí a teď si myslíte, že budete plenit i naše vesnice? Vy lidé jste ještě pošetilejší, než jsme si mysleli!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0016", "ID_STRING": "NAME_TXT", "TEXT": "HK vítězí1", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0017", "ID_STRING": "NAME_TXT", "TEXT": "HK vítězí3", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN003a", "ID_STRING": "NAME_TXT", "TEXT": "Skřetí vyzvědač", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0018", "ID_STRING": "NAME_TXT", "TEXT": "HK vítězí2", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí vítězí", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - vstup do údolí", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Zlobr\n\"Myslíte si, lidičkové, že můžete mít tohle údolí? To údolí patří zeleným! Jděte pryč!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN003e", "ID_STRING": "NAME_TXT", "TEXT": "Skřet", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Lidé dobývají Gnarthwood", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Toto město představuje důležitý krok k ovládnutí údolí. Jestliže se ho zmocní horské kmeny, způsobí nám to v našem poslání velké problémy.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Zelení byli dobře vybaveni - v jejich truhlicích jsme objevili Knihu války!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Lidé dobývají Runii", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Konečně jsme dobyli Runii. Pro zelené představovala důležitou základnu. Musíme být však opatrní - mohou se pomstít.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - zabití Thalrisy", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Vypadá to, že ten duch jménem Thalrisa hlídal vchod do skrytého údolí. Netroufám si představit, jaké další hrůzy tam dřímají...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN0040", "ID_STRING": "NAME_TXT", "TEXT": "Skřet", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - vyloupení opuštěné farmy", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Tato budova je velice stará, můj pane. Je jasné, že zelení v údolí pobývali velmi dlouho. Ale proč? Že by nějaká magie?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - vyloupení", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Prolomili jsme Thalrisino prokletí. Vrátila se zpět do pekel, kde byla stvořena. Nyní můžeme nerušeně sklízet manu.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0020", "ID_STRING": "NAME_TXT", "TEXT": "HK objevení2 - zpráva", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Zvěd\n\"Doneslo se k nám, že ke skřetům se blíží posily! Mohou mířit k našemu hlavnímu městu!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN0043", "ID_STRING": "NAME_TXT", "TEXT": "Velký skřet", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - 2. zpráva", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Zvěd\n\"Doneslo se k nám, že ke skřetům se blíží posily! Mohou mířit k našemu hlavnímu městu!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0022", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - Thalrisin příběh", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0022", "ID_STRING": "POPUP_TXT", "TEXT": "Thalrisa\n\"Dlouho jsem čekala, než jsem se postavila nepřátelům. Konečně se pomstím na těch, kteří mne pronásledovali a zbavím se i vás, protože vy jste se pokoušeli zbavit mě. Dokonce i když se moji živelní strážci rozpadnou v prach, bude pomsta má!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Zapnout objevení 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0024", "ID_STRING": "NAME_TXT", "TEXT": "HK objevení1 - zpráva", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0024", "ID_STRING": "POPUP_TXT", "TEXT": "Zvěd\n\"K městům míří trolové, jež vyslali velitelé zelených, můj pane. Měli bychom posílit naši obranu!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - 1. zpráva", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Zvěd\n\"K městům míří trolové, jež vyslali velitelé zelených, můj pane. Měli bychom posílit naši obranu!\"", "SEQ_NUM": 0},
