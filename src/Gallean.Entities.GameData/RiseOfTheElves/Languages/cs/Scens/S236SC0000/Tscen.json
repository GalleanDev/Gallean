    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SR000d", "ID_STRING": "NAME_TXT", "TEXT": "Svobodní démoni", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SR000e", "ID_STRING": "NAME_TXT", "TEXT": "Pavouci", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Ardobert", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Alderik", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236UN0005", "ID_STRING": "NAME_TXT", "TEXT": "Begrezen", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236UN0007", "ID_STRING": "NAME_TXT", "TEXT": "Huun'reh", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236UN000f", "ID_STRING": "NAME_TXT", "TEXT": "Elfí pán", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutrální", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Žádný popis", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Goar", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Tento mocný pán se zamlada samojediný postavil armádě pekelné a jednou rukou ji zničil, neboť zapečetil bránu, jež vojska na tento svět přiváděla. Poté se stal nezávislým vládcem říše.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Theodemis", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Tento nejvyšší z trpasličích pánů si získal věhlas díky nesmírné síle v boji a odvaze tváří v tvář nesmírné přesile. Jednou po celých sedm dní a nocí bojoval s mocným rudým drakem Arfuruzonem, než nad ním konečně zvítězil.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236UN0021", "ID_STRING": "NAME_TXT", "TEXT": "Lesní elf", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236PL000b", "ID_STRING": "NAME_TXT", "TEXT": "Sagoth", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236PL000b", "ID_STRING": "DESC_TXT", "TEXT": "Každé dítě se třese, zaslechne-li toto neblahé jméno - tento vládce pekel totiž proslul nezřízenou krvežíznivostí. Na jedné hostině, pořádané na počest Bethrezena a jeho vítězství nad královstvím světla, prý pozřel 1000 otroků.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236PL000c", "ID_STRING": "NAME_TXT", "TEXT": "Nehru", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236PL000c", "ID_STRING": "DESC_TXT", "TEXT": "Tento pán svého času proslul jako nejmocnější z adeptů černého umění. Jeho hrůzovládě sice učinil přítrž inkvizitor Vorgel, který ho zabil, avšak nyní zloduch opět povstal coby nemrtvý, sžírán neutuchající touhou podrobit každého smrtelníka své vůli.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236UN0023", "ID_STRING": "NAME_TXT", "TEXT": "Lesní elf", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236UN0027", "ID_STRING": "NAME_TXT", "TEXT": "Lesní elf", "SEQ_NUM": 0},
