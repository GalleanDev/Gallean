    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236UN01df", "ID_STRING": "NAME_TXT", "TEXT": "Mistrovský lupič", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236UN01e4", "ID_STRING": "NAME_TXT", "TEXT": "Vlk", "SEQ_NUM": 0},
