    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236UN01f5", "ID_STRING": "NAME_TXT", "TEXT": "Vlk", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - uzdravující socha", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí vítězí", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Legie - intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Novinky ze Středozemí, pane. Táhnou sem odpadlé Legie nespoutaných démonů. Nemrtvým se je úspěšně podařilo ze Středozemí vytlačit a nyní hledají útočiště na našem území.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Určitě si neuvědomili, že v těchto zemích přebýváme MY. Té drzosti budou velice litovat!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Naši zvědové také zjistili, že Wotanův svitek se nachází na severu. Musíme teď vyslat průzkumníka, aby jej od elfů získal, a další vyzvědače musíme pověřit pátráním po poškozené runě.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví - intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\nPane, zdárně se nám podařilo vyhnat z našeho území svobodné démony. Prchali směrem k západu, do držav Legií. Avšak lidé se stále ještě nevzdali svých chabých útoků.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Také bychom měli mít na paměti,  že draci mají v držení poškozenou runu. Musíme nalézt způsob, jak ji získat zpět a zjistit, kde se nalézá Wotanův svitek. Pak budeme konečně vládnout celé zemi.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Aragonie", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Aragonie", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Elfové\n\"Buďte si jisti, že elfové nikdy nedopustí, aby jejich zem byla takto zpustošena!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Lok. poustevníka", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Poustevník\n\"Odstup! Nikdy ti to nevydám! Varuji tě, už se víc nepřibližuj!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0008", "ID_STRING": "NAME_TXT", "TEXT": "HK vzpoura trpaslíků", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Můj pane, vypadá to, že horníci odmítají pracovat! Prohlašují, že už nám nebudou dále sloužit. Takové bezbožníky musíme přísně potrestat, neboť disciplína je to jediné, čemu rozumí!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0009", "ID_STRING": "NAME_TXT", "TEXT": "HK uzdravující socha", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Lok. východního draka", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Draci\n\"Odejdi, dokud jsi ještě naživu, neboť toto je panství Doragona. Všichni vetřelci budou sežráni zaživa!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Lok. západního draka", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Draci\n\"Držte se dál, vetřelci, dokud ještě žijete. Zde vládnou draci a nikoho jiného tu nestrpíme!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí zlodějské síně", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Zloději\n\"Můžeš si myslet, že jsi nás zastavil, ale my dosáhneme všude - i tam, kde bys to nejméně čekal!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Dobyti Burntu", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Mistrovský lupič\n\"Nemysli si, že se vidíme naposledy. Naši zloději s tebou budou bojovat až do krvavého konce!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Získat runu", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Konečně jsme získali poškozenou runu. Nyní musíme nalézt ještě ten legendární svitek!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Získat svitek", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Svitek je náš! Nyní musíme ještě najít runu!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - lok. skřeti", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Vypadá to, že se před námi utábořila banda skřetů, pane. Měli bychom být opatrní, mají sklony chovat se velmi popudlivě.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - vyloupení", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Zloději tu nechali mapu, můj pane. Vypadá to, že na jihu najdeme ještě další zlodějská sídla.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Timorie", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Obránci víry\n\"Nevěřící, až draci uvolní runu, nebudete ušetřeni!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Lok. kultistů", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Naše města vypalují šílení kultisté. Musíme se s nimi ihned vypořádat.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Vyloupit zřícenou věznici", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"V této věži bývali vězněni kacíři a šílenci. Na stěně jsou patrné podivné runové nápisy, psané krví.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Dobyti Khu'brahu", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Primitivní obři\n\"Arghhh!!! Proč vy sem zajít??? My chtít vás zažrat!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Lok. elf", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Na tomto území se často objevují elfové a není pochyb, že sledují každý náš krok.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Lok. obránců víry", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Obránci víry\n\"Stůjte, nevěřící! Vzdejte se nám a my vám ukážeme skutečnou cestu!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Lok. primitivního obra", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Primitivní obři\n\"Arghhh!!! Pojďte blíž, bude z vás prima zákusek!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Lok. nevěřících", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Bezvěrec\n\"Cestoval jsem daleko a pokoušel se znovu získat víru, ale nenašel jsem nic. Nyní hledám pouze jídlo a přístřeší. Dovol, abych ti sloužil, a nebudeš litovat.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Přilehlé oblasti obývá mnoho lidí, kteří nevěří v Nejvyššího otce. Spolupracují s místními lupiči při mnohých nájezdech na naše území.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Na mučidlech nám jeden zajatý člověk prozradil, že runu, kterou hledáme, lze ve skutečnosti najít spolu s elfy daleko na severovýchodě. Měli bychom okamžitě vypravit družinu, která ji získá.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001d", "ID_STRING": "NAME_TXT", "TEXT": "HK intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Můj pane, poustevníci z okolí plánují spolu s obry ze severu útok na naše državy. Měli bychom se s nimi co nejdříve vypořádat!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Někteří naši kupci se doslechli, že runu, kterou hledáme, uchvátili mocní draci. Obávám se, že si ji budeme muset vzít násilím.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví vítězí", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001f", "ID_STRING": "NAME_TXT", "TEXT": "HK vítězí", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Legie vítězí", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Dracovo cvičiště", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0000", "ID_STRING": "TXT_DESC", "TEXT": "U mne se cvičili všichni slavní dračí válečníci!", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Chrulenův obchod", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Mám za to, že můžeme uzavřít obchod.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Leifův magický krámek", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Jestliže potřebuješ ochrannou magii, pak jsi přišel na správné místo.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Thurinovo zboží", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Moje zboží je nejlepší široko daleko.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0004", "ID_STRING": "TXT_TITLE", "TEXT": "Dennarův tábor", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0004", "ID_STRING": "TXT_DESC", "TEXT": "Zaplatíš-li, přidáme se ke tvému vojsku.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0005", "ID_STRING": "TXT_TITLE", "TEXT": "Thurinovo zboží", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0005", "ID_STRING": "TXT_DESC", "TEXT": "Co pro tebe mohu udělat, cizinče?", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0006", "ID_STRING": "TXT_TITLE", "TEXT": "Leina svatyně", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0006", "ID_STRING": "TXT_DESC", "TEXT": "Specializuji se na vyvolávací kouzla.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0007", "ID_STRING": "TXT_TITLE", "TEXT": "Furrenův obchod", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0007", "ID_STRING": "TXT_DESC", "TEXT": "Jen si prohlédni moje zboží, možná ti něco padne do oka.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0008", "ID_STRING": "TXT_TITLE", "TEXT": "Laetova hospoda", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0008", "ID_STRING": "TXT_DESC", "TEXT": "Pivo a ostatní nezbytnosti za rozumnou cenu.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236LO0000", "ID_STRING": "NAME_TXT", "TEXT": "Uzdravující socha", "SEQ_NUM": 0},
