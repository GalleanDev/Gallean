{
  "formatVersion": 1,
  "rows": [
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Zaorish", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213UN0004", "ID_STRING": "NAME_TXT", "TEXT": "Kraken", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213UN0007", "ID_STRING": "NAME_TXT", "TEXT": "Mořská panna", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213UN001f", "ID_STRING": "NAME_TXT", "TEXT": "Páže", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213UN0025", "ID_STRING": "NAME_TXT", "TEXT": "Čaroděj", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Útok blesky", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Anděl milosrdenství\n\"Odejdi! Nikdo nesmí vstoupit do Hořkého štěstí a rušit nás, když se snažíme, aby Zručín došel pokoje. Vzdej hold Nešťastné hvězdě!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Léčivá půda", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Požehnání Nejvyššího otce", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Zpráva z Vinusi", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Rytíř z Vinusi\n\"Tak dobrá - radši ty než démoni. Socha Nejvyššího otce, která stojí poblíž, je ve skutečnosti nebeským znamením. Přiblížíš-li se k ní, nebesa tě uzdraví. Andělé milosrdenství jsou silní! Nechť je ti tato informace ku prospěchu!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Zpráva z Kamenného Hrádku", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Statečný rytíř \n\"Severně odsud leží pohřebiště, kam nemrtví mohou bez obav vstoupit. Ve skutečnosti je to však nebeské znamení - pokud na ně vstoupíš, nebesa tě uzdraví.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Závěrečná zpráva", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Askael \n\"Když andělé milosrdenství padli naší ohnivou mocí, lid Zručína bude zotročen a vše, co je jim drahé, lehne popelem!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Vítěz. podm. pro Legie", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Ashkael \n\"Ve Zručíně nastala Ďábelská noc! V této kdysi bohaté a mírumilovné zemi nyní vládne chaos a oheň. Obyvatelstvo Zručína bude sloužit Legiím zatracenců jako otroci a vojáci!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Viragovy ostrovy", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Arciďábel \n\"Viragův ostrov silně střeží skřeti, kteří prý mají spoustu zlata. Nemělo by být příliš těžké ho od těch zabedněných příšer dostat!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Legie, den první", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Arciďábel \n\"Zručín obsadili andělé milosrdenství, kteří doufají, že celý konflikt urovnají. Sídlí ve věži Hořkého štěstí, kde se snaží čelit nadcházejícímu rituálu.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0012", "ID_STRING": "NAME_TXT", "TEXT": "HK, den první", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Zručín přestal obchodovat se všemi sousedními kraji. Mnoho našich měst je na něm obchodně závislých - taková hospodářská nestabilita nás může zcela zničit!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213UN0036", "ID_STRING": "NAME_TXT", "TEXT": "Páže", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Zpráva od čaroděje", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Sympatizující čaroděj\n\"Proč bojuješ proti něčemu, co je dobré? Ďábelská noc se blíží a všichni se musíme spojit, abychom ty kacíře jednou provždy zničili. Když ses nám postavil, vlastně ses k přidal k těm zloduchům! Proto tě nyní zničím!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Zpráva od pážete", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Páže \n\"Stůj! Tuto oblast očistili andělé a ty sem nesmíš ani vkročit!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Vinusi II", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Rytíř z Vinusi\n\"Prosím, už víc nebodej - prozradím všechno, co vím. Jaká socha? Ach! Ano! Ano... ta socha vyléčí každého - i takové kacíře, jako jsi ty... prosím, nechej mne zemřít!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213UN003a", "ID_STRING": "NAME_TXT", "TEXT": "Páže", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Spektra", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Spektra \n\"Vkročil jsi do naší země a teď v ní budeš pohřben!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Strážce věže", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Věrný kopiník\n\"Ještě krok a já tě tak zmaluju, že na to do smrti nezapomeneš! Tedy za předpokladu, že ještě dokážeš utéci.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Věž II", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Anděl milosrdenství \n\"Ďábelská noc nesmí nastat. Řád opět zvítězí nad chaosem. Tak tomu vždy bylo.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213UN003e", "ID_STRING": "NAME_TXT", "TEXT": "Páže", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Kamenní vojáci", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Andělský herold", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Anděl milosrdenství\n\"Ve jménu řádu tě vypudíme z tohoto města!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV001e", "ID_STRING": "NAME_TXT", "TEXT": "HK Vítězná událost", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Vithar\n\"Zručín byl osvobozen od andělů milosrdenství - nyní s jeho obyvateli můžeme opět obchodovat jako dřív. Dnes budeme hodovat a slavit svůj triumf! Hej, děvče, přines mi nějakou kořalku!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213UN0042", "ID_STRING": "NAME_TXT", "TEXT": "Kopiník", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Kladivo zraňuje Em", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Čaroděj \n\"Mjolnirovo kladivo je prokleté. Pokud je třímá někdo nehodný, zjeví se andělé a ztrestají ho. Já tuto zbraň však uchráním přede všemi, kdož by se jí mohli zmocnit.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Text města Primera", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Primerský vzbouřenec\n\"Ti takzvaní andělé milosrdenství uvrhli na lid, který tvrdí, že ochraňují, bídu a hlad! Prohlašují, že Zručín je rozpolcen kvůli našim potřebám bojovat, ale ve skutečnosti jsou to oni, kdo nám ubližují!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Text Primery - Legie", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0023", "ID_STRING": "POPUP_TXT", "TEXT": "Primerský vzbouřenec\n\"Pochválena buď Ďábelská noc! Jen ať ten obřad začne a zničí Hořké štěstí! Ti, kteří nám slibovali ochranu, v nás ve skutečnosti úplně udusili veškeré lidství. Pomůžeme ti zničit ty anděly milosrdenství!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Obrana Primery", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Anděl milosrdenství \n\"Pro mír a bezpečnost Zručína musí být všichni útočníci zničeni. Pro slávu Nešťastné hvězdy!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Zpráva od kopiníka", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0026", "ID_STRING": "POPUP_TXT", "TEXT": "Posel\n\"Odejdi! Nejsi tu vítán!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Nová událost", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Urozený rytíř z Pomezního Hradce\n\"I když jsme tuto bitvu prohráli, válka jde dál! Dokud nad námi budou bdít zraky andělů, budeme vítězit!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Pomezní Hradec - Legie", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "Urozený rytíř z Pomezního Hradce\n\"Aáááchhhhhhh... tvůj čas se blíží... celý tvůj neblahý rod je odsouzen k zániku! Jen si mne zabij, ale nezapomeň mých slov, bezbožníku... čeká na tebe mocná svatost a ukončí tvou hrůzovládu!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "Kultista \n\"Ha, ha, ha, ha! Zmlkni, darebáku! Tu mocnou svatost, o které mluvíš, potká stejný osud jako tebe - pomalá a bolestivá smrt! A teď zemři a věz, že jsi ničeho nedosáhl!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Text Viragova vítězství", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0029", "ID_STRING": "POPUP_TXT", "TEXT": "Vrhač sekyr\n\"Jen ať je vidět, že horské kmeny umí bojovat! Zvítězíme, neboť jsme stejně stateční, jako silní!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Virago - Legie", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV002a", "ID_STRING": "POPUP_TXT", "TEXT": "Vévoda\n\"Další pěšec byl odstraněn ze hry. Ďábelská noc se blíží a celý svět se nám bude klanět!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Vinusi - uzdravení kmenů", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV002c", "ID_STRING": "POPUP_TXT", "TEXT": "Začátečnice\n\"Můj pane, dozvěděla jsem se, že město Vinusi má neobvyklou historii. V dávných dobách zde přebývali záhadní tvorové, známí jako nebešťané, kteří své mrtvé pohřbívali všude v okolí.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV002c", "ID_STRING": "POPUP_TXT", "TEXT": "Začátečnice\n\"Věřím, že země kolem Vinusi je očarována. Až najdeme to pravé místo, můžeme léčivé síly nebešťanů využít.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV002d", "ID_STRING": "NAME_TXT", "TEXT": "Vinusi - Legie", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Kultista \n\"Můj pane, musím ti prozradit něco o této oblasti. Kdysi tu přebývala skupina lidí zvaných nebešťané.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Vévoda\n\"Ticho, hňupe, tvé povídačky mne vůbec nezajímají! Já jsem pro mnohé ztělesněním strachu a své nepřátele bryskně posílám do věčného zapomnění! Neměl bys proto vzbuzovat můj hněv!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Kultista \n\"Prosím tisíckrát za prominutí, můj pane! Jen jsem ti chtěl říci, že ve městě Vinusi kdysi přebývali nebešťané, a proto prý je zdejší půda očarována. Každý, kdo na ni vstoupí, bude uzdraven!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Vévoda\n\"Výborně, maličký, máš u mě bezvýznamné plus. Má slova však neber na lehkou váhu. Pokud se mi ty nebo kdokoliv jiný znelíbí, bude zatracen. Ďábelská noc se blíží a celý svět před naší mocí padne na kolena!\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV002e", "ID_STRING": "NAME_TXT", "TEXT": "Kamenný Hrádek ML", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV002e", "ID_STRING": "POPUP_TXT", "TEXT": "Urozený rytíř z Kamenného Hrádku\n\"Severně odsud je pohřebiště nebešťanů, na něž stále dohlíží jeho strážce.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV002f", "ID_STRING": "NAME_TXT", "TEXT": "Odejdi odsud", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "Páže \n\"Mám ti vyřídit, že tu nejsi vítán. Zručín už s horskými kmeny nemíní nadále obchodovat. Odejdi - varovali jsme tě!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213UN0053", "ID_STRING": "NAME_TXT", "TEXT": "Kopiník", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0030", "ID_STRING": "NAME_TXT", "TEXT": "Páže zrušeno", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213UN0059", "ID_STRING": "NAME_TXT", "TEXT": "Mistrovský lupič", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213UN005c", "ID_STRING": "NAME_TXT", "TEXT": "Strážce věže", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213UN0060", "ID_STRING": "NAME_TXT", "TEXT": "Čaroděj", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213UN006a", "ID_STRING": "NAME_TXT", "TEXT": "Skřet", "SEQ_NUM": 0},
