    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Tralarův krámek", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Domnívám se, že se ti moje zboží hodí.", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Dennarův tábor", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Moji barbaři ti pomohou dosáhnout vítězství.", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213SI0004", "ID_STRING": "TXT_TITLE", "TEXT": "Furrenův krámek", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213SI0004", "ID_STRING": "TXT_DESC", "TEXT": "Moje zboží ti může na tvé pouti pomoci.", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutrální", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Žádný popis", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Gunrha", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Každé dítě se třese, zaslechne-li toto neblahé jméno - tento vládce pekel totiž proslul nezřízenou krvežíznivostí. Na jedné hostině, pořádané na počest Bethrezena a jeho vítězství nad královstvím světla, prý pozřel 1000 otroků.", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Lantfrid", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Tento nejvyšší z trpasličích pánů si získal věhlas díky nesmírné síle v boji a odvaze tváří v tvář nesmírné přesile. Jednou po celých sedm dní a nocí bojoval s mocným rudým drakem Arfuruzonem, než nad ním konečně zvítězil.", "SEQ_NUM": 0}
  ]
