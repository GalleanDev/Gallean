    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209UN01b7", "ID_STRING": "NAME_TXT", "TEXT": "Zombie", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209UN01bb", "ID_STRING": "NAME_TXT", "TEXT": "Zombie", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209UN01be", "ID_STRING": "NAME_TXT", "TEXT": "Lupič", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209UN01c0", "ID_STRING": "NAME_TXT", "TEXT": "Lupič", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209UN01c4", "ID_STRING": "NAME_TXT", "TEXT": "Mistrovský lupič", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209UN01c8", "ID_STRING": "NAME_TXT", "TEXT": "Mistrovský lupič", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Kmeny, den první", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Daeron Stařešina \n\"Doprovoďte mě do Tlamy, bojovníci, a já  se postarámm, abychom pronikli přímo do srdce zemí démonů!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Norwyndar \n\"Nebude to tak snadné, Daerone. Musíme projít přes zbylé vojáky Goveneše a prorazit sílící armádou démonů. Myslím, že bychom měli...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Daeron Stařešina \n\"Proč bychom měli poslouchat rady od elfa? Ano, bude to kruté a nebezpečné, ale nezapomínej, kdo jsme! Musíme zamířit na jih, dokud jsou naši nepřátelé slabí!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Norwyndar \n\"Bylo by mnohem lepší, kdyby Daeron zůstal v hlavním městě, dokud neshromáždíme dostatečně silnou armádu, která by ho ochránila. Měli bychom někoho poslat na jihozápad a prozkoumat Govenesh, zatímco se moje skupina vydá na východ k přátelům.\" ", "SEQ_NUM": 3},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Daeron Stařešina \n\"Pche! Zbabělé elfské strategie! Dejme se na pochod!\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Legie, den první", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"Pane, máme zprávy, že ti mrňousové sem táhnout ze severu. Kdybychom zrovna neválčili s govenešany, snadno bychom si s nimi poradili. Okamžitě musíme dobýt všechna zbylá města! Počkej - něco ti ukážu...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Thriš \n\"Proč jšte šem přivedli Thriš? Nepřežijete došt... ššššššš... sssssss... a tělo je naše, pane. Slabé mysli zničíme snadno. Očekávám tvé příkazy.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"Takhle blízko Tlamy mohou naši bratři přežít dost dlouho, aby ovládli všechny slabé. A máme tu ještě jednoho vojáka, který se k nám míní přidat...\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Grunkk \n\"Ty sem přinesl Grunkka! Grunkk tě smázne jako... áááárgh... už jsem tu bestii ovládl, pa... árrrgh... nikdy nezvládneš Grunkka! Počkej... tak tedy, jak jsem řekl, nyní toho zlobra ovládáme.\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"Ještě jednou nad ním ztratíš kontrolu a my se postaráme, aby sis to pořádně odskákal. Můj pane, s pomocí těchto... půjčených vojáků můžeme místní národy přimět, aby za nás bojovaly. Avšak nejprve bychom měli vyplenit města govenešanů.\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Legie vítězí", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"Hahahaha! Ti ubozí trpaslíci ztratili svého spasitele! Už nemají proč bojovat!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Kmeny vítězí", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Daeron Stařešina \n\"Tak jsme tu! Hotovo, bojovníci! Tenhle tunel vede přímo do srdce vojsk Legií! Při Wotanovi, teď okusí hněv našich kmenů!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"Ustupte! Rychle zpátky do Tlamy!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Kmeny prohrávají", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Daeron Stařešina \n\"Co jsem to učinil??? Kéž mi Wotan odpustí... ach!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Mina1", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Walos  \n\"Hahahahaha!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Mina2", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Walos \n\"Hahahaha! Nádhera!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Mina3", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Walos \n\"Dobrý pokus!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Mina4", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Walos \n\"Hahaha, to muselo bolet!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Legie - čarod. varování", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"Toho lidského čaroděje nezabíjejte! Již je posedlý a používáme ho jako návnadu!  Ty tudy projdeš bez úhony, ale trpaslíci... hahaha... nebudou mít takové štěstí!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Varování kmen. čaroděje", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Walos \n\"Zdravím tě, ehm... příteli! Lidská říše obdržela zprávu. Přicházíme ve jménu Nejvyššího otce a tak dále, však ty nesmysly znáš. Veď nás, budeme ti krýt záda. Proč váháš? Řekl jsem pojďme!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Kmeny zabíjejí Walose", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Daeron \n\"Všichni byli posedlí - cítím to! Nyní nepočítejme s tím, že by ta zpráva mohla k lidem dorazit!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Legie zabíjejí Walose", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"Kašpaři! Nakázal jsem vám přece, abyste se Walose nedotýkali! Zmařili jste tak jednu skvělou past!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Zajmutí elfa", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Mistrovský lupič \n\"Á, tak jsi nám přivedl toho legendárního Norwyndara. Dostaneme za něj pěknou sumičku! Můžeš jít.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Norwyndar \n\"Chápu tvé pohnutky, pane. Neboj se, při nejbližší příležitosti těm lumpům uteču.\"", "SEQ_NUM": 5},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Lupiči na severu", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Mistrovský lupič \n\"Trpaslíci, přiveďte nám elfa Norwyndera a my na oplátku poboříme tu zeď na jihu. Legie nečekají, že se k nim přiblížíte takhle. Popřemýšlejte o tom, je to moc dobrá nabídka - obětovat jednoho elfa a vyhrát válku!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Zaskočen", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Kmeny, den 4", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Frug Chrabrý \n\"Nyní odcházím, pane. Předám lidem poselství - jestli máme uspět, budeme potřebovat sílu každého muže. Pokud se naše cesty už nezkříží, je jisté, že jsme na druhé straně. Nechť Wotan vede naše břity!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Kmeny - Havraní město", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Zraněný goblin \n\"Prosím, už mě nepijte! My přebrali město elfům! Elfové se zakryli v zelené řicenině! Vy dovnitř nezaniknete! Ne, ne, ne, ne, ne, kdepak, nikam se nezastanete!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Kmeny, vstup skřetů", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Zvěd \n\"Fuj, cítíš to? Kam se poděl můj lid? Tady něco nehraje...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Únik z vězení", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Zvěd \n\"Z mého lidu už zůstali jen nemnozí... a pohlédni na ně - jsou slabí a zotročení!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Relwynn \n\"Už jsme se vzdali veškeré naděje, ale proti démonům s tebou samozřejmě potáhneme!\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Truntis \n\"Nedříve musíme přetnout řetězy. Tamhle ten skřetí otrokář u jámy má meč, který je k tomu jak dělaný. A vidím, že jsi jej již našel. Děkuji ti.\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Kmeny táhnou", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Poustevník", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Poustevník \n\"To si myslíš, že si prostě můžeš zabrat všechno, co zrovna potřebuješ? Tohle je náš důl a v jeho zdech přebývá náš lid. Nech nás na pokoji.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Fierholdu", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Bojovník \n\"Tyto ssstěny tě neuchrání před Mortisssinou zlobou. Pochutná sssi na tvém massse!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Scartoe", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Spektra \n\"Nemysssli sssi, že přežiješ.  Mortisss zatím vzkřísssila jen několik vojáků. Pomysssli na to, že v půdě pod tvýma nohama celé věky leží mrtví, kteří čekají jen na to, až ssse k nám přidají!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Felbrinnu", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Zasvěcenec \n\"Pchá, tak si to užij. Doufám jen, že tě ten mor, co tu po nás zůstal, hezky pomalu stráví zaživa!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Edrelmiru", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Vyšší upír \n\"To bylo sice působivé, ale má nečistá krev bude žít i nadále. Radši si v budoucnu dávej pozor na krk!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Cothkele", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Ghúlové \n\"Nééééééééééééééééé!!!!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Krečaku", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Černokněžník \n\"Vítej v Krečaku, doufám, že ti nevadí ty hromady mrtvol. To víš, my si na čistotu příliš nepotrpíme.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Illthrekova půda", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Za malý peníz dokážu přimět duchy, aby ti sloužili.", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Ubbovo zboží", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Tady nemáš co dělat! Koukej rychle nakoupit a vypadni!", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Crysendu", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0023", "ID_STRING": "POPUP_TXT", "TEXT": "Zasvěcenec \n\"Nechť Mortis znesvětí vaše mrtvá těla!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Doupě lupičů", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Nezajímej se, jak jsem to získal, a buď rád, že nakoupíš tak levně.", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Kthrellu", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Medusa \n\"Cizáci! Co sssi to dovolujete???\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Kmeny, den 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0026", "ID_STRING": "POPUP_TXT", "TEXT": "Frug Chrabrý \n\"A já si myslel, že se trpaslíci snížili ke spojení s elfy! Právě jsem zaslechl, že hlídky ještěranů zpozorovaly gobliny! Původní národy se musely spojit, aby odolaly útoku Goveneše.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Legie, den 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"Měli bychom se mít na pozoru - vypadá to, že domorodci spojili své síly, zřejmě aby je nezničil Goveneš. Nevadí - stejně je pobijeme, spojenectví nespojenectví!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Mor", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Varování před morem", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0029", "ID_STRING": "POPUP_TXT", "TEXT": "Oběť moru \n\"Zbláznil ses? Cožpak nevidíš, že jsme sem přišli v klidu zemřít? Možná už ses také nakazil morem! Obrať se zpět a zanech nás našemu utrpení!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Walos mrtev", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002b", "ID_STRING": "NAME_TXT", "TEXT": "Mor 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002b", "ID_STRING": "POPUP_TXT", "TEXT": "Družina byla nakažena morem.", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Mor 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002c", "ID_STRING": "POPUP_TXT", "TEXT": "Družinu postihla morová nákaza.", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002d", "ID_STRING": "NAME_TXT", "TEXT": "Mor 3", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Tvá družina byla nakažena morem.", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002e", "ID_STRING": "NAME_TXT", "TEXT": "Mor 4", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002e", "ID_STRING": "POPUP_TXT", "TEXT": "Tvou družinu zachvátila morová nákaza.", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002f", "ID_STRING": "NAME_TXT", "TEXT": "Mor 5", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "Tvá družina trpí náporem moru.", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0030", "ID_STRING": "NAME_TXT", "TEXT": "Mor 6", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0030", "ID_STRING": "POPUP_TXT", "TEXT": "Tvou družinu postihla morová nákaza.", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0031", "ID_STRING": "NAME_TXT", "TEXT": "Mor 7", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0031", "ID_STRING": "POPUP_TXT", "TEXT": "Družina byla nakažena morem.", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0032", "ID_STRING": "NAME_TXT", "TEXT": "Mor 8", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0032", "ID_STRING": "POPUP_TXT", "TEXT": "Družina trpí morovou nákazou.", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0033", "ID_STRING": "NAME_TXT", "TEXT": "Jonderuk", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0033", "ID_STRING": "POPUP_TXT", "TEXT": "Jonderuk \n\"Páni, tehnle svět je tak prostý! A na můj vkus příliš chladný!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0033", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"´Á, koukám, že máme dalšího rekruta. Ale nemáš pocit, že podoba, kterou sis vybral, je tak trochu... prašivá?\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0033", "ID_STRING": "POPUP_TXT", "TEXT": "Jonderuk \n\"Umění posedlosti není nic snadného, pane. Jen co jsem ucítil slabou mysl, hned jsem se vydal na cestu!\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0034", "ID_STRING": "NAME_TXT", "TEXT": "Černé oko", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0034", "ID_STRING": "POPUP_TXT", "TEXT": "Černé oko \n\"Jsme tu, pane. Už se těšíme, jak ten trpasličí mystik zahyne!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0034", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"Á, tady jste, vy moje ďábelská trojčátka! Byl jsem zvědavý, jestli se k nám přidáte. Jen doufám, že ta posedlost byla pořádně bolestivá!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0034", "ID_STRING": "POPUP_TXT", "TEXT": "Černé oko \n\"Jistěže ano, pane.\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0035", "ID_STRING": "NAME_TXT", "TEXT": "Ochrana", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0036", "ID_STRING": "NAME_TXT", "TEXT": "Lidská říše přichází", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0036", "ID_STRING": "POPUP_TXT", "TEXT": "Lodrimoor \n\"Obávám se, že může být už příliš pozdě, ale lidská říše je připravena bojovat s démony! Chviličku strpení - hned jsme u vás!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0037", "ID_STRING": "NAME_TXT", "TEXT": "Pavouk", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209LO0000", "ID_STRING": "NAME_TXT", "TEXT": "Tlama", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209LO0001", "ID_STRING": "NAME_TXT", "TEXT": "Mina1", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209LO0002", "ID_STRING": "NAME_TXT", "TEXT": "Mina2", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209LO0003", "ID_STRING": "NAME_TXT", "TEXT": "Mina3", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209LO0004", "ID_STRING": "NAME_TXT", "TEXT": "Mina4", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209LO0005", "ID_STRING": "NAME_TXT", "TEXT": "Legie potkávají čaroděje", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209LO0006", "ID_STRING": "NAME_TXT", "TEXT": "Varování kmen. čar.", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209LO0007", "ID_STRING": "NAME_TXT", "TEXT": "Lupiči na severu", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209LO0008", "ID_STRING": "NAME_TXT", "TEXT": "Varování před lupiči", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209LO0009", "ID_STRING": "NAME_TXT", "TEXT": "Vstup skřetů", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209LO000a", "ID_STRING": "NAME_TXT", "TEXT": "Osvobození", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209LO000c", "ID_STRING": "NAME_TXT", "TEXT": "Poustevník", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209LO000d", "ID_STRING": "NAME_TXT", "TEXT": "Morová oblast", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209LO000e", "ID_STRING": "NAME_TXT", "TEXT": "Mor jedna", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209LO000f", "ID_STRING": "NAME_TXT", "TEXT": "Mor2", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209LO0010", "ID_STRING": "NAME_TXT", "TEXT": "Mor3", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209LO0011", "ID_STRING": "NAME_TXT", "TEXT": "Mor4", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209LO0012", "ID_STRING": "NAME_TXT", "TEXT": "Mor5", "SEQ_NUM": 0},
