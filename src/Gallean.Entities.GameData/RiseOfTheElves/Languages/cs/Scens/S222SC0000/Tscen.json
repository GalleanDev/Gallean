    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Mstitelův tábor", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Moji skřeti jsou nejlepší v kraji.", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Underův obchod", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Prodávám všechno, co mám.", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Vidalova věž", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Má kouzla ti mohou na cestách pomoci.", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Allarův kvelb", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Na prodej mám všechno - pokud mi zaplatíš.", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutrální", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Žádný popis", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Goar", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Tento mocný pán se zamlada samojediný postavil armádě pekelné a jednou rukou ji zničil, neboť zapečetil bránu, jež vojska na tento svět přiváděla. Poté se stal nezávislým vládcem říše.", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Honir'ya", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Tento pán svého času proslul jako nejmocnější z adeptů černého umění. Jeho hrůzovládě sice učinil přítrž inkvizitor Vorgel, který ho zabil, avšak nyní zloduch opět povstal coby nemrtvý, sžírán neutuchající touhou podrobit každého smrtelníka své vůli.", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Ardobert", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Khagrael", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN0004", "ID_STRING": "NAME_TXT", "TEXT": "Král Virgil", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN0012", "ID_STRING": "NAME_TXT", "TEXT": "Sir Anabáziz", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN001c", "ID_STRING": "NAME_TXT", "TEXT": "Vesničan", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN0020", "ID_STRING": "NAME_TXT", "TEXT": "Vesničan", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Příběh Říše lidí", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Bradobar \n\"Král Virgil porazil skřety a uvěznil jejich krále. Musíme také zjistit, proč se v království opět objevují nemrtví. Až jejich hrozbu zažehnáme, připojíme toto území k naší říši.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Příběh - nemrtví", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Zombie\n\"Sir Anabáziz je věrným služebníkem krále, na jehož žádost jeho věrní studují Ďábelskou dýku a snaží se odhalit všechna její tajemství. Král hodlá vzkřísit svého syna, ať to stojí, co to stojí.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Nový Daxam", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Akolyta z Nového Daxamu\n\"Děje se tu něco prapodivného; lidé se mění ve zcela nepřirozená stvoření. Zdá se mi, jako bychom učinili něco, co je zapovězeno.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Desburg", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Přeživší z Desburgu\n\"Ďábelská dýka! Anabáziz je blázen, stejně jako jeho lidé. Uvolnili něco, co nemohou pochopit, a na nás na všechny tak uvrhli kletbu! Prokletí Ďábelské dýky spočívá v tom, že proměňuje všechno živé v bezduché tělesné schránky!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN0029", "ID_STRING": "NAME_TXT", "TEXT": "Vesničan", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Věž čarodějnice", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Lovec čarodějnic z věže\n\"Odstup, bezduchý tvore! Zmiz, nebo ochutnáš čepel mého meče!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN002c", "ID_STRING": "NAME_TXT", "TEXT": "Vesničan", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Bythazarská stráž", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Obranný sloupec", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Nový Ráj", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Prokletý obyvatel Nového Ráje\n\"Nový Bythazar? Ano, je silně střežen - jeho hlídači byli také proměněni a jsou odsouzeni k zatracení, stejně jako my.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN0030", "ID_STRING": "NAME_TXT", "TEXT": "Spektra", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Útok strážce", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Král Virgil \n\"Zničím vás jednou provždy, škůdci národa!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Zpráva strážce - lid. říše", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Král Virgil\n\"Pohleď - mocná Říše lidí! A to se jí mám jako bát? Patří mi všechno bohatství království a nemám co ztratit! A co máš ty?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Dračí útok", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN0034", "ID_STRING": "NAME_TXT", "TEXT": "Vesničan", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Artekins", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Sir Anabáziz\n\"Působení Ďábelské dýky bude v této oblasti zřetelné ještě po celé generace!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Rozhovor", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Archanděl\n\"Krále Virgila se zmocnila neutuchající krvežíznivost. Ztráta syna ho dohnala k šílenství!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN0037", "ID_STRING": "NAME_TXT", "TEXT": "Páže", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Vrah", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Vrah dvě", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Zpráva od vesničana", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Prostý vesničan\n\"Můžeš si myslet, že jsem chudý a bezcenný, ale právě proto často zůstanu neviděn a nepovšimnut. Náš milovaný král dal tvé jméno bythazarským vrahům, kteří se cvičí ve vyzvědačství a jsou úplně všude. Bylo by moudré se králi vzdát.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Královský vrah", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Zpráva od lupiče", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Lupič \n\"Checht, to si nemyslím!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Královská stráž", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Útok na Ráj", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Anabázizův služebník", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Podmínky vítězství lidí", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Rytíř na Pegasovi\n\"Sláva Říši lidí! Zvítězili jsme! Na vědomost se dává, že král Virgil je mrtev. V tento slavný den se ujímáme správy království a všech přilehlých panství. Kéž dnes začne nový zlatý věk Nového Bythazaru!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN0044", "ID_STRING": "NAME_TXT", "TEXT": "Vlk", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Podm. vítězství nemrt.", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Spektra  \n\"Král Virgil ssse touží ssspojit ssse sssvým bláznivým sssynem. Budou tedy ssspolu, neboť král je mrtev! Nyní ssse k němu musssí připojit i celý jeho lid!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0022", "ID_STRING": "NAME_TXT", "TEXT": "Půda Říše lidí", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0022", "ID_STRING": "POPUP_TXT", "TEXT": "Bradobar\n\"Nyní ovládáme většinu území a musíme se soustředit na krále Virgila. Dejme mu za vyučenou a přesvědčeme ho, že se nevyplatí nás urážet či přehlížet! Ať žije Říše lidí!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0022", "ID_STRING": "OBJECT_TXT", "TEXT": "Porazit krále Virgila", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Území nemrtvých", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0023", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' ash \n\"Král se k nám brzy připojí ve smrti. Až se zmocníme jeho těla, můžeme vládnout i celé jeho říši a nesmírně tak posílit naši armádu!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0023", "ID_STRING": "OBJECT_TXT", "TEXT": "Porazit krále Virgila", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0024", "ID_STRING": "NAME_TXT", "TEXT": "Odstranit hory", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Vrahové padesát procent", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Varování nemrtvých", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Spektra \n\"Můj pane, zjissstili jsssme, že král sss pomocí Ďábelssské dýky nassstražil na všechny cesssty ssspousssty passstí. Cítím, že by bylo moudré vyssslat do první linie prosté kossstlivce, aby všechny passsti ssspussstili.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN004a", "ID_STRING": "NAME_TXT", "TEXT": "Artekinský kopiník", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Varování Říše lidí", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "Páže \n\"Můj pane, král Virgil se zbláznil! Zjistil jsem, že některé oblasti jsou prokleté. Musíme si dávat pozor na každém kroku!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Nová událost", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí, den 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV002a", "ID_STRING": "POPUP_TXT", "TEXT": "Bradobar \n\"Král Virgil si zahrává s neznámými věcmi a výsledkem je, že na celou zem padlo prokletí a na cestách na nás číhají mnohá nebezpečí. Použijeme-li však jako vyzvědače oživlé brnění, můžeme nástrahy spustit a své vojáky tak ochránit.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Past 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV002d", "ID_STRING": "NAME_TXT", "TEXT": "Nová událost", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV002e", "ID_STRING": "NAME_TXT", "TEXT": "Past 4", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV002f", "ID_STRING": "NAME_TXT", "TEXT": "Past 5", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0030", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví, den 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0030", "ID_STRING": "POPUP_TXT", "TEXT": "Kostlivec \n\"Můj pane, zjistil jsem, že ten bláznivý král si zahrával s neznámými věcmi. Proklel celou zemi a my nyní musíme postupovat pouze s nejvyšší opatrností. Každým krokem můžeme být blíže nějakému netušenému nebezpečí.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN0053", "ID_STRING": "NAME_TXT", "TEXT": "Artekins Kopiník II", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN0054", "ID_STRING": "NAME_TXT", "TEXT": "Páže", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0031", "ID_STRING": "NAME_TXT", "TEXT": "Past 6", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0033", "ID_STRING": "NAME_TXT", "TEXT": "Past 7", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN0057", "ID_STRING": "NAME_TXT", "TEXT": "Páže", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0034", "ID_STRING": "NAME_TXT", "TEXT": "Past 8", "SEQ_NUM": 0},
