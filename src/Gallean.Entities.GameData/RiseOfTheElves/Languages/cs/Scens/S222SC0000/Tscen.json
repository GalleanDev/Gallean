    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN005b", "ID_STRING": "NAME_TXT", "TEXT": "Lední medvěd", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0039", "ID_STRING": "NAME_TXT", "TEXT": "Past 11", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN005e", "ID_STRING": "NAME_TXT", "TEXT": "Kultista", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV003b", "ID_STRING": "NAME_TXT", "TEXT": "Past 13", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV003c", "ID_STRING": "NAME_TXT", "TEXT": "Past zlato 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV003d", "ID_STRING": "NAME_TXT", "TEXT": "Nová událost", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV003e", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí 10", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV003e", "ID_STRING": "POPUP_TXT", "TEXT": "Páže \n\"Můj pane, musím ti připomenout, že tato země je prokletá. Král Virgil se pokoušel vzkřísit svého syna, prince Daxama, a neuspěl! A příroda ho teď za takové rouhání spravedlivě trestá!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV003f", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví, den 10", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV003f", "ID_STRING": "POPUP_TXT", "TEXT": "Kostlivec \n\"Pane, chci ti jen pokorně připomenout, že tohle královssství je prokleté. Sssmrt se ke králi Virgilovi blíží mílovými kroky a vykonavateli tohoto osudu budeme právě my. Musssíme possstupovat opatrně, neboť tu na násss číhají mnohá nebezpečí!\"", "SEQ_NUM": 0},
