    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Clathumův obchod", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Vítej, jen si v klidu prohlédni všechno, co tu mám.", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Jenbahovo tržiště", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Nakupujeme i prodáváme za skvělé ceny, pane.", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Keriekův tábor", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Moji vojáci jsou ti nejlepší v kraji.", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Bilalova věž", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Domnívám se, že má magická knihovna by ti mohla být nápomocna.", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutrální", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Žádný popis", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Galarth", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Tento mocný pán se zamlada samojediný postavil armádě pekelné a jednou rukou ji zničil, neboť zapečetil bránu, jež vojska na tento svět přiváděla. Poté se stal nezávislým vládcem říše.", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Fedroth", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Tato paní svého času proslula jako nejmocnější z adeptů černého umění. Její hrůzovládě sice učinil přítrž inkvizitor Vorgel, který ji zabil, avšak nyní zrůda opět povstala coby nemrtvá, sžírána neutuchající touhou podrobit každého smrtelníka své vůli.", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Dagar", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Zythaar", "SEQ_NUM": 0}
