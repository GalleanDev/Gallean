    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV002c", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Pane, posily dorazily.\"\n", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV002d", "ID_STRING": "NAME_TXT", "TEXT": "Den 21 posila úroveň 1 - nemrtví", "SEQ_NUM": 0},
