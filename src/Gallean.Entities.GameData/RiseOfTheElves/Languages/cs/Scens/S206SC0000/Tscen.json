    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206UN0046", "ID_STRING": "NAME_TXT", "TEXT": "Sybarh Maal", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Objevení úr. 2 loď Z 4", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0024", "ID_STRING": "NAME_TXT", "TEXT": "Objevení úr. 2 loď Z 5", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - lok. příběh Sirie 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Zvěd\n\"Pane, blížíme se k městu Siria. Obývají je hlavně obchodníci a námořníci, kteří se tu na svých cestách zastavují. V současnosti mu vládnou obyvatelé bažin.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - lok. příběh Sirie 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "Zvěd\n\"Pane, blížíme se k městu Siria. Obývají je hlavně obchodníci a námořníci, kteří se tu na svých cestách zastavují. V současnosti mu vládnou obyvatelé bažin.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví - lok. Siriin příběh 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0029", "ID_STRING": "POPUP_TXT", "TEXT": "Zvěd\n\"Pane, blížíme se k městu Siria. Obývají je hlavně obchodníci a námořníci, kteří se tu na svých cestách zastavují. V současnosti mu vládnou obyvatelé bažin.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví - lok. Siriin příběh 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV002a", "ID_STRING": "POPUP_TXT", "TEXT": "Zvěd\n\"Pane, blížíme se k městu Siria. Obývají je hlavně obchodníci a námořníci, kteří se tu na svých cestách zastavují. V současnosti mu vládnou obyvatelé bažin.\"", "SEQ_NUM": 0},
