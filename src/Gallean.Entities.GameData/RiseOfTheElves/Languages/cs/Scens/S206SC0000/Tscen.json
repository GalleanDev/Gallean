    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV002e", "ID_STRING": "NAME_TXT", "TEXT": "Den 18 varování - nemrtví", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV002e", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Pane, Jeden zvěd mi právě sdělil, že Mortis nám posílá pomocné jednotky, které mají brzy dorazit.\"\n", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV002f", "ID_STRING": "NAME_TXT", "TEXT": "Den 18 varování - lidé", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Pane, Jeden zvěd mi právě sdělil, že ze spřátelené Říše lidí k nám pochodují pomocné jednotky, které mají brzy dorazit.\"\n", "SEQ_NUM": 0},
