    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí získává krakena", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Pane, ta svatá relikvie nám umožní ovládat mýtického krakena!\"\n", "SEQ_NUM": 2},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví získávají krakena", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Pane, ta svatá relikvie nám umožní ovládat mýtického krakena!\"\n", "SEQ_NUM": 2},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí získává hada", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Pane, ta svatá relikvie nám umožní ovládat mýtického mořského hada!\"\n", "SEQ_NUM": 2},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví získávají hada", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Pane, ta svatá relikvie nám umožní ovládat mýtického mořského hada!\"\n", "SEQ_NUM": 2},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - intro - mořský tvor", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Před dávnými časy, ještě před příchodem Říše lidí a Zástupů nemrtvých, bojovali o vládu nad touto oblastí obyvatelé bažin a barbaři.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "\"Ostrované si vyprávějí příběhy o tom, jak ovládli mýtická mořská stvoření a používali je v bitvách.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví - intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Před dávnými časy, ještě před příchodem Říše lidí a Zástupů nemrtvých, bojovali o vládu nad touto oblastí obyvatelé bažin a barbaři.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "\"Ostrované si vyprávějí příběhy o tom, jak ovládli mýtická mořská stvoření a používali je v bitvách.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Konvoj nemrtvých úspěšný", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Můj pane, konvoj bezpečně dorazil do cíle.\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Konvoj Říše lidí úspěšný", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Pane, konvoj bezpečně dorazil do cíle.\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Den 7 varování - lidé", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Můj pane, jeden z našich konvojů u města Galdarthu potřebuje pomoc! Nese velmi cenný náklad a musíme zajistit, aby bez úhony dorazil do cíle.\"\n", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Den 7 varování - nemrtví", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Pane, jeden z našich konvojů u města Arkenaso potřebuje pomoc! Jeho náklad je velmi cenný a musíme zajistit, aby zdárně dorazil do cíle.\"\n", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Objevení úr. 1 lodi Z1", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Objevení úr. 1 loď Z 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Objevení úr. 1 loď Z 3", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Objevení úr. 1 loď Z 4", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Objevení úr. 1 loď Z 5", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - lok. Galdarthův příběh", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Zvěd\n\"Pane, blížíme se ke městu zvanému Galdarth. Vypráví se, že náčelník kmene Galdarth vlastní magický předmět, který mu dává moc ovládat jakousi mocnou šelmu.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví - lok. Galdarthův příběh", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Zvěd\n\"Pane, blížíme se ke městu zvanému Galdarth. Vypráví se, že náčelník kmene Galdarth vlastní magický předmět, který mu dává moc ovládat jakousi mocnou šelmu.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Konvoj Říše lidí ztracen", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Pane, konvoj byl zničen a ztratili jsme všechno zboží!\"\n", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Konvoj nemrtvých ztracen", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Pane, konvoj byl zničen a ztratili jsme všechno zboží!\"\n", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206UN003d", "ID_STRING": "NAME_TXT", "TEXT": "Mýtický kraken", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206UN003f", "ID_STRING": "NAME_TXT", "TEXT": "Mýtický mořský had", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206UN0040", "ID_STRING": "NAME_TXT", "TEXT": "Ještěran", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - lok. Arkenosův příběh", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Zvěd\n\"Toto je město Arkenaso. Jednu chvíli bývalo jedním z největších měst obyvatel bažin, ale to bylo ještě před válkou s barbary. Legendy vyprávějí o magické věci, která jim dává nesmírnou moc nad mořskými tvory.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Nemrtví - lok. Arkenasův příběh", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Zvěd\n\"Toto je město Arkenaso. Jednu chvíli bývalo jedním z největších měst obyvatel bažin, ale to bylo ještě před válkou s barbary. Legendy vyprávějí o magické věci, která jim dává nesmírnou moc nad mořskými tvory.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206UN0043", "ID_STRING": "NAME_TXT", "TEXT": "Náčelník kmene Galdarth", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Objevení úr. 2 loď Z 1", "SEQ_NUM": 0},
