    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Kammilarova továrna", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Zde nalezneš všechny druhy lektvarů!", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Nellyno zboží", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Prodávám pár velmi zajímavých věciček!", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Reggenův tábor", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Hej, hoši! Nepotřebujete vycvičit?", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutrální", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Žádný popis", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Goar", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Tento mocný pán se zamlada samojediný postavil armádě pekelné a jednou rukou ji zničil, neboť zapečetil bránu, jež vojska na tento svět přiváděla. Poté se stal nezávislým vládcem říše.", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Baalhu", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Každé dítě se třese, zaslechne-li toto neblahé jméno - tento vládce pekel totiž proslul nezřízenou krvežíznivostí. Na jedné hostině, pořádané na počest Bethrezena a jeho vítězství nad královstvím světla, prý pozřel 1000 otroků.", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Ardobert", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Kahath", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254UN0023", "ID_STRING": "NAME_TXT", "TEXT": "Posel Nejvyšší rady", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254UN0025", "ID_STRING": "NAME_TXT", "TEXT": "Lesní elf", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Legie přinášejí Oko", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Vaglan\n\"Získal jsi Oko! Je to moudrá volba - lidé si teď budou muset najít jiný způsob, jak tě porazit. A teď mne doprovoď do hlavního města!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254UN0026", "ID_STRING": "NAME_TXT", "TEXT": "Kentauří kopiník", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254UN0027", "ID_STRING": "NAME_TXT", "TEXT": "Lesní elf", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Abychom šířili slovo Nejvyššího otce, potřebujeme průvodce, jenž by nám pomohl ovládnout vrchovinu, kde se usídlily Legie.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Vysoko v horách, poblíž hlavního města Legií, žije jakýsi člověk. Už jsme se s ním spojili a souhlasil, že nás dovede do vysočiny, jestliže pro něj získáme Doragonovo oko.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254UN0028", "ID_STRING": "NAME_TXT", "TEXT": "Kentauří kopiník", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Lidé dobývají Nisseland", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Jsme si jisti, že elfové mají Oko, ale v tomto městě po něm není ani stopy. Musíme hledat dál.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254UN0029", "ID_STRING": "NAME_TXT", "TEXT": "Lesní elf", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Taury", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Thrunn Vládce oštěpu\n\"Elfové jsou všude - ještě ses nás nezbavil! Nebudeme tolerovat obsazování našich měst tvými vojáky. Pokud chceš přežít, odejdi!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - lok. elfí varování", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Posel Nejvyšší rady\n\"Nejvyšší rada elfů rozhodla, že elfí lid už tě tu nebude více tolerovat. Za své nenasytné chování a nabubřelou neúctu k našim zemím i obyvatelům zaplatíš opravdu vysokou cenu!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Posel Nejvyšší rady\n\"Nepočítej s naší pomocí a nepokoušej se s námi spojit, nebo toho budeš hořce litovat.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Plané výhrůžky elfů nejsou nijak důležité. Jen nám zavdávají příčinu, abychom se zmocnili jejich měst a vesnic. Postupujme podle plánu.\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Dobytí Dullahanu", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Elfové\n\"Nikdy vám nic neprozradíme, a nikdy vám nevydáme, co hledáte! Vše, co dostanete, je pouze bolest!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Legie - intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Informace, jež máme o pohybech Říše lidí, nasvědčují, že se nás pokoušejí vystrnadit z vysočiny. Až dosud naše severní země dostatečně chránil mocný horský masiv.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Ještě přesně nevíme, kdy nebo jak na nás Říše lidí chce zaútočit, což nás dosti zneklidňuje. Musíme to vypátrat, a brzy!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Lok. umírajících elfů", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Toto místo je podivně klidné. Znám spoustu starých příběhů o elfech, kteří sem vstoupili a už nikdy se nevrátili.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Mrtví se zvedají ze země!\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254UN002e", "ID_STRING": "NAME_TXT", "TEXT": "Kentauří kopiník", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254UN0032", "ID_STRING": "NAME_TXT", "TEXT": "Kentauří kopiník", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254UN0033", "ID_STRING": "NAME_TXT", "TEXT": "Lesní elf", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Legie dobývají Kannu", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Obyvatelé města\n\"Konečně jsi přišel a osvobodil nás! Navždycky tě budeme uctívat jako skutečného pána!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254UN0035", "ID_STRING": "NAME_TXT", "TEXT": "Lesní elf", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - lok. Dullahan", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Toto je město Dullahan, pane. Bude těžce opevněno. Jsme připraveni na takový boj?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254UN0039", "ID_STRING": "NAME_TXT", "TEXT": "Kentauří kopiník", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - varování před lesem", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Elfové si dali záležet na tom, aby husté lesy, jež vypěstovali, zabraňovaly všem vetřelcům ve vstupu. Další postup bude pomalý, ale ne nemožný.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Legie - setkání s Vaglanem", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Vaglan\n\"Jmenuji se Vaglan. Dovol, abych ti vše stručně vysvětlil. Jestli mi nepřineseš Doragonovo oko, doprovodím Říši lidí na vysočinu a vaše nechráněná města vydám všanc jejich útokům.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Vaglan\n\"Nabízím služby tomu, kdo mi Oko přinese jako první. Budu čekat ve svatyni na vrcholu hory.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Vaglan (Legie) - lidé vítězí", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254UN003c", "ID_STRING": "NAME_TXT", "TEXT": "Kentauří kopiník", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Vaglan (Legie) - Legie vítězí", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí přináší Oko", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Vaglan\n\"Získal jsi Oko! Je to moudrá volba, neboť s mou pomocí máš vítězství v kapse. A teď mne doprovoď do tvého hlavního města!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254UN003e", "ID_STRING": "NAME_TXT", "TEXT": "Dullahanův strážce", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Vaglan (lidé) - lidé vítězí", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Vaglan (lidé) - Legie vítězí", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - lok. Dullahanovo hrabství", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Elfové\n\"Rozuměli jste varování? Držte se od nás dál!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Nellyn krámek", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Neflly\n\"I když se s tebou ostatní elfové nemíní bavit, já s tebou budu stále obchodovat.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Legie - lok. varování před elfy", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Buď opatrný, pane, neboť v těchto končinách žije mnoho elfů, kteří nás nenávidí téměř tolik jako my je. Mohou nás napadnout, jakmile nás spatří.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254UN0044", "ID_STRING": "NAME_TXT", "TEXT": "Kentauří kopiník", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Objevení elfa1", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0022", "ID_STRING": "NAME_TXT", "TEXT": "Objevení elfa 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - lok. Nisseland", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0023", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Před námi se nachází město Nisseland. Jde o důležité obchodní středisko elfů a jeho dobytím jim zasadíme citelnou ránu.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0024", "ID_STRING": "NAME_TXT", "TEXT": "Legie - lok. Nisseland", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0024", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Pane, před námi leží město Nisseland. Pro elfy představuje důležité obchodní středisko a jestliže je dobudeme, zasadíme jejich hospodářství krutou ránu.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Legie dobývají Nisseland", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Jsme si jisti, že elfové mají Oko, ale v tomto městě po něm není ani stopy. Musíme hledat dál.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Lidé dobývají Kannu", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0026", "ID_STRING": "POPUP_TXT", "TEXT": "Obyvatelé města\n\"Město Kanna nebude nikdy utiskováno císařskými vojsky - proti takové invazi budeme bojovat!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Lok. varování stráž. věže", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Stráž\n\"Poplach ve strážní věži! Vetřelci!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Legie - lok. Dullahanovo hrabství", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "Elfové\n\"Démonické zrůdy, pošleme vás zpátky do pekel!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254UN004b", "ID_STRING": "NAME_TXT", "TEXT": "Kentauří kopiník", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Legie - lok. Dullahan", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0029", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Před námi leží město Dullahan. I když je elfové opevnili, nedá nám jeho dobytí mnoho práce!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Vyloupit Hrabiště1", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV002a", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Oko!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV002b", "ID_STRING": "NAME_TXT", "TEXT": "Lidé vylupují Hrabiště", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV002b", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Musíme Vaglanovi donést Oko ještě předtím, než se nám je Legie pokusí odcizit. Pravil, že ho najdeme ve skrýši na vrcholu hory, která se nalézá na území Legií.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254UN004e", "ID_STRING": "NAME_TXT", "TEXT": "Elfí stráž", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Legie vylupují Hrabiště", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV002c", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Konečně, máme to! Teď už nám jen stačí setkat se s Vaglanem v jeho horské skrýši a doprovodit ho do hlavního města. Ta bídná lidská říše už nebude mít šanci!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV002d", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - lok. Taura", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Před námi leží město Taura. Je to malá elfí osada a pro naše zkušené vojáky nebude jeho dobytí jistě žádný problém.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV002e", "ID_STRING": "NAME_TXT", "TEXT": "Legie - lok. Taura", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV002e", "ID_STRING": "POPUP_TXT", "TEXT": "Rádce\n\"Toto je město Taura, pane. Celá léta jsme čekali, abychom je mohli dobýt, neboť jeho obyvatelé občas podnikali nájezdy do našich zemí. Nyní pocítí náš hněv!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV002f", "ID_STRING": "NAME_TXT", "TEXT": "Legie - lok. Hrabiště", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "Elf\n\"Neopovažujte se ještě přiblížit, démoni! Jestli se odvážíte vstoupit, budeme Hrabiště bránit ze všech sil!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0030", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - lok. Hrabiště", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0030", "ID_STRING": "POPUP_TXT", "TEXT": "Elf\n\"Jestli se opovážíte vstoupit, budeme Hrabiště bránit se všech sil! Byli jste varování, vojáci Říše lidí!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0031", "ID_STRING": "NAME_TXT", "TEXT": "Lok. útoků Vaglanova medvěda", "SEQ_NUM": 0},
    {"NO_SCEN": "S254SC0000", "ID_OBJECT": "S254EV0032", "ID_STRING": "NAME_TXT", "TEXT": "Říše lidí - odhalení Vaglanova úkrytu", "SEQ_NUM": 0},
