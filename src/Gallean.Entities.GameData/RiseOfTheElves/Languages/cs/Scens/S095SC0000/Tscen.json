    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095SI0001",
      "ID_STRING": "TXT_DESC",
      "TEXT": "Jen si prohl\u00E9dni m\u00E9 zbo\u017E\u00ED, t\u0159eba tu najde\u0161 n\u011Bco zaj\u00EDmav\u00E9ho.",
      "SEQ_NUM": 0
