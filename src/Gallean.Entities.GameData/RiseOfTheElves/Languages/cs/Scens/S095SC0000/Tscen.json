    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095SI0002",
      "ID_STRING": "TXT_DESC",
      "TEXT": "M\u00E1m tu spoustu mocn\u00FDch kouzel.",
      "SEQ_NUM": 0
