    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0000",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar T1",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0000",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar Cestovatel\n\u0022Bu\u010F zdr\u00E1v, pane! Jsem r\u00E1d, \u017Ee jsi v\u0161e bezpe\u010Dn\u011B zvl\u00E1dl. Inkvizitor Philip D\u0027Agnicourt t\u011B o\u010Dek\u00E1v\u00E1 ve m\u011Bst\u011B Fhindaru naho\u0159e na severu. Dovedu t\u011B tam...\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0023",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Kopin\u00EDk",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0001",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar T2",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar Cestovatel\n\u0022Dej si pozor! Tyto \u0159eky ob\u00FDvaj\u00ED mo\u0159sk\u00E9 \u010Darod\u011Bjnice, je\u017E \u010D\u00EDhaj\u00ED na neopatrn\u00E9 cestovatele! Nezdr\u017Euj se ve vod\u011B!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0024",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0002",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar Mrtv\u00FD",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0025",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0026",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0003",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar st\u0159edn\u00ED 1",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0003",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Kopin\u00EDk\n\u0022Promi\u0148, Nobare, ale krom\u011B tebe tudy nesm\u00ED nikdo proj\u00EDt. Tak p\u0159ik\u00E1zal Philip.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0027",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0004",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar st\u0159edn\u00ED 2",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Kopin\u00EDk\n\u0022Zdrav\u00ED\u010Dko, Nobare. Krom\u011B tebe sem nesm\u00ED nikdo vstoupit. Tak zn\u011Bj\u00ED rozkazy Philipa D\u0027Agnicourta...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0005",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Obch\u00E1zej\u00EDc\u00ED pavouk T10",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0028",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0029",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0007",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Hubertova arm\u00E1da T30",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0007",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hubert de Lalye\n\u0022L\u00EDb\u00ED se ti m\u00ED hedv\u00E1bn\u00ED p\u0159\u00E1tel\u00E9? M\u011Bl ses ke mn\u011B p\u0159ipojit, tak jak u\u010Dinili ostatn\u00ED... Nyn\u00ED zem\u0159e\u0161 a Fhindar bude m\u016Fj! Ha, ha, ha, ha, ha...\u0022",
      "SEQ_NUM": 3
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0007",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hrani\u010D\u00E1\u0159\n\u0022Pane, mus\u00EDme Huberta de Lalye zastavit je\u0161t\u011B p\u0159edt\u00EDm, ne\u017E se zmocn\u00ED m\u011Bsta Fhindaru!\u0022",
      "SEQ_NUM": 5
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0007",
      "ID_STRING": "OBJECT_TXT",
      "TEXT": "P\u0159emoci Huberta de Lalye d\u0159\u00EDve, ne\u017E si podman\u00ED m\u011Bsto Fhindar. Uther nesm\u00ED zahynout.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0008",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Obch\u00E1zej\u00EDc\u00ED pavouci T20",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0008",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hrani\u010D\u00E1\u0159\n\u0022N\u011Bco ty pavouky vyh\u00E1n\u00ED z jejich doupat! Na\u0161i pr\u016Fzkumn\u00EDci vid\u011Bli kou\u0159, kter\u00FD se linul z Hedv\u00E1bn\u00E9ho lesa... Kdo mohl zp\u016Fsobit n\u011Bco takov\u00E9ho?\u0022",
      "SEQ_NUM": 5
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0009",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Dra\u010D\u00ED str\u00E1\u017E",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0009",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Uther\n\u0022O\u010Dist\u00EDm na\u0161i \u0159\u00ED\u0161i od takov\u00FDch, jako jsi ty, Huberte de Lalye! P\u0159iprav se na smrt! Navr\u00E1t\u00EDm vl\u00E1du jej\u00EDmu pr\u00E1voplatn\u00E9mu majiteli!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0009",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hubert de Lalye\n\u0022Chlapec?! Ha, ha, ha! To je v\u0161echno, \u010D\u00EDm se m\u016F\u017Ee lidsk\u00E1 \u0159\u00ED\u0161e br\u00E1nit? Demosthene je zbab\u011Blec...\u0022",
      "SEQ_NUM": 4
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN002c",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Kopin\u00EDk",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Varov\u00E1n\u00ED p\u0159ed Hedv\u00E1bn\u00FDm lesem",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000a",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar Cestovatel\n\u0022T\u011Bm hvozd\u016Fm p\u0159ed n\u00E1mi se \u0159\u00EDk\u00E1 Hedv\u00E1bn\u00FD les. Jen m\u00E1lokdo si trouf\u00E1 p\u0159ibl\u00ED\u017Eit, nebo\u0165 se ob\u00E1v\u00E1 divok\u00FDch tvor\u016F, kte\u0159\u00ED v n\u011Bm \u010D\u00EDhaj\u00ED.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN002d",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN002e",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000c",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Vstup do Fhindaru",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000c",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar Cestovatel\n\u0022Fhindar u\u017E je bl\u00EDzko! Mus\u00ED\u0161 se vydat na z\u00E1pad. Vede tam v\u00EDce ne\u017E jedna cesta...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN002f",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Kopin\u00EDk",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000d",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar T5",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000d",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar Cestovatel\n\u0022Philip d\u0027Agnicourt je velmi opatrn\u00FD - zablokoval v\u0161echny cesty do Fhindaru. Douf\u00E1m, \u017Ee t\u011B nech\u00E1 proj\u00EDt!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0030",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0031",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Prost\u00FD kopin\u00EDk um\u00EDr\u00E1",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0032",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000f",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nejvy\u0161\u0161\u00ED kopin\u00EDk um\u00EDr\u00E1",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0010",
      "ID_STRING": "NAME_TXT",
      "TEXT": "V\u00EDt\u011Bzstv\u00ED v \u00FAkolu (zabit\u00ED Huberta)",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0010",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hubert de Lalye\n\u0022Ty... ty... ty jsi mne porazil! Jak je to mo\u017En\u00E9? Prokl\u00EDn\u00E1m t\u011B, Uthere!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0010",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Uther\n\u0022V\u0161echny nep\u0159\u00E1tele \u0158\u00ED\u0161e lid\u00ED potk\u00E1 stejn\u00FD osud. Pomohu sv\u00E9mu otci znovu nastolit m\u00EDr do kr\u00E1lovstv\u00ED Nevendaar!\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0034",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Ledn\u00ED medv\u011Bd",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0011",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Hubert v\u00EDt\u011Bz\u00ED",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0011",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hubert de Lalye\n\u0022Ha, ha, ha! Te\u010F, kdy\u017E vl\u00E1dnu Fhindaru, nem\u016F\u017Ee\u0161 mi nikdy vzdorovat... Uther\u016Fv n\u00E1vrat byl k ni\u010Demu!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0012",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Text m\u011Bsta Chazan\u016Fv T\u00FDn",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0012",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Lu\u010Di\u0161tn\u00EDk\n\u0022Na mo\u0159i zmizelo mnoho ryb\u00E1\u0159\u016F... Vesni\u010Dan\u00E9 se domn\u00EDvaj\u00ED, \u017Ee je pohltily mo\u0159sk\u00E9 obludy!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0036",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Mo\u0159sk\u00E1 panna",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0013",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Text m\u011Bsta St\u0159\u00EDbroval",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0013",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Kopin\u00EDk\n\u0022Fhindar le\u017E\u00ED kousek na sever. Douf\u00E1me, \u017Ee c\u00EDsa\u0159 tuto vojnu vyhraje... Hubert vyslal domobranu, aby zajistila v\u0161echna m\u011Bsta v t\u011Bchto kraj\u00EDch!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0014",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Lofemyr\u016Fv tah T8",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0037",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0038",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0017",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar T30",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0017",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar Cestovatel\n\u0022Philip d\u0027Agnicourt t\u011B nap\u00E1lil! V\u0161echno to byl trik, dej si pozor, m\u016Fj pane...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN003a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Kraken",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0018",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Uther um\u00EDr\u00E1",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0018",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Kn\u011B\u017Eka\n\u0022Co jsme to ud\u011Blali? Uther, c\u00EDsa\u0159\u016Fv ztracen\u00FD syn, zahynul! Osud na\u0161\u00ED \u0159\u00ED\u0161e je zpe\u010Det\u011Bn!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0019",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Fhindarsk\u00E1 oblast",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0019",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Uther\n\u0022P\u0159i\u0161el jsem ve jm\u00E9nu sv\u00E9ho otce! Jsem Uther, d\u011Bdic Nevendaaru, kter\u00FD vede boj proti nep\u0159\u00E1tel\u016Fm \u0158\u00ED\u0161e lid\u00ED! O\u010Dist\u00EDm ji od takov\u00FDch, jako jsi ty, de Lalye! P\u0159iprav se na smrt...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0019",
      "ID_STRING": "OBJECT_TXT",
      "TEXT": "Zbavit se Huberta de Lalye. Uther nesm\u00ED zahynout.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN003c",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Mo\u0159sk\u00E1 panna",
      "SEQ_NUM": 0
