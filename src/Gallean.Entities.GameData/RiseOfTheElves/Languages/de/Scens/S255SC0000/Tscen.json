    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Keine Völkerbeschreibung", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255UN0019", "ID_STRING": "NAME_TXT", "TEXT": "Hügelriese", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255UN001f", "ID_STRING": "NAME_TXT", "TEXT": "Godefroy", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Godefroy", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Dieser mächtige Fürst stellte sich einst einer ganzen Armee aus der Hölle und besiegte sie fast alleine, indem er das Portal verschloss, aus dem die Höllenbrut strömte. Er wurde dann Herrscher seines Reiches.", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255UN0020", "ID_STRING": "NAME_TXT", "TEXT": "Uron", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Kafira", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Jedes Kind erschauert, sobald der Name fällt. Diese Höllenfürstin ist für ihren Blutdurst bekannt. Bei einem Bankett, das Brethrezen anlässlich des Sieges über das Königreich des Lichts einst gab, soll sie angeblich 1000 Sklaven gefressen haben.", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255UN0021", "ID_STRING": "NAME_TXT", "TEXT": "Gunther", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255PL000b", "ID_STRING": "NAME_TXT", "TEXT": "Lan-Duul", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255PL000b", "ID_STRING": "DESC_TXT", "TEXT": "Zu seiner Zeit war dieser Fürst als mächtigster aller Schwarzen Magier bekannt. Er wurde von Inquisitor Vorgel getötet. Doch nun wurde er als Untoter wiedererweckt und plant, jeden Sterblichen seinem Willen zu unterwerfen.", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255UN0022", "ID_STRING": "NAME_TXT", "TEXT": "Konrad", "SEQ_NUM": 0},
