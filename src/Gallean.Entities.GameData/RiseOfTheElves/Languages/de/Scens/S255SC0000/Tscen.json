    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loc Peasant Village", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Bauern    \"Wir Bauern gehören nicht mehr zu Eurem Kaiserreich! Wir sind jetzt frei, unter der Herrschaft von Fürst Kyn!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loc Lord Kyn's Manor", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Freibeuter-Knappe    \"Haltet Euch fern! Lasst den erhabenen Fürsten Kyn in Ruhe! Er ist ein Anführer, dem das Wohl seines Volkes wirklich am Herzen liegt!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loc Spearman at wall", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Lanzenträger   \"Die Herrschaft des Kaiserreichs ist vorüber! Fürst Kyn hat Soldaten des Kaiserreichs den Zugang untersagt, bis wir für frei erklärt werden!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loc Spearman Watch", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Lanzenträger    \"Halt! Ich würde Euch nicht raten, weiterzugehen! Die Legionen werden Euch braten!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Loc Spearman Watch", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Lanzenträger    \"Alarmiert die Wachen! Feindliche Truppen im Anmarsch!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Emp Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Nachdem wir den Hochländer Vaglan von unserer Sicht der Dinge überzeugen konnten, haben wir mit den Planungen für unsere Angriffe auf die nördlichen Grenzen der Legion begonnen.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Unter Vaglans Führung platzierten wir vier unserer besten Krieger an den Frontlinien der Schlachtfelder, um die gegnerischen Städte einnehmen zu können.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Jetzt müssen wir nur noch wissen, ob die Legionen die Untoten Horden, die weit im Osten siedeln, um Hilfe bitten werden. Wenn sie es tun, könnte dieser Affront härter ausfallen als geplant.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Und Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Unsere Politik des Abwartens und der Beobachtung beginnt sich auszuzahlen, Meister. Wie es scheint, wären die Legionen bei einem verheerenden Frontalangriff des Kaiserreichs äußerst verwundbar.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Das hat im Hochland ein für uns günstiges Klima der Verwirrung entstehen lassen. Jetzt haben wir die Gelegenheit, beide Gegner zu überraschen, denn zur Zeit sind sie schwach und ihre Kräfte sind weit verteilt.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Wir haben im ganzen Land unsere Spione verteilt, um diese Ereignisse zu untersuchen und den idealen Zeitpunkt zum Losschlagen festzulegen.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Leg Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Vaglans Weigerung, mit uns zusammenzuarbeiten, stürzte das Kaiserreich in eine tiefe Krise. Ein eiligst einberufenes Treffen mit den Höllenfürsten unserer verbündeten Stadt brachte keine greifbaren Ergebnisse.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Daraufhin bildete sich das Bündnis der Unterdämonen. Sie verließen sich nicht auf den Schutz durch die mächtigen Legionen der Verdammten und  trennten sich von uns. Das bringt uns in eine schwache Position.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Wir müssen diese Städte irgendwie zurückerobern und das Bündnis zu Fall bringen, um dem Volk zu beweisen, wer sein wahrer Herr ist!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Loc Thug Territory1", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Schläger    \"Halt! Dieses Territorium gehört uns! Wenn ihr leben wollt, dann kehrt um und gebt Fersengeld.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Loc Thug Territory2", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Schläger    \"Halt! Dieses Territorium gehört uns! Wenn ihr leben wollt, dann kehrt um und gebt Fersengeld.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loc Zombie Tower", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Meister, aus dem Turm dringt ein stechender Gestank - Zombies kriechen über den Boden... Hier muss eine unbekannte Totenbeschwörung stattgefunden haben!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Und Loc Untote Control", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Meister, uns droht die Herrschaft über dieses Land aus den Händen zu gleiten... Viele Nekromanten-Fürsten haben rings um die Stadt ihre eigene Kulte ins Leben gerufen. Diese Leute müssen unsere Macht zu spüren bekommen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Loc Spider Trap", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Das ist ein Falle, Mylord! Die Spinnen haben uns in einen Hinterhalt gelockt!", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Emp Win", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Leg Win", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Emp Capture Dragon Vale", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Dämonen    \"Wir lassen nicht zu, dass menschlicher Abschaum dieses Land regiert! Macht es Euch nur nicht zu bequem...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Feste Indrus", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Und Loc Rogue Zombies", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Diese Zombies werden von irgendeinem wahnsinnigen Anhänger okkulter Bräuche geführt! Wir sollten die Quelle ausfindig machen und sie vernichten!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Disable Rogue Zombies", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loc Dragon Vale", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Vor uns liegt die Stadt Drachental. Man erzählt sich, dass diese Stadt von den Großen Drachen gegründet worden sein soll. Im großen Krieg aber wurde sie von den Legionen zerstört. Seitdem sollen dort die Geister der Drachen hausen.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Allantyr", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Zwerge   \"Glaubt bloß nicht, dass Ihr hier gewinnen könnt! Wir kämpfen bis zum bitteren Ende! Unsere Truppen werden bald zurück sein und uns befreien!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Zwergenstadt", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Zwerge   \"Wir Zwerge sind ein Kriegervolk und haben ein gutes Gedächtnis. Bei Wotan, wir werden unsere Hauptstadt zurückerobern!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Dwarves Attack Dwarf City", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Loc Dwarf Siege", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Zwergensoldaten    \"Verlasst diesen Ort. Wir Zwerge haben einen Belagerungsring um diese Stadt gelegt!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Loc North Dwarf City", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Wache der Zwergenstadt    \"Dieses Land gehört den Zwergen. Ihr seid hier nicht willkommen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Loc East Dwarf City Enter", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Felsriese    \"Dieses Land gehört den Zwergen. Ihr seid hier nicht erwünscht!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Enable Spawn Demon", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Demon", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Und Win", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Leg Capture Troya", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Es ist nun von entscheidender Bedeutung, dass wir diese Stadt weiterhin unter Kontrolle halten. Dann müssen wir nur noch Drachental erobern.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Leg Capture Drachen Vale", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \" Es ist nun von entscheidender Bedeutung, dass wir diese Stadt weiterhin unter Kontrolle halten. Dann müssen wir nur noch Troya erobern.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Kanna", "SEQ_NUM": 0},
