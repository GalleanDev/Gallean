    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0024", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Meister, aus dem Turm dringt ein stechender Gestank - Zombies kriechen über den Boden... Hier muss eine unbekannte Totenbeschwörung stattgefunden haben!\"", "SEQ_NUM": 0},
