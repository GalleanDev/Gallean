    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0000", "ID_STRING": "TXT_DESC", "TEXT": "ich glaube, ich könnte Euch nützlich sein.", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Leg Lesser Demons Allianc", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Meister, eine Gruppe von Abweichlern, es handelt sich wohl um Unterdämonen,  will sich unseren Truppen anschließen. Wenn wir uns mit ihnen in der Nähe von Troya treffen, würde das für unsere Armee eine große Verstärkung bedeuten...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0022", "ID_STRING": "NAME_TXT", "TEXT": "Leg Loc Demons Ally", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0022", "ID_STRING": "POPUP_TXT", "TEXT": "Hazky'la   \"Ja, wir haben nicht die Absicht, Bethrezen zu verärgern! Wir sind loyale Diener Eurer Armee!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Lord Kyns Vorräte", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Wir haben alles, was die Leute brauchen!", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Und Loc Drachen Vale", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0023", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Vor uns liegt die Stadt Drachental. Man erzählt sich, dass diese Stadt von den Großen Drachen gegründet worden sein soll. Im großen Krieg aber wurde sie von den Legionen zerstört. Seitdem sollen dort die Geister der Drachen hausen.\"", "SEQ_NUM": 0},
