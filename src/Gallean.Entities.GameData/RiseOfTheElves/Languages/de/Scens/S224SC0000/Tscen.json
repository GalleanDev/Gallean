    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Yggars Lager", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Die größten Kämpfer des Königreichs haben hier gelernt.", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Sallats Laden", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Wie kann ich Euch helfen?", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Warwicks Laden", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Meine Waren können Euch bei Eurer Aufgabe helfen.", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Othons Turm", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Ich kann Euch helfen, gegen die Invasion der Dämonen zu kämpfen!", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0004", "ID_STRING": "TXT_TITLE", "TEXT": "Furrens Laden", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0004", "ID_STRING": "TXT_DESC", "TEXT": "Ich verkaufe alles... wenn der Preis stimmt.", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutrale", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Keine Völkerbeschreibung", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Winfrid", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Dieser mächtige Fürst stellte sich einst einer ganzen Armee aus der Hölle und besiegte sie fast alleine, indem er das Portal verschloss, aus dem die Höllenbrut strömte. Er wurde dann Herrscher seines Reiches.", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Baldaric", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Der höchste Fürst der Zwergenfürsten, er ist bekannt für seine Kampfkraft und seinen Mut selbst in aussichtslosesten Situationen. Einst kämpfte er sieben Tage und sieben Nächte gegen den mächtigen roten Drachen ARFURUZON, bis er ihn besiegte.", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Emery", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Lantfrid", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0008", "ID_STRING": "NAME_TXT", "TEXT": "Schläger", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0023", "ID_STRING": "NAME_TXT", "TEXT": "Lanzenträger", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Inferno", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Schaut, unsere bloße Anwesenheit scheint zu genügen, um den Boden von dem Bösen zu befreien, das ihn durchdringt! Unser Einfluss vermag dieses entsetzliche Böse zu vertreiben.", "SEQ_NUM": 2},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0001", "ID_STRING": "NAME_TXT", "TEXT": "MC Win", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Der Klan hat die bösartige Krankheit besiegt, die sich in diesem Land so ausgebreitet hat...", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Avgrundskval", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Schaut nur! Unsere bloße Anwesenheit verwandelt den Boden, auf dem wir gehen! Die höllischen Lavakrater schließen sich... Nun glauben auch unsere Truppen wieder an diese Sache!", "SEQ_NUM": 3},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Es regnet Dämonen", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Friedhof", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Die Dämonen haben selbst die heilige Ruhestätte unserer Toten geplündert! Das schreit nach Rache!", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0028", "ID_STRING": "NAME_TXT", "TEXT": "Lanzenträger", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Nekromant", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Nekromant: \"Ha ha ha! Verbeugt Euch vor Eurem neuen Herrn, Ihr unbedeutenden Sterblichen! Unser Drachenfürst kann Euch alle mit einem einzigen Atemzug vernichten! \"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Kaiserreich Bauernwache", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Wir stehen dem Kaiserreich nicht mehr loyal gegenüber. Wir sind unsere eigenen Herren, also haltet Euch fern von unserem Land, Soldaten!", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN002b", "ID_STRING": "NAME_TXT", "TEXT": "Bauer", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Dämonologenzauber", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Unglücklicherweise für Euch Sterbliche ist das nun unser Königreich! Wie könnt Ihr es wagen, dieses Land mit Eurer Anwesenheit zu besudeln!", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN002c", "ID_STRING": "NAME_TXT", "TEXT": "Bauer", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Unheiliges Portal", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Dämonen    \"Der Tod kommt zu allen, die ihn suchen! Und das hier habt Ihr gefunden!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Empire Visit Camp", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Lorn: \"Wartet, bitte! Wir möchten uns Euch anschließen, denn wir wollen nicht mehr der Sache des Drachenfürsten dienen!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000d", "ID_STRING": "NAME_TXT", "TEXT": "MC Visit Dwarf", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Zwerg: \"Endlich seid Ihr gekommen, um den Feldzug gegen den bösartigen Drachenfürsten fortzusetzen! Ich bin zu müde, um weiterzugehen... Nehmt das hier, es wird Euch von großem Nutzen sein...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000e", "ID_STRING": "NAME_TXT", "TEXT": "MC Peasant Wache", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Dämliche Zwerge, bleibt weg von unserem Dorf! Hier dürfen nur Menschen rein!", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Disable MC Peasant Guard", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Klans, wir werden uns zur Wehr setzen!", "SEQ_NUM": 1},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0032", "ID_STRING": "NAME_TXT", "TEXT": "Lanzenträger", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Kaiserreich Sieg", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Wir haben das Böse in diesem Lande besiegt, im Namen des Hohen Vaters!", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Kaiserreich Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "So lange wir denken können, lebten wir in diesem Land friedlich Seite an Seite mit den Bergklans. Bis zu jenem Tag, als sich im Süden der Himmel verdunkelte und eine stickige Hitze aus dem Erdboden empor stieg.", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Wir unternahmen nichts, aus Angst, bis es zu spät war. Nun macht sich blankes Entsetzen breit, unsere Bürger fliehen aus der Hauptstadt und das ganze Land stürzt ins Chaos. Wir müssen die Quelle dieses Unheils finden und sie vernichten!", "SEQ_NUM": 1},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0035", "ID_STRING": "NAME_TXT", "TEXT": "Lanzenträger", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0012", "ID_STRING": "NAME_TXT", "TEXT": "MC Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "So lange wir denken können, lebten wir in diesem Land friedlich Seite an Seite mit dem Kaiserreich. Bis zu jenem Tag, als sich im Süden der Himmel verdunkelte und eine stickige Hitze aus dem Erdboden empor stieg.", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Wir unternahmen nichts, aus Angst, bis es zu spät war. Nun macht sich blankes Entsetzen breit, unsere Bürger fliehen aus der Hauptstadt und das ganze Land stürzt ins Chaos. Wir müssen die Quelle dieses Unheils finden und sie vernichten!", "SEQ_NUM": 1},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Enable Raining Demons", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Dämonen steigen aus dem Boden! Sie müssen aufgehalten werden!", "SEQ_NUM": 2},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0014", "ID_STRING": "NAME_TXT", "TEXT": "MC North Keep West", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Haltet Euch von unserer Stadt fern, Klansgesindel. Eure Art wird hier nicht gern gesehen, hier sind nur Menschen willkommen!", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0015", "ID_STRING": "NAME_TXT", "TEXT": "MC North Keep East", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Haltet Euch von unserer Stadt fern, Klansgesindel. Eure Art wird hier nicht gern gesehen, hier sind nur Menschen willkommen!", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0039", "ID_STRING": "NAME_TXT", "TEXT": "Bauer", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Kaiserreich Nordfeste Osten", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Soldaten des Kaiserreichs, Ihr konntet uns nicht vor den Dämonen schützen, also werden wir uns selbst verteidigen! Und jetzt haltet Euch fern, bevor wir es tun!", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Kaiserreich Nordfeste Westen", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Soldaten des Kaiserreichs, Ihr konntet uns nicht vor den Dämonen schützen, also werden wir uns selbst verteidigen! Und jetzt haltet Euch fern, bevor wir es tun!", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0018", "ID_STRING": "NAME_TXT", "TEXT": "MC Near Unholy Portal", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Mylord! Wir spüren eine mächtige Falle des Bösen! Eine glühende Hitze steigt aus dem Boden...Wir sollten uns mit unseren besten Zaubern wappnen!", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Kaiserreich Nahe Unheiliges Portal", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Mylord! Wir spüren eine mächtige Falle des Bösen! Wir sollten gewappnet sein, hier steigt eine glühende Hitze empor... Möge der Hohe Vater mit uns sein...", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Empire Visit Dwarf", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Seid Ihr gekommen, um den elenden Drachen zu töten? Ich bitte Euch, ich selbst bin schwer verletzt und kann nicht mehr... nehmt das hier und tötet den Drachen...", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Nahe Knappe", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Wir brauchen Eure Hilfe nicht, um mit diesen Bestien fertig zu werden. Bleibt wo Ihr seid, wir sind bis zu den Zähnen bewaffnet!", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Nahe Zombie", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Mylord! Da sind die wilden Dämonen, von denen die Bauern sprachen!", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN003f", "ID_STRING": "NAME_TXT", "TEXT": "Bauer", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Nahe Gespenst", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Mylord! Da sind die wilden Dämonen, von denen die Bauern sprachen!", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0042", "ID_STRING": "NAME_TXT", "TEXT": "Lanzenträger", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Fliehender Bauer", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Hilfe! Hilfe! Mylord, rettet uns! Wir durchquerten das Tal unter uns, doch plötzlich wurden wir von fürchterlichen Dämonen gejagt! Ihr müsst sie töten! Hilfe!", "SEQ_NUM": 2},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Fort Marsch Kaiserreich", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Dorfbewohner    \"Bitte errettet uns vor den Dämonen! Sie haben geschworen, uns dem Drachenfürsten zu opfern!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Fort Marsch MC", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Dorfbewohner   \"Erst überfallen uns die Dämonen, und jetzt die verräterischen Bergklans! Bitte habt doch Erbarmen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0049", "ID_STRING": "NAME_TXT", "TEXT": "Knappe", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN004f", "ID_STRING": "NAME_TXT", "TEXT": "Knappe", "SEQ_NUM": 0},
