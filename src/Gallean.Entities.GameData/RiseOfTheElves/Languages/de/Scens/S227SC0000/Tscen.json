    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Turions Lager", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Braucht Ihr neue Rekruten?", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Ebhons Laden", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Meine Waren können Euch bei Eurer Aufgabe helfen.", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Zoltarss Lager", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Ich bilde Eure Leute aus, wenn der Preis stimmt.", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutrale", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Keine Völkerbeschreibung", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Calderic", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Der höchste Fürst der Zwergenfürsten, er ist bekannt für seine Kampfkraft und seinen Mut selbst in aussichtslosesten Situationen. Einst kämpfte er sieben Tage und sieben Nächte gegen den mächtigen roten Drachen ARFURUZON, bis er ihn besiegte.", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Asumuel", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Jedes Kind erschauert, sobald der berüchtigte Name fällt. Dieser Höllenfürst ist für seinen Blutdurst bekann. Bei einem Bankett, das Brethrezen anlässlich des Sieges über das Königreich des Lichts gab, soll er angeblich 1000 Sklaven gefressen haben.", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Heiric", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Zaorish", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0008", "ID_STRING": "NAME_TXT", "TEXT": "Prinz Daxam", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0016", "ID_STRING": "NAME_TXT", "TEXT": "Spinnenzepter", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0019", "ID_STRING": "NAME_TXT", "TEXT": "Vampir", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN001d", "ID_STRING": "NAME_TXT", "TEXT": "Nekromant", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0022", "ID_STRING": "NAME_TXT", "TEXT": "Wynfeldluchs", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Legionen Winning Condition", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Bestie", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0002", "ID_STRING": "NAME_TXT", "TEXT": "C1", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0003", "ID_STRING": "NAME_TXT", "TEXT": "C2", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Nekromantenangriff", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Aufständischer Phonycianer   \"Die Phonycianer, die Ausgestoßenen von Bythazar, werden über das Königreich herrschen. Von da an wird keiner mehr sicher sein, wenn wir unsere... Botschaft... unter ihren Familien in ihrer Heimat verbreiten!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Clans Heal", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Legionen Heilen", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Mystash Text", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Bürger von Mystash    \"Danke, dass Ihr uns von Wynfeld befreit habt. Prinz Daxam hat seinen Leuten die beste Ausrüstung gekauft.  Mit seinem Reichtum hat er sich eine unsichtbare Waffe gesichert. Niemand weiß, welche, aber wir haben alle Angst...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Verfaulender Damm", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Magier    \"Prinz Daxams Reichtum umfasst das ganze Land und noch mehr. Der Prinz hat von einem Fahrenden Händler einen Weißen Drachen erstanden. Seine Widerstandskraft ist gering, doch seine Atemwaffe ist stärker als die jedes anderen Drachen.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Verfaulender Damm Nachricht Zwei", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Knappe    \"Tod den Legionen! Zu Prinz Daxams Armee gehört nun eine Bestie, die ihresgleichen sucht. Ich werde ein Glas auf Eure Leichen erheben, wenn dieses Untier Euch aus der Welt geschafft hat!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN002d", "ID_STRING": "NAME_TXT", "TEXT": "Ork", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN002e", "ID_STRING": "NAME_TXT", "TEXT": "Ork", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Mc Winning Condition", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0030", "ID_STRING": "NAME_TXT", "TEXT": "Ork", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Legion Geschichte", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Ashkael    \"Das kleine Königreich von Bythazar verfügt über viele Goldvorkommen. Die Gegend wird von Orks und ähnlichen Zeitgenossen bewacht, aber wir müssen Bythazar erobern. Wir werden diesen Daxam lehren, was es heißt, die Legionen zu beleidigen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Bergklan Geschichte", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Wenn wir Daxam umbringen, riskieren wir Ärger mit seinem Volkes. Ja, sie sind sehr unzufrieden mit ihrem Herrscher, aber deshalb akzeptieren sie noch lange keinen neuen. Ist der Prinz ermordet, sollten wir umgehend Bythazar einnehmen.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Elite-Wachsoldat", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Bragon von den Hügeln    \"Mit den hohen Steuern, die er der Bevölkerung von Bythazar abpresst, finanziert Prinz Daxam seine Elitegarde. Die Wächter der Burg sind mit den besten Rüstungen und  Waffen ausgestattet, die es für Gold zu kaufen gibt.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0033", "ID_STRING": "NAME_TXT", "TEXT": "Goblin", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Plünderer-Nachricht", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Ashkael    \"Einer von Prinz Daxams Untertanen wurde beobachtet, wie er mit einem Händler verhandelte, dem Mitglied einer mächtigen Gilde, die als Plünderer bekannt sind. Gerüchten zufolge soll der Prinz um Schutz für sein Schloss nachgesucht haben.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Warnung", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Geist    \"Kehrt um und verlassst diessen Ort. Es ssssei denn, Ihr möchtet nähere Bekanntschaft mit dem Tod machen, so wie ich.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0037", "ID_STRING": "NAME_TXT", "TEXT": "Goblinangriff", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Zombieberserker", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Mystash Text", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Elitesoldat    \"Die Verdammten...hier in unserem Königreich? Wir werden uns Eurer Macht beugen, aber Prinz Daxam wird nicht so schnell klein bei geben. Er wurde mit ein paar Händlern gesehen, die mit dem Obskuren im Bunde sind. \"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Angriff des Schlägers", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN003b", "ID_STRING": "NAME_TXT", "TEXT": "Ork", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Phonycianer", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Phonycianer   \"Das Spinnenzepter... das Spinnenzepter. Es ist schön, tot zu sein. Sucht die Spinne oder das Zepter, und kommt zu uns. Aller Schmerz ist dann Vergangenheit...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Phonycian Nachricht For LD", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Phonycianer   \"Prinz Daxam ist ein Narr, und das Reich seines Vaters wird in Schutt und Asche fallen. Ich kann spüren, dass der König durch die Hand der Untoten Horden fallen wird. Ihr sucht den Schild? Der Vampir wird sich über Gäste sehr freuen.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Legion Nachricht", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Erzteufel    \"Wir haben erfahren, dass es in dieser Gegend eine Statue geben muss, die den Bergklans heilig ist. Nur die Bergklans selbst überstehen ihre Anwesenheit unverletzt. Jeder andere wird von der Kraft dieses Gottes niedergestreckt!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Legion Bestrafung", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Berg Nachricht", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Hügelriese    \"Diese Statue nur für Dämonen. Nur Legionen können Kräfte nutzen. Wenn näherkommen, wir verflucht!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Berg Bestrafung", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Umkehren-Nachricht", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Schläger    \"Nachdem ich Euer Leben vor der Riesenspinne  gerettet habe, denke ich, schuldet Ihr mir eine Kleinigkeit. Und solltet Ihr ausgerechnet heute Euren geizigen Tag haben, dann werft doch einen Blick auf meine scharfen Freunde hier. \"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Stadtwache", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Elite-Lanzenträger   \"Halt! Niemand passiert dieses Tor, die Burg der Phonycier  ist die Heimat der Verräter von Bythazar! So lautet der Befehl von Daxams Vater,  König Virgil.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Riesenspinne II", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Riesenspinne III", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0044", "ID_STRING": "NAME_TXT", "TEXT": "Ork", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0022", "ID_STRING": "NAME_TXT", "TEXT": "Händlerwarnung", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0022", "ID_STRING": "POPUP_TXT", "TEXT": "Bauer    \"Hier lauert überall Gefahr. Es gibt Monster und Drachen, die aus dem Dunkel der Nacht heraus angreifen. Ihr hättet lieber auf die Warnungen hören sollen...!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Orkkönig", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0023", "ID_STRING": "POPUP_TXT", "TEXT": "Ork    \"Ihr habt Neuigkeiten vom Orkkönig? Nein? Dann kommt Ihr bestimmt her, damit wir Euch in kleine Teile zerhacken?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0024", "ID_STRING": "NAME_TXT", "TEXT": "Vampir", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0024", "ID_STRING": "POPUP_TXT", "TEXT": "Vampir    \"Kommt näher... näher..., und Ihr werdet in meinen Augen das Schicksal erkennen, das Ihr Euch wünscht. Kommt näher, und Ihr werdet erfahren, wo der unheilige Artefakt ruht.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0047", "ID_STRING": "NAME_TXT", "TEXT": "Ork", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Vampir Nachricht II", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Vampir    \"Kommt näher... kommt einfach näher, dann erfahrt Ihr das Geheimnis, wie man Prinz Daxam besiegen kann. Kommt her, und Ihr werdet von gro0en Schätzen erfahren... oder habt Ihr etwa Angst?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Verlasst unser Zuhause", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0026", "ID_STRING": "POPUP_TXT", "TEXT": "Phonycia-Zombie    \"Geht, und Ihr könnt weiterleben. Bleibt, und Ihr werdet einer von uns... ein Ausgestoßener von Bythazar - ein  Phonycianer!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Zug eins", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Sire, die Orks und ihre Kumpane sind in unsere Höhlen eingedrungen. Sie versiegeln unsere Durchgänge. Es muss jemanden geben, der sie führt. Mein Instinkt sagt mir, dass es sich hierbei nur um den elenden Prinz Daxam handeln kann...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Ich bin's", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "Aufständischer Phonycianer   \"Prinz Daxam und sein Vater sind Narren! Schon bald werden die Phonycianer die Herren dieses Landes sein, und an diesem Tag werden die Untoten Horden über das Land herfallen und Tod und Vernichtung säen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN004c", "ID_STRING": "NAME_TXT", "TEXT": "Knappe", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Ich bin kein einfacher Bauer!", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0029", "ID_STRING": "POPUP_TXT", "TEXT": "General   \"Ich bin kein Bauer! Ich hoffe, Ihr konntet meine Orks genießen. Sie sind nicht besonders helle, aber leicht zu bestechen. Daxams Wohlstand wird noch für viele Überraschungen sorgen, aber Ihr werdet sie nicht mehr erleben.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Turn One MC", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002a", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Die Orks haben sich einen Weg in unseren Bergstützpunkt gebahnt. Den Orks fehlt es aber an der nötigen Intelligenz für solche Pläne, es muss also jemanden geben, der sie dazu anleitet... Daxam?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Prinzenmörder", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002c", "ID_STRING": "POPUP_TXT", "TEXT": "Elitesoldat    \"Befehl von Prinz Daxam: Alle Staatsfeinde sind sofort zu eliminieren. Und damit... meint er Euch!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN004f", "ID_STRING": "NAME_TXT", "TEXT": "Knappe", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002d", "ID_STRING": "NAME_TXT", "TEXT": "New Event", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Ashkael    \"Der Prinz stellt eine neue Streitmacht zusammen - seine Elitegarde. Diese Soldaten werden mit den besten Rüstungen und feinsten Waffen ausgerüstet, und ich fürchte, er hält noch ein paar andere unangenehme Überraschungen bereit.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002e", "ID_STRING": "NAME_TXT", "TEXT": "Plünderklans", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002e", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Ein Mitglied der königlichen Familie wurde bei einer Gruppe Händler gesehen, die sich 'Die Plünderer'nennen. Diese Plünderer handeln mit allem, Söldner eingeschlossen. Wir können also davon ausgehen, dass der Prinz Verstärkungen erhält.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0052", "ID_STRING": "NAME_TXT", "TEXT": "Bauer", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002f", "ID_STRING": "NAME_TXT", "TEXT": "Phonycian Nachricht", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "Phonycianer   \"Wir Phonycianer werden uns an Daxam und seinen ausländischen Söldnern rächen. Jeder, der sich einmischt, wird mit dem Prinzen zusammen fallen.\"", "SEQ_NUM": 0},
