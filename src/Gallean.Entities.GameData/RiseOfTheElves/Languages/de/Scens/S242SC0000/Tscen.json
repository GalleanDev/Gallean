    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242UN0162", "ID_STRING": "NAME_TXT", "TEXT": "Marileif", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242UN0166", "ID_STRING": "NAME_TXT", "TEXT": "Polarbär", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0000", "ID_STRING": "NAME_TXT", "TEXT": "MC Win", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0002", "ID_STRING": "NAME_TXT", "TEXT": "MC Capture Kwelia", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Arhigos-Klan   \"Unser Klan möchte in Frieden leben, warum lasst Ihr uns nicht in Ruhe? Wir wollen mit Euch nichts zu tun haben!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Emp Capture Kwelia", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Arhigos-Klan   \"Unser Klan ist keine Bedrohung für Euch! Warum seid hierher gekommen und habt uns unser Dorf genommen?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Emp Capture Dimmel", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Vorsicht, Mylord, die Kreaturen greifen Dimmel häufig an.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Confluenza", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Zombie    \"Bastel Royas wird Euch dafür zur Rechenschaft ziehen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Tesley", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Gefangene Barbaren   \"Unsere Vettern im Süden teilen uns mit, dass der Vampir Bastel Royas sich in einer Bergfestung irgendwo im Süden versteckt hält. Ihn solltet Ihr jagen, nicht uns!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Koulouria", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Dorfbewohner   \"Ihr habt uns befreit! Vielleicht kann Euch diese Information helfen: Östlich von hier findet Ihr Sangleton. Dort treibt der schreckliche Vampir Bastel Royas sein Unwesen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loc Bastel Message", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Bastel Royas   \"Seid willkommen! Erlaubt mir, mich vorzustellen: Meine Name ist Bastel Royas, der künftiger Herrscher über ganz Nevendaar. Kehrt um und verbreitet die Neuigkeit bei allen, die dem Hohen Vater dienen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV000e", "ID_STRING": "NAME_TXT", "TEXT": "MC Loc Bastel Nachricht", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Bastel Royas   \"Ha! Ihr seid kein Gegner für den großen Vampir Bastel Royas! Die Zeit ist gekommen, Euch meinen Zorn spüren zu lassen! Sagt Wotan, er sei ein Narr, Eure armselige Armee hierher zu schicken!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Emp Cemetary", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Mylord, wir sollten diesen Ort umgehend verlassen... Die Luft hier ist stickig... Es riecht nach Tod...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Die Toten steigen aus ihren Gräbern!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loc Elven Lands", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"In diesem Gebiet gibt es offenkundig nichts, was für uns von Bedeutung wäre, Mylord. Lasst uns weiter südlich suchen.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Emp Elves Help", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Zentaur   \"Liebe Leute, helft uns Itlha von diesen üblen Kreaturen zu befreien, und wir helfen Euch im Gegenzug bei Eurer Sache!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001a", "ID_STRING": "NAME_TXT", "TEXT": "MC Elves Help", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Zentaur    \"Liebe Leute, helft uns Itlha von diesen üblen Kreaturen zu befreien, und wir helfen Euch im Gegenzug bei Eurer Sache!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Ithla", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Zentaur   \"Habt Dank für Eure Hilfe. Für den großen Gefallen, den Ihr dem Volk der Elfen getan habt, bin ich gerne bereit, Euch zu dienen. Ihr dürft Itlha so lange in Besitz nehmen, bis wir dieses Land endgültig von dieser Plage befreit haben!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Emp Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"In den letzten Monaten wurde das Mondlied-Tal von untoten Kreaturen nahezu überschwemmt. Die Leute dort leben in großer Angst, denn viele ihrer Freunde und Verwandten sind diesen Kreaturen schon zum Opfer gefallen.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Wir müssen den Ausgangspunkt dieser Invasion finden, bevor es zu spät ist!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Loc Squire Attacks", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Zorniger Knappe   \"Ich befehle Euch, diesen Ort sofort zu verlassen. Das hier ist ein Ort der Ruhe für jene, die den Untoten zum Opfer fielen. Wenn Ihr Euch nicht sofort entfernt, sehe ich mich gezwungen, Euch anzugreifen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Emp Capture Canouria", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Mylord, ich würde Euch empfehlen, einen Teil unseres Goldes für die Verteidigung dieser Stadt auszugeben. Die Bürger beklagen sich über zahlreiche Angriffe der untoten Pest.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Enthras", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Dorfbewohner   \"Unsere Verteidigung wurde von den ständigen Angriffen der Untoten völlig aufgerieben!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0020", "ID_STRING": "NAME_TXT", "TEXT": "MC Capture Canouria", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Mylord, ich würde Euch empfehlen, einen Teil unseres Goldes für die Verteidigung dieser Stadt auszugeben. Die Bürger beklagen sich über zahlreiche Angriffe der untoten Pest.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Neffins Laden", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Ich verkaufe alles, was ich besitze.", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0022", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Manris", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0022", "ID_STRING": "POPUP_TXT", "TEXT": "Versklavte Magier   \"Macht diesem Wahnsinn ein Ende und tötet Bastel Royas! Er ist die Ursache allen Übels. Vernichtet ihn, auf das wieder Frieden herrsche in Mondlied.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Renmans Lager", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Wir werden uns Euch anschließen, wenn Ihr einen fairen Preis zahlt.", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Canouria Specter", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Metars' Lager", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Tretet ein, Ihr Feiglinge, ich werde Euch zu Helden machen!", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Ilans Turm", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Ich kenne viele mächtige Zauber.", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Kwelia Zombie", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Dimmel Necromancer", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Confluence Doomdrak", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0006", "ID_STRING": "TXT_TITLE", "TEXT": "Ralars Laden", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0006", "ID_STRING": "TXT_DESC", "TEXT": "Meine Sachen sind die besten im ganzen Land.", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Koularia Lich", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Ithla Skeleton Cham", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Manris Deathdragon", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002b", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Werewolf Berzerk", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Vampire Appears", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002d", "ID_STRING": "NAME_TXT", "TEXT": "Elves Attack MC", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Elfen-Berater   \"Ihr habt es nicht geschafft, dieses Tal von der Bedrohung durch Bastel Royas zu befreien, und uns unsere Stadt zurückzugeben. Wenn das die Art ist, wie die Klans mit uns umzugehen gedenken, dann müsst Ihr die Konsequenzen tragen.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002e", "ID_STRING": "NAME_TXT", "TEXT": "MC Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002e", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"In den letzten Monaten wurde das Mondlied-Tal von untoten Kreaturen nahezu überschwemmt. Die Leute dort leben in großer Angst, denn viele ihrer Freunde und Verwandten sind diesen Kreaturen schon zum Opfer gefallen.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002e", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Wir müssen den Ausgangspunkt dieser Invasion finden, bevor es zu spät ist!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002f", "ID_STRING": "NAME_TXT", "TEXT": "MC Capture Dimmel", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Vorsicht, Mylord, die Kreaturen greifen Dimmel häufig an.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0030", "ID_STRING": "NAME_TXT", "TEXT": "MC Loc Elven Lands", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0030", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"In diesem Gebiet gibt es offenkundig nichts, was für uns von Bedeutung wäre, Mylord. Lasst uns weiter südlich suchen.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0031", "ID_STRING": "NAME_TXT", "TEXT": "Emp Win", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0032", "ID_STRING": "NAME_TXT", "TEXT": "Loc Kendall", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0032", "ID_STRING": "POPUP_TXT", "TEXT": "Magier Kendall   \"Ich bin Kendall, der Wandermagier , und ich bin gekommen, Euch von den großen Vampiren des Südens zu berichten. Es gibt dort nur den Tod - Ihr müsst dort hin gehen und ihn vernichten.\"", "SEQ_NUM": 0},
