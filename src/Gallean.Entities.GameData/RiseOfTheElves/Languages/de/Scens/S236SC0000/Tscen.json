    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Emp Healing Statue", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Emp Win", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Legionen Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Kanzler    \"Neuigkeiten aus den Mittellanden, Meister. Die untreuen Legionen der Entfesselten Dämonen sind auf dem Weg hierher. Den Untoten ist es gelungen, sie aus aus den Mittellanden zu vertreiben und nun suchen sie Schutz auf unserem Territorium.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Sie haben noch gar nicht bemerkt, dass dieses Gebiet jetzt von UNS bewohnt wird. Diesen Irrtum werden sie noch bitter bereuen...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Kanzler    \"Darüber hinaus haben unsere Spione im Nordland Wotans Schriftrolle entdeckt, Meister. Wir müssen einen Kundschafter aussenden, der den Elfen die Rolle abnimmt. Außerdem brauchen wir weitere Spione, um die Rune ausfindig zu machen.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Untote Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Es ist uns gelungen, die entfesselten Dämonen aus unserem Territorium zu verjagen. Sie haben sich Richtung Westen in das Gebiet der Legionen zurückgezogen. Nur die Menschen werden nicht müde, ihre schwächlichen Angriffe fortzusetzen.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Wir sollten außerdem nicht vergessen, dass wir wissen, wer die Korrumpierte Rune besitzt: die Drachen. Wir müssen einen Weg finden, an sie heranzukommen und Wotans Schriftrolle finden. Dann erst sind wir die Herren dieses Landes.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Aragonia", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Aragonia", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Elfen    \"Die Elfen werden niemals zulassen, dass ihr Land derart niedergemetzelt wird, da könnt Ihr sicher sein!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Loc Hermit", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Eremit    \"Bleibt wo ihr seid! Das bekommt Ihr nicht! Ich warne Euch, keinen Schritt näher!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0008", "ID_STRING": "NAME_TXT", "TEXT": "MC Dwarf Mutiny", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Mylord, wie es scheint, weigern sich die Minenarbeiter zu arbeiten! Sie sagen, sie wollten uns nicht länger dienen. Wir müssen diese Ungläubigen zur Raison bringen. Disziplin ist die einzige Sprache, die sie verstehen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0009", "ID_STRING": "NAME_TXT", "TEXT": "MC Statue Healing", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Loc East Dragon", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Drachen   \"Geht nun und behaltet Euer Leben, aber denkt daran: Das hier ist das Reich der Drachen. Hier werden alle Eindringlinge bei lebendigem Leibe aufgefressen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Loc West Dragon", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Drachen    \"Bleibt, wo Ihr seid, Eindringlinge, wenn Euch Euer Leben lieb ist. Das hier sind die Gebiete der Drachen und wir akzeptieren keine Außenseiter!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Diebeshalle", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Diebe    \"Ihr mögt vielleicht glauben, Ihr könntet uns aufhalten, aber unsere Leute sind überall... Und wenn Ihr es am wenigsten erwartet...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Burnt", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Meisterdieb    \"Das wird nicht unser letztes Zusammentreffen gewesen sein! Die Diebe unserer Gilde werden bis an Euer blutiges Ende gegen Euch kämpfen...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Beschafft die Rune", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Endlich haben wir die Korrumpierte Rune. Jetzt brauchen wir nur noch die sagenumwobene Schriftrolle!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Beschafft die Schriftrolle", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Die Schriftrolle gehört uns! Jetzt müssen wir die Rune suchen.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loc Orc", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Eine Bande von Orks muss unmittelbar vor uns ihr Lager aufgeschlagen haben, Mylord. Wir sollten vorsichtig sein, diese Orks können recht aggressiv sein.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loot Crumbled Tower", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Die Diebe haben eine Karte hinterlassen, Mylord... Offenkundig gibt es im Süden noch weitere Diebeslager.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Timoria", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Glaubenskrieger    \"Ungläubige... Wenn die Drachen die Rune entfesseln, werdet auch Ihr nicht verschont!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Loc Cultists", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Diese wahnsinnigen Kultisten brennen unsere Städte nieder... Wir müssen sie ausschalten. Sofort.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Loot Ruined Prison Turm", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"In diesem Turm wurden die Ketzer und die Geisteskranken gefangen gehalten... Auf der Mauer finden sich seltsame Zeichnungen von Runensteinen, in Blut gemalt...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Khu'brah", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Urzeitriese    \"Arghhh!!! Warum kommt Ihr her??? Wir Euch fressen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Loc Elves", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"In dem Gebiet wurden Elfen gesichtet. Es besteht kein Zweifel, dass sie jeden einzelnen Schritt unserer Seite genau beobachten.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Loc Defenders of Faith", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Glaubenskrieger    \"Halt, Ungläubige! Ergebt Euch, dann wollen wir Euch den wahren Pfad zeigen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Loc Primitive Giant", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Urzeitriese    \"Arrrgh!, kommt her, Ihr jetzt Riesenfutter!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Loc Treuloser", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Treuloser    \"Ich bin weit umhergereist und habe versucht, meinen Glauben wiederzufinden, doch vergebens. Nun bin ich nur noch auf der Suche nach Nahrung und Unterkunft. Gestattet mir, Euch zu dienen, und Ihr werdet Eure Entscheidung nicht bereuen....\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Emp Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"In den angrenzenden Gebieten leben viele Menschen, die nicht an den Hohen Vater glauben, Mylord. Sie haben sich mit den örtlichen Schlägern zusammen getan, um uns zu überfallen.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Ein gefangener Mensch hat uns unter der Folter verraten, dass die gesuchte Rune tatsächlich tief im Nordosten bei den Elfen zu finden sein könnte. Wir sollten auf der Stelle eine Armee zusammenstellen, um sie aufzuspüren.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001d", "ID_STRING": "NAME_TXT", "TEXT": "MC Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Mylord, die Eremiten der angrenzenden Gebiete haben sich mit den Riesen des Nordens zusammen getan und planen nun eine Offensive auf unsere Territorien. Wir sollten uns umgehend darum kümmern!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Einige unserer Händler berichten von dem Gerücht, dass sich die Rune, nach der wir suchen, im Besitz der mächtigen Drachen befinden soll. Sir, ich fürchte, dass wir sie uns mit Gewalt holen müssen...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Untote Win", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001f", "ID_STRING": "NAME_TXT", "TEXT": "MC Win", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Legionen Win", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Draco-Ausbildungslager", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Jeder berühmte Drachenkrieger ist hier ausgebildet worden!", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Chrulens Laden", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Ich glaube, wir können ein Abkommen treffen...", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Leifs Magieladen", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Wenn Ihr Schutzmagie braucht, seid Ihr an der richtigen Adresse.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Thurins Laden", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Meine Sachen sind die besten im ganzen Land.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0004", "ID_STRING": "TXT_TITLE", "TEXT": "Dennars Lager", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0004", "ID_STRING": "TXT_DESC", "TEXT": "Wir werden uns Euch anschließen, wenn Ihr einen fairen Preis zahlt.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0005", "ID_STRING": "TXT_TITLE", "TEXT": "Thurins Laden", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0005", "ID_STRING": "TXT_DESC", "TEXT": "Wie kann ich Euch helfen?", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0006", "ID_STRING": "TXT_TITLE", "TEXT": "Leias Zuflucht", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0006", "ID_STRING": "TXT_DESC", "TEXT": "Ich habe mich auf Beschwörungen spezialisiert.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0007", "ID_STRING": "TXT_TITLE", "TEXT": "Furrens Laden", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0007", "ID_STRING": "TXT_DESC", "TEXT": "Werft ruhig einen Blick auf meine Waren, bestimmt ist es etwas für Euch dabei.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0008", "ID_STRING": "TXT_TITLE", "TEXT": "Laetes Taverne", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0008", "ID_STRING": "TXT_DESC", "TEXT": "Ale und sonstige Waren des täglichen Bedarfs zu vernünftigen Preisen.", "SEQ_NUM": 0},
