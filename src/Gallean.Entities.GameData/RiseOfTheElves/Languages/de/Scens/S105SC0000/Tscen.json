      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0000",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Ritual Warning",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0000",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Sorcerer\r\u0022Master! Strange occult forces are at work here... A ritual is pulling demons forth to attack us! We must close that infernal gate...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0024",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Meerjungfrau",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0001",
      "ID_STRING": "NAME_TXT",
      "TEXT": "T 1 Drama",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ratgeber\n\u0022Unsere Sp\u00E4her haben das Land nach Untoten durchk\u00E4mmt. Keine ihrer Streitkr\u00E4fte wurden gefunden.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Bethrezen\n\u0022Dass es in diesem Land keine Untoten gibt, ist offensichtlich ...\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ratgeber\n\u0022Was meinst du damit, Meister Bethrezen? Sind wir denn nicht zu diesem Ort gekommen, um ihnen aufzulauern!?\u0022",
      "SEQ_NUM": 2
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Uther\n\u0022Ich bin nicht Bethrezen.\u0022",
      "SEQ_NUM": 3
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ratgeber\n\u0022Nicht Bethrezen!? Aber Ihr habt Euch verhalten wie Bethrezen.\u0022",
      "SEQ_NUM": 4
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Uther\n\u0022Ihr werdet noch fr\u00FCh genug verstehen. Asteroth! Zertrete diese D\u00E4monen aus den niederen Ebenen. Wir brauchen sie jetzt ja wohl nicht mehr oder?!\u0022",
      "SEQ_NUM": 5
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0002",
      "ID_STRING": "NAME_TXT",
      "TEXT": "T 1-2 Drama",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0002",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Asteroth\n\u0022Jawohl, wir werden gemeinsam herrschen! Sie werden uns nicht besiegen k\u00F6nnen!\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0002",
      "ID_STRING": "OBJECT_TXT",
      "TEXT": "Vernichtet den D\u00E4monenf\u00FCrsten Asteroth",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0027",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Meerjungfrau",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0004",
      "ID_STRING": "NAME_TXT",
      "TEXT": "T 1-3 Drama",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Teufel der Tiefe \n\u0022Dienerd\u00E4monen. Ihr werdet nicht gebraucht!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Teufel der Tiefe\n\u0022Wir stehen hinter unserem wahren Herrn Bethrezen! Euer Verrat wird Euch teuer zu stehen kommen!\u0022",
      "SEQ_NUM": 4
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0006",
      "ID_STRING": "NAME_TXT",
      "TEXT": "City Gromdam Text",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0006",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Scharfsch\u00FCtze\n\u0022Wisst Ihr denn nicht, wenn Ihr verloren habt, D\u00E4monen? Uther wird herrschen, und Ihr werdet nichts dagegen unternehmen k\u00F6nnen!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0007",
      "ID_STRING": "NAME_TXT",
      "TEXT": "City Rottudam Text",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0007",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ritter\n\u0022Bleibt wo Ihr seid, D\u00E4monen! Wir erwarten unseren Retter Uther. Wenn er kommt, werden wir euch Eure Angriffe zur\u00FCckzahlen!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN002a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Onyx Gargoyle",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0008",
