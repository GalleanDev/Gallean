    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN002e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Onyx Gargoyle",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000b",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Zerst\u00F6rt Kultisten",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000b",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Pandemoneus \n\u0022Wir haben den Beschw\u00F6rungskreis zerst\u00F6rt, Meister. Es wird keine weiteren D\u00E4monen mehr geben.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000c",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Zerst\u00F6rt D\u00F6monologen",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000c",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Pandemoneus \n\u0022Wir haben den Beschw\u00F6rungskreis zerst\u00F6rt, Meister. Es wird keine weiteren D\u00E4monen mehr geben.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000d",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Water Warning",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000d",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ratgeber \n\u0022Seid auf der Hut, Herr. Das Meer hier wird von Seehexen \u00FCberwacht. Sie lauern jedem auf, der ihr Reich betritt.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Asteroth T2",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000f",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Situationszone",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000f",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Herzog \n\u0022Das Imperium dient jetzt Asteroth! Sie haben irgendein B\u00FCndnis ausgehandelt! Es scheint, Uther hat das Imperium verhext. Hubert de Lalye steckt vermutlich dahinter.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0032",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Kultist",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0010",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Asteroth Near",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0010",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Asteroth \n\u0022ein weiterer Fehler, Sterblicher...Ich werde dich eigenh\u00E4ndig zerst\u00F6ren! Bethrezens Herrschaft ist vorbei...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0034",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Kultist",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0011",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Onyx Move T15",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0012",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Aufgabe erfolgreich beenden",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0012",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Asteroth \n\u0022Ghhhooarrr! Ihr k\u00F6nnt euch gl\u00FCcklich sch\u00E4tzen, D\u00E4monen, dass ihr meinem Zorn entgeht! Aber ich kann nicht zerst\u00F6rt werden...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0012",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "D\u00E4monologe \n\u0022Asteroth ist in einem Feuer verschwunden! Er ist geflohen! Aber wir haben gesiegt.\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0036",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Oger",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0014",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Asteroth T40",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0014",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Asteroth \n\u0022Feiglinge! Ich werde euch eigenh\u00E4ndig zerst\u00F6ren ... Ihr werdet euren Verrat b\u00FC\u00DFen!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0015",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Ork-Aufgabe",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0015",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ork\n\u0022Hei\u00DFhaut. Wir bitten Hilfe. Orkbruder weg. Ihr helfen?\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0015",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Herzog \n\u0022Was ben\u00F6tigt Ihr?\u0022",
      "SEQ_NUM": 2
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0015",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ork\n\u0022Bringt Ork hier. Wir geben etwas f\u00FCr Euch.\u0022",
      "SEQ_NUM": 4
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0039",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Kaiserlicher Assassine",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0016",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Ork-Belohnung",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0016",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ork\n\u0022GHOOOOAAR! Ork.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0016",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ork\n\u0022Bruder zur\u00FCck. Wir geben Euch Hilfe. Sucht in gro\u00DFer Stadt nach Schatz.\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0016",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ork\n\u0022Wr Hei\u00DFh\u00E4ute m\u00F6gen Wir Euch helfen.\u0022",
      "SEQ_NUM": 4
    },
