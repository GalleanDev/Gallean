    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO000f", "ID_STRING": "NAME_TXT", "TEXT": "Zimraans Turm", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO0010", "ID_STRING": "NAME_TXT", "TEXT": "Drega Zul Hide", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO0011", "ID_STRING": "NAME_TXT", "TEXT": "Krake Warnung", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Truppenausbildung", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Kommt nur herein, ich mache aus Euren gebrechlichen Soldaten tapfere Kämpfer.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Kekkut Schmied", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Hier findet Ihr alle Waren für das Kriegerhandwerk.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Markt von Rivend", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Wir haben alle möglichen Sachen hier!", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Zimraans Turm", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Ich habe viel infernalische Magie.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutrale", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Keine Völkerbeschreibung", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Breasal", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Dieser mächtige Fürst stellte sich einst einer ganzen Armee aus der Hölle und besiegte sie fast alleine, indem er das Portal verschloss, aus dem die Höllenbrut strömte. Er wurde dann Herrscher seines Reiches.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Uallgarg", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Zu seiner Zeit war dieser Fürst als mächtigster aller Schwarzen Magier bekannt. Er wurde von Inquisitor Vorgel getötet. Doch nun wurde er als Untoter wiedererweckt und plant, jeden Sterblichen seinem Willen zu unterwerfen.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Cathal", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Conall", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN000d", "ID_STRING": "NAME_TXT", "TEXT": "Zwerg", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0019", "ID_STRING": "NAME_TXT", "TEXT": "Polarbär", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Emp Kraken Appears", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul    \"Mylord! Wir haben ein Monster aus der Tiefe geweckt! Wir müssen fliehen!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Fendhil", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Dorfbewohner    \"Der Name Krath'du... er weckt schreckliche Erinnerungen an Schmerz und Leiden!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Rivend Kaiserreich", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Dorfbewohner    \"Wir kennen den Namen Krath'du. Man erzählt sich, in den Jahren des Terrors habe er während der Plünderung eines Dorfes Mitleid für eine junge Braut empfunden...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Sie war schön und sie war schwanger. Er umhüllte sie mit dem Mantel des Todes! Doch der Körper des Mädchens, der spürte, wie das ungeborene Kind der Invasion des Vampirs widerstand, ließ sich nicht bekehren... und so erlosch die junge Braut.", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul    \"Diese Geschichte! Das klingt... alles so vertraut... \"", "SEQ_NUM": 2},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Kekkut", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Dorfbewohner    \"Ihr werdet für Euren Überfall auf diesen Klan büßen! Mögen die Dämonen, die Ihr sucht, Euch verschlingen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0028", "ID_STRING": "NAME_TXT", "TEXT": "Schläger", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Kalajit", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Dorfbewohner    \"Die Klans werden Euch für Eure Untaten bei lebendigem Leibe häuten! Keine Suche nach irgendwelchen Dämonen kann eine solche Verwüstung rechtfertigen... dafür werdet Ihr teuer bezahlen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Approaching Rivend Empire", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul    \"Wir nähern uns der Stadt Rivend, Mylord. Sie war stark befestigt und konnte den Angriffen der Untoten jahrelang widerstehen. Es wird nicht einfach werden, diese Stadt zu erobern, denn ihre Bewohner sind an den Krieg gewöhnt!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Approaching Undead Empire", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul    \"Das ist der Eingang zum Territorium der Untoten. Seid vorsichtig! Die Kreaturen der Nacht sind äußerst gefährlich...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Loot Lookout Turm Kaiserreich", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Am Turm steht eine Inschrift, doch sie ist nur noch teilweise zu entziffern... Dort steht:    'Und als der Nosferatu Krath'du ein Auge auf die Dame geworfen hatte, sagte der Nosferatu zu ihr: Seid mein.'     Was mögen diese Zeilen bedeuten, Mylord?", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Loot Abandoned Shelter Em", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul    \"Ein Bär hat hier vor kurzem Unterschlupf gefunden, dennoch ist die Anwesenheit des Todes hier nahezu überwältigend. Schädel säumen die Rückwand. Kein Zweifel, dass hier ein Vampir gehaust hat!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Loot Alchemists Lab Empi", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul    \"Es gibt keinen Beweis, dass Krath'du mit den Zwergen zu tun hatte, Mylord... Gefunden hat man lediglich die üblichen magischen Werkzeuge der Klans.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Loot Ruined Castle Emp 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Krath'du    \"Ich habe schon so lange auf Euch gewartet, Drega Zul...  Wir gehören zusammen, versteht Ihr? Es ist unsere Bestimmung, dieses Land gemeinsam zu beherrschen!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Untote-Nachricht", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Das Kaiserreich hat Krath'du ausfindig gemacht, Meister... Wir müssen ihn umgehend gefangen nehmen, bevor er den geschwächten Truppen des Kaiserreichs womöglich durch die Lappen geht!", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Day After Loot Empire", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Sir Geldwin    \"Wir wissen, dass Ihr einen wertvollen Anführer verloren habt! Wir sind hier, um Eure Verluste zu ersetzen, Mylord.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Untote Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Meister! Der wahnsinnige Nosferatu Krath'du ist geflohen! Er verließ die Stadt am helllichten Tag mit einigen loyalen Truppen... Seine Diener sagen, er sei auf der Suche nach seinem einzigen wahren Freund, den er selbst einst schuf - Drega Zul!", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Vor vielen Jahren versuchte er, die Mutter dieser Kreatur zu bekehren, als diese ihr Kind austrug. Daraufhin verwandelte sich das ungeborene sterbliche Fleisch in ein Monster. Wir müssen ihn aufhalten, bevor er die Finstere Gabe weiter verbreiten kann!", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Kaiserreich Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul    \"Mylord, ich habe mit Euch geübt und bin Euch seit Jahren treu ergeben. Doch nun ist für mich die Zeit gekommen, den Tod meines Vaters zu rächen...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Er wurde vor vielen Jahren auf grausame Weise umgebracht - vom gleichen Nosferatu, der mich zu der Verirrung machte, die ich heute bin... Ich muss seinem Tod einen Sinn geben! Ich flehe Euch an, helft mir bei der Suche nach dem Dämon!", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Sie hat Recht, Mylord. Wir sollten unseren Krieg gegen die Untoten ausweiten. Sie haben zahllose Gräueltaten an unserer Bevölkerung begangen - jetzt sollen sie unseren Zorn spüren!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Wachturm Imperium", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Freibeuter-Knappe    \"Dieser Turm ist Sperrgrbiet für kaiserliche Soldaten!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Wachturm Untote", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Freibeuter-Knappe   \"Alarm! Zu den Waffen! Die Untoten greifen an!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Approaching Rivend Undead", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Lanzenträger-Wachen    \"Alarm! Alarm! Untote im Anmarsch! Alarmiert die Magier!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0036", "ID_STRING": "NAME_TXT", "TEXT": "Speerträger von Rivend", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Clans Pass", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Felsriese    \"Das hier ist das Gebiet der Klans. Kehrt um, oder Ihr werdet die Folgen zu spüren bekommen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN003a", "ID_STRING": "NAME_TXT", "TEXT": "Freibeuter-Knappe", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Approaching Fendhil Emp.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Freibeuter-Knappe    \"Haltet Euch von unserer Stadt fern, Soldaten des Kaiserreichs! Unser Volk lebt in Freiheit und will Eure Tyrannei nicht!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Approaching Fendhil Undea", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Freibeuter-Knappe    \"Redet Euch bloß nicht ein, dass Ihr die Bewohner dieser Stadt besiegen könntet! Sterbt, Ihr untotes Gesocks!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN003c", "ID_STRING": "NAME_TXT", "TEXT": "Lanzenträger", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Heilige Erde des Eremiten", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Eremit    \"Wer unreinen Herzens ist, darf den geweihten Ort der Ruhe nicht betreten! Das bleibt allein Wotans auserwählten Kriegern vorbehalten... Ich werde die heilige Erde von Eurer Anwesenheit säubern!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Knappe greift Untote an", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Freibeuter-Knappe    \"Mögen die Mächte des Lichtes Euch vernichten, Ihr dreckigen Untoten!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN003e", "ID_STRING": "NAME_TXT", "TEXT": "Meisterdieb", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Wolfbiest Warnung", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Mylord, die Einheimischen hier glauben an die Existenz einer wolfsähnlichen Bestie, die in dieser Gegend ihr Unwesen treiben soll.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Kaiserreich Tag 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Unser Spion bei den Untoten hat uns mitteilen lassen, dass ein gewisser Fürst Krath'du unlängst verschwunden ist... Das könnte der brutale Schlächter sein, den wir suchen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Kaiserreich Sieg", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0041", "ID_STRING": "NAME_TXT", "TEXT": "Freibeuter-Knappe", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Loot Abandoned Shelter Un", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Krath'du war hier! Die Schädel seiner Opfer säumen die Wände. Doch leider gibt es keinen Hinweis, wohin er gegangen sein könnte...", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Loot Alchemists Lab Unde", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Nichts da, Meister. Nur ein paar einfache magische Güter von Zwergen.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Loot Ruined Castle Und 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Krath'du    \"Glaubt nicht, Eure altertümlichen Tricks könnten Euch retten, Soldaten der Zwischenwelt! Mit meiner Geliebten Drega Zul werde ich eine neue, überlegene Rasse erschaffen. Ich erwarte sie, und sobald sie kommt, werdet Ihr alle untergehen!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0044", "ID_STRING": "NAME_TXT", "TEXT": "Freibeuter-Knappe", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Kaiserreich Nachricht", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Die untoten Armeen haben Krath'du entdeckt! Lasst uns angreifen!", "SEQ_NUM": 0}
  ]
}
