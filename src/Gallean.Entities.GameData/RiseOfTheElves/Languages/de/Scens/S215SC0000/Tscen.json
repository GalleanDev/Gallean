{
  "formatVersion": 1,
  "rows": [
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Loot Ruined Castle Emp 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Transformierter Drega Zul    \"Jetzt verstehe ich , mein Krath'du... Es ist unser Schicksal, zusammen zu sein.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Mylord! Der teuflische Krath'du hat all dies von Anfang an geplant - uns in die Falle zu locken und Drega Zul zu verzaubern! Auch wenn wir geschwächt sind, wir dürfen nicht aufgeben... Wir müssen den Zauber brechen!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Verzweifelt nicht, ich habe schon um Verstärkung gebeten, Mylord.", "SEQ_NUM": 2},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0049", "ID_STRING": "NAME_TXT", "TEXT": "Meisterdieb", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Rivend-Wachen1 angreifen", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0026", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul    \"Nun, da wir den ersten Schlag geführt haben, werden die Menschen wahrscheinlich Vergeltung üben... Wir sollten dieses Gebiet verlassen, wenn wir noch nicht für einen Krieg gerüstet sind!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Rivend-Wachen2 angreifen", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul    \"Nun, da wir den ersten Schlag geführt haben, werden die Menschen wahrscheinlich Vergeltung üben... Wir sollten dieses Gebiet verlassen, wenn wir noch nicht für einen Krieg gerüstet sind!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Rivend Untote", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "Diese Menschen wissen von Krath'dus Taten... Möglicherweise hat er mehr Unschuldige auf dem Gewissen als angenommen! Wir sollten unsere Bemühungen weiter verfolgen.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Fendhil Undead", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0029", "ID_STRING": "POPUP_TXT", "TEXT": "Meister, diese Dorfbewohner wissen nichts über Krath'dus neueste Untaten... Er ist schon seit vielen Jahren hier nicht mehr gesehen worden.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN004c", "ID_STRING": "NAME_TXT", "TEXT": "Lanzenträger", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Untote verlieren", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002a", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber   \"Krath'du lebt immer noch und wird nicht eher ruhen, bis er Drega Zul endlich zur Strecke gebracht hat. Er wird die Organisation innerhalb der Untoten Horden zerschmettern, um sich zu rächen! Wir müssen uns nun selbst schützen...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002b", "ID_STRING": "NAME_TXT", "TEXT": "Drega Zul Capture Fendhil", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN004f", "ID_STRING": "NAME_TXT", "TEXT": "Wolf", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Untote Win2", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002c", "ID_STRING": "POPUP_TXT", "TEXT": "Dieser irre Krath'du ist endlich tot... Unser heiliges Blut wird nicht länger vergossen werden...", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0050", "ID_STRING": "NAME_TXT", "TEXT": "Wolf", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002f", "ID_STRING": "NAME_TXT", "TEXT": "Drega nähert sich Krath'du", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "Krath'du    \"Ich habe schon so lange auf Euch gewartet, Drega Zul...  Wir gehören zusammen, versteht Ihr? Es ist unsere Bestimmung, dieses Land gemeinsam zu beherrschen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul    \"Nun verstehe ich, mein lieber Krath'du... es ist unser Schicksal, zusammen zu sein.\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "Mylord! Der teuflische Krath'du hat all dies von Anfang an geplant - uns in die Falle zu locken und Drega Zul zu verzaubern! Auch wenn wir geschwächt sind, wir dürfen nicht aufgeben... Wir müssen den Zauber brechen, mit dem er sie belegt hat!", "SEQ_NUM": 5},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0030", "ID_STRING": "NAME_TXT", "TEXT": "Loot Castle Disable Undea", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0031", "ID_STRING": "NAME_TXT", "TEXT": "Und Krake Appears", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0031", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeberl    \"Meister! Wir haben ein Monster aus der Tiefe geweckt! Wir müssen fliehen!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0032", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loc Krath'du Hint", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0032", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul    \"Dieses Gebiet ist von einer finsteren Macht heimgesucht worden, Mylord... Könnte Krath'du in der Nähe sein?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0033", "ID_STRING": "NAME_TXT", "TEXT": "Und Loc Krath'du", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0033", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber   \"Dieses Gebiet wurde von untoten Truppen heimgesucht, Meister... Krath'du muss in der Nähe sein.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0058", "ID_STRING": "NAME_TXT", "TEXT": "Eremit", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0035", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loc Kraken Warning", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0035", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul    \"Nehmt die Warnung ernst, Mylord: In diesem Gebiet wurden Kraken gesichtet. Wir sollten umkehren!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0059", "ID_STRING": "NAME_TXT", "TEXT": "Zwerg", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0036", "ID_STRING": "NAME_TXT", "TEXT": "Und Loc Krake Warnung", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0036", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Achtet auf diese Warnung, Meister: In dem Gebiet wurden Kraken gesichtet. Wir sollten umkehren!\"", "SEQ_NUM": 0},
