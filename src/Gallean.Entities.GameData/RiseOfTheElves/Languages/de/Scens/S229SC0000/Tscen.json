    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229UN002b", "ID_STRING": "NAME_TXT", "TEXT": "Krnak  der Starke", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0008", "ID_STRING": "NAME_TXT", "TEXT": "MC Loc Eidechsen Warning1", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Wir betreten gefährliches Territorium, Mylord! Mit den Echsenmenschen ist nicht zu spaßen...Vielleicht sollten wir besser umkehren?", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0009", "ID_STRING": "NAME_TXT", "TEXT": "MC Loc Eidechsen Warning2", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Wir betreten gefährliches Territorium, Mylord! Die Echsenmenschen sind schädliche Wesen. Vielleicht sollten wir besser umkehren?", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Hg'nufy", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Sumpfbewohner    \"Warum Ihr uns angreifen? Wir friedliche Leutes bevor Ihr kommen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Loc Pass 1 Warnung", "SEQ_NUM": 0},
