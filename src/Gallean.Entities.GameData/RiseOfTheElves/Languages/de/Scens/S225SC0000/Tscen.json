    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Yuggins Turm", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Meine Zauber können Euch bei Eurer Aufgabe helfen.", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Tralars Laden", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Ich verkaufe alles, was ich besitze.", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Righons Lager", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Meine Soldaten sind die besten in dieser Gegend.", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0004", "ID_STRING": "TXT_TITLE", "TEXT": "Gruntworts Waren", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0004", "ID_STRING": "TXT_DESC", "TEXT": "Ich verkaufe an jeden... wenn der Preis stimmt.", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutrale", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Keine Völkerbeschreibung", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Calderic", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Der höchste Fürst der Zwergenfürsten, er ist bekannt für seine Kampfkraft und seinen Mut selbst in aussichtslosesten Situationen. Einst kämpfte er sieben Tage und sieben Nächte gegen den mächtigen roten Drachen ARFURUZON, bis er ihn besiegte.", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Gunther", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Dieser mächtige Fürst stellte sich einst einer ganzen Armee aus der Hölle und besiegte sie fast alleine, indem er das Portal verschloss, aus dem die Höllenbrut strömte. Er wurde dann Herrscher seines Reiches.", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Jagare", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN0017", "ID_STRING": "NAME_TXT", "TEXT": "Thalrisa", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN001a", "ID_STRING": "NAME_TXT", "TEXT": "Goblin", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN0021", "ID_STRING": "NAME_TXT", "TEXT": "Goblin", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN0024", "ID_STRING": "NAME_TXT", "TEXT": "Oger", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0001", "ID_STRING": "NAME_TXT", "TEXT": "MC Kill Thalrisa", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Wie es aussieht, wird der Eingang zu diesem versteckten Tal von diesem Geist der Thalrisa bewacht. Ich wage mir nicht vorzustellen, welche Schrecken in seinem Inneren warten mögen...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Loc Ork Warnung", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Ork-Champion    \"Niemand darf diesen bösen Boden besitzen. Magie ist schlecht!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN0026", "ID_STRING": "NAME_TXT", "TEXT": "Ork", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0003", "ID_STRING": "NAME_TXT", "TEXT": "MC Cap Runia", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Endlich haben wir Runia erobert. Es war ein wichtiger Außenposten der Grünhäute... Wir sollten dennoch vorsichtig sein, sie könnten zurückschlagen\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0006", "ID_STRING": "NAME_TXT", "TEXT": "MC Thalrisa Geschichte", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Thalrisa    \"Ich habe lange gewartet, um meinen Feinden  gegenüberzustehen... jetzt werde ich mich Eurer entledigen, so wie Ihr versuchtet, Euch meiner zu entledigen... Auch wenn meine  Wächter dahin geschmolzen sind, ich werde meine Rache bekommen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN002a", "ID_STRING": "NAME_TXT", "TEXT": "Oger", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0008", "ID_STRING": "NAME_TXT", "TEXT": "MC Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Wir wurden vom Hohen König beauftragt, dieses Tal zu besiedeln, um die dort lagernden großen Mana-Vorkommen auszubeuten.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Unglücklicherweise haben die magiefürchtenden Grünhäute unsere Pläne entdeckt. Jetzt sind sie fest entschlossen, uns aus dem Tal zu verjagen. Auf der anderen Seite beansprucht das Kaiserreich dieses Tal für sich.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Sie haben einen Belagerungsring um unser Tal gezogen, um uns zur Aufgabe zu bewegen. Wenn wir die Belagerung durchbrechen wollen, müssen wir einen Boten zum Taleingang im Südosten schicken und die angrenzenden Klans um Hilfe bitten.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN002d", "ID_STRING": "NAME_TXT", "TEXT": "Goblin", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Loc Ork Trap", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000b", "ID_STRING": "NAME_TXT", "TEXT": "MC Ork Meeting", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Ork-Champion    \"Grr! Ihr werdet hier nicht lange überleben, Zwerge! Es war ein fehler von Euch, herzukommen, wir hatten Euch gewarnt. Nun werdet Ihr nie wieder lebend von hier fortgehen!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000c", "ID_STRING": "NAME_TXT", "TEXT": "MC Runia Eingang", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Ork-Wache    \"Ihr dringt in dieses Tal ein und denkt jetzt, Ihr könntet unsere Dörfer erobern? Ihr Zwerge seid verrückter, als wir dachten!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Spawn1", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Enable Spawn 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Spawn2", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Loc Thalrisas magic", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Ork    \"Ihr wollt Thalrisas Magie, aber wir werden sie Euch niemals überlassen. Ihr werdet die Grünhäute nicht verletzen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0011", "ID_STRING": "NAME_TXT", "TEXT": "MC Loot Abandoned Farm", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Das Gebäude ist sehr alt, Mylord! Offenkundig lebten die Grünhäute seit langer Zeit hier in diesem Tal. Aber warum? Die Magie?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Tal der Schrecken betreten", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Thalrisas Diener leben noch! Sie werden sich rächen wollen!", "SEQ_NUM": 2},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0013", "ID_STRING": "NAME_TXT", "TEXT": "MC Loot Thalrisas Tempel", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Wir haben Thalrisas Fluch gebrochen. Sie ist zurück ins Höllenreich, wo sie hergekommen ist. Jetzt können wir das Mana ernten, ohne von ihr behindert zu werden.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Emp Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Die Kundschafter des Kaiserreichs berichteten über Bewegungen der Bergklans in diesem Tal. Als wir den Grund für die Präsenz der Bergklans in dieser Region herausgefunden hatten, erkannten wir, dass das Kaiserreich einschreiten musste.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Die Klans werden mit Sicherheit versuchen, Hilfe zu holen. Deshalb haben wir einen Belagerungsring um den Eingang zum Tal gelegt. Ohne Verstärkung ist es nur eine Frage der Zeit, bis sie zur Aufgabe gezwungen sind.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Sir Glorcliff, ein erfahrener Krieger , wird den Angriff auf ihre Hauptstadt anführen. Wir dürfen keine Zeit mehr verlieren.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Emp Runia Entrance", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Ork    \"Ihr dringt in dieses Tal ein und denkt jetzt, Ihr könntet unsere Dörfer erobern? Ihr Menschen seid verrückter, als wir dachten!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0016", "ID_STRING": "NAME_TXT", "TEXT": "MC Win1", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN003a", "ID_STRING": "NAME_TXT", "TEXT": "Goblin-Spion", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0017", "ID_STRING": "NAME_TXT", "TEXT": "MC Win3", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0018", "ID_STRING": "NAME_TXT", "TEXT": "MC Win2", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Emp Win", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Emp Valley Enter", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Oger    \"Ihr Menschen wollt dieses Tal haben? Die ist das Tal der Grünhäute! Bleibt weg!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Emp Cap Gnarthwood", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Diese Stadt ist ein wichtiger Schritt hin zur Herrschaft über das gesamte Tal. Würden die Klans dieses Gebiet kontrollieren, wäre das ein großes Hindernis für unseren Feldzug...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Die Grünhäute waren gut ausgerüstet. In ihren Gewölben fanden wir beispielsweise das Buch des Krieges.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN003e", "ID_STRING": "NAME_TXT", "TEXT": "Goblin", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Emp Cap Runia", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \" Endlich haben wir Runia erobert. Es war ein wichtiger Außenposten der Grünhäute... Wir sollten dennoch vorsichtig sein, sie könnten zurückschlagen.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN0040", "ID_STRING": "NAME_TXT", "TEXT": "Ork", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Emp Kill Thalrisa", "SEQ_NUM": 0},
