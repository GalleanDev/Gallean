    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Clathums Laden", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Willkommen, schaut Euch ruhig um, was ich anzubieten habe...", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Jenbahs markt", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Wir kaufen und verkaufen zu erstklassigen Preisen, mein Fürst...", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Kerieks Lager", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Meine Soldaten sind die besten in dieser Gegend.", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Bilals Turm", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Ich glaube, meine magische Bibliothek könnte Euch nützlich sein.", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutrale", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Keine Völkerbeschreibung", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Galarth", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Dieser mächtige Fürst stellte sich einst einer ganzen Armee aus der Hölle und besiegte sie fast alleine, indem er das Portal verschloss, aus dem die Höllenbrut strömte. Er wurde dann Herrscher seines Reiches.", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Fedroth", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Zu ihrer Zeit war diese Fürstin als mächtigste aller Schwarzen Magierinnen bekannt. Sie wurde von Inquisitor Vorgel getötet. Doch nun wurde sie als Untote wiedererweckt und plant, jeden Sterblichen ihrem Willen zu unterwerfen.", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Dagar", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Zythaar", "SEQ_NUM": 0}
