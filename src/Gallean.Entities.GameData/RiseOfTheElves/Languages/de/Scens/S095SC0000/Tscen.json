    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095SI0001",
      "ID_STRING": "TXT_DESC",
      "TEXT": "Seht Euch meine Waren an. Ich k\u00F6nnte etwas haben, das Euch interessiert.",
