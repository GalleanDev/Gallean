      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0017",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar T30",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0017",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar der Reisende\n\u0022Philip d\u0027Agincourt hat Euch in die Falle gelockt! Das war alles nur ein Trick, mein Lehnsherr.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN003a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Krake",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0018",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Uther stirbt",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0018",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Kleriker\n\u0022Was haben wir getan? Uther, der verlorene Sohn des Kaisers ist tot! Das Imperium ist dem Untergang geweiht!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0019",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Gebiet von Fhindar",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0019",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Uther\n\u0022Ich bin im Namen meines Vaters hier! Ich bin Uther, der Erbe von Nevendaar. Unterst\u00FCtzt mich im Kampf gegen die Feinde des Imperiums! Ich werde das Reich von Euch und euresgleichen Abschaum reinigen, de Lalye! Nun werdet Ihr sterben.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0019",
      "ID_STRING": "OBJECT_TXT",
      "TEXT": "Zerst\u00F6rt Hubert de Lalye. Uther darf nicht sterben.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN003c",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Meerjungfrau",
