    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095PL0009",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Goar",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095PL0009",
      "ID_STRING": "DESC_TXT",
      "TEXT": "Dieser m\u00E4chtige F\u00FCrst hat in seiner Jugend einst gegen eine H\u00F6llenarmee standgehalten und sie ganz alleine besiegt, indem er das Tor versiegelte, aus dem sie kamen. Er wurde anschlie\u00DFend der Herrscher seines Reiches.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095PL000a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Asumuel",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095PL000a",
      "ID_STRING": "DESC_TXT",
      "TEXT": "Jedes Kind erschaudert bei der Erw\u00E4hnung dieses Namens. Dieser H\u00F6llenf\u00FCrst ist f\u00FCr seinen Blutdurst bekannt, und es hei\u00DFt, er h\u00E4tte einmal 1000 Sklaven bei einem Bankett verschlungen, das Bethrezen nach einem Sieg \u00FCber das K\u00F6nigreich des Lichts gab.",
      "SEQ_NUM": 0
    },
