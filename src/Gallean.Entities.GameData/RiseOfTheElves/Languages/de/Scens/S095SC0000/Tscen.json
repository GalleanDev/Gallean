    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0000",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar T1",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0000",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar der Reisende\n \u0022Seit geg\u00FCsst, mein Lehnsherr! Ich bin erfreut, Euch sicher zu sehen. Der Inquisitor Philip d\u0027Agincourt wartet auf Euch in der Stadt Fhindar, hoch im Norden. Ich werde Euch f\u00FChren.\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0023",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Speertr\u00E4ger",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0001",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar T2",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar der Reisende\n \u0022Seid auf der Hut! In diesen Fl\u00FCssen leben Meerhexen, die unvorsichtige Reisende \u00FCberfallen! Geht nicht ins Wasser!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0024",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0002",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar tot",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0025",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0026",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0003",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar Middle 1",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0003",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Speertr\u00E4ger \n\u0022Verzeiht uns, Nobar. Niemand au\u00DFer Euch darf hier passieren. So lauten Philips Befehle!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0027",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0004",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar Middle 2",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Speertr\u00E4ger \n\u0022Seid gegr\u00FC\u00DFt, Nobar. Au\u00DFer Euch darf hier niemand passieren. Das sind die Befehle Philip d\u0027Agincourts.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0005",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Spider Roam T10",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0028",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0029",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0007",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Hubert\u0027s Army T30",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0007",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hubert de Lalye\n\u0022Mochtet Ihr meine seidenen Freunde? Ihr h\u00E4ttet Euch mir anschlie\u00DFen sollen, so wie die anderen.Jetzt werdet Ihr sterben und Fhindar wird mein sein! Hahahahaha.\u0022",
      "SEQ_NUM": 3
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0007",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ranger \n\u0022Meister, wir m\u00FCssen Hubert de Lalye aufhalten, bevor er die Stadt Fhindar einnimmt!\u0022",
      "SEQ_NUM": 5
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0007",
      "ID_STRING": "OBJECT_TXT",
      "TEXT": "Zerst\u00F6rt Hubert de Lalye, bevor er die Stadt Fhindar einnimmt. Uther darf nicht sterben.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0008",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Spiders Roam T20",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0008",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Waldl\u00E4ufer\n\u0022Irgend etwas treibt die Spinnen aus ihren Nestern! Unsere Kundschafter sahen Rauch \u00FCber dem Seidenwald. Wer k\u00F6nnte dies getan haben?\u0022",
      "SEQ_NUM": 5
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0009",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Uther Arrive T33",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0009",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Uther\n\u0022Ich werde das Reich von Euch und euresgleichen Abschaum reinigen, de Lalye! Nun werdet Ihr sterben. Ich werde das Imperium seinem rechtm\u00E4\u00DFigen Herrscher zur\u00FCck geben!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0009",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hubert de Lalye \n\u0022Ein Junge? Hahaha! Ist das alles, was das Imperium zu seinem Schutz aufzubieten hat? Demosthene ist ein Feigling!\u0022",
      "SEQ_NUM": 4
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN002c",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Speertr\u00E4ger",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Seidenwald Warnung",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000a",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar der Reisende\n\u0022Die W\u00E4lder dort unten werden die Seidenw\u00E4lder genannt. Nur wenige wagen sich in ihre N\u00E4he, denn wilde Tiere verbergen sich darinnen.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN002d",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN002e",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000c",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Fhindar betreten",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000c",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar der Reisende\n\u0022Fhindar ist nahe! Ihr m\u00FCsst nach Westen reisen. Mehr als ein Weg f\u00FChrt zu der Stadt.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN002f",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Speertr\u00E4ger",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000d",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar T5",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000d",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar der Reisende\n\u0022Philip d\u0027Agincourt ist sehr vorsichtig. Er hat alle Wege nach Fhindar blockiert. Ich hoffe, dass er Euch passieren l\u00E4sst!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0030",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0031",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Niedriger Speertr\u00E4ger stirbt",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0032",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000f",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Hoher Speertr\u00E4ger stirbt",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0010",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Gewinnen Q (Hubert t\u00F6ten)",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0010",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hubert de Lalye\n\u0022Ihr. Ihr habt mich besiegt! Wie kann das sein? Seid verflucht, Uther!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0010",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Uther \n\u0022Alle Feinde des Imperiums werden das gleiche Schicksal erleiden. Ich werde meinem Vater helfen, den Frieden im Reich Nevendaar wieder herzustellen!\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0034",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Eisb\u00E4r",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0011",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Hubert gewinnt",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0011",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hubert de Lalye\n\u0022Hahaha! Jetzt, da die Stadt Fhindar mein ist, werdet ihr mir nicht mehr widerstehen k\u00F6nnen. Uthers Ankunft war ohne jegliche Konsequenzen!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0012",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Text Stadt Feste Khazan",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0012",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Bogensch\u00FCtze\n\u0022Viele Fischer sind auf hoher See verschwunden.. Die Bauern denken, sie seien von Seeungeheuern verschlungen worden!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0036",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Meerjungfrau",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0013",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Text Stadt Silveria",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0013",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Speertr\u00E4ger\n\u0022Fhindar ist noch etwas weiter im Norden. Wir hoffen, dass der Kaiser diesen Krieg gewinnt. Hubert hat Milizen ausgeschickt, die alle St\u00E4dte in diesen Landen sichern sollen!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0014",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Lofemyr Move T8",
      "SEQ_NUM": 0
