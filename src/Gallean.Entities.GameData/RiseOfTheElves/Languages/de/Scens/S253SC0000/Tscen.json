{
  "formatVersion": 1,
  "rows": [
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Hemlocks Laden", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Meine Waren können Euch bei Eurer Aufgabe helfen.", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Herlicks Laden", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Werft ruhig einen Blick auf meine Waren, bestimmt ist es etwas für Euch dabei.", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Garkaths Turm", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Braucht Ihr noch mehr interessante Zauber?", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0005", "ID_STRING": "TXT_TITLE", "TEXT": "Metacas Lager", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0005", "ID_STRING": "TXT_DESC", "TEXT": "Kommt nur herein, ich mache aus Euren gebrechlichen Soldaten tapfere Kämpfer.", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutrale", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Keine Völkerbeschreibung", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Goar", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Dieser mächtige Fürst stellte sich einst einer ganzen Armee aus der Hölle und besiegte sie fast alleine, indem er das Portal verschloss, aus dem die Höllenbrut strömte. Er wurde dann Herrscher seines Reiches.", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Jagare", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN000c", "ID_STRING": "NAME_TXT", "TEXT": "Goblin", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN000e", "ID_STRING": "NAME_TXT", "TEXT": "Goblin", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0010", "ID_STRING": "NAME_TXT", "TEXT": "Bauer", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0012", "ID_STRING": "NAME_TXT", "TEXT": "Erster Dorfbewohner", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0018", "ID_STRING": "NAME_TXT", "TEXT": "Goblin", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN001c", "ID_STRING": "NAME_TXT", "TEXT": "Bauer", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN001e", "ID_STRING": "NAME_TXT", "TEXT": "Bauer", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Intro 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Mylord, das Königreich sieht sich einer ernsten Gefahr gegenüber - wie es scheint, haben sich alle Dörfer unter Eurer Herrschaft einer Revolte angeschlossen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Wir müssen unsere Städte mit Gewalt zurückerobern und herausfinden, wer dafür verantwortlich ist! Doch zunächst sollten wir uns mit dem Kanzler von Clovis zusammensetzen, um mit ihm die geeigneten Strategien zu abzusprechen.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Intro 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Kaiserlicher Ratgeber    \"Willkommen, mein Fürst, ich bin Euer Kaiserlicher Ratgeber. Ich kann Euch mit hilfreichen Ratschlägen zur Seite stehen, wie man ein Königreich führt.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Kaiserlicher Ratgeber    \"Ich würde vorschlagen, Ihr stellt eine Armee in der Hauptstadt zusammen,  indem Ihr Einheiten der Verteidigungstruppen zur kämpfenden Armee herüberzieht. Dann könnt Ihr auch noch Gegenstände aus den Schatzkammern verteilen.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Hinweis Hexenturm", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Mylord! Aus dem Hexenturm dringen grässliche Schreie! Dort leiden unschuldigen Seelen unsägliche Qualen! Es ist unsere Pflicht, ihnen zu helfen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Loot Hag Turm", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Isuel    \"Danke, dass Ihr mich befreit habt. Ich dachte schon, ich käme niemals wieder frei. Erlaubt mir, mich erkenntlich zu zeigen, indem ich allen vom Imperium künde und Pfähle errichtem wo immer Ihr es befehlt.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Wir können dem Erzengel befehlen, überall da Stecken aufzupflanzen, wo wir Vorkommen für uns beanspruchen. Auf diese Weise sammeln wir Gold und Mana, ohne jedes Mal eine Stadt in der Nähe unterhalten zu müssen.\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0029", "ID_STRING": "NAME_TXT", "TEXT": "Bauer", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Tipp3- Goblin-Kaiserreich", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Goblins    \"Hey! Verschwindet! Das ist ein besonderer Schatz! Den könnt Ihr nicht haben! Ihr macht uns wütend!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Dorf verteidigen", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Dorfbewohner    \"Lauft um Euer Leben!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Tipp4- Reise übers Wasser", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Für Anführer, die nicht fliegen können, ist das Überqueren von Wasser äußerst mühsam und gefährlich, Mylord.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Tipp4- Reise übers Wasser2", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Für Anführer, die nicht fliegen können, ist das Überqueren von Wasser äußerst mühsam und gefährlich, Mylord.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Friedhof", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Grabräuber    \"Kommt in Euer Grab...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Runenstein-Mana", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Mylord, vor uns liegt eine Quelle voller Runenmana! Wir sollten einen Erzengel entsenden, um in der Nähe einen Stecken zu pflanzen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0032", "ID_STRING": "NAME_TXT", "TEXT": "Schläger", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Day4 Hint", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Mylord, unsere Kundschafter berichten von einem kleinen Dorf im Norden. Vielleicht sollten wir diesen Hinweisen nachgehen. Es wäre eine gute Gelegenheit, unseren Einfluss weiter auszubauen.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0037", "ID_STRING": "NAME_TXT", "TEXT": "Schläger", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Kaiserreich Heilung", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Kaiserreich Heilungsnachricht", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Statue    \"Gesegnet sind die, die für den Hohen Vater kämpfen... Die Verletzten sollen nun geheilt werden, jetzt und immer wieder, wenn sie an diesen Ort zurückkehren.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Goblinbrut", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0046", "ID_STRING": "NAME_TXT", "TEXT": "Goblin", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0024", "ID_STRING": "NAME_TXT", "TEXT": "Schläger-Durchgang", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0024", "ID_STRING": "POPUP_TXT", "TEXT": "Schläger    \"Ihr bezahlt einen hohen Preis, wenn Ihr an mir vorbei kommen wollt!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN004b", "ID_STRING": "NAME_TXT", "TEXT": "Meisterdieb", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Nepheris", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "Um die Verteidigungsfähigkeiten dieser Stadt zu erhöhen, muss sie wachsen. Mit jeder Stufe wächst auch die Zahl der Garnisonseinheiten, die Eure Stadt aufnehmen kann. Außerdem steigt der Verteidigungsbonus aller Einheiten innerhalb Eurer Stadtmauern.", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN004d", "ID_STRING": "NAME_TXT", "TEXT": "Meisterdieb", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Erobert Fort Davon", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV002a", "ID_STRING": "POPUP_TXT", "TEXT": "Dorfbewohner    \"Ihr könnt uns unser Land wegnehmen, aber irgendwann werden wir uns dafür rächen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN004f", "ID_STRING": "NAME_TXT", "TEXT": "Lanzenträger", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Ork Warnung", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV002c", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Seid auf der Hut, Mylord, Orks sind extrem angriffslustig und eine wahre Plage auf dem Schlachtfeld! Sie könnten uns angreifen, wenn wir ihn ihrer Nähe anhalten.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV002d", "ID_STRING": "NAME_TXT", "TEXT": "Grünhaut-Versteck", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Hier befindet sich ein Fort der Grünhäute, Mylord. In diesen Forts horten sie in der Regel größere Goldvorräte, die aus den Überfällen auf Passanten stammen. Allerdings wissen sie sich auch gut zu verteidigen...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0052", "ID_STRING": "NAME_TXT", "TEXT": "Meisterdieb", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0030", "ID_STRING": "NAME_TXT", "TEXT": "Day Goblins Appear", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0030", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Viele Goblins kommen aus dem Nordland in unsere Region, um hier Handel zu treiben. Wenn wir nicht aufpassen, greifen sie uns möglicherweise sogar an!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0032", "ID_STRING": "NAME_TXT", "TEXT": "Lebensmana", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0032", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Der seltsame Kristall vor uns ist sogenanntes Lebensmana, Mylord, die Quelle unserer magischen Macht!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0032", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Wenn wir Vorkommen wie Goldminen oder Manakristalle, die nicht unter unserer Kontrolle stehen, beschlagnahmen wollen, können wir einen Erzengel aussenden, der gleich neben dem Vorkommen einen Stecken einpflanzt.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0033", "ID_STRING": "NAME_TXT", "TEXT": "Hügelriese", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0033", "ID_STRING": "POPUP_TXT", "TEXT": "Hügelriese    \" Was wollt Ihr? Ich entscheide, wer hier ausgebildet wird, und Ihr seht nicht aus, als hättet Ihr hier eine Chance! Ha!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0035", "ID_STRING": "NAME_TXT", "TEXT": "Tränke Hinweis", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0035", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Sollte jemand bei einem Gefecht verletzt werden, kann er mit einem Trank geheilt oder wiederbelebt werden. Steht in der Hauptstadt ein Tempel, könnt Ihr Einheiten auch in einer  Stadt heilen oder wiederbeleben lassen.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0036", "ID_STRING": "NAME_TXT", "TEXT": "Zauber-Hinweis", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0036", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Mylord, wenn wir genügend Mana gesammelt haben, können wir Zauber aussprechen, die uns helfen und unseren Feinden schaden. Doch dafür müssen wir zunächst den magischen Turm errichten, wenn er nicht schon längst gebaut worden ist.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0036", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Wenn Ihr weitere Zaubersprüche besitzen wollt, könnt Ihr sie in der Hauptstadt erforschen. Allerdings nur, wenn Ihr zuvor die erforderliche Menge Mana gesammelt habt.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0037", "ID_STRING": "NAME_TXT", "TEXT": "Upgrade-Hinweis", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0037", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Wenn unsere Kampfeinheiten genügend Erfahrung gesammelt haben, können wir sie zu mächtigeren Figuren aufrüsten, vorausgesetzt, wir haben in der Hauptstadt das für die Aufwertung nötige Gebäude errichtet.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0038", "ID_STRING": "NAME_TXT", "TEXT": "Artefakt-Hinweis", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0038", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Mylord, wir sollten nach Schatztruhen Ausschau halten. Diese Truhen können Artefakte mit besonderen Kräften oder Wertgegenstände enthalten. Die erste befindet sich gleich vor uns!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0039", "ID_STRING": "NAME_TXT", "TEXT": "Disable Upgrade", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003a", "ID_STRING": "NAME_TXT", "TEXT": "Hiring Hint", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003a", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Mylord, auch wenn wir einen großen Anführer verloren haben, sollten wir uns keine übertriebenen Sorgen machen. In der Hauptstadt können wir einen anderen anheuern, gegen eine gewisse Gebühr, versteht sich.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003b", "ID_STRING": "NAME_TXT", "TEXT": "Goblin-Schatz2", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003b", "ID_STRING": "POPUP_TXT", "TEXT": "Goblin    \"Hey! Hey! Pfoten weg von unserem Schatz! Verschwindet!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003c", "ID_STRING": "NAME_TXT", "TEXT": "Händler-Hinweis", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003c", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Vor uns liegt der Laden eines Händlers - nur für den Fall, dass wir ein paar Vorräte wie Heiltränke oder andere Gegenstände brauchen sollten.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003d", "ID_STRING": "NAME_TXT", "TEXT": "Hallo, Kanzler", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003d", "ID_STRING": "POPUP_TXT", "TEXT": "Kanzler von Clovis    \"Seid willkommen. Ich bin der Kanzler von Clovis, und bin gekommen, um Euch in der hohen Schule der Kampftaktik zu unterweisen. Leider kann ich mich nicht lange aufhalten, doch ich will Euch erzählen, was ich weiß.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003d", "ID_STRING": "POPUP_TXT", "TEXT": "Kanzler von Clovis    \"Fernkämpfer wie z.B. Bogenschütze,  Lehrling oder Akoluth solltet Ihr hinten platzieren. So werden sie von den kräftigeren Einheiten, die sich auf den Nahkampf verstehen, geschützt wie z.B. dem Knappen oder dem Pegasusritter.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003d", "ID_STRING": "POPUP_TXT", "TEXT": "Kanzler von Clovis    \"Also: Manche Einheiten beherrschen nur den Nahkampf, die solltet Ihr in der ersten Reihe platzieren. Andere kämpfen aus der Distanz, platziert sie also hinten. Und verlasst die Hauptstadt immer mit einer vollständigen Armee!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003d", "ID_STRING": "POPUP_TXT", "TEXT": "Kanzler von Clovis    \"Noch etwas: Um Euch Zugang etwa zu einem Anführer oder der Hauptstadt zu verschaffen, genügt ein Doppelklick darauf. Mit einem Rechtsklick auf ein Objekt könnt Ihr Euch die dazugehörigen Informationen beschaffen.\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003e", "ID_STRING": "NAME_TXT", "TEXT": "Auf Wiedersehen, Kanzler", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003f", "ID_STRING": "NAME_TXT", "TEXT": "Bekämpft die Bauern", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003f", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Aufständische Bauern sind im Anmarsch! Sie wollen die Hauptstadt belagern! Im Namen des Hohen Vaters, wir müssen sie aufhalten! Denkt an den Ratschlag des Kanzlers!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0041", "ID_STRING": "NAME_TXT", "TEXT": "Goldmine", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0041", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Das ist eine Goldmine, Mylord. Sie gehört bereits uns.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0043", "ID_STRING": "NAME_TXT", "TEXT": "Sieg", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0043", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber   \"Die aufständischen Bauern wurden zur Aufgabe gezwungen! Das Kaiserreich beherrscht dieses Land!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0067", "ID_STRING": "NAME_TXT", "TEXT": "Goblin", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0045", "ID_STRING": "NAME_TXT", "TEXT": "Hinweis Ausbildungslager", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0045", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Mylord, vor uns liegt ein Ausbildungslager. Gegen ein entsprechendes Entgelt könnt Ihr unsere Truppen dort ausbilden lassen - sie sammeln dann Erfahrung,  als ob sie auf dem Schlachtfeld kämpften.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0046", "ID_STRING": "NAME_TXT", "TEXT": "Magierturm-Hinweis", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0046", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Das ist ein Magierturm, Mylord. Bei diesem Magier können wir uns gegen eine entsprechende Summe Goldes neue Zaubersprüche kaufen.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0047", "ID_STRING": "NAME_TXT", "TEXT": "Orkbegegnung", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0047", "ID_STRING": "POPUP_TXT", "TEXT": "Ork    \"Was wollt Ihr? Es gibt hier nichts für Euch Kaiserliche... nur dreckige Dämonen! Und jetzt haut ab, und bleibt weg von meinem Glücksschatz!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0048", "ID_STRING": "NAME_TXT", "TEXT": "Infernalisches Mana", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0048", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Vor uns steigt höllisches Mana aus dem Boden. Wir können es ernten, wenn wir gleich daneben einen Stecken pflanzen.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0049", "ID_STRING": "NAME_TXT", "TEXT": "Kaiserreich Heilungsberechtigter", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV004a", "ID_STRING": "NAME_TXT", "TEXT": "Berge entfernen", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV004a", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Mylord! Wir haben einen geheimen magischen Durchgang geöffnet!\"", "SEQ_NUM": 0},
