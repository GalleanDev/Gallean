    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0000",
      "ID_STRING": "NAME_TXT",
      "TEXT": "City Inthuric text",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0000",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Zwerg \n\u0022Gymner Wolkenh\u00FCter ist der Sohn K\u00F6nig Moroks. Wenn Ihr ihm etwas zu Leide tut, wird Morok Euch zerquetschen!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100UN0023",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0002",
      "ID_STRING": "NAME_TXT",
      "TEXT": "City Oghock text",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0002",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Goblin \n\u0022Dudu wieder??!! Du alle sterben, Gro\u00DFaxt euch t\u00F6ten!!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0003",
      "ID_STRING": "NAME_TXT",
      "TEXT": "City Dunera text",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0003",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Kultist \n\u0022Herr, wir m\u00FCssen uns beeilen! Der Wissensh\u00FCter darf das Tor nicht verschlie\u00DFen. Wir m\u00FCssen Bethrezen befreien!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100UN0027",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0004",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Gymner T30",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ratgeber \n\u0022Herr! Unsere Sp\u00E4her haben gesehen, wie Gymner sich dem Tor n\u00E4hert. Er wird in K\u00FCrze die Zeremonie beginnen, die unser Schicksal besiegeln soll! Er muss aufgehalten werden!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100UN0029",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100UN002a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Leif",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0007",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Enter zone 1",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0007",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "H\u00FCgelriese\n\u0022Wotan wird diese Blasphemie nicht tolerieren! Macht Euch gefasst, Eurem verfluchten Gott ins Jenseits zu folgen.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100UN002b",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0008",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Enter zone 2",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0008",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "H\u00FCgelriese \n\u0022Wotan wird Eure Gegenwart in unseren L\u00E4nderein nicht dulden, H\u00E4retikerabschaum! Er wird uns gegen Eure Truppen zum Sieg f\u00FChren.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0009",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Betrunkene Zwerge",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0009",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "W\u00E4chterThurin \n\u0022Har! Warum schicken die Gymner hierher? Wir werden die Trolljagd in Gunthera verpassen.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0009",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Zwerg \n\u0022Ach,.wer wei\u00DF? Wir sollen Gymner f\u00FCr so eine Zeremonie bewachen. Immer haben andere das Vergn\u00FCgen.\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0009",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "W\u00E4chter Thurin \n\u0022Reich mir einfach das Bier r\u00FCber. Wir k\u00F6nnen uns ja wenigstens am\u00FCsieren, w\u00E4hrend wir dieses verdammte Tor bewachen!\u0022",
      "SEQ_NUM": 2
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0009",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Kultist \n\u0022Herr, wir haben die betrunkenen Zwerge belauscht. Sie bewachen den Gang, der zum Tor f\u00FChrt!!!\u0022",
      "SEQ_NUM": 3
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100UN002d",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV000a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Goblin Warning 1",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV000a",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Kultist \n\u0022Herr, dieses Gebiet ist mit Goblins infiziert! Wir sind uns nicht sicher, welche scheu\u00DFlichen Kreaturen dieses Ungeziefer begleiten k\u00F6nnte. Wir m\u00FCssen auf Jeden Fall vorsichtig sein.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV000b",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Aufgabe erfolgreich beenden 1",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV000b",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Herzog \n\u0022Wir haben unseren Auftrag erledigt, Herr. Der Wissensh\u00FCter Gymner ist tot.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV000b",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Gymner Wolkenh\u00FCter \n\u0022Ich.ich bin besiegt. Mei... Morok.wird meinen Tod r\u00E4chen.Ihr wer-werdet den Zorn der Clans sp\u00FCren!\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV000b",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "D\u00E4monologe\n\u0022Seht! Das Tor \u00F6ffnet sich! Bethrezen wird endlich aus seinem h\u00F6llischen Gef\u00E4ngnis befreit! Unser Herr kehrt zur\u00FCck!\u0022",
      "SEQ_NUM": 3
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV000b",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "D\u00E4monologe\n\u0022Wa...was ist das?!! Ein Junge? Wo ist der gro\u00DFe D\u00E4mon, der ganze Truppen befehligte! Wo ist Bethrezen, wenn er nicht hier gefangen war? Hat unser Anf\u00FChrer, auf den wir so lange gewartet haben, uns verlassen?\u0022",
      "SEQ_NUM": 5
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV000c",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Undead Help",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV000c",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hexer \n\u0022Meister, die Untoten Horden haben ihre Zauberkr\u00E4fte gegen Gymner eingesetzt. Helfen sie uns, Bethrezen zu befreien? Wie sind ihre Pl\u00E4ne?\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV000c",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Gymner Wolkenh\u00FCter \r\u0022Eure Versuche, mich aufzuhalten, sind zwecklos! Die Clans lassen sich nicht ins Handwerk pfuschen. Euer verfluchter Gott wird auf ewig eingesperrt bleiben.\u0022",
      "SEQ_NUM": 2
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV000c",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hexer \n\u0022Gymner beginnt mit der Zeremonie. Jetzt m\u00FCssen wir zuschlagen, es eilt!\u0022",
      "SEQ_NUM": 3
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100UN002f",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100UN0030",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV000d",
      "ID_STRING": "NAME_TXT",
      "TEXT": "T1 Warning",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV000d",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Zwerg\n\u0022Was? D\u00E4monen - hier? Verlasst diese L\u00E4ndereien, bevor wir euch zermalmen! Das ist BergClan-Gebiet. Verschwindet, solange ihr noch k\u00F6nnt.\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV000d",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Kultist\n\u0022Herr, sollen wir den Zwergenboten t\u00F6ten, bevor er die anderen vor uns warnen kann? Er muss aufgehalten werden!\u0022",
      "SEQ_NUM": 2
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV000e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Dwarf Messenger",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV000e",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ratgeber\n\u0022Herr, der Zwergenbote ist an seinem Bestimmungsort angekommen. Ich f\u00FCrchte, die Clans sind sich unserer Gegenwart jetzt bewusst!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0010",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Win Quest 2",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0010",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Bethrezen \n\u0022Erkennt Ihr mich nicht? Verneigt Euch vor dem Herrscher der H\u00F6lle ...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0011",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Destroy Guard 1",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0011",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ratgeber \n\u0022Wir haben einen W\u00E4chter gefangen genommen und ausgel\u00F6scht. Das Tor kann nicht weit sein! Wir m\u00FCssen wachsam sein und auf Feinde achten; es ist sehr wahrscheinlich, dass wir auf mehr Widerstand treffen, je n\u00E4her wir dem Tor kommen.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0013",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Dwarf move",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0013",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Zwergenw\u00E4chter \n\u0022Hinfort, Bestien! B\u00F6se Bestien von eurer Art sind hier unerw\u00FCnscht! Verschwindet oder sterbt.\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0014",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Dwarf messenger killed",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0014",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ratgeber \n\u0022Wir haben den Boten get\u00F6tet, Herr! Wenn wir uns des Sohnes des Hohen K\u00F6nigs entledigen k\u00F6nnen, bevore er das H\u00F6llentor versiegelt, wird Bethrezen frei sein!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0015",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Freie Riesen",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0016",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Ihr verliert die Aufgabe T85",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0016",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Gymner Wolkenh\u00FCter \n\u0022Hahaha! Die Zeremonie ist vollbracht! Jetzt wird das Tor ein Jahrhundert lang versiegelt sein!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0017",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Gymner  T40",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0017",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Kultist \n\u0022Hier! Eine Nachricht von Gymner kam gerade an!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0017",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Zwergenbote \n\u0022Verlasst diese L\u00E4ndereien, dreckige Bestien! Ihr werdet es nie schaffen, Gymners Zeremonie zu stoppen. Bethrezens Schicksal ist bereits besiegelt.\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0018",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Message T8",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0018",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ratgeber \n\u0022Herr, die minder bemittelten Zwerge scheinen uns nicht bemerkt zu haben. Wir sollten das f\u00FCr uns ausnutzen.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0019",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Gymner T70",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0019",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Gymner Wolkenh\u00FCter \n\u0022F\u00FCr euch ist alles verloren, D\u00E4monen. Das Tor ist fast versiegelt. Ich werde mich um euch k\u00FCmmern, sobald die Zeremonie vollbracht ist!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0019",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Kultist \n\u0022Beeilung, Herr! Wenn Gymner Erfolg hat, sind wir dem Untergang geweiht.\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100UN004f",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Meisterschl\u00E4ger",
      "SEQ_NUM": 0
