    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100SI0000",
      "ID_STRING": "TXT_TITLE",
      "TEXT": "Under\u0027s Laden",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100SI0000",
      "ID_STRING": "TXT_DESC",
      "TEXT": "Ich verkaufe euch alles, gegen einen gewissen Preis.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100SI0001",
      "ID_STRING": "TXT_TITLE",
      "TEXT": "Malavien\u0027s Turm",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100SI0001",
      "ID_STRING": "TXT_DESC",
      "TEXT": "Ich habe einige neue m\u00E4chtige Zauberspr\u00FCche, die Euch interessieren d\u00FCrften!",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100PL0000",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Begrezen",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100PL0000",
      "ID_STRING": "DESC_TXT",
      "TEXT": "Jedes Kind erschaudert bei der Erw\u00E4hnung dieses Namens. Dieser H\u00F6llenf\u00FCrst ist f\u00FCr seinen Blutdurst bekannt, und es hei\u00DFt, er h\u00E4tte einmal 1000 Sklaven bei einem Bankett verschlungen, das Bethrezen nach einem Sieg \u00FCber das K\u00F6nigreich des Lichts gab.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100PL0001",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Athaulf",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100PL0001",
      "ID_STRING": "DESC_TXT",
      "TEXT": "Als oberster der Zwergenf\u00FCrsten ist er f\u00FCr seine St\u00E4rke im Kampf und seine Tapferkeit angesichts schlechter Chancen bekannt. Einst k\u00E4mpfte er sieben Tage und N\u00E4chte gegen den m\u00E4chtigen Roten Drachen ARFURUZON, um ihn schlie\u00DFlich zu besiegen.",
      "SEQ_NUM": 0
    },
