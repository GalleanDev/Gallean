    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211LO0010", "ID_STRING": "NAME_TXT", "TEXT": "Ork Eingang", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211LO0011", "ID_STRING": "NAME_TXT", "TEXT": "Legionenhändler", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Der Mühlenladen", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Ich habe die besten Stiefel in der ganzen Region.", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Mithikors Laden", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Ihr seht aus, als wolltet Ihr was kaufen, und ich bin genau der Richtige, um es Euch zu verkaufen.", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Kiggers Lager", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Ich kann Luftelementare für Euch herbei beschwören, und wenn Ihr genug Geld habt, könnt Ihr einen meiner Studenten anheuern.", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutrale", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Keine Völkerbeschreibung", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211PL0001", "ID_STRING": "NAME_TXT", "TEXT": "Konrad", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211PL0001", "ID_STRING": "DESC_TXT", "TEXT": "Dieser mächtige Fürst stellte sich einst einer ganzen Armee aus der Hölle und besiegte sie fast alleine, indem er das Portal verschloss, aus dem die Höllenbrut strömte. Er wurde dann Herrscher seines Reiches.", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211PL0002", "ID_STRING": "NAME_TXT", "TEXT": "Zagamon", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211PL0002", "ID_STRING": "DESC_TXT", "TEXT": "Jedes Kind erschauert, sobald der berüchtigte Name fällt. Dieser Höllenfürst ist für seinen Blutdurst bekann. Bei einem Bankett, das Brethrezen anlässlich des Sieges über das Königreich des Lichts gab, soll er angeblich 1000 Sklaven gefressen haben.", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Ravon Mith", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Bretish Zok", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211UN0005", "ID_STRING": "NAME_TXT", "TEXT": "Meftu-Krake", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211UN0008", "ID_STRING": "NAME_TXT", "TEXT": "Seejungfrau", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211UN0009", "ID_STRING": "NAME_TXT", "TEXT": "Seejungfrau", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211UN000c", "ID_STRING": "NAME_TXT", "TEXT": "Seejungfrau", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211UN001e", "ID_STRING": "NAME_TXT", "TEXT": "Rendors königlicher Konvoi", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211UN001f", "ID_STRING": "NAME_TXT", "TEXT": "South Keven Convoy", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Krake", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211UN0024", "ID_STRING": "NAME_TXT", "TEXT": "Mithikor", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Kaiserreich Hilfe1", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Mithikor    \"Ich bin gerade aus einem weit entfernten Land angekommen und habe Gegenstände dabei, die uns beim Kampf gegen die Dämonen helfen werden!\"", "SEQ_NUM": 5},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Intro Kaiserreich", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Mylord, ich muss Euch leider mitteilen, dass hier Waldläufer und Priester ihr Unwesen treiben, die das Kaiserreich verraten haben. Ich würde vorschlagen, dass wir uns zuerst um sie kümmern, bevor wir uns der Legionen annehmen. \"", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Legion Hilfe", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Dämon    \"In meinen Adern brodelt der Hass auf das Kaiserreich und alles, wofür es steht. Helft mir, Rache zu üben.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211UN0027", "ID_STRING": "NAME_TXT", "TEXT": "Seejungfrau", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Intro Legion", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Es ist an der Zeit, die alte Prophezeiung zu erfüllen und die Herrschaft der Dämonen über die ganze Erde auszubreiten. Doch zunächst müssen wir Gorgoth und Bhaarth vernichten. Diese verräterischen Dämonen müssen sterben!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Priester tot", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Priest    \"Die verräterischen Priester haben für ihren Verrat am Hohen Vater bezahlt. Diese Schlacht soll die Macht des Kaiserreiches demonstrieren!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Ranger tot", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Nachdem  wir diese... Beleidigung...für die Waldläufer aus der Welt geschaffen haben, wird es für uns wahrscheinlich einfacher, Bogenschützen zu rekrutieren...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211UN002b", "ID_STRING": "NAME_TXT", "TEXT": "Seejungfrau", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Ork Warnung", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Orkkundschafter    \"Niemand betritt unser Gebiet! Verschwindet dahin, wo Ihr hergekommen seid!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Erzählt über die Lebende Rüstung", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Man sagt, dass der Hohe Vater Euch bei Euren Aufgaben hilft, wenn Ihr Euch die Zeit nehmt und in der Nähe von alten Statuen zu ihm betet. Nun geht das Gerücht, dass im Osten eine solche Statue stehen soll.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211UN002e", "ID_STRING": "NAME_TXT", "TEXT": "Seeschlange", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Lebende Rüstung wird gezaubert", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Lebende Rüstung    \"Ich bin hier, um dem Hohen Vater zu dienen. Die Zeit ist gekommen, die Legionen in seinem Namen zu vernichten, sowie alle, die sich gegen ihn stellen!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Warnung Zwergenstadt", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Wächter der Bruderschaft    \"Ihr habt kein Recht, eine Stadt zu besetzen, die der Bruderschaft des Nordens gehört! Wir werden bis zum letzten Mann kämpfen und für jeden getöteten Bruder werden drei weitere an seine Stelle treten!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211UN0030", "ID_STRING": "NAME_TXT", "TEXT": "Seejungfrau", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Tote Dämonen", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Ratgeber    \"Hier habt Ihr ein kleines Zeichen unserer Anerkennung für die Tötung dieser Rebellen-Dämonen. Wenn Ihr uns weiter so gut dient, werden wir Euch reich belohnen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Dwarf renfort", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Ork spawn", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Legionhändler", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Mithikor    \"Ihr werdet diese Schlacht nicht gewinnen, indem Ihr auf einem einfachen Händler rumhackt!\"", "SEQ_NUM": 0},
