    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244LO000a", "ID_STRING": "NAME_TXT", "TEXT": "Verlasst unsere Insel", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244LO000b", "ID_STRING": "NAME_TXT", "TEXT": "Legion Verräter", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244LO000c", "ID_STRING": "NAME_TXT", "TEXT": "Orks", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Sallats Laden", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Meine Waren können Euch bei Eurer Aufgabe helfen.", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Nibors Turm", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Ich kann Euch vor der Gespensterdame und dem Himmelskönig schützen.", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutrale", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Keine Völkerbeschreibung", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Goar", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Dieser mächtige Fürst stellte sich einst einer ganzen Armee aus der Hölle und besiegte sie fast alleine, indem er das Portal verschloss, aus dem die Höllenbrut strömte. Er wurde dann Herrscher seines Reiches.", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Ekrezem", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Jedes Kind erschauert, sobald der berüchtigte Name fällt. Dieser Höllenfürst ist für seinen Blutdurst bekann. Bei einem Bankett, das Brethrezen anlässlich des Sieges über das Königreich des Lichts gab, soll er angeblich 1000 Sklaven gefressen haben.", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Ardobert", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN000f", "ID_STRING": "NAME_TXT", "TEXT": "Ork-Champion", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN0017", "ID_STRING": "NAME_TXT", "TEXT": "Schläger", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN0019", "ID_STRING": "NAME_TXT", "TEXT": "Schläger", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN001b", "ID_STRING": "NAME_TXT", "TEXT": "Schläger", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN001c", "ID_STRING": "NAME_TXT", "TEXT": "Waldelfe", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN001f", "ID_STRING": "NAME_TXT", "TEXT": "Zentaurischer Lanzenträger", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN0021", "ID_STRING": "NAME_TXT", "TEXT": "Zentaurischer Lanzenträger", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Glückwunsch", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Pegasusritter   \"Der Kampf tobt weiter, bis der leblose Körper des Himmelskönigs zu Boden fällt! Das Kaiserreich hat seine Stärke bewiesen - wieder fällt ein Königreich unter sein Banner. Doch was ist das? Der Körper des Himmelskönigs verschwindet..?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN0029", "ID_STRING": "NAME_TXT", "TEXT": "Waldelfe", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Zentaur greift an", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Zentaurischer Lanzenträger    \"Vernichtet das Kaiserreich! Angriff!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Siegtext", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Lehrling    \"Die Sterne sandten dem König eine Nachricht...wir haben gelernt, dass die Reihen des Kaiserreichs in ihrem Innersten verdorben sind! Lobet Xenos, den Himmelskönig!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Elfenwarnung", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Dunkelfürst    \"Der Himmelskönig? Was für ein schwacher Narr! Er lebt jenseits des Waldes! Ich denke mal, die Elfen werden Euch nicht lange genug leben lassen, um ihn zu treffen. Hahahah...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Ork-Wache", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Ork Wache zwei", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN0032", "ID_STRING": "NAME_TXT", "TEXT": "Meisterdieb", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV000f", "ID_STRING": "NAME_TXT", "TEXT": "New Gamor", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Ashkael    \"Mit der Niederlage der Gespensterdame von Neu-Gamor sind die Geheimnisse der Ketzermagier zurückgekehrt...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0010", "ID_STRING": "NAME_TXT", "TEXT": "New Gamor Nachricht One", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Weibliches Gespenst    \"Wir ergeben unssssss...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Xenos Schloss Nachricht 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Hexenjäger   \"Die Legionen der Verdammten stehen für alles, gegen was wir gekämpft haben. Dieser Kampf ist noch nicht vorbei!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Blitzangriff", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0013", "ID_STRING": "NAME_TXT", "TEXT": "New Gamor Curse", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Weibliches Gespenst    \"New Gamor wird sich niemals Außenweltlern ergeben! Fühlt den Zorn einer Verbotenen Stadt, die Ihr niemals betreten werdet!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Sorenburg", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Elfen-Waldläufer    \"Die Elfen sind wild und viele an der Zahl! Wir werden Euch von unserem Territorium verjagen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Geisternachricht", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Geist    \"Kehrt um... dann werdet Ihr den nächsten Sssonnenaufgang noch erleben. Kommt näher... und ihr werdet ihren Untergang heute abend nicht mehr erleben.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Geisternachricht Legionen", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Geist    \"Die Gespenssterdame issst unbesiegbar! Werdet ein Anhänger der dunklen Pracht von Neu-Gamor! Allerdingsss müssen wir Eure heutige Gesstalt ersst ein wenig zerstören, dann erschaffen wir auss dem Ressst etwass Sschöneres! Habt keine Angst...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Peculiar Sojourn Two", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Dunkelfürst   \"Vernichtet die Dämonen! Schickt sie zurück in ihr stinkendes Loch!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Weibliches Gespenst", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Weibliches Gespenst    \"Kniet nieder vor der Gespensterdame von New Gamor! Fühlt die Macht Eurer eigenen Zauber und meiner dunklen Kräfte, Ketzer!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Kriegsfürst", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Kriegsfürst    \"Wir haben diesen Turm im Namen des Chaos eingenommen. Das Kaiserreich kann die Mächte des Bösen niemals besiegen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Kaiserreich Geschichte", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Paladin    \"Wir müssen das Königreich von Xenos finden und vernichten. Xenos, der Himmelskönig, ist ein Feind des Kaiserreiches! Er erzählte den Elfen, das Kaiserreich plane, ihre Waldsiedlungen zu vernichten. Wir rechnen mit einem Angriff.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Pegasus", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Hexenjäger   \"Der Himmelskönig wird uns rächen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Pegasus Nachricht Zwei", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Hexenjäger   \"Die Legionen der Verdammten? Wir hätten es wissen sollen....Nachdem die böse Hexe Neu Gamor erobert hat, sind die Truppen des Bösen hinter uns her!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001e", "ID_STRING": "NAME_TXT", "TEXT": "New Gamor Warnung", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Weibliches Gespenst    \"New Gamor wird ihre Grenzen beschützen. Jeder Außenweltler, der sie verletzt, wird unseren Fluch zu spüren bekommen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Himmelsblitz", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Himmelsblitz Zwei", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Pegasus-Ritter    \"Der Himmelskönig weiß, dass wir hier sind. Beeilt Euch!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Weibliches Gespenst Eins", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0023", "ID_STRING": "POPUP_TXT", "TEXT": "Erzteufel    \"Die Gespensterdame weiß, das wir sie jagen! Das spielt aber keine Rolle - wir werden sie finden und ihr nehmen, was uns gehört...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0024", "ID_STRING": "NAME_TXT", "TEXT": "Legion Geschichte", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0024", "ID_STRING": "POPUP_TXT", "TEXT": "Ashkael    \"Ein Narr, der nicht mehr lange leben wird, hat das Undenkbare getan - die Legionen der Verdammten bestohlen! Unsere Magier vermissen ihre wertvollsten Schriftrollen. Wir müssen zurückerobern, was uns gehört!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Enthüllung 7", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Magier    \"Der Himmelskönig erzeugt eine gewisse Energie... ich kann fast fühlen, wie uns seine Anwesenheit alleine daran hindert, unser volles magisches Potential auszuschöpfen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Verlasst unsere Insel", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0026", "ID_STRING": "POPUP_TXT", "TEXT": "Magier    \"Verlasst sofort unsere Insel! Wir sind dem Himmelskönig treu ergeben, und Außenweltler sind hier nicht willkommen. Ich habe Euren geschwächten Beinen die Gabe verliehen, sich weiter zu bewegen. Nutzt sie gut und geht fort!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Duke Turn Coat", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Herzog    \"Narren! Wer die Dame kennt, kennt das Böse in seiner reinsten Form... Ihre Berührung bedeutet Verzückung; sich von ihr abzuwenden bedeutet Wahnsinn! Die Legionen der Verdammten werden über die unvergleichliche Gespensterdame herfallen.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Empire Turn Coat", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "Erzmagier    \"Warum greifen wir dieses Königreich an? Der Himmelskönig ist ein liebenswürdiger und gerechter Mann... Ich halte das Kaiserreich für den wahren Aggressor! Ich kann und ich werde Euch bei dieser ungerechten Mission nicht unterstützen!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0029", "ID_STRING": "NAME_TXT", "TEXT": "New Event", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN0058", "ID_STRING": "NAME_TXT", "TEXT": "Lanzenträger", "SEQ_NUM": 0},
