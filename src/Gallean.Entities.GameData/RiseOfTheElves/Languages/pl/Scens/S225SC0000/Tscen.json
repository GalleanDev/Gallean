    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225LO0010", "ID_STRING": "NAME_TXT", "TEXT": "Imp. wylot Doliny", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Wieża Yuggina", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Moje czary pomogą ci w twojej misji.", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Tralara", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Kupczę wszystkim, co posiadam.", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Obóz Righona", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Moi żołnierze są najlepsi w regionie.", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0004", "ID_STRING": "TXT_TITLE", "TEXT": "Towary Gruntworta", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225SI0004", "ID_STRING": "TXT_DESC", "TEXT": "Handluję z każdym... kto odpowiednio płaci.", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutralni", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Brak opisu rasy", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Calderic", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Najwyższy z władców krasnoludów, znany jest ze swej zaciętości w bitwie i odwagi w obliczu niesprzyjających okoliczności. Kiedyś przez siedem dni i nocy walczył z wielkim smokiem ARFURUZONEM, by wreszcie go pokonać.", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Gunther", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225PL000a", "ID_STRING": "DESC_TXT", "TEXT": "W czasach młodości ten wielki władca stanął samotnie przeciw wojsku piekieł i pokonał je zapieczętowując bramy, które je wypluwały. Następnie objął suwerenną władzę nad swoim królestwem.", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Jagare", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN0017", "ID_STRING": "NAME_TXT", "TEXT": "Thalrisa", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN001a", "ID_STRING": "NAME_TXT", "TEXT": "Goblin", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN0021", "ID_STRING": "NAME_TXT", "TEXT": "Goblin", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN0024", "ID_STRING": "NAME_TXT", "TEXT": "Ogr", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0001", "ID_STRING": "NAME_TXT", "TEXT": "GK zabij Thalrisę", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Zdaje się, że ten duch, Thalrisa, strzegł wejścia do ukrytej doliny. Boję się pomyśleć, jakie okropieństwa czekają uśpione w jej głębi...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Lok. orkowe ostrzeżenie", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Czempion orków\n\"Nikt nie powinien posiadać tej złej ziemi... Magia jest niedobra!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN0026", "ID_STRING": "NAME_TXT", "TEXT": "Ork", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0003", "ID_STRING": "NAME_TXT", "TEXT": "GK zdob. Runię", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Wreszcie zajęliśmy Runię. Była to ważna placówka Zielonoskórych... Musimy uważać na ich kontrataki.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0006", "ID_STRING": "NAME_TXT", "TEXT": "GK hist. Thalrisy", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Thalrisa\r\"Tak długo czekałam, by zmierzyć się z nieprzyjaciółmi... Nareszcie zemszczę się na prześladowcach i pozbędę się was tak, jak wy chcieliście pozbyć się mnie... I nawet jeśli moi nieszczęśni strażnicy żywiołów rozpłynęli się, wywrę swą zemstę!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN002a", "ID_STRING": "NAME_TXT", "TEXT": "Ogr", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0008", "ID_STRING": "NAME_TXT", "TEXT": "GK Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Najwyższy król powierzył nam zadanie zasiedlenia tej doliny i zebrania dostępnych tu wielkich zasobów many.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Niestety obawiający się magii Zielonoskórzy odkryli nasze plany i są zdecydowani, by wyrzucić nas z doliny. Z drugiej strony Imperium pragnie jej dla siebie.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Oblegają naszą dolinę, aby zmusić nas do poddania. Jeśli chcemy przerwać oblężenie, musimy wysłać posłańca do wylotu doliny na południowym wschodzie, aby poprosił sąsiednie Klany o odsiecz.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN002d", "ID_STRING": "NAME_TXT", "TEXT": "Goblin", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Lok. orkowa pułapka", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000b", "ID_STRING": "NAME_TXT", "TEXT": "GK spotkanie orków", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Czempion orków \n\"Grr! Długo tu nie przetrwacie, krasnale! Zrobiliście błąd przychodząc tutaj. Ostrzegaliśmy was. Teraz nie ujdziecie z życiem!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000c", "ID_STRING": "NAME_TXT", "TEXT": "GK wejście do Runii", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Ork strażnik\n\"Najeżdżacie na dolinę, a teraz wydaje się wam, że najedziecie na nasze wioski? Wy, krasnale, jesteście głupsi niż myśleliśmy!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Wywołaj1", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Włącz wywołanie 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Wywołaj2", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Lok. magia Thalrisy", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Ork \n\"Chcecie magii Thalrisy, ale my nigdy wam jej nie damy! Nie skrzywdzicie Zielonoskórych!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0011", "ID_STRING": "NAME_TXT", "TEXT": "GK plądr. opuszcz. gosp.", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Ta budowla jest bardzo stara, milordzie! Widać, że Zielonoskórzy są w tej dolinie od dawien dawna. Ale czemu? Czy ze względu na magię?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Wejście do Doliny Koszmarów", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "\"Słudzy Thalrisy wciąż jeszcze żyją. Z pewnością szukają pomsty!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0013", "ID_STRING": "NAME_TXT", "TEXT": "GK plądr. Świątynię Thalrisy", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Znieśliśmy klątwę Thalrisy. Przeklęta wróciła do piekielnych otchłani, w których powstała. Możemy teraz bez przeszkód zbierać manę.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Imp. Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Niedawno powrócili zwiadowcy Imperium, przynosząc wieści o ruchach Górskich Klanów w dolinie. Kiedy odkryliśmy przyczynę pojawienia się klanów w tym regionie, zrozumieliśmy, że Imperium musi wkroczyć do akcji.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Te magiczne zasoby są bardzo wartościowe. Klany z pewnością wyślą wołanie o pomoc, dlatego zamknęliśmy wejście do doliny. Bez posiłków kapitulacja wroga jest tylko kwestią czasu.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Doświadczony wojownik, sir Glorcliff, poprowadzi atak na stolicę. Nie możemy zwlekać.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Imp. wejście do Runii", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Ork \n\"Najeżdżacie na dolinę, a teraz wydaje się wam, że najedziecie na nasze wioski? Wy, ludzie, jesteście głupsi niż myśleliśmy!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0016", "ID_STRING": "NAME_TXT", "TEXT": "GK zwycięstwo1", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN003a", "ID_STRING": "NAME_TXT", "TEXT": "Goblin szpieg", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0017", "ID_STRING": "NAME_TXT", "TEXT": "GK zwycięstwo3", "SEQ_NUM": 0}
  ]
}
