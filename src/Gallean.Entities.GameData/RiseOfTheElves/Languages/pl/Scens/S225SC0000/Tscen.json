{
  "formatVersion": 1,
  "rows": [
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0018", "ID_STRING": "NAME_TXT", "TEXT": "GK zwycięstwo2", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Imp. zwycięstwo", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Imp. wylot Doliny", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Ogr \n\"Wam, ludziom, wydaje się, że możecie zająć tę dolinę? To dolina Zielonoskórych! Trzymajcie się z daleka!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Imp. zdob. Gnarthwood", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"To miasto jest ważnym punktem na drodze do przejęcia kontroli nad doliną. Jeśli Klany je utrzymają, bardzo utrudni to naszą kampanię...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Zielonoskórzy byli dobrze wyposażeni. W ich skarbcu znaleźliśmy Księgę Wojny.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN003e", "ID_STRING": "NAME_TXT", "TEXT": "Goblin", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Imp. zdob. Runię", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Wreszcie zajęliśmy Runię. Była to ważna placówka Zielonoskórych... Musimy uważać na ich kontrataki.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN0040", "ID_STRING": "NAME_TXT", "TEXT": "Ork", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Imp. Zabij Thalrisę", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Zdaje się, że ten duch, Thalrisa, strzegł wejścia do ukrytej doliny. Boję się pomyśleć, jakie okropieństwa czekają uśpione w jej głębi...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Imp. plądr. opuszcz. gosp.", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Ta budowla jest bardzo stara, milordzie! Widać, że Zielonoskórzy są w tej dolinie od dawien dawna. Ale czemu? Czy ze względu na magię?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Imp. plądr. Świątynię Thalrisy", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Znieśliśmy klątwę Thalrisy. Przeklęta wróciła do piekielnych otchłani, w których powstała. Możemy teraz bez przeszkód zbierać manę.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN0043", "ID_STRING": "NAME_TXT", "TEXT": "Czempion orków", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0020", "ID_STRING": "NAME_TXT", "TEXT": "GK wywołaj wiadomość 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Zwiadowca \n\"Otrzymaliśmy wiadomość, że nadciągają posiłki orków. Być może maszerują na naszą stolicę!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Imp. wywołaj komunikat 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Zwiadowca \n\"Otrzymaliśmy wiadomość, że nadciągają posiłki orków. Być może maszerują na naszą stolicę!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0022", "ID_STRING": "NAME_TXT", "TEXT": "Imp. piętro Thalrisy", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0022", "ID_STRING": "POPUP_TXT", "TEXT": "Thalrisa\r\"Tak długo czekałam, by zmierzyć się z nieprzyjaciółmi... Nareszcie zemszczę się na prześladowcach i pozbędę się was tak, jak wy chcieliście pozbyć się mnie... I nawet jeśli moi nieszczęśni strażnicy żywiołów rozpłynęli się, wywrę swą zemstę!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Włącz wywołanie 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0024", "ID_STRING": "NAME_TXT", "TEXT": "GK wywołaj wiadomość 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0024", "ID_STRING": "POPUP_TXT", "TEXT": "Zwiadowca \n\"Trolle wysłane przez Zielonoskórych z plemienia Wielkich Gąb zmierzają w stronę miast, milordzie. Musimy wzmocnić obronę!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225UN0048", "ID_STRING": "NAME_TXT", "TEXT": "Ork", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Imp. wywołaj komunikat 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S225SC0000", "ID_OBJECT": "S225EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Zwiadowca \n\"Trolle wysłane przez Zielonoskórych z plemienia Wielkich Gąb zmierzają w stronę miast, milordzie. Musimy wzmocnić obronę!\"", "SEQ_NUM": 0},
