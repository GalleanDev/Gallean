    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Clovis", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Begrezen", "SEQ_NUM": 0},
