    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Nyullokth\n\"Jak... jak mogłeś mnie pokonać?!? Zabijając mnie, pomagasz jedynie Yataa'Halli w dalszym osłabianiu jej ludu. Żałosne... ale... może po jej śmierci Klany przypomną sobie, czym jest wojna!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Rycerz Pegaza\n\"Planują zabicie własnej królowej? Banda dzikusów. Co się stało ze szlachetnymi rasami? Czemu zarówno elfy, jak i krasnoludy postępują tak, jakby postradały rozum?\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Zwycięska misja Nieumarłych", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Nyullokth\n\"Jak... jak mogłeś mnie pokonać?!? Zabijając mnie, pomagasz jedynie Yataa'Halli w dalszym osłabianiu jej ludu. Żałosne... ale... może po jej śmierci Klany przypomną sobie, czym jest wojna!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Lisza Królowa\n\"Ta issstota zbyt dużo mówi. Pomóżcie jej dołączyć do Mortisss...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Zwycięska misja Legionów", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Nyullokth\n\"Jak... jak mogłeś mnie pokonać?!? Zabijając mnie, pomagasz jedynie Yataa'Halli w dalszym osłabianiu jej ludu. Żałosne... ale... może po jej śmierci Klany przypomną sobie, czym jest wojna!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Książę\n\"Zabicie własnej królowej? Może jednak darujemy temu tu życie! Ha ha ha! Te krasnoludy zawsze potrafią mnie rozbawić!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Zwycięska misja Elfów", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Nyullokth\n\"Jak... jak mogłeś mnie pokonać?!? Zabijając mnie, pomagasz jedynie Yataa'Halli w dalszym osłabianiu jej ludu. Żałosne... ale... może po jej śmierci Klany przypomną sobie, czym jest wojna!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Wyrocznia\n\"Śmierci? Co to ma oznaczać? Co on knuł?\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Pierwsza tura wydarzenie", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Nyullokth\n\"Co takiego?!? Siły wroga są w pobliżu? To na pewno sprawka Yataa'Halli.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Nyullokth\n\"Ha ha ha! Ci żałośni śmiertelnicy... czy oni naprawdę myślą, że mogą mnie powstrzymać? Nie po to przeżyłem pięć wilczych epok, aby dać się zniszczyć mizernym wojownikom! Przyszli tu po śmierć!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Near Objective Left", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "\"Zbliżamy się do sił Nyulloktha. Miasta, których szukamy, muszą być nieopodal!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Near Objective Right", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "\"Jesteśmy w pobliżu wojsk Nyulloktha. Miasta muszą być nieopodal!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Near Objective Center", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "\"Bądź ostrożny, Panie... to miasto jest siedzibą Nyulloktha! Musimy się przygotować na spotkanie z nim.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Wieża Undera", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Sprzedam wszystko, co posiadam.", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Wieża Malaviena", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Możesz skorzystać z tomów zgromadzonych w mojej bibliotece.", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Obóz Richarda", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Nie potrzebni ci przypadkiem lojalni żołnierze?", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Obóz Purthena", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Czy potrzebujesz rekrutów?", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233SI0004", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Kilgena", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233SI0004", "ID_STRING": "TXT_DESC", "TEXT": "Myślę, że moja pomoc może ci się przydać.", "SEQ_NUM": 0},
