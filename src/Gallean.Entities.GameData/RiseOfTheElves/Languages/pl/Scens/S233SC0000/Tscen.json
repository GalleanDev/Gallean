    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233UN0007", "ID_STRING": "NAME_TXT", "TEXT": "Eboren", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutralni", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Brak opisu rasy", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233PL0001", "ID_STRING": "NAME_TXT", "TEXT": "Konrad", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233PL0001", "ID_STRING": "DESC_TXT", "TEXT": "W czasach młodości ten wielki władca stanął samotnie przeciw wojsku piekieł i pokonał je zapieczętowując bramy, które je wypluwały. Następnie objął suwerenną władzę nad swoim królestwem.", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233PL0002", "ID_STRING": "NAME_TXT", "TEXT": "Zagamon", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233PL0002", "ID_STRING": "DESC_TXT", "TEXT": "Jego imieniem straszy się dzieci. Ten pan piekieł słynie ze swej krwiożerczości. Mówi się, że kiedyś, w czasie bankietu wdanego przez Bethrezena z okazji zwycięstwa nad królestwem światłości, pożarł tysiąc niewolników.", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233PL0003", "ID_STRING": "NAME_TXT", "TEXT": "Ophaal", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233PL0003", "ID_STRING": "DESC_TXT", "TEXT": "Znana w swoich czasach jako najpotężniejsza mistrzyni mrocznej sztuki, władczyni ta zabita została przez inkwizytora Vorgela, który położył kres jej bezeceństwom. Teraz została wskrzeszona jako nieumarła i pragnie władać wszystkimi śmiertelnikami.", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233PL0004", "ID_STRING": "NAME_TXT", "TEXT": "Eldis", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233PL0004", "ID_STRING": "DESC_TXT", "TEXT": "Weteran wojny o odzyskanie chwały elfów - nikt nie wkroczy do lasu bez jego wiedzy.", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233UN002c", "ID_STRING": "NAME_TXT", "TEXT": "Nyullokth", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233UN002f", "ID_STRING": "NAME_TXT", "TEXT": "Niebieski smok", "SEQ_NUM": 0},
