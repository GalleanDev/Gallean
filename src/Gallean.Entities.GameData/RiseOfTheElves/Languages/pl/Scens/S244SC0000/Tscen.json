    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244LO0002", "ID_STRING": "NAME_TXT", "TEXT": "Atak błyskawicy", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244LO0003", "ID_STRING": "NAME_TXT", "TEXT": "Klątwa Gamory", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244LO0004", "ID_STRING": "NAME_TXT", "TEXT": "Wiadomość ducha", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244LO0005", "ID_STRING": "NAME_TXT", "TEXT": "Komunikat Pani", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244LO0006", "ID_STRING": "NAME_TXT", "TEXT": "Czarownik", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244LO0007", "ID_STRING": "NAME_TXT", "TEXT": "Niebieska błyskawica", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244LO0008", "ID_STRING": "NAME_TXT", "TEXT": "Niebieska błyskawica 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244LO0009", "ID_STRING": "NAME_TXT", "TEXT": "'Widmowa Pani 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244LO000a", "ID_STRING": "NAME_TXT", "TEXT": "Opuść naszą wyspę", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244LO000b", "ID_STRING": "NAME_TXT", "TEXT": "Legion zmiana barw", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244LO000c", "ID_STRING": "NAME_TXT", "TEXT": "Orcs", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Sallata", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Moje towary pomogą ci w twojej misji.", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Wieża Nibora", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244SI0003", "ID_STRING": "TXT_DESC", "TEXT": "\"Mogę cię obronić przed Widmową Panią i Niebiańskim Królem.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutralni", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Brak opisu rasy", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Goar", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244PL0009", "ID_STRING": "DESC_TXT", "TEXT": "W czasach młodości ten wielki władca stanął samotnie przeciw wojsku piekieł i pokonał je zapieczętowując bramy, które je wypluwały. Następnie objął suwerenną władzę nad swoim królestwem.", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Ekrezem", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Jego imieniem straszy się dzieci. Ten pan piekieł słynie ze swej krwiożerczości. Mówi się, że kiedyś, w czasie bankietu wdanego przez Bethrezena z okazji zwycięstwa nad królestwem światłości, pożarł tysiąc niewolników.", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Ardobert", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN000f", "ID_STRING": "NAME_TXT", "TEXT": "Czempion orków", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN0017", "ID_STRING": "NAME_TXT", "TEXT": "Thug", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN0019", "ID_STRING": "NAME_TXT", "TEXT": "Thug", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN001b", "ID_STRING": "NAME_TXT", "TEXT": "Thug", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN001c", "ID_STRING": "NAME_TXT", "TEXT": "Leśny elf", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN001f", "ID_STRING": "NAME_TXT", "TEXT": "Centaur włócznik", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN0021", "ID_STRING": "NAME_TXT", "TEXT": "Centaur włócznik", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Gratulacje", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0004", "ID_STRING": "POPUP_TXT", "TEXT": " Rycerz pegazów \n\"Bitwa toczy się, dopóki ciało Króla Niebieskiego nie padnie bez życia na ziemię! Imperium dowiodło swej siły i zawładnęło kolejnym królestwem. Ale co się dzieje? Ciało Króla Niebieskiego znika?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN0029", "ID_STRING": "NAME_TXT", "TEXT": "Leśny elf", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Centaur atakuje", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Centaur włócznik \n\"Zniszczyć Imperium! Do boju, za krzywdy!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Tekst zwycięstwa", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Uczeń \n\"Król otrzymał wiadomość z gwiazd... Dowiedzieliśmy się, że w szeregach Imperium szerzy się zepsucie! Chwała Xenosowi, Królowi Niebieskiemu!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Ostrzeżenie elfów", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Mroczny Władca \n\"Król Niebieski? To słaby głupiec! Mieszka za lasem. Zakładam, że elfy nie pozwolą wam pożyć wystarczająco długo, byście go poznali. Ha ha ha...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Ork strażnik", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Ork strażnik 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Nowa Gamora", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Ashkael \n\"Wraz z pokonaniem Widmowej Pani z Nowej Gamory odzyskaliśmy sekrety heretyckich magów...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN0032", "ID_STRING": "NAME_TXT", "TEXT": "Wódz zbirów", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Nowa Gamora - wiadomość 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Widmowa Pani \n\"Poddajemy się...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Zamek Xenosa wiadomość 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Łowca czarownic \n\"Legiony Potępionych reprezentują wszystko to, przeciw czemu walczyliśmy. To jeszcze nie koniec!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Atak błyskawicy", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Nowa Gamora - klątwa", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Widmowa Pani\n\"Nowa Gamora nigdy nie wpadnie w obce ręce... Poczujcie gniew zakazanego miasta, do którego nigdy nie wkroczycie!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Sorenburg", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Elf tropiciel \n\"Elfy są liczne i zajadłe! Wygnamy was z naszych ziem!", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Wiadomość ducha", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Duch \n\"Zawróć, młodziku... a zobaczysz ponownie wschód słońca. Podejdź bliżej... A nie dożyjesz jego zachodu.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Wiadomość ducha Leg.", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Duch \n\"Widmowej Pani nie można pokonać! Przyłączcie się do orszaku chwały i ciemności Nowej Gamory! Porzućcie dawne herezje. Zniszczymy to, czym jesteście teraz i zmienimy was w coś pięknego. Nie bójcie się...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Dziwaczna wizyta 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Mroczny Władca \n\"Zniszczyć demony! Wysłać je z powrotem do ich brudnego więzienia!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Widmowa Pani", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Widmowa Pani\n\"Pokłońcie się Widmowej Pani z Nowej Gamory! Poczujcie moc własssnej magii i ugnijcie się przed moją potęgą, heretycy!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Czarownik", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Czarownik \n\"Przejęliśmy tę wieżę w imię chaosu. Imperium nigdy nie pokona sił zła!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Imperium historia", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Paladyn \n\"Musimy znaleźć i zniszczyć królestwo Xenosa! Władca ten, znany jako Król Niebieski, jest wrogiem Imperium! Powiedział elfom, że Imperium zamierza zniszczyć ich leśne domy, aby przedrzeć się do jego państwa. Musimy przysposobić siły do ataku.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Pegaz", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Łowca czarownic \n\"Król Niebieski nas pomści!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Druga wiadomość pegaza", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Łowca czarownic \n\"Legiony Potępionych? Mogliśmy się domyśleć! Po tym, jak zła wiedźma zajęła Nową Gamorę, siły zła z pewnością zabiorą się za nas!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Nowa Gamora - ostrzeżenie", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Widmowa Pani\n\"Nowa Gamora będzie chronić ssswych granic... I klątwa spadnie na każdego obcego, który spróbuje je przekroczyć!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Niebieska błyskawica", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Niebieska błyskawica 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Rycerz pegazów \n\"Król Niebieski wie, że tu jesteśmy! Spieszmy się!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0023", "ID_STRING": "NAME_TXT", "TEXT": "'Widmowa Pani 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0023", "ID_STRING": "POPUP_TXT", "TEXT": "Arcyczart \n\"Widmowa Pani wie, że ją ścigamy! To nieistotne. Znajdziemy ją i weźmiemy, co nasze...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0024", "ID_STRING": "NAME_TXT", "TEXT": "Legion historia", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0024", "ID_STRING": "POPUP_TXT", "TEXT": "Ashkael \n\"Głupiec, który nie pożyje długo, dokonał niemożliwego - okradł Legiony Potępionych! Nasi magowie stracili swe najcenniejsze zwoje. Ten cios osłabił Zakon Magów... musimy odebrać, co do nas należy!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Objawienie 7", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Mag \n\"Istnieje pewna energia, którą emanuje Król Niebieski... Niemal wyczuwam, że jego obecność nie pozwala nam na osiągnięcie pełnego potencjału magicznego!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Opuść naszą wyspę", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0026", "ID_STRING": "POPUP_TXT", "TEXT": "Mag \n\"Natychmiast opuśćcie naszą wyspę! Jesteśmy wierni Królowi Niebieskiemu i nie wpuszczamy cudzoziemców. Dałem waszym osłabionym nogom nowe siły... Użyjcie tego daru mądrze i odejdźcie stąd!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Książe zmiana barw", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Książe \n\"Głupcy! Poznać Panią, znaczy poznać najczystsze zło... Jej dotyk to ekstaza; unikanie jej boskiego wpływu to szaleństwo! Legiony Potępionych ugną się przed niezrównaną Widmową Panią.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Imperium zmiana barw", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "Arcymag \n\"Dlaczego atakujemy to królestwo? Król Niebieski jest dobrym i sprawiedliwym władcą... Imperium zachowuje się jak agresor! Nie mogę i nie będę pomagał w realizacji tych podłych zamiarów!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Nowe zdarzenie", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN0058", "ID_STRING": "NAME_TXT", "TEXT": "Włócznik", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN005c", "ID_STRING": "NAME_TXT", "TEXT": "Ork strażnik", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN0061", "ID_STRING": "NAME_TXT", "TEXT": "Włócznik", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN006c", "ID_STRING": "NAME_TXT", "TEXT": "Wyznawca", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN0070", "ID_STRING": "NAME_TXT", "TEXT": "Widmo", "SEQ_NUM": 0},
