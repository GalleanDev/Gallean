    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV0000", "ID_STRING": "NAME_TXT", "TEXT": "WPROWADZENIE - ELFY", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Draniell\n\"Od kilku miesięcy pojawia się tu coraz więcej ludzi, ale, co dziwne, nie wyglądają oni na powiązanych z Imperium Emry'ego... są raczej wyrzutkami...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Draniell\n\"Niedawno pojawiła się grupa potężnych pielgrzymów. Jeśli zdołają zjednoczyć pozostałe grupy w regionie, wtedy ich siła będzie stanowiła dla nas problem. Trzeba temu zapobiec, zabijając ich przywódcę!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV0001", "ID_STRING": "NAME_TXT", "TEXT": "WPROWADZENIE - IMPERIUM", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Karasten\n\"Musimy zgromadzić rywalizujące na tym obszarze klany i zawrzeć przymierze - w przeciwnym wypadku nie uda nam się przepędzić stąd elfów i demonów. Potrzebne nam wsparcie Drevrieve, Clansmith i Bragren.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Karasten\n\"Wątpię, czy posłuchają byle kogo - sam muszę się do nich udać. To powinno przekonać ich o naszych dobrych zamiarach.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV0002", "ID_STRING": "NAME_TXT", "TEXT": "WPROWADZENIE - LEGIONY", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Garkumat\n\"My głodni... czemu czekać? My... głodni... ludzie, już tak wielu... musimy się pożywić.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Herasin\n\"Jak miałbym was wszystkich powstrzymać? Bethrezen zostawił nas, byśmy tu zgnili, ale nie poddamy się tak łatwo. Wysłuchajcie mnie, demony! Ludzie wciąż się gromadzą. Musimy ich powstrzymać.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Herasin\n\"Zawsze ciężej unicestwić całą armię, zwłaszcza gdy jesteśmy osłabieni. Lepiej pożryj dowódcę głównej grupy. Jego śmierć wprowadzi zamęt w szeregach, a wtedy łatwo się pożywimy... znowu.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Z - IMPERIUM - ZWYCIĘSTWO", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Karasten\n\"Sprawujemy teraz pełną kontrolę nad tym obszarem. Imperium się od nas odwróciło, tak więc zaczniemy wszystko od nowa. Moi wierni pielgrzymi, jesteśmy w domu.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV0004", "ID_STRING": "NAME_TXT", "TEXT": "KARASTEN - Clansmith", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Karasten\n\"Mieszkańcy Clansmith sprzymierzyli się z nami! Musimy utrzymać kontrolę nad tym miastem.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV0005", "ID_STRING": "NAME_TXT", "TEXT": "KARASTEN - Bragen", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Karasten\n\"Mieszkańcy Bragen sprzymierzyli się z nami! Musimy szybko pomóc im wznieść umocnienia!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV0006", "ID_STRING": "NAME_TXT", "TEXT": "KARASTEN - Drevrieve", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Karasten\n\"Mieszkańcy Drevrieve sprzymierzyli się z nami! Przygotować się do obrony, by nie zaskoczył nas wróg!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Z - LEGIONY - ZWYCIĘSTWO", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Herasin\n\"Wybraniec poległ! Dziś w nocy ta ziemia spłynie krwią, a krzyki przerażenia zabrzmią raz jeszcze! Niech rozpocznie się uczta!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Z - ELFY - ZWYCIĘSTWO", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Draniell\n\"Nasz gaj jest znów bezpieczny. Zagrożenie ze strony ludzi zostało zażegnane... na razie.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV0009", "ID_STRING": "NAME_TXT", "TEXT": "ZABIJ - KARASTEN", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "\"Przywódca pielgrzymów został zabity, a jego rozkazy przechwycone.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV000a", "ID_STRING": "NAME_TXT", "TEXT": "KARASTEN ZABITY", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "\"Przedwczesna śmierć Karastena wywołała chaos wśród pielgrzymów. Rozgorzała długa i okrutna wojna, w której wszystkie ze stron poniosły ciężkie straty.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV000b", "ID_STRING": "NAME_TXT", "TEXT": "SI - IMPERIUM - 0", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV000c", "ID_STRING": "NAME_TXT", "TEXT": "SI - IMPERIUM - 0 ukończone", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV000d", "ID_STRING": "NAME_TXT", "TEXT": "SI - IMPERIUM - 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV000e", "ID_STRING": "NAME_TXT", "TEXT": "SI - IMPERIUM - 1 ukończone", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204EV000f", "ID_STRING": "NAME_TXT", "TEXT": "SI - IMPERIUM - 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Wieża Drashwall", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Wszystkie zaklęcia były testowane na żywych istotach. Satysfakcja gwarantowana!", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Towary u Szczęściarza Blateratha", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Są pieniądze, są towary. Nie ma pieniędzy, nie ma towarów. To proste.", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Lombard \"Obdarty Sztyletem\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Dopóki nie pytasz, skąd to wszystko mam... możesz kupować do woli!", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Legowisko łowcy głów", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Najlepiej ich wynająć, zanim zaczną na ciebie polować!", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204SI0004", "ID_STRING": "TXT_TITLE", "TEXT": "Obóz Yggara", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204SI0004", "ID_STRING": "TXT_DESC", "TEXT": "Tutaj szkolili się najwięksi wojownicy tego królestwa.", "SEQ_NUM": 0},
