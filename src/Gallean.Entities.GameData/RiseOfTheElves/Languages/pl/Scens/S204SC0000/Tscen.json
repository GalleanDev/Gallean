    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204PL0001", "ID_STRING": "NAME_TXT", "TEXT": "Hatton", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204PL0001", "ID_STRING": "DESC_TXT", "TEXT": "W czasach młodości ten wielki władca stanął samotnie przeciw wojsku piekieł i pokonał je zapieczętowując bramy, które je wypluwały. Następnie objął suwerenną władzę nad swoim królestwem.", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204PL0002", "ID_STRING": "NAME_TXT", "TEXT": "Ekrezem", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204PL0002", "ID_STRING": "DESC_TXT", "TEXT": "Jego imieniem straszy się dzieci. Ten pan piekieł słynie ze swej krwiożerczości. Mówi się, że kiedyś, w czasie bankietu wdanego przez Bethrezena z okazji zwycięstwa nad królestwem światłości, pożarł tysiąc niewolników.", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204PL0003", "ID_STRING": "NAME_TXT", "TEXT": "Erwylle", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204PL0003", "ID_STRING": "DESC_TXT", "TEXT": "Weteran wojny o odzyskanie chwały elfów - nikt nie wkroczy do lasu bez jego wiedzy.", "SEQ_NUM": 0},
