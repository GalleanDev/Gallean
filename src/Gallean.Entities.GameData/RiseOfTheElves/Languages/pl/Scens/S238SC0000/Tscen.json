    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238LO0021", "ID_STRING": "NAME_TXT", "TEXT": "Sophic Angel Appears", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Reddena", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Moje towary pomogą ci w twojej misji.", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Wieża Othona", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Moje czary są najpotężniejsze w regionie.", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutralni", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Brak opisu rasy", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Calderic", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Najwyższy z władców krasnoludów, znany jest ze swej zaciętości w bitwie i odwagi w obliczu niesprzyjających okoliczności. Kiedyś przez siedem dni i nocy walczył z wielkim smokiem ARFURUZONEM, by wreszcie go pokonać.", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Khagrael", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238PL000a", "ID_STRING": "DESC_TXT", "TEXT": "W swoich czasach znany jako najpotężniejszy mistrz mrocznej sztuki, władca ten zabity został przez inkwizytora Vorgela, który położył kres jego bezeceństwom. Teraz jest wskrzeszony jako nieumarły i pragnie nagiąć do swej woli wszystkich śmiertelników.", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Heiric", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN001a", "ID_STRING": "NAME_TXT", "TEXT": "Wyznawca Synclair", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN001c", "ID_STRING": "NAME_TXT", "TEXT": "Wyznawca Synclair", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0021", "ID_STRING": "NAME_TXT", "TEXT": "Leśny elf", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Dead Zone", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "_", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Plaga", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Akolita heretyckiego kultu\n\"Nikt nie pożyje dość długo, aby ujrzeć twarz Synclair! Dziecię Solarisa zostanie ochronione, chwała Scyonowi!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Taura City", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Mędrzec \n\"Demon szerzy nienawiść poprzez rzeki Jedności. Jego nienawiść do wszystkich żywych stworzeń jest tak głęboka, jak przenoszące ją wody - Scyon zniszczy każdego, kto odważy się do niego zbliżyć.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0026", "ID_STRING": "NAME_TXT", "TEXT": "Wyznawca Synclair", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Fire Attack", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Akolita heretyckiego kultu\n\"Śmierć intruzom!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0029", "ID_STRING": "NAME_TXT", "TEXT": "Wyznawca Synclair", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Winter Curse", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Akolita heretyckiego kultu\n\"Niechaj mroźne wichry powstrzymają wszystkich, którzy chcą zaszkodzić Scyonowi!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Healing Lake", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Duch anioła mądrości\n\"Mój duch płynie w tych wodach, a mój dotyk leczył niegdyś chorych i słabych... Jednak Synclair i jej kultyści przejęli moją moc i magia wód uległa rozproszeniu... \"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Healing Waters Two", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Duch anioła mądrości\n\"Jestem tylko widmem tego, co już było. Niedawno jeszcze wody te miały wspaniałe własności lecznicze, lecz jednego dnia ich magia została rozproszona! Dowiedzieliśmy się, że moc leczniczą ukradła Synclair i heretycy z jej kultu.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN002c", "ID_STRING": "NAME_TXT", "TEXT": "Wyznawca Synclair", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Water Healing Three", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Duch anioła jedności\n\"Scyon i jego wyznawcy zamieniają dobre miejsce w siedlisko zła. Będę cię wspierać w imię dobra Jedności.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Protect City", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Water Healing Four", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Duch anioła jedności\n\"Pomogę ci pokonać pomiot Synclair. Zrozum jednak, moje dziecko - gdy tylko heretycki kult zostanie pokonany, musisz opuścić to miejsce!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000d", "ID_STRING": "NAME_TXT", "TEXT": "M Clans Story", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Gilgam Koczownik\n\"Scyon to pomiot wiedźmy Synclair i uzdrowiciela Solarisa... Jego dziedzictwem są różne odporności i wielkie zdolności lecznicze , co czyni z niego bardzo groźnego przeciwnika.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Calderic \n\"Gilgamie, po co mam szukać tych ludzi? Powinniśmy podbić tę krainę i za jej złoto pić i weselić się przez całą noc.\" \n", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Gilgam Koczownik\n\"Starczy tego - lepiej mnie słuchaj. Nie otrzymasz dowództwa pełnej drużyny, dopóki nie dowiedziesz swej wartości.\" \n", "SEQ_NUM": 2},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Undead Story", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Hu'lyr z Hord Nieumarłych \n\"Cała ta kraina passsskudnie śmierdzi! Wyczuwam tu jednak coś znajomego, jakby sssstarego wroga...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Zythaar \n\"Twoje obawy mnie nie obchodzą, głupcze. Wszyscy mają robić, co każę - nie mamy wiele czasu. Nasi wrogowie nie będą się kryć wiecznie!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' lyr \n\"Masz mnie sssłuchać i wykonywać moje polecenia! Czeka cię kara za twój wybuch - ograniczę twoją kontrolę nad wojskiem. Zrozum - jesteś tylko bezwolnym narzędziem mojej woli!\" \n", "SEQ_NUM": 2},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Taura Message", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Mędrzec \n\"Te księgi opisują klątwę spoczywającą na tej krainie... Jeśli ktokolwiek zajmie tu zamek, to pojawią się złe istoty z zamiarem jego odbicia.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Suldon", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Akolita heretyckiego kultu\n\"Scyon nie spocznie, póki nie odszuka wrogów swej matki i ich nie zniszczy. Wraz ze swymi wyznawcami wszystkich poświęci rzece.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Forest Citadel", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Akolita heretyckiego kultu\n\"Anioł pobłogosławił niegdyś te wody, które leczyły przez długi czas okoliczną ludność... Ale na szczęście już tak nie jest, dzięki wielkiemu Scyonowi. Chwała Scyonowi, cześć jego mrocznej woli!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Satora", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Akolita heretyckiego kultu\n\"Scyon zniszczy każdego, kto wkroczy do miasta. Chwała potwornemu Scyonowi!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Scyon Mountain Clans", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Scyon Undead", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN003b", "ID_STRING": "NAME_TXT", "TEXT": "Leśny elf", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Victory Mountain Clans", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Gilgam Koczownik\n\"Dzięki ciężkiej pracy i wielu wyrzeczeniom Górskie Klany zatryumfowały. Udało się nam zniszczyć heretycki kult, a ludność Jedności będzie teraz mogła w spokoju prowadzić swój żywot. Obyśmy mogli żyć wiecznie!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Victory Undead", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' lyr \n\"Pokonaliśmy heretycki kult i wypędziliśmy Sssscyona! Sssynclair gdzieś się zapodziała, jednak i ona i Górskie Klany przekonali się, że nikt i nic nie powstrzyma Hord Nieumarłych!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Zythaar Betrayal", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Akolita heretyckiego kultu\n\"Nieumarli głupcy! Nikt się nie oprze wezwaniu Synclair! Dołączcie do nas! Dołączcie i poznajcie, czym jest prawdziwa potęga! Cały czas wasze szeregi słabną...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Zythaar \n\"Jeszcze się okaże, kto tu włada prawdziwą potęgą! Kto tu jest głupcem! Hordy Nieumarłych posmakują mego ostrza!\" \n", "SEQ_NUM": 3},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Calderic Betrayal", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Akolita heretyckiego kultu\n\"Dołączcie do nas... Dołączcie do nas... Poczujcie krążącą w waszych żyłach czystą moc... Poznajcie piękno Synclair! Niech miejsce rozumu zajmie u was oddanie Synclair!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Calderic \n\"Gilgamie, odpłacę ci mieczem za twą niekompetencję. Wszyscy twoi podwładni staną się moimi celami, a na końcu to ja odniosę tryumf wraz z heretykami.\" \n", "SEQ_NUM": 3},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Undead Story Day Two", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Hu'Lyr  \n\"To mi coś przypomina... Wyczuwam tu robotę Legionu. Coś tu nie gra, a ja chcę się dowiedzieć co.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Zythaar \n\"Jedyną taką rzeczą jesteś ty jako dowódca. W porównaniu do Mortissss jesteś wiossssskowym głupkiem.\" \n", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Hu'lyr \n\"Zythaarze, ostrzegałem cię, abyś nie podważał mojej władzy! Po zakończeniu tej misji czekają cię tysssiącletnie męki. Nie wssspominaj też nigdy imienia Mortiss, pokraczna kreaturo.\" \n", "SEQ_NUM": 2},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Undead Story Turn 5", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' Lyr \n\"Już wiem, o co chodzi! Obywatele Jedności poddali się władzy heretyckiego kultu tak ssssamo, jak my! Musssimy odnaleźć Sssscyona, zanim nie będzie za późno!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0020", "ID_STRING": "NAME_TXT", "TEXT": "M Clans Story 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Gilgam Koczownik\n\"Poznaję ten zapach... Istniał niegdyś kult, który wykorzystywał w swych obrzędach siarkę, tworząc jakieś serum kontroli nad umysłami... Oni muszą tu działać! Trzeba chronić nasz lud...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Calderic \n\"Jedynym smrodem, jaki ja wyczuwam jest twoje tchórzostwo i niekompetencja. Jak śmiesz ograniczać mą władzę i publicznie mnie krytykować? Toleruję cię tylko dla chwały Wotana.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Gilgam Koczownik \n\"Caldericu, nadużywasz mej cierpliwości. Nigdy więcej nie podważaj mego autorytetu! Dowodzę, gdyż byłem już w tej krainie. Po zakończeniu tej misji czeka cię areszt domowy, a my będziemy pić i świętować.\" \n", "SEQ_NUM": 2},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Calderic \n\"....\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0021", "ID_STRING": "NAME_TXT", "TEXT": "M Clan Day 6", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Mędrzec \n\"Smród jest wyraźniejszy! Tych heretyków nie wolno lekceważyć... Calderica już straciliśmy - sądzę, że wkrótce nas zaatakują.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0044", "ID_STRING": "NAME_TXT", "TEXT": "Giermek", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Taura", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0047", "ID_STRING": "NAME_TXT", "TEXT": "Giermek", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0024", "ID_STRING": "NAME_TXT", "TEXT": "Beast goes Berzerk", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0024", "ID_STRING": "POPUP_TXT", "TEXT": "Akolita heretyckiego kultu\n\"Nadeszła godzina naszego gniewu! Naprzód, sługi Scyona! Zniszczcie wrogów na chwałę naszego pana!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0025", "ID_STRING": "NAME_TXT", "TEXT": "M Clans Turn 10", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Gilgam Koczownik\n\"Dowiedziałem się, że musimy zdobyć trzy miasta - wtedy ujawni się sam Scyon!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Undead Story Turn 10", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0026", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' Lyr \n\"Musimy zdobyć trzy miasta, tylko wtedy ukaże się Sssscyon. Zniszczymy przeklętą bessstię, gdy tylko pokaże tu sssswą plugawą mordę!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0027", "ID_STRING": "NAME_TXT", "TEXT": "If Calderic Dies", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Z gets killed", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN004c", "ID_STRING": "NAME_TXT", "TEXT": "Giermek", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Satora Message", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0029", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' lyr \n\"Ukaż się, Sssscyonie! Hordy Nieumarłych nie lękają się ciebie. To ty się ich boisz.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Undead Troll Attack", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV002c", "ID_STRING": "NAME_TXT", "TEXT": "M Clans Ogre Attack", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV002d", "ID_STRING": "NAME_TXT", "TEXT": "Undead Turn 29", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' Lyr \n\"Heretycki kult planuje na nasssss atak! Musssssimy się na to przygotować... Chcą wykorzystać osłabienie Ashgana!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV002e", "ID_STRING": "NAME_TXT", "TEXT": "Mountain Attack", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV002e", "ID_STRING": "POPUP_TXT", "TEXT": "Gilgam Koczownik\n\"Heretycy planują atak! Musimy być przygotowani na wszystko...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV002f", "ID_STRING": "NAME_TXT", "TEXT": "Remove Lava Pits", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0053", "ID_STRING": "NAME_TXT", "TEXT": "Wódz zbirów", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0030", "ID_STRING": "NAME_TXT", "TEXT": "Undead Story Day 9", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0030", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' Zar  \n\"Rozmawiałem z niesssspokojnymi wojami śmierci. Muszą się przygotować na obronę Ashgana, a heretycy mogą zaatakować naszego strażnika w każdej chwili!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0031", "ID_STRING": "NAME_TXT", "TEXT": "M Clans Day 9", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0031", "ID_STRING": "POPUP_TXT", "TEXT": "Mędrzec \n\"Musimy chronić Vithara przez plugawą Synclair! Jej żądza mocy jest niewyczerpalna... A jeśli uda się jej lub jej sługom pokonać Vithara, to będzie mogła zaabsorbować jego energię życiową. Musimy się dobrze przygotować!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0031", "ID_STRING": "POPUP_TXT", "TEXT": "Vithar \n\"Niech przyjdzie ta wiedźma, łaknę porządnej walki!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0056", "ID_STRING": "NAME_TXT", "TEXT": "Giermek", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0033", "ID_STRING": "NAME_TXT", "TEXT": "MClans Day 60", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0033", "ID_STRING": "POPUP_TXT", "TEXT": "Akolita heretyckiego kultu\n\"Na chwałę Synclair i sławę jej pomiotu z Solarisem pokonamy naszych wrogów!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0034", "ID_STRING": "NAME_TXT", "TEXT": "UHordes Day 60 Attack", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0034", "ID_STRING": "POPUP_TXT", "TEXT": "Akolita heretyckiego kultu\n\"Chwała niech będzie Synclair i jej mrocznemu sercu! Nadszedł już czas - ukorzcie się przed naszą potęgą! Spójrzcie w twarze stojących przeciwko wam waszych dawnych podwładnych i zrozumcie, że wasz czas już minął...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0035", "ID_STRING": "NAME_TXT", "TEXT": "Undead Day 55", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0035", "ID_STRING": "POPUP_TXT", "TEXT": "Akolita heretyckiego kultu\n\"Czas nie jest waszym sprzymierzeńcem i wkrótce przegracie z nim walkę. Nadeszła chwila, w której Synclair i jej wyznawcy odzyskają należne im miejsce!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0059", "ID_STRING": "NAME_TXT", "TEXT": "Giermek", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0036", "ID_STRING": "NAME_TXT", "TEXT": "MClans Day 55", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0036", "ID_STRING": "POPUP_TXT", "TEXT": "Akolita heretyckiego kultu\n\"A walczcie - wasza porażka jest pewna! Z radością będziemy patrzeć na wasze błagalne jęki, aby pozwolić wam się do nas przyłączyć! Walczcie ze świadomością, że Synclair i tak zatryumfuje!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0037", "ID_STRING": "NAME_TXT", "TEXT": "M Clans Day 52", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0037", "ID_STRING": "POPUP_TXT", "TEXT": "Mędrzec \n\"Musimy być gotowi na wszystko! Synclair i jej wyznawcy mogą zaatakować naszą stolicę, próbując przejąć na własny użytek moc Vithara.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0038", "ID_STRING": "NAME_TXT", "TEXT": "U Day 52", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0038", "ID_STRING": "POPUP_TXT", "TEXT": "Hu'lyr \n\"Synclair! Jakże paskudnie brzmi to imię... Wkrótce jej sssługi nasss zaatakują... Trzeba chronić przed jej wyznawcami Ashgana.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0038", "ID_STRING": "POPUP_TXT", "TEXT": "Ashgan \n\"Nie potrzeba nam żadnej ochrony... Dajcie im do nas przyjśśśśśśść.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0039", "ID_STRING": "NAME_TXT", "TEXT": "U Day 8", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0039", "ID_STRING": "POPUP_TXT", "TEXT": "Szkielet \n\"Coś ossssłabia Asssshgana... Coś mu kradnie energię - to coś w powietrzu! Słyszę lodowaty, obmierzły rechot dobiegający z oddali...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003a", "ID_STRING": "NAME_TXT", "TEXT": "M Clans day 8", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003a", "ID_STRING": "POPUP_TXT", "TEXT": "Gilgam Koczownik\n\"Vithar słabnie... Coś jest w powietrzu. To chyba siarka pozbawia go energii - musimy się mieć na baczności, nie wiadomo, do czego posłuży zabrana Vitharowi energia!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003a", "ID_STRING": "POPUP_TXT", "TEXT": "Vithar \n\"Nic mi nie jest, nie martwcie się.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003c", "ID_STRING": "NAME_TXT", "TEXT": "Legions Appear", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003c", "ID_STRING": "POPUP_TXT", "TEXT": "Akolita heretyckiego kultu\n\"Chwała Scyonowi i jego wszechmocnemu gniewowi! Przyłączcie się do nas lub gińcie okrutną śmiercią!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003d", "ID_STRING": "NAME_TXT", "TEXT": "Empire Appears", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003d", "ID_STRING": "POPUP_TXT", "TEXT": "Akolita heretyckiego kultu\n\"Każdego dnia rośnie potęga heretyckiego kultu... Wszędzie pełno jest głupców o słabych umysłach, których nic nie chroni przed mocą Synclair. Wkrótce wasz Vithar legnie pod naporem naszych armii.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003e", "ID_STRING": "NAME_TXT", "TEXT": "M Clans day 19", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003e", "ID_STRING": "POPUP_TXT", "TEXT": "Gilgam Koczownik\n\"Miasta Taura chroni zielonoskóry smok. Pojawia się tam od czasu do czasu - podobno zjawia się w ciągu kilku dni od zajęcia miasta celem jego odzyskania... A my musimy Taurę utrzymać za wszelką cenę.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003f", "ID_STRING": "NAME_TXT", "TEXT": "Taura Dragon", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0040", "ID_STRING": "NAME_TXT", "TEXT": "U Day Two", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0040", "ID_STRING": "POPUP_TXT", "TEXT": "Hu'nskel \n\"Mówi sssssię, że Sssscyon szszszuka ssssswego ojca, Sssssolarissssa! Możemy go wywabić, zdobywając trzy miasta - Sssuldon, Sssatorię i Taurę; gdy znajdą się wszszszyssstkie w naszej mocy, Sssscyon sssspróbuje je odbić!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0063", "ID_STRING": "NAME_TXT", "TEXT": "Wyznawca", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0041", "ID_STRING": "NAME_TXT", "TEXT": "M Clans Day Two", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0041", "ID_STRING": "POPUP_TXT", "TEXT": "Mędrzec \n\"Jeśli chcemy wywabić Ssscyona, to musimy zagrozić jego ziemiom. Jeśli uda się nam zdobyć Taurę, Satorię i Leśną Cytadelę, to Scyon z pewnością osobiście spróbuje je odbić.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0042", "ID_STRING": "NAME_TXT", "TEXT": "MClans Day 28 Advice", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0042", "ID_STRING": "POPUP_TXT", "TEXT": "Gilgam Koczownik\n\"Coś tu nie gra... Chyba lepiej zostawić część naszych wojsk w stolicy - Vithar jest osłabiony, a nam nie wolno ryzykować!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0043", "ID_STRING": "NAME_TXT", "TEXT": "U Hordes Day 28  Advice", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0043", "ID_STRING": "POPUP_TXT", "TEXT": "Huz' Rala Rycerz Śmierci\n\"Heretycy są niebezpieczni! Nalegam, aby pozostawić na tyłach część naszych Hord... Ashgan nie dysponuje pełnią swojej mocy - nie możemy ryzykować w starciu z tym kultem.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0043", "ID_STRING": "POPUP_TXT", "TEXT": "Ashgan \n\"Jesssst dobrze... Mięssssa... Dajcie nam mięsssa!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0044", "ID_STRING": "NAME_TXT", "TEXT": "Mountain Day 40", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0044", "ID_STRING": "POPUP_TXT", "TEXT": "Gilgam Koczownik\n\"Za wszelką cenę musimy się przygotować... Heretycy na pewno zaatakują w chwili, gdy Vithar będzie osłabiony, a ich władza nad mrocznymi sztukami to dla nas poważne zagrożenie. Przeklęte natarcie może zostać wyprowadzone w każdej chwili!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0047", "ID_STRING": "NAME_TXT", "TEXT": "Undead 41 warning", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0047", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' Zar \n\"Ashgan jest słaby, a nasz wróg z pewnością wykorzysta tę okazję! Nie damy się pokonać - jesteśmy Hordami Nieumarłych i rozprawimy się z wszystkimi atakującymi Ashgana!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV004b", "ID_STRING": "NAME_TXT", "TEXT": "M day 57", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV004d", "ID_STRING": "NAME_TXT", "TEXT": "Mclans day 31", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV004d", "ID_STRING": "POPUP_TXT", "TEXT": "Gilgam Koczownik\n\"Heretycy może i zostali pokonani, ale jeszcze tu wrócą. Hordy z pewnością też zażarcie walczą... Jeśli padnie ich stolica, to nikt i nic nie powstrzyma Synclair!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV004e", "ID_STRING": "NAME_TXT", "TEXT": "Day 31", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV004e", "ID_STRING": "POPUP_TXT", "TEXT": "Szkielet\n\"Wygraliśmy to starcie, choć z pewnością nie było ono ostatnim. Podobnie wygląda sytuacja Górskich Klanów - jeśli padnie ich stolica, to heretycki kult stanie się zbyt potężny, aby go pokonać!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV004f", "ID_STRING": "NAME_TXT", "TEXT": "Suldon Satoria", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV004f", "ID_STRING": "POPUP_TXT", "TEXT": "Akolita heretyckiego kultu\n\"Przeklęci nieumarli - sama wasza obecność przyprawia mnie o mdłości! Za swą pychę będziecie cierpieć wieczne męki.\" \n", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0050", "ID_STRING": "NAME_TXT", "TEXT": "Nowe zdarzenie", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0051", "ID_STRING": "NAME_TXT", "TEXT": "Day 51", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0051", "ID_STRING": "POPUP_TXT", "TEXT": "Akolita heretyckiego kultu\n\"Nikt nie przeżyje, nikt nie pokona Scyona - to stwór odporny na wszelkie ziemskie moce! Próbujcie, choć i tak poniesiecie w końcu klęskę!\" \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0052", "ID_STRING": "NAME_TXT", "TEXT": "Undead Day 46", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0052", "ID_STRING": "POPUP_TXT", "TEXT": "Akolita heretyckiego kultu\n\"Scyon rzecze: pokonajcie Hordy Nieumarłych, a naszym będzie zwycięstwo!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0053", "ID_STRING": "NAME_TXT", "TEXT": "Mclans day 46", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0053", "ID_STRING": "POPUP_TXT", "TEXT": "Akolita heretyckiego kultu\n\"Nadszedł czas, aby zmiażdżyć potężne niegdyś Górskie Klany! Zabijcie ich wielkiego Vithara, aby Synclair mogła nasycić się jego mocą!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0055", "ID_STRING": "NAME_TXT", "TEXT": "Unity Angel Test", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0055", "ID_STRING": "POPUP_TXT", "TEXT": "Jedność\n\"Jestem Aniołem Jedności. Heretycki kult uwięził mego ducha w kamieniu, mogę jednak pobłogosławić tę okolicę tak, aby były w niej od czasu do czasu leczone rany. W chwili słabości powróćcie tutaj, a na pewno poczujecie się lepiej.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0078", "ID_STRING": "NAME_TXT", "TEXT": "Demonolog", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0057", "ID_STRING": "NAME_TXT", "TEXT": "Infinite Healing Location", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN007a", "ID_STRING": "NAME_TXT", "TEXT": "Demonolog", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0058", "ID_STRING": "NAME_TXT", "TEXT": "Defeat Unity Cultist", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0058", "ID_STRING": "POPUP_TXT", "TEXT": "Mądrość\n\"Jestem mądrością, Aniołem Życia. Dziękuję ci za uwolnienie mego ducha z tej ognistej jaskini! Zaczarowałam ją tak, że przebywający w niej podróżnicy będą co jakiś czas leczeni.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0059", "ID_STRING": "NAME_TXT", "TEXT": "Infinite Health Two", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV005b", "ID_STRING": "NAME_TXT", "TEXT": "Mountain Angel History", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV005b", "ID_STRING": "POPUP_TXT", "TEXT": "Mędrzec \n\"Pewien prastary zwój opisywał legendę Jedności... Podobno dwa anioły nie były już w stanie znieść nieszczęść całego świata i przemieniły zwykłą rzekę w magiczną krainę - chorzy wchodzący w kontakt z jej wodami natychmiast zdrowieli!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV005c", "ID_STRING": "NAME_TXT", "TEXT": "Undead Angel History", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV005c", "ID_STRING": "POPUP_TXT", "TEXT": "Czarnoksiężnik\n\"Tego miejsca, Jedności, strzegły niegdyś dwa anioły. Wierzyły one, że chorym i słabym należy pomagać i w tym celu przekształciły rzekę, dając jej cudowne własności lecznicze!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0080", "ID_STRING": "NAME_TXT", "TEXT": "Wyznawca", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV005d", "ID_STRING": "NAME_TXT", "TEXT": "If Zythaar Dies", "SEQ_NUM": 0},
