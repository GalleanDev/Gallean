    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Tempest Attack", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Winning Event", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Fort Davon", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Herszt Zbirów \n\"Ewakuowaliśmy miasto... Zbiry rozglądają się już za nowymi podbojami!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Avonia Message A", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Łowca Czarownic Avonia \n\"Tylko nie ty! Po naszym ostatnim spotkaniu rozpętała się wojna!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Avonia Message B", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Łowca Czarownic Avonia \n\"Orkowie zdobyli niziny!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Avonia Message C", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Łowca Czarownic Avonia \n\"Z pomocą z zewnątrz Barbarzyńcy zdołali podbić wyżyny!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Aragonia Message", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Mieszkaniec Aragonii \n\"Dawno temu Imperialni próbowali się osiedlić w tym regionie... Dwukrotnie próbowali i dwa razy im się to nie udało. Pierwsi koloniści, którzy chcieli powrócić do domu, zostali okrzyknięci zdrajcami i zabici przez własnych ludzi!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Edras", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Giermek \n\"Przybyliśmy tu w poszukiwaniu złota i szlachetnych kamieni, w które obfitują ziemie tej krainy. Przed przybyciem obcego panował tutaj pokój... Jednak potem obcy znudził się on własnymi ludźmi i postanowił osiedlić w tym miejscu!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Winning Event 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Winning Event 3", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Forest Keep Text", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000b", "ID_STRING": "POPUP_TXT", "TEXT": " \n\"Pobliskim plemieniem dowodzi osoba, która przybyła z innej krainy ... Niewiele wiemy o tym tajemniczym przywódcy, a żaden z naszych szpiegów nie powrócił!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Spear man says leave", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Włócznik  \n\"Przebywasz na moim terytorium, intruzie! Odejdź... Aby żyć wśród wilków i pająków!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Avonia Says Leave", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Łowca Czarownic Avonia \n\"Nigdy nie wpuścimy cię do miasta! Jeśli spróbujesz, przygotuj się na straszliwą bitwę!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Mountain Clans Day One", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Bragon Silny \n\"Dawno temu Imperium próbowało założyć tutaj kolonię. Osadnicy, wbrew rozkazom Imperium, opuścili to miejsce, ale nigdy nie powrócili do domu... Druga założona tutaj kolonia również zniknęła w tajemniczych okolicznościach!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0010", "ID_STRING": "NAME_TXT", "TEXT": "MClans Day Ten", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Górski Olbrzym \n\"Jest w tym miejscu coś znajomego... Nie wiem co to, ale mam uczucie, jakbym znał to miejsce!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Legions Day One", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Beliarh \n\"Po całej krainie porozrzucane są ludzkie kości... z pewnością są to ślady dawnej obecności Imperium na tych ziemiach... To jedyny ślad ich porażki, jaki się jeszcze zachował!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Legions Day 12", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Baronowa \n\"Kości żołnierzy Imperium rozrzucone są po całej krainie... Wedle legendy, ziemie te strzeżone są przez plemię, na którego czele stoi cudzoziemski przywódca. Podejrzewam, że to za ich sprawą Imperium poniosło tak sromotną klęskę!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Nieumarli - wiadomość", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Szkielet \n\"Mistrzu, w całej tej krainie pełno jest szkieletów, najwyraźniej spalonych przez pioruny! To miejsce musi chronić jakaś potężna siła. Jednak nawet ona będzie musiała się ugiąć przed potęgą Hord Nieumarłych.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Undead Fourteen", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Duch \n\"Wyczuwam tu obecność niespokojnych dusz... żołnierzy Imperium, zabitych przez swych własnych braci. Ostrzegają nas przed tymi, którzy tu pozostali! Tych ziem strzeże cudzoziemski przywódca, gromowładny herszt o wielkiej mocy!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Barbarian Message", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Barbarzyński Wojownik \n\"Ten, który włada żywiołami, pragnie, abyście opuścili to miejsce! Odejdźcie albo umrzecie!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Loc leave our land", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Barbarzyński Herszt \n\"Opuśćcie te ziemie na zawsze! Albo was do tego zmusimy... Mój mistrz ma władzę na piorunami. Jeśli się sprzeciwicie, poznacie jego potęgę! O ile przeżyjecie walkę ze mną!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Mclans Day 1b", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "\"Górska Wieża została przejęta przez siły orków! W środku ukryta jest para magicznych butów, które już kiedyś okazały się niezwykle przydatne. Jeśli spróbujecie je odzyskać, możecie napotkać silny opór!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Furrena", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Czym mogę służyć, przybyszu?", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Wieża Undera", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Moje towary są najlepsze w całym królestwie.", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Obóz Luggena", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Moi najemnicy przyłączą się do twojego wojska... Za odpowiednią cenę.", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Obóz Xennona", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Moi Berserkerzy są mi posłuszni.", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0004", "ID_STRING": "TXT_TITLE", "TEXT": "Wieża Malaviena", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0004", "ID_STRING": "TXT_DESC", "TEXT": "Moje czary są najpotężniejsze w regionie.", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0005", "ID_STRING": "TXT_TITLE", "TEXT": "Obóz Metaki", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0005", "ID_STRING": "TXT_DESC", "TEXT": "Za określoną cenę wytrenuję twoje jednostki", "SEQ_NUM": 0},
