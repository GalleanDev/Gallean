    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutralni", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Brak opisu rasy", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207UN0018", "ID_STRING": "NAME_TXT", "TEXT": "Orc", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207UN001a", "ID_STRING": "NAME_TXT", "TEXT": "Orc", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207UN001c", "ID_STRING": "NAME_TXT", "TEXT": "Tytan", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Calderic", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Najwyższy z władców krasnoludów, znany jest ze swej zaciętości w bitwie i odwagi w obliczu niesprzyjających okoliczności. Kiedyś przez siedem dni i nocy walczył z wielkim smokiem ARFURUZONEM, by wreszcie go pokonać.", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207UN0020", "ID_STRING": "NAME_TXT", "TEXT": "Włócznik", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Asumuel", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Jego imieniem straszy się dzieci. Ten pan piekieł słynie ze swej krwiożerczości. Mówi się, że kiedyś, w czasie bankietu wdanego przez Bethrezena z okazji zwycięstwa nad królestwem światłości, pożarł tysiąc niewolników.", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207PL000b", "ID_STRING": "NAME_TXT", "TEXT": "Zythaar", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207PL000b", "ID_STRING": "DESC_TXT", "TEXT": "W swoich czasach znany jako najpotężniejszy mistrz mrocznej sztuki, władca ten zabity został przez inkwizytora Vorgela, który położył kres jego bezeceństwom. Teraz jest wskrzeszony jako nieumarły i pragnie nagiąć do swej woli wszystkich śmiertelników.", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207UN0027", "ID_STRING": "NAME_TXT", "TEXT": "Tytan", "SEQ_NUM": 0},
