    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218UN00f5", "ID_STRING": "NAME_TXT", "TEXT": "Szamanka", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218UN00f7", "ID_STRING": "NAME_TXT", "TEXT": "Wilk", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Legiony Dzień 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Modeusz\n\"Już czas. Ludzie niszczą się sami, lecz ta plugawa czystość jest jeszcze gdzie indziej: elfy! Te przeklęte lasy wypełnią się ich krzykiem, a ich domostwa pochłonie ogień.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Sukuba\n\"Las jest olbrzymi - jak chcesz je wszystkie odnaleźć? Zanim dosięgnie je ogień, zdążą uciec.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Modeusz\n\"W tym celu wezwałem z najczarniejszych otchłani brata Fareuma. Jest słaby... istota o jego potędze nie jest w stanie zbyt długo egzystować z dala od Bethrezena. Jednak czarne obeliski plugawią ziemie elfów... Fareum użyje ich, by wszystko spalić", "SEQ_NUM": 3},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Fareum\n\"Tak. Czuję ich obecność. Są daleko stąd. Daleko na południe. Muszę natychmiast wyruszyć.\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Legiony Fareum zabity", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Fareum\n\"Powróciłem, Panie!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Legions Burn1 ", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Fareum\n\"Płoń!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Legiony płoną2", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Faruem \n\"Hahahahah!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Legiony płoną3", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Fareum\n\"Widzisz, jak się tli?\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Legiony płoną4", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Fareum\n\"Gdzie się chowacie... maleństwa? Może to was wywabi!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Legions Burn5 ", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Fareum \n\"Ha!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Legiony zwycięstwo", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Modeus \n\"Udało mu się! Widzicie, jak ci leśni tchórze czmychają na ziemie krasnoludów? Bethrezen nas wynagrodzi!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Legiony DemonyPostęp1", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Legiony DemonyPostęp2", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Legiony DemonyPostęp3", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Legiony DemonyPostęp4", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Legiony DemonyPostęp5", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Klany Dzień1", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Król krasnoludów\n\"Parszywe elfy maszerują ku nam, posłuszne woli ich niegodziwego boga. Musimy się przygotować. Czeka nas wspaniała walka, chłopaki!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Złodziej\n\"Panie, nadciągają też demony! Może sprzymierzyły się przeciwko nam? Nie sprostamy dwóm armiom, chyba że sięgniemy do... subtelniejszych metod.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Król krasnoludów\n\"Jeszcze nie wiem, co masz na myśli, ale już mi się to nie podoba.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Alchemik\n\"Rozważaliśmy to... możemy przyrządzić zabójczą truciznę, aby zniszczyć ich wojska na ich własnych ziemiach. Czy to chwalebne? Nie. Ale nie mamy wielkiego wyboru.\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Złodziej\r\n\"Daleko na północny wschód stąd jest miejsce, w którym wypływa plugawe źródło. Wszystko wokół od razu gnije. Gdyby udało się zdobyć niewielką ilość tej trucizny, moglibyśmy zatruć zbiorniki wodne elfów znajdujące się nieopodal ich stolicy.\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Alchemik\n\"Jestem przekonany, że substancja ta osłabi także demony, jeśli zostanie wlana do ich przeklętego źródła.\"", "SEQ_NUM": 5},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Król krasnoludów\r\n\"A więc zróbcie tak. Jeśli ta trucizna jest tak potworna, jak twierdzisz, ktokolwiek ją przyniesie, z pewnością zachoruje. Będzie się też musiał zmierzyć ze straszliwymi istotami z tych przeklętych ziem. To będzie szlachetna ofiara.\"", "SEQ_NUM": 6},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Alchemik\n\"Przygotowałem kilka starych pojemników specjalnie na transport tej substancji. Gdy tylko dostanę próbkę ze źródła, będę mógł ją powielić. Gdybyśmy nie zdołali dotrzeć do nieprzyjaciela, będziemy gotowi z dużą ilością trucizny.\"", "SEQ_NUM": 7},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Klany NapełnijTrucizną", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Alchemik\n\"O to chodziło! Skoro mamy już próbkę, wypełnimy wszystkie pojemniki tą samą trucizną. Musimy ją wlać do źródeł nieprzyjaciela!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Klany ZatrujElfy", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Alchemik\n\"Tam! Źródło elfów. Prędko, wlejcie truciznę!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Złodziej\n\"Zrobione! Musimy opuścić ten przeklęty las.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Klany ZatrujLegiony", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Alchemik\n\"Cóż za plugawe miejsce! Prędzej, wlejcie truciznę!", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Złodziej\n\"To działa! Demony zostały zarażone! Musimy się stąd wykraść, zanim zauważą, czyja to sprawka.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Klany zwyciężają", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Alchemik\n\"Obie armie zostały zatrute, Panie! Niebawem trucizna zacznie działać. Powstrzymaliśmy inwazję!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Król krasnoludów\n\"Świetna robota, jesteśmy z was dumni! Niech ktoś przyniesie tym dzielnym krasnoludom po butelce! Albo nie, po dwie butelki!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Klany StartSI", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Klany Wyposaż Rudmera", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Klany RudmerTemp zabity", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0018", "ID_STRING": "NAME_TXT", "TEXT": "KlanyPostęp1", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0019", "ID_STRING": "NAME_TXT", "TEXT": "KlanyPostęp2", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Klany Ruch 1st Rudmer", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Klany Dzień2", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Klany Dzień3", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Elfy Status mniej niż5", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Mędrzec\n\"Ponieśliśmy zbyt duże straty! Musimy przestać wysyłać nasze dzieci do grobu! Nie odbiorą nam lasów bez walki!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV001d", "ID_STRING": "OBJECT_TXT", "TEXT": "Legiony muszą przyprowadzić demona Faeruma do pięciu obelisków na ziemi elfów.\r\nElfy przegrały.\r\nKrasnoludy muszą zdobyć truciznę i zatruć źródła obu nieprzyjaciół.", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Elfy Dzień 4", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Elfy Dzień 6", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Elfy Dzień 8", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Elfy Dzień 12", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Hevershale", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Nie obchodzą nasss sssprawy śmiertelników. Czego od nasss chcesssssz?", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0022", "ID_STRING": "NAME_TXT", "TEXT": "Elfy Postęp Mure'esh", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0022", "ID_STRING": "POPUP_TXT", "TEXT": "Mure'esh \n\"Zostanę tutaj.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Rada Magów", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Możesz się tu nauczyć naprawdę niezwykłych zaklęć, które na pewno ci się przydadzą.", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Elfy Postęp Dereni'il", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0023", "ID_STRING": "POPUP_TXT", "TEXT": "Dereni'il \n\"Przybyłem bezpiecznie.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Trening u Oggfega", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Pracowałem zarówno z dobrymi wojownikami, jak i z kiepskimi. Z każdego coś wydobędę.", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0024", "ID_STRING": "NAME_TXT", "TEXT": "Elfy Postęp Erenlus", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0024", "ID_STRING": "POPUP_TXT", "TEXT": "Erenlus \n\"To nie było zbyt trudne.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Menażeria Mundora", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Te stworzenia są wprawdzie okrutne, lecz będą służyć ci wiernie.", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Elfy Postęp Gremech", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Gremech \n\"Jestem, jak kazałeś.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0004", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Bellar", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0004", "ID_STRING": "TXT_DESC", "TEXT": "Moją specjalnością są klejnoty i biżuteria, ale proszę, rozejrzyj się.", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Elfy Postęp Sommech", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0026", "ID_STRING": "POPUP_TXT", "TEXT": "Sommech \n\"To tutaj.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0005", "ID_STRING": "TXT_TITLE", "TEXT": "Towary Fren", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0005", "ID_STRING": "TXT_DESC", "TEXT": "Dzięki częstym przemarszom wojsk mamy tu wiele ciekawych rzeczy.", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Elfy Postęp Pelumnus", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Pelemnus \n\"Zrobione.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Elfy Postęp Osbil", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "Osbil \n\"Krasnoludzki Ołtarz. To musi być tutaj!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Elfy Postęp Furennsil", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0029", "ID_STRING": "POPUP_TXT", "TEXT": "Furennsil \n\"Udało mi się.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Elfy Postęp Belenesh", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV002a", "ID_STRING": "POPUP_TXT", "TEXT": "Belenesh \n\"Poczekam tutaj.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV002b", "ID_STRING": "NAME_TXT", "TEXT": "Elfy zwyciężają - Zniszczenie", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV002b", "ID_STRING": "POPUP_TXT", "TEXT": "Królowa Illenese \n\"Na Galleana, dokonali tego. Odbudujemy nasze domy w samym sercu terytorium krasnoludów! A te nieszczęsne demony będą musiały donieść Bethrezenowi o swej klęsce.\"\n", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Elfy zwyciężają - Czas", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV002c", "ID_STRING": "POPUP_TXT", "TEXT": "Królowa Illenese \n\"Walczyłyście dzielnie, moje dzieci. Nie dopuściłyście nieprzyjaciela do naszych ziem. Płomienie w naszych lasach przygasają, a krasnoludy wycofują się w góry.\"", "SEQ_NUM": 0},
