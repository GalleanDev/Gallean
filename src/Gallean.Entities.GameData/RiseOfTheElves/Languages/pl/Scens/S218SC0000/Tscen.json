    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218PL0001", "ID_STRING": "DESC_TXT", "TEXT": "Najwyższy z władców krasnoludów, znany jest ze swej zaciętości w bitwie i odwagi w obliczu niesprzyjających okoliczności. Kiedyś przez siedem dni i nocy walczył z wielkim smokiem ARFURUZONEM, by wreszcie go pokonać.", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218UN0018", "ID_STRING": "NAME_TXT", "TEXT": "Pelumnus", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218PL0002", "ID_STRING": "NAME_TXT", "TEXT": "Abraal", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218PL0002", "ID_STRING": "DESC_TXT", "TEXT": "Jego imieniem straszy się dzieci. Ten pan piekieł słynie ze swej krwiożerczości. Mówi się, że kiedyś, w czasie bankietu wdanego przez Bethrezena z okazji zwycięstwa nad królestwem światłości, pożarł tysiąc niewolników.", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218UN0019", "ID_STRING": "NAME_TXT", "TEXT": "Gremech", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218PL0003", "ID_STRING": "NAME_TXT", "TEXT": "Kera'anil", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218PL0003", "ID_STRING": "DESC_TXT", "TEXT": "Weteran wojny o odzyskanie chwały elfów - nikt nie wkroczy do lasu bez jego wiedzy.", "SEQ_NUM": 0},
