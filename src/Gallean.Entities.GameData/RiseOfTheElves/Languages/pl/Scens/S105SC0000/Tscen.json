    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0016",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nagroda ork\u00F3w",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0016",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ork \n\u0022GHOOOOAAR! Orki...\u0022",
