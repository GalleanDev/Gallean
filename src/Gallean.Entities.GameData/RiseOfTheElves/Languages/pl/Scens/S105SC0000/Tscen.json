    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000b",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Zabij wyznawc\u00F3w",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000b",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Pandemoniusz \n\u0022Zniszczyli\u015Bmy kr\u0105g przyzywania, panie. Demony przestan\u0105 przybywa\u0107...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000c",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Zabij demonol.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000c",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Pandemoniusz \n\u0022Zniszczyli\u015Bmy kr\u0105g przyzywania, panie. Demony przestan\u0105 przybywa\u0107...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000d",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Ostrze\u017Cenie wodne",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000d",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Doradca \n\u0022Uwa\u017Caj, panie... Morzami w tym rejonie w\u0142adaj\u0105 morskie wied\u017Amy, kt\u00F3re po\u017Ceraj\u0105 wszystkich intruz\u00F3w.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Asteroth T2",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000f",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Strefa stanu",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000f",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ksi\u0105\u017Ce \n\u0022Imperium przy\u0142\u0105czy\u0142o si\u0119 do Asterotha! Zawarli przymierze! Z\u0142y urok Uthera ogarn\u0105\u0142 chyba Imperium. Pewnie stoi za tym Hubert de Lalye...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0032",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Wyznawca",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0010",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Asteroth w pobli\u017Cu",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0010",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Asteroth \n\u0022Pope\u0142ni\u0142e\u015B kolejny b\u0142\u0105d, \u015Bmiertelniku... Osobi\u015Bcie dope\u0142ni\u0119 twej zguby! Nadszed\u0142 kres w\u0142adzy Bethrezena...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0034",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Wyznawca",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0011",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Ruch onyksa T15",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0012",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Wygraj Misj\u0119",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0012",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Asteroth \n\u0022Wrrr! Macie szcz\u0119\u015Bcie, \u017Ce nie si\u0119gn\u0105\u0142 was m\u00F3j gniew, demony! Ale nie zdo\u0142acie mnie zniszczy\u0107...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0012",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Demonolog \n\u0022Asteroth znikn\u0105\u0142 w rozb\u0142ysku ognia! Uciek\u0142! A wi\u0119c zwyci\u0119\u017Cyli\u015Bmy...\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0036",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Ogr",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0014",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Asteroth T40",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0014",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Asteroth \n\u0022Tch\u00F3rze! Sam was unicestwi\u0119... Po\u017Ca\u0142ujecie tej zdrady!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0015",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Misja ork\u00F3w",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0015",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ork \n\u0022Ciep\u0142osk\u00F3ry... Prosimy pomocy... Orkowy brat przepad\u0142... Pom\u00F3c nam?\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0015",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ksi\u0105\u017Ce \n\u0022Czego od nas chcecie?\u0022",
      "SEQ_NUM": 2
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0015",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Ork \n\u0022Przyprowad\u017Acie ork\u00F3w... Co\u015B wam damy...\u0022",
      "SEQ_NUM": 4
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0039",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Imperialny zab\u00F3jca",
