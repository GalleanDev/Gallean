    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Clans Day One", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Daeron Starszy\n\"Doprowadźcie mnie do wyłomu, a ja wam załatwię przejście do samego serca krainy demonów!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Norwyndar \n\"Nie będzie to proste, Daeronie. Musimy przebić się przez resztki Goveneshów i rosnącą w siłę armię demonów. Sugeruję...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Daeron Starszy \n\"Czemu mielibyśmy słuchać elfickich rad? Droga jest długa i kręta, ale musimy pamiętać, kim jesteśmy! Ruszajmy na południe, póki nasi wrogowie są słabi!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Norwyndar \n\"Lepiej będzie, jeśli Daeron zostanie w stolicy, dopóki nie stworzymy odpowiednio dużych sił, które będą go chronić. Małą grupę wyślijmy na południowy zachód, by rozpoznać pozycje Goveneshów, a ja wyruszę na wschód, szukać sprzymierzeńców.\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Daeron Starszy\n\"Strategie tchórzliwych elfów! W drogę!\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Legions Day One", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"Panie, z północy nadchodzą karły. Z łatwością byśmy sobie z nimi poradzili, gdyby nie ci Goveneshowie... Musimy natychmiast zająć ich pozostałe miasta - mam ci coś do pokazania.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Thriss \n\"Czemu ty tu przyprowadzić Thrisssss? Zdechniesz... Szszszybko... To ciało należy już do nas, panie. Słabe umysły nie stawiają oporu - czekam na twoje rozkazy.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"Dzięki bliskości wyłomu nasi pobratymcy są w stanie opętać słabszych od siebie. Oto kolejna istota, która chce się zaciągnąć na naszą służbę...\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Grunkk \n\"Ty sprowadzić tu Grunkk! Grunkk być zły, wbić cię w ziemia...aaaaaargh... Władam teraz tym zwierzęciem, pa....arrrgh...Ty nie władać Grunkk! Zaraz...już. Jak wspominałem, kontrolujemy teraz tego ogra.\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"Jeśli jeszcze raz stracisz kontrolę, to poniesiesz karę... Panie, jeśli wykorzystamy te... dodatkowe jednostki... to może uda się nam przekonać okoliczne stworzenia do wsparcia naszej sprawy. Najpierw jednak proponuję atak na miasta Goveneshów.\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Legiony zwycięstwo", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"Ahahah! Żałosne krasnoludy straciły swego zbawiciela - nie mają już po co walczyć!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Clans Win", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Daeron Starszy\n\"Już chłopcy, gotowe! Mamy teraz drogę prowadzącą w samo serce terytorium demonów - i na Wotana, odczują naszą furię!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"Odwrót! Do wyłomu!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Clans Lose", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Daeron the Elder \n\"Cóż ja zrobiłem??? Niech mi Wotan wybaczy...agh!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Mine1", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Walos  \n\"Hahahahahah!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Mine2", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Walos \n\"Ahahahahah! Wspaniale!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Mine3", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Walos \n\"Niezły pokaz!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Mine4", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Walos \n\"Hahaha to musiało boleć!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Legions Wizard Warning", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"Nie zabijaj tego ludzkiego czarodzieja! Władają nim Legiony i służy on za przynętę. Ty przejdziesz przez tę krainę bez szwanku, ale krasnoludy raczej nie będą miały tyle szczęścia!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Clans Wizard Warning", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Walos \n\"Witajcie, przyjaciele... Ekhm... Imperium otrzymało waszą wiadomość i przybywamy tu w imieniu Wszechojca i całej reszty tej bandy... Idźcie przodem, będziemy was osłaniać. Czemu się wahacie? Ruszajcie się!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Clans Kill Walos", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Daeron \n\"Wyczuwam to... Ci ludzie byli opętani. Nasza wiadomość nie mogła dotrzeć do Imperium.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Legions Kill Walos", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"Idioci! Zabroniłem wam ruszać Walosa - zepsuliście wzorcową zasadzkę!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Elfnapping", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Herszt zbirów\n\"Ach... Sprowadzacie tu słynnego Norwyndara. Nieźle się za niego obłowimy... Możecie przejść.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Norwyndar \n\"Rozumiem, panie. Nie obawiaj się - przy najbliższej okazji uwolnię się od tych rzezimieszków.\"", "SEQ_NUM": 5},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Thugs North", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Herszt zbirów\n\"Krasnoludy... Wydajcie nam elfa Norwyndara, a obniżymy południowy mur. Legiony nie spodziewają się ataku z tej strony... Zastanówcie się, oferta jest bardzo korzystna - jeden elf w zamian za zwycięstwo.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Napped", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Clans Day 4", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Frug Brenstout \n\"Wyruszam z wiadomością dla ludzi - przyda się nam każda para rąk. Do zobaczenia - w tym lub innym świecie; niech Wotan prowadzi wasze ostrza!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Clans Eldrooke", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Ranny goblin \n\"Przestać! Nie robić mi krzywdy! Ja wszystko powiedzieć. Wszystko! My zabrać elfom miasto i wszystkie je zamknąć w zielonych ruinach. Ty tam nie wejść. Nie nie nie, ty nie wejść...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Clans Orc Entry", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Zwiadowca\n\"Egh... Czujesz to? Gdzie moi ludzie? Coś mi tu nie gra...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Prison Break", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Zwiadowca\n\"Tak niewielu nas zostało... A nawet ci są słabi i poranieni.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Relwynn \n\"Straciliśmy już wszelką nadzieję, ale przyłączymy się do waszej walki z demonami.\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Truntis \n\"Najpierw musisz nas uwolnić z okowów. Orkowy nadzorca niewolników przy jamie ma ostrze, które powinno się do tego świetnie nadać... Ach, widzę, że już je masz. Dziękuję...\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Clans on the Move", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Pustelnik", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Pustelnik\n\"Dlaczego uważasz, że możesz sobie tak po prostu wziąć, to, czego ci potrzeba? To nasza kopalnia, zamieszkują ją moi pobratymcy. Zostaw ją w spokoju.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Capture Fierhold", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Wojownik\n\"Te mury nie ochronią cię przed zakusssssssssssami Mortisssssss... Zakoszszszszsztujemy waszszszej posssssoki...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Capture Scartoe", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Widmo\n\"Nie przeżyjecie. Mortisss właśnie wskrzesza kolejnych wojowników... Całe pokolenia zmarłych leżących pod waszymi sssstopami czekają, aby się do nasss przyłączyć...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Capture Felbrinn", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Wtajemniczony\n\"A masz. Mam nadzieję, że nasza plaga sprawi, iż zgniją ci wszystkie członki.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Capture Edrelmire", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Starszy wampir\n\"To robi wrażenie, ale skażona krew mego rodu przetrwa. Uważajcie na swoje szyje...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Capture Cothkele", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Ghule\n\"Eeeeeeeeeeeeeeeeeeigh!!!!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Capture Krecheck", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Czarnoksiężnik\n\"Witam w Krechek - mam nadzieję, że smród rozkładających się zwłok wam nie przeszkadza. Czystość nie jest tu najwyższym priorytetem...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Ziemie Illthreka", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Za niewielką opłatę zmuszę duchy, aby ci służyły.", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Towary Ubby", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Nie wolno ci tutaj przebywać! Kup, co masz kupić, i odejdź!", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Capture Crysend", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0023", "ID_STRING": "POPUP_TXT", "TEXT": "Wtajemniczony\n\"Niech Mortis zbezcześci wasze martwe truchła!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Nora zbirów", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Nie pytaj mnie, skąd to mam, ciesz się, że tak tanio to sprzedaję.", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Capture Kthrell", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Meduza \n\"Obcy! Jak śśśśmiecie???\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Clans Day 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0026", "ID_STRING": "POPUP_TXT", "TEXT": "Frug Brenstout \n\"Wydawało mi się, że krasnoludy i elfy do siebie nie pasują... Ale dziś słyszałem o goblinach wspierających patrole jaszczoludzi! Autochtoni musieli się sprzymierzyć w obliczu inwazji Goveneshów.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Legions Day 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"Musimy uważać - miejscowe rasy najwyraźniej się sprzymierzyły, prawdopodobnie przeciwko Goveneshom. I tak ich oczywiście pokonamy, niezależnie od tych wszystkich sojuszów.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Plagued", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Plague Warning", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0029", "ID_STRING": "POPUP_TXT", "TEXT": "Ofiara plagi\n\"Oszaleliście? Przybywam tu tylko umrzeć w pokoju... Być może już się zaraziliście - zawróćcie natychmiast i zostawcie nas naszym troskom!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Walos Dead", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002b", "ID_STRING": "NAME_TXT", "TEXT": "Plague1", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002b", "ID_STRING": "POPUP_TXT", "TEXT": "Twoja drużyna cierpi z powodu plagi.", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Plague2", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002c", "ID_STRING": "POPUP_TXT", "TEXT": "Twoja drużyna cierpi z powodu plagi.", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002d", "ID_STRING": "NAME_TXT", "TEXT": "Plague 3", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Twoja drużyna cierpi z powodu plagi.", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002e", "ID_STRING": "NAME_TXT", "TEXT": "Plague 4", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002e", "ID_STRING": "POPUP_TXT", "TEXT": "Twoja drużyna cierpi z powodu plagi.", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002f", "ID_STRING": "NAME_TXT", "TEXT": "Plague 5", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "Twoja drużyna cierpi z powodu plagi.", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0030", "ID_STRING": "NAME_TXT", "TEXT": "Plague 6", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0030", "ID_STRING": "POPUP_TXT", "TEXT": "Twoja drużyna cierpi z powodu plagi.", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0031", "ID_STRING": "NAME_TXT", "TEXT": "Plague 7", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0031", "ID_STRING": "POPUP_TXT", "TEXT": "Twoja drużyna cierpi z powodu plagi.", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0032", "ID_STRING": "NAME_TXT", "TEXT": "Plague 8", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0032", "ID_STRING": "POPUP_TXT", "TEXT": "Twoja drużyna cierpi z powodu plagi.", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0033", "ID_STRING": "NAME_TXT", "TEXT": "Jonderuk", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0033", "ID_STRING": "POPUP_TXT", "TEXT": "Jonderuk \n\"Ten świat jest taki płaski... I jak dla mnie zdecydowanie zbyt chłodny.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0033", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"Kolejny rekrut. Nie sądzisz, że masz problemy z właściwym doborem opętywanych przez ciebie organizmów?\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0033", "ID_STRING": "POPUP_TXT", "TEXT": "Jonderuk \n\"Opętanie kogokolwiek nie jest prostym zadaniem. Gdy tylko wyczułem obecność słabego umysłu natychmiast skorzystałem z okazji.\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0034", "ID_STRING": "NAME_TXT", "TEXT": "Blackeye", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0034", "ID_STRING": "POPUP_TXT", "TEXT": "Blackeye \n\"Jesteśmy, panie. Łakniemy śmierci krasnoludzkiego mistyka...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0034", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"Jesteście, moje nieświęte trojaczki. Zastanawiałem się, kiedy do nas dołączycie... Mam nadzieję, że opętanie było odpowiednio bolesne?\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0034", "ID_STRING": "POPUP_TXT", "TEXT": "Blackeye \n\"Straszliwie, panie.\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0035", "ID_STRING": "NAME_TXT", "TEXT": "Protect", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0036", "ID_STRING": "NAME_TXT", "TEXT": "Empire Arrives", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0036", "ID_STRING": "POPUP_TXT", "TEXT": "Lodrimoore \n\"Obawiam się, że przybywamy za późno, ale Imperium jest gotowe na walkę z demonami! Wytrzymajcie, wkrótce was wesprzemy!\"", "SEQ_NUM": 1},
