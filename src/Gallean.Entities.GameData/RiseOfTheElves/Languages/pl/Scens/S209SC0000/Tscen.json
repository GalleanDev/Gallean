    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209UN000f", "ID_STRING": "NAME_TXT", "TEXT": "Norwyndar", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutralni", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Brak opisu rasy", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209PL0002", "ID_STRING": "NAME_TXT", "TEXT": "Farsael", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209PL0002", "ID_STRING": "DESC_TXT", "TEXT": "Jego imieniem straszy się dzieci. Ten pan piekieł słynie ze swej krwiożerczości. Mówi się, że kiedyś, w czasie bankietu wdanego przez Bethrezena z okazji zwycięstwa nad królestwem światłości, pożarł tysiąc niewolników.", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209PL0003", "ID_STRING": "NAME_TXT", "TEXT": "Lockjaw", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209PL0003", "ID_STRING": "DESC_TXT", "TEXT": "Najwyższy z władców krasnoludów, znany jest ze swej zaciętości w bitwie i odwagi w obliczu niesprzyjających okoliczności. Kiedyś przez siedem dni i nocy walczył z wielkim smokiem ARFURUZONEM, by wreszcie go pokonać.", "SEQ_NUM": 0},
