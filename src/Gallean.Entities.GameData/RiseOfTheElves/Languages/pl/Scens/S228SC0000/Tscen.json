    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Imp spr kontr miasto", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Rycerz Humphrey\n\"Od czasów wielkiej wojny chaos i zniszczenie pochłaniają królestwo. Złodzieje i Zielonoskórzy grasują bezkarnie na utraconych ziemiach, nie uznając żadnych praw.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Imp Intro chaos", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Rycerz Humphrey\n\"Od czasów wielkiej wojny chaos i zniszczenie pochłaniają królestwo. Złodzieje i Zielonoskórzy grasują bezkarnie na utraconych ziemiach, nie uznając żadnych praw.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Imp dzień 5 wyzw zagadkę 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca\n\"Kapłani świątyni Apthy wierzą, że strażnik wieży czerpie swą siłę z magicznego trójkąta. Powiadają też, że trójkąt ten tworzą trzy przeklęte miasta - Baphomet, Babalon i Menkhaos.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Imp dzień 7 wyzw zagadkę 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca\n\"Tylko ten, kto zawładnie trzema wierzchołkami magicznego trójkąta, może wygnać drzemiącego w nim demona.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Imp lok wejście wieży", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Elf\n\"Na południe stąd znajduje się wejście do wieży Kadratha. Strzeżcie się, powiadają bowiem, że strażnik wieży włada magicznymi mocami i jest niemal nieśmiertelny.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Stwórz demonologa 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Demonolodzy\n\"Na potęgę Anthaela, pochłonie was nasz ogień!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Stwórz demonologa 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Demonolodzy \n\"Nie oprzecie się woli Anthaela!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Stwórz demonologa 3", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Demonolodzy \n\"Stawiając nam opór, tracicie tylko siły. Staniecie się sługami Anthaela!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Stwórz demona 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Stwórz demona 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Stwórz demona 3", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Stwórz upiornego żmija", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Aktywuj upiornego żmija", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Dezaktywuj upiornego żmija", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Stwórz wilki", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Stwórz w lesie zbirów Klany", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Stwórz zbirów Imperium", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Aktywuj tworzenie zbirów", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Dezaktywuj tworzenie zbirów", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Loc Baphomet", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Strażnik Baphomet\n\"Oddajcie swe dusze władcy Anthaelowi albo gińcie!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Loc Babalon", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Strażnik Babalon\n\"Nie służycie władcy Anthaelowi! Czemuż chcecie zginąć?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Loc Menkhaos", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Strażnik Menkhaos\n\"Sprawimy, że uznacie władzę Anthaela!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0022", "ID_STRING": "NAME_TXT", "TEXT": "Stwórz mn zagrożenie Imp", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Wieża Jolana", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Mam potężne czary za umiarkowaną cenę.", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Stwórz mn zagrożenie GK", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0024", "ID_STRING": "NAME_TXT", "TEXT": "GK intro chaos", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0024", "ID_STRING": "POPUP_TXT", "TEXT": "Weteran Gordoth\n\"Od czasów wielkiej wojny chaos i zniszczenie pochłaniają królestwo. Złodzieje i Zielonoskórzy grasują bezkarnie na utraconych ziemiach, nie uznając żadnych praw.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0025", "ID_STRING": "NAME_TXT", "TEXT": "GK dzień 5 wyzw zagadkę 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca\n\"Kapłani świątyni Apthy wierzą, że strażnik wieży czerpie swą siłę z magicznego trójkąta. Powiadają też, że trójkąt ten tworzą trzy przeklęte miasta - Baphomet, Babalon i Menkhaos.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0026", "ID_STRING": "NAME_TXT", "TEXT": "GK dzień 7 wyzw zagadkę 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0026", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca\n\"Tylko ten, kto zawładnie trzema wierzchołkami magicznego trójkąta, może wygnać drzemiącego w nim demona.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228SI0005", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Furrena", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228SI0005", "ID_STRING": "TXT_DESC", "TEXT": "Czym mogę służyć, przybyszu?", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228SI0006", "ID_STRING": "TXT_TITLE", "TEXT": "Obóz Oro", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228SI0006", "ID_STRING": "TXT_DESC", "TEXT": "Moi ludzie należą do najsilniejszych w tym kraju.", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0028", "ID_STRING": "NAME_TXT", "TEXT": "I wch do strefy gras 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Milordzie! Zło działa tu ze zbyt wielką siłą, jeśli wkrótce nie odejdziemy, zabije nas...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228SI0007", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Sallata", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228SI0007", "ID_STRING": "TXT_DESC", "TEXT": "Moje towary pomogą ci w twojej misji.", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0029", "ID_STRING": "NAME_TXT", "TEXT": "I wch do strefy gras 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0029", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Milordzie! Zło działa tu ze zbyt wielką siłą, jeśli wkrótce nie odejdziemy, zabije nas...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228SI0008", "ID_STRING": "TXT_TITLE", "TEXT": "Wieża Yggara", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228SI0008", "ID_STRING": "TXT_DESC", "TEXT": "Myślę, że moja magiczna biblioteka może cię zainteresować.", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV002a", "ID_STRING": "NAME_TXT", "TEXT": "I wch do strefy gras 3", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV002a", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Milordzie! Zło działa tu ze zbyt wielką siłą, jeśli wkrótce nie odejdziemy, zabije nas...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228SI000a", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Hundera", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228SI000a", "ID_STRING": "TXT_DESC", "TEXT": "Przyjrzyj się moim towarom. Może znajdziesz wśród nich coś interesującego.", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228SI000b", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Werrica", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228SI000b", "ID_STRING": "TXT_DESC", "TEXT": "Znajdziesz tu każdy eliksir, o jakim zamarzysz, do tego za umiarkowaną cenę!", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV002d", "ID_STRING": "NAME_TXT", "TEXT": "GK spr kontr miasto", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Weteran Gordoth\n\"Przejęliśmy trzy przeklęte miasta. Kadrath utracił już większość swej mocy i nie zdoła utrzymać magii dającej siłę strażnikowi. Musimy uderzyć natychmiast, panie!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0031", "ID_STRING": "NAME_TXT", "TEXT": "GK lok obelisk Legionów", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0031", "ID_STRING": "POPUP_TXT", "TEXT": "Zwiadowca\n\"Panie, czuję tu silny wpływ zła. Pochodzi ze wschodu, ale nie widzę jego źródła. Musimy poruszać się ostrożnie!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0032", "ID_STRING": "NAME_TXT", "TEXT": "Zdobycie Baphomet", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0032", "ID_STRING": "POPUP_TXT", "TEXT": "Chłop\n\"Panie! Dzięki ci za uwolnienie nas od złego Kadratha. Może nasze modlitwy pomogą go pokonać.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0033", "ID_STRING": "NAME_TXT", "TEXT": "Imp lok spalone miasto", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0033", "ID_STRING": "POPUP_TXT", "TEXT": "Chłop\n\"Kadrath zniszczył nasze miasto, ponieważ nie chcieliśmy się poddać. Daruje życie tylko tym, którzy oddadzą mu cześć. Pomścij nas, panie...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0035", "ID_STRING": "NAME_TXT", "TEXT": "Zdobycie Babalon", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0035", "ID_STRING": "POPUP_TXT", "TEXT": "Lud miasta\n\"Nareszcie położyliście kres naszym cierpieniom! Będziemy wam dozgonnie wdzięczni, milordzie.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0036", "ID_STRING": "NAME_TXT", "TEXT": "Zdobycie Menkhaos", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0036", "ID_STRING": "POPUP_TXT", "TEXT": "Lud miasta\n\"A już ogarnęła nas rozpacz, panie. Nie mieliśmy wyjścia, musieliśmy poddać się władzy Kadratha. Teraz, dzięki wam, odzyskaliśmy życie!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0037", "ID_STRING": "NAME_TXT", "TEXT": "Dzień 9 magiczne kręgi przyzywania", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0037", "ID_STRING": "POPUP_TXT", "TEXT": "Wysłannik elfów\n\"Panie, odkryliśmy, że Kadrath przyzywa swe sługi poprzez magiczne kręgi. Kręgów tych bronią potężne, złe moce, które mogą przynieść nam zgubę. Jeden z naszych zwiadowców ledwie uszedł z życiem po wejściu do takiego kręgu...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0039", "ID_STRING": "NAME_TXT", "TEXT": "Imp lok Menkhaos 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0039", "ID_STRING": "POPUP_TXT", "TEXT": "Zwiadowca\n\"Na północny wschód stąd znajduje się miasto Baldara.  Po wielkiej wojnie Kadrath nazwał je imieniem swego drugiego dziecka-demona, Menkhaosa...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV003a", "ID_STRING": "NAME_TXT", "TEXT": "Imp lok Menkhaos 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV003a", "ID_STRING": "POPUP_TXT", "TEXT": "Zwiadowca\n\"Na południe stąd znajduje się miasto Baldara.  Po wielkiej wojnie Kadrath nazwał je imieniem swego drugiego dziecka-demona, Menkhaosa...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV003b", "ID_STRING": "NAME_TXT", "TEXT": "GK lok Menkhaos 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV003b", "ID_STRING": "POPUP_TXT", "TEXT": "Zwiadowca\n\"Na północny wschód stąd znajduje się miasto Baldara.  Po wielkiej wojnie Kadrath nazwał je imieniem swego drugiego dziecka-demona, Menkhaosa...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV003c", "ID_STRING": "NAME_TXT", "TEXT": "GK lok Menkhaos 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV003c", "ID_STRING": "POPUP_TXT", "TEXT": "Zwiadowca\n\"Na południe stąd znajduje się miasto Baldara.  Po wielkiej wojnie Kadrath nazwał je imieniem swego drugiego dziecka-demona, Menkhaosa...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV003d", "ID_STRING": "NAME_TXT", "TEXT": "GK wch do strefy gras 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV003d", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Milordzie! Zło działa tu ze zbyt wielką siłą, jeśli wkrótce nie odejdziemy, zabije nas...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV003e", "ID_STRING": "NAME_TXT", "TEXT": "GK wch do strefy gras 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV003e", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Milordzie! Zło działa tu ze zbyt wielką siłą, jeśli wkrótce nie odejdziemy, zabije nas...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV003f", "ID_STRING": "NAME_TXT", "TEXT": "GK wch do strefy gras 3", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV003f", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Milordzie! Zło działa tu ze zbyt wielką siłą, jeśli wkrótce nie odejdziemy, zabije nas...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0041", "ID_STRING": "NAME_TXT", "TEXT": "Imp Lok Babalon ", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0041", "ID_STRING": "POPUP_TXT", "TEXT": "Zwiadowca\n\"Na południe stąd znajduje się miasto Maldrik. Niegdyś było jednym z najbogatszych grodów w królestwie. Po wojnie Kadrath nazwał je imieniem swego trzeciego dziecka-demona, Babalona...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0043", "ID_STRING": "NAME_TXT", "TEXT": "GK Txt Babalon ", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0043", "ID_STRING": "POPUP_TXT", "TEXT": "Zwiadowca\n\"Na południe stąd znajduje się miasto Maldrik. Niegdyś było jednym z najbogatszych grodów w królestwie. Po wojnie Kadrath nazwał je imieniem swego trzeciego dziecka-demona, Babalona...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0044", "ID_STRING": "NAME_TXT", "TEXT": "GK lok wejście wieży", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0044", "ID_STRING": "POPUP_TXT", "TEXT": "Elf\n\"Na południe stąd znajduje się wejście do wieży Kadratha. Strzeżcie się, powiadają bowiem, że strażnik wieży włada magicznymi mocami i jest niemal nieśmiertelny.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0045", "ID_STRING": "NAME_TXT", "TEXT": "GK spalone miasto", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0045", "ID_STRING": "POPUP_TXT", "TEXT": "Chłop\n\"Kadrath zniszczył nasze miasto, ponieważ nie chcieliśmy się poddać. Daruje życie tylko tym, którzy oddadzą mu cześć. Pomścij nas, panie...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0046", "ID_STRING": "NAME_TXT", "TEXT": "Imp lok Baphomet", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0046", "ID_STRING": "POPUP_TXT", "TEXT": "Zwiadowca\n\"Na północ stąd znajduje się miasto Andragard. Podczas wojny Kadrath wysłał swoje pierwsze dziecko-demona, Baphometa, aby podporządkował sobie niewiernych. Przejąwszy miasto nazwał je imieniem swego syna.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0047", "ID_STRING": "NAME_TXT", "TEXT": "GK Txt Baphomet", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0047", "ID_STRING": "POPUP_TXT", "TEXT": "Zwiadowca\n\"Na północ stąd znajduje się miasto Andragard. Podczas wojny Kadrath wysłał swoje pierwsze dziecko-demona, Baphometa, aby podporządkował sobie niewiernych. Przejąwszy miasto nazwał je imieniem swego syna.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0048", "ID_STRING": "NAME_TXT", "TEXT": "I zdobycie twierdzy Kadratha", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0049", "ID_STRING": "NAME_TXT", "TEXT": "Zdobycie Baphomet", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV004a", "ID_STRING": "NAME_TXT", "TEXT": "GK zdobycie twierdzy Kadratha", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV004b", "ID_STRING": "NAME_TXT", "TEXT": "Imp lok obelisk", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV004b", "ID_STRING": "POPUP_TXT", "TEXT": "Zwiadowca\n\"Panie, czuję tu silny wpływ zła. Pochodzi ze wschodu, ale nie widzę jego źródła. Musimy poruszać się ostrożnie!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV004c", "ID_STRING": "NAME_TXT", "TEXT": "Imp tworzy smoka śmierci", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV004d", "ID_STRING": "NAME_TXT", "TEXT": "GK tworzą smoka śmierci", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV004f", "ID_STRING": "NAME_TXT", "TEXT": "I ostrzeżenie o strażniku", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV004f", "ID_STRING": "POPUP_TXT", "TEXT": "Zwiadowca \n\"Przed nami stoi strażnik wieży. Nie zdołamy go pokonać, milordzie. Jedynym sposobem na pobicie go jest zajęcie trzech przeklętych miast. Jeśli tego dokonamy, Kadrath nie będzie miał dość sił, by utrzymać demona w naszym wymiarze.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0050", "ID_STRING": "NAME_TXT", "TEXT": "GK ostrzeżenie o strażniku", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228EV0050", "ID_STRING": "POPUP_TXT", "TEXT": "Zwiadowca \n\"Przed nami stoi strażnik wieży. Nie zdołamy go pokonać, milordzie. Jedynym sposobem na pobicie go jest zajęcie trzech przeklętych miast. Jeśli tego dokonamy, Kadrath nie będzie miał dość sił, by utrzymać demona w naszym wymiarze.\"", "SEQ_NUM": 0},
