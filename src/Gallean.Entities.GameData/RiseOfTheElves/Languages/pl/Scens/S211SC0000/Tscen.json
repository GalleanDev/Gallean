    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211LO0011", "ID_STRING": "NAME_TXT", "TEXT": "Legiony kupiec", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Młyn", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Mam najlepsze buty w okolicy.", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Mithikora", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Wyglądasz, jakbyś chciał coś kupić, a ja właśnie jestem kimś, kto może ci sprzedać wszystko, czego potrzebujesz.", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Obóz Kiggera", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Mogę dla ciebie wezwać żywiołaki, a jeśli będzie cię na to stać, czy przyjmiesz na służbę jednego z mych uczniów?", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutralni", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Brak opisu rasy", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211PL0001", "ID_STRING": "NAME_TXT", "TEXT": "Konrad", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211PL0001", "ID_STRING": "DESC_TXT", "TEXT": "W czasach młodości ten wielki władca stanął samotnie przeciw wojsku piekieł i pokonał je zapieczętowując bramy, które je wypluwały. Następnie objął suwerenną władzę nad swoim królestwem.", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211PL0002", "ID_STRING": "NAME_TXT", "TEXT": "Zagamon", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211PL0002", "ID_STRING": "DESC_TXT", "TEXT": "Jego imieniem straszy się dzieci. Ten pan piekieł słynie ze swej krwiożerczości. Mówi się, że kiedyś, w czasie bankietu wdanego przez Bethrezena z okazji zwycięstwa nad królestwem światłości, pożarł tysiąc niewolników.", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Ravon Mith", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Bretish Zok", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211UN0005", "ID_STRING": "NAME_TXT", "TEXT": "Meftu-Kraken", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211UN0008", "ID_STRING": "NAME_TXT", "TEXT": "Syrena", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211UN0009", "ID_STRING": "NAME_TXT", "TEXT": "Syrena", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211UN000c", "ID_STRING": "NAME_TXT", "TEXT": "Syrena", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211UN001e", "ID_STRING": "NAME_TXT", "TEXT": "Królewski Konwój Rendoru", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211UN001f", "ID_STRING": "NAME_TXT", "TEXT": "Konwój Keven", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Kraken", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211UN0024", "ID_STRING": "NAME_TXT", "TEXT": "Mithikor", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Imperium pomoc", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Mithikor \n\"Właśnie przybyłem z odległych krain i przywiozłem ze sobą przedmioty, które pomogą nam w walce przeciw demonom!\"", "SEQ_NUM": 5},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Intro Imperium", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Dzień dobry, panie. Muszę cię ostrzec, że ten region nękają tropiciele i kapłani, którzy zdradzili Imperium. Sugeruję, żebyśmy uporali się z nimi, zanim zajmiemy się Legionami. Nie możemy narażać się na atak od tyłu.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Legion pomoc", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Demon \n\"Moje żyły są nabrzmiałe od nienawiści do Imperium i tego, co ono reprezentuje. Pomóż mi wywrzeć zemstę.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211UN0027", "ID_STRING": "NAME_TXT", "TEXT": "Syrena", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Intro Legion", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Przyszedł czas, by wypełniła się pradawna przepowiednia i władza demonów rozprzestrzeniła się po świecie. Musimy najpierw zniszczyć Gorgotha i Bhaartha. Wiarołomne demony muszą zostać zabite, aby proroctwo mogło się nadal spełniać!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Martwi kapłani", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Kapłan \n\"Zdradliwi kapłani zapłacili za sprzeniewierzenie się Wszechojcu. Niech ta bitwa pokaże moc Imperium!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Martwy tropiciel", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Kiedy załatwiliśmy sprawę tej... zniewagi... względem tropicieli, może będzie nam łatwiej rekrutować łuczników...\" ", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211UN002b", "ID_STRING": "NAME_TXT", "TEXT": "Syrena", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Ostrzeżenie orków", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Zwiadowca orków \n\"Nikt nie wejdzie na nasze ziemie. Wracajcie tam, gdzie wasze miejsce!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Opowiedz o żywej zbroi", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Powiadają, że jeśli znajdziesz chwilę czasu na modlitwę do Wszechojca w pobliżu pradawnych posągów, może on przyjść ci z pomocą. Podobno taki posąg znajduje się gdzieś na wschodzie.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211UN002e", "ID_STRING": "NAME_TXT", "TEXT": "Wąż morski", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Rzucanie żywej zbroi", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Żywa zbroja \n\"Jestem tu, by służyć Wszechojcu! Przyszedł czas, aby usunąć stąd Legiony i każdego, kto się mu sprzeciwi!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Ostrzeżenie miasta krasnoludów", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Strażnik Bractwa\n\"Nie macie prawa zajmować miasta należącego do Bractwa Północy! Będziemy bić się do ostatniej kropli krwi, a każdego z naszych poległych braci zastąpi trzech kolejnych!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211UN0030", "ID_STRING": "NAME_TXT", "TEXT": "Syrena", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Martwe demony", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Oto drobny przejaw naszej wdzięczności za zabicie tych zbuntowanych demonów. Za dalszą służbę będziemy was hojnie wynagradzać!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Krasnoludzki szaniec", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Wywołanie orka", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Legion kupiec", "SEQ_NUM": 0},
    {"NO_SCEN": "S211SC0000", "ID_OBJECT": "S211EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Mithikor \n\"Nie myślcie, że wybrawszy sobie za cel pojedynczego kupca, zdołacie wygrać tę bitwę!\"", "SEQ_NUM": 0},
