    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255UN0185", "ID_STRING": "NAME_TXT", "TEXT": "Wilk", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255UN0189", "ID_STRING": "NAME_TXT", "TEXT": "Zgłębiczart", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255UN019a", "ID_STRING": "NAME_TXT", "TEXT": "Hazky'la", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Imp. lok. osada chłopska", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Chłopi \n\"Imperium już nie ma władzy nad chłopami! Jesteśmy teraz wolni, pod przywództwem lorda Kyna!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Imp. lok. posiadłość Lorda Kyna", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Zbuntowany giermek \n\"Trzymajcie się z daleka. Zostawcie w spokoju dobrego lorda Kyna! Jest przywódcą, który troszczy się o swój lud!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Imp. lok. włócznik na murach", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Włócznik\r\"Rządy Imperium się skończyły! Lord Kyn zabronił żołnierzom Imperium przekraczać granicę Pogórza, dopóki nie zostaniemy uznani za wolnych!\"\r\n", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Imp. lok. włócznik na warcie", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Włócznik \n\"Czekajcie! Nie radziłbym wam iść dalej! Legiony spalą was na skwarki!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Lok. warta włóczników", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Włócznik \n\"Alarm dla straży! Nadciąga wrogie wojsko!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Imp. Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Po tym, jak przekonaliśmy górala Vaglana, aby przyłączył się do naszej sprawy, rozpoczęliśmy planowanie ataku na północne pogranicze Legionów.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Dzięki wskazówkom Vaglana strategicznie rozmieściliśmy naszych czterech najlepszych wodzów, którzy są gotowi do przerwania frontu i zajęcia wrogich miast.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Teraz wszystko zależy od tego, czy Legiony będą szukać pomocy u Hord Nieumarłych, które zamieszkują na wschodzie. Jeśli tak się stanie, może być trudniej, niż przewidywaliśmy.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Nieum. Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Nasza polityka wyczekiwania wreszcie przynosi owoce, panie. Zdaje się, że Legiony zapomniały o ostrożności, wystawiając się na frontalny atak ze strony Imperium.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"To spowodowało sprzyjający nam zamęt na Pogórzu. Mamy teraz możliwość pokonania obu naszych przeciwników, dopóki są osłabieni i rozproszeni.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Wysłaliśmy w te strony wielu szpiegów, którzy mieli zbadać doniesienia i umożliwić wybór najlepszego momentu do ataku.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Leg. Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Kiedy Vaglan odmówił przyłączenia się do naszej sprawy, Imperium pogrążyło się w kryzysie. Zwołane w pośpiechu spotkanie z włodarzami sprzymierzonego z nami miasta nie przyniosło żadnych jednoznacznych rozwiązań.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Wówczas powstało Przymierze Mniejszych Demonów. Nie wierząc, że potężne Legiony Potępionych mogą je ochronić, oddzieliły się od nas. To stawia nas na bardzo słabej pozycji.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Musimy w jakiś sposób odbić miasta i rozbić Przymierze, aby ludzie poznali swego prawdziwego władcę!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Lok. terytorium zbirów 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Zbir \n\"Stać! Te ziemie należą do nas! Jeśli wam życie miłe, zawracajcie i uciekajcie do domu.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Lok. terytorium zbirów 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Zbiry\n\"Stać! Te ziemie należą do nas! Jeśli wam życie miłe, zawracajcie i uciekajcie do domu.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Imp. lok. Wieża Zombi", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Milordzie, od wieży bije paskudny fetor, a zombi czołgają się wokół... Musi tu działać jakaś niezwykła nekromancja!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Nieum. lok. kontrola nieum.", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Panie, tracimy kontrolę nad krajem... Wielu nekromantów założyło wokół miasta własne kulty. Musimy wymierzyć im karę!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Lok. pajęcza pułapka", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "\"To pułapka, milordzie! Pająki urządziły na nas zasadzkę!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Imp. zwycięstwo", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Leg. zwycięstwo", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Imp. zdob. Smocza Dolinę", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Demony \n\"Nie pozwolimy na to, by te ziemie na dłużej wpadły w ręce ludzkiego śmiecia! Nie panoszcie się tu zbytnio...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź warownię Indrus", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Nieum. lok. zbuntowane zombi", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Te zombi są kontrolowane przez jakiegoś szalonego okultystę! Powinniśmy znaleźć i zniszczyć źródło tej mocy!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Wył. łotrzyki zombi", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Imp. lok. Smocza Dolina", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Przed nami miasto Smoczej Doliny. Powiadają, że był to niegdyś wspaniały gród rządzony przez wielkie smoki. Jednak w czasie wojny został on zniszczony przez Legiony i dzisiaj nawiedzają go tylko smocze duchy.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Allantyr", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Krasnoludy\r\"Nie myślcie, że wam się to uda! Będziemy się bić do ostatka! Nasze wojska wkrótce wrócą do nas z odsieczą!\"\n", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź miasto krasnoludów", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Krasonludy\r\"My, krasnoludy, jesteśmy rasą wojowniczą i pamiętliwą. Na Wotana, odbierzemy z powrotem naszą stolicę!\"\r \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Atak krasn. na m. krasn.", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Lok. oblężenie krasnoludów", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Żołnierze krasnoludzcy \n\"Odejdźcie stąd. Krasnoludy oblegają to miasto!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Lok. pn. miasto krasnoludów", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Strażnik miasta krasnoludów \n\"Te ziemie należą do krasnoludów. Nie jesteście tu mile widziani!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Lok. wejście do wsch. m. krasn.", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Skalny olbrzym \n\"To krainy krasnoludów! Nie jesteście tu mile widziani!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Włącz wywołanie demona", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Wywołaj demona", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Nieum. zwycięstwo", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Leg. zdob. Troję", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Utrzymanie kontroli nad tym miastem jest koniecznością. Potem pozostanie nam już tylko zajęcie Smoczej Doliny.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Leg. zdob. Smoczą Dolinę", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Utrzymanie kontroli nad tym miastem jest koniecznością. Potem pozostanie nam już tylko zajęcie Troi.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Kannę", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Leg. przym. mn. demonów", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Panie, grupa zbuntowanych mniejszych demonów pragnie powrócić pod nasze zwierzchnictwo. Jeśli spotkamy ich w okolicy Troi, zwiększenie liczebności naszych szeregów może się bardzo przydać...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Kilgena", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Myślę, że moja pomoc może ci się przydać.", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0022", "ID_STRING": "NAME_TXT", "TEXT": "Leg. lok. sprzym. demony", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0022", "ID_STRING": "POPUP_TXT", "TEXT": "Hazky'la\r\"Tak, z pewnością nie pragniemy złościć Bethrezena! Będziemy wiernie służyć w szeregach waszej armii!\"\r \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Nieum. lok. Smocza Dolina", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0023", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Przed nami miasto Smoczej Doliny. Powiadają, że był to niegdyś wspaniały gród rządzony przez wielkie smoki. Jednak w czasie wojny został on zniszczony przez Legiony i dzisiaj nawiedzają go tylko smocze duchy.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Zaopatrzenie Lorda Kyna", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Mamy wszystko, czego możecie potrzebować!", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0024", "ID_STRING": "NAME_TXT", "TEXT": "Leg. lok. wieża zombi", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255EV0024", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Panie, od wieży bije paskudny fetor, a zombi czołgają się wokół... Musi tu działać jakaś niezwykła nekromancja!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Allara", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Za pieniądze... handluję wszystkim.", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0005", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Yggara", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0005", "ID_STRING": "TXT_DESC", "TEXT": "Moje towary pomogą ci w twojej misji.", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0006", "ID_STRING": "TXT_TITLE", "TEXT": "Obóz Luggena", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0006", "ID_STRING": "TXT_DESC", "TEXT": "Czy potrzebujesz rekrutów?", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0007", "ID_STRING": "TXT_TITLE", "TEXT": "Obóz Guthera", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0007", "ID_STRING": "TXT_DESC", "TEXT": "Moi żołnierze są najlepsi w regionie.", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0008", "ID_STRING": "TXT_TITLE", "TEXT": "Obóz Lorda Kyna", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0008", "ID_STRING": "TXT_DESC", "TEXT": "Sztuki wojennej nauczy się tu każdy!", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0009", "ID_STRING": "TXT_TITLE", "TEXT": "Obóz Reggena", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0009", "ID_STRING": "TXT_DESC", "TEXT": "Wszystko rodzi się w bólu.", "SEQ_NUM": 0},
