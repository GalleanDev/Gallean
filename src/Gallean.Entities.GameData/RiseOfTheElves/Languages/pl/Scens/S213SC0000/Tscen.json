    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213LO0012", "ID_STRING": "NAME_TXT", "TEXT": "Herald Angels", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213LO0013", "ID_STRING": "NAME_TXT", "TEXT": "Spearman Message", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213LO0014", "ID_STRING": "NAME_TXT", "TEXT": "Squire Says leave", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Tralara", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Myślę, że moja pomoc może ci się przydać.", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Obóz Dennara", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Moi Barbarzyńcy zapewnią ci zwycięstwo.", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213SI0004", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Furrena", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213SI0004", "ID_STRING": "TXT_DESC", "TEXT": "Moje towary pomogą ci w twojej misji.", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutralni", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Brak opisu rasy", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Gunrha", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Jego imieniem straszy się dzieci. Ten pan piekieł słynie ze swej krwiożerczości. Mówi się, że kiedyś, w czasie bankietu wdanego przez Bethrezena z okazji zwycięstwa nad królestwem światłości, pożarł tysiąc niewolników.", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Lantfrid", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Najwyższy z władców krasnoludów, znany jest ze swej zaciętości w bitwie i odwagi w obliczu niesprzyjających okoliczności. Kiedyś przez siedem dni i nocy walczył z wielkim smokiem ARFURUZONEM, by wreszcie go pokonać.", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Zaorish", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213UN0004", "ID_STRING": "NAME_TXT", "TEXT": "Kraken", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213UN0007", "ID_STRING": "NAME_TXT", "TEXT": "Syrena", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213UN001f", "ID_STRING": "NAME_TXT", "TEXT": "Giermek", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213UN0025", "ID_STRING": "NAME_TXT", "TEXT": "Czarodziej", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Atak błyskawicy", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Anioł Miłosierdzia \n\"Odejdźcie! Nikt nie wkroczy do Bitter Bliss, aby przeszkodzić nam w naszej misji niesienia pomocy Prowess. Chwała Gwieździe Żałoby!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Healing Grounds", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Highfather Blessing", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Vinusi Message", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Rycerz Vinusi \n\"Dobrze, wolę powiedzieć tobie niż demonom. Posąg Wszechojca to znak Niebian. Udajcie się do niego, a zostaniecie cudownie uzdrowieni. Aniołowie Miłosierdzia są groźnym przeciwnikiem, magia Niebian może okazać się bardzo pomocna.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Rock Castle Message", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Dzielny Rycerz \n\"Na północ stąd znajduje się cmentarzysko, gdzie królują Nieumarli. To teren Niebian. Wejdźcie na teren cmentarzyska, a zostaniecie cudownie uzdrowieni.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Final Message", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Askael \n\"Kiedy Aniołowie Miłosierdzia zostaną zgładzeni, zniewolimy Prowess i puścimy z dymem wszystko, co cenne dla jego mieszkańców!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Legiony warunek zwycięstwa", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Ashkael \nProwess świętuje Diabelską Noc! Ten niegdyś spokojny i bogaty region stał się krainą chaosu i ognia. Mieszkańcy Prowess zostali niewolnikami lub żołnierzami w Legionach Potępionych!", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Island of Virago", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Arcydiabeł \n\"Wyspy Virago strzegą orkowie. Chodzą słuchy, że mają oni sporo złota. Przy odrobinie szczęścia zdołamy je odebrać tym głupim bestiom.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Legions Day One", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Arcydiabeł \n\"Region Prowess został przejęty przez Aniołów Miłosierdzia. Uważają oni, że poprzez wzmocnienie kontroli nad krainą zdołają zaprowadzić tam pokój. W wieży Bitter Bliss Aniołowie obmyślają plan powstrzymania nadchodzącego rytuału.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Mc Day One", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Region Prowess zerwał kontakty handlowe ze wszystkimi sąsiadami. Wiele naszych miast utrzymywało się głównie z handlu z tym regionem. Niestabilna gospodarka może oznaczać ich rychły upadek.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213UN0036", "ID_STRING": "NAME_TXT", "TEXT": "Giermek", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Wizard Message", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Czarodziej \n\"Czemu walczycie przeciw wszystkiemu, co dobre? Nadchodzi Diabelska Noc, musimy połączyć siły, aby raz na zawsze rozprawić się z Heretykami. Sprzeciwiając się nam, stajecie po stronie wroga! Stawajcie do walki!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Squire Message", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Giermek \n\"Stójcie! Aniołowie zabronili wstępu na te ziemie!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Vinusi II", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Rycerz Vinusi \n\"Proszę, nie rób tego więcej, powiem ci wszystko, co wiem. Jaki posąg? ACH! Tak! Tak... posąg uzdrowi wszystkich - nawet takich Heretyków, jak wy...Proszę, pozwólcie mi umrzeć.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213UN003a", "ID_STRING": "NAME_TXT", "TEXT": "Giermek", "SEQ_NUM": 0}
  ]
}
