{
  "formatVersion": 1,
  "rows": [
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Spectre", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Widmo \n\"Wkroczyłeś na nasz teren i już nie opuścisz tego miejsca!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Tower Guard", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Lojalny Włócznik \n\"Zbliż się tylko, a zrobię ci paskudną bliznę! Popamiętasz mnie do końca życia - oczywiście pod warunkiem, że w ogóle wyjdziesz z tego cało...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Tower II", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Anioł Miłosierdzia \n\"Diabelska Noc nie dojdzie do skutku. Porządek zatriumfuje nad chaosem. Taka jest odwieczna kolej rzeczy.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213UN003e", "ID_STRING": "NAME_TXT", "TEXT": "Giermek", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Rock Soldiers", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Herald Angel", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Anioł Miłosierdzia\n\"W imię ładu i porządku, opuśćcie to miasto!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV001e", "ID_STRING": "NAME_TXT", "TEXT": "MC Winning Event", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Vithar \n\"Region Prowess wyzwolił się spod ucisku Aniołów Miłosierdzia. Nadal będziemy z nim utrzymywać kontakty handlowe. Dzisiaj będziemy ucztować i świętować nasze wspaniałe zwycięstwo! Dziewko, przynieś mi piwa!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213UN0042", "ID_STRING": "NAME_TXT", "TEXT": "Włócznik", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Hammer Hurt Em", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Czarodziej \n\"Młot Mjornira jest przeklęty. Jeśli ktoś niegodny tego zaszczytu spróbuje go objąć w posiadanie, pojawią się Aniołowie i zgładzą tego grzesznika. Będę chronił Młot przed niegodnymi rękami.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Primera Text", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Rebeliant Primera\n\"Ci tak zwani Aniołowie Miłosierdzia ściągnęli śmierć i cierpienie na lud, który, jak sami twierdzą, mają ochraniać! Aniołowe twierdzą, że to nasz konflikt jessssst przyczyną upadku Prowesss. Pomożemy zniszczyć Bitter Blisss!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Primera Text Legions", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0023", "ID_STRING": "POPUP_TXT", "TEXT": "Rebeliant Primera \n\"Wychwalajcie Diabelską Noc! Niechaj rytuał rozpocznie się od zagłady Bitter Bliss! Ci, którzy obiecywali nas bronić, odarli nas z naszej godności! Pomożemy wam w waszej krucjacie przeciwko Aniołom Miłosierdzia.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Primerians Defense", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Anioł Miłosierdzia \n\"Wszyscy intruzi, dla zapewnienia bezpieczeństwa w Prowess, będą traktowani z najwyższą surowością. Chwała Gwieździe Żałoby!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Spearman Message", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0026", "ID_STRING": "POPUP_TXT", "TEXT": "Posłaniec \n\"Odejdźcie! Nie jesteście tu mile widziani!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Nowe zdarzenie", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Dostojny Rycerz z Fortu Marszowego \n\"Choć przegraliśmy tę bitwę, wojna się jeszcze nie skończyła! Zwyciężymy, gdyż czuwają nad nami Aniołowie!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0028", "ID_STRING": "NAME_TXT", "TEXT": "March Fort Legions", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "Dostojny Rycerz z Fortu Marszowego \n\"Ghhhhhhuuuu...koniec jest bliski...wasza żałosna rasa jest przeklęta! Skończ ze mną, ale zapamiętaj me słowa, bluźnierco... Wasz terror wkrótce dobiegnie końca, nadchodzi czas wszechogarniającej świętości!\" \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "Wyznawca \n\"Ha ha ha ha! Cisza, prostaku! Ta twoja wielka świętość skończy tak samo, jak ty - zdechnie powolną, bolesną śmiercią! Giń ze świadomością, że umierasz na darmo!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Virago Victory Text", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV0029", "ID_STRING": "POPUP_TXT", "TEXT": "Miotacz toporów \n\"Niechaj to będzie jasne: Klany Górskie będą walczyć dalej. Zwyciężymy, bo nasza odwaga dorównuje naszej sile.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Virago Legions", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV002a", "ID_STRING": "POPUP_TXT", "TEXT": "Książę \n\"Przeciwnik traci kolejne atuty. Wkrótce nadejdzie Diabelska Noc i cały świat zadrży przed naszą potęgą!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Vinusi Healing Clans", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV002c", "ID_STRING": "POPUP_TXT", "TEXT": "Tenderfoot \n\"Panie, dowiedziałem się, że miasto Vinusi ma niezwykłą historię. W poprzedniej epoce mieszkały tu mistyczne istoty zwane Niebianami. Grzebali swoich zmarłych w mieście.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV002c", "ID_STRING": "POPUP_TXT", "TEXT": "Tenderfoot \n\"Według mnie tereny wokół Vinusi są zaklęte. Musimy mieć oczy otwarte, może znajdziemy jakieś znaki. Może uda nam się posiąść niebiańską sztukę uzdrawiania.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV002d", "ID_STRING": "NAME_TXT", "TEXT": "Vinusi Legions", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Wyznawca \n\"Panie, oto czego dowiedziałem się o tych terenach. W zamierzchłych czasach mieszkali tutaj Niebianie.\" \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Książę \n\"Cisza, głupcze! Nie obchodzą mnie twoje historyjki! Dla wielu jestem uosobieniem grozy. Wrogów ścieram na proch. Więc lepiej unikaj mojego gniewu.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Wyznawca \n\"Stokrotne przeprosiny, Mistrzu! Chciałem ci tylko powiedzieć, że miasto Vinusi zamieszkiwali kiedyś Niebianie. Podobno ta kraina jest zaklęta. Wszyscy, którzy postawią tu stopę, zostaną uzdrowieni.\" \n", "SEQ_NUM": 2},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Książę \n\"Dobrze, przyjmuję to do wiadomości. Pamiętaj, aby nie lekceważyć moich słów. Biada temu, kto zasłuży na mój gniew. Zbliża się Diabelska Noc, wkrótce świat zadrży przed naszą potęgą!\" \n", "SEQ_NUM": 3},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV002e", "ID_STRING": "NAME_TXT", "TEXT": "Rock Castle ML", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV002e", "ID_STRING": "POPUP_TXT", "TEXT": "Dostojny Rycerz ze Skalnego Zamku\n\"Na północ stąd znajduje się miejsce pochówku Niebian. Czuwa nad nim strażnik.\" \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV002f", "ID_STRING": "NAME_TXT", "TEXT": "Leave This Place", "SEQ_NUM": 0},
    {"NO_SCEN": "S213SC0000", "ID_OBJECT": "S213EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "Giermek\n\"Kazano nam poinformować was, że nie jesteście tu mile widziani. Prowess zrywa wszelkie kontakty handlowe z Klanami Górskimi. Odejdźcie. Zostaliście ostrzeżeni.\" \n", "SEQ_NUM": 0},
