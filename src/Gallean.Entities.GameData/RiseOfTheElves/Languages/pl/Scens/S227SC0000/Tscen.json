    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227LO0019", "ID_STRING": "NAME_TXT", "TEXT": "To ja", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227LO001a", "ID_STRING": "NAME_TXT", "TEXT": "Nie jestem chłopem", "SEQ_NUM": 0},
