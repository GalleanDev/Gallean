    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Obóz Turiona", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Czy potrzebujesz rekrutów?", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Ebhona", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Moje towary pomogą ci w twojej misji.", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Obóz Zoltarsa", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Za określoną cenę wytrenuję twoje jednostki", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutralni", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Brak opisu rasy", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Calderic", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Najwyższy z władców krasnoludów, znany jest ze swej zaciętości w bitwie i odwagi w obliczu niesprzyjających okoliczności. Kiedyś przez siedem dni i nocy walczył z wielkim smokiem ARFURUZONEM, by wreszcie go pokonać.", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Asumuel", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Jego imieniem straszy się dzieci. Ten pan piekieł słynie ze swej krwiożerczości. Mówi się, że kiedyś, w czasie bankietu wdanego przez Bethrezena z okazji zwycięstwa nad królestwem światłości, pożarł tysiąc niewolników.", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Heiric", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Zaorish", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0008", "ID_STRING": "NAME_TXT", "TEXT": "Książę Daxam", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0016", "ID_STRING": "NAME_TXT", "TEXT": "Pajęcze Berło", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0019", "ID_STRING": "NAME_TXT", "TEXT": "Wampir", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN001d", "ID_STRING": "NAME_TXT", "TEXT": "Nekromanta", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0022", "ID_STRING": "NAME_TXT", "TEXT": "Wynfeld Ryś", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Legiony warunek zwycięstwa", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Zwierz", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0002", "ID_STRING": "NAME_TXT", "TEXT": "C1", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0003", "ID_STRING": "NAME_TXT", "TEXT": "C2", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Nekromanta atakuje", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Phonycjański powstaniec \n\"Phonycjanie, odmieńcy z Bythazaru, napadną na wasze królestwo. Kiedy to nastąpi, nikt nie będzie bezpieczny, gdyż rozniesiemy nasze... przesłanie wśród waszych rodzin i przyjaciół!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Lecznie - Klany", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Legiony uzdrowienie", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Tekst Mystasha", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Mieszkaniec Mystash \n\"Dziękujmy za wyzwolenie nas z więzów Wynfeld. Książę Daxam przybył na nasze ziemie ze swoimi najlepszymi żołnierzami. Dzięki swemu bogactwu zdobył jakąś niesamowitą broń. Nikt nie wie, co to jest, ale wszyscy drżą ze strachu...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Zgnilizna", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Mag \n\"Bogactwa księcia Daxama pozwalają mu sięgać nawet za granice kraju. Od wędrownego kupca zdołał pozyskać białego smoka. Bestia jest mało odporna, jednak jej ogień ma większą moc niż u innych z jej gatunku.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Zgnilizna wiadomość 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Giermek \n\"Śmierć Legionom! Armię księcia Daxama wspiera teraz bestia nie mająca sobie równych. Wypiję za wasze zwłoki po tym, jak zostaniecie już usunięci z tego świata!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN002d", "ID_STRING": "NAME_TXT", "TEXT": "Ork", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN002e", "ID_STRING": "NAME_TXT", "TEXT": "Ork", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Warunek zwycięstwa GK", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0030", "ID_STRING": "NAME_TXT", "TEXT": "Ork", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Legion historia", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Ashkael \n\"Niewielkie królestwo Bythazarau ma dużą koncentrację złotych żył. Ten obszar jest silnie broniony przez orków i im podobnych, ale musimy go zająć. Pokażemy Daxamowi, co grozi tym, którzy rzucają wyzwanie Legionom!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Historia Górskich Klanów", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Zabijając Daxama, ryzykujemy, że jego ludzie obrócą się przeciw nam. To prawda, że są źli na swego władcę, ale niełatwoz aakceptują nowego. Kiedy zgładzimy księcia, musimy zająć Bythazar i przywrócić porządek.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Gwardia doborowa", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Bragon ze Wzgórz \n\"Książe Daxam finansuje swoją elitarną gwardię z wysokich podatków nałożonych na Bythazar. Straż pałacowa dostała najlepszy oręż i zbroje, jakie można zdobyć płacąc złotem.\"\n", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0033", "ID_STRING": "NAME_TXT", "TEXT": "Goblin", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Wiadomość Sępów", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Ashkael \n\"Widziano jednego ze sług księcia Daxama, jak negocjował z kupcem. Ten handlarz należy do potężnej gildii znanej pod nazwą Sępów. Krążą plotki, że książę szuka środków do obrony swego zamku.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Ostrzeżenie", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Widmo \n\"Zawróćcie i odejdźcie stąd. Chyba że pragniecie tak jak ja oddać się w ramiona śmierci.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0037", "ID_STRING": "NAME_TXT", "TEXT": "Atak goblina", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Zombi w szale", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Tekst Mystasha", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Doborowy żołnierz \n\"Przeklęci tutaj... w naszym królestwie? Poddamy się waszej potędze, ale książę Daxam nie ugnie się tak łatwo. Spotyka się z kupcami, którzy handlują różnymi dziwactwami. Kto wie, co przywiezie ze sobą...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Zbir atakuje", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN003b", "ID_STRING": "NAME_TXT", "TEXT": "Ork", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Phonycjanin", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Phonycjanin \n\"Pajęcze Berło... Pajęcze Berło. Jak dobrze jessst być martwym, szukajcie pająka, albo berła i przyłączcie się do nasss. Cały ból minie...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Phonycjańska wiadomość dla LP", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Phonycjanin \n\"Książę Daxam to głupiec, a królessstwo jego ojca popadnie w ruinę. Czuję, że król zginie z rąk nieumarłych. Aaach... szukacie tarczy? Goście to radość dla wampira.\"\u0013", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Legion wiadomość", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Arcyczart \n\"Dowiedzieliśmy się, że gdzieś w tych stronach stoi święty posąg Górskich Klanów. Tylko ich przedstawiciele mogą doń podchodzić bez ryzyka, wszyscy inni porażeni zostaną mocą tego żałosnego bożka!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Legion kara", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Komunikat w górach", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Górski olbrzym \n\"To posąg tylko dla demonów. Tylko Legiony mogą używać mocy. Jeśli się zbliżymy, spadnie na nas klątwa!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Kara w górach", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Wiadomość odwrotu", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Zbir\n\"Zważywszy na to, że stanąłem na waszej drodze i uratowałem was od wielkiego pająka, zakładam, że jesteście mi winni sporo złota. Jeśli nie macie dzisiaj zbyt hojnego nastroju, mam paru ostrych przyjaciół, którzy pomogą wam zmienić zdanie.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Straż Miejska", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Doborowy włócznik \n\"Stój! Nikt nie przejdzie przez bramę! Zamek Phonycian nie jest miejscem dla zdrajców z Bythazaru! Taki jest rozkaz ojca Daxama, króla Virgila.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Wielki Pająk II", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Wielki Pająk III", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0044", "ID_STRING": "NAME_TXT", "TEXT": "Ork", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0022", "ID_STRING": "NAME_TXT", "TEXT": "Ostrzeżenie kupca", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0022", "ID_STRING": "POPUP_TXT", "TEXT": "Chłop \n\"Wokół czyhają niebezpieczeństwa! Zwierzęta i smoki atakują z ciemności. Trzeba było posłuchać rady nieziemskiej istoty!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Król orków", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0023", "ID_STRING": "POPUP_TXT", "TEXT": "Ork \n\"Przynosicie wieści o królu orków? Nie? To może przychodzicie, żebyśmy was porąbali na sztuki?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0024", "ID_STRING": "NAME_TXT", "TEXT": "Wampir", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0024", "ID_STRING": "POPUP_TXT", "TEXT": "Wampir\n\"Chodź bliżej... bliżej... a w moich oczach ujrzysz los, którego pragniesz. Podejdź, a dowiesz się, gdzie znaleźć nieczysty artefakt.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0047", "ID_STRING": "NAME_TXT", "TEXT": "Ork", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Wiadomość wampira II", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Wampir \n\"Chodź bliżej... bliżej... a poznasz sekret zwycięstwa nad księciem Daxamem. Podejdź, a poznasz wielkie bogactwo... czy boisz się?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Opuść nasz dom", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0026", "ID_STRING": "POPUP_TXT", "TEXT": "Phonycjański zombi \n\"Opuśćcie to miejsce, a przeżyjecie. Zossstańcie, a ssstaniecie się jednymi z nasss, wygnańcami z Bythazaru - Phonycjanami!\" ", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Pierwsza tura", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Mój panie, orkowie i ich pobratymcy zdołali dostać się do naszych jaskiń, teraz zamykają przejścia. Orkowie nie są zdolni do tak przemyślanych działań, ktoś musi nimi kierować. Przeczucie mówi mi, że tą osobą jest książę Daxam...\"   ", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0028", "ID_STRING": "NAME_TXT", "TEXT": "To ja", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "Phonycjański powstaniec \n\"To ja obróciłem sprawy przeciw wam. Książę Daxam i jego ojciec to głupcy! Wkrótce Phonycjanie będą panami tych ziem, a Hordy Nieumarłych powstaną i rozsieją wokół śmierć i zepsucie!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN004c", "ID_STRING": "NAME_TXT", "TEXT": "Giermek", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Nie jestem chłopem", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV0029", "ID_STRING": "POPUP_TXT", "TEXT": "Generał \n\"Nie jestem chłopem! Zmierzyć się ze mną, znaczy ponieść porażkę. Mam nadzieję, że dobrze bawiliście się z moimi orkami. Nie są zbyt lotni, ale łatwo ich kupić. Bogactwo Daxama przyniesie też inne niespodzianki, ale wy ich nie zobaczycie.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Pierwsza tura GK", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002a", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Orkom udało się dostać do naszej górskiej bazy. W jakiś sposób te głupie stwory zdołały zapieczętować większość wejść. Orkom brak inteligencji do zaplanowania takich działań, więc ktoś musi ich kontrolować... Czyżby Daxam?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Zabójca księcia", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002c", "ID_STRING": "POPUP_TXT", "TEXT": "Doborowy żołnierz \n\"Książę Daxam wydał rozkaz stracenia wszystkich wrogów stanu. I kogo miał na myśli? Właśnie was!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN004f", "ID_STRING": "NAME_TXT", "TEXT": "Giermek", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002d", "ID_STRING": "NAME_TXT", "TEXT": "Nowe zdarzenie", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Ashkael \n\"Książę zbiera nową armię - własną przyboczną gwardię. Straż zamkowa zostanie wyposażona w najlepszy oręż i zbroje, jakie można kupić płacąc złotem, a obawiam się, że może dostać do dyspozycji także inne niespodzianki.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002e", "ID_STRING": "NAME_TXT", "TEXT": "Klany Sępów", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002e", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca\n\"Członka rodziny królewskiej widziano w towarzystwie kupców. W pewnych krainach konsorcjum znane jest pod nazwą Sępów. Tym handlarzom jest obojętne, z kim robią interesy, handlują nawet najemnikami. Spodziewamy się, że książę dostanie posiłki.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0052", "ID_STRING": "NAME_TXT", "TEXT": "Chłop", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002f", "ID_STRING": "NAME_TXT", "TEXT": "Phonycjańska wiadomość", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "Phonycjanin \n\"My Phonycjanie zemścimy się na Daxamie i jego cudzoziemskich najemnikach. A każdy, kto się w to wmiesza, legnie obok księcia.\"\n", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0055", "ID_STRING": "NAME_TXT", "TEXT": "Chłop", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0059", "ID_STRING": "NAME_TXT", "TEXT": "Smok zagłady", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN005c", "ID_STRING": "NAME_TXT", "TEXT": "Smok śmierci", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN005d", "ID_STRING": "NAME_TXT", "TEXT": "Zbir", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227UN0064", "ID_STRING": "NAME_TXT", "TEXT": "Włócznik", "SEQ_NUM": 0}
  ]
}
