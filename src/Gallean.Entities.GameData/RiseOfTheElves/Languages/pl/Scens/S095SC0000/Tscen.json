    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0000",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar T1",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0000",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar W\u0119drowiec\n\u0022Witaj, milordzie! Ciesz\u0119 si\u0119, \u017Ce jeste\u015B ca\u0142y. Inkwizytor Philip d\u0027Agincourt oczekuje w mie\u015Bcie Fhindar, kawa\u0142ek na p\u00F3\u0142noc. Poprowadz\u0119 ci\u0119...\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0023",
      "ID_STRING": "NAME_TXT",
      "TEXT": "W\u0142\u00F3cznik",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0001",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar T2",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar W\u0119drowiec \n \u0022Strze\u017Ccie si\u0119! Te rzeki zamieszkane s\u0105 przez wied\u017Amy-topielice, kt\u00F3re poluj\u0105 na nieostro\u017Cnych podr\u00F3\u017Cnych. Nie zostawajcie w wodzie na d\u0142u\u017Cej!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0024",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0002",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar martwy",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0025",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0026",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0003",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar \u015Brodek 1",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0003",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "W\u0142\u00F3cznik\n\u0022Wybacz Nobar... Poza tob\u0105 nikomu nie wolno przej\u015B\u0107. Rozkazy Philipa!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0027",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0004",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar \u015Brodek 2",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "W\u0142\u00F3cznik \n\u0022Witaj, Nobar. Poza tob\u0105 nikt nie mo\u017Ce t\u0119dy przej\u015B\u0107. To rozkaz Philipa d\u0027Agincourt...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0005",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Paj\u0105k w\u0119druje T10",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0028",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0029",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0007",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Armia Huberta T30",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0007",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hubert de Lalye\n\u0022Czy podobali ci si\u0119 moi jedwabi\u015Bci przyjaciele? Powiniene\u015B by\u0142 si\u0119 do mnie przy\u0142\u0105czy\u0107, jak pozostali... Teraz umrzesz a Fhindar b\u0119dzie moje! Ha ha ha ha... \u0022",
      "SEQ_NUM": 3
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0007",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Tropiciel \n\u0022Panie, musimy powstrzyma\u0107 Huberta de Lalye zanim zajmie Fhindar!\u0022",
      "SEQ_NUM": 5
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0007",
      "ID_STRING": "OBJECT_TXT",
      "TEXT": "Zabij Huberta de Lalye, zanim zdob\u0119dzie miasto Fhindar. Uther nie mo\u017Ce zgin\u0105\u0107.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0008",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Paj\u0105ki w\u0119druj\u0105 T20",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0008",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Tropiciel\n\u0022Co\u015B wygna\u0142o paj\u0105ki z ich gniazda! Nasi zawiadowcy dostrzegli dym ponad Jedwabnym Lasem... Kto m\u00F3g\u0142 zrobi\u0107 co\u015B takiego?\u0022",
      "SEQ_NUM": 5
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0009",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Przybywa Uther T33",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0009",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Uther\n\u0022Oczyszcz\u0119 Imperium z twojego nieczystego rodu, Hubercie de Lalye! Przygotuj si\u0119 na \u015Bmier\u0107... Imperium wr\u00F3ci do prawowitego w\u0142adcy!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0009",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hubert de Lalye \n\u0022Ch\u0142opiec?! Ha ha ha! Czy to jedyny obro\u0144ca Imperium? Demosthene jest tch\u00F3rzem...\u0022",
      "SEQ_NUM": 4
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN002c",
      "ID_STRING": "NAME_TXT",
      "TEXT": "W\u0142\u00F3cznik",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Ostrze\u017Cenie Jedwabnego Lasu",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000a",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar W\u0119drowiec\n\u0022Te bory znane s\u0105 jako Jedwabny Las. Niewielu si\u0119 tu zapuszcza, bowiem w ost\u0119pach czaj\u0105 si\u0119 straszliwe stwory...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN002d",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN002e",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000c",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Wej\u015Bcie do Fhindaru",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000c",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar W\u0119drowiec\n\u0022Fhindar jest blisko! Musimy i\u015B\u0107 na zach\u00F3d. Wiedzie tam kilka dr\u00F3g...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN002f",
      "ID_STRING": "NAME_TXT",
      "TEXT": "W\u0142\u00F3cznik",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000d",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar T5",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000d",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar W\u0119drowiec\n\u0022Philip d\u0027Agincourt jest bardzo ostro\u017Cny... Zablokowa\u0142 wszystkie drogi do Fhindar. Mam nadziej\u0119, \u017Ce pozwoli ci przej\u015B\u0107!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0030",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0031",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "W\u0142\u00F3cznik niski umiera",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0032",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000f",
      "ID_STRING": "NAME_TXT",
      "TEXT": "W\u0142\u00F3cznik wysoki umiera",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0010",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Wygraj Misj\u0119 (Zabij Huberta)",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0010",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hubert de Lalye\n\u0022Ty... ty... Pokona\u0142e\u015B mnie! Jak to mo\u017Cliwe? Przekl\u0119ty Uther!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0010",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Uther \n\u0022Wszystkich wrog\u00F3w Imperium spotka ten sam los. Pomog\u0119 mojemu ojcu przywr\u00F3ci\u0107 pok\u00F3j w kr\u00F3lestwie Nevendaar!\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0034",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nied\u017Awied\u017A polarny",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0011",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Zwyci\u0119stwo Huberta",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0011",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hubert de Lalye\n\u0022Ha ha ha! Teraz, gdy posiadam miasto Fhindar, nikt nie zdo\u0142a mi si\u0119 oprze\u0107... Przybycie Uthera jest bez znaczenia!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0012",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Warownia Khazan - tekst",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0012",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "\u0141ucznik\n\u0022Wielu rybak\u00F3w zagin\u0119\u0142o na morzu... Ch\u0142opi s\u0105dz\u0105, \u017Ce po\u017Car\u0142y ich morskie potwory!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0036",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Syrena",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0013",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Miasto Silveria - tekst",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0013",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "W\u0142\u00F3cznik\n\u0022Fhindar le\u017Cy dalej na p\u00F3\u0142noc. Mamy nadziej\u0119, \u017Ce Cesarz wygra t\u0119 wojn\u0119... Hubert wys\u0142a\u0142 milicj\u0119 do obrony miast tej ziemi!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0014",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Ruch Lofemyra T8",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0037",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0038",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0017",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar T30",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0017",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar W\u0119drowiec\n\u0022Philip d\u0027Agincourt schwyta\u0142 ci\u0119 w pu\u0142apk\u0119. To wszystko by\u0142 wybieg, strze\u017C si\u0119 milordzie...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN003a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Kraken",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0018",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Uther umiera",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0018",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Kleryk\n\u0022Co\u015Bmy uczynili? Uther, utracony syn cesarza, nie \u017Cyje! Imperium jest ju\u017C zgubione!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0019",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Obszar Fhindaru",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0019",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Uther\n\u0022Przybywam w imi\u0119 mego ojca! Jestem Uther, dziedzic Nevendaar. Przy\u0142\u0105czcie si\u0119 do walki przeciw wrogom Imperium! Oczyszcz\u0119 kr\u00F3lestwo z twojego nieczystego rodu, de Lalye! Szykuj si\u0119 na \u015Bmier\u0107...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0019",
      "ID_STRING": "OBJECT_TXT",
      "TEXT": "Zniszcz Huberta de Layle. Uther nie mo\u017Ce zgin\u0105\u0107.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
