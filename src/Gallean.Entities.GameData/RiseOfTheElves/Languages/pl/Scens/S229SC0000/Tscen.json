    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Tawerna i Zbrojownia Nearburta oferują najlepsze piwo i oręż w okolicy.", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep z czarami w Dolinie", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Mam wiele czarów, których być może cię nauczę...", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229SI0004", "ID_STRING": "TXT_TITLE", "TEXT": "Obóz Golrona", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229SI0004", "ID_STRING": "TXT_DESC", "TEXT": "Za określoną cenę wytrenuję twoje jednostki", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229SI0005", "ID_STRING": "TXT_TITLE", "TEXT": "Leśny sklep złodziei", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229SI0005", "ID_STRING": "TXT_DESC", "TEXT": "\"Będziemy strzelać do kieszonkowców i włamywaczy\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutralni", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Brak opisu rasy", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Calderic", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Najwyższy z władców krasnoludów, znany jest ze swej zaciętości w bitwie i odwagi w obliczu niesprzyjających okoliczności. Kiedyś przez siedem dni i nocy walczył z wielkim smokiem ARFURUZONEM, by wreszcie go pokonać.", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Ahndrash", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229PL000a", "ID_STRING": "DESC_TXT", "TEXT": "W swoich czasach znany jako najpotężniejszy mistrz mrocznej sztuki, władca ten zabity został przez inkwizytora Vorgela, który położył kres jego bezeceństwom. Teraz jest wskrzeszony jako nieumarły i pragnie nagiąć do swej woli wszystkich śmiertelników.", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Cloderic", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Zythaar", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229UN0006", "ID_STRING": "NAME_TXT", "TEXT": "Jonas", "SEQ_NUM": 0},
