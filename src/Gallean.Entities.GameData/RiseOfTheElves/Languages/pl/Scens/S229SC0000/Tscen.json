    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229UN0021", "ID_STRING": "NAME_TXT", "TEXT": "Kraken", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0000", "ID_STRING": "NAME_TXT", "TEXT": "GK porażka", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Porażka nieumarłych", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0002", "ID_STRING": "NAME_TXT", "TEXT": "GK lok. terytorium ludzi", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "\"Bądź ostrożny wchodząc na terytorium ludzi, milordzie... Będą się bronić!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Lok. R nagłe ataki", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Punkt Wolności 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Wieśniacy \n\"Mówi się, że Stary Kościół nawiedzany jest przez wilkołaki i wampiry...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229UN0027", "ID_STRING": "NAME_TXT", "TEXT": "Dezerterzy", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Wył. stary kościół złup.", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Lok. złodziejska zasadzka", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Herszt Zbirów \n\"Ha ha! Wpadliście w zasadzkę! Zginiecie z naszych rąk!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229UN002b", "ID_STRING": "NAME_TXT", "TEXT": "Krnak Mocarz", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0008", "ID_STRING": "NAME_TXT", "TEXT": "GK lok. ostrzeż. jaszczurów 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "\"Wchodzimy na niebezpieczne obszary, panie! Jaszczoludy są bardzo niebezpieczne... Może powinniśmy zawrócić?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0009", "ID_STRING": "NAME_TXT", "TEXT": "GK lok. ostrzeż. jaszczurów 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "\"Wchodzimy na niebezpieczne obszary, panie! Jaszczoludy mogą przynieść nam zgubę... Czy nie powinniśmy zawrócić?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Hg'nufy", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Lud moczarów \n\"Czemu wy nas teraz atakować? My być spokojny lud, zanim wy przyjść!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Lok. ostrzeżenie opuszcz. 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Smok \n\"Zbliż się i pokłoń smokowi... Niech skosztuję twego mięsa!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Lok. ostrzeżenie opuszcz. 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Smok \n\"Zbliż się i pokłoń smokowi... Niech skosztuję twego mięsa!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Nieumarli lok. terytorium elfów1", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "\"Panie, przed nami znajduje się chyba osada elfów.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Nieumarli lok. terytorium elfów2", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "\"Panie, przed nami znajduje się chyba osada elfów.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229UN0031", "ID_STRING": "NAME_TXT", "TEXT": "Jaszczolud", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Nieumarli lok. terytorium elfów3", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "\"Panie, przed nami znajduje się chyba osada elfów.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0010", "ID_STRING": "NAME_TXT", "TEXT": "GK Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "\"Tak, nasz lud dojrzał do przejęcia władzy w tym królestwie... Doszły nas słuchy, że żywe trupy rosną w siłę! Ich nowy przywódca, lord Tace, jest już być może za silny - Bjorn musi go natychmiast unicestwić!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Intro nieumarłych", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "\"Mój panie, postawiliśmy lorda Tace na czele naszych armii. Wszystko idzie zgodnie z planem z wyjątkiem tego... Zanim nasza ekspansja wreszcie się rozpocznie, musimy posłać lorda Tace, żeby zgładził księcia Bjorna.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Wył. strażnik 1 martwy", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229UN0035", "ID_STRING": "NAME_TXT", "TEXT": "Jaszczolud", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Wył. strażnik w martwy", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Punkt Wolności 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S229SC0000", "ID_OBJECT": "S229EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Wieśniacy \n\"Ludzie nigdy się nie poddadzą! Wiedzcie, że odpowiemy ciosem za niesprawiedliwość, która nas spotkała!\"", "SEQ_NUM": 0},
