    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Obóz Grukka", "SEQ_NUM": 0},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Grukk uczyni z twych chłopów prawdziwych mężczyzn!", "SEQ_NUM": 0},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutralni", "SEQ_NUM": 0},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Brak opisu rasy", "SEQ_NUM": 0},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223PL0001", "ID_STRING": "NAME_TXT", "TEXT": "Zythaar", "SEQ_NUM": 0},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223PL0001", "ID_STRING": "DESC_TXT", "TEXT": "W swoich czasach znany jako najpotężniejszy mistrz mrocznej sztuki, władca ten zabity został przez inkwizytora Vorgela, który położył kres jego bezeceństwom. Teraz jest wskrzeszony jako nieumarły i pragnie nagiąć do swej woli wszystkich śmiertelników.", "SEQ_NUM": 0},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223PL0002", "ID_STRING": "NAME_TXT", "TEXT": "Ciernie", "SEQ_NUM": 0},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223PL0002", "ID_STRING": "DESC_TXT", "TEXT": "Weteran wojny o odzyskanie chwały elfów - nikt nie wkroczy do lasu bez jego wiedzy.", "SEQ_NUM": 0},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Pradesh", "SEQ_NUM": 0},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Ciernie", "SEQ_NUM": 0},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223UN0010", "ID_STRING": "NAME_TXT", "TEXT": "Zbir - Wartownik", "SEQ_NUM": 0},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223UN0011", "ID_STRING": "NAME_TXT", "TEXT": "Zbir", "SEQ_NUM": 0},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223UN0023", "ID_STRING": "NAME_TXT", "TEXT": "Czempion orków", "SEQ_NUM": 0},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Zbir - Wartownik", "SEQ_NUM": 0},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Zbir - Wartownik\n\"Myślisz, że tak łatwo przejdziesz sobie przez nasze tereny?!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Zadanie Nieumarli", "SEQ_NUM": 0},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Zadanie Elfy", "SEQ_NUM": 0},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Rozpocznij Elfy", "SEQ_NUM": 0},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Ruthllak\n\"Milordzie! Mamy wieści o miejscu pobytu kultystów Mortis. Znaleźli sposób na zniewolenie Zielonoskórych.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Wyrocznia\n\"Zdradzieckie mroczne elfy! Co one wyprawiają? Co łączy je z Zielonoskórymi?\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Ruthllak\n\"Nie możemy do tego dopuścić... natychmiast wyślę zwiadowców! Nie możemy pozwolić, by to plugastwo dotarło do naszych lasów.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Rozpocznij Nieumarli", "SEQ_NUM": 0},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Zombie \n\"Euuuuuuuuuuughhhhhhhhh...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Shr'ullen \n\"Kto wpuścił tu tego głupiego zombie?!? Nie mamy na to czasu! Zniszczyć go...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Wampir \n\"Tak, Shr'ullen.\"\r \n", "SEQ_NUM": 2},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Shr'ullen \n\"Zdradzieckie mroczne elfy! Jak one mogły odwrócić się od Mortis? Co próbują osiągnąć?\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Shr'ullen\n\"Wysłać oddziały! Nie interesują nas ich motywy. Mortis życzyłaby sobie, abyśmy uprzątnęli jej... potknięcia.\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223EV0005", "ID_STRING": "NAME_TXT", "TEXT": "T 11Mroczny elf wiadomość", "SEQ_NUM": 0},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Mroczny elf\n\"Nie zdajecie sobie sprawy z potęgi Bestii... Spróbujcie nas powstrzymać, a zostaniecie unicestwieni. Bestia Galleana ożyje!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Zaklęcie blisko ruin", "SEQ_NUM": 0},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Mroczny elf\n\"Popełniliście wielki błąd, przybywając tutaj. Nie powstrzymacie odrodzenia naszego boga!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "\"Strzeżcie się!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223EV0007", "ID_STRING": "NAME_TXT", "TEXT": "T 11 Elfy odpowiedź", "SEQ_NUM": 0},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Ruthllak\n\"Te odrażające mroczne elfy! Chcą znów sprowadzić to obrzydlistwo - chcą ożywić Bestię Galleana!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Wyrocznia\n\"Trzeba ich powstrzymać, Ruthllaku! Gallean nie życzyłby sobie tego!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Ruthllak\n\"Tak też się stanie! Musimy wybić wszystkie mroczne elfy w tym rejonie! Potem przyjdzie kolej na Zielonoskórych...\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223EV0009", "ID_STRING": "NAME_TXT", "TEXT": "T 11 Nieumarli odpowiedź", "SEQ_NUM": 0},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Shr'ullen\n\"Bestia Galleana?!? Jak oni śmią oddawać cześć czemuś takiemu? Żeby zdradzić Mortis dla szczątków Galleana...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Wampir\n\"Co mamy czynić, Shr'ullen?\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Shr'ullen\n\"Mortis pragnie ich unicestwienia. Na co jeszcze czekasz? Precz stąd!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S223SC0000", "ID_OBJECT": "S223EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Wampir \n\"Tak, Shr'ullen...\" \n", "SEQ_NUM": 3},
