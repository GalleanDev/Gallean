    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0000",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Miasto Inthuric - tekst",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0000",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Krasnolud \n\u0022Gymner Stra\u017Cnik Chmur jest synem najwy\u017Cszego kr\u00F3la Klan\u00F3w, Moroka. Je\u015Bli spadnie mu w\u0142os z g\u0142owy, Morok zmia\u017Cd\u017Cy was sw\u0105 pot\u0119g\u0105!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100UN0023",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0002",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Miasto Oghock - tekst",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0002",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Goblin \n\u0022Znowu wy?!! Wszyscy zgin\u0105\u0107! Du\u017Ca top\u00F3r was zabi\u0107!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0003",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Miasto Dunera - tekst",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0003",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Wyznawca \n\u0022Musimy si\u0119 pospieszy\u0107, panie! Nie mo\u017Cemy dopu\u015Bci\u0107, by M\u0119drzec zamkn\u0105\u0142 bram\u0119... Musimy uwolni\u0107 Bethrezena!\u0022",
      "SEQ_NUM": 0
    },
    {
