    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Shankry", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Chcesz wykorzystać swoją manę? Owszem, możemy cię tego nauczyć.", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Rozdroże", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Nie obchodzi mnie, dla kogo walczysz. Ważne, żeby mi się to wszystko opłaciło...", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutralni", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Brak opisu rasy", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217PL0002", "ID_STRING": "NAME_TXT", "TEXT": "Ciernie", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217PL0002", "ID_STRING": "DESC_TXT", "TEXT": "Weteran wojny o odzyskanie chwały elfów - nikt nie wkroczy do lasu bez jego wiedzy.", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217PL0003", "ID_STRING": "NAME_TXT", "TEXT": "Uron", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217PL0003", "ID_STRING": "DESC_TXT", "TEXT": "W czasach młodości ten wielki władca stanął samotnie przeciw wojsku piekieł i pokonał je zapieczętowując bramy, które je wypluwały. Następnie objął suwerenną władzę nad swoim królestwem.", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Beregras", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217UN0005", "ID_STRING": "NAME_TXT", "TEXT": "Godefroy", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217UN000a", "ID_STRING": "NAME_TXT", "TEXT": "Jona'ath", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217UN000b", "ID_STRING": "NAME_TXT", "TEXT": "Kera'anil", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217UN000c", "ID_STRING": "NAME_TXT", "TEXT": "Isuel", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217UN000d", "ID_STRING": "NAME_TXT", "TEXT": "Alix", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Elfy - Dzień 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Strażnik\n\"Musimy ubiec ludzi i zdobyć jak najwięcej surowców. Losy wojny spoczywają w naszych rękach!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Myśliwy\n\"Jeśli wytężysz słuch, usłyszysz te aroganckie okrzyki! Wodzowie zagrzewają ich do walki.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Strażnik\n\"Niech sobie zagrzewają. Gallean zapewnił nas, że zwyciężymy.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Imperium - Dzień1", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Paladyn\n\"Król Emry ostrzegł nas przed atakiem na Sieć. Elfy planują przemaszerować tędy i zagarnąć nasze zasoby!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Święty Mściciel\n\"Są zbyt pewne siebie! W jaki sposób ta leśna hołota miałaby stawić czoła siłom Imperium?\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Paladyn\n\"Pokazały już, że trzeba się z nimi liczyć. Coś nimi kieruje... coś sprawia, że ich plemiona się jednoczą. Musimy zdobyć tyle, ile tylko się da, zanim dostaną się tam elfy.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Elfy zwyciężają", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Strażnik\n\"Dobra robota! Zabezpieczyliśmy nasze pozycje. Ludzie wrócą do swego króla z pustymi rękoma!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Imperium zwycięża", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Paladyn\n\"Odparliśmy elfy! Skoro nie mają kontroli nad Siecią, ich armia upadnie, zanim w ogóle dotrze pod mury Temperance! Król Emry będzie zadowolony!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Imperium - Życie", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "\"Pełno tu many życia. Nasi magowie będą zadowoleni z tego odkrycia!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Imperium - Gaj", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "\"Mana elfów. Nie na wiele zda się naszym magom, ale i tak powinniśmy ją zabrać. Jeśli dostanie się w ręce elfów, ich moc znacznie wzrośnie.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Imperium - Mix", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "\"Ten obszar to prawdziwa skarbnica many! Musimy go zająć jak najprędzej. Ślij posłańca do Emry'ego!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Elfy - Gaj", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "\"Na Galleana! Spójrzcie, ile tu many! Illumielle wiedziała, co robi, wysyłając nas tutaj - ten niewielki obszar wystarczyłby dla całej armii!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Elfy - Życie", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "\"Złoża many życia są tu niebywale bogate! Nie możemy dopuścić do tego, by wpadły w łapska ludzi. Prędko, musimy zająć ten teren!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Elfy - Mix", "SEQ_NUM": 0},
    {"NO_SCEN": "S217SC0000", "ID_OBJECT": "S217EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "\"Musiała tu być kopalnia... Widzę wiele różnych kryształów many! Przydadzą się nam podczas szturmu na Temperance!\"", "SEQ_NUM": 0},
