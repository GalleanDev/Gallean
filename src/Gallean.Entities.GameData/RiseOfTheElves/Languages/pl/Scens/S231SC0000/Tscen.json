    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231UN011a", "ID_STRING": "NAME_TXT", "TEXT": "Leśny elf", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231UN011c", "ID_STRING": "NAME_TXT", "TEXT": "Draashel", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231UN011e", "ID_STRING": "NAME_TXT", "TEXT": "Wódz zbirów", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231UN0121", "ID_STRING": "NAME_TXT", "TEXT": "Syrena", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Imperium zwycięstwo", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Wieża wampira", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "\"To miejsce przesycone jest odorem śmierci, milordzie... Jestem pewien, że gdzieś w pobliżu mieszka wampir!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Wył. wieża wampira", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Imperium Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Rycerz pegazów \n\"W imię Wszechojca! Musimy nawrócić te ziemie i uwolnić je od barbarzyńskich plemion, które się tu panoszą.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Rycerz pegazów \n\"Niektóre z tych wysp zamieszkują barbarzyńskie plemiona Sthlanken, żyjąc obok potwornych ludzi-jaszczurów. Musimy im pokazać ścieżkę prawdy. Bez litości!", "SEQ_NUM": 1},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Smocza Krypta", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "\"Mówi się, że elfy czczą upadłego smoka i że w jego krypcie zalegają wielkie skarby. Czy mamy to sprawdzić, milordzie?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Pozycja gniazda gryfa", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "\"Powinniśmy uważać... To tereny lęgowe gryfów, a one są bardzo agresywne, jeśli ktoś zbliży się do gniazd. Elfy z pewnością zabronią nam wstępu do wieży lęgowej.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Legiony Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Książe \n\"Na dłoń Bethrezena, przechrzcimy te ziemie, niszcząc wszystko na naszej drodze... Spalimy miasta i wsie, i rzucimy cień strachu na kraj.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Intro nieumarłych", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Rycerz Śmierci \n\"Mortis rozkazała nam roznieść zarazę po tej krainie i przetrzebić wszystko, co dobre i czyste... Naszym zadaniem jest służyć jej bez zastrzeżeń. Wykonajmy jej rozkazy i nie okazujmy miłosierdzia!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Zamek elfów Leg.", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Strażnik centaur \n\"Trzymajcie się z dala od naszych ziem, niewolnicy potępienia! Nigdy ich nie dostaniecie. Smoczy Bóg chroni nas zza grobu i pomści nas. Odejdźcie stąd i nigdy nie wracajcie!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź zamek elfów", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Elfy \n\"Będziecie tego żałować, a czas waszej śmierci nadjedzie dużo wcześniej!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Kraken1", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "\"Wielkie Krakeny zamieszkują morza, niszcząc każdy statek, który zapuści się zbyt daleko. Dzielnie bronią swych włości! Powinniśmy bardzo uważać, milordzie!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Imp. cmentarz", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Rycerz pegazów \n\"Straszliwe zło spowija te przeklęte ziemie... Musimy je oczyścić!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Nieumarli do magicznej wieży", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Galrifius \n\"Mortis kiedyś pomogła mi zdobyć nowe życie. Teraz ja pomogę tobie...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Barbarzyński czar wieży", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Barbarzyńcy \n\"Precz stąd. Myślicie, że zajmiecie nasze ziemie bez walki? Ha ha ha!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Imperium przynieś przedmiot Magowi", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Galrifius \n\"Nie mogę porozumieć się z moją siostrą Hannah, ale jeśli zdołasz dostarczyć jej ten klucz, będę bardzo wdzięczny. Bez wątpienia cię wynagrodzi. Nie będziesz żałował podjęcia się tej misji!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Imperium klucz do Maga", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Hannah \n\"Och, dzięki! Nie umiem wprost wyrazić swojej wdzięczności! Proszę, przyjmijcie to jako symbol mojej dozgonnej wdzięczności.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Legiony uzdrowienie", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Zabij Krakena dla barb.", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Barbarzyńca \n\"Modlę się do mych bogów, żeby zniszczyli bestię, która zabiła moją rodzinę - potwornego Krakena! Jestem chory i słabowity, nie mogłem ich obronić... Zabij potwora, a będę odtąd wiernie służył tobie i twojemu bogu.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Zabij Krakena dla barb. 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Barbarzyńca \n\"Potworny Kraken wreszcie wyzionął ducha... Na zawsze jestem twym dłużnikiem!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Cannon", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Barbarzyńcy \n\"Jak śmiecie najeżdżać ziemie, które do was nie należą?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Chłop broni złota", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Chłopi \n\"Hej! Trzymajcie się z daleka od tego. To nasze złoto i będziemy go bronić!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Martwy chłop broni zł", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź wieś Sthlanken", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Barbarzyńcy \n\"Głupcy! Myślicie, że możecie po prostu najechać nasze miasta i wsie? Spadnie na was gniew naszych braci!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Legiony przynieś przedmiot magowi", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Galrifius \n\"Tak, myślę, że sobie poradzisz... Zanieś ten klucz do sanktuarium mojej siostry Hannah w twych rodzinnych stronach. Spiesz się, a w zamian zostaniesz hojnie obdarowany.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Legiony klucz do Maga", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Hannah \n\"Dziękuję wam, doceniam waszą lojalność. Przyjmijcie to jako zapłatę za wasze usługi.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Podbito 40 % kraju.", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Zająłeś 40% ziemi.", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Święta ziemia elfów", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Elfy \n\"Trzymajcie się z daleka od naszych świętych ziem, przybysze. Ostrzegamy was!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Junfru", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Barbarzyńcy \n\"To nasze miasto! Nasi bogowie nas obronią!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Strażnik Jerrella", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Jaszczolud \n\"Lepiej odwiedźcie sklep Jerrella, bo inaczej potnę was na plasterki!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Odwiedź sklep Jerella", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Magowie Galrifiusa", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Znam wiele niepospolitych czarów, których mogę cię nauczyć. Za odpowiednią opłatą oczywiście.", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0022", "ID_STRING": "NAME_TXT", "TEXT": "Legiony czary uzdrowienia", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0022", "ID_STRING": "POPUP_TXT", "TEXT": "\"Wygląda na to, że Legiony wyznaczyły tu poświęconą ziemię... Powinniśmy trzymać się z dala od tego nieczystego miejsca…\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Zamek elfów Imp.", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0023", "ID_STRING": "POPUP_TXT", "TEXT": "Elfy \n\"Nie zakłócajcie naszego spokoju, słudzy Imperium... Jeśli spróbujecie najechać na nasze ziemie, wasze bóstwa nie uchronią was przed gniewem Smoczego Boga...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Obóz Leafa Wielkiej Stopy", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Tutaj trenujemy najlepsze gryfy w całym królestwie.", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0024", "ID_STRING": "NAME_TXT", "TEXT": "Zamek elfów nieum.", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0024", "ID_STRING": "POPUP_TXT", "TEXT": "Elfi strażnicy\n\"Precz, truchła! Chronią nas nasi Smoczy Bogowie i pomszczą nas, jeśli spróbujecie tu rozsiewać swoją zarazę...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Zaopatrzenie Kaa'ratha", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Zaspokajamy wszelkie potrzeby wojownika.", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Wył. Smoczą Kryptę", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0004", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Elphiny", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0004", "ID_STRING": "TXT_DESC", "TEXT": "Tu znajdziesz najprzedniejsze elfie towary.", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Martwy Kraken", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0005", "ID_STRING": "TXT_TITLE", "TEXT": "Fabryka Gerberta", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0005", "ID_STRING": "TXT_DESC", "TEXT": "Mamy tu wiele przydatnych rzeczy, wszystko czego dusza zapragnie.", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Legiony zwycięstwo", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0006", "ID_STRING": "TXT_TITLE", "TEXT": "Obóz Metaki", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0006", "ID_STRING": "TXT_DESC", "TEXT": "Tutaj ćwiczyli wszyscy barbarzyńcy z okolicy.", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Zwycięstwo nieumarłych", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0007", "ID_STRING": "TXT_TITLE", "TEXT": "Towary Jerella", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0007", "ID_STRING": "TXT_DESC", "TEXT": "Czego szukasz?", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Imp. plądr. Pradawną Basztę", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV0029", "ID_STRING": "POPUP_TXT", "TEXT": "Rycerz pegazów \n\"Milordzie, tu jest chyba jakaś mapa... Informuje nas, że kto chce znaleźć skarb Lunnarka, musi przeszukać morza na północnym wschodzie. Podróżnik Lunnark uważany jest za legendę... Czyżby jednak istniał naprawdę?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0008", "ID_STRING": "TXT_TITLE", "TEXT": "Sanktuarium Hannah", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231SI0008", "ID_STRING": "TXT_DESC", "TEXT": "Mam potężne czary za umiarkowaną cenę.", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Nieumarli plądr. pradawne", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV002a", "ID_STRING": "POPUP_TXT", "TEXT": "Rycerz Śmierci \n\"Panie, tu jest chyba jakaś mapa... Informuje nas, że kto chce znaleźć skarb Lunnarka, musi przeszukać morza na północnym wschodzie. Podróżnik Lunnark uważany jest za legendę... Czyżby jednak istniał naprawdę?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV002b", "ID_STRING": "NAME_TXT", "TEXT": "Legiony plądr. Pradawną Wieżę", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV002b", "ID_STRING": "POPUP_TXT", "TEXT": "Książe \n\"Panie, tu jest chyba jakaś mapa... Informuje nas, że kto chce znaleźć skarb Lunnarka, musi przeszukać morza na północnym wschodzie. Podróżnik Lunnark uważany jest za legendę... Czyżby jednak istniał naprawdę?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Wył. złup. pradawnej wart.", "SEQ_NUM": 0},
