    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231UN0017", "ID_STRING": "NAME_TXT", "TEXT": "Syrena", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231UN0019", "ID_STRING": "NAME_TXT", "TEXT": "Kraken", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231UN001a", "ID_STRING": "NAME_TXT", "TEXT": "Zbir", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Konrad", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231PL0009", "ID_STRING": "DESC_TXT", "TEXT": "W czasach młodości ten wielki władca stanął samotnie przeciw wojsku piekieł i pokonał je zapieczętowując bramy, które je wypluwały. Następnie objął suwerenną władzę nad swoim królestwem.", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Xhmaah", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Jej imieniem straszy się dzieci. Ta pani piekieł słynie ze swej krwiożerczości. Mówi się, że kiedyś, w czasie bankietu wdanego przez Bethrezena z okazji zwycięstwa nad królestwem światłości, pożarła tysiąc niewolników.", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231PL000b", "ID_STRING": "NAME_TXT", "TEXT": "Draashel", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231PL000b", "ID_STRING": "DESC_TXT", "TEXT": "Znana w swoich czasach jako najpotężniejsza mistrzyni mrocznej sztuki, władczyni ta zabita została przez inkwizytora Vorgela, który położył kres jej bezeceństwom. Teraz została wskrzeszona jako nieumarła i pragnie władać wszystkimi śmiertelnikami.", "SEQ_NUM": 0},
    {"NO_SCEN": "S231SC0000", "ID_OBJECT": "S231UN0058", "ID_STRING": "NAME_TXT", "TEXT": "Chłop", "SEQ_NUM": 0},
