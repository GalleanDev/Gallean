    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Obóz zemsty", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Moi Orkowie są najlepsi w okolicy.", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Wieża Undera", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Sprzedam wszystko, co posiadam.", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Wieża Vidala", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Moje czary pomogą ci w twojej misji.", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Allara", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Za pieniądze... handluję wszystkim.", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutralni", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Brak opisu rasy", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Goar", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222PL0009", "ID_STRING": "DESC_TXT", "TEXT": "W czasach młodości ten wielki władca stanął samotnie przeciw wojsku piekieł i pokonał je zapieczętowując bramy, które je wypluwały. Następnie objął suwerenną władzę nad swoim królestwem.", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Honir'ya", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222PL000a", "ID_STRING": "DESC_TXT", "TEXT": "W swoich czasach znany jako najpotężniejszy mistrz mrocznej sztuki, władca ten zabity został przez inkwizytora Vorgela, który położył kres jego bezeceństwom. Teraz jest wskrzeszony jako nieumarły i pragnie nagiąć do swej woli wszystkich śmiertelników.", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Ardobert", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Khagrael", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN0004", "ID_STRING": "NAME_TXT", "TEXT": "King Virgil", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN0012", "ID_STRING": "NAME_TXT", "TEXT": "Sir Anabaziz", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN001c", "ID_STRING": "NAME_TXT", "TEXT": "Chłop", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN0020", "ID_STRING": "NAME_TXT", "TEXT": "Chłop", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Imperium historia", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Bradobar \n\"Król Virgil pokonał orków i uwięził ich władcę. Musimy teraz zbadać wzrost aktywności nieumarłych w tej okolicy. Gdy już rozwiążemy ten problem, przyłączymy ten rejon do Imperium.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Undead Story", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Zombie \n\"Sir Anabaziz to lojalny sługa króla. Z polecenia władcy jego sługi badają Nieczysty Sztylet, chcąc poznać jego ssssekrety. Król chce za wszszszelką cenę wsssskrzesić sssswego sssyna.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0005", "ID_STRING": "NAME_TXT", "TEXT": "New Daxam ", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Akolita z New Daxam\n\"Dzieje się coś dziwnego - ludzie mutują, stają się stworami nie z tej ziemi. Wydaje się, że złamane zostało jakieś zakazane prawo...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Desburg", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Uchodźca z Desburga\n\"Nieczysty Sztylet! Anabaziz i jego sługi to głupcy. Bawią się czymś, co ich przerasta, i sprowadzili klątwę na nas wszystkich! To ta klątwa przemienia żywe istoty w bezduszne skorupy błąkające się bez celu po całej krainie!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN0029", "ID_STRING": "NAME_TXT", "TEXT": "Chłop", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Wieża czarownic", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Łowca wiedźm z wieży\n\"Nie zbliżaj się, bezduszny potworze! Odejdź lub posmakuj mego zaklętego ostrza.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN002c", "ID_STRING": "NAME_TXT", "TEXT": "Chłop", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Bythazar Guard", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Defend Stack", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV000d", "ID_STRING": "NAME_TXT", "TEXT": "New Haven", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Przeklęty z New Haven\n\"New Bythazar? Taaak, dobrze bronione. Ale ssstrażnicy zostali przemienieni tak samo jak my - nad nimi też wisssssi klątwa.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN0030", "ID_STRING": "NAME_TXT", "TEXT": "Widmo", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Guard Attack", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Król Virgil \n\"Zginiecie raz na zawsze, przeklęte istoty.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Guard Message Empire", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Król Virgil \n\"Och... Potężne Imperium! Mam się bać? Władam całym królestwem, nie mam nic do stracenia... A wy czym dysponujecie?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Dragon Attack", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN0034", "ID_STRING": "NAME_TXT", "TEXT": "Chłop", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Artekins ", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Sir Anabaziz \n\"Wpływ Nieczystego Sztyletu skazi tę krainę na całe pokolenia!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Talk", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Archanioł\n\"Królem kieruje teraz niezaspokojony głód krwi. Strata syna doprowadziła go do obłędu!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN0037", "ID_STRING": "NAME_TXT", "TEXT": "Giermek", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Zabójca", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Assassin Two", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Peasant Message", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Nędzny chłop\n\"Możesz mnie mieć za istotę nędzną i nic nie wartą, często wielcy tego świata nie dostrzegają jednak mojej obecności. Nasz ukochany król podał twoje dane swoim zabójcom - kryją się tu wszędzie, lepiej się mu poddaj!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0019", "ID_STRING": "NAME_TXT", "TEXT": "King Assassin", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Wiadomość zbira", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Zbir\n\"Przypuszczam, że wątpię.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Kings Guard", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Haven Attack", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Anabaziz Servant", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Empire Winning Condition", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Rycerz pegazów\n\"Niech żyje Imperium! Zwycięstwo! Ogłasza się wszem i wobec, że król Virgil nie żyje. Od tej wspaniałej chwili to królestwo i wszyscy jego poddani przechodzą pod opiekę Imperium. Niech będzie to początek nowej ery w dziejach New Bythazar!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN0044", "ID_STRING": "NAME_TXT", "TEXT": "Wolf", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Udead Winning Condition", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Widmo  \n\"Król Virgil chce ssssię znów spotkać ze sssswym durnym sssssynalkiem. I tak się stanie, gdyż król nie żyje! Teraz jeszcze muszą zginąć jego poddani!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0022", "ID_STRING": "NAME_TXT", "TEXT": "Terrain Empire", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0022", "ID_STRING": "POPUP_TXT", "TEXT": "Bradobar \n\"Kontrolujemy już większość okolicznych ziem i musimy się zająć królem Virgilem. Szybko się nauczy, że nie może nas obrażać - a już na pewno lekceważyć. Chwała Imperium!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0022", "ID_STRING": "OBJECT_TXT", "TEXT": "Defeat King Virgil.", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Terrain Undead", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0023", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' ash \n\"Król wkrótce umrze i do nassss dołączy. Dzięki jego zwłokom będziemy władać całym królessstwem, a naszszsza armia urośśśnie w sssiłę!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0023", "ID_STRING": "OBJECT_TXT", "TEXT": "defeat King Virgil. \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0024", "ID_STRING": "NAME_TXT", "TEXT": "Usuń góry", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Assasins fifty percent", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Ostrzeżenie nieumarłych", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Widmo\n\"Panie, król wykorzystał Nieczysty Sztylet do zastawienia po drodze pułapek. Sssssądzę, że można je zdezaktywować za pomocą prossssstych szkieletów. \"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222UN004a", "ID_STRING": "NAME_TXT", "TEXT": "Artekins Spearman", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Ostrzeżenie Imperium", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "Giermek\n\"Panie mój, król Virgil oszalał! Pewne obszary jego domeny zostały przeklęte - musimy zachować czujność!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Nowe zdarzenie", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Empire day 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV002a", "ID_STRING": "POPUP_TXT", "TEXT": "Bradobar \n\"Król Virgil dotknął nieznanego, przez co cała kraina została przeklęta, a na szlakach czeka na nas wiele różnych zagrożeń. Zwiadowca może aktywować pułapki i chronić nasze wojska za pomocą Żywej Zbroi.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Trap 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV002d", "ID_STRING": "NAME_TXT", "TEXT": "Nowe zdarzenie", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV002e", "ID_STRING": "NAME_TXT", "TEXT": "Trap 4", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV002f", "ID_STRING": "NAME_TXT", "TEXT": "Trap 5", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0030", "ID_STRING": "NAME_TXT", "TEXT": "Undead Day 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S222SC0000", "ID_OBJECT": "S222EV0030", "ID_STRING": "POPUP_TXT", "TEXT": "Szkielet\n\"Panie, głupi Virgil zajął się nieznanym - jego domena zossssstała przeklęta, mussssimy uważać. Każdy krok może być naszszszym ossstatnim...\"", "SEQ_NUM": 0},
