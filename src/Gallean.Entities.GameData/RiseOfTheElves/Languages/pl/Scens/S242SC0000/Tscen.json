    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242UN0154", "ID_STRING": "NAME_TXT", "TEXT": "Ork", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242UN015f", "ID_STRING": "NAME_TXT", "TEXT": "Brodulf", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242UN0162", "ID_STRING": "NAME_TXT", "TEXT": "Marileif", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242UN0166", "ID_STRING": "NAME_TXT", "TEXT": "Niedźwiedź polarny", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0000", "ID_STRING": "NAME_TXT", "TEXT": "GK zwycięstwo", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0002", "ID_STRING": "NAME_TXT", "TEXT": "GK zdob. Kwelię", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Klan Arhigos\r\"Nasz Klan pragnie pokoju. Czemu nie dajecie nam żyć? Nie chcemy mieć z wami nic wspólnego!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Imp. zdob. Kwelię", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Klan Arhigos\r\"Nasz Klan nie wchodził wam w drogę! Dlaczego przybyliście tu i odebraliście nam nasze domy?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Imp. zdob. Dimmel", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Ostrożnie milordzie, stwory nieumarłych często atakują Dimmel.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Zbieg", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Zombi \n\"Bastel Royas sprawi, że zapłacicie za to!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Tesley", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Pojmani barbarzyńcy\r\"Nasi ziomkowie z południa mówią nam, że wampir Bastel Royas ukrywa się w górskiej twierdzy w tamtych stronach. To jego powinniście prześladować, nie nas!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Koulourię", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Wieśniacy\r\"Wyzwoliliście nas! Ta informacja może się wam przydać: na wschód stąd znajduje się Sangleton. Tam właśnie przebywa straszliwy wampir Bastel Royas!\"\r \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Imp. lok. wiad. Bastela", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Bastel Royas\r\"Witajcie! Pozwólcie, że się przedstawię. Nazywam się Bastel Royas, wkrótce władca całego Nevendaaru. Wracajcie i przekażcie tę wiadomość wszystkim, którzy służą Wszechojcu!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV000e", "ID_STRING": "NAME_TXT", "TEXT": "GK lok. wiadomość Bastela", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Bastel Royas\r\"Ha! Nie możecie się równać z wielkim wampirem Bastelem Royasem! Teraz poznacie mój gniew! Powiedzcie Wotanowi, że jest głupcem, wysyłając tu swoją żałosną armię!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Imp. cmentarz", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Milordzie, powinniśmy natychmiast stąd odejść... Powietrze jest tu nieczyste... Gęste od oparów śmierci...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Martwi powstają z grobów!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Imp. lok. ziemie elfów", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Nie ma tu nic wartościowego, milordzie. Lepiej poszukajmy dalej na południu.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Imp. elfy pomoc", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Centaur\r\"Dobrzy ludzie, pomóżcie nam uwolnić Ithlę od tych wstrętnych stworów, a w zamian udzielimy wam wsparcia!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001a", "ID_STRING": "NAME_TXT", "TEXT": "GK pomoc elfów", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Centaur \n\"Dobrzy ludzie, pomóżcie nam uwolnić Ithlę od tych wstrętnych stworów, a w zamian udzielimy wam wsparcia!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Ithlę", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Centaur\r\"Dziękujemy za pomoc. Z radością będę wam służył w zamian za przysługę, którą wyświadczyliście elfom. Możecie stacjonować w Ithli tyle czasu, ile będziecie potrzebowali na uwolnienie tych krain od Plagi!\"\r\n", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Imp. Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Kilka miesięcy temu plaga nieumarłych istot spadła na Dolinę Księżycowej Pieśni. Na ludzi padł strach, gdyż wielu z ich przyjaciół i członków rodzin padło ofiarą przeklętych stworów.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Musimy odkryć, skąd nadciąga ta inwazja, zanim będzie za późno!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Lok. atak giermka", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Wściekły giermek\r\"Rozkazuję natychmiast opuścić to miejsce. To miejsce spoczynku dla ofiar nieumarłych. Jeśli nie odejdziecie, będę musiał użyć siły!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Imp. zdob. Canourię", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Milordzie, radziłbym, abyśmy przeznaczyli część złota na obronę tego miasta. Jego mieszkańcy skarżą się na częste ataki ze strony nieumarłych.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Enthras", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Wieśniacy\r\"Nasza obrona została straszliwie uszczuplona przez nieustanne ataki nieumarłej zarazy!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0020", "ID_STRING": "NAME_TXT", "TEXT": "GK zdob. Canourię", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Milordzie, radziłbym, abyśmy przeznaczyli część złota na obronę tego miasta. Jego mieszkańcy skarżą się na częste ataki ze strony nieumarłych.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Neffina", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Kupczę wszystkim, co posiadam.", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Obóz Renmana", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Za określoną cenę wstąpimy w wasze szeregi.", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0022", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Manris", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0022", "ID_STRING": "POPUP_TXT", "TEXT": "Zniewoleni magowie\r\"Musicie położyć kres temu szaleństwu i zabić Bastela Royasa! To on jest źródłem wszelkich plag. Zniszczcie go i zaprowadźcie pokój w Księżycowej Pieśni.\"\"Enter", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Obóz Metarów", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Wejdźcie tchórze, uczynię z was bohaterów!", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Wywołaj Canourię - Widm.", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Wieża Ilana", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Posiadam wiele czarów", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Wywołaj zombi z Kwelii", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Wywołaj nekromantę - Dimmel", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0006", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Ralara", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242SI0006", "ID_STRING": "TXT_DESC", "TEXT": "Moje towary są najlepsze w całym królestwie.", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Wywołaj smoka zagłady - Zbieg", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Wywołaj lisza z Koularii", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Wywołaj czemp. szkieletów z Ithli", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Wywołaj Smoka Śmierci - Manris", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002b", "ID_STRING": "NAME_TXT", "TEXT": "Wywołaj oszalałego wilkołaka", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Wywołaj wampira", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002d", "ID_STRING": "NAME_TXT", "TEXT": "Elfy atakują GK", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Rada elfów\r\"Nie zdołaliście uwolnić tej doliny od zmory Bastela Royasa i nie zwróciliście nam naszych miast. Jeśli Klany w taki sposób chcą z nami postępować, niech przygotują się na konsekwencje.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002e", "ID_STRING": "NAME_TXT", "TEXT": "GK Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002e", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Kilka miesięcy temu plaga nieumarłych istot spadła na Dolinę Księżycowej Pieśni. Na ludzi padł strach, gdyż wielu z ich przyjaciół i członków rodzin padło ofiarą przeklętych stworów.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002e", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Musimy odkryć, skąd nadciąga ta inwazja, zanim będzie za późno!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002f", "ID_STRING": "NAME_TXT", "TEXT": "GK zdob. Dimmel", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Ostrożnie milordzie, stwory nieumarłych często atakują Dimmel.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0030", "ID_STRING": "NAME_TXT", "TEXT": "GK lok. ziemie elfów", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0030", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Nie ma tu nic wartościowego, milordzie. Lepiej poszukajmy dalej na południu.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0031", "ID_STRING": "NAME_TXT", "TEXT": "Imp. zwycięstwo", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0032", "ID_STRING": "NAME_TXT", "TEXT": "Lok. Kendall", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242EV0032", "ID_STRING": "POPUP_TXT", "TEXT": "Mag Kendall\r\"Jestem Kendall, wędrowny mag, i przybyłem, by opowiedzieć wam o wielkich wampirach z południa... Nie ma tam już nic prócz śmierci - musicie się tam udać i stawić jej czoła!\"", "SEQ_NUM": 0},
