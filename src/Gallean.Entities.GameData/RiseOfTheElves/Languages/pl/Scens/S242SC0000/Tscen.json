    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242PL0009", "ID_STRING": "DESC_TXT", "TEXT": "W czasach młodości ten wielki władca stanął samotnie przeciw wojsku piekieł i pokonał je zapieczętowując bramy, które je wypluwały. Następnie objął suwerenną władzę nad swoim królestwem.", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Theodemis", "SEQ_NUM": 0},
    {"NO_SCEN": "S242SC0000", "ID_OBJECT": "S242PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Najwyższy z władców krasnoludów, znany jest ze swej zaciętości w bitwie i odwagi w obliczu niesprzyjających okoliczności. Kiedyś przez siedem dni i nocy walczył z wielkim smokiem ARFURUZONEM, by wreszcie go pokonać.", "SEQ_NUM": 0},
