    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Clathuma", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Witam. Proszę, oglądajcie wszystko, co posiadam...", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Rynek Jenbah", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Sprzedajemy i kupujemy za korzystne ceny, milordzie...", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Obóz Kerieka", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Moi żołnierze są najlepsi w regionie.", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Wieża Bilala", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Myślę, że moja magiczna biblioteka może cię zainteresować.", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutralni", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Brak opisu rasy", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Galarth", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206PL0009", "ID_STRING": "DESC_TXT", "TEXT": "W czasach młodości ten wielki władca stanął samotnie przeciw wojsku piekieł i pokonał je zapieczętowując bramy, które je wypluwały. Następnie objął suwerenną władzę nad swoim królestwem.", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Fedroth", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Znana w swoich czasach jako najpotężniejsza mistrzyni mrocznej sztuki, władczyni ta zabita została przez inkwizytora Vorgela, który położył kres jej bezeceństwom. Teraz została wskrzeszona jako nieumarła i pragnie władać wszystkimi śmiertelnikami.", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Dagar", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Zythaar", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Imp. dostaje Krakena", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca\r\"Panie, Święta Relikwia pozwoli nam zapanować nad mitycznym Krakenem!\"\r \n", "SEQ_NUM": 2},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Nieumarli dostają Krakena", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca\r\"Panie, Święta Relikwia pozwoli nam zapanować nad mitycznym Krakenem!\"\r \n", "SEQ_NUM": 2},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Imp. dostaje Węża", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca\r\"Panie, Święta Relikwia pozwoli nam zapanować nad mitycznym Wężem Morskim!\"\r \n", "SEQ_NUM": 2},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Nieumarli dostają Węża", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca\r\"Panie, Święta Relikwia pozwoli nam zapanować nad mitycznym Wężem Morskim!\"\r \n", "SEQ_NUM": 2},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Imp. IntroStwór Morski", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca\r\"Dawno temu, jeszcze przed przybyciem Imperium i Hord Nieumarłych, Lud Moczarów i Barbarzyńcy toczyli wojnę o ten kraj.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "\"Mieszkańcy wysp opowiadają historie o tym, jak zapanowali nad mitycznymi morskimi stworami i jak wykorzystywali je w bitwie.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Intro nieumarłych", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca\r\"Dawno temu, jeszcze przed przybyciem Imperium i Hord Nieumarłych, Lud Moczarów i Barbarzyńcy toczyli wojnę o ten kraj.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "\"Mieszkańcy wysp opowiadają historie o tym, jak zapanowali nad mitycznymi morskimi stworami i jak wykorzystywali je w bitwie.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Konwój nieumarłych dotarł", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Panie, konwój bezpiecznie dotarł do celu.\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Imp. konwój dotarł", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Panie, konwój bezpiecznie dotarł do celu.\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Dzień 7 alarm Imp.", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca\r\"Milordzie, jeden z naszych konwojów potrzebuje wsparcia w okolicy miasta Galdarth! Konwój przewozi cenny ładunek, który musi dotrzeć do miejsca przeznaczenia.\"\r \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Dzień 7 alarm konw. nieum.", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca\r\"Panie, jeden z naszych konwojów potrzebuje wsparcia w okolicy miasta Arkenaso! Konwój przewozi bardzo cenny ładunek, który musi dotrzeć do miejsca przeznaczenia.\"\r \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Wywołaj statki Z 1 poz. 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Wywołaj statek Z 2 poz. 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Wywołaj statek Z 3 poz. 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Wywołaj statek Z 4 poz. 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Wywołaj statek Z 5 poz. 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Imp. lok. Górne Galdarth", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Zwiadowca\r\"Panie, zbliżamy się do miasta Galdarth. Powiadają, że przywódca klanu Galdarth posiada magiczny przedmiot pozwalający mu kontrolować potężną bestię...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Nieumarli lok. hist. Galdarth", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Zwiadowca\r\"Panie, zbliżamy się do miasta Galdarth. Powiadają, że przywódca klanu Galdarth posiada magiczny przedmiot pozwalający mu kontrolować potężną bestię...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Imp. konwój stracony", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca\r\"Milordzie, konwój został zniszczony i straciliśmy wszystkie towary...\"\r \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Konwój nieumarłych stracony", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca\r\"Panie, konwój został zniszczony i straciliśmy wszystkie towary...\"\r \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206UN003d", "ID_STRING": "NAME_TXT", "TEXT": "Mityczny Kraken", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206UN003f", "ID_STRING": "NAME_TXT", "TEXT": "Mityczny Wąż Morski", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206UN0040", "ID_STRING": "NAME_TXT", "TEXT": "Jaszczolud", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Imp. lok. hist. Arkenaso", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Zwiadowca\r\"Oto miasto Arkenaso. Dawno temu było największym z miast Moczarów. Ale to były czasy przed wojną z barbarzyńcami... Legendy mówią o magicznym przedmiocie, który daje władzę nad morskimi stworami.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Nieumarli lok. hist. Arkenaso", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Zwiadowca\r\"Oto miasto Arkenaso. Dawno temu było największym z miast Moczarów. Ale to były czasy przed wojną z barbarzyńcami... Legendy mówią o magicznym przedmiocie, który daje władzę nad morskimi stworami.\"", "SEQ_NUM": 0},
