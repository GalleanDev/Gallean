    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0024", "ID_STRING": "NAME_TXT", "TEXT": "Wywołaj statek Z 5 poz. 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Imp. lok. hist. Siria 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Zwiadowca\r\"Milordzie, jesteśmy w pobliżu miasta Siria. Mieszkają w nim głównie kupcy i żeglarze, którzy często się tu zatrzymują w czasie rejsów. W chwili obecnej rządzi tu Lud Moczarów.\" \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Imp. lok. hist Siria 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "Zwiadowca\r\"Milordzie, jesteśmy w pobliżu miasta Siria. Mieszkają w nim głównie kupcy i żeglarze, którzy często się tu zatrzymują w czasie rejsów. W chwili obecnej rządzi tu Lud Moczarów.\"\r \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Nieumarli lok. hist. Sirii 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV0029", "ID_STRING": "POPUP_TXT", "TEXT": "Zwiadowca\r\"Panie, jesteśmy w pobliżu miasta Siria. Mieszkają w nim głównie kupcy i żeglarze, którzy często się tu zatrzymują w czasie rejsów. W chwili obecnej rządzi tu Lud Moczarów.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Nieumarli lok. hist. Sirii 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV002a", "ID_STRING": "POPUP_TXT", "TEXT": "Zwiadowca\r\"Panie, jesteśmy w pobliżu miasta Siria. Mieszkają w nim głównie kupcy i żeglarze, którzy często się tu zatrzymują w czasie rejsów. W chwili obecnej rządzi tu Lud Moczarów.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Dzień 21 posiłki Imp. poz.1", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV002c", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca\r\"Milordzie, przybyły posiłki...\"\r \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV002d", "ID_STRING": "NAME_TXT", "TEXT": "Dzień 21 posiłki bieum. poz.1", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca\r\"Panie, przybyły posiłki...\"\r \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV002e", "ID_STRING": "NAME_TXT", "TEXT": "Dzień 18 alarm nieum.", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV002e", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca\r\"Panie, jeden z naszych zwiadowców donosi, że Mortis wysłała posiłki, które wkrótce do nas dołączą.\"\r \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV002f", "ID_STRING": "NAME_TXT", "TEXT": "Dzień 18 alarm Imp.", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca\r\"Milordzie, jeden z naszych zwiadowców donosi, że zmierzają tu żołnierze wierni Imperium, by nas wesprzeć. Wkrótce do nas dołączą.\"", "SEQ_NUM": 0},
