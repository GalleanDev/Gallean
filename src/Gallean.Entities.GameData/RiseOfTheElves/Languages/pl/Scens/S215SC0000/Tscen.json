    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO0001", "ID_STRING": "NAME_TXT", "TEXT": "Miasto Rivend", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO0002", "ID_STRING": "NAME_TXT", "TEXT": "Terytorium nieumarłych", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO0003", "ID_STRING": "NAME_TXT", "TEXT": "Pojawia się Krath'du", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO0004", "ID_STRING": "NAME_TXT", "TEXT": "Przybycie posiłków", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO0005", "ID_STRING": "NAME_TXT", "TEXT": "Przemieszczenie posiłków", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO0006", "ID_STRING": "NAME_TXT", "TEXT": "T Pojawia się Drega Zul", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO0007", "ID_STRING": "NAME_TXT", "TEXT": "Wyczyść pozycję", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO0008", "ID_STRING": "NAME_TXT", "TEXT": "Wieża strażnicza", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO0009", "ID_STRING": "NAME_TXT", "TEXT": "Demon nadciąga", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO000a", "ID_STRING": "NAME_TXT", "TEXT": "Klany - opuść turę", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO000b", "ID_STRING": "NAME_TXT", "TEXT": "Miasto Fendhil", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO000c", "ID_STRING": "NAME_TXT", "TEXT": "Święte miejsce pustelnika", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO000d", "ID_STRING": "NAME_TXT", "TEXT": "Giermek atakuje", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO000e", "ID_STRING": "NAME_TXT", "TEXT": "Wilki", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO000f", "ID_STRING": "NAME_TXT", "TEXT": "Wieża Zimraana", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO0010", "ID_STRING": "NAME_TXT", "TEXT": "Ukrycie Drega Zul", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO0011", "ID_STRING": "NAME_TXT", "TEXT": "Ostrzeż. Kraken", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Ćwiczenie wojsk", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Wejdźcie, a uczynię z waszych słabych żołnierzy zacnych wojowników.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Kowal Kekkut", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Tu znajdziesz wszystko, czego potrzeba wojownikowi.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Rynek Rivend", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Mamy wszelkie dobra i towary!", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Wieża Zimraana", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Posiadam wiele magii pochodzenia piekielnego.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutralni", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Brak opisu rasy", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Breasal", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL0009", "ID_STRING": "DESC_TXT", "TEXT": "W czasach młodości ten wielki władca stanął samotnie przeciw wojsku piekieł i pokonał je zapieczętowując bramy, które je wypluwały. Następnie objął suwerenną władzę nad swoim królestwem.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Uallgarg", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL000a", "ID_STRING": "DESC_TXT", "TEXT": "W swoich czasach znany jako najpotężniejszy mistrz mrocznej sztuki, władca ten zabity został przez inkwizytora Vorgela, który położył kres jego bezeceństwom. Teraz jest wskrzeszony jako nieumarły i pragnie nagiąć do swej woli wszystkich śmiertelników.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Cathal", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Conall", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN000d", "ID_STRING": "NAME_TXT", "TEXT": "Krasnolud", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0019", "ID_STRING": "NAME_TXT", "TEXT": "Niedźwiedź polarny", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Imp. nadejście Krakena", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul \n\"Milordzie! Zbudziliśmy potwora z głębin. Musimy uciekać!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Fendhil", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Wieśniacy \n\"Dźwięk imienia Krath'du... Niesie ze sobą straszliwe wspomnienia bólu i cierpienia!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Rivend Imp.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Wieśniacy \n\"Słyszeliśmy już imię Krath'du. Powiadają, że w latach strachu i okropieństwa, podczas pustoszenia jednej z wiosek, zlitował się nad pewną młodą panną...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "\"Była piękna, do tego przy nadziei, więc zamiast ją zabić, nakrył swą peleryną śmierci! Jednak ciało dziewczyny, czując opór, który nienarodzone dziecko stawiało wampirycznej inwazji, nie mogło zostać znieprawione... i panna młoda przestała nią być.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul \n\"Ta historia! Wydaje się... aż nazbyt znajoma...\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Kekkut", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Wieśniacy \n\"Zapłacicie za najechanie tego Klanu! Niech pożrą was demony, których poszukujecie!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0028", "ID_STRING": "NAME_TXT", "TEXT": "Zbir", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Kalajit", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Wieśniacy \n\"Za to, co zrobiliście, zapłacicie Klanom własnymi głowami! Takiego spustoszenia nie usprawiedliwi nawet pościg za demonami!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Zbliż. do Rivend - Imp.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul \n\"Zbliżamy się do miasta Rivend, milordzie. Jest silnie ufortyfikowane i od lat opiera się atakom nieumarłych. Nie będzie łatwo go zająć, bowiem mieszkańcy są nawykli do wojny!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Zbliż. do nieum. - Imp.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul \n\"To jest droga na terytorium nieumarłych, milordzie. Strzeż się. Stwory nocy są wyjątkowo niebezpieczne...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Plądr. wieżę straż. Imp.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "\"W wieży znajduje się inskrypcja, ale zachowała się tylko częściowo... Tu jest napisane: \"Kiedy oczy Nosferata Krath'du spoczęły na obliczu damy, rzekł do niej: Bądź moją\". Cóż mogą znaczyć te słowa, milordzie?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Plądr. opuszczone schr. Imp.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul \n\"Niedawno niedźwiedź urządził sobie tu legowisko, jednak przytłaczająca obecność śmierci pozostała, a wzdłuż ścian walają się czaszki. Nie ma wątpliwości, że jest to schronienie wampira!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Plądr. prac. alchemika Imp.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul \n\"Nie ma dowodów na to, że Krath'du miał do czynienia z krasnoludami, milordzie... Znaleziono jedynie zwyczajne magiczne przedmioty Klanów.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Plądr. zrujnowany zamek Imp. 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Krath'du \n\"Tak długo na ciebie czekałem, Drega Zul... Musimy być razem, rozumiesz? Naszym przeznaczeniem jest rządzić tą krainą - we dwoje!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Nieumarli - wiadomość", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "\"Imperium odnalazło Krath'du, panie... Musimy natychmiast go schwytać, zanim wymknie się słabym żołnierzom Imperium!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Dzień po złupieniu Imp.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Sir Geldwin \n\"Wiemy, że straciłeś wartościowego wodza! Jesteśmy tu, by uzupełnić straty, milordzie.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Intro nieumarłych", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "\"Panie! Szalony Nosferat Krath'du uciekł ze stolicy! Odszedł w środku dnia i zabrał wiernych sobie żołnierzy... Jego słudzy mówią, że wyruszył na poszukiwanie swej jedynej towarzyszki - pół-ludzkiej, pół-nieumarłej istoty, którą stworzył - Drega Zul!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "\"Wiele lat temu usiłował nawrócić śmiertelną matkę tej istoty, kiedy jeszcze nosiła w łonie dziecko. Oczywiście nienarodzone ciało zmieniło się w potworność, którą jest obecnie. Musimy powstrzymać go, zanim poniesie dalej swój Mroczny Dar!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Imperium Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul \n\"Milordzie, służę ci lojalnie już od wielu lat. Teraz jednak muszę pomścić śmierć mojego ojca. Przyszedł już na to czas...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "\"Wiele lat temu został brutalnie zabity przez tego samego Nosferata, który uczynił ze mnie to dziwadło, którym jestem obecnie... Muszę pomścić jego śmierć! Zaklinam cię, pomóż mi odnaleźć tego demona!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Ona ma rację, milordzie. Powinniśmy rozszerzyć nasze działania wojenne i zaatakować także siły nieumarłych. Popełnili oni niezliczone zbrodnie przeciw naszym ludziom i nadszedł czas, by zaznali naszego gniewu!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Wieża straż. Imperium", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Zbuntowany giermek \n\"Ta wieża nie jest przeznaczona dla żołnierzy Imperium!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Wieża straż. nieum.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Zbuntowany giermek \n\"Alarm! Do broni! Nieumarli atakują!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Zbliż. do Rivend - nieum.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Włócznicy na straży \n\"Ogłosić alarm! Nadciągają nieumarli! Powiadomić magów!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0036", "ID_STRING": "NAME_TXT", "TEXT": "Włócznik z Rivend", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Klany - opuść turę", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Skalny olbrzym \n\"To terytorium klanowe, nie macie tu czego szukać... Zawracajcie, albo zmierzcie się z konsekwencjami!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN003a", "ID_STRING": "NAME_TXT", "TEXT": "Zbuntowany giermek", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Zbliż. do Fendhil - Imp.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Zbuntowany giermek \n\"Trzymaj się z dala od naszego miasta, żołdaku Imperium! Nasi ludzie żyją wolni od waszej tyranii!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Zbliż. do Fendhil - nieum.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Zbuntowany giermek \n\"Nie myślcie sobie, ze mieszkańcy tego miasta dadzą się łatwo pokonać! Przygotujcie się na swój koniec, nieumarłe bydło!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN003c", "ID_STRING": "NAME_TXT", "TEXT": "Włócznik", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Święte miejsce pustelnika", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Pustelnik \n\"Istoty nieczystego serca nie wejdą tu, by zbrukać to święte miejsce spoczynku! Jest zarezerwowane dla wybranych wojowników Wotana... Uwolnię to miejsce od waszej obecności!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Giermek atakuje nieum.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Zbuntowany giermek \n\"Niech siły światłości zniszczą was, parszywi nieumarli!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN003e", "ID_STRING": "NAME_TXT", "TEXT": "Wódz zbirów", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Ostrzeżenie o wilku", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "\"Milordzie, tubylcy podejrzewają, że w tych stronach żyje jakaś straszna wilcza bestia.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Imperium dzień 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Nasz informator wśród nieumarłych donosi o niedawnym zniknięciu pewnego niejakiego lorda Krath'du... Może to być ten okrutny rzeźnik, którego szukamy!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Imperium zwycięstwo", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0041", "ID_STRING": "NAME_TXT", "TEXT": "Zbuntowany giermek", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Plądr. opuszczone schr. nieum.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "\"Krath'du był tutaj! Wokół murów wytyczył linię z czaszek swych ofiar. Nie ma jednak żadnych śladów wskazujących, gdzie może być on sam...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Plądr. prac. alchemika nieum.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "\"Nie ma tu nic ciekawego, panie. Tylko krasnoludzkie magiczne przedmioty.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Plądr. zrujnowany zamek nieum. 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Krath'du \n\"Nie myślcie, że wasze archaiczne metody będą w stanie was uratować, nieumarli żołnierze! Tworzę teraz nową, nadrzędną rasę razem z moją ukochaną - Drega Zul. Czekam na nią, a gdy przybędzie, wy przepadniecie!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0044", "ID_STRING": "NAME_TXT", "TEXT": "Zbuntowany giermek", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Imperium komunikat", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "\"Siły nieumarłych odnalazły Krath'du! Ruszajmy do ataku!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Plądr. zrujnowany zamek Imp. 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Odmieniona Drega Zul \n\"Teraz rozumiem, mój Krath'du... Naszym przeznaczeniem jest być razem.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Milordzie! Zły Krath'du zaplanował to od początku do końca - wpędzenie nas w pułapkę i zaklęcie Drega Zul! Chociaż jesteśmy osłabieni, musimy działać... Musimy zabić Krath'du, żeby złamać czar, który na nią rzucił!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "\"Nie rozpaczaj, milordzie, posłałem po posiłki.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0049", "ID_STRING": "NAME_TXT", "TEXT": "Wódz zbirów", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Zaatak. straży Rivend 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0026", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul \n\"Teraz, kiedy zadaliśmy pierwszy cios, ludzie z pewnością będą chcieli go odwzajemnić... Powinniśmy opuścić ten rejon, jeśli nie jesteśmy przygotowani do wojny!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Zaatak. straży Rivend 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul \n\"Teraz, kiedy zadaliśmy pierwszy cios, ludzie z pewnością będą chcieli go odwzajemnić... Powinniśmy opuścić ten rejon, jeśli nie jesteśmy przygotowani do wojny!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Rivend nieum.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "\"Ci ludzie wiedzą o uczynkach Krath'du... Mógł zarazić więcej niewinnych niż przypuszczaliśmy. Nie możemy się wycofać.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Fendhil nieum.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0029", "ID_STRING": "POPUP_TXT", "TEXT": "\"Panie, wieśniacy nic nie wiedzą o poczynaniach Krath'du... Nie widziano go tutaj od wielu lat.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN004c", "ID_STRING": "NAME_TXT", "TEXT": "Włócznik", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Porażka nieumarłych", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002a", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca\r\"Krath'du nadal żyje i nie spocznie, dopóki nie zabije Drega Zul. Żeby to osiągnąć, wprowadzi zamęt w szykach Hord Nieumarłych! Musimy skupić się na własnej obronie...\"\r \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002b", "ID_STRING": "NAME_TXT", "TEXT": "Drega Zul zdob. Fendhil", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN004f", "ID_STRING": "NAME_TXT", "TEXT": "Wilk", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Zwycięstwo nieumarłych2", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002c", "ID_STRING": "POPUP_TXT", "TEXT": "\"Śmierć wreszcie dopadła szalonego Krath'du... Nasza szlachetna krew nie będzie już marnotrawiona...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0050", "ID_STRING": "NAME_TXT", "TEXT": "Wilk", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002f", "ID_STRING": "NAME_TXT", "TEXT": "Drega podch. do Krath'du", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "Krath'du \n\"Tak długo na ciebie czekałem, Drega Zul... Musimy być razem... Rozumiesz? Naszym przeznaczeniem jest rządzić tą krainą we dwoje!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul \n\"Teraz rozumiem, mój Krath'du... Wspólny los jest nam przeznaczony.\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "\"Milordzie! Zły Krath'du zaplanował to od początku do końca - wpędzenie nas w pułapkę i zaklęcie Drega Zul! Chociaż jesteśmy osłabieni, musimy działać... Trzeba złamać czar, który na nią rzucił!\"", "SEQ_NUM": 5},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0030", "ID_STRING": "NAME_TXT", "TEXT": "Wył. plądr. zamek nieum.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0031", "ID_STRING": "NAME_TXT", "TEXT": "Nieum. nadejście Krakena", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0031", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Panie, zbudziliśmy potwora z otchłani! Musimy uciekać!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0032", "ID_STRING": "NAME_TXT", "TEXT": "Imp. lok. wskazówka Krath'du", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0032", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul \n\"Ten obszar został dotknięty wpływem jakiejś ciemnej siły, milordzie... Czyżby Krath'du był w pobliżu?\"\r \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0033", "ID_STRING": "NAME_TXT", "TEXT": "Nieum. lok. Krath'du", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0033", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca\r\"Ten obszar dostał się we władanie nieumarłych mocy, panie... Krath'du musi być blisko.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0058", "ID_STRING": "NAME_TXT", "TEXT": "Pustelnik", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0035", "ID_STRING": "NAME_TXT", "TEXT": "Imp. lok. ostrz. Kraken", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0035", "ID_STRING": "POPUP_TXT", "TEXT": "Drega Zul \n\"Zapamiętaj to ostrzeżenie, milordzie: W okolicy dostrzeżono Krakeny. Powinniśmy zawrócić!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0059", "ID_STRING": "NAME_TXT", "TEXT": "Krasnolud", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0036", "ID_STRING": "NAME_TXT", "TEXT": "Nieum. lok. ostrzeżenie Kraken", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0036", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Zważ na to, panie: w okolicy widziano Krakeny. Powinniśmy zawrócić!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN005d", "ID_STRING": "NAME_TXT", "TEXT": "Krasnolud", "SEQ_NUM": 0},
