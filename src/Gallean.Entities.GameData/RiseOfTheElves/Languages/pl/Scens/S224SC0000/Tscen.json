    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Obóz Yggara", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Tutaj szkolili się najwięksi wojownicy tego królestwa.", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Sallata", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Czym mogę służyć, przybyszu?", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Warwicka", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Moje towary pomogą ci w twojej misji.", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Wieża Othona", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Mogę pomóc wam w walce z inwazją demonów!", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0004", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Furrena", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224SI0004", "ID_STRING": "TXT_DESC", "TEXT": "Za odpowiednią cenę sprzedam wszystko.", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutralni", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Brak opisu rasy", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Winfrid", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224PL0009", "ID_STRING": "DESC_TXT", "TEXT": "W czasach młodości ten wielki władca stanął samotnie przeciw wojsku piekieł i pokonał je zapieczętowując bramy, które je wypluwały. Następnie objął suwerenną władzę nad swoim królestwem.", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Baldaric", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Najwyższy z władców krasnoludów, znany jest ze swej zaciętości w bitwie i odwagi w obliczu niesprzyjających okoliczności. Kiedyś przez siedem dni i nocy walczył z wielkim smokiem ARFURUZONEM, by wreszcie go pokonać.", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Korund", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Lantfrid", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0008", "ID_STRING": "NAME_TXT", "TEXT": "Zbir", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0023", "ID_STRING": "NAME_TXT", "TEXT": "Włócznik", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Inferno", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "\"Spójrzcie tylko! Sama nasza obecność zdaje się oczyszczać ziemię ze zła, którym jest przesiąknięta! Nasz wpływ pokonuje zepsucie!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0001", "ID_STRING": "NAME_TXT", "TEXT": "GK zwycięstwo", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "\"Klan zwyciężył zarazę, która rozprzestrzeniała się w tym kraju...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Avgrundskval", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "\"To niesamowite! Nasza obecność zmienia ziemię wokół nas i z każdym naszym krokiem zamykają się piekielne szczeliny lawy... Wiara naszych żołnierzy odrodzi się!\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Deszcz demonów", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Cmentarz", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "\"Demony ograbiły nawet nasze sanktuarium w poszukiwaniu umarłych! Musimy się zemścić!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0028", "ID_STRING": "NAME_TXT", "TEXT": "Włócznik", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Nekromanta", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Nekromanta: \"Ha ha ha! Pokłońcie się swemu nowemu władcy, mizerni śmiertelnicy! Nasz Smoczy Władca unicestwi was jednym swoim oddechem!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Imperium Straż Chłopska", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "\"Nie służymy już Imperium. Sami się o siebie zatroszczymy, więc trzymajcie się z dala od naszych ziem, żołnierze!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN002b", "ID_STRING": "NAME_TXT", "TEXT": "chłop", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Czar demonologa", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "\"Na wasze nieszczęście, śmiertelnicy, to teraz nasze królestwo! Jak śmiecie kalać tę ziemię swoją obecnością!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN002c", "ID_STRING": "NAME_TXT", "TEXT": "Chłop", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Nieczysty portal", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Demony \n\"Śmierć przybywa do tych, którzy jej szukają! I właśnie ją znaleźliście!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Imperium wizyta w obozie", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Lorn: \"Zaczekajcie! Pozwólcie nam przyłączyć się do was. Nie chcemy już dłużej służyć Smoczemu Włodarzowi!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000d", "ID_STRING": "NAME_TXT", "TEXT": "GK wizyta u krasnoluda", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Krasnolud: \"Nareszcie powróciliście, aby kontynuować krucjatę przeciw złemu Władcy Smoków! Ja jestem już zbyt znużony... Weźcie to, bardzo się wam przyda...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000e", "ID_STRING": "NAME_TXT", "TEXT": "GK straż chłopska", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "\"Trzymajcie się z daleka od naszej osady, durne krasnale. Mogą tu wejść tylko ludzie!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Wył. straż. chłop GK", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "\"Klany, będziemy się bronić!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0032", "ID_STRING": "NAME_TXT", "TEXT": "Włócznik", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Imperium zwycięstwo", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "\"W imię Wszechojca, wypleniliśmy zło z tych krain!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Imperium Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "\"Odkąd sięgam pamięcią, żyliśmy na tych ziemiach w pokoju z Górskimi Klanami. Aż pewnego dnia niebo na południu zaciągnęło się ciemnością, a od ziemi buchać zaczął okrutny żar.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "\"Obawiam się, że zareagowaliśmy za późno. Nasi poddani uciekają w panice z miast, a cały kraj wokół pogrąża się w chaosie. Musimy znaleźć i zniszczyć źródło zła!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0035", "ID_STRING": "NAME_TXT", "TEXT": "Włócznik", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0012", "ID_STRING": "NAME_TXT", "TEXT": "GK Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "\"Odkąd sięgam pamięcią, żyliśmy na tych ziemiach w pokoju z Imperium. Aż pewnego dnia niebo na południu zaciągnęło się ciemnością, a od ziemi buchać zaczął okrutny żar.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "\"Obawiam się, że zareagowaliśmy za późno. Nasi poddani uciekają w panice ze stolicy, a cały kraj wokół pogrąża się w chaosie. Musimy znaleźć źródło zła i zniszczyć je!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Włącz deszcz demonów", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "\"Demony wydostają się spod ziemi. Trzeba je powstrzymać!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0014", "ID_STRING": "NAME_TXT", "TEXT": "GK pn. warownia zach.", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "\"Niech lud Klanów trzyma się z daleka od naszego miasta. Przyjmujemy tylko prawdziwych ludzi!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0015", "ID_STRING": "NAME_TXT", "TEXT": "GK pn. warownia wsch.", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "\"Niech lud Klanów trzyma się z daleka od naszego miasta. Przyjmujemy tylko prawdziwych ludzi!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0039", "ID_STRING": "NAME_TXT", "TEXT": "Chłop", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Imperium pn. warownia wsch.", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "\"Żołnierze Imperium, nie obroniliście nas przed demonami, więc bronimy się sami. A teraz odstąpcie, zanim i wam się oberwie!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Imperium pn. warownia zach.", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "\"Żołnierze Imperium, nie obroniliście nas przed demonami, więc bronimy się sami. A teraz odstąpcie, zanim i wam się oberwie!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0018", "ID_STRING": "NAME_TXT", "TEXT": "GK zbliż. do Nieczystego Portalu", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "\"Milordzie! Wyczuwamy tu pułapkę zastawioną przez potężne złe moce! Od ziemi bije jakiś żar... Powinniśmy przygotować nasze najmocniejsze czary!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Imperium zbliż. do Nieczyst. Port.", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "\"Milordzie! Wyczuwamy tu pułapkę zastawioną przez potężne złe moce! Od ziemi bije jakiś żar... Niechaj Wszechojciec będzie z nami!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Imperium wizyta u krasnoluda", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "\"Czy przybywasz tu, by zabić złego smoka? Moje rany są śmiertelne, nie dam już rady... Weź to i zabij bestię…\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Obok giermka", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "\"Nie potrzebujemy waszej pomocy, by pokonać te bestie. Odstąpcie, jesteśmy uzbrojeni po zęby!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Blisko zombi", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "\"Milordzie! To są te okrutne demony, o których wspominali wieśniacy!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN003f", "ID_STRING": "NAME_TXT", "TEXT": "Chłop", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Obok Widmowej Pani", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "\"Milordzie! To są te okrutne demony, o których wspominali wieśniacy!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0042", "ID_STRING": "NAME_TXT", "TEXT": "Włócznik", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Umykający chłop", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "\"Ratunku! Pomocy! Ratuj nas, milordzie! Jesteśmy niżej, w dolinie, a potworne demony ruszyły za nami w pościg! Zabij je, zabij! Pomocy!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Fort March Imp.", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Wieśniacy \n\"Błagamy, uratujcie nas przed demonami! Poprzysięgli złożyć nas w ofierze Smoczemu Władcy!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Fort March GK", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Wieśniacy\r\"Najpierw inwazja demonów, a teraz podstępne Górskie Klany! Zlitujcie się nad nami!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN0049", "ID_STRING": "NAME_TXT", "TEXT": "Giermek", "SEQ_NUM": 0},
    {"NO_SCEN": "S224SC0000", "ID_OBJECT": "S224UN004f", "ID_STRING": "NAME_TXT", "TEXT": "Giermek", "SEQ_NUM": 0},
