  "rows": [
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutralni", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Brak opisu rasy", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250PL0001", "ID_STRING": "NAME_TXT", "TEXT": "Konrad", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250PL0001", "ID_STRING": "DESC_TXT", "TEXT": "W czasach młodości ten wielki władca stanął samotnie przeciw wojsku piekieł i pokonał je zapieczętowując bramy, które je wypluwały. Następnie objął suwerenną władzę nad swoim królestwem.", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250PL0002", "ID_STRING": "NAME_TXT", "TEXT": "Moldar", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250PL0002", "ID_STRING": "DESC_TXT", "TEXT": "Najwyższy z władców krasnoludów, znany jest ze swej zaciętości w bitwie i odwagi w obliczu niesprzyjających okoliczności. Kiedyś przez siedem dni i nocy walczył z wielkim smokiem ARFURUZONEM, by wreszcie go pokonać.", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250PL0003", "ID_STRING": "NAME_TXT", "TEXT": "Dorian", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250PL0003", "ID_STRING": "DESC_TXT", "TEXT": "Jej imieniem straszy się dzieci. Ta pani piekieł słynie ze swej krwiożerczości. Mówi się, że kiedyś, w czasie bankietu wdanego przez Bethrezena z okazji zwycięstwa nad królestwem światłości, pożarła tysiąc niewolników.", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250UN001b", "ID_STRING": "NAME_TXT", "TEXT": "Włócznik", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250UN001f", "ID_STRING": "NAME_TXT", "TEXT": "Górski olbrzym", "SEQ_NUM": 0},
