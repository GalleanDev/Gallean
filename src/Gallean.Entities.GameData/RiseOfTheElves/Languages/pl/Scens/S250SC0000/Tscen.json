    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Empire's goal", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Legion goal01", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250EV0009", "ID_STRING": "NAME_TXT", "TEXT": "L removemountain", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250EV000a", "ID_STRING": "NAME_TXT", "TEXT": "L removemountain02", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Legion change goal", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "_", "SEQ_NUM": 2},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250EV000b", "ID_STRING": "OBJECT_TXT", "TEXT": "Empire and Mountain clan: Take the Legions Capital \n \nLegions: Defeat Sordan the Wizard", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Legion goal 02", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250EV000d", "ID_STRING": "NAME_TXT", "TEXT": "L dragon to legion", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca\n\"To coś więcej, niż zwykły artefakt - dzięki temu oku możemy dowodzić bestią, Dakoniakiem! Dzięki jego potędze z pewnością zwyciężymy.\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250EV000e", "ID_STRING": "NAME_TXT", "TEXT": "E Dragon to Empire", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca\n\"Chwała Wszechojcu! Dzięki tej błyskotce możemy władać straszliwym Dakoniakiem!\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250EV000f", "ID_STRING": "NAME_TXT", "TEXT": "M dragon to MC", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca\n\"Ta zabawka umożliwi nam władanie potężnym Dakoniakiem, panie!\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250EV0013", "ID_STRING": "NAME_TXT", "TEXT": "E M peasant to werewolf", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Chłop \n\"Ja... Wkrótce zginę. Jestem taki słaby... Proszę, pomóż nam!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250EV0014", "ID_STRING": "NAME_TXT", "TEXT": "E humainorder", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Włócznik\n\"Otrzymałem rozkazy, aby nikogo tędy nie przepuszczać, macie więc dwie możliwości: możecie albo zawrócić, albo zakosztować ostrza mej włóczni.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250EV0015", "ID_STRING": "NAME_TXT", "TEXT": "M orderdwarf", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Górski olbrzym\n\"Tędy nie przejdziecie. Odejdźcie, albo stanie się wam krzywda.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250EV0017", "ID_STRING": "NAME_TXT", "TEXT": "A dwarfzombie", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Boirro \n\"Prooooszęęęęęę... Idźcie sooooobieeee. Nie wiem, co ze mną zrobili, a nie chcę wam zrobić krzywdy!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250EV001a", "ID_STRING": "NAME_TXT", "TEXT": " spell of the old Wizard", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Prastary Hisderon \n\"Jestem bardzo stary, umieram. Wolę zginąć w płomieniach niż uschnąć ze starości... Spiesz się, pomogę ci mym ostatnim tchem!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250EV001d", "ID_STRING": "NAME_TXT", "TEXT": "L spell old wizard vs L", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Prastary czarodziej\n\"Ten starzec użądli cię jeszcze raz przed śmiercią!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250EV001f", "ID_STRING": "NAME_TXT", "TEXT": "E M hint for wizard", "SEQ_NUM": 0},
