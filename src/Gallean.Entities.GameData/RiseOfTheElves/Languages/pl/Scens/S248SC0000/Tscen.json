    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248PL0001", "ID_STRING": "NAME_TXT", "TEXT": "Konrad", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248PL0001", "ID_STRING": "DESC_TXT", "TEXT": "W czasach młodości ten wielki władca stanął samotnie przeciw wojsku piekieł i pokonał je zapieczętowując bramy, które je wypluwały. Następnie objął suwerenną władzę nad swoim królestwem.", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248PL0002", "ID_STRING": "NAME_TXT", "TEXT": "Bertin", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248PL0002", "ID_STRING": "DESC_TXT", "TEXT": "Najwyższy z władców krasnoludów, znany jest ze swej zaciętości w bitwie i odwagi w obliczu niesprzyjających okoliczności. Kiedyś przez siedem dni i nocy walczył z wielkim smokiem ARFURUZONEM, by wreszcie go pokonać.", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248PL0003", "ID_STRING": "NAME_TXT", "TEXT": "Ophaal", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248PL0003", "ID_STRING": "DESC_TXT", "TEXT": "Znana w swoich czasach jako najpotężniejsza mistrzyni mrocznej sztuki, władczyni ta zabita została przez inkwizytora Vorgela, który położył kres jej bezeceństwom. Teraz została wskrzeszona jako nieumarła i pragnie władać wszystkimi śmiertelnikami.", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Clovis", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Trudulf", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248UN0005", "ID_STRING": "NAME_TXT", "TEXT": "Zythaar", "SEQ_NUM": 0},
