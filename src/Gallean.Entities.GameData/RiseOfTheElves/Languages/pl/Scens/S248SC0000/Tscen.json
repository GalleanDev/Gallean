    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Empire 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Undead 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Undead 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Clans 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV000a", "ID_STRING": "NAME_TXT", "TEXT": "MC Day 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Królowa Elfów  \n\"Przychodzę do was w tajemnicy. Moi ludzie nie żyją. Tylko wy mi pozostaliście, przyjaciele.\"\r \n", "SEQ_NUM": 1},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Królowa Elfów \n\"Miasta Jupien i Jumien zostały opanowane przez demony z królestwa Bethrezena! Nie ma już o co walczyć, moje miasta legły w gruzach, moi ludzie zginęli! Wciąż jednak pozostaje mój czar. Mój czar trafił w ręce demonów!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Królowa Elfów \n\"Posiadacz tego czaru ma władzę nad smokami - a one zetrą z powierzchni ziemi wszystkie rasy, włącznie z wami! Bethrezen chce zamienić cały świat w ogniste piekło...\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Królowa Elfów\n\"Musicie mi pomóc, jeśli nie przez wzgląd na mnie, to chociaż we własnej obronie - pokonajcie demony, które panoszą się w Jupien i Jumien!\"\r \n", "SEQ_NUM": 4},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV000b", "ID_STRING": "NAME_TXT", "TEXT": "EMP Day 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Królowa Elfów  \n\"Przychodzę do was w tajemnicy. Moi ludzie nie żyją. Tylko wy mi pozostaliście, przyjaciele.\"\r \n", "SEQ_NUM": 1},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Królowa Elfów \n\"Miasta Jupien i Jumien zostały opanowane przez demony z królestwa Bethrezena! Nie ma już o co walczyć, moje miasta legły w gruzach, moi ludzie zginęli! Wciąż jednak pozostaje mój czar. Mój czar trafił w ręce demonów!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Królowa Elfów \n\"Posiadacz tego czaru ma władzę nad smokami - a one zetrą z powierzchni ziemi wszystkie rasy, włącznie z wami! Bethrezen chce zamienić cały świat w ogniste piekło...\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Królowa Elfów\n\"Musicie mi pomóc, jeśli nie przez wzgląd na mnie, to chociaż we własnej obronie - pokonajcie demony, które panoszą się w Jupien i Jumien!\"\r \n", "SEQ_NUM": 4},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV000c", "ID_STRING": "NAME_TXT", "TEXT": "MC Dragon Island", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Arcydruidka \n\"To skradziony czar! Smoki się zbudziły! Uciekajcie!\"\r \n", "SEQ_NUM": 1},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV000e", "ID_STRING": "NAME_TXT", "TEXT": "EMP Dragon Island ", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Prorokini \n\"To skradziony czar! Smoki się zbudziły! Uciekajcie!\"\r \n", "SEQ_NUM": 1},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0011", "ID_STRING": "NAME_TXT", "TEXT": "EMP Own Elf Cities", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Królowa Elfów \n\"Dziękuję! Magia tego miejsca została zbrukana przez żołnierzy Bethrezena, ale magia elfów jest potężniejsza od bezmyślnej siły! Odbudujemy kraj, który - dzięki waszemu wysiłkowi - wciąż należy do nas...\"\r \n", "SEQ_NUM": 3},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Królowa Elfów \n\"Jednak smoki nie przestaną atakować Jeziora Smutków! Zabierzcie mnie na Wyspę Straconych Łez. Ugaszę ich gniew i uśpię je ponownie.\"\r \n", "SEQ_NUM": 4},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0011", "ID_STRING": "OBJECT_TXT", "TEXT": "Escort the Elf Queen to the Island of Lost tears. \nThe Elf Queen must not die.", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0012", "ID_STRING": "NAME_TXT", "TEXT": "EMP WIN Island lost tears", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Królowa Elfów\r\"Śpijcie, smoki! Niechaj zgaśnie wasz gniew! Będę was chronić do końca swych dni.\"\r \n", "SEQ_NUM": 1},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0013", "ID_STRING": "NAME_TXT", "TEXT": "MC WIN Island lost tears", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Królowa Elfów\r\"Śpijcie, smoki! Niechaj zgaśnie wasz gniew! Będę was chronić do końca swych dni.\"\r \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0015", "ID_STRING": "NAME_TXT", "TEXT": "UND Day 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Arcylisz \n\"Misssstrzu. Znów słyszę twój głos... Jessstem taki zmęczony, powrót do tego świata sssssprawia mi ból. Jakie sssą twoje rozkazy?\"\r \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Arcylisz \n\"Rozzłościła cię Królowa Elfów, Misssstrzu? Udam się na północ i sssspełnię twoją wolę... \"\r \n", "SEQ_NUM": 1},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Arcylisz \n\"Bracia, sssiostry, obudźcie się! Przyzwano nassss raz jeszcze...\"\r \n", "SEQ_NUM": 2},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0016", "ID_STRING": "NAME_TXT", "TEXT": "UND First City Jupien", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Arcylisz \n\"To sssssą demony, Missstrzu. Nie znaleźliśmy Królowej Elfów, która tak cię rozwścieczyła...\" \r \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Arcylisz \n\"Tak, Missstrzu. Podbijemy wszysssstkie miassssta elfów...\"\r \n", "SEQ_NUM": 1},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Arcylisz \n\"Nie udało nam się jeszcze uciszyć naszego Misssstrza. Naprzód...\"\r \n", "SEQ_NUM": 2},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0017", "ID_STRING": "NAME_TXT", "TEXT": "UND First City Jumien", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Arcylisz \n\"To sssssą demony, Missstrzu. Nie znaleźliśmy Królowej Elfów, która tak cię rozwścieczyła...\" \r \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Arcylisz \n\"Tak, Missstrzu. Podbijemy wszysssstkie miassssta elfów...\"\r \n", "SEQ_NUM": 1},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Arcylisz \n\"Nie udało nam się jeszcze uciszyć naszego Misssstrza. Naprzód...\"\r \n", "SEQ_NUM": 2},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0018", "ID_STRING": "NAME_TXT", "TEXT": "UND Own Second City Jupie", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Arcylisz \n\"Twój cel sssstał się jasssny, Missstrzu. Chcesz zdobyć czar Elfów.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248UN003b", "ID_STRING": "NAME_TXT", "TEXT": "Tytan", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0019", "ID_STRING": "NAME_TXT", "TEXT": "UND Own Second City Jumie", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Arcylisz \n\"Twój cel sssstał się jasssny, Missstrzu. Chcesz zdobyć czar Elfów.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248UN003c", "ID_STRING": "NAME_TXT", "TEXT": "Giermek", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV001a", "ID_STRING": "NAME_TXT", "TEXT": "UND Own Elf Cities", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Królowa Elfów \n\"Nie użyjecie czaru, głupcy! Nie pozwolę go sobie znowu odebrać!\"\r \n", "SEQ_NUM": 1},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Arcylisz \n\"Co nam rozkażesz, Missssstrzu? Czy ona też ma zginąć?\"\r \n", "SEQ_NUM": 2},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Arcylisz \n\"Rozumiem, Misssstrzu. Mam nadzieję, że to już koniec...\"\r \n", "SEQ_NUM": 3},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV001a", "ID_STRING": "OBJECT_TXT", "TEXT": "Kill the Elf Queen.", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Und WIN Kill Queen", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Arcylisz \n\"O słodka nicości! Powracam do ciebie, Ojcze!\"\r \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV001c", "ID_STRING": "NAME_TXT", "TEXT": "MC Own Elf Cities", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Królowa Elfów \n\"Dziękuję! Magia tego miejsca została zbrukana przez żołnierzy Bethrezena, ale magia elfów jest potężniejsza od bezmyślnej siły! Odbudujemy kraj, który - dzięki waszemu wysiłkowi - wciąż należy do nas...\"\r \n", "SEQ_NUM": 3},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Królowa Elfów \n\"Jednak smoki nie przestaną atakować Jeziora Smutków! Zabierzcie mnie na Wyspę Straconych Łez. Ugaszę ich gniew i uśpię je ponownie.\"\r \n", "SEQ_NUM": 4},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV001c", "ID_STRING": "OBJECT_TXT", "TEXT": "Escort the Elf Queen to the Island of Lost Tears. \nThe Elf Queen must not die.", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV001d", "ID_STRING": "NAME_TXT", "TEXT": "MC Don't Own Elf Cities", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Elf Tropiciel \n\"Witajcie krasnoludy! Przynoszę wam dobre wieści! Demony zostały wypędzone z miast elfów przez siły Imperium!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Elf Tropiciel \n\"W tej chwili nasza królowa udała się na Wyspę Straconych Łez. Jeśli wasi żołnierze przebywają w okolicy, może zapewnicie jej dodatkową eskortę?\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV001e", "ID_STRING": "NAME_TXT", "TEXT": "MC LOSE Kill Elf Queen", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Obrońca Wiary \n\"Królowa Elfów?! Nie żyje?! Biada! Smoki zostaną tu już na zawsze, bo zabiliście jedyną istotę, która potrafiła je kontrolować! To wy jesteście za to odpowiedzialne, krasnoludy! Wszyscy będą przez was cierpieć!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV001f", "ID_STRING": "NAME_TXT", "TEXT": "EMP LOSE Kill Elf Queen", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Mistrz Runów\n\"Królowa Elfów?! Nie żyje?! Biada! Smoki zostaną tu już na zawsze, bo zabiliście jedyną istotę, która potrafiła je kontrolować! To wy jesteście za to odpowiedzialni! Wszyscy będą przez was cierpieć!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0021", "ID_STRING": "NAME_TXT", "TEXT": "EMP Don't Own Elf Cities", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Elf Tropiciel \n\"Witajcie, przyjaciele! Przynoszę wam dobre wieści! Demony zostały wypędzone z miast elfów przez siły Górskich Klanów!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Elf Tropiciel \n\"W tej chwili nasza królowa udała się na Wyspę Straconych Łez. Jeśli wasi żołnierze przebywają w okolicy, może zapewnicie jej dodatkową eskortę?\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248EV0022", "ID_STRING": "NAME_TXT", "TEXT": "EMP LOSE Elf Queen Dies", "SEQ_NUM": 0},
