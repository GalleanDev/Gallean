    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253LO0027", "ID_STRING": "NAME_TXT", "TEXT": "Wieża maga", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253LO0028", "ID_STRING": "NAME_TXT", "TEXT": "Spotkanie orków", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253LO0029", "ID_STRING": "NAME_TXT", "TEXT": "Górskie przejście", "SEQ_NUM": 0},
