    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253LO002b", "ID_STRING": "NAME_TXT", "TEXT": "Usuń góry2", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Cykuty", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Moje towary pomogą ci w twojej misji.", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Herlicka", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Przyjrzyj się moim towarom. Może znajdziesz wśród nich coś interesującego.", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Wieża Garkatha", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Czy pragniesz jakichś ciekawszych czarów?", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0005", "ID_STRING": "TXT_TITLE", "TEXT": "Obóz Metaki", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253SI0005", "ID_STRING": "TXT_DESC", "TEXT": "Wejdźcie, a uczynię z waszych słabych żołnierzy zacnych wojowników.", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutralni", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Brak opisu rasy", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Goar", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253PL0009", "ID_STRING": "DESC_TXT", "TEXT": "W czasach młodości ten wielki władca stanął samotnie przeciw wojsku piekieł i pokonał je zapieczętowując bramy, które je wypluwały. Następnie objął suwerenną władzę nad swoim królestwem.", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Jagare", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN000c", "ID_STRING": "NAME_TXT", "TEXT": "Goblin", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN000e", "ID_STRING": "NAME_TXT", "TEXT": "Goblin", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0010", "ID_STRING": "NAME_TXT", "TEXT": "Chłop", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0012", "ID_STRING": "NAME_TXT", "TEXT": "Głowa wioski", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0018", "ID_STRING": "NAME_TXT", "TEXT": "Goblin", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN001c", "ID_STRING": "NAME_TXT", "TEXT": "Chłop", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN001e", "ID_STRING": "NAME_TXT", "TEXT": "Chłop", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Intro 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Milordzie, w sytuacja w królestwie jest bardzo poważna. Zdaje się, że zbuntowali się wszyscy nasi wieśniacy!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Musimy siłą odebrać nasze miasta i odkryć, kto do za tym stoi! W pierwszej kolejności powinniśmy spotkać się z kanclerzem Clovis i przedyskutować najlepsze taktyki walki.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Intro 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Imperialny doradca \n\"Witaj, milordzie. Jestem twoim imperialnym doradcą. Będę dawał ci dobre rady dotyczące niuansów rządzenia królestwem.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Imperialny doradca \n\"Radzę, żebyś w pierwszej kolejności przygotował swoje siły do wymarszu, przenosząc oddziały z garnizonu w szeregi drużyny. Następnie możesz przenieść przedmioty ze skarbca do ekwipunku drużyny.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Wskazówka Wiedźmiej Wieży", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Milordzie! Z Wiedźmiej Wieży dochodzą straszne krzyki! Z pewnością torturuje się tam jakieś nieszczęsne dusze! Naszym obowiązkiem jest im pomóc!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Plądr. Wiedźmią Wieżę", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Isuel \n\"Dziękuję za uwolnienie mnie. Myślałem już, że nigdy to nie nastąpi. Dzięki. Pozwólcie, że rozniosę po świecie słowo o chwale Imperium ustawiając rózgi wszędzie, gdzie mi rozkażecie.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Możemy rozkazać archaniołowi, aby przeleciał nad krainą i ustawiał rózgi obok zasobów, oznaczając je jako naszą własność. W ten sposób możemy zbierać złoto i manę bez konieczności posiadania w ich pobliżu miasta.\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0029", "ID_STRING": "NAME_TXT", "TEXT": "Chłop", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Wskazówka3- Imperium Goblinów", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Gobliny \n\"Hej! A kysz! To nasz wyjątkowy skarb. Nie damy go wam! Złościcie nas!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Broń wioski", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Wieśniacy \n\"Ratuj się kto może!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Wskazówka4- Wodna Wyprawa", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Dla wodzów niepotrafiących latać przeprawa przez wodę jest długa i niebezpieczna, milordzie.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Wskazówka4- Wodna Wyprawa2", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Dla wodzów niepotrafiących latać przeprawa przez wodę jest długa i niebezpieczna, milordzie.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Cmentarz", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Hiena cmentarna \n\"Zapraszamy na nasz cmentarz...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Mana kamieni runicznych", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Milordzie, przed nami znajduje się źródło many pod postacią runicznego kamienia! Powinniśmy wysłać archanioła, żeby zatknął przy nim rózgę!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0032", "ID_STRING": "NAME_TXT", "TEXT": "Zbir", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Dzień 4 wskazówka", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Milordzie, nasi zwiadowcy donoszą, że na północy znajduje się niewielka osada. Może powinniśmy ją zbadać i przy okazji rozszerzyć nasze wpływy.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0037", "ID_STRING": "NAME_TXT", "TEXT": "Zbir", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Imperium uzdrowienie", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Imperium komunikat uzdrowienia", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Posąg \n\"Błogosławieni są ci, którzy biją się za Wszechojca... Jeśli jesteś ranny, zostaniesz uleczony teraz i za każdym razem, gdy wrócisz w to miejsce\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Wywołanie goblina", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0046", "ID_STRING": "NAME_TXT", "TEXT": "Goblin", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0024", "ID_STRING": "NAME_TXT", "TEXT": "Przejście zbira", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0024", "ID_STRING": "POPUP_TXT", "TEXT": "Zbir \n\"Ominięcie mnie będzie was drogo kosztować!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN004b", "ID_STRING": "NAME_TXT", "TEXT": "Wódz zbirów", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Nepheris", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "\"Aby zwiększyć zdolności obronne tego miasta, musisz je rozbudować. Kiedy miasto rozrasta się do następnego poziomu, wzrasta też ilość wojska, którym można je obsadzić. Ponadto zwiększy się premia do obrony dla oddziałów stacjonujących w obrębie murów.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN004d", "ID_STRING": "NAME_TXT", "TEXT": "Wódz zbirów", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Fort Davon", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV002a", "ID_STRING": "POPUP_TXT", "TEXT": "Wieśniacy \n\"Możecie nam odebrać ziemię, ale i tak w końcu dosięgnie was nasza zemsta!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN004f", "ID_STRING": "NAME_TXT", "TEXT": "Włócznik", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Ostrzeżenie orków", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV002c", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Strzeżmy się, milordzie. Orkowie są bardzo agresywni i straszni w boju! Mogą nas zaatakować bez powodu.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV002d", "ID_STRING": "NAME_TXT", "TEXT": "Kryjówka Zielonoskórych", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"To fort Zielonoskórych, milordzie. Zazwyczaj w takich miejscach gromadzą sporo zrabowanego wędrowcom złota. Ale potrafią go też dobrze bronić...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0052", "ID_STRING": "NAME_TXT", "TEXT": "Wódz zbirów", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0030", "ID_STRING": "NAME_TXT", "TEXT": "Dzień przybycia goblinów", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0030", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Wielu goblinów przybywa tu z Północnych Ziem, aby handlować. Jeśli nie będziemy ostrożni, mogą nas zaatakować!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0032", "ID_STRING": "NAME_TXT", "TEXT": "Mana życia", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0032", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Milordzie, ten dziwny kryształ przed nami to mana życia, źródło magicznej mocy!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0032", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Aby uzyskać dostęp do źródeł zasobów, takich jak kopalnia złota lub kryształ many, trzeba posłać tam Archanioła, aby obok umieścił w ziemi rózgę.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0033", "ID_STRING": "NAME_TXT", "TEXT": "Górski olbrzym", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0033", "ID_STRING": "POPUP_TXT", "TEXT": "Górski olbrzym\n\"Czego chcesz? Ja decyduję, kto może tu ćwiczyć, a ty nie wyglądasz odpowiednio! Ha!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0035", "ID_STRING": "NAME_TXT", "TEXT": "Wskazówka eliksirów", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0035", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Jeśli w czasie bitwy ktoś zostanie zraniony, można go uleczyć za pomocą uzdrawiającego eliksiru lub wskrzesić za pomocą eliksiru życia. Jeśli w stolicy wybudowana zostanie świątynia, jednostki można będzie leczyć i wskrzeszać w miastach.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0036", "ID_STRING": "NAME_TXT", "TEXT": "Wskazówka czarów", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0036", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Milordzie, gdy zbierzemy wystarczającą ilość many, będziemy mogli rzucać czary, które pomogą nam i utrudnią działanie nieprzyjacielowi. Żeby tak uczynić, musimy postawić magiczną wieżę, jeśli jeszcze jej nie posiadamy.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0036", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Nowe czary można opracowywać w stolicy, ale dopiero po zebraniu odpowiedniej ilości many.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0037", "ID_STRING": "NAME_TXT", "TEXT": "Wskazówka ulepszenia", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0037", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Po zebraniu wystarczającej ilości doświadczenia, nasze jednostki bojowe mogą zyskać większe znaczenie. Żeby jednak ich umiejętności mogły się zwiększać, należy wznieść odpowiednią budowlę w stolicy.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0038", "ID_STRING": "NAME_TXT", "TEXT": "Wskazówka na temat artefaktu", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0038", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Milordzie, powinniśmy rozglądać się za skrzyniami, w których możemy znaleźć magiczne lub wartościowe przedmioty. Zdaje się, że właśnie na taką natrafiliśmy!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0039", "ID_STRING": "NAME_TXT", "TEXT": "Wył. ulepszenie", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003a", "ID_STRING": "NAME_TXT", "TEXT": "Wskazówka werbowania", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003a", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Milordzie, chociaż straciliśmy wielkiego wodza, nie powinno nas to trapić. Możemy za odpowiednią sumę zwerbować nowego w stolicy.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003b", "ID_STRING": "NAME_TXT", "TEXT": "Skarb goblinów 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003b", "ID_STRING": "POPUP_TXT", "TEXT": "Goblin \n\"Hej! Hej! Wynocha od naszego skarbu! Won!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003c", "ID_STRING": "NAME_TXT", "TEXT": "Wskazówka kupca", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003c", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Przed nami faktoria kupiecka. Możemy do niej wejść, jeśli potrzebujemy zaopatrzenia, eliksirów uzdrawiających i temu podobnych rzeczy.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003d", "ID_STRING": "NAME_TXT", "TEXT": "Witaj kanclerzu", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003d", "ID_STRING": "POPUP_TXT", "TEXT": "Kanclerz Clovis \n\"Witajcie. Jestem kanclerzem Clovis, a moim zadaniem jest nauczenie was taktyk walki. Nie mogę poświęcić wam wiele czasu, bowiem muszę gnać do nadgranicznych miast. Powiem wam jednak, ile zdążę.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003d", "ID_STRING": "POPUP_TXT", "TEXT": "Kanclerz Clovis \n\"Jednostki rażące na odległość, takie jak łucznik, uczeń i akolita, powinny być rozstawiane w tylnym rzędzie, gdzie będą chronione przez mocniejszych żołnierzy zdolnych do bezpośredniego starcia, takich jak giermek lub rycerz pegazów.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003d", "ID_STRING": "POPUP_TXT", "TEXT": "Kanclerz Clovis \n\"Pamiętaj: niektóre jednostki potrafią walczyć tylko wręcz - umieść je w pierwszym szeregu. Inne mogą razić na odległość, ale z reguły są słabsze, więc ustaw je w tylnym rzędzie. Wyprawiaj się ze stolicy tylko z kompletną drużyną!", "SEQ_NUM": 2},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003d", "ID_STRING": "POPUP_TXT", "TEXT": "Kanclerz Clovis \n\"I jeszcze jedno: żeby uaktywnić obiekty, takie jak wodzowie lub stolica, po prostu kliknij je dwa razy. Aby uzyskać informacje o obiekcie, kliknij go prawym przyciskiem.\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003e", "ID_STRING": "NAME_TXT", "TEXT": "Żegnaj kanclerzu", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003f", "ID_STRING": "NAME_TXT", "TEXT": "Walcz z chłopami", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV003f", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Zbliża się zbuntowane chłopstwo. Będą próbowali oblegać stolicę! Musimy ich powstrzymać w imię Wszechojca. Pamiętajmy o radach kanclerza!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0041", "ID_STRING": "NAME_TXT", "TEXT": "Kopalnia złota", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0041", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"To kopalnia złota, milordzie. Mamy już nad nią kontrolę.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0043", "ID_STRING": "NAME_TXT", "TEXT": "Zwycięstwo", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0043", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Zbuntowane chłopstwo zostało zmuszone do poddania się! Imperium włada tym krajem!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253UN0067", "ID_STRING": "NAME_TXT", "TEXT": "Goblin", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0045", "ID_STRING": "NAME_TXT", "TEXT": "Wskazówka obozu ćwiczebnego", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0045", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Milordzie, przed nami znajduje się obóz ćwiczebny. Za odpowiednią opłatą możemy wyćwiczyć w nim naszych żołnierzy; zyskają oni doświadczenie równe temu, które zdobywają w bitwie.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0046", "ID_STRING": "NAME_TXT", "TEXT": "Wskazówka wieży maga", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0046", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"To wieża maga, milordzie. Płacąc złotem, możemy kupić od maga nowe czary.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0047", "ID_STRING": "NAME_TXT", "TEXT": "Spotkanie orków", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0047", "ID_STRING": "POPUP_TXT", "TEXT": "Ork \n\"Czego tu? Nie ma tu nic dla was, ludzie Imperium... Tu są tylko brudasy demony! A teraz wynocha! I trzymajcie się z daleka od mojego kochanego skarbu!", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0048", "ID_STRING": "NAME_TXT", "TEXT": "Mana piekielna", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0048", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Przed nami unosi się z ziemi piekielna mana. Możemy ją zbierać, umieszczając obok niej rózgę.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV0049", "ID_STRING": "NAME_TXT", "TEXT": "Imperium uzdrowienie wł.", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV004a", "ID_STRING": "NAME_TXT", "TEXT": "Usuń góry", "SEQ_NUM": 0},
    {"NO_SCEN": "S253SC0000", "ID_OBJECT": "S253EV004a", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Milordzie! Otworzyliśmy sekretne, magiczne przejście!\"", "SEQ_NUM": 0},
