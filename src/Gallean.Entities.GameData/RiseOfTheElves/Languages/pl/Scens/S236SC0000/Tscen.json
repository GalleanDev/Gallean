    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Imp. Uzdrawiający Posąg", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Imp. zwycięstwo", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Legiony Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Wieści ze Śródkraju, panie. Niewierne niespętane demony nadciągają w tę stronę. Nieumarłym udało się wyprzeć ich ze Śródkraju i teraz szukają schronienia na naszym terytorium.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Najwyraźniej nie zdają sobie sprawy, że MY zamieszkujemy te ziemie. Szczerze pożałują tego najścia...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Co więcej, nasi szpiedzy na Północnych Ziemiach odnaleźli Zwój Wotana, panie. Musimy wysłać zwiadowcę, który odbierze go elfom oraz rozesłać kolejnych szpiegów w poszukiwaniu Zniszczonego Runu.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Intro nieumarłych", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Panie, udało się nam wyprzeć niespętane demony z naszych ziem. Wycofały się na zachód, w stronę terytorium Legionów. Jednakże ludzie nie ustają w swoich mizernych atakach.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Powinniśmy też pamiętać, że smoki są w posiadaniu Zniszczonego Runu. Musimy znaleźć sposób na jej odzyskanie, a także odnaleźć Zwój Wotana. Wtedy zyskamy pełną kontrolę nad tą krainą.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Aragonię", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Aragonię", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Elfy \n\"Elfy nigdy nie pozwolą, by ktoś w ten sposób pustoszył ich ziemie. Możecie być tego pewni!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Lok. pustelnik", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Pustelnik \n\"Trzymajcie się z daleka. Nie dostaniecie tego! Ostrzegam, ani kroku!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0008", "ID_STRING": "NAME_TXT", "TEXT": "GK bunt krasnoludów", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Milordzie! Zdaje się, że górnicy odmawiają pracy! Mówią, że nie będą nam już służyć. Musimy zaatakować tych wiarołomców. Dyscyplina to jedyny język, jaki rozumieją!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0009", "ID_STRING": "NAME_TXT", "TEXT": "GK Uzdrawiający Posąg", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Lok. wschodni smok", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Smoki \n\"Odejdźcie, pókiście żywi, bowiem jest to Domena Smoków i intruzi zostaną żywcem pożarci!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Lok. zachodni smok", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Smoki \n\"Trzymajcie się z daleka, intruzi, jeśli wam życie miłe. To Domena Smoków i nie tolerujemy tutaj obcych!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Złodziejski Dwór.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Złodzieje \n\"Może się wam wydawać, że nas powstrzymaliście, ale my jesteśmy wszędzie... Przybywamy, gdy najmniej się nas spodziewają...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Zgliszcza", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Herszt zbirów \n\"Nie myślcie, że widzimy się po raz ostatni. Każdy złodziej w tym kraju będzie was ścigał swoją zemstą, aż do waszego gorzkiego końca...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Run", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Wreszcie zdobyliśmy Zniszczony Run. Musimy teraz odnaleźć legendarny zwój!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Zwój", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Zwój jest nasz. Teraz musimy szukać Runów.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Imp. lok. orkowie", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Zdaje się, że przed nami obozem rozłożyła się banda orków. Powinniśmy uważać, zdają się być agresywni.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Imp. plądr. Podupadłą Wieżę", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Złodzieje zostawili tu mapę, milordzie... Wygląda na to, że na południu jest więcej złodziejskich osiedli.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Timmorię.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Obrońcy wiary \n\"Niewierni... Nie unikniecie śmierci, kiedy smoki uwolnią moc Runu!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Lok. wyznawcy", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Szaleni wyznawcy palą nasze miasta... Trzeba zająć się nimi natychmiast.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Plądr. zrujnowaną wieżę więz.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"W tej wieży więziono heretyków i obłąkanych... Na ścianie są powypisywane krwią dziwne, runiczne znaki...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Zdobądź Khu'brah", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Pierwotne olbrzymy \n\"Arghhh!!! Wy do nas przyleźć? My was zjeść!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Lok. elfy", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"W okolicy dostrzeżono elfy. Z pewnością obserwują każdy nasz ruch\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Lok. Obrońcy wiary", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Obrońcy wiary\n\"Stójcie, niewierni! Poddajcie się nam, a poprowadzimy was ścieżką prawdy!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Lok. pierwotny olbrzym", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Pierwotne olbrzymy \n\"Arrrgh!, podejść bliżej, wy być teraz jedzenie!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Lok. niewierny", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Niewierny \n\"Wyruszyłem w podróż, aby raz jeszcze odnaleźć moją wiarę, lecz nie znalazłem nic. Teraz poszukuję tylko strawy i schronienia... Przyjmij mnie na służbę, a nie pożałujesz tej decyzji...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Imp. Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Tę okolicę zamieszkuje wielu ludzi nieuznających zwierzchnictwa Wszechojca, milordzie. Łączą się z bandami zwykłych zbirów i napadają na nasze oddziały.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Schwytany człowiek wyjawił nam na torturach, że Run, którego szukamy, może być w posiadaniu elfów mieszkających na północnym wschodzie. Powinniśmy natychmiast wysłać tam oddział i zdobyć run.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001d", "ID_STRING": "NAME_TXT", "TEXT": "GK Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Milordzie, pustelnicy zamieszkujący te obszary porozumieli się z olbrzymami z północy i wspólnie planują atak na nasze ziemie. Powinniśmy uporać się z nimi tak szybko, jak to możliwe!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Doradca \n\"Kilku kupców twierdzi, że Run, którego szukamy, znajduje się w posiadaniu wielkich smoków. Obawiam się, że będziemy zmuszeni odebrać go siłą...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Zwycięstwo nieumarłych", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV001f", "ID_STRING": "NAME_TXT", "TEXT": "GK zwycięstwo", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Legiony zwycięstwo", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Obóz ćwiczebny Draco", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Tutaj szkolili się wszyscy sławni Smoczy Wojownicy!", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Chrulena", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Myślę, że się dogadamy...", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Magiczny Sklepik Leifa", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Jeśli potrzeba ci magicznej ochrony, trafiłeś w dobre miejsce.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Thurina", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Moje towary są najlepsze w całym królestwie.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0004", "ID_STRING": "TXT_TITLE", "TEXT": "Obóz Dennara", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0004", "ID_STRING": "TXT_DESC", "TEXT": "Za określoną cenę wstąpimy w wasze szeregi.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0005", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Thurina", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0005", "ID_STRING": "TXT_DESC", "TEXT": "Czym mogę służyć, przybyszu?", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0006", "ID_STRING": "TXT_TITLE", "TEXT": "Sanktuarium Lei", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0006", "ID_STRING": "TXT_DESC", "TEXT": "Specjalizuję się w czarach przywołujących.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0007", "ID_STRING": "TXT_TITLE", "TEXT": "Sklep Furrena", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0007", "ID_STRING": "TXT_DESC", "TEXT": "Przyjrzyj się moim towarom. Może znajdziesz wśród nich coś interesującego.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0008", "ID_STRING": "TXT_TITLE", "TEXT": "Tawerna Laetes", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236SI0008", "ID_STRING": "TXT_DESC", "TEXT": "Piwo i inne niezbędne towary za rozsądną cenę.", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236LO0000", "ID_STRING": "NAME_TXT", "TEXT": "Uzdrawiający posąg", "SEQ_NUM": 0},
