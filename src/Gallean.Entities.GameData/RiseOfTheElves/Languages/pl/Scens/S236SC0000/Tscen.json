    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236LO0005", "ID_STRING": "NAME_TXT", "TEXT": "GK Uzdrawiający Posąg", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236LO0006", "ID_STRING": "NAME_TXT", "TEXT": "Położenie orków", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236LO0007", "ID_STRING": "NAME_TXT", "TEXT": "Płonące miasto - wyznawcy", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236LO0008", "ID_STRING": "NAME_TXT", "TEXT": "Pozycja smoka", "SEQ_NUM": 0},
    {"NO_SCEN": "S236SC0000", "ID_OBJECT": "S236LO0009", "ID_STRING": "NAME_TXT", "TEXT": "Lokacja elfów", "SEQ_NUM": 0},
