      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0017",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar T30",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0017",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar el Viajero\n\u0022\u00A1Philip d\u0027Agincourt os ha atrapado, mi Se\u00F1or! Todo era un truco, \u00A1cuidado!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN003a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Kraken",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0018",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Uther muere",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0018",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Cl\u00E9rigo\n\u0022\u00BFQu\u00E9 hemos hecho? \u00A1Uther, el hijo del emperador, ha muerto! \u00A1Ahora, el imperio est\u00E1 condenado!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0019",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Area de Fhindar",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0019",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Uther\n\u0022\u00A1He venido en nombre de mi padre! Soy Uther, el heredero de Nevendaar. \u00A1Un\u00EDos a m\u00ED en la batalla contra los enemigos del Imperio! \u00A1Limpiar\u00E9 el reino de los de tu sucia clase, de Lalye! Prep\u00E1rate a morir...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0019",
      "ID_STRING": "OBJECT_TXT",
      "TEXT": "Destruir a Hubert de Lalye. Uther no debe morir.",
      "SEQ_NUM": 0
    },
