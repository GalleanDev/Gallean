    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0051", "ID_STRING": "POPUP_TXT", "TEXT": "Devoto del culto imío\n\"¡Nadie sobrevivirá! Porque nadie puede derrotar a Scyon. ¡Preparaos para morir!\"", "SEQ_NUM": 0},
