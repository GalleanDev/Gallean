    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV004f", "ID_STRING": "POPUP_TXT", "TEXT": "Devoto del culto imío\n\"¡Criaturas sin vida, vuestra presencia en nuestras ciudades es intolerable! ¡Pronto saborearéis un eterno sufrimiento!\"", "SEQ_NUM": 1},
