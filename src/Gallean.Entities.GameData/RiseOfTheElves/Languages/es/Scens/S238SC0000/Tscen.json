    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV002e", "ID_STRING": "POPUP_TXT", "TEXT": "Gilgam el nómada\n\"El culto impío planea atacarnos... ¡debemos estar preparados!\"", "SEQ_NUM": 0},
