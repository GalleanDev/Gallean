    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' Lyr \n\"El culto impío planea atacarnos... ¡debemos estar preparados! Quieren vengarse por el estado de Ashgan.\"", "SEQ_NUM": 0},
