    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Tempest Attack", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Winning Event", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Davon Fort", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Bandido líder\n\"Hemos evacuado la ciudad... ¡Pero ya estamos buscando nuevas conquistas!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Avonia Message A", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Cazador de brujas de Avonia \n\"¡Tú! ¡La última vez que vimos a tu raza, hubo guerra!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Avonia Message B", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Cazador de brujas de Avonia \n\"¡Los orcos se han hecho con las tierras bajas!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Avonia Message C", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Cazador de brujas de Avonia \n\"¡Los orcos se han hecho con la región montañosa gracias a la ayuda de un forastero!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Aragonia Message", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Ciudadano de Aragonia \n\"Hace mucho tiempo, el Imperio intentó establecerse en esta región... Por dos veces fracasaron. ¡Sabemos que la primera colonia intentó regresar a su tierra, pero se les consideró rebeldes y fueron ejecutados por su gente!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Edras", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Escudero \n\"Al principio vinimos aquí para extraer las riquezas de esta tierra. Antes de la llegada de los forasteros reinaba la paz; fue entonces cuando, cansados de nuestra propia gente, decidimos que sería aquí donde nos estableceríamos.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Winning Event 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Winning Event 3", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Forest Keep Text", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000b", "ID_STRING": "POPUP_TXT", "TEXT": " \n\"Una tribu violenta de las cercanías vive bajo el liderazgo de un forastero... Sabemos poco de este misterioso líder, y nadie que hayamos enviado a investigar ha regresado jamás.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Spear man says leave", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Lancero  \n\"¡He reclamado este territorio, intruso! ¡Vete ahora... Y vive entre los lobos y las arañas!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Avonia Says Leave", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Cazador de brujas de Avonia \n\"¡Nunca entrarás en nuestra ciudad! ¡Y si lo intentas, te enfrentarás a una terrible batalla!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Mountain Clans Day One", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Bragon el fuerte \n\"Hace mucho tiempo, el Imperio intentó establecer una colonia aquí. Los colonos se fueron, contra la voluntad del imperio, y nunca regresaron... Y la segunda colonia que enviaron también se esfumó.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0010", "ID_STRING": "NAME_TXT", "TEXT": "MClans Day Ten", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Gigante de las colinas \n\"Hay algo familiar aquí - no sé de qué se trata... Alguien, o algo, en este territorio, me resulta muy familiar.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Legions Day One", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Beliarh \n\"Hay huesos humanos por todo el territorio; el Imperio ha debido de andar por aquí hace tiempo... Pero ahora no hay ni rastro de sus fuerzas; ¡sólo quedan sus huesos para dar testimonio de su fracaso!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Legions Day 12", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Baronesa \n\"Los huesos de las fuerzas del Imperio están por todas partes... La leyenda habla de una tribu y su líder forastero que actúan como protectores de esta región. ¡Sospecho que el Imperio se los encontró y que sus huesos dan fe su de destino!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Undead Message", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Esqueleto \n\"Señor, hay esqueletos dispuestos para marcar el territorio, quemados por los relámpagos. Fuerzas poderosas protegen esta región, aunque estos misteriosos protectores se inclinarán ante las hordas de los no muertos.", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Undead Fourteen", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Fantasma \n\"Siento la presencia de espíritus perturbados... Fueron ejecutados por su propia gente - fuerzas del Imperio. ¡Nos quieren avisar de otros, que aún permanecen! ¡Un forastero con el poder de domar el relámpago vaga por estas tierras!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Barbarian Message", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Guerrero bárbaro \n\"¡Aquel que domina a los elementos desea que os vayáis! - ¡Retiraos, o sed destruidos!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Loc leave our land", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Guerrero bárbaro \n\"¡Dejad nuestra tierra para siempre! Si no os vais por las buenas, os iréis por las malas... ¡Mi maestro controla las fuerzas del relámpago, y tiene el poder de golpearte con él! Suponiendo, claro, que no te derrote yo primero...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Mclans Day 1b", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "\"¡La torre de la montaña ha sido tomada por los orcos! Un par de botas mágicas, que nos fueron de utilidad en el pasado, están ocultas en lo alto de la misma. No sabemos con qué oposición te encontrarás en caso de que intentes recuperar las botas.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Mercader", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0000", "ID_STRING": "TXT_DESC", "TEXT": "¿En qué puedo ayudarte, extranjero?", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Mercader", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Mis mercancías son las mejores del reino.", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Campo mercenario", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Mis mercenarios se unirán a ti... por un precio.", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Campo mercenario", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Mis Bersérker han sido entrenados para obedecer.", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0004", "ID_STRING": "TXT_TITLE", "TEXT": "Torre de mago", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0004", "ID_STRING": "TXT_DESC", "TEXT": "Mis hechizos son los más potentes del reino.", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0005", "ID_STRING": "TXT_TITLE", "TEXT": "Campamento militar", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0005", "ID_STRING": "TXT_DESC", "TEXT": "Yo te entrenaré... Por un precio.", "SEQ_NUM": 0},
