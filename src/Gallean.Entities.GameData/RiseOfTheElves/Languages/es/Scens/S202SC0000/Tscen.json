    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202MM0098", "ID_STRING": "DESC_TXT", "TEXT": "Undead Habitation", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Edwin", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Zaorish", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN0006", "ID_STRING": "NAME_TXT", "TEXT": "Araña roja gigante", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN0008", "ID_STRING": "NAME_TXT", "TEXT": "Araña gigante", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN000f", "ID_STRING": "NAME_TXT", "TEXT": "Segeric", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN0015", "ID_STRING": "NAME_TXT", "TEXT": "Demonio", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN001a", "ID_STRING": "NAME_TXT", "TEXT": "Dragón verde", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN001b", "ID_STRING": "NAME_TXT", "TEXT": "Unfegra", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN0020", "ID_STRING": "NAME_TXT", "TEXT": "Nigosh", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Win Empire", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Clérigo \n\"Hemos restablecido el orden en estas islas. A pesar de lo que hemos perdido, trabajaremos para reconstruir nuestras vidas.\" ", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Win Legions", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Ashkael \n\"Que nuestros enemigos sufran el destino de los tontos - consigamos su condenación.\" \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Emp Day 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Caballero pegaso \n\"¡Los espías han vuelto con noticias asombrosas! ¡Finalmente, hemos encontrado el Cáliz Sagrado de Stagyrias! La ciudad está bajo dominio de los enanos de Anzryft y se encuentra justo al norte de nuestra capital.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Clérigo\n\"Con el debido respeto, mi señor: las islas Maldyn están bajo control de nuestros enemigos. Tu loca ambición de encontrar el cáliz ha comprometido nuestras cruzadas en el pasado.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN0026", "ID_STRING": "NAME_TXT", "TEXT": "Thiffhas", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Emp Cap Stagyrias", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loc Warning", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Escudero \n\"Hay un fétido ambiente en esta cueva. Debemos ir con cuidado; podríamos encontrarnos con cualquier tipo de ser vivo... o no muerto.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loc Islands", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Enano de Anzryft \n\"Estas islas están ahora bajo el dominio de los enanos de Anzryft. ¡Cualquier visitante no invitado será ejecutado sin dilación!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Caballero Pegaso \n\"¡Pobre idiota! ¡Un poco de nieve no nos detendrá! ¡El imperio recuperará lo que es suyo! ¡Stagyrias caerá y el Cáliz Sagrado será mío de nuevo!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Emp Day 10", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Hu'Larsh \n\"Contempla las caras de tus hombres, mujeres y niños, las de aquellos que han muerto. Es un sentimiento perturbador el de la confianza, ¿no?. Escucha los lamentos de las viudas que lloran por sus familias.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Caballero pegaso \n\"Maldito enfermo perverso... ¡Prepárate, criatura despreciable, para ser aniquilado!.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' Larsh \n\"¿Aniquilación? ¡He trascendido la muerte! Si es poder lo que tu corazón desea, ven a buscarme y te libraré de tus debilidades.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Caballero pegaso \n\"Puedes dar por hecho que iremos a buscarte.\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Loc Hu Larsh Trap 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Caballero no muerto \n\"¡Mortis se deleitará con tu desgracia!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Loc Hu Larsh Trap 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Hu'Larsh \n\"Te daré a probar un poco de la gloria eterna de la muerte.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Loc Hu Larsh Trap 3", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Caballero no muerto \n\"Pronto todos os habréis unido a nosotros.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Loc Hu Larsh Trap 4", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Caballero no muerto \n\"Ni te muevas de donde estás.\" \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Caballero no muerto \n\"Así... No sientes el poder de Mortis?\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Emp Day 11", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Escudero \n\"¡Mi señor, estamos confusos! ¿Seguimos buscando el cáliz? ¿Buscamos a Hu'Larsh? ¿Cuál de las dos ciudades hemos de capturar?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Caballero pegaso \n\"El Cáliz Sagrado es prioritario; hemos de hacernos con cualquier posible ventaja: Nuestros enemigos tienen muchos recursos.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Paladín \n\"Las ciudades están ferreamente defendidas, pero hemos de hacernos con ellas. Hu'Larsh es muy poderoso, pero también posee objetos útiles para el Imperio. Sospecho que tendremos que lidiar con ambos asuntos antes o después.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Leg Day 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Duque\n\"El Cáliz Impío está por aquí; puedo sentir su poder corrupto. ¡La ciudad portuaria! ¡Si! ¡El Cáliz debe encontrarse en Puerto Brigham!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN003a", "ID_STRING": "NAME_TXT", "TEXT": "Guardián", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Emp Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Clérigo \n\"...las viudas formaron un círculo y comenzó la ceremonia. La falsa bruja pronto se enfrentó a una verdadera, leal a Bethrezen. La bruja de los desposeidos acabó con su rival.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Clérigo \n\"La bruja de los desposeidos, sin embargo, ocultaba un secreto: no era leal a nuestra gente. ¡De pronto brotó humo de ella y en su lugar apareció una bestia no muerta!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Clérigo \n\"La liche se hace llamar Hu'Larsh. Informó a las viudas de que no debían preocuparse, pues sus familias volverían... Sólo que no como antes, sino como fantasmas, espectros y zombis. ¡La ceremonia sólo era una trampa!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN003b", "ID_STRING": "NAME_TXT", "TEXT": "Guardián", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Leg Day 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Sectario \n\"...las viudas habían hecho un círculo y comenzado el ritual. Una de nuestras brujas se enfrentó a su 'Bruja de los desposeídos' y fue derrotada.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Sectario  \n\"La oí regodearse confesando que la ceremonia era una treta. Acabada la farsa, la impostora se reveló como una liche.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Sectario  \n\"La liche, Hu'Larsh, declaró que las viudas se reunirían con sus familias, pero en la forma de espectros y zombis. Sus seres queridos volverán como criaturas no muertas.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Duque  \n\"¿Por qué me aburres con tus historias? ¡Estamos aquí para destruir, no para contar cuentos! Ni esa chusma no muerta ni los patéticos humanos se interpondrán en mi camino.\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Loot Hu'larsh Castle 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' Larsh \n\"¡Idiotas! ¡Ya he muerto anteriormente! Tomad el anillo maldito; no lo conservareis mucho tiempo: la muerte enviará a sus campeones para vengarme.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN003d", "ID_STRING": "NAME_TXT", "TEXT": "Guardián", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN003f", "ID_STRING": "NAME_TXT", "TEXT": "Gigante de las colinas", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Leg Loc Doragons Alter", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Sectario \n\"Señor, hay un altar dedicado a alguna antigua deidad. Deberíamos tener cuidado.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Duque \n\"¿Cuidado? Tú deberías tener cuidado si supones que me importan tus supersticiones.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Emp Cap Cordyllia", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Aparición \n\"Disfrutad el momento, porque las fuerzas de la oscuridad se reagruparán.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Caballero pegaso \n\"¡Con esta ciudad en nuestro poder estamos muy cerca de la victoria definitiva!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN0041", "ID_STRING": "NAME_TXT", "TEXT": "Guardián", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Leg Cap Cordyllia", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Sectario \n\"Señor, he sabido que el imperio quiere conquistar esta ciudad.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Duque \n\"¡Nuestros enemigos no hoyarán el suelo de este lugar\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Leg Cap Sorugirilla", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Alzado \n\"...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Duque \n\"Entiendo que resulta difícil emitir amenazas sin tu lengua, ¿verdad?\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Emp Cap Sorugirilla", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Escudero \n\"Señor, se extiende el rumor de que las Legiones Demoniacas quieren hacerse con esta ciudad. ¿Qué hacemos?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Caballero pegaso \n\"Ya me gustaría contar con algún sabio consejo, pero todo lo que podemos hacer es luchar contra cualquier cosa que nos manden.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN0044", "ID_STRING": "NAME_TXT", "TEXT": "Lobo", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0022", "ID_STRING": "NAME_TXT", "TEXT": "Leg Cap Polyonolos", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0022", "ID_STRING": "POPUP_TXT", "TEXT": "Brujo \n\"¿Intentas enfurecer a Mortis?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0022", "ID_STRING": "POPUP_TXT", "TEXT": "Duque \n\"¡No, sólo busco tu condenación eterna!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Emp Cap Polyonolos", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0023", "ID_STRING": "POPUP_TXT", "TEXT": "Caballero pegaso \n\"Hoy hemos ganado una batalla, pero nuestra tarea no ha hecho más que empezar. Sospecho que conservar esta ciudad será todo un reto.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Leg Cap Brighams Port", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Duque \n\"¡Al fin! ¡El Cáliz es nuestro! ¡La sangre sabrá más dulce en él!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Emp Day 5", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Escudero \n\"Señor, la gente de este lugar ha sufrido mucho desde las grandes guerras hasta hoy. ¿Podemos olvidarnos ahora del Cáliz Sagrado y ayudar a nuestros hermanos a recuperar su humanidad?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Caballero pegaso \n\"Todos hemos sufrido mucho. Yo he perdido a muchos seres queridos. Pero seguiré adelante; me niego a vivir en la autocompasión. Ayudaremos mejor a esta gente recuperando el Cáliz Sagrado.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Day 15 Once", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV002c", "ID_STRING": "POPUP_TXT", "TEXT": "Espectro \n\"El tiempo de los vivos se ha terminado. Los espíritus de los caídos están sedientos de libertad.\" \n", "SEQ_NUM": 1},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV002e", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Day 15", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN0057", "ID_STRING": "NAME_TXT", "TEXT": "Zombi", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN0058", "ID_STRING": "NAME_TXT", "TEXT": "Zombi", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN005b", "ID_STRING": "NAME_TXT", "TEXT": "Zombi", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN005d", "ID_STRING": "NAME_TXT", "TEXT": "Campesino", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN0066", "ID_STRING": "NAME_TXT", "TEXT": "Escudero", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN006a", "ID_STRING": "NAME_TXT", "TEXT": "Bandido", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN006c", "ID_STRING": "NAME_TXT", "TEXT": "Bandido líder", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN007a", "ID_STRING": "NAME_TXT", "TEXT": "Goblin", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202FT0000", "ID_STRING": "NAME_TXT", "TEXT": "Timoria", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202FT0001", "ID_STRING": "NAME_TXT", "TEXT": "Castillo Gorgon", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202FT0002", "ID_STRING": "NAME_TXT", "TEXT": "Stagyrias", "SEQ_NUM": 0},
