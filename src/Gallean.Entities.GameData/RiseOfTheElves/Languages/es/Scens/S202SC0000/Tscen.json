    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202MM0092", "ID_STRING": "DESC_TXT", "TEXT": "Seaweed", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202MM0093", "ID_STRING": "DESC_TXT", "TEXT": "Impaled Skeleton", "SEQ_NUM": 0},
