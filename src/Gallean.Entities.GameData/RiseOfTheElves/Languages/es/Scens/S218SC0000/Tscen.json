    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Clans Day2", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Clans Day3", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Elves Standing LessThn5", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Iluminado\n\"¡No podemos seguir enviando a nuestros hijos a la tumba! ¡No les entregaremos el bosque sin oponer resistencia!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV001d", "ID_STRING": "OBJECT_TXT", "TEXT": "Los demonios deben llevar a Fareum a los cinco obeliscos situados en territorio élfico.\nLos elfos han sido derrotados.\nLos enanos deben envenenar los pozos de sus dos enemigos.", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Elves Day 4", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Elves Day 6", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Elves Day 8", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Elves Day 12", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Torre de mago", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Los assuntoss de loss mortaless no noss conciernen. ¿Por qué nos disstraess?", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0022", "ID_STRING": "NAME_TXT", "TEXT": "Elves Prog Mure'esh", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0022", "ID_STRING": "POPUP_TXT", "TEXT": "Mure'esh\n\"Yo me quedaré aquí.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Torre de mago", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Tenemos una estrafalaria colección de hechizos para enseñar; seguro que les das buen uso.", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Elves Prog Dereni'il", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0023", "ID_STRING": "POPUP_TXT", "TEXT": "Dereni'il\n\"He logrado llegar indemne.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Campamento militar", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0002", "ID_STRING": "TXT_DESC", "TEXT": "He trabajado con buenos y malos soldados. Y al terminar, todos eran mejores.", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0024", "ID_STRING": "NAME_TXT", "TEXT": "Elves Prog Erenlus", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0024", "ID_STRING": "POPUP_TXT", "TEXT": "Erenlus\n\"No ha sido tan difícil.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Campo mercenario", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Te ofrezco bestias para servirte. Son fieras, pero leales.", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Elves Prog Gremech", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Gremech \n\"Aquí estoy, tal y como me ordenaron.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0004", "ID_STRING": "TXT_TITLE", "TEXT": "Mercader", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0004", "ID_STRING": "TXT_DESC", "TEXT": "Mi especialidad es la joyería, pero hecha un vistazo sin compromiso.", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Elves Prog Sommech", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0026", "ID_STRING": "POPUP_TXT", "TEXT": "Sommech \n\"Aquí es.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0005", "ID_STRING": "TXT_TITLE", "TEXT": "Mercader", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0005", "ID_STRING": "TXT_DESC", "TEXT": "Nos hacemos con muchos objetos de utilidad cuando pasan ejércitos por aquí.", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Elves Prog Pelumnus", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Pelemnus \n\"Hecho.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Elves Prog Osbil", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "Osbil \n\"El altar de los enanos. ¡Debe de ser aquí!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Elves Prog Furennsil", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0029", "ID_STRING": "POPUP_TXT", "TEXT": "Furennsil \n\"¡Lo he conseguido!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Elves Prog Belenesh", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV002a", "ID_STRING": "POPUP_TXT", "TEXT": "Belenesh \n\"Yo esperaré aquí.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV002b", "ID_STRING": "NAME_TXT", "TEXT": "Elves Win Ruin", "SEQ_NUM": 0},
