    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0012",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Asteroth \n\u0022\u00A1Ghhhooarrr! \u00A1Sois afortunados por haber escapado de mi ira, demonios! Pero no puedo ser destruido...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0012",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Demon\u00F3logo\n\u0022\u00A1Asteroth ha desaparecido en una llamarada! \u00A1Ha escapado! Pero hemos triunfado...\u0022",
