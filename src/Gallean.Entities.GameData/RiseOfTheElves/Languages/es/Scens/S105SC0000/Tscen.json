      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Diablo abisal\n\u0022Demonios sirvientes... \u00A1ya no os necesitamos!!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Diablo abisal\n\u0022\u00A1Obedecemos a nuestro verdadero amo Bethrezen! \u00C9l os har\u00E1 pagar por vuestra traici\u00F3n...\u0022",
      "SEQ_NUM": 4
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0006",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Texto de la ciudad de Gromdam",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0006",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Tirador\n\u0022\u00BFNo sab\u00E9is cu\u00E1ndo abandonar, demonios? \u00A1Uther gobierna estas tierras y tendr\u00E9is que apartaros!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0007",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Texto de la ciudad de Rottudam",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0007",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Caballero\n\u0022\u00A1Atr\u00E1s, demonios! Esperamos a nuestro salvador, Uther... \u00A1Cuando llegue, os haremos pagar por vuestros pecados!\u0022",
