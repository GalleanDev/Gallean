    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0015",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Orco \n\u0022Traer orco aqu\u00ED... Nosotros dar algo a ti...\u0022",
