    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0010",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Asteroth \n\u0022Otro error mortal... \u00A1Yo mismo te destruir\u00E9! El reinado de Bethrezen es historia...\u0022",
