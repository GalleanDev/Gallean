    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV000d",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Consejero\n\u0022Sed precavido, amo... Estos mares est\u00E1n controlados por brujas marinas. Capturan a cualquiera que entre en su reino.\u0022",
      "SEQ_NUM": 0
