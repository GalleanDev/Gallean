    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0014",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Asteroth \n\u0022\u00A1Cobardes! Os destruir\u00E9 yo mismo... \u00A1Os arrepentir\u00E9is de vuestros traicioneros actos!\u0022",
