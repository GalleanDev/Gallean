    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0015",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Orco \n\u0022Pieles caliente... Nosotros ayudar... Hermano orco perdido... \u00BFT\u00FA ayudar?\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0015",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Duque \n\u0022\u00BFQu\u00E9 necesitas de nosotros?\u0022",
