    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140SI0000",
      "ID_STRING": "TXT_TITLE",
      "TEXT": "Mercader",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140SI0000",
      "ID_STRING": "TXT_DESC",
      "TEXT": "Vendo los mejores art\u00EDculos del Reino.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140SI0002",
      "ID_STRING": "TXT_TITLE",
      "TEXT": "Campo mercenario",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140SI0002",
      "ID_STRING": "TXT_DESC",
      "TEXT": "Los mejores guerreros a un precio de risa. \u00A1No se admiten devoluciones!",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140PL0000",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Neutrales",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140PL0000",
      "ID_STRING": "DESC_TXT",
      "TEXT": "Ninguna descripci\u00F3n de raza",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140PL0001",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Isuel",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140PL0001",
      "ID_STRING": "DESC_TXT",
      "TEXT": "En su juventud, esta poderosa se\u00F1ora de la guerra derrot\u00F3 a un ej\u00E9rcito de demonios y logr\u00F3 sellar el portal infernal del que proced\u00EDan. Poco despu\u00E9s, se alz\u00F3 con el poder en su regi\u00F3n.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140PL0002",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Cillen",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140PL0002",
      "ID_STRING": "DESC_TXT",
      "TEXT": "Una veterana guerrera de la causa \u00E9lfica; nadie puede entrar en el bosque sin su permiso.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140UN0000",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140UN0001",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Virgile",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140UN000c",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140UN000d",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140UN000e",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140UN000f",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
