    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140EV001a",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Serphis\n\u0022Hemos perdido el control de la regi\u00F3n. Nuestra misi\u00F3n ha fracasado.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140UN003d",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Sirena",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140EV001b",
      "ID_STRING": "NAME_TXT",
      "TEXT": "ENC - TENDER MEET",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140EV001b",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "\u0022\u00A1Es el l\u00EDder de la flota imperial! Si acabamos con \u00E9l, el Imperio no tardar\u00E1 en perder el control de la zona!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140EV001b",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "L\u00EDder de la flota\n\u0022\u00BFDe verdad cr\u00E9eis que pod\u00E9is acabar con nuestras rutas comerciales? \u00A1No ten\u00E9is nada que hacer! \u00A1Los elfos no saben nada del mar!\u0022",
      "SEQ_NUM": 1
