    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Curandera\n\"¡Los responsables de este robo pagarán por ello! ¡Cuidado! ¡Llegan más bárbaros!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221UN0034", "ID_STRING": "NAME_TXT", "TEXT": "Sectario", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Elves Day 1 ", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Arconte elfo\n\"Los elfos Grystrom deben unirse a la alianza, pero me temo que desconfían de nosotros. Sólo hay una forma de convencerles: ¡debemos encontrar la reliquia y devolverla a la fuente mágica!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Elf Threaten ", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Segador\n\"¡Los hijos de Gallean volveréis a sufrir! Llevamos una eternidad torturando a los elfos... ¡y esta alianza correrá la misma suerte!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221UN0036", "ID_STRING": "NAME_TXT", "TEXT": "Sectario", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Demon Is Coming ", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Demonio\n\"¡Esa maravillosa reliquia pronto será para mí! ¡Y el reino de Grystrom arderá!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Undead Day 1 ", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Caballero No Muerto\n\"¡La reliquia tiene que ser nuestra! ¡Pronto su poder será nuestro! Si veis algún elfo, ¡hacedle sufrir! ¡Su alianza será un fracaso!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221UN0038", "ID_STRING": "NAME_TXT", "TEXT": "Sectario", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Undead Threat ", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Arconte elfo\n\"La Alianza Élfica acabará contigo, miserable criatura. Todavía no hemos olvidado cómo los No muertos torturaron a los nuestros. ¡Por el poder de Gallean, Mortis y sus acólitos serán derrotados!\" \n \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Undead Healing Message ", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "\"¡La magia de la fuente está fuera de control! En esta zona podrán sanarse los heridos. Puede que haya otras zonas cuya magia podamos explotar... Ahora, ¡encontremos esa reliquia y conquistemos estas tierras en nombre de Mortis!", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Elves Healing Message ", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "\"Esto será cosa de la fuente. Hay mucho poder en este reino; aquí podrán recuperarse los heridos y necesitados. Pero debemos emplear esta magia con sabiduría. Estad atentos: puede haber otras zonas mágicas. ¡Por la Alianza!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Legions Message ", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Duque\n\"¡Es inútil, no nos detendremos jamás! ¡La reliquia será nuestra!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Citymessage Grysborg", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Adepto\n\"¡Los bárbaros jamás permitirán que os llevéis la reliquia!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221UN003c", "ID_STRING": "NAME_TXT", "TEXT": "Orco", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV001a", "ID_STRING": "NAME_TXT", "TEXT": "city message Asmara ", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Orco\n\"¡Lor orcos jamás olvidan! ¡Por la venganza!", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV001b", "ID_STRING": "NAME_TXT", "TEXT": "city message+grystrent ", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "\"Los bárbaros tienen la reliquia en una torre del Norte. ¡Debemos alcanzarla rápidamente!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221UN003e", "ID_STRING": "NAME_TXT", "TEXT": "Orco", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Shaman_Undead ", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "\"¡La reliquia es mía! ¡Vamos, a la fuente mágica!\"", "SEQ_NUM": 0},
