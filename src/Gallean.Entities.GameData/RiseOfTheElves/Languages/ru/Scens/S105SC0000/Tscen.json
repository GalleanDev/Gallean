  "rows": [
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Нейтральный отряд", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Нет описания расы", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Гоар", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105PL0009", "ID_STRING": "DESC_TXT", "TEXT": "В дни своей юности этот могущественный повелитель выступил против армии ада и в одиночку победил ее, запечатав врата, через которые она вошла в мир. После этого он стал правителем своей страны.", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Асумуэль", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Его именем пугают детей. Этот повелитель ада известен своей кровожадностью. Говорят, однажды он пожрал 1000 рабов на пиру, который Бетрезен устроил в честь победы над королевством света.", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105UN0000", "ID_STRING": "NAME_TXT", "TEXT": null, "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Ардоберт", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105UN0002", "ID_STRING": "NAME_TXT", "TEXT": null, "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Заориш", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105UN0004", "ID_STRING": "NAME_TXT", "TEXT": null, "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105UN0009", "ID_STRING": "NAME_TXT", "TEXT": "Астарот", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105UN000b", "ID_STRING": "NAME_TXT", "TEXT": "Тролль", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105UN000d", "ID_STRING": "NAME_TXT", "TEXT": "Дьявол Преисподней", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105UN000f", "ID_STRING": "NAME_TXT", "TEXT": "Дьявол Преисподней", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105UN0011", "ID_STRING": "NAME_TXT", "TEXT": "Демон", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105UN0013", "ID_STRING": "NAME_TXT", "TEXT": "Последователь культа", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105UN0016", "ID_STRING": "NAME_TXT", "TEXT": "Последователь культа", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105UN0018", "ID_STRING": "NAME_TXT", "TEXT": "Берсерк", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105UN001e", "ID_STRING": "NAME_TXT", "TEXT": "Демон", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105UN0020", "ID_STRING": "NAME_TXT", "TEXT": "Кракен", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105UN0022", "ID_STRING": "NAME_TXT", "TEXT": "Русалка", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Предупреждение о ритуале", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Чародей\r\"Господин! Здесь действуют какое-то странное чародейство... Ритуал вынуждает демонов нападать на нас! Мы должны закрыть адские врата...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105UN0024", "ID_STRING": "NAME_TXT", "TEXT": "Русалка", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0001", "ID_STRING": "NAME_TXT", "TEXT": "T 1 Drama", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Советник \n\"Наши разведчики обыскали в поисках нежити все вокруг... Но их нигде нет.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Бетрезен \n\"То, что на этих землях нет нежити, очевидно.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Советник \n\"Что это значит, повелитель Бетрезен? Разве мы здесь не для того, чтобы устроить на них засаду?!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Утер\n\"Я не Бетрезен...\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Советник \n\"Не Бетрезен?! Но вы ведете себя как Бетрезен...\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Утер \n\"Ты скоро поймешь... Астарот! Уничтожь этих мелких демонов. Они нам больше не понадобятся, не так ли?\"", "SEQ_NUM": 5},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0002", "ID_STRING": "NAME_TXT", "TEXT": "T 1-2 Drama", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Астарот\n\"Да, мы будем править вместе! Они не смогут противостоять нам!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0002", "ID_STRING": "OBJECT_TXT", "TEXT": "Уничтожить повелителя демонов Астарота", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105UN0027", "ID_STRING": "NAME_TXT", "TEXT": "Русалка", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0004", "ID_STRING": "NAME_TXT", "TEXT": "T 1-3 Drama", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Дьявол Преисподней \n\"Младшие демоны! Вы не нужны нам!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Дьявол Преисподней \n\"Мы защищаем Бетрезена, нашего истинного повелителя! Вы заплатите ему за свое предательство...\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0006", "ID_STRING": "NAME_TXT", "TEXT": "City Gromdam Text", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Стрелок \n\"Неужели вы не знаете, что пришла пора остановиться, демоны? Утер будет править миром, а вы останетесь ни с чем!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0007", "ID_STRING": "NAME_TXT", "TEXT": "City Rottudam Text", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Рыцарь \n\"Назад, демоны! Мы ждем нашего спасителя Утера. Когда он прибудет, вы заплатите за свою дерзость!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105UN002a", "ID_STRING": "NAME_TXT", "TEXT": "Ониксовая горгулья", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Demon Spawn", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105UN002c", "ID_STRING": "NAME_TXT", "TEXT": "Демон", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Demon Spawn 15", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Demon Spawn 25", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105UN002e", "ID_STRING": "NAME_TXT", "TEXT": "Ониксовая горгулья", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Уничтожить последователей культа", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Пандемониус \n\"Мы уничтожили круг призывания, господин. Демоны больше не будут появляться здесь.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Уничтожь демонолога", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Пандемониус \n\"Мы уничтожили круг призывания, господин. Демоны больше не будут появляться здесь.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Предупреждение о воде", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Советник \n\"Осторожнее, повелитель... Морские ведьмы повелевают волнами. Они нападают на всех, кто осмелится войти в их царство.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Asteroth T2", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Situation zone", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Герцог \n\"Империя поддержала мятеж Астарота! Они заключили какой-то союз! Кажется, Утер подчинил Империю своим чарам. Можно предположить, что за этим стоит Юбер де Лали...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105UN0032", "ID_STRING": "NAME_TXT", "TEXT": "Последователь культа", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Asteroth Near", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Астарот \n\"Ты совершил еще одну ошибку, смертный... Я уничтожу тебя собственными руками! Время Бетрезена прошло!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105UN0034", "ID_STRING": "NAME_TXT", "TEXT": "Последователь культа", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Onyx Move T15", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Победа", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Астарот \n\"Гррр! Вам повезло! В этот раз вы сумели ускользнуть от моего гнева, демоны! Но меня нельзя уничтожить так просто...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Демонолог \n\"Астарот исчез в огненной вспышке! Он сбежал! И все же мы победили...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105UN0036", "ID_STRING": "NAME_TXT", "TEXT": "Людоед", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Asteroth T40", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Астарот \n\"Трусы! Я уничтожу вас собственными руками... Вы еще пожалеете о своей измене!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Задание орков", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Орк \n\"Демоны... Мы просим помогать... Мы потерять брат-орк... Вы нам помогать?\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Герцог \n\"Что вы хотите от нас?\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Орк \n\"Приведите сюда орк. Мы вам что-то дать...\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105UN0039", "ID_STRING": "NAME_TXT", "TEXT": "Ассасин Империи", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Награда орков", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Орк \n\"ГГГГРРР! Орк...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Орк \n\"Брат здесь! Мы вам помогать. Искать сокровище в большой город...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S105SC0000", "ID_OBJECT": "S105EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Орк \n\"Демоны хорошо. Мы вам помогать...\"", "SEQ_NUM": 4},
