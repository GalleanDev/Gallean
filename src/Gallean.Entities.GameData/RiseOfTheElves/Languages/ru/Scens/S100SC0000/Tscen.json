    {"NO_SCEN": "S100SC0000", "ID_OBJECT": "S100UN0002", "ID_STRING": "NAME_TXT", "TEXT": null, "SEQ_NUM": 0},
    {"NO_SCEN": "S100SC0000", "ID_OBJECT": "S100UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Альдерик", "SEQ_NUM": 0},
