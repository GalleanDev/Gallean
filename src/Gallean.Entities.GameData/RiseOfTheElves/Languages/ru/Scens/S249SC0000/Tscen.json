    {"NO_SCEN": "S249SC0000", "ID_OBJECT": "S249UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Кловис", "SEQ_NUM": 0},
    {"NO_SCEN": "S249SC0000", "ID_OBJECT": "S249UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Трудальф", "SEQ_NUM": 0},
