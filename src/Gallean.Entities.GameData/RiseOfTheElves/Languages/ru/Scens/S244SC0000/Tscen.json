    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244FT0005", "ID_STRING": "NAME_TXT", "TEXT": "Новый Гамор", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244UN008e", "ID_STRING": "NAME_TXT", "TEXT": "Разбойник", "SEQ_NUM": 0},
