    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244FT0001", "ID_STRING": "NAME_TXT", "TEXT": "Королевство Ксеноса", "SEQ_NUM": 0},
    {"NO_SCEN": "S244SC0000", "ID_OBJECT": "S244FT0002", "ID_STRING": "NAME_TXT", "TEXT": "Особое положение", "SEQ_NUM": 0},
