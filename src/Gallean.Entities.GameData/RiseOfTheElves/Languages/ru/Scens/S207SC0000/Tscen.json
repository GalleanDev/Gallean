    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207LO0008", "ID_STRING": "NAME_TXT", "TEXT": "Варвары, сообщение", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207LO0009", "ID_STRING": "NAME_TXT", "TEXT": "Покиньте нашу землю", "SEQ_NUM": 0},
