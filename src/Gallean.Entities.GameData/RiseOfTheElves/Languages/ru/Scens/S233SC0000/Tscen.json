    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Кловис", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Бегрезен", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233UN0005", "ID_STRING": "NAME_TXT", "TEXT": "Зитар", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233UN0007", "ID_STRING": "NAME_TXT", "TEXT": "Эборен", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Нейтралы", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Нет описания расы", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233PL0001", "ID_STRING": "NAME_TXT", "TEXT": "Конрад", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233PL0001", "ID_STRING": "DESC_TXT", "TEXT": "В дни своей юности этот могущественный повелитель выступил против армии ада и в одиночку победил ее, запечатав врата, через которые та вошла в мир. После этого он стал правителем своей страны.", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233PL0002", "ID_STRING": "NAME_TXT", "TEXT": "Загамон", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233PL0002", "ID_STRING": "DESC_TXT", "TEXT": "Ее именем пугают детей. Этот повелитель ада известен своей кровожадностью. Говорят, однажды он пожрал тысячу рабов на пиру, который Бетрезен устроил в честь победы над королевством света.", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233PL0003", "ID_STRING": "NAME_TXT", "TEXT": "Офааль", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233PL0003", "ID_STRING": "DESC_TXT", "TEXT": "В свое время она была самой могущественной из всех адептов темного искусства, пока инквизитор Воргель не убил ее, положив тем самым конец засилью ужаса в ее землях. Теперь она восстала из мертвых и стремится подчинить своей воле всех смертных.", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233PL0004", "ID_STRING": "NAME_TXT", "TEXT": "Элдис", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233PL0004", "ID_STRING": "DESC_TXT", "TEXT": "Этот опытный боец давно сражается за честь эльфов, никому не войти в лес без его ведома.", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233UN002c", "ID_STRING": "NAME_TXT", "TEXT": "Ниулокт", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233UN002f", "ID_STRING": "NAME_TXT", "TEXT": "Синий дракон", "SEQ_NUM": 0},
    {"NO_SCEN": "S233SC0000", "ID_OBJECT": "S233UN0031", "ID_STRING": "NAME_TXT", "TEXT": "Синий дракон", "SEQ_NUM": 0},
