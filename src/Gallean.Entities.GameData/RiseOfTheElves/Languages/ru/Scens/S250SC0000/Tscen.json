    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250PL0001", "ID_STRING": "NAME_TXT", "TEXT": "Конрад", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250PL0001", "ID_STRING": "DESC_TXT", "TEXT": "In his youth, this mighty lord once stood fast against an army from hell and single-handedly defeated them by sealing the gateway that spew them. He then became sovereign of his realm.", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250PL0002", "ID_STRING": "NAME_TXT", "TEXT": "Молдар", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250PL0002", "ID_STRING": "DESC_TXT", "TEXT": "Highest lord of the dwarf lords, he is known for his intensity in battle and his courage in the face of overwhelming odds. He once fought seven days and nights against the mighty red dragon ARFURUZON to finally defeat him.", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250PL0003", "ID_STRING": "NAME_TXT", "TEXT": "Дориан", "SEQ_NUM": 0},
    {"NO_SCEN": "S250SC0000", "ID_OBJECT": "S250PL0003", "ID_STRING": "DESC_TXT", "TEXT": "Every child trembles at the hearing of this most infamous name. This lord of hell is known for her blood thirsts. It is said that she once ate 1000 slaves at a banquet given by Bethrezen for a victory against the kingdom of light.", "SEQ_NUM": 0},
