    {"NO_SCEN": "S119SC0000", "ID_OBJECT": "S119UN0179", "ID_STRING": "NAME_TXT", "TEXT": "Ассасин Империи", "SEQ_NUM": 0},
    {"NO_SCEN": "S119SC0000", "ID_OBJECT": "S119UN017b", "ID_STRING": "NAME_TXT", "TEXT": "Головорез", "SEQ_NUM": 0},
