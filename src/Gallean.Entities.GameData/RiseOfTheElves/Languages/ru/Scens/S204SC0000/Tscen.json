    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204UN01b8", "ID_STRING": "NAME_TXT", "TEXT": "Дракон рока", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204UN01bf", "ID_STRING": "NAME_TXT", "TEXT": "Разбойник", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204UN01c1", "ID_STRING": "NAME_TXT", "TEXT": "Гигантский паук", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204UN01ce", "ID_STRING": "NAME_TXT", "TEXT": "Ассасин Империи", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204UN01de", "ID_STRING": "NAME_TXT", "TEXT": "Копейщик", "SEQ_NUM": 0},
    {"NO_SCEN": "S204SC0000", "ID_OBJECT": "S204UN01eb", "ID_STRING": "NAME_TXT", "TEXT": "Ассасин Империи", "SEQ_NUM": 0},
