    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Добро пожаловать, взгляните на мои товары...", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Рынок Дженбаха", "SEQ_NUM": 0},
    {"NO_SCEN": "S206SC0000", "ID_OBJECT": "S206SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Мы продаем и покупаем за большие деньги, милорд...", "SEQ_NUM": 0},
