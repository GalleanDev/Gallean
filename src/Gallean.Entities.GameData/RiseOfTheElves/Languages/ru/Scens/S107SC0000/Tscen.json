    {"NO_SCEN": "S107SC0000", "ID_OBJECT": "S107SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Башня Ганнера", "SEQ_NUM": 0},
    {"NO_SCEN": "S107SC0000", "ID_OBJECT": "S107SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Я знаю множество чудесных заклинаний.", "SEQ_NUM": 0},
    {"NO_SCEN": "S107SC0000", "ID_OBJECT": "S107SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Лавка Турина", "SEQ_NUM": 0},
    {"NO_SCEN": "S107SC0000", "ID_OBJECT": "S107SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Мой товар пригодится тебе в твоем походе.", "SEQ_NUM": 0},
    {"NO_SCEN": "S107SC0000", "ID_OBJECT": "S107PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Юстин", "SEQ_NUM": 0},
    {"NO_SCEN": "S107SC0000", "ID_OBJECT": "S107PL0000", "ID_STRING": "DESC_TXT", "TEXT": "В дни своей юности этот могущественный повелитель выступил против армии ада и в одиночку победил ее, запечатав врата, через которые она вошла в мир. После этого он стал правителем своей страны.", "SEQ_NUM": 0},
    {"NO_SCEN": "S107SC0000", "ID_OBJECT": "S107PL0001", "ID_STRING": "NAME_TXT", "TEXT": "Идразель", "SEQ_NUM": 0},
    {"NO_SCEN": "S107SC0000", "ID_OBJECT": "S107PL0001", "ID_STRING": "DESC_TXT", "TEXT": "Его именем пугают детей. Этот повелитель ада известен своей кровожадностью. Говорят, однажды он пожрал 1000 рабов на пиру, который Бетрезен устроил в честь победы над королевством света.", "SEQ_NUM": 0},
    {"NO_SCEN": "S107SC0000", "ID_OBJECT": "S107PL0004", "ID_STRING": "NAME_TXT", "TEXT": "Нейтральный игрок", "SEQ_NUM": 0},
