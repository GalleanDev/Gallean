    {"NO_SCEN": "S234SC0000", "ID_OBJECT": "S234UN024a", "ID_STRING": "NAME_TXT", "TEXT": "Гоблин", "SEQ_NUM": 0},
    {"NO_SCEN": "S234SC0000", "ID_OBJECT": "S234UN024d", "ID_STRING": "NAME_TXT", "TEXT": "Гоблин", "SEQ_NUM": 0},
