  "rows": [
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232MM0001", "ID_STRING": "DESC_TXT", "TEXT": "Нейтральное поселение", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232MM0004", "ID_STRING": "DESC_TXT", "TEXT": "Нейтральное поселение", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232MM0005", "ID_STRING": "DESC_TXT", "TEXT": "Нейтральное поселение", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232MM0006", "ID_STRING": "DESC_TXT", "TEXT": "Нейтральное поселение", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232MM0007", "ID_STRING": "DESC_TXT", "TEXT": "Нейтральное поселение", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232MM0008", "ID_STRING": "DESC_TXT", "TEXT": "Дом эльфов", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232MM000b", "ID_STRING": "DESC_TXT", "TEXT": "Плато ", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232MM000c", "ID_STRING": "DESC_TXT", "TEXT": "Нейтральное поселение", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232MM000d", "ID_STRING": "DESC_TXT", "TEXT": "Статуя имперцев", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Лавка Иггара", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232SI0000", "ID_STRING": "TXT_DESC", "TEXT": "У меня лучший товар в стране.", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Рынок рабов Тома", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Эта свежесть и молодость только для тебя! Они твои, можешь делать с ними, что хочешь, за деньги, конечно! Купленный товар возврату не подлежит...", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Нейтралы", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Нет описания расы", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232PL0001", "ID_STRING": "NAME_TXT", "TEXT": "Изуэль", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232PL0001", "ID_STRING": "DESC_TXT", "TEXT": "В дни своей юности эта могущественная повелительница выступила против армии ада и в одиночку победила ее, запечатав врата, через которые та вошла в мир. После этого она стал правителем своей страны.", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232PL0002", "ID_STRING": "NAME_TXT", "TEXT": "Силен", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232PL0002", "ID_STRING": "DESC_TXT", "TEXT": "Она опытный боец и давно сражается за честь эльфов, никому не войти в лес без ее ведома.", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Виргилий", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232UN0015", "ID_STRING": "NAME_TXT", "TEXT": "Разбойник", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV0000", "ID_STRING": "NAME_TXT", "TEXT": "РОЛИК ЭЛЬФОВ", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Серфис \n\"Прежде чем вторгнуться в земли Фардейла, нам необходимо укрепить свои позиции в Торговом море и собрать силы, достаточные для того, чтобы справиться с войсками Империи на их собственной земле.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Серфис \n\"До сих пор нам удавалось одержать верх, несмотря на все препятствия на нашем пути. Вне всякого сомнения, это знак благоволения богов. Я знаю, что вы не моряки, но Галлеан поможет нам пройти через это.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Кентавр-копейщик \n\"И ты поведешь кентавров? Я сомневаюсь...\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Серфис \n\"Почему вы стараетесь помешать каждому нашему шагу?\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Кентавр-странник\n\"Разве это не очевидно? Мы не подчиняемся приказам 'благородных'! Почему мы должны отвечать перед тобой?\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Серфис \n\" Серфис \n\"Это не мои приказы, это воля Галлеана! Вы забыли, почему мы здесь?! Мы должны немедленно уничтожить торговые пути Империи! Здесь есть три порта - захватите их.\"", "SEQ_NUM": 5},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV0001", "ID_STRING": "NAME_TXT", "TEXT": "ЭЛЬФЫ ЗАХВАТИЛИ ЛОГОВО ДЬЯВОЛА", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Том Вудворф \n\"Что? Новые владельцы? Мне все равно, пока я могу вести свои дела. Не повышайте мою арендную плату, и я не стану жаловаться.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Какие услуги ты предлагаешь?", "SEQ_NUM": 1},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Том Вудворф \n\"Ха-ха, интересует? Ну, мы очень осмотрительны... если вы понимаете. Мы можем достать любой товар или информацию или даже заставить кого-нибудь исчезнуть, благодаря нашему молчаливому другу!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Грейс \n\"...\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "\"Еретик! Он следует твоим приказам?\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Том Вудворф \n\"Ну, у меня с ним особый уговор. Он мне подчиняется, я кормлю его. Кроме того, я думаю, ему нравятся все эти убийства и хаос.\"", "SEQ_NUM": 5},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV0002", "ID_STRING": "NAME_TXT", "TEXT": "ЭЛЬФЫ ЗАХВАТИЛИ ЯРМАРКУ БАНТЕРА", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Бантер \n\"Чтоо... Эй... Эльфы! Давненько здесь не появлялся лесной народ, да... Что привело вас в наш город? Ааа... Вам нужен товар? Хо-хо-хо, у Бантера есть все!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Нет, теперь мы будем вести здесь торговлю, человек!", "SEQ_NUM": 1},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Бантер \n\"Вести здесь торговлю? Ага... О... О! Вы хотите сказать, вместо Империи... Прекрасно! Эти негодяи просто... Они берут и берут, берут и... Ну... Это все, что они делают, они только берут! С ними нельзя иметь дело.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Бантер \n\"Ох…Ха! Вы можете быть уверены, что Бантер будет снабжать вас, он видит только позитивные стороны в нашем сотрудничестве... Вот! Товары на мне! Разве я не прекрасен? Ну конечно же, я прекрасен!\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV0003", "ID_STRING": "NAME_TXT", "TEXT": "ЭЛЬФЫ ЗАХВАТИЛИ ЛИТЕЙНЮ ШАДИ", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Брамдок \n\"Так это правда! Значит, Яата'Халли мертва! Жаль, в ней текла королевская кровь. Хотя местные гномы не слишком-то ее любили. Мир здесь... Переговоры там. Это не путь детей Вотана!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Да... Итак... Мы берем эти торговые пути под свое покровительство. Какие дела вы здесь ведете?", "SEQ_NUM": 1},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Брамдок \n\"Природные ресурсы! Все виды минералов, железо, камень и тому подобное! И не только из гномских рудников, а со всего Невендаара. Если где-то есть шахта, мы сможем достать для вас то, что в ней добывают! И по хорошей цене!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Заманчивое предложение. Мы оставим здесь своих помощников, чтобы вы обсудили с ними детали. Надеюсь, ты не против иметь дело с эльфами?", "SEQ_NUM": 3},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Брамдок \n\"Золото - мой единственный друг. Все остальное... Как вы сказали... Детали. Пока вы не против иметь дело с гномом, мы сработаемся!\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232UN002d", "ID_STRING": "NAME_TXT", "TEXT": "Русалка", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232UN0031", "ID_STRING": "NAME_TXT", "TEXT": "Русалка", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV000e", "ID_STRING": "NAME_TXT", "TEXT": "ЭЛЬФЫ ВЫИГРАЛИ", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Серфис \n\"Мы установили контроль над всеми торговыми портами Торгового моря. Сообщите, что мы можем начинать готовить флот к вторжению в Фардейл.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232UN0038", "ID_STRING": "NAME_TXT", "TEXT": "Копейщик", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232UN003d", "ID_STRING": "NAME_TXT", "TEXT": "Русалка", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV001a", "ID_STRING": "NAME_TXT", "TEXT": "ИМПЕРИЯ ВЫИГРАЛА", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Мизраэль \n\"Все торговые порты в безопасности. Свяжитесь с Эмри и запросите подкрепления. Мы не должны дать эльфам второго шанса.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV001b", "ID_STRING": "NAME_TXT", "TEXT": "РОЛИК ИМПЕРИИ", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Солдат \n\"Сэр, в Торговом море появились эльфы. Похоже, что их цель - торговые порты.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Мизраэль \n\"Мы не можем игнорировать эту угрозу. Потеря Торгового моря подорвет всю экономику Империи - так что приготовиться к обороне. Порты должны остаться в наших руках.\"\r \n", "SEQ_NUM": 1},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV001c", "ID_STRING": "NAME_TXT", "TEXT": "ИМПЕРИЯ ЗАХВАТИЛА ЯРМАРКУ БАНТЕРА", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Бантер \n\"НЕЕТ! Нет... Что теперь? Бантер уже отдал вам ВСЕ товары! У него нет ничего, даже сапог! Особенно сапог! Почему у меня будут сапоги? Хм...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "\"Прекрати свою болтовню, простофиля! Мы здесь для охраны, а не для того, чтобы пользоваться твоими бесполезными услугами!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Бантер \n\"БЕСПОЛЕЗНЫМИ??? Как вы! Хмм, ладно... ХОРОШО... хорошо, вы правы. Значит, огромный имперский здоровяк будет охранять старого бедного Бантера? УДИВИТЕЛЬНО! Да.\"\r \n", "SEQ_NUM": 2},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "\"Он будет защищать торговый порт, а не тебя! Заткнись, наконец!\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV001d", "ID_STRING": "NAME_TXT", "TEXT": "ИМПЕРИЯ ЗАХВАТИЛА ЛИТЕЙНЮ ШАДИ", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "\"Мы усиливаем гарнизон, Бремдок. У нас есть основания предполагать, что кое-кто попробует установить контроль над Торговым морем.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Бремдок \n\"Хорошо, допустим, но почему вы думаете, что я не могу защитить себя сам? У меня не \"дипломатический\" склад ума, если вы понимаете, что я имею в виду.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "\"Мы полагаем, что тебе плевать, кто контролирует Торговое море, пока деньги текут через твои грязные руки. Как бы то ни было, мы размещаем здесь дополнительные войска.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Бремдок \n\"Хорошо. Когда деньги перестанут течь, вы узнаете мое мнение.\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV001e", "ID_STRING": "NAME_TXT", "TEXT": "ИМПЕРИЯ ЗАХВАТИЛА ЛОГОВО ДЬЯВОЛА", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Том Вудворф \n\"Что еще? Еще один пилигрим должен исчезнуть? Мы здесь не для того, чтобы заниматься такими пустяками!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "\"Не в этот раз, Том, мы усиливаем оборону твоей лачуги. Ты должен радоваться... у тебя появятся покупатели, как раз то, чего тебе не хватает!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Том Вудворф \n\"Заткнись! Давай, приводи своих крылатых рыцарей. Но не обвиняй меня, если Грейсс решит перекусить кем-нибудь из них.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "\"Если мы увидим твою скотину не в клетке, мы не просто убьем его. Мы вышвырнем тебя и твою жалкую банду жуликов в море. Я слышал, что у кракенов отличный аппетит!\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232UN0042", "ID_STRING": "NAME_TXT", "TEXT": "Ассасин Империи", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232UN0049", "ID_STRING": "NAME_TXT", "TEXT": "Головорез", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232UN004a", "ID_STRING": "NAME_TXT", "TEXT": "Русалка", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232UN004d", "ID_STRING": "NAME_TXT", "TEXT": "Головорез", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232UN0053", "ID_STRING": "NAME_TXT", "TEXT": "Кракен", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232UN0054", "ID_STRING": "NAME_TXT", "TEXT": "Морской змей", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232UN0061", "ID_STRING": "NAME_TXT", "TEXT": "Отон", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232UN0074", "ID_STRING": "NAME_TXT", "TEXT": "Копейщик", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232UN0076", "ID_STRING": "NAME_TXT", "TEXT": "Копейщик", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232UN0079", "ID_STRING": "NAME_TXT", "TEXT": "Ассасин Империи", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232UN0084", "ID_STRING": "NAME_TXT", "TEXT": "Кракен", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232UN0085", "ID_STRING": "NAME_TXT", "TEXT": "Морской змей", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232UN0087", "ID_STRING": "NAME_TXT", "TEXT": "Торн", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232UN0088", "ID_STRING": "NAME_TXT", "TEXT": "Ассасин Империи", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232FT0000", "ID_STRING": "NAME_TXT", "TEXT": "Эдрас", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232FT0001", "ID_STRING": "NAME_TXT", "TEXT": "Торговый двор Бантера", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232FT0002", "ID_STRING": "NAME_TXT", "TEXT": "Куцзница Шадья", "SEQ_NUM": 0},
    {"NO_SCEN": "S232SC0000", "ID_OBJECT": "S232FT0003", "ID_STRING": "NAME_TXT", "TEXT": "Логово дьявола", "SEQ_NUM": 0},
