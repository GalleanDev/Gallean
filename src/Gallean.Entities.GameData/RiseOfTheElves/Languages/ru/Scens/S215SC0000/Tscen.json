    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO000f", "ID_STRING": "NAME_TXT", "TEXT": "Башня Зимраана", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO0010", "ID_STRING": "NAME_TXT", "TEXT": "Укрытие Дреги Зул", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215LO0011", "ID_STRING": "NAME_TXT", "TEXT": "Предупреждение кракена", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Подготовка войск", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Заходи, я сделаю достойных бойцов из твоих слабаков.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Кузня Кеккута", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Здесь есть предметы, которые могут пригодиться воину.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Рынок Ривенда", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0002", "ID_STRING": "TXT_DESC", "TEXT": "У нас есть товар на любой вкус!", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Башня Зимраана", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215SI0003", "ID_STRING": "TXT_DESC", "TEXT": "У меня много дьявольской магии.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Нейтралы", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Нет описания расы", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Брисал", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL0009", "ID_STRING": "DESC_TXT", "TEXT": "В дни своей юности этот могущественный повелитель выступил против армии ада и в одиночку победил ее, запечатав врата, через которые та вошла в мир. После этого он стал правителем своей страны.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Уаллгарг", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215PL000a", "ID_STRING": "DESC_TXT", "TEXT": "В свое время он был самым могущественным из всех адептов темного искусства, пока инквизитор Воргель не убил его, положив конец засилью ужаса в его землях. Теперь он восстал из мертвых и стремится подчинить своей воле всех смертных.", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Катал", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Конал", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN000d", "ID_STRING": "NAME_TXT", "TEXT": "Гном", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0019", "ID_STRING": "NAME_TXT", "TEXT": "Белый медведь", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Империя, появление кракена", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Дрега Зул \n\"Милорд! Мы разбудили монстра из бездны! Мы должны бежать!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Захват Фендхила", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Крестьяне\n\"Крат'ду... при упоминании этого имени душа наполняется ужасом и болью!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Захват Ривенда", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Крестьяне\n\"Мы слышали это имя раньше - Крат'ду. Говорят, что в те ужасные годы, когда он грабил и мародерствовал в деревнях, случилась история... он сжалился над молодой невестой...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "\"Она была прекрасна и должна была родить ребенка. Вместо того, чтобы убить ее, он накинул на нее мантию смерти... Но молодая женщина не вынесла испытания - нерожденный ребенок внутри нее сопротивлялся воздействию вампира... и она умерла.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Дрега Зул \n\"Эта история что-то напоминает...\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Захват Кеккута", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Крестьяне\n\"Ты поплатишься за те страдания, что причинил этому клану! Пусть демоны найдут тебя и уничтожат!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0028", "ID_STRING": "NAME_TXT", "TEXT": "Разбойник", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Захват Калаита", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Крестьяне\n\"Кланы сдерут с тебя шкуру за содеянное! Ты за все заплатишь!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Приближение к Ривенду", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Дрега Зул \n\"Мы приближаемся к городу Ривенд, милорд. Этот город хорошо охраняется, он годами отражал атаки нежити. Ривенд будет нелегко захватить, его жители - опытные воины.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Приближение Империи к нежити", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Дрега Зул \n\"Это вход на территории нежити, милорд. Будьте осторожны! Эти существа невероятно опасны...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Осмотр дозорной башни", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "\"На башне есть надпись, но эта часть стены повреждена, и невозможно прочесть текст целиком... Тут написано: \n'И когда носферату Крат'ду возжелал молодую женщину, он сказал ей: 'Будь моей'. \nЧто это может значить, милорд?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Осмотр заброшенного убежища", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Дрега Зул \n\"Тут с недавних пор устроил себе логово медведь, но всепоглощающее холодное ощущение присутствия смерти и черепа на дальней стене... Без сомнений, здесь жил вампир!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Осмотр лаборатории алхимика", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Дрега Зул \n\"Нет прямых доказательств того, что Крат'ду в сговоре с гномами, милорд... Просто были найдены обычные магические предметы Кланов.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Осмотр разрушенного замка", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Крат'ду \n\"Я так долго ждал тебя, Дрега Зул... Мы должны быть вместе, ты это понимаешь? Нам суждено править этими землями вместе!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Сообщение нежити", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "\"Империя нашла Крат'ду, хозяин... Мы должны его немедленно захватить, так как Империя, скорее всего, упустит его.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Day After Loot Empire", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Сэр Гелдвин \n\"Мы понимаем, что вы потеряли ценного предводителя! Мы здесь, чтобы возместить ваши потери, милорд!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Undead Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "\"Хозяин! Безумный Крат'ду покинул столицу! Он уехал с верноподданными воинами через день. Его слуги говорят, что он уехал искать свою невесту: девушку, которая наполовину является человеком, а наполовину нежитью. Он создал ее сам. Зовут ее Дрега Зул!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "\"Много лет назад он попытался обратить смертную женщину, мать этого создания, когда она была беременна. Естественно, плоть нерожденного ребенка трансформировалась и он превратился в монстра. Нужно остановить его, пока он не передал ей свой темный дар!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Ролик Империи", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Дрега Зул \n\"Милорд, я обучалась с вами и верно вам служила эти годы! Пришло время отомстить за смерть моего отца...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "\"Его жестоко убили много лет назад. Это сделал носферату, который меня превратил в монстра... Я должна искупить его смерть! Я прошу вас, помогите мне найти этого демона!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Советник \n\"Она права, милорд. Мы должны пойти войной на Орды нежити. Они принесли столько страданий нашему народу, мы должны найти и уничтожить их!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Дозорная башня - Империя", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Вор-сквайр\n\"Солдатам Империи не позволяется ходить дальше этой башни!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Дозорная башня - нежить", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Вор-сквайр\n\"Тревога! Готовь оружие! Нежить атакует!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Приближение к Ривенду - нежить", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Стражники-копейщики \n\"Поднимайте тревогу! Нежить приближается! Предупредите волшебников!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0036", "ID_STRING": "NAME_TXT", "TEXT": "Копейщик Ривенда", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Путь Кланов", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Горный великан \n\"Это территория Кланов, вам тут не место... Поворачивайте назад, или вам несдобровать!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN003a", "ID_STRING": "NAME_TXT", "TEXT": "Вор-сквайр", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Приближение к Фендилу - Империя", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Вор-сквайр\n\"Держитесь подальше от этого города, солдаты Империи! Нашему народу не нужна ваша тирания!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Приближение к Фендилу - Нежить", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Вор-сквайр\n\"Трудно представить, чтобы люди этого города позволили победить себя! Приготовься умереть, нежить!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN003c", "ID_STRING": "NAME_TXT", "TEXT": "Копейщик", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Священная земля отшельника", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Хермит\n\"Нечистые сердцем не должны ступать на эту землю! Она для избранных воинов Вотана... Я избавлю эти земли от вашего присутствия!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Сквайр атакует нежить", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Вор-сквайр\n\"Пусть силы света уничтожат вас, мерзкая нежить!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN003e", "ID_STRING": "NAME_TXT", "TEXT": "Головорез", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Предупреждение о волке", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "\"Милорд, местное население верит, что в этих землях обитает оборотень!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Империя, день 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Советник \n\"Наши шпионы принесли вести о нежити. Недавно исчез Лорд Крат'ду... Может, это именно его мы и ищем?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Империя побеждает", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0041", "ID_STRING": "NAME_TXT", "TEXT": "Вор-сквайр", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Грабеж оставленного жилья - нежить", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "\"Крат'ду был здесь! Он оставил тут черепа жертв. Но нет ни единого намека на то, куда он направился...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Грабеж лаборатории алхимика - Нежить", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "\"Тут ничего нет, хозяин! Только обычные магические предметы гномов.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Грабеж разрушенного замка - нежить 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Крат'ду \n\"Не думайте, что вам удастся спастись, солдаты Орд нежити! Я создам новую совершенную расу вместе с моей любимой Дрегой Зул. Я жду ее, и когда она придет, вы все будете уничтожены!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0044", "ID_STRING": "NAME_TXT", "TEXT": "Вор-сквайр", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Послание Империи", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "\"Нежить узнала, где находится Крат'ду! Время начать наступление!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Грабеж разрушенного замка - Империя 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Превращенная Дрега Зул \n\"Теперь я понимаю, Крат'ду... Это судьба - мы должны быть вместе!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Советник \n\"Милорд! Злой Крат'ду все это спланировал - он заманил нас в ловушку и получил Дрегу Зул! Несмотря на то, что мы ослаблены, мы не должны сдаваться! Мы должны убить Крат'ду, чтобы снять заклятие, которое он на нее наложил!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "\"Не отчаивайтесь, я вызвал подкрепление, милорд!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0049", "ID_STRING": "NAME_TXT", "TEXT": "Головорез", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Атака стражей Ривенда1", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0026", "ID_STRING": "POPUP_TXT", "TEXT": "Дрега Зул \n\"После того как мы первыми атаковали, люди вряд ли будут контратаковать... Мы должны покинуть эту землю, так как мы не готовы к войне!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Атака стражей Ривенда2", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Дрега Зул \n\"После того как мы первыми атаковали, люди вряд ли будут контратаковать... Мы должны покинуть эту землю, так как мы не готовы к войне!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Захват Ривенда нежитью", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "\"Эти люди знают, что сделал Крат'ду... Он инициировал больше невинных людей, чем нам кажется! Мы не должны останавливаться!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Захват Фендила нежитью", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0029", "ID_STRING": "POPUP_TXT", "TEXT": "\"Хозяин, жители деревень не знают о деяниях Крат'ду... Его не было здесь много лет.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN004c", "ID_STRING": "NAME_TXT", "TEXT": "Копейщик", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Нежить проиграла", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002a", "ID_STRING": "POPUP_TXT", "TEXT": "Советник\r\"Крат'ду все еще жив, и он ни за что не успокоится, пока не выполнит задуманного. Он отомстит за то, что мы сделали! Мы должны подумать о своем спасении, пока не поздно!\"\r \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002b", "ID_STRING": "NAME_TXT", "TEXT": "Дрега Зул захватывает Фендил", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN004f", "ID_STRING": "NAME_TXT", "TEXT": "Волк", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Нежить победила2", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002c", "ID_STRING": "POPUP_TXT", "TEXT": "\"Безумный Крат'ду наконец мертв... Он больше не будет проливать нашу кровь...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0050", "ID_STRING": "NAME_TXT", "TEXT": "Волк", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002f", "ID_STRING": "NAME_TXT", "TEXT": "Дрега приближается к Крат'ду", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "Крат'ду \n\"Я так долго ждал тебя, Дрега Зул... Мы должны быть вместе, ты это понимаешь? Нам суждено править этими землями вместе!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "Дрега Зул \n\"Теперь я понимаю, Крат'ду... Это судьба - мы должны быть вместе!\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "\"Милорд! Злой Крат'ду все это спланировал - он заманил нас в ловушку и получил Дрегу Зул! Несмотря на то, что мы ослаблены, мы не должны сдаваться! Мы должны убить Крат'ду, чтобы снять заклятие, которое он на нее наложил!\"", "SEQ_NUM": 5},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0030", "ID_STRING": "NAME_TXT", "TEXT": "Грабеж замка отключен - Нежить", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0031", "ID_STRING": "NAME_TXT", "TEXT": "Нежить - появление Кракена", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0031", "ID_STRING": "POPUP_TXT", "TEXT": "Советник \n\"Хозяин, мы разбудили монстра из бездны! Мы должны бежать!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0032", "ID_STRING": "NAME_TXT", "TEXT": "Империя - намек о нахождении Крат'ду", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0032", "ID_STRING": "POPUP_TXT", "TEXT": "Дрега Зул \n\"На этих землях побывали темные силы, милорд... Может ли Крат'ду быть где-то поблизости?\"\r \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0033", "ID_STRING": "NAME_TXT", "TEXT": "Нежить - намек о нахождении Крат'ду", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0033", "ID_STRING": "POPUP_TXT", "TEXT": "Советник\r\"На этих землях побывали темные силы, милорд... Может ли Крат'ду быть где-то поблизости?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0058", "ID_STRING": "NAME_TXT", "TEXT": "Отшельник", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0035", "ID_STRING": "NAME_TXT", "TEXT": "Империя - предупреждение о приближении к месту кракена", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0035", "ID_STRING": "POPUP_TXT", "TEXT": "Дрега Зул \n\"Милорд, предупреждаю, в этих краях обитают кракены. Мы должны повернуть обратно!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215UN0059", "ID_STRING": "NAME_TXT", "TEXT": "Гном", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0036", "ID_STRING": "NAME_TXT", "TEXT": "Нежить - предупреждение о приближении к месту кракена", "SEQ_NUM": 0},
    {"NO_SCEN": "S215SC0000", "ID_OBJECT": "S215EV0036", "ID_STRING": "POPUP_TXT", "TEXT": "Советник\n\"Хозяин, предупреждаю, в этих краях обитают кракены. Мы должны повернуть обратно!\"", "SEQ_NUM": 0},
