    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227LO0018", "ID_STRING": "NAME_TXT", "TEXT": "Уйдите", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227LO0019", "ID_STRING": "NAME_TXT", "TEXT": "Это я", "SEQ_NUM": 0},
    {"NO_SCEN": "S227SC0000", "ID_OBJECT": "S227LO001a", "ID_STRING": "NAME_TXT", "TEXT": "Я не крестьянин", "SEQ_NUM": 0},
