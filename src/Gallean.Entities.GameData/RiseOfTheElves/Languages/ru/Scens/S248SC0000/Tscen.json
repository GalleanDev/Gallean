    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248MM007a", "ID_STRING": "DESC_TXT", "TEXT": "Город эльфов", "SEQ_NUM": 0},
    {"NO_SCEN": "S248SC0000", "ID_OBJECT": "S248MM007b", "ID_STRING": "DESC_TXT", "TEXT": "Дом эльфов", "SEQ_NUM": 0},
