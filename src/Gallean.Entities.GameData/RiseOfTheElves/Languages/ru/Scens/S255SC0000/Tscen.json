    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0008", "ID_STRING": "TXT_DESC", "TEXT": "Любой может прийти и научиться искусству боя!", "SEQ_NUM": 0},
    {"NO_SCEN": "S255SC0000", "ID_OBJECT": "S255SI0009", "ID_STRING": "TXT_TITLE", "TEXT": "Лагерь Реггена", "SEQ_NUM": 0},
