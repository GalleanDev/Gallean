    {"NO_SCEN": "S200SC0000", "ID_OBJECT": "S200UN001c", "ID_STRING": "NAME_TXT", "TEXT": "Эфраэль", "SEQ_NUM": 0},
    {"NO_SCEN": "S200SC0000", "ID_OBJECT": "S200EV0000", "ID_STRING": "NAME_TXT", "TEXT": "GFC_spawn", "SEQ_NUM": 0},
    {"NO_SCEN": "S200SC0000", "ID_OBJECT": "S200EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Туман-Эльфы", "SEQ_NUM": 0},
    {"NO_SCEN": "S200SC0000", "ID_OBJECT": "S200EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Туман-Нежить", "SEQ_NUM": 0},
    {"NO_SCEN": "S200SC0000", "ID_OBJECT": "S200EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Лечение 1 ", "SEQ_NUM": 0},
    {"NO_SCEN": "S200SC0000", "ID_OBJECT": "S200EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Лечение 2 ", "SEQ_NUM": 0},
    {"NO_SCEN": "S200SC0000", "ID_OBJECT": "S200EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Эльфы-ПКГ Угроза", "SEQ_NUM": 0},
    {"NO_SCEN": "S200SC0000", "ID_OBJECT": "S200EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Кентавр-латник \n\"Стой! Никому из Эльфийского союза здесь не рады. Я пришел с миром. Между нами мало общего, но все же я дам тебе шанс навсегда покинуть эти земли. Теперь уходи, пока я не передумал и не убил тебя!\" \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S200SC0000", "ID_OBJECT": "S200EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Нежить-ПКГ угроза", "SEQ_NUM": 0},
    {"NO_SCEN": "S200SC0000", "ID_OBJECT": "S200EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Кентавр-латник \n\"Мерзкое порождение ночи! Мы знаем, как пострадали от тебя темные эльфы. Великий Галлеан покарает тебя!\" \n", "SEQ_NUM": 0},
    {"NO_SCEN": "S200SC0000", "ID_OBJECT": "S200EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Эльфы_Роттурдам", "SEQ_NUM": 0},
    {"NO_SCEN": "S200SC0000", "ID_OBJECT": "S200EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "\"Наш город недолго будет в руках Эльфийского союза!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S200SC0000", "ID_OBJECT": "S200EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Эльфы-Воин", "SEQ_NUM": 0},
    {"NO_SCEN": "S200SC0000", "ID_OBJECT": "S200EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Иллюмиэль \n\"Наш город недолго будет в руках Орд нежити!\" \n", "SEQ_NUM": 1},
    {"NO_SCEN": "S200SC0000", "ID_OBJECT": "S200EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Разграбление башни ПКГ", "SEQ_NUM": 0},
