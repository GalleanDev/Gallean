    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228UN0238", "ID_STRING": "NAME_TXT", "TEXT": "Вождь орков", "SEQ_NUM": 0},
    {"NO_SCEN": "S228SC0000", "ID_OBJECT": "S228UN023e", "ID_STRING": "NAME_TXT", "TEXT": "Зомби", "SEQ_NUM": 0},
