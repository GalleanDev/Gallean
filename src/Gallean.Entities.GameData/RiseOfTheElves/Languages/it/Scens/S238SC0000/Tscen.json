    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238LO001b", "ID_STRING": "NAME_TXT", "TEXT": "Mountain Vithar", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238LO001c", "ID_STRING": "NAME_TXT", "TEXT": "Legions Appear", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238LO001d", "ID_STRING": "NAME_TXT", "TEXT": "Empire Appears", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238LO001e", "ID_STRING": "NAME_TXT", "TEXT": "Orc Dragon", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238LO001f", "ID_STRING": "NAME_TXT", "TEXT": "Skeletos", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238LO0020", "ID_STRING": "NAME_TXT", "TEXT": "Remove Mountain Test", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238LO0021", "ID_STRING": "NAME_TXT", "TEXT": "Sophic Angel Appears", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Mercante", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Vendo cose molto utili, mio signore.", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Torre del mago", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238SI0001", "ID_STRING": "TXT_DESC", "TEXT": "I miei incantesimi non hanno pari in tutta la regione.", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238PL0000", "ID_STRING": "NAME_TXT", "TEXT": "Neutrali", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238PL0000", "ID_STRING": "DESC_TXT", "TEXT": "Nessuna descrizione", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238PL0009", "ID_STRING": "NAME_TXT", "TEXT": "Calderic", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238PL0009", "ID_STRING": "DESC_TXT", "TEXT": "Supremo signore dei clan nani, è noto per il suo valore nell'affrontare nemici più forti. Si narra che abbia combattuto per sette giorni e sette notti contro il possente drago Arfuruzon, riusciendo in fine a sconfiggerlo.", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238PL000a", "ID_STRING": "NAME_TXT", "TEXT": "Khagrael", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238PL000a", "ID_STRING": "DESC_TXT", "TEXT": "Noto ai sui tempi per essere l'adepto più potente della magia nera, morì per mano dell'inquisitore Vorgel, che mise fine al suo regno di terrore. Adesso è tornato in vita in qualità di non morto per soggiogare alla sua volontà qualsiasi mortale.", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Heiric", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN001a", "ID_STRING": "NAME_TXT", "TEXT": "Seguace di Synclair", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN001c", "ID_STRING": "NAME_TXT", "TEXT": "Seguace di Synclair", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0021", "ID_STRING": "NAME_TXT", "TEXT": "Elfo dei boschi", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Dead Zone", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Devoto del culto profano\n\"O stai con noi o contro di noi. Presto tutti soccomberanno all'incantesimo di Synclair... Il culto profano dominerà queste terre!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Plague", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Devoto del culto profano\n\"Nessuno vivrà abbastanza da vedere il volto di Synclair! Il giovane Solaris sarà protetto. Lodato sia Scyon!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Taura City", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Maestro del sapere\n\"Il demonio estende il suo odio attraverso i fiumi di Unity... Scyon distruggerà chiunque osi avvicinarsi a lui.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0026", "ID_STRING": "NAME_TXT", "TEXT": "Seguace di Synclair", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Fire Attack", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Devoto del culto profano\n\"A morte gli intrusi!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0029", "ID_STRING": "NAME_TXT", "TEXT": "Seguace di Synclair", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Winter Curse", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Devoto del culto profano\n\"Che i gelidi ventini arrestino chiunque cerchi di far del male a Scyon!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Healing Lake", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Spirito dell'angelo Sofico\n\"La mia anima viaggia sull'acqua... Ci fu un tempo in cui ero in grado di curare i feriti semplicemente sfiorandoli con la mia mano! Ma Synclair ha rubato il potere delle acque, lasciandomi senza magia.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Healing Waters Two", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Spirito dell'angelo Sofico\n\"Non sono altro che una visione del passato. Fino a poco tempo fa, queste acque possedevano proprietà balsamiche. Finché Synclair ed il suo culto profano le rubarono...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN002c", "ID_STRING": "NAME_TXT", "TEXT": "Seguace di Synclair", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Water Healing Three", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Spirito dell'angelo di Unity\n\"Scyon ed i suoi seguaci hanno trasformato questa sacra regione in un luogo profano... Per il bene di Unity, ti aiuterò.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Protect City", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Water Healing Four", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Spirito dell'angelo di Unity\n\"Ti aiuterò a sconfiggere il figlio di Synclair. Ma devi promettermi che quando il culto profano sarà sconfitto, andrai via!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000d", "ID_STRING": "NAME_TXT", "TEXT": "M Clans Story", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Gilgam el nomade\n\"Scyon è il figlio della strega Synclair e del guaritore divino Solaris. È immune a vari elementi e possiede abilità curative. Sarà un rivale molto pericoloso.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Calderic\n\"Gilgam, perché li cerchiamo? Preferirei conquistare queste terre e cercare l'oro. Questo sì che sarebbe un motivo per festeggiare!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Gilgam il nomade\n\"Basta adesso! Stammi bene a sentire: non ti permetterò di dirigere una spedizione di guerrieri finché non ti sarai guadagnato la mia fiducia.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Undead Story", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Hu'lyr\n\"Non mi piace l'odore di questo regno, anche se c'è qualcosa di familiare...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Zythaar\n\"Smettila di lamentarti ed ascolta attentamente: ognuno di voi seguirà i miei ordini, non abbiamo molto tempo! Il nemico non potrà nascondersi per sempre...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' lyr \n\"Ti ordino di ascoltarmi e di obbedirmi. D'ora in poi avrai meno potere tra le truppe. Non sei altri che un semplice soldato al mio comando...\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Taura Message", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Maestro del sapere\n\"Questi libri parlano di una maledizione che aleggia sulla regione... Se qualcuno occupa questo castello, delle creature malvagie torneranno per reclamarlo.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Suldon", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Devoto del culto profano\n\"Scyon non riposerà fin quando non avrà sconfitto i nemici di sua madre. I suoi seguaci vogliono gettare tutti nel fiume come sacrificio.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Forest Citadel", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Devoto del culto profano\n\"Queste acque furono benedette a suo tempo da un angelo. Di solito curavano i feriti... Ma tutto è cambiato grazie a Scyon! Sia lodata la sua malvagità!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Satora", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Devoto del culto profano\n\"Scyon distruggerà chiunque intenda entrare in città.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Scyon Mountain Clans", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Scyon Undead", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN003b", "ID_STRING": "NAME_TXT", "TEXT": "Elfo dei boschi", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Victory Mountain Clans", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Gilgam el nomade\n\"Grazie al sacrificio dei clan, abbiamo liberato questa regione dal culto profano. Le genti di Unity potranno di nuovo vivere in pace.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Victory Undead", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' lyr \n\"Abbiamo sconfitto Scyon! Vi assicuro che sia Synclair che i clan hanno appreso la lezione. Nessuno potrà arrestare i Non morti!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Zythaar Betrayal", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Devoto del culto profano\n\"Maledetti morti ambulanti! Nessuno può resistere alla chiamata di Synclair! Unitevi a noi!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Zythaar\n\"Giammai! Presto assaggerai l'acciaio di un Non morto!\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Calderic Betrayal", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Devoto del culto profano\n\"Unitevi a noi! Sentite il potere! La ragione abbandonerà la vostra mente e adorerete Synclair...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Calderic\n\"Gilgam, pagherai per la tua incompetenza. I tuoi guerrieri adesso sono i miei rivali! Quando la vittoria sarà mia, festeggerò insieme all'eretico...\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Undead Story Day Two", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Hu'Lyr  \n\"C'è qualcosa di familiare negli abitanti di questa regione... Sento che questa è opera dei dannati. C'è qualcosa che non quadra e intendo scoprire cos'è.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Zythaar \n\"L'unica cosa che non quadra qui è la tua scarsa capacità di conduzione. Sei solo un buono a nulla!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Hu'lyr \n\"Ti avevo avvisato, Zythaar! Quando avrò portato a termine questa missione, verrai castigato per aver messo in discussione la mia autorità.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Undead Story Turn 5", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' Lyr \n\"Ora capisco cosa sta succedendo! Gli abitanti di Unity si trovano sotto l'effetto del culto profano, proprio come noi! Dobbiamo sconfiggere Scyon...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0020", "ID_STRING": "NAME_TXT", "TEXT": "M Clans Story 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Gilgam il nomade\n\"Riconosco questo fetore... Un tempo un culto usava dello zolfo nelle sue cerimonie per dominare le menti dei presenti. Quel culto è qui! Dobbiamo proteggere il nostro popolo.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Calderic \n\"L'unico fetore che sento è quello della tua incompetenza. Come osi discutere la mia autorità davanti agli altri?\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Gilgam el nomade\n\"Calderic, stai mettendo alla prova la mia pazienza. Non mi contraddire! Sono io quello che comanda. Quando avrò portato a termine la missione, verrai punito per quest'affronto.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Calderic \n\"....\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0021", "ID_STRING": "NAME_TXT", "TEXT": "M Clan Day 6", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Maestro del sapere\n\"Il fetore è sempre più forte! Dobbiamo prendere sul serio il culto profano, abbiamo già perso Calderic...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0044", "ID_STRING": "NAME_TXT", "TEXT": "Scudiere", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Taura", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0047", "ID_STRING": "NAME_TXT", "TEXT": "Scudiere", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0024", "ID_STRING": "NAME_TXT", "TEXT": "Beast goes Berzerk", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0024", "ID_STRING": "POPUP_TXT", "TEXT": "Devoto del culto profano\n\"È il momento! Avanti, bestie di Scyon! Annientate il nemico!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0025", "ID_STRING": "NAME_TXT", "TEXT": "M Clans Turn 10", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Gilgam el nomade\n\"Dobbiamo catturare tre città. Scyon in persona si manifesterà se le occupiamo.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Undead Story Turn 10", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0026", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' Lyr \n\"Dobbiamo catturare tre città. Scyon in persona si manifesterà se le occupiamo... E quando lo farà, lo uccideremo!\"", "SEQ_NUM": 0},
