    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV005b", "ID_STRING": "POPUP_TXT", "TEXT": "Maestro del sapere\n\"Una volta lessi una pergamena sulla leggenda di Unity... Dicono che due angeli trasformarono le acque di un fiume, conferendogli delle proprietà balsamiche.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV005c", "ID_STRING": "NAME_TXT", "TEXT": "Undead Angel History", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV005c", "ID_STRING": "POPUP_TXT", "TEXT": "Brujo\n\"Una volta lessi una pergamena sulla leggenda di Unity... Dicono che due angeli trasformarono le acque di un fiume, conferendogli delle proprietà balsamiche.\"", "SEQ_NUM": 0},
