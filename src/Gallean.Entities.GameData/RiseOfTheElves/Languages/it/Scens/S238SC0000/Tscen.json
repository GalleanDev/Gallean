    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0029", "ID_STRING": "POPUP_TXT", "TEXT": "Huz' lyr \n\"¡Manifestati, Scyon! ¡No ci fai paura!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Undead Troll Attack", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV002c", "ID_STRING": "NAME_TXT", "TEXT": "M Clans Ogre Attack", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV002d", "ID_STRING": "NAME_TXT", "TEXT": "Undead Turn 29", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' Lyr \n\"Il culto profano ha intenzione di attaccarci... Dobbiamo essere pronti! Vogliono vendicarsi dello stato di Ashgan.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV002e", "ID_STRING": "NAME_TXT", "TEXT": "Mountain Attack", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV002e", "ID_STRING": "POPUP_TXT", "TEXT": "Gilgam il nomade\n\"Il culto profano ha intenzione di attaccarci... Dobbiamo essere pronti!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV002f", "ID_STRING": "NAME_TXT", "TEXT": "Remove Lava Pits", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0053", "ID_STRING": "NAME_TXT", "TEXT": "Capo furfante", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0030", "ID_STRING": "NAME_TXT", "TEXT": "Undead Story Day 9", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0030", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' Zar  \n\"Mi comunicano che dobbiamo prepararci per difendere Ashgan. Gli eretici vogliono tenderci un'imboscata...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0031", "ID_STRING": "NAME_TXT", "TEXT": "M Clans Day 9", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0031", "ID_STRING": "POPUP_TXT", "TEXT": "Maestro del sapere\n\"Dobbiamo proteggere Vithar da Synclair! La sua ansia di potere non ha limiti...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0031", "ID_STRING": "POPUP_TXT", "TEXT": "Vithar\n\"Che venga la strega! Sono ansioso di entrare in combattimento...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0056", "ID_STRING": "NAME_TXT", "TEXT": "Scudiere", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0033", "ID_STRING": "NAME_TXT", "TEXT": "MClans Day 60", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0033", "ID_STRING": "POPUP_TXT", "TEXT": "Devoto del culto profano\n\"Per la gloria di Synclair e Solaris, sconfiggeremo i nostri nemici!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0034", "ID_STRING": "NAME_TXT", "TEXT": "UHordes Day 60 Attack", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0034", "ID_STRING": "POPUP_TXT", "TEXT": "Devoto del culto impío\n\"¡Alabado sea el oscuro corazón de Synclair! ¡Ha llegado vuestra hora!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0035", "ID_STRING": "NAME_TXT", "TEXT": "Undead Day 55", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0035", "ID_STRING": "POPUP_TXT", "TEXT": "Devoto del culto profano\n\"Il tempo gioca a vostro sfavore! È giunta l'ora che Synclair reclami ciò che suo...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0059", "ID_STRING": "NAME_TXT", "TEXT": "Scudiere", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0036", "ID_STRING": "NAME_TXT", "TEXT": "MClans Day 55", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0036", "ID_STRING": "POPUP_TXT", "TEXT": "Devoto del culto profano\n\"Avanti, iniziate una battaglia persa in partenza! Synclair ne uscirà trionfante!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0037", "ID_STRING": "NAME_TXT", "TEXT": "M Clans Day 52", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0037", "ID_STRING": "POPUP_TXT", "TEXT": "Maestro del sapere\n\"Dobbiamo essere pronti per qualsiasi attacco! I seguaci di Synclair vorranno occupare la nostra capitale per sottrarre a Vithar il potere...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0038", "ID_STRING": "NAME_TXT", "TEXT": "U Day 52", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0038", "ID_STRING": "POPUP_TXT", "TEXT": "Hun'lyr \n\"Synclair, quanto odio questo nome! Dobbiamo proteggere Ashgan, potremmo ricevere un attacco in qualsiasi momento.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0038", "ID_STRING": "POPUP_TXT", "TEXT": "Ashgan \n\"Non abbiamo bisogno di protezione. Fateli venire!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0039", "ID_STRING": "NAME_TXT", "TEXT": "U Day 8", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0039", "ID_STRING": "POPUP_TXT", "TEXT": "Scheletro\n\"C'è qualcosa che sta indebolendo Ashgan, una strana energia... Lo sentite? Sento un'inquietante risata che proviene da lontano!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003a", "ID_STRING": "NAME_TXT", "TEXT": "M Clans day 8", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003a", "ID_STRING": "POPUP_TXT", "TEXT": "Gilgam il nomade\n\"Vithar è sempre più debole... Credo che ci sia qualcosa nell'aria che influisce su di lui. State attenti! Non sappiamo cosa staranno facendo con l'energia che gli rubano...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003a", "ID_STRING": "POPUP_TXT", "TEXT": "Vithar\n\"Sto bene! Non preoccupatevi per me!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003c", "ID_STRING": "NAME_TXT", "TEXT": "Legions Appear", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003c", "ID_STRING": "POPUP_TXT", "TEXT": "Devoto del culto profano\n\"Che Scyon e la sua gloriosa furia siano lodati! Unitevi a noi... O morirete!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003d", "ID_STRING": "NAME_TXT", "TEXT": "Empire Appears", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003d", "ID_STRING": "POPUP_TXT", "TEXT": "Devoto del culto profano\n\"Il potere del culto cresce giorno dopo giorno. Nessuno può sfuggire a Synclair! Presto il nostro amato Vithar cadrà...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003e", "ID_STRING": "NAME_TXT", "TEXT": "M Clans day 19", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003e", "ID_STRING": "POPUP_TXT", "TEXT": "Gilgam el nomade\n\"La città di Taura è protetta da un drago verde. Dicono che appaia quando la capitale è sotto assedio. Dobbiamo proteggere Taura ad ogni costo!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV003f", "ID_STRING": "NAME_TXT", "TEXT": "Taura Dragon", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0040", "ID_STRING": "NAME_TXT", "TEXT": "U Day Two", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0040", "ID_STRING": "POPUP_TXT", "TEXT": "Hu'nskel \n\"Ho saputo che Scyon sta cercando suo padre, Solaris. Possiamo attirarlo catturando le sue città: Suldon, Satoria e Taura.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238UN0063", "ID_STRING": "NAME_TXT", "TEXT": "Settario", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0041", "ID_STRING": "NAME_TXT", "TEXT": "M Clans Day Two", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0041", "ID_STRING": "POPUP_TXT", "TEXT": "Maestro del sapere\n\"Se vogliamo che Scyon si faccia vedere dobbiamo catturare le sue terre. Occupiamo le città di Taura, Satoria e Cittadella del Bosco. Di sicuro apparirà presto!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0042", "ID_STRING": "NAME_TXT", "TEXT": "MClans Day 28 Advice", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0042", "ID_STRING": "POPUP_TXT", "TEXT": "Gilgam el nomade\n\"Suggerisco che parte della spedizione si effettui nella capitale. Non possiamo correre il rischio di mettere in pericolo Vithar.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0043", "ID_STRING": "NAME_TXT", "TEXT": "U Hordes Day 28  Advice", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0043", "ID_STRING": "POPUP_TXT", "TEXT": "Huz' Rala, cavaliere non morto\n\"Parte delle nostre truppe deve rimanere qui. Ashgan è debole, non possiamo correre il rischio che venga attaccato dal culto.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0043", "ID_STRING": "POPUP_TXT", "TEXT": "Ashgan \n\"Bene... Portateci carne fresca!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0044", "ID_STRING": "NAME_TXT", "TEXT": "Mountain Day 40", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0044", "ID_STRING": "POPUP_TXT", "TEXT": "Gilgam el nomade\n\"Dobbiamo essere preparati: il culto non ci metterà molto ad attaccare sapendo che Vithar è debole.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0047", "ID_STRING": "NAME_TXT", "TEXT": "Undead 41 warning", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0047", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' Zar \n\"Dobbiamo essere preparati: il culto non ci metterà molto ad attaccare sapendo che Ashgan è debole.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV004b", "ID_STRING": "NAME_TXT", "TEXT": "M day 57", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV004d", "ID_STRING": "NAME_TXT", "TEXT": "Mclans day 31", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV004d", "ID_STRING": "POPUP_TXT", "TEXT": "Gilgam el nomade\n\"Probabilmente hanno perso la battaglia, ma non ne dubitate: il culto ritornerà. Anche i clan sono stati attaccati. Se la loro capitale viene occupata, Synclair sarà invincibile!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV004e", "ID_STRING": "NAME_TXT", "TEXT": "Day 31", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV004e", "ID_STRING": "POPUP_TXT", "TEXT": "Scheletro\n\"Probabilmente hanno perso la battaglia, ma non ne dubitate: il culto ritornerà. Anche i clan sono stati attaccati. Se la loro capitale viene occupata, Synclair sarà invincibile!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV004f", "ID_STRING": "NAME_TXT", "TEXT": "Suldon Satoria", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV004f", "ID_STRING": "POPUP_TXT", "TEXT": "Devoto del culto profano\n\"Creature senza vita, la vostra presenza nelle nostre città è intollerabile! Presto assaggerete l'eterna sofferenza!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0050", "ID_STRING": "NAME_TXT", "TEXT": "New Event", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0051", "ID_STRING": "NAME_TXT", "TEXT": "Day 51", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0051", "ID_STRING": "POPUP_TXT", "TEXT": "Devoto del culto profano\n\"Nessuno sopravvivrà! Perché nessuno può sconfiggere Scyon. Preparatevi a morire!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0052", "ID_STRING": "NAME_TXT", "TEXT": "Undead Day 46", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0052", "ID_STRING": "POPUP_TXT", "TEXT": "Devoto del culto profano\n\"Sconfiggete le orde e la vittoria sarà nostra! Nel nome di Scyon!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0053", "ID_STRING": "NAME_TXT", "TEXT": "Mclans day 46", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0053", "ID_STRING": "POPUP_TXT", "TEXT": "Devoto del culto profano\n\"È giunta l'ora di eliminare i clan! Uccidete Vithar e Synclair consumerà la sua energia!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0055", "ID_STRING": "NAME_TXT", "TEXT": "Unity Angel Test", "SEQ_NUM": 0},
    {"NO_SCEN": "S238SC0000", "ID_OBJECT": "S238EV0055", "ID_STRING": "POPUP_TXT", "TEXT": "Unity\n\"Molti mi conoscono come l'angelo di Unity. Il culto profano aveva pietrificato la mia anima... Ma io benedirò questo luogo e le vostre ferite saranno guarite. Quando vi sentirete deboli, guardate verso qui e verrete curati.\"", "SEQ_NUM": 1},
