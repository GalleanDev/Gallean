    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0000",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Testo della citt\u00E0 di Inthuric",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0000",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nano \n\u0022Gymner Cloudkeeper \u00E8 figlio di Morok, Re dei Clan dei nani. Se lo ferite, Morok vi abbatter\u00E0!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100UN0023",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0002",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Testo della citt\u00E0 di Oghock",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0002",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Goblin \n\u0022Voi ancora?!! Voi morire! Grossascia uccide!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0003",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Testo della citt\u00E0 di Dunera",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0003",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Cultista \n\u0022Dobbiamo sbrigarci, Padrone! Il Guardiano del Sapere non deve sigillare il cancello verso gli inferi... Dobbiamo liberare Bethrezen!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100UN0027",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0004",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Gymner T30",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Consigliere \n\u0022Padrone! I nostri esploratori hanno visto Gymner avvicinarsi al cancello... Sta per iniziare la cerimonia che segner\u00E0 il nostro destino! Deve essere fermato...\u0022",
      "SEQ_NUM": 0
    },
