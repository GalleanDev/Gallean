      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100SI0000",
      "ID_STRING": "TXT_DESC",
      "TEXT": "Compro e vendo qualsiasi oggetto.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100SI0001",
      "ID_STRING": "TXT_TITLE",
      "TEXT": "Torre del Mago",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100SI0001",
      "ID_STRING": "TXT_DESC",
      "TEXT": "Ho alcuni nuovi incantesimi che potrebbero interessarti.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100PL0000",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Begrezen",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100PL0000",
      "ID_STRING": "DESC_TXT",
      "TEXT": "Qualsiasi bambino trema al sentire questo nome infame. Questo signore dell\u0027inferno \u00E8 noto per la sua sete di sangue e crudelt\u00E0. Si dice che una volta divor\u00F2 1000 schiavi ad un banchetto dato da Bethrezen per una vittoria contro il regno della luce.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100PL0001",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Athaulf",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100PL0001",
      "ID_STRING": "DESC_TXT",
      "TEXT": "Supremo signore dei Clan dei nani, \u00E8 noto per la sua forza in battaglia ed il suo coraggio di fronte a forze soverchianti. Una volta combatt\u00E8 sette giorni e sette notti contro il potente drago rosso Arfuruzon, fino a sconfiggerlo.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S100SC0000",
      "ID_OBJECT": "S100PL0004",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Giocatore neutrale",
      "SEQ_NUM": 0
    },
