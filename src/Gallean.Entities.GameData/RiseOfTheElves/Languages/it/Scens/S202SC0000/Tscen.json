    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN006a", "ID_STRING": "NAME_TXT", "TEXT": "Furfante", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN006c", "ID_STRING": "NAME_TXT", "TEXT": "Capo furfante", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN007a", "ID_STRING": "NAME_TXT", "TEXT": "Goblin", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202FT0000", "ID_STRING": "NAME_TXT", "TEXT": "Timoria", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202FT0001", "ID_STRING": "NAME_TXT", "TEXT": "Castello Gorgon", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202FT0002", "ID_STRING": "NAME_TXT", "TEXT": "Stagyrias", "SEQ_NUM": 0},
