    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN0001", "ID_STRING": "NAME_TXT", "TEXT": "Edwin", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN0003", "ID_STRING": "NAME_TXT", "TEXT": "Zaorish", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN0006", "ID_STRING": "NAME_TXT", "TEXT": "Ragno rosso gigante", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN0008", "ID_STRING": "NAME_TXT", "TEXT": "Ragno gigante", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN000f", "ID_STRING": "NAME_TXT", "TEXT": "Segeric", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN0015", "ID_STRING": "NAME_TXT", "TEXT": "Dannato", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN001a", "ID_STRING": "NAME_TXT", "TEXT": "Drago verde", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN001b", "ID_STRING": "NAME_TXT", "TEXT": "Unfegra", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN0020", "ID_STRING": "NAME_TXT", "TEXT": "Nigosh", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Win Empire", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Chierico\n\"Abbiamo ristabilito l'ordine di queste isole. Nonostante ciò che abbiamo perso, lavoreremo per ricostruire le nostre vite.\" ", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Win Legions", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Ashkael \n\"Che i nostri nemici subiscano la sorte degli stolti... Consegniamoli alla loro dannazione.\"\n", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Emp Day 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Cavaliere Pegaso\n\"Le spie sono tornate con notizie sorprendenti! Finalmente siamo riusciti a trovare il Calice Sacro di Stagyrias! La città è sotto il controllo dei nani di Anzryft e si trova a Nord della nostra capitale.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Chierico\n\"Con tutto il rispetto, mio signore: le isole Maldyn sono sotto il controllo dei nostri nemici. La tua folle ambizione di trovare il calice ha compromesso le nostre crociate in passato.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN0026", "ID_STRING": "NAME_TXT", "TEXT": "Thiffhas", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Emp Cap Stagyrias", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loc Warning", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Scudiere\n\"C'è un fetido ambiente in questa grotta. Dobbiamo fare attenzione, potremmo trovare qualsiasi tipo di essere vivo o... Non morto.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Emp Loc Islands", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Nano di Anzryft \n\"Queste isole si trovano ora sotto il controllo dei nani di Anzryft. Qualsiasi visitatore non invitato verrà giustiziato immediatamente!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Cavaliere pegaso\n\"Povero idiota! Un pò di neve non ci fermerà! L'impero recupererà ciò che è suo! Stagyrias cadrà ed il Calice Sacro sarà di nuovo mio!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Emp Day 10", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Hu'Larsh \n\"Contempla i volti dei tuoi uomini, donne e bambini, quelle di coloro i quali sono morti. È un sentimento turbante la fiducia, no? Ascolta i lamenti delle vedove che piangono per le loro famiglie.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Cavaliere Pegaso\n\"Maledetto malato perverso... Creatura spregievole, preparati ad essere sconfitta!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' Larsh \n\"Sconfitta? Ho superato la morte! Se è potere ciò che il tuo cuore desidera, vieni a cercarmi e ti libererò delle tue debolezze!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Cavaliere pegaso\n\"Stai sicuro che verremo a cercarti.\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Loc Hu Larsh Trap 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Cavaliere non morto\n\"Mortis si allieterà della tua disgrazia!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Loc Hu Larsh Trap 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Hu'Larsh \n\"Ti farò provare un po' della gloria eterna della morte.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Loc Hu Larsh Trap 3", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Cavaliere non morto\n\"Presto tutti vi unirete a noi.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Loc Hu Larsh Trap 4", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Cavaliere non morto\n\"Non azzardarti a muoverti da dove sei.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Cavaliere non morto\n\"Dunque... Non senti il potere di Mortis?\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Emp Day 11", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Scudiere\n\"Mio signore, siamo confusi! Continuiamo a cercare il calice? Cerchiamo Hu'Larsh? Quale delle due città dobbiamo catturare?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Cavaliere Pegaso\n\"Il Calice Sacro è prioritario; dobbiamo conseguire ogni possibile vantaggio: i nostri nemici hanno molte risorse.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Paladino\n\"Le città sono ben protette, ma dobbiamo conquistarle. Hu'Larsh è molto potente, ma possiede anche degli oggetti utili per l'Impero. Temo che dovremo affrontare entrambe le questioni prima o poi.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Leg Day 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Duca\n\"Il calice profano è da queste parti; percepisco il suo potere corrotto. La cirrà portuaria! Si! Il Calice dev'essere a Porto Brigham!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Emp Intro", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Chierico\n\"... Le vedove formarono un cerchio ed ebbe inizio la cerimonia. La falsa strega ne affrontò presto una vera, leale a Bethrezen. La strega dei diseredati eliminò il suo rivale.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Chierico\n\"La strega dei diseredati, tuttavia, nascondeva un segreto: non era leale alla nostra gente. Improvvisamente, venne fuori del fumo dal suo corpo e svanì lasciando il posto ad una bestia non morta!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Chierico\n\"La lich si fa chiamare Hu'larsh. Ha informato le vedove che non avrebbero dovuto preoccuparsi, poiché le loro famiglie avrebbero fatto ritorno... Ma sotto forma di fantasmi, spettri e zombie. La cerimonia era solo una montatura!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN003a", "ID_STRING": "NAME_TXT", "TEXT": "Guardiano", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Leg Day 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Settario\n\"... Le vedove avevano fatto un cerchio e diedero inizio al rituale. Una delle nostre streghe affrontò la sua 'Strega dei diseredati' e venne sconfitta.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Settario\n\"La udì compiacersi confessando che la cerimonia era una farsa. Finita la messa in scena, la farsante si rivelò quale lich.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Settario\n\"La lich Hu'Larsh dichiarò che le vedove si sarebbero riunite con le proprie famiglie, ma sotto forma di spettri e zombie. I loro cari sarebbero tornati come creature non morte.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Duca\n\"Perché mi annoi con le tue storie? Siamo qui per distruggere, non per raccontarie storie! Né quella gentaglia non morta né i patetici umani ostacoleranno il mio cammino.\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN003b", "ID_STRING": "NAME_TXT", "TEXT": "Guardiano", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Loot Hu'larsh Castle 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Hu' Larsh \n\"Idioti! Sono già morto! Prendete il dannato anello; non lo avrete ancora per molto: la morte invierà i suoi campioni a vendicarmi.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN003d", "ID_STRING": "NAME_TXT", "TEXT": "Guardiano", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN003f", "ID_STRING": "NAME_TXT", "TEXT": "Gigante delle colline", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Leg Loc Doragons Alter", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Settario\n\"Signore, c'è un altare dedicato a qualche antica divinità. Dovremmo stare attenti.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Duca\n\"Attenti? Tu dovresti stare attento se pensi che m'importino le tue superstizioni.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN0041", "ID_STRING": "NAME_TXT", "TEXT": "Guardiano", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Emp Cap Cordyllia", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Spirito\n\"Godetevi questo momento, perché le forze dell'oscurità si raduneranno.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Cavaliere Pegaso\n\"Con questa città in nostro potere siamo molto vicini alla vittoria definitiva!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Leg Cap Cordyllia", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Settario\n\"Signore, ho saputo che l'Impero vuole conquistare questa città.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Duca\n\"I nostri nemici non calpesteranno il suolo di questo luogo.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Leg Cap Sorugirilla", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Sollevato \n\"...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Duca\n\"Immagino sia è difficile fare minaccie senza lingua, non è vero?\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN0044", "ID_STRING": "NAME_TXT", "TEXT": "Lupo", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Emp Cap Sorugirilla", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Scudiero\n\"Signore, corre la voce che le Legioni dei dannati vogliono conquistare questa città. Che facciamo?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Cavaliere Pegaso\n\"Mi piacerebbe ricevere qualche saggio consiglio, ma l'unica cosa che possiamo fare è lottare contro qualsiasi cosa ci mandino.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0022", "ID_STRING": "NAME_TXT", "TEXT": "Leg Cap Polyonolos", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0022", "ID_STRING": "POPUP_TXT", "TEXT": "Stregone\n\"Vuoi fare infuriare Mortis?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0022", "ID_STRING": "POPUP_TXT", "TEXT": "Duca\n\"No, voglio solo ottenere la tua eterna dannazione!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Emp Cap Polyonolos", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0023", "ID_STRING": "POPUP_TXT", "TEXT": "Cavaliere Pegaso\n\"Oggi abbiamo vinto una battaglia, ma il nostro compito è appena cominciato. Temo che mantenere questa città sarà una grande sfida.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Leg Cap Brighams Port", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Duca\n\"Finalmente! Il Calice è nostro! Il sangue avrà un sapore più dolce in esso!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Emp Day 5", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Scudiere\n\"Signore, la gente di questo posto ha sofferto molto dalle Grandi Guerre ad oggi. Ora possiamo dimenticarci del Calice Sacro e aiutare i nostri fratelli a recuperare la loro umanità?\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Cavaliere Pegaso\n\"Tutti abbiamo sofferto molto. Io ho perso molti dei miei cari, ma andrò avanti. Mi rifiuto di vivere nell'autocompassione. Aiuteremo molto di più questa gente recuperando il Calice Sacro.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Day 15 Once", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV002c", "ID_STRING": "POPUP_TXT", "TEXT": "Spettro\n\"Il tempo dei vivi è giunto al termine. Gli spiriti dei caduti sono assetati di libertà.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202EV002e", "ID_STRING": "NAME_TXT", "TEXT": "Spawn Day 15", "SEQ_NUM": 0},
