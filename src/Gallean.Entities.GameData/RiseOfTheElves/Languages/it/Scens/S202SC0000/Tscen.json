    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN0058", "ID_STRING": "NAME_TXT", "TEXT": "Zombie", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN005b", "ID_STRING": "NAME_TXT", "TEXT": "Zombie", "SEQ_NUM": 0},
    {"NO_SCEN": "S202SC0000", "ID_OBJECT": "S202UN005d", "ID_STRING": "NAME_TXT", "TEXT": "Contadino", "SEQ_NUM": 0},
