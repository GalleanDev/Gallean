    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209UN01c4", "ID_STRING": "NAME_TXT", "TEXT": "Capo furfante", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209UN01c8", "ID_STRING": "NAME_TXT", "TEXT": "Capo furfante", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Clans Day One", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Daeron l'anziano \n\"Compagni, scortatemi fino alla grotta, mi assicurerò di ottenere un'ingresso alle terre dei dannati!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Norwyndar \n\"Non è così facile, Daeron. Dobbiamo passare attraverso i resti delle forze Governesh e del crescente esercito dei dannati. Suggerisco di...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Daeron l'anziano\n\"Perché dovremmo ascoltare i suggerimenti di un elfo? È ovvio che sarà duro, ma non dimentichiamo chi siamo! Dobbiamo dirigerci a Sud immediatamente approfittando della debolezza dei nostri nemici!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Norwyndar \n\"Sarebbe molto più ragionevole che Daeron rimanesse nella capitale mentre raduniamo un esercito abbastanza potente. Dovremmo inviare un gruppo a Sud e indagare sui Govenesh mentre io mi dirigo ad Est in cerca di alleati.\" ", "SEQ_NUM": 3},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Daeron l'anziano\n\"Bah! Codarde strategie da elfi! Marciamo diretti al combattimento!\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Legions Day One", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Amizn\n\"Signore, ci informano che i nani arrivano dal Nord. Potremmo difenderci senza problemi se non stessimo subendo la minaccia dei Govenesh. Dovremmo mettere fine alle loro ultime città quanto prima! C'è qualcosa che voglio mostrarti...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Thriss \n\"Perché avete portato Thrisss qui? Non vivrete tanto a lungo da... sssssss...sssssss... fatto, signore, ho posseduto questo corpo. Le menti deboli sono facili da piegare. Attendo i suoi ordini.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"Stando così vicini alla grotta, i nostri umani possono vivere in questo regno abbastanza da possedere i deboli. Abbiamo un altro soldato...\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Grunkk \n\"¡Grunkk vi farà a pezzi! ¡Vi schiaccerà come.....! Aaaaaaargh... Ce l'ho, sign.....aaaaaaaaargh....Nessuno comanda Grunkk!...Aspetti, signore, ecco; abbiamo il controllo dell'orco selvaggio.\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"Signore, se usiamo le nostre... Truppe in prestito, potremmo ingannare le razze vicine affinché lottino per noi. Tuttavia, suggerisco di occuparci prima delle città dei Govenesh.\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Legions Win", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"Ahahaha! I patetici nani hanno perso il loro salvatore! Non hanno più nulla per cui lottare!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Clans Win", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Daeron l'anziano \n\"Fatto, compagni! Abbiamo un tunnel aperto direttamente verso il centro delle forze dei demoni; per Wotan porteremo l'ira dei clan fino a loro!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"Ritirata! Torniamo alla grotta!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Clans Lose", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Daeron l'anziano \n\"Cosa ho fatto?! Che Wotan mi perdoni... aaagh!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Mine1", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0009", "ID_STRING": "POPUP_TXT", "TEXT": "Walos  \n\"Ahahaha!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Mine2", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000a", "ID_STRING": "POPUP_TXT", "TEXT": "Walos \n\"Ahahahaha! Fantastico!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Mine3", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000b", "ID_STRING": "POPUP_TXT", "TEXT": "Walos \n\"Bello spettacolo!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Mine4", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Walos \n\"Ahahaha! Questo deve far male!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Legions Wizard Warning", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000d", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"Non uccidete quel mago umano! È riposseduto e lo stiamo usando come esca. Potrai passare da questa zona senza problemi, ma i nani... Forse non avranno la stessa fortuna... Ahahaha!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Clans Wizard Warning", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Walos \n\"Salve, eeehhh... Amici! L'Impero ha ricevuto il vostro messaggio e siamo qui in nome di... Beh, dei pesci grossi. Andate avanti, io coprirò la vostra retroguardia. Perché esitate? Ho detto di muovervi!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Clans Kill Walos", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Daeron \n\"Riesco a sentire che gli umani erano posseduti... Non possiamo far affidamento sul fatto che il messaggio sia arrivato all'Impero!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Legions Kill Walos", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"Stupidi! Vi avevo detto di lasciare in pace Walos! Avete mandato all'aria una trappola perfetta!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Elfnapping", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Capo furfante\n\"Ah, si. Ci hai portato al leggendario Norwyndar. Potremo ottenere un buon riscatto. Potete passare.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Norwyndar \n\"Capisco il vostro ragionamento, signore. Non temete, fuggirò da questi banditi quando ce ne sarà l'occasione.\"", "SEQ_NUM": 5},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Thugs North", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Capo furfante \n\"Nani, portateci dal leggendario elfo Norwyndar e apriremo la muraglia a Sud. Le legioni non si aspetteranno il vostro arrivo da quella parte. Pensateci, è un buon affare, sacrificare un elfo per vincere la guerra...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Napped", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Clans Day 4", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Frug Brenstout \n\"Adesso vado, signore, con un messaggio per gli umani. Avremo bisogno di tutti gli uomini possibili per trionfare. Se le nostre strade non si incrocieranno ancora, di sicuro lo faranno nell'altro mondo. Che Wotan guidi le vostre spade.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Clans Eldrooke", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Goblin ferito \n\"Basta male! Parlerò, parlerò! Preso città degli elfi! Elfi rinchiusi in rovine verdi! Tu no entrare! No no no tu no entrare...!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Clans Orc Entry", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Esploratore \n\"Aaahh... lo senti! Dov'è la mia gente? Qui c'è qualcosa che non va...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0019", "ID_STRING": "NAME_TXT", "TEXT": "Prison Break", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Esploratore\n\"Mi rimangono pochi uomini... E guardali, deboli e incantenati!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Relwynn \n\"Avevamo abbandonato ogni speranza. Certo che ci uniremo a voi contro i dannati!\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Truntis \n\"Innanzitutto dovete rompere le nostre catene; l'orco capo degli schiavi aveva una tenaglia che... Ah, vedo che l'avete già trovata. Grazie... \"", "SEQ_NUM": 4},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Clans on the Move", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Hermit", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "Eremita \n\"Cosa ti fa pensare che potevi prendere qualsiasi cosa? Questa è la nostra miniera, la nostra gente vive tra le sue mura. Lasciaci in pace.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Capture Fierhold", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001c", "ID_STRING": "POPUP_TXT", "TEXT": "Sollevato \n\"Quessste mura non vi proteggeranno da Mortisss. Lei assssssaggerà la vosssssstra caaarne...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Capture Scartoe", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Spettro \n\"Non sssopravviverete. Mortissss ha ssssvegliato ssssolo qualcuno dei ssssuoi sssoldati. Pensssate ai ssssecoli di morti sotto i vossstri piedi, asssspettando di unirssssi a noi...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Capture Felbrinn", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001e", "ID_STRING": "POPUP_TXT", "TEXT": "Sollevato \n\"Bah, tenetevela. Vi auguro di marcire lentamente con la piaga che abbiamo lasciato.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Capture Edrelmire", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV001f", "ID_STRING": "POPUP_TXT", "TEXT": "Vampiro anziano\n\"Sorprendente, ma il mio sangue sopravviverà. Sarà meglio che stiate attenti al vostro collo.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Capture Cothkele", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0020", "ID_STRING": "POPUP_TXT", "TEXT": "Necrofago \n\"Aiiiiiiiiiiiiiiiiiiiiiiiiiiikk!!!!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Capture Krecheck", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0021", "ID_STRING": "POPUP_TXT", "TEXT": "Stregone \n\"Benvenuti a Krecheck; spero che non vi disturbi il fetore dei cadaveri in decomposizione; non siamo molto puntigliosi in quanto alla pulizia.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Campo mercenario", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Posso fare in modo che gli spiriti siano al tuo servizio, per una piccola ricompensa.", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Mercante", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Non dovreste essere qui! Comprate in fretta e sparite!", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Capture Crysend", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0023", "ID_STRING": "POPUP_TXT", "TEXT": "Iniziato \n\"Che Mortis torturi i vostri cadaveri descomposti!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Mercante", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Non mi chiedere dove l'ho preso, semplicemente rallegrati che sia così economico.", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Capture Kthrell", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Medusa \n\"Forestieri! Come vi azzardate??\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Clans Day 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0026", "ID_STRING": "POPUP_TXT", "TEXT": "Frug Brenstout \n\"Ed io che pensavo che i nani e gli elfi non andassero molto d'accordo.. Ho sentito che sono stati avvistati dei Goblin in pattuglie di uomini lucertola. Le razze indigene si saranno unite per sopravvivere all'attacco dei Govenesh...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Legions Day 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"Sarà meglio stare all'erta, le razze indigene sembra abbiano stretto strane alleanze, forse per difendersi dai Govenesh. Ad ogni modo, dobbiamo annientarli, che siano alleati o no.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Plagued", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Plague Warning", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0029", "ID_STRING": "POPUP_TXT", "TEXT": "Contagiato \n\"Sei pazzo? Non vedi che siamo venuti a morire in pace? Forse tu stesso sei già vittima della piaga! Girati e lasciaci con le nostre pene.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Walos Dead", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002b", "ID_STRING": "NAME_TXT", "TEXT": "Plaga 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002b", "ID_STRING": "POPUP_TXT", "TEXT": "Il tuo gruppo è stato contagiato dalla piaga.", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Plaga 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002c", "ID_STRING": "POPUP_TXT", "TEXT": "Il tuo gruppo è stato contagiato dalla piaga.", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002d", "ID_STRING": "NAME_TXT", "TEXT": "Plague 3", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002d", "ID_STRING": "POPUP_TXT", "TEXT": "Il tuo gruppo è stato contagiato dalla piaga.", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002e", "ID_STRING": "NAME_TXT", "TEXT": "Plague 4", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002e", "ID_STRING": "POPUP_TXT", "TEXT": "Il tuo gruppo è stato contagiato dalla piaga.", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002f", "ID_STRING": "NAME_TXT", "TEXT": "Plague 5", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV002f", "ID_STRING": "POPUP_TXT", "TEXT": "Il tuo gruppo è stato contagiato dalla piaga.", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0030", "ID_STRING": "NAME_TXT", "TEXT": "Plague 6", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0030", "ID_STRING": "POPUP_TXT", "TEXT": "Il tuo gruppo è stato contagiato dalla piaga.", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0031", "ID_STRING": "NAME_TXT", "TEXT": "Plague 7", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0031", "ID_STRING": "POPUP_TXT", "TEXT": "Il tuo gruppo è stato contagiato dalla piaga.", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0032", "ID_STRING": "NAME_TXT", "TEXT": "Plague 8", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0032", "ID_STRING": "POPUP_TXT", "TEXT": "Il tuo gruppo è stato contagiato dalla piaga.", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0033", "ID_STRING": "NAME_TXT", "TEXT": "Jonderuk", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0033", "ID_STRING": "POPUP_TXT", "TEXT": "Jonderuk \n\"Ahhh... questo mondo è così semplice. E troppo freddo per i miei gusti.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0033", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"Ahhh, vedo che abbiamo una nuova recluta. Non credi che le tue scelte in quanto a ospiti siano un poco... Scarse?\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0033", "ID_STRING": "POPUP_TXT", "TEXT": "Jonderuk \n\"L'arte della possessione non è facile, signore. Quando ho sentito una mente debole, ero ansioso di fare il viaggio.\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0034", "ID_STRING": "NAME_TXT", "TEXT": "Blackeye", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0034", "ID_STRING": "POPUP_TXT", "TEXT": "Blackeye \n\"Eccoci, signore. Siamo ansiosi per la morte del mistico nano...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0034", "ID_STRING": "POPUP_TXT", "TEXT": "Amzin \n\"Ahhh... dunque siete arrivati, miei sacrileghi trigemini. Mi chiedevo quando vi sareste uniti a noi. Posso dare per scontato che la possessione sia stata estremamente dolorosa?\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0034", "ID_STRING": "POPUP_TXT", "TEXT": "Blackeye \n\"Deliziosamente, maestro.\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0035", "ID_STRING": "NAME_TXT", "TEXT": "Protect", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0036", "ID_STRING": "NAME_TXT", "TEXT": "Empire Arrives", "SEQ_NUM": 0},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0036", "ID_STRING": "POPUP_TXT", "TEXT": "Lodrimoore \n\"Temo che siamo arrivati troppo tardi, ma l'Impero è pronto per combattere quei dannati. Resistete, compagni! Presto saremo al vostro fianco!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S209SC0000", "ID_OBJECT": "S209EV0037", "ID_STRING": "NAME_TXT", "TEXT": "Spider", "SEQ_NUM": 0},
