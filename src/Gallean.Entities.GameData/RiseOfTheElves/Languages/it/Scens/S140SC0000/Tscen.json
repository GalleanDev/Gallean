    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140EV001a",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Serphis\n\u0022Abbiamo perso il controllo della regione. La nostra missione \u00E8 fallita.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140UN003d",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Sirena",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140EV001b",
      "ID_STRING": "NAME_TXT",
      "TEXT": "ENC - TENDER MEET",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140EV001b",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "\u0022\u00C8 il leader della flotta imperiale! Se lo uccidiamo, l\u0027Impero presto perderebbe il controllo della zona!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140EV001b",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Leader della flotta\n\u0022Davvero credete di poter ostacolare le nostre rotte commerciali? Non avete nessuna chance! Gli elfi non hanno nessuna idea di navigazione!\u0022",
      "SEQ_NUM": 1
