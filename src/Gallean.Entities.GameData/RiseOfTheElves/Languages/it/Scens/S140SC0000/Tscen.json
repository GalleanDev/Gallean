    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140EV000e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Z - PLAYER WINS",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140EV000e",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Esploratore\n\u0022Abbiamo fatto fuori il leader della flotta imperiale e occupato i porti commerciali di Mercantile. Informate Serphis che \u00E8 giunto il momento di preparare alla flotta per invadere Fardale.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140UN0031",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Sirena",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140EV000f",
      "ID_STRING": "NAME_TXT",
      "TEXT": "ENC - EMP ALERT",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140EV000f",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Gealia\n\u0022Abbiamo saputo che l\u0027Impero \u00E8 al corrente dei nostri ultimi movimenti. Non ci metteranno molto a rinforzare la sicurezza degli altri porti di Mercantile.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140EV000f",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Serphis\n\u0022Non possiamo permetterlo! Se l\u0027Impero consolida le sue posizioni nella zona non potremo sconfiggerli. Dobbiamo fare in fretta... Bisogna occupare i porti ed aumentare le loro difese!\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140EV000f",
      "ID_STRING": "OBJECT_TXT",
      "TEXT": "Occupa tutti i porti commerciali e respingi gli attacchi dell\u0027Impero. Sconfiggi il leader della flotta imperiale ed evita che quest\u0027ultima prenda il controllo del resto dei porti.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S140SC0000",
      "ID_OBJECT": "S140UN0032",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
