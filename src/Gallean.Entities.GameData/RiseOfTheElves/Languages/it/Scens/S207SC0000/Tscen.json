    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Tempest Attack", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Winning Event", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Davon Fort", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Capo furfante\n\"Abbiamo evacuato la città... Ma siamo già alla ricerca di nuove conquiste!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Avonia Message A", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Cacciatore di streghe di Avonia\n\"Tu! L'ultima volta che abbiamo visto la tua razza, c'è stata una guerra!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Avonia Message B", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Cacciatore di streghe di Avonia\n\"Gli orchi hanno conquistato le basse terre!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Avonia Message C", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Cacciatore di streghe di Avonia\n\"Gli orchi hanno conquistato la regione montagnosa grazie all'aiuto di un forestiero!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Aragonia Message", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Cittadino di Aragonia\n\"Molto tempo fa, l'Impero cercò di stabilirsi in questa regione... Per ben due volte fallirono. Sappiamo che la prima colonia cercò di fare ritorno alla sua terra, ma furono considerati ribelli e giustiziati dalla loro gente!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0008", "ID_STRING": "NAME_TXT", "TEXT": "Edras", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0008", "ID_STRING": "POPUP_TXT", "TEXT": "Escudero \n\"Al principio vennimo qui per estrarre le ricchezze di questa terra, abbondante in oro e gemme. Prima dell'arrivo dei forestieri regnava la pace; fu allora che, stanchi delle nostra stessa gente, decidemmo di stabilirci qui.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Winning Event 2", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Winning Event 3", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Forest Keep Text", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000b", "ID_STRING": "POPUP_TXT", "TEXT": " \n\"Una violenta tribù delle vicinanze vive sotto la guida di un forestiere... Sappiamo poco di questo misterioso leader, e nessuno di quelli che abbiamo inviato ad indagare è mai più tornato.\" ", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Spear man says leave", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000c", "ID_STRING": "POPUP_TXT", "TEXT": "Lanciere  \n\"¡Ho reclamato questo territorio, intruso! ¡Vattene adesso... E retsa tra i lupi e i ragni!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Avonia Says Leave", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Cacciatore di streghe\n\"Non entrerai mai nella nostra città! E se ci provi, farai i conti con una terribile battaglia!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Mountain Clans Day One", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Bragon il forte\n\"Molto tempo fa, l'Impero cercò di stabilire una colonia in questo posto. I coloni andarono via, contro la volontà dell'Impero, e non fecero mai più ritorno... E la seconda colonia inviata ebbe la stessa sorte.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0010", "ID_STRING": "NAME_TXT", "TEXT": "MClans Day Ten", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Gigante delle colline\n\"C'è qualcosa di familiare in questo posto, non so cosa sia... Ma qualcosa o qualcuno qui mi sembra molto familiare.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Legions Day One", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Beliarh \n\"Ci sono ossa umane dappertutto; l'Impero sarà stato da queste parti tempo fa... Ma adesso non c'è traccia delle sue forze; rimangono solo le ossa a testimoniare il suo insuccesso!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Legions Day 12", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Baronessa \n\"Le ossa delle forze dell'Impero sono ovunque... La leggenda parla di una tribù e del suo leader forestiero protettori di questa regione. Immagino che l'lmpero li abbia trovati e che le loro ossa diano testimonianza del loro destino!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Undead Message", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Scheletro\n\"Signore, degli scheletri bruciati dai lampi marcano il territorio. Delle forze poderose proteggono questa regione, anche se questi misteriosi protettori si piegheranno dinanzi alle orde dei non morti.", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Undead Fourteen", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Fantasma \n\"Sento la presenza di spiriti perturbati... Furono eseguiti dalla loro stessa gente - forze dell'Impero. Ci vogliono mettere in guardia riguardo ad altri ancora presenti! Un forestiero con il potere di domare il fulmine vaga per queste terre!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Barbarian Message", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "Guerriero barbaro \n\"Colui il quale domina gli elementi vuole che ve ne andiate! Sparite o verrete annientati!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Loc leave our land", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Guerriero barbaro \n\"Lasciate la nostra terra, ora e per sempre! Se non ve ne andate con le buone, lo farete con le cattive... Il mio maestro padroneggia le forze del fulmine ed è capace di usarlo per colpirti! Supponendo che non ti sconfigga prima io...\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Mclans Day 1b", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "\"La torre della montagna è stata presa dagli orchi! Nella sua cima sono nascosti un paio di stivali magici che ci furono molto utili in passato. Non sappiamo quali avversari troverai se cercassi di recuperare quegli stivali.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Mercante", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0000", "ID_STRING": "TXT_DESC", "TEXT": "In cosa posso esserti utile, straniero?", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Mercante", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Le mie merci sono le migliori del regno.", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Campo mercenario", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0002", "ID_STRING": "TXT_DESC", "TEXT": "I miei mercanti si uniranno a te... Ad un prezzo.", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Campo mercenario", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0003", "ID_STRING": "TXT_DESC", "TEXT": "I miei Berserker sono addestrati per obbedire.", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0004", "ID_STRING": "TXT_TITLE", "TEXT": "Torre del mago", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0004", "ID_STRING": "TXT_DESC", "TEXT": "I miei incantesimi sono i più potenti del regno.", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0005", "ID_STRING": "TXT_TITLE", "TEXT": "Accampamento militare", "SEQ_NUM": 0},
    {"NO_SCEN": "S207SC0000", "ID_OBJECT": "S207SI0005", "ID_STRING": "TXT_DESC", "TEXT": "Ti addestrerò... Ad un prezzo.", "SEQ_NUM": 0},
