    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Guaritrice\n\"I responsabili di questo furto pagheranno per questo! Attenti! Arrivano altri barbari!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221UN0034", "ID_STRING": "NAME_TXT", "TEXT": "Settario", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Elves Day 1 ", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Arconte elfo\n\"Gli elfi Grystrom devono unirsi all'alleanza, ma temo che non si fidino di noi. C'è solo un modo di convincerli: dobbiamo trovare la reliquia e restituirla alla fonte magica!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Elf Threaten ", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Falciatore\n\"Voi figli di Gallean soffrirete ancora! Da sempre torturiamo gli elfi... E questa alleanza avrà la stessa sorte!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221UN0036", "ID_STRING": "NAME_TXT", "TEXT": "Settario", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Demon Is Coming ", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0013", "ID_STRING": "POPUP_TXT", "TEXT": "Dannato\n\"Quella meravigliosa reliquia presto sarà mia! Ed il regno di Grystrom arderà!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0014", "ID_STRING": "NAME_TXT", "TEXT": "Undead Day 1 ", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0014", "ID_STRING": "POPUP_TXT", "TEXT": "Cavaliere Non Morto\n\"La reliquia dev'essere nostra! Presto il suo potere sarà nelle nostre mani! Se vedete qualche elfo, fatelo soffrire! La sua alleanza sarà un fallimento!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221UN0038", "ID_STRING": "NAME_TXT", "TEXT": "Settario", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Undead Threat ", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0015", "ID_STRING": "POPUP_TXT", "TEXT": "Arconte elfo\n\"L'Alleanza Elfica ti annienterà, creatura miserabile. Non abbiamo ancora dimenticato le torture che i Non Morti hanno riservato alla nostra gente. Per il potere di Gallean, Mortis ed i suoi seguaci verranno sconfitti!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Undead Healing Message ", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0016", "ID_STRING": "POPUP_TXT", "TEXT": "\"La magia della fonte è fuori controllo! In questa zona i feriti potranno essere guariti. Forse ci sono delle altre zone delle quali possiamo sfruttare la magia... Adesso, troviamo quella reliquia e conquistiamo queste terre in nome di Mortis!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0017", "ID_STRING": "NAME_TXT", "TEXT": "Elves Healing Message ", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0017", "ID_STRING": "POPUP_TXT", "TEXT": "Questo dipenderà dalla fonte. C'è un gran potere in questo regno. Qui i feriti ed i bisognosi potranno riprendersi. Ma dobbiamo impiegare questa magia con saggezza. State attenti: potrebbero esserci delle altre zone magiche. Per l'Alleanza!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0018", "ID_STRING": "NAME_TXT", "TEXT": "Legions Message ", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0018", "ID_STRING": "POPUP_TXT", "TEXT": "Duca\n\"È inutile, non ci fermeremo mai! La reliquia sarà nostra!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV0019", "ID_STRING": "POPUP_TXT", "TEXT": "Seguace\n\"I barbari non permetteranno mai che vi portiate via la reliquia!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221UN003c", "ID_STRING": "NAME_TXT", "TEXT": "Orco", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV001a", "ID_STRING": "NAME_TXT", "TEXT": "city message Asmara ", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV001a", "ID_STRING": "POPUP_TXT", "TEXT": "Orco\n\"Gli orchi non dimenticano! Per la vendetta!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV001b", "ID_STRING": "NAME_TXT", "TEXT": "city message+grystrent ", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV001b", "ID_STRING": "POPUP_TXT", "TEXT": "\"I barbari tengono la reliquia in una torre del Nord. Dobbiamo raggiungerla rapidamente!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221UN003e", "ID_STRING": "NAME_TXT", "TEXT": "Orco", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Shaman_Undead ", "SEQ_NUM": 0},
    {"NO_SCEN": "S221SC0000", "ID_OBJECT": "S221EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "\"La reliquia è mia! Andiamo, alla fonte magica!\"", "SEQ_NUM": 0},
