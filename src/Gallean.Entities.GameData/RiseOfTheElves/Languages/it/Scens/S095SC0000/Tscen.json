    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0000",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar T1",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0000",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar il Viaggiatore\n\u0022Salve, mio Signore! Sono contento di vedere che siete in salvo. L\u0027inquisitore Philip d\u0027Agincourt vi sta aspettando nella citt\u00E0 di Fhindar a Nord. Vi guider\u00F2 io...\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0023",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Lanciere",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0001",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar T2",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar il Viaggiatore \n \u0022Attenzione! Questi fiumi sono abitati da streghe marine che attaccano i viaggiatori imprudenti! Non state nell\u0027acqua!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0024",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0002",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar Morto",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0025",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0026",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0003",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar Centro 1",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0003",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Lanciere\n\u0022Mi spiace Nobar... Tranne te, nessuno pu\u00F2 passare. Ordini di Philip!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0027",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0004",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar Centro 2",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Lanciere \n\u0022Saluti, Nobar. Tranne te, nessuno pu\u00F2 passare da qui. Questi sono gli ordini di Philip d\u0027Agincourt...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0005",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Ragno vaga T10",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0028",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0029",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0007",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Esercito di Hubert T30",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0007",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hubert de Lalye\n\u0022Hai gradito i miei vellutati amici? Avresti dovuto unirti a me come gli altri... Ora morirai, e Fhindar sar\u00E0 mia! Ha ha aha ha... \u0022",
      "SEQ_NUM": 3
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0007",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Esploratore \n\u0022Padrone, dobbiamo fermare Hubert de Lalye prima che catturi la citt\u00E0 di Fhindar!\u0022",
      "SEQ_NUM": 5
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0007",
      "ID_STRING": "OBJECT_TXT",
      "TEXT": "Distruggi Hubert de Lalye prima che catturi la citt\u00E0 di Fhindar. Uther deve sopravvivere.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0008",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Ragni vagano T20",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0008",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Esploratore\n\u0022Qualcosa sta spingendo i ragni fuori dalle loro tane! I nostri esploratori videro del fumo uscire dalla Foresta di Seta... Chi pu\u00F2 aver fatto una cosa simile?\u0022",
      "SEQ_NUM": 5
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0009",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Uther Arrivo T33",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0009",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Uther\n\u0022Purificher\u00F2 l\u0027Impero umano dalla tua immonda genia, Hubert de Lalye! Preparati a morire... restituir\u00F2 l\u0027Impero umano al suo legittimo proprietario!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0009",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hubert de Lalye \n\u0022Un ragazzo?! Ha ha ha! Ecco tutto quello che ha l\u0027Impero umano per proteggersi! Demostene \u00E8 un codardo...\u0022",
      "SEQ_NUM": 4
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN002c",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Lanciere",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Avvertimento del Bosco di Seta",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000a",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar il Viaggiatore\n\u0022Quei boschi sono chiamati Boschi di Seta. Pochi si avventurano in quelle zone, poich\u00E9 temono le selvaggie creature che si aggirano in quei luoghi...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN002d",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN002e",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000c",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Entra a Fhindar",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000c",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar il Viaggiatore\n\u0022Fhindar \u00E8 vicina! Dovete andare a Ovest. C\u0027\u00E8 pi\u00F9 di un passaggio che porta laggi\u00F9...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN002f",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Lanciere",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000d",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar T5",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000d",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar il Viaggiatore\n\u0022Philip d\u0027Agincourt \u00E8 molto prudente... Ha bloccato tutti i passaggi per Fhindar. Spero che vi lasci passare!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0030",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0031",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000e",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Lanciere basso muore",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0032",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV000f",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Lanciere alto muore",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0010",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Vittoria Missione (Uccidere Hubert)",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0010",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hubert de Lalye\n\u0022Tu... tu... mi hai sconfitto! Com\u0027\u00E8 possibile? Che tu sia dannato, Uther!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0010",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Uther \n\u0022Tutti i nemici dell\u0027Impero umano subiranno lo stesso destino. Aiuter\u00F2 mio padre a riportare la pace nel regno di Nevendaar!\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0034",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Orso polare",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0011",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Hubert Vince",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0011",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Hubert de Lalye\n\u0022Ha ha ha! Ora che possiedo la citt\u00E0 di Fhindar non potrete mai resistermi... l\u0027arrivo di Uther non \u00E8 servito a nulla!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0012",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Testo della citt\u00E0 di Rocca di Khazan",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0012",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Arciere\n\u0022Molti pescatori sono scomparsi in mare... I contadini pensano che siano stati divorati da creature marine!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0036",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Sirena",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0013",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Testo della citt\u00E0 di Silveria",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0013",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Lanciere\n\u0022Fhindar \u00E8 un po\u0027 pi\u00F9 a Nord. Speriamo che l\u0027Imperatore vinca questa guerra... Hubert ha inviato la milizia per mettere al sicuro tutte le citt\u00E0 in queste terre!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0014",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Mossa Lofemyr T8",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0037",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN0038",
      "ID_STRING": "NAME_TXT",
      "TEXT": null,
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0017",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Nobar T30",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0017",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Nobar il Viaggiatore\n\u0022Philip d\u0027Agincourt vi ha intrappolato! Era tutto un trucco, dunque siate cauto mio Signore...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN003a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Kraken",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0018",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Uther Muore",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0018",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Chierico\n\u0022Cosa abbiamo fatto? Uther, il figlio perduto dell\u0027Imperatore, \u00E8 morto! Ora l\u0027Impero umano \u00E8 condannato!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0019",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Area di Fhindar",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0019",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Uther\n\u0022Vengo in nome di mio padre! Io sono Uther, erede di Nevendaar. Unitevi alla mia battaglia contro i nemici del nostro Impero! Io purificher\u00F2 il reame dalla tua lurida specie, de Lalye! Preparati a morire...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095EV0019",
      "ID_STRING": "OBJECT_TXT",
      "TEXT": "Distruggi Hubert de Lalye. Uther non deve morire.",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S095SC0000",
      "ID_OBJECT": "S095UN003c",
