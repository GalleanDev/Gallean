      "TEXT": "Kraken",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0022",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Sirena",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0000",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Avvertimento rituale",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0000",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Stregone\n\r\u0022Padrone! Ci sono strane forze occulte al lavoro qui... un rituale sta invocando demoni per attaccarci! Dobbiamo chiudere il cancello infernale...\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0024",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Sirena",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0001",
      "ID_STRING": "NAME_TXT",
      "TEXT": "T 1 Dramma",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Consigliere \n\u0022I nostri esploratori hanno setacciato i dintorni cercando i Non Morti... non \u00E8 stata trovata nessuna delle loro forze.\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Bethrezen\n\u0022\u00C8 ovvio che in queste terre non ci sono Non Morti...\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Consigliere \n\u0022Cosa intendete, Padron Bethrezen? Non siamo forse venuti in questo posto per tendere un\u0027imboscata!?\u0022",
      "SEQ_NUM": 2
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Uther\n\u0022Io non sono Bethrezen...\u0022",
      "SEQ_NUM": 3
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Consigliere \n\u0022Non sei Bethrezen!? Ma... tutto questo tempo... cosa significa?\u0022",
      "SEQ_NUM": 4
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0001",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Uther\n\u0022Presto capirete meglio... Asteroth! Schiaccia questi demoni dei piani inferiori. Non ci servono pi\u00F9, giusto?!\u0022",
      "SEQ_NUM": 5
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0002",
      "ID_STRING": "NAME_TXT",
      "TEXT": "T 1-2 Dramma",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0002",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Asteroth\n\u0022S\u00EC, domineremo assieme! Non saranno in grado di sfidarci!\u0022",
      "SEQ_NUM": 1
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0002",
      "ID_STRING": "OBJECT_TXT",
      "TEXT": "Distruggi il signore dei demoni Asteroth",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN0027",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Sirena",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0004",
      "ID_STRING": "NAME_TXT",
      "TEXT": "T 1-3 Dramma",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Diavolo degli abissi \n\u0022Demoni servitori... non abbiamo pi\u00F9 bisogno di voi!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0004",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Diavolo degli abissi \n\u0022Siamo col nostro vero padrone Bethrezen! Vi far\u00E0 pagare per il vostro tradimento...\u0022",
      "SEQ_NUM": 4
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0006",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Testo della citt\u00E0 di Gromdam",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0006",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Tiratore scelto \n\u0022Non sapete quando \u00E8 ora di smettere, Demoni? Uther dominer\u00E0 queste terre, e voi sarete costretti a farvi da parte!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0007",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Testo della citt\u00E0 di Rottudam",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0007",
      "ID_STRING": "POPUP_TXT",
      "TEXT": "Cavaliere \n\u0022State indietro, Demoni! Attendiamo il nostro salvatore Uther... Quando arriver\u00E0, pagherete per la vostra intrusione!\u0022",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105UN002a",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Gargoyle di onice",
      "SEQ_NUM": 0
    },
    {
      "NO_SCEN": "S105SC0000",
      "ID_OBJECT": "S105EV0008",
      "ID_STRING": "NAME_TXT",
      "TEXT": "Progenie demoniaca",
      "SEQ_NUM": 0
    },
