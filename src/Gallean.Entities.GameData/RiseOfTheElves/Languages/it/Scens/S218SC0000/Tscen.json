    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0000", "ID_STRING": "NAME_TXT", "TEXT": "Legions Day 1", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Modeus\n\"È giunta l'ora. Gli umani si distruggono da sé, ma c'è ancora della purezza nelle altre razze. Scacciamo gli elfi dai loro boschi!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Succubus\n\"Ma i boschi sono estesi, come pensi di trovarli tutti?\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Modeus\n\"Per quello ho chiamato il fratello Fareum, ma il tempo stringe: il suo potere si estingue poco a poco lontano dall'inferno. Lui si occuperà di utilizzare obelischi oscuri per bruciare i boschi degli elfi.\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0000", "ID_STRING": "POPUP_TXT", "TEXT": "Fareum\n\"Si, sento la sua presenza. Sono lontani da qui, verso Sud. Devo partire immediatamente.\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0001", "ID_STRING": "NAME_TXT", "TEXT": "Legions Fareum Slain", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0001", "ID_STRING": "POPUP_TXT", "TEXT": "Fareum\n\"Torno subito, mio signore!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0002", "ID_STRING": "NAME_TXT", "TEXT": "Legions Burn1 ", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0002", "ID_STRING": "POPUP_TXT", "TEXT": "Fareum\n\"Bruciate!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0003", "ID_STRING": "NAME_TXT", "TEXT": "Legions Burn2", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0003", "ID_STRING": "POPUP_TXT", "TEXT": "Fareum\n\"Ah ah ah!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0004", "ID_STRING": "NAME_TXT", "TEXT": "Legions Burn3", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0004", "ID_STRING": "POPUP_TXT", "TEXT": "Fareum\n\"Che spettacolo queste fiamme!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0005", "ID_STRING": "NAME_TXT", "TEXT": "Legions Burn4", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0005", "ID_STRING": "POPUP_TXT", "TEXT": "Fareum\n\"Dove siete, piccoli? Forse questo vi farà uscire...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0006", "ID_STRING": "NAME_TXT", "TEXT": "Legions Burn5 ", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0006", "ID_STRING": "POPUP_TXT", "TEXT": "Fareum\n\"AH!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0007", "ID_STRING": "NAME_TXT", "TEXT": "Legions Win", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0007", "ID_STRING": "POPUP_TXT", "TEXT": "Modeus\n\"Fareum ci è riuscito! Guarda come scappano verso il territorio dei clan! Bethrezen ti ricompenserà per questa vittoria!\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0009", "ID_STRING": "NAME_TXT", "TEXT": "Legions DemonProgress1", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000a", "ID_STRING": "NAME_TXT", "TEXT": "Legions DemonProgress2", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000b", "ID_STRING": "NAME_TXT", "TEXT": "Legions DemonProgress3", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000c", "ID_STRING": "NAME_TXT", "TEXT": "Legions DemonProgress4", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000d", "ID_STRING": "NAME_TXT", "TEXT": "Legions DemonProgress5", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000e", "ID_STRING": "NAME_TXT", "TEXT": "Clans Day1", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Re dei nani\n\"Gli sporchi elfi marciano verso qui per ordine del loro corrotto dio. Dobbiamo prepararci per l'invasione.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Spia\n\"Signore, anche i dannati si avvicinano! Forse si saranno alleati per attaccarci? Non possiamo respingere entrambi gli eserciti... Sempre se non ...\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Re dei nani\n\"Non so cosa pensi di proporre, so solo che non mi piace.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Alchimista\n\"Ne abbiamo parlato... Possiamo elaborare una terribile pozione che ci permetta di avvelenare gli eserciti nemici nelle loro stesse case.\"", "SEQ_NUM": 3},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Furfante\n\"A Nordest c'è una fontana di sostanze putrefatte. Qualsiasi cosa gli stia attorno perisce. Se riusciamo ad estrarre veleno a sufficienza dal suo interno, potremo infettare le acque della capitale elfica.\"", "SEQ_NUM": 4},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Alchimista\n\"Sono sicuro che questa sostanza debiliterà i demoni se riusciamo a versarla nel suo pozzo impuro.\"", "SEQ_NUM": 5},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Re dei nani\n\"Allora avanti. La persona che si occuperà di estrarre il veleno di sicurò si ammalerà... Ma sarà un nobile sacrificio.\"", "SEQ_NUM": 6},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000e", "ID_STRING": "POPUP_TXT", "TEXT": "Alchimista\n\"Ho preparato vari contenitori speciali per trasportare il veleno. Non appena avremo il primo campione, io stesso sarò in grado di elaborare una pozione identica di veleno.\"", "SEQ_NUM": 7},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000f", "ID_STRING": "NAME_TXT", "TEXT": "Clans FillPoison", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV000f", "ID_STRING": "POPUP_TXT", "TEXT": "Alchimista\n\"Ottimo lavoro! Con questa primo campione potremo riempire tutti contenitori con lo stesso veleno.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0010", "ID_STRING": "NAME_TXT", "TEXT": "Clans PoisonElves", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Alchimista\n\"Ecco il pozzo! Presto, rovesceremo il veleno!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0010", "ID_STRING": "POPUP_TXT", "TEXT": "Furfante\n\"Fatto! Adesso, andiamo via da questo dannato bosco.\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0011", "ID_STRING": "NAME_TXT", "TEXT": "Clans PoisonLegions", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Alchimista\n\"Che  posto sinistro! Presto, versate il veleno nel pozzo.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0011", "ID_STRING": "POPUP_TXT", "TEXT": "Furfante\n\"Sta funzionando! I demoni sono stati contagiati... Fuggiamo prima che ci vedano!\"", "SEQ_NUM": 2},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0012", "ID_STRING": "NAME_TXT", "TEXT": "Clans Win", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Alchimista\n\"Entrambi gli eserciti sono stati avvelenati, signore. Nel giro di poco cadranno come mosche!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0012", "ID_STRING": "POPUP_TXT", "TEXT": "Re dei nani\n\"Buon lavoro, guerrieri.\"", "SEQ_NUM": 1},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0013", "ID_STRING": "NAME_TXT", "TEXT": "Clans StartAI", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0015", "ID_STRING": "NAME_TXT", "TEXT": "Clans Equip Rudmer", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0016", "ID_STRING": "NAME_TXT", "TEXT": "Clans RudmerTemp Killed", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0018", "ID_STRING": "NAME_TXT", "TEXT": "ClansProgress1", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0019", "ID_STRING": "NAME_TXT", "TEXT": "ClansProgress2", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV001a", "ID_STRING": "NAME_TXT", "TEXT": "Clans Move 1st Rudmer", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV001b", "ID_STRING": "NAME_TXT", "TEXT": "Clans Day2", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV001c", "ID_STRING": "NAME_TXT", "TEXT": "Clans Day3", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV001d", "ID_STRING": "NAME_TXT", "TEXT": "Elves Standing LessThn5", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV001d", "ID_STRING": "POPUP_TXT", "TEXT": "Illuminato\n\"Non possiamo continuare a mandare i nostri figli alla tomba! Non li consegneremo al bosco senza opporre resistenza!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV001d", "ID_STRING": "OBJECT_TXT", "TEXT": "I dannati devono portare Fareum ai cinque obelischi che si trovano sul territorio elfico.\nGli elfi sono stati sconfitti.\nI nani devono avvelenare i pozzi dei loro due nemici.", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV001e", "ID_STRING": "NAME_TXT", "TEXT": "Elves Day 4", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV001f", "ID_STRING": "NAME_TXT", "TEXT": "Elves Day 6", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0020", "ID_STRING": "NAME_TXT", "TEXT": "Elves Day 8", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0021", "ID_STRING": "NAME_TXT", "TEXT": "Elves Day 12", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0000", "ID_STRING": "TXT_TITLE", "TEXT": "Torre del mago", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0000", "ID_STRING": "TXT_DESC", "TEXT": "Le quesssstioni dei mortali non ci riguardano. Perché ci disssstrai?", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0022", "ID_STRING": "NAME_TXT", "TEXT": "Elves Prog Mure'esh", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0022", "ID_STRING": "POPUP_TXT", "TEXT": "Mure'esh\n\"Io rimarrò qui.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0001", "ID_STRING": "TXT_TITLE", "TEXT": "Torre del mago", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0001", "ID_STRING": "TXT_DESC", "TEXT": "Abbiamo una bizzarra collezione di incantesimi da insegnare, di sicuro ne farai buon uso.", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0023", "ID_STRING": "NAME_TXT", "TEXT": "Elves Prog Dereni'il", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0023", "ID_STRING": "POPUP_TXT", "TEXT": "Dereni'il\n\"Sono riuscito ad arrivare indenne.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0002", "ID_STRING": "TXT_TITLE", "TEXT": "Accampamento militare", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0002", "ID_STRING": "TXT_DESC", "TEXT": "Ho lavorato con soldati buoni e cattivi. E alla fine, erano tutti migliorati.", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0024", "ID_STRING": "NAME_TXT", "TEXT": "Elves Prog Erenlus", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0024", "ID_STRING": "POPUP_TXT", "TEXT": "Erenlus\n\"Non è stato poi così difficile.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0003", "ID_STRING": "TXT_TITLE", "TEXT": "Campo mercenario", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0003", "ID_STRING": "TXT_DESC", "TEXT": "Ti offro delle bestie che stiano al tuo servizio. Sono bestie, ma leali.", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0025", "ID_STRING": "NAME_TXT", "TEXT": "Elves Prog Gremech", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0025", "ID_STRING": "POPUP_TXT", "TEXT": "Gremech \n\"Eccomi qui, proprio come mi avevano ordinato.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0004", "ID_STRING": "TXT_TITLE", "TEXT": "Mercante", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0004", "ID_STRING": "TXT_DESC", "TEXT": "La mia specialità è la gioielleria, ma dai un'occhiata senza impegno.", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0026", "ID_STRING": "NAME_TXT", "TEXT": "Elves Prog Sommech", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0026", "ID_STRING": "POPUP_TXT", "TEXT": "Sommech \n\"È qui.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0005", "ID_STRING": "TXT_TITLE", "TEXT": "Mercante", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218SI0005", "ID_STRING": "TXT_DESC", "TEXT": "Recuperiamo un sacco di oggetti utili quando gli eserciti passano da qui.", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0027", "ID_STRING": "NAME_TXT", "TEXT": "Elves Prog Pelumnus", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0027", "ID_STRING": "POPUP_TXT", "TEXT": "Pelemnus \n\"Fatto.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0028", "ID_STRING": "NAME_TXT", "TEXT": "Elves Prog Osbil", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0028", "ID_STRING": "POPUP_TXT", "TEXT": "Osbil \n\"L'altare dei nani. Dev'essere qui!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0029", "ID_STRING": "NAME_TXT", "TEXT": "Elves Prog Furennsil", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV0029", "ID_STRING": "POPUP_TXT", "TEXT": "Furennsil \n\"Ci sono riuscito!\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV002a", "ID_STRING": "NAME_TXT", "TEXT": "Elves Prog Belenesh", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV002a", "ID_STRING": "POPUP_TXT", "TEXT": "Belenesh \n\"Io aspetterò qui.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV002b", "ID_STRING": "NAME_TXT", "TEXT": "Elves Win Ruin", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV002b", "ID_STRING": "POPUP_TXT", "TEXT": "Reina Illenese\n\"Per Gallean, ci sono riusciti! Ricostruiremo le nostre dimore sul territorio dei clan.\"", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218EV002c", "ID_STRING": "NAME_TXT", "TEXT": "Elves Win Time", "SEQ_NUM": 0},
