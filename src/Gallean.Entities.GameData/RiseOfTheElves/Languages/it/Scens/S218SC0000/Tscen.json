    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218PL0001", "ID_STRING": "NAME_TXT", "TEXT": "Radulf", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218PL0001", "ID_STRING": "DESC_TXT", "TEXT": "Supremo signore dei clan nani, è noto per il suo valore nell'affrontare nemici più forti. Si narra che abbia combattuto per sette giorni e sette notti contro il possente drago Arfuruzon, riusciendo in fine a sconfiggerlo.", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218UN0018", "ID_STRING": "NAME_TXT", "TEXT": "Pelumnus", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218PL0002", "ID_STRING": "NAME_TXT", "TEXT": "Abraal", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218PL0002", "ID_STRING": "DESC_TXT", "TEXT": "Qualsiasi bambino trema al sentire questo nome infame. Questo signore dell'inferno è noto per la sua sete di sangue e crudeltà. Si dice che un tempo divorò 1000 schiavi ad un banchetto dato da Bethrezen per una vittoria contro il regno della luce.", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218UN0019", "ID_STRING": "NAME_TXT", "TEXT": "Gremech", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218PL0003", "ID_STRING": "NAME_TXT", "TEXT": "Kera'anil", "SEQ_NUM": 0},
    {"NO_SCEN": "S218SC0000", "ID_OBJECT": "S218PL0003", "ID_STRING": "DESC_TXT", "TEXT": "Un veterano guerriero della causa elfica; nessuno può entrare nel bosco senza il suo permesso.", "SEQ_NUM": 0},
