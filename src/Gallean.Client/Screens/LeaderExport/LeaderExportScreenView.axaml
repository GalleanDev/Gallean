<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Gallean.Client"
             x:Class="Gallean.Client.LeaderExportScreenView"
             x:DataType="local:LeaderExportScreenViewModel">

  <UserControl.Styles>
    <Style Selector="Border.item-row">
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{StaticResource CardBackgroundGradientBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    </Style>
  </UserControl.Styles>

  <Border Background="{StaticResource ModalBackdropBrush}">
    <local:ModalPanel Width="820" MaxHeight="680" Padding="20,16,20,24" Title="{local:Text 'Export leader'}" InitialFocus="{Binding #ExportButton}">

      <local:ModalPanel.Footer>
        <Grid ColumnDefinitions="*,Auto,Auto">
          <Button Grid.Column="1"
                  Content="{local:Text 'Back'}"
                  Classes="pill"
                  local:PlateChrome.TextureSeed="1"
                  MinWidth="110"
                  VerticalAlignment="Center"
                  Command="{Binding CloseCommand}"
                  Margin="0,0,12,0" />
          <Button x:Name="ExportButton"
                  Grid.Column="2"
                  Content="{local:Text 'Continue'}"
                  Classes="pill success"
                  local:PlateChrome.TextureSeed="2"
                  MinWidth="160"
                  VerticalAlignment="Center"
                  Command="{Binding ExportCommand}" />
        </Grid>
      </local:ModalPanel.Footer>

      <Grid ColumnDefinitions="2*,24,3*" RowDefinitions="Auto,*">

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="3"
                   Text="{Binding Instruction}"
                   Classes="body"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12" />

        <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,*">
          <local:OutlinedTextBlock Grid.Row="0" Text="{local:Text 'Leader'}" Classes="label" Margin="0,0,0,8" />
          <ListBox Grid.Row="1" Classes="select-list" ItemsSource="{Binding Leaders}" SelectedItem="{Binding SelectedLeader}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:LeaderExportLeaderViewModel">
                <Border Classes="row">
                  <Grid ColumnDefinitions="56,*">
                    <local:UnitIcon Grid.Column="0" SpriteKey="{Binding PortraitKey}" Width="56" Height="56" />
                    <StackPanel Grid.Column="1" Spacing="4" Margin="12,0,0,0" VerticalAlignment="Center">
                      <local:OutlinedTextBlock Classes="object-name row" TextTrimming="CharacterEllipsis"><Run Text="{Binding Name}" /><Run Text="  " /><Run Classes="row-level" Text="{Binding LevelText}" /></local:OutlinedTextBlock>
                      <TextBlock Text="{Binding BattlesWonText}"
                                 Classes="caption"
                                 Foreground="{StaticResource SecondaryTextBrush}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,*">
          <local:OutlinedTextBlock Grid.Row="0" Text="{Binding ItemsTitle}" Classes="label" Margin="0,0,0,8" />
          <ScrollViewer Classes="list" Grid.Row="1" MinHeight="300" VerticalScrollBarVisibility="Auto">
            <ItemsControl Classes="focus-group" Padding="0,6,12,6" ItemsSource="{Binding Items}">
              <local:Blankslate.Content>
                <TextBlock Text="{local:Text 'No items can be brought to the next quest.'}"
                           Classes="body"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,10" />
              </local:Blankslate.Content>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:LeaderExportItemViewModel">
                  <Border Classes="item-row">
                    <Grid ColumnDefinitions="64,*,Auto">
                      <Border Grid.Column="0" Classes="frame" Width="64" Height="64" BorderThickness="2">
                        <local:SpriteVisual SpriteKey="{Binding IconKey}" Stretch="Uniform" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" Spacing="2">
                        <local:OutlinedTextBlock Text="{Binding Name}" Classes="object-name row" TextWrapping="Wrap" />
                        <TextBlock local:TextRuns.Spans="{Binding CountText}"
                                   Classes="caption"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <ContentControl Content="{Binding Price}" Classes="caption" Foreground="{StaticResource PrimaryTextBrush}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Classes="icon-button" Command="{Binding RemoveCommand}">
                          <local:IconVisual Moniker="Minus" />
                        </Button>
                        <TextBlock Text="{Binding Selected}"
                                   Classes="body"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   MinWidth="20"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Button Classes="icon-button" Command="{Binding AddCommand}">
                          <local:IconVisual Moniker="Plus" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>

      </Grid>

    </local:ModalPanel>
  </Border>

</UserControl>
