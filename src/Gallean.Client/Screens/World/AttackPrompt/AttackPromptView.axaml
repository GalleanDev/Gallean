<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Gallean.Client"
             x:Class="Gallean.Client.AttackPromptView"
             x:DataType="local:AttackPromptViewModel">

  <Border Background="{StaticResource ModalBackdropBrush}">
    <local:ModalPanel Classes="accent" Width="520" Padding="28,10,28,24" Title="{local:Text 'Confirm the attack'}" InitialFocus="{Binding #AttackButton}">

      <local:ModalPanel.Footer>
        <Grid ColumnDefinitions="*,Auto,Auto,*">
          <Button x:Name="AttackButton"
                  Grid.Column="1"
                  Content="{local:Text 'Attack'}"
                  Classes="pill primary"
                  local:PlateChrome.TextureSeed="1"
                  Command="{Binding ConfirmCommand}"
                  MinWidth="150"
                  Margin="0,0,16,0" />
          <Button Grid.Column="2"
                  Content="{local:Text 'Cancel'}"
                  Classes="pill"
                  local:PlateChrome.TextureSeed="2"
                  Command="{Binding CloseCommand}"
                  MinWidth="150" />
        </Grid>
      </local:ModalPanel.Footer>

      <StackPanel Spacing="16">
        <local:SpriteVisual SpriteKey="{Binding PortraitKey}"
                            IsVisible="{Binding PortraitKey, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Height="280"
                            Margin="0,0,0,-14"
                            HorizontalAlignment="Center"
                            Stretch="Uniform" />
        <Border IsVisible="{Binding !IsTargetKnown}"
                Margin="0,26,0,12"
                Width="88"
                Height="88"
                CornerRadius="44"
                HorizontalAlignment="Center"
                Background="{StaticResource WindowBackgroundBrush}"
                BorderBrush="{StaticResource ModalPortraitFrameBrush}"
                BorderThickness="1">
          <local:IconVisual Moniker="Unknown"
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SecondaryTextBrush}" />
        </Border>
        <TextBlock Classes="body"
                   Foreground="{StaticResource PrimaryTextBrush}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   local:TextRuns.Spans="{Binding Message}" />
      </StackPanel>

    </local:ModalPanel>
  </Border>

</UserControl>
