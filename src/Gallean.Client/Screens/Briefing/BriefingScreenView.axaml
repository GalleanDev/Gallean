<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Gallean.Client"
             x:Class="Gallean.Client.BriefingScreenView"
             x:DataType="local:BriefingScreenViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Enter" Command="{Binding ContinueCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <Style Selector="Grid.briefing-column">
      <Setter Property="MaxWidth" Value="760" />
      <Setter Property="Margin" Value="48,36" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.briefing-column.video">
      <Setter Property="MaxWidth" Value="560" />
      <Setter Property="Margin" Value="48,36,72,36" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector=":is(Control).briefing-text">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="SineEaseInOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector=":is(Control).briefing-text.hidden">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
  </UserControl.Styles>

  <Grid Background="{StaticResource ScenarioSelectBackdropBrush}" ClipToBounds="True">

    <ContentControl Content="{Binding Background}">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="local:MenuBackgroundViewModel">
          <local:CoverBoxDecorator Classes="menu-background">
            <local:MenuBackgroundView />
          </local:CoverBoxDecorator>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <local:VideoVisual AnimationKey="{Binding Video}"
                       Rate="{x:Static local:AnimationRate.BriefingVideo}"
                       StartTime="{Binding VideoStartTime}"
                       Stretch="UniformToFill"
                       Grain="0.05" />

    <Panel Classes="briefing-text" Classes.hidden="{Binding !IsTextVisible}" IsHitTestVisible="False">
      <Border Background="{StaticResource ModalBackdropBrush}" IsVisible="{Binding !HasVideo}" />

      <Border Background="{StaticResource BriefingVideoBorderGradientBrush}" IsVisible="{Binding HasVideo}" />
    </Panel>

    <Grid RowDefinitions="*,Auto" Classes="briefing-column" Classes.video="{Binding HasVideo}">

      <Grid Grid.Row="0" RowDefinitions="Auto,Auto,Auto,*,Auto" Classes="briefing-text" Classes.hidden="{Binding !IsTextVisible}">

        <local:AnimatedTextBlock Grid.Row="0"
                                 Text="{local:Text 'Briefing'}"
                                 Classes="label"
                                 HorizontalAlignment="Center"
                                 Reveal="{x:Static local:AnimatedTextReveal.SmokeWords}"
                                 SmokeColor="{x:Static local:Theme+Briefing.SmokeColor}" />

        <local:AnimatedTextBlock Grid.Row="1"
                                 Text="{Binding Title}"
                                 Classes="display"
                                 Foreground="{StaticResource HighlightTextBrush}"
                                 TextWrapping="Wrap"
                                 TextAlignment="Center"
                                 HorizontalAlignment="Center"
                                 Margin="0,10,0,0"
                                 Reveal="{x:Static local:AnimatedTextReveal.SmokeGlyphs}"
                                 SmokeColor="{x:Static local:Theme+Briefing.SmokeColor}"
                                 RevealDelay="0:0:0.1"
                                 GlowColor="{x:Static local:Theme+Briefing.EmberColor}" />

        <local:OrnamentDivider Grid.Row="2"
                               Width="300"
                               Stroke="{StaticResource ModalOrnamentBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,0" />

        <ScrollViewer Grid.Row="3"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      VerticalAlignment="Center"
                      Margin="0,20,0,0">
          <ScrollViewer.OpacityMask>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Offset="0" Color="Transparent" />
              <GradientStop Offset="0.05" Color="Black" />
              <GradientStop Offset="0.95" Color="Black" />
              <GradientStop Offset="1" Color="Transparent" />
            </LinearGradientBrush>
          </ScrollViewer.OpacityMask>
          <local:AnimatedTextBlock x:Name="BriefingText"
                                   local:ScenarioText.Spans="{Binding Briefing}"
                                   Classes="prose"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   Margin="16,16,24,16"
                                   Reveal="{x:Static local:AnimatedTextReveal.SmokeWords}"
                                   SmokeColor="{x:Static local:Theme+Briefing.SmokeColor}"
                                   RevealDelay="0:0:0.7"
                                   GlowColor="{x:Static local:Theme+Briefing.EmberColor}" />
        </ScrollViewer>

        <Grid Grid.Row="4" Margin="0,28,0,0" HorizontalAlignment="Center">
          <Border Background="{StaticResource BriefingBackdropGradientBrush}" Margin="-160,-36" IsHitTestVisible="False" />

          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto,*" HorizontalAlignment="Center">
              <Rectangle Grid.Column="0"
                         Width="96"
                         Height="1"
                         Fill="{StaticResource BriefingRuleLeadingGradientBrush}"
                         VerticalAlignment="Center"
                         Margin="0,0,16,0" />
              <local:AnimatedTextBlock Grid.Column="1"
                                       Text="{local:Text 'Objective'}"
                                       Classes="label"
                                       Reveal="{x:Static local:AnimatedTextReveal.SmokeWords}"
                                       SmokeColor="{x:Static local:Theme+Briefing.SmokeColor}"
                                       RevealDelay="0:0:0.9" />
              <Rectangle Grid.Column="2"
                         Width="96"
                         Height="1"
                         Fill="{StaticResource BriefingRuleTrailingGradientBrush}"
                         VerticalAlignment="Center"
                         Margin="16,0,0,0" />
            </Grid>

            <local:AnimatedTextBlock Text="{Binding Objective}"
                                     Classes="h1"
                                     Foreground="{StaticResource HighlightTextBrush}"
                                     TextWrapping="Wrap"
                                     TextAlignment="Center"
                                     HorizontalAlignment="Center"
                                     Reveal="{x:Static local:AnimatedTextReveal.SmokeGlyphs}"
                                     SmokeColor="{x:Static local:Theme+Briefing.SmokeColor}"
                                     RevealDelay="{Binding #BriefingText.RevealEnd}"
                                     GlowColor="{x:Static local:Theme+Briefing.EmberColor}">
              <local:AnimatedTextBlock.Effect>
                <DropShadowEffect OffsetX="0"
                                  OffsetY="0"
                                  BlurRadius="16"
                                  Color="{x:Static local:Theme+Briefing.ObjectiveShadowColor}" />
              </local:AnimatedTextBlock.Effect>
            </local:AnimatedTextBlock>
          </StackPanel>
        </Grid>
      </Grid>

      <StackPanel Grid.Row="1" Classes="focus-group pill-group" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
        <Button Classes="pill"
                local:PlateChrome.TextureSeed="1"
                Content="{Binding ToggleTextLabel}"
                Command="{Binding ToggleTextCommand}"
                IsVisible="{Binding HasVideo}"
                Width="200" />
        <Button Classes="pill success"
                local:PlateChrome.TextureSeed="2"
                Content="{local:Text 'Continue'}"
                Command="{Binding ContinueCommand}"
                Width="240" />
      </StackPanel>
    </Grid>
  </Grid>

</UserControl>
