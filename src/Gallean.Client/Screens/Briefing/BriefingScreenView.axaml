<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Gallean.Client"
             x:Class="Gallean.Client.BriefingScreenView"
             x:DataType="local:BriefingScreenViewModel">

  <Grid Background="{StaticResource ScenarioSelectBackdropBrush}" ClipToBounds="True">

    <ContentControl Content="{Binding Background}">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="local:MenuBackgroundViewModel">
          <local:CoverBoxDecorator Classes="menu-background">
            <local:MenuBackgroundView />
          </local:CoverBoxDecorator>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <Border Background="{StaticResource ModalBackdropBrush}" IsHitTestVisible="False" />

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" MaxWidth="760" Margin="48,36" HorizontalAlignment="Center">

      <local:AnimatedTextBlock Grid.Row="0"
                               Text="{local:Text 'Briefing'}"
                               Classes="label"
                               HorizontalAlignment="Center"
                               Reveal="{x:Static local:AnimatedTextReveal.SmokeWords}"
                               SmokeColor="{x:Static local:Theme+Briefing.SmokeColor}" />

      <local:AnimatedTextBlock Grid.Row="1"
                               Text="{Binding Title}"
                               Classes="display"
                               Foreground="{StaticResource HighlightTextBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"
                               Reveal="{x:Static local:AnimatedTextReveal.SmokeGlyphs}"
                               SmokeColor="{x:Static local:Theme+Briefing.SmokeColor}"
                               RevealDelay="0:0:0.1"
                               GlowColor="{x:Static local:Theme+Briefing.EmberColor}" />

      <local:OrnamentDivider Grid.Row="2"
                             Width="300"
                             Stroke="{StaticResource ModalOrnamentBrush}"
                             HorizontalAlignment="Center"
                             Margin="0,18,0,0" />

      <ScrollViewer Grid.Row="3"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalAlignment="Center"
                    Margin="0,20,0,0">
        <ScrollViewer.OpacityMask>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="Transparent" />
            <GradientStop Offset="0.05" Color="Black" />
            <GradientStop Offset="0.95" Color="Black" />
            <GradientStop Offset="1" Color="Transparent" />
          </LinearGradientBrush>
        </ScrollViewer.OpacityMask>
        <local:AnimatedTextBlock x:Name="BriefingText"
                                 local:ScenarioText.Spans="{Binding Briefing}"
                                 Classes="prose"
                                 Foreground="{StaticResource PrimaryTextBrush}"
                                 Margin="16,16,24,16"
                                 Reveal="{x:Static local:AnimatedTextReveal.SmokeWords}"
                                 SmokeColor="{x:Static local:Theme+Briefing.SmokeColor}"
                                 RevealDelay="0:0:0.7"
                                 GlowColor="{x:Static local:Theme+Briefing.EmberColor}" />
      </ScrollViewer>

      <Grid Grid.Row="4" Margin="0,28,0,0" HorizontalAlignment="Center">
        <Border Background="{StaticResource BriefingBackdropGradientBrush}" Margin="-160,-36" IsHitTestVisible="False" />

        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto,*" HorizontalAlignment="Center">
            <Rectangle Grid.Column="0"
                       Width="96"
                       Height="1"
                       Fill="{StaticResource BriefingRuleLeadingGradientBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0" />
            <local:AnimatedTextBlock Grid.Column="1"
                                     Text="{local:Text 'Objective'}"
                                     Classes="label"
                                     Reveal="{x:Static local:AnimatedTextReveal.SmokeWords}"
                                     SmokeColor="{x:Static local:Theme+Briefing.SmokeColor}"
                                     RevealDelay="0:0:0.9" />
            <Rectangle Grid.Column="2"
                       Width="96"
                       Height="1"
                       Fill="{StaticResource BriefingRuleTrailingGradientBrush}"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0" />
          </Grid>

          <local:AnimatedTextBlock Text="{Binding Objective}"
                                   Classes="h1"
                                   Foreground="{StaticResource HighlightTextBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Reveal="{x:Static local:AnimatedTextReveal.SmokeGlyphs}"
                                   SmokeColor="{x:Static local:Theme+Briefing.SmokeColor}"
                                   RevealDelay="{Binding #BriefingText.RevealEnd}"
                                   GlowColor="{x:Static local:Theme+Briefing.EmberColor}">
            <local:AnimatedTextBlock.Effect>
              <DropShadowEffect OffsetX="0"
                                OffsetY="0"
                                BlurRadius="16"
                                Color="{x:Static local:Theme+Briefing.ObjectiveShadowColor}" />
            </local:AnimatedTextBlock.Effect>
          </local:AnimatedTextBlock>
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="5" Classes="focus-group" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,32,0,0">
        <Button Classes="pill primary"
                local:PlateChrome.TextureSeed="2"
                Content="{local:Text 'Continue'}"
                Command="{Binding ContinueCommand}"
                Width="240" />
      </StackPanel>
    </Grid>
  </Grid>

</UserControl>
