<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Gallean.Client"
             x:Class="Gallean.Client.ManagementScreenView"
             x:Name="Screen"
             x:DataType="local:ManagementScreenViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Q" Command="{Binding SelectPreviousTabCommand}" />
    <KeyBinding Gesture="E" Command="{Binding SelectNextTabCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Resources>
    <DataTemplate x:Key="ManagementTabTemplate" x:DataType="local:ManagementTabViewModel">
      <Grid>
        <Border Margin="0,0,0,5"
                IsHitTestVisible="False"
                IsVisible="{Binding IsSelected}"
                BorderThickness="1,0"
                BorderBrush="{StaticResource TabBarSelectedCellBorderShadowGradientBrush}">
          <Border BorderThickness="1,0"
                  BorderBrush="{StaticResource TabBarSelectedCellBorderGradientBrush}"
                  Background="{StaticResource TabBarSelectedCellGradientBrush}" />
        </Border>
        <Grid Height="10" Margin="0,54,0,0" VerticalAlignment="Top" IsHitTestVisible="False" IsVisible="{Binding IsSelected}">
          <Grid.Effect>
            <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="10" Opacity="1" Color="{x:Static local:Theme+TabBar.UnderlineGlowColor}" />
          </Grid.Effect>
          <Path Height="3"
                Margin="0,0,0,1"
                VerticalAlignment="Bottom"
                Stretch="Fill"
                Data="M 0,1.5 L 1,0 L 2,1.5 L 1,3 Z"
                Fill="{StaticResource TabBarUnderlineBrush}" />
          <Path Width="16"
                Height="7"
                Margin="0,0,0,2.5"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Stretch="Fill"
                Data="M 0,7 L 8,0 L 16,7 Z"
                Fill="{StaticResource TabBarUnderlineBrush}" />
        </Grid>
        <Button Classes="tab"
                Classes.selected="{Binding IsSelected}"
                Command="{Binding #Screen.((local:ManagementScreenViewModel)DataContext).SelectTabCommand}"
                CommandParameter="{Binding}">
          <TextBlock Text="{Binding TabHeader}" />
        </Button>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.tab">
      <Setter Property="Margin" Value="0,16,0,0" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TabBarTextBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="FontFamily" Value="{StaticResource FontFamilySerif}" />
      <Setter Property="FontSize" Value="26" />
    </Style>
    <Style Selector="Button.tab /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TabBarHoverTextBrush}" />
    </Style>
    <Style Selector="Button.tab.selected">
      <Setter Property="Foreground" Value="{StaticResource TabBarSelectedTextBrush}" />
    </Style>
    <Style Selector="Button.tab.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TabBarSelectedTextBrush}" />
    </Style>

    <Style Selector="local|SpriteVisual.site-image">
      <Setter Property="Margin" Value="-120" />
      <Setter Property="Stretch" Value="UniformToFill" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Effect" Value="blur(50)" />
    </Style>

    <Style Selector="Button.hotkey">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{StaticResource TabBarHotkeyFaceBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TabBarHotkeyTextBrush}" />
      <Setter Property="FontFamily" Value="{StaticResource FontFamilySans}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="7">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Margin="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.hotkey:pointerover">
      <Setter Property="Background" Value="{StaticResource TabBarHotkeyHoverFaceBrush}" />
    </Style>
    <Style Selector="Button.hotkey:pressed">
      <Setter Property="Opacity" Value="0.9" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*" Background="{StaticResource WindowTranslucentBackgroundBrush}">
    <Panel Grid.Row="1" Classes="cached" ClipToBounds="True">
      <local:SpriteVisual Classes="site-image" SpriteKey="{Binding SelectedTab.SiteImageKey}" />
    </Panel>

    <ContentControl Grid.Row="1" Content="{Binding SelectedTab}" />

    <Grid Grid.Row="0" Classes="cached" ZIndex="1">
      <Border Height="67" Background="{StaticResource TabBarBackgroundGradientBrush}" />

      <local:OrnamentRule Type="Scroll"
                          Size="3"
                          Margin="0,63,0,-20"
                          VerticalAlignment="Top"
                          IsHitTestVisible="False"
                          Stroke="{StaticResource TabBarOrnamentBrush}"
                          Line="{StaticResource TabBarRuleGradientBrush}"
                          Pattern="{StaticResource TabBarPatternGradientBrush}">
        <local:OrnamentRule.Effect>
          <DropShadowEffect OffsetX="0" OffsetY="1" BlurRadius="4" Opacity="1" Color="{x:Static local:Theme+TabBar.OrnamentShadowColor}" />
        </local:OrnamentRule.Effect>
      </local:OrnamentRule>

      <StackPanel Orientation="Horizontal" Height="67" HorizontalAlignment="Center" VerticalAlignment="Top">
        <Button Classes="hotkey" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="{local:Text 'Q'}" Margin="0,20,24,0" Command="{Binding SelectPreviousTabCommand}" />
        <ItemsControl x:Name="TabStrip"
                      Classes="focus-group"
                      ClipToBounds="False"
                      ItemsSource="{Binding Tabs}"
                      ItemTemplate="{StaticResource ManagementTabTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <Button Classes="hotkey" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="{local:Text 'E'}" Margin="24,20,0,0" Command="{Binding SelectNextTabCommand}" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,24,0">
        <ContentControl Content="{Binding PlayerResources}"
                        Classes="body"
                        Height="28"
                        Foreground="{StaticResource PrimaryTextBrush}" />
        <Button Classes="hotkey" Command="{Binding CloseCommand}">
          <local:IconVisual Moniker="Close" Width="12" Height="12" Foreground="{Binding $parent[Button].Foreground}" />
        </Button>
      </StackPanel>
    </Grid>
  </Grid>

</UserControl>
