<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Gallean.Client"
             x:Class="Gallean.Client.SpellItemsView"
             x:Name="Screen"
             x:DataType="local:SpellItemsViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="S" Command="{Binding CloseCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <Style Selector="Button.spell-item-tile">
      <Setter Property="Width" Value="120" />
      <Setter Property="Padding" Value="4,8,4,6" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.spell-item-tile:pointerover">
      <Setter Property="Background" Value="{StaticResource SpellTileHoverBrush}" />
    </Style>
    <Style Selector="Button.spell-item-tile.selected">
      <Setter Property="Background" Value="{StaticResource SpellTileSelectedBrush}" />
    </Style>

    <Style Selector="Button.spell-item-tile.unavailable TextBlock.spell-item-name">
      <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    </Style>

    <Style Selector="Panel.spell-item-socket">
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector=".unavailable Panel.spell-item-socket">
      <Setter Property="Opacity" Value="0.4" />
    </Style>

    <Style Selector="Border.group-divider">
      <Setter Property="Height" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{StaticResource DividerBrush}" />
    </Style>

    <Style Selector="ContentControl.spell-item-price WrapPanel">
      <Setter Property="ItemsAlignment" Value="Center" />
    </Style>
    <Style Selector="Line.spell-item-divider">
      <Setter Property="Margin" Value="0,6" />
      <Setter Property="Stretch" Value="Fill" />
      <Setter Property="StartPoint" Value="0,0" />
      <Setter Property="EndPoint" Value="1,0" />
      <Setter Property="Stroke" Value="{StaticResource DividerBrush}" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="StrokeDashArray" Value="4,3" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <DataTemplate x:Key="SpellItemTemplate" x:DataType="local:SpellItemViewModel">
      <Panel>
        <Button Classes="spell-item-tile"
                Classes.unavailable="{Binding !Status.IsAvailable}"
                Classes.selected="{Binding IsSelected}"
                Command="{Binding #Screen.((local:SpellItemsViewModel)DataContext).SelectItemCommand}"
                CommandParameter="{Binding}"
                DoubleTapped="OnItemDoubleTapped">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
            <Panel Grid.Row="0"
                   Classes="inventory-slot spell-item-socket"
                   Classes.equipment="{Binding Type, Converter={x:Static local:EnumEqualsConverter.Instance}, ConverterParameter={x:Static local:InventoryItemType.Equipment}}"
                   Classes.valuable="{Binding Type, Converter={x:Static local:EnumEqualsConverter.Instance}, ConverterParameter={x:Static local:InventoryItemType.Valuable}}"
                   Classes.special="{Binding Type, Converter={x:Static local:EnumEqualsConverter.Instance}, ConverterParameter={x:Static local:InventoryItemType.Special}}">
              <local:PlateChrome Classes="socket" />
              <local:SpriteVisual SpriteKey="{Binding Details.IconKey}" Stretch="Uniform" />
              <Panel Classes="item-count"
                     IsVisible="{Binding Count, Converter={x:Static local:GreaterThanConverter.Instance}, ConverterParameter=1}">
                <local:PlateChrome Classes="socket counter" />
                <local:OutlinedTextBlock Classes="object-name compact" Text="{Binding Count}" />
              </Panel>
            </Panel>
            <TextBlock Grid.Row="1"
                       Classes="caption spell-item-name"
                       Text="{Binding Details.Name}"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <ContentControl Grid.Row="2"
                            Content="{Binding Details.CastingCost}"
                            Classes="caption spell-item-price"
                            HorizontalAlignment="Center"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            IsVisible="{Binding Details.CastingCost, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </Grid>
        </Button>
        <Popup Placement="RightEdgeAlignedTop"
               PlacementConstraintAdjustment="FlipX,SlideY"
               HorizontalOffset="6"
               VerticalOffset="-6"
               IsOpen="{Binding IsSelected}">
          <local:ModalFrameDecorator Width="340" Background="{StaticResource ModalAccentBodyGradientBrush}">
            <StackPanel Margin="18,16,18,18" Spacing="10">
              <local:PriceButton Classes="pill"
                                 local:PlateChrome.TextureSeed="1"
                                 Content="{local:Text 'Cast'}"
                                 Status="{Binding Status}"
                                 Command="{Binding #Screen.((local:SpellItemsViewModel)DataContext).UseSelectedCommand}" />
              <ContentControl Content="{Binding Status}"
                              Classes="caption"
                              HorizontalAlignment="Center"
                              IsVisible="{Binding Status.IsReasonVisible}" />

              <Line Classes="spell-item-divider" />

              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Panel Grid.Column="0"
                       Classes="inventory-slot spell-item-socket"
                       Classes.equipment="{Binding Type, Converter={x:Static local:EnumEqualsConverter.Instance}, ConverterParameter={x:Static local:InventoryItemType.Equipment}}"
                       Classes.valuable="{Binding Type, Converter={x:Static local:EnumEqualsConverter.Instance}, ConverterParameter={x:Static local:InventoryItemType.Valuable}}"
                       Classes.special="{Binding Type, Converter={x:Static local:EnumEqualsConverter.Instance}, ConverterParameter={x:Static local:InventoryItemType.Special}}">
                  <local:PlateChrome Classes="socket" />
                  <local:SpriteVisual SpriteKey="{Binding Details.IconKey}" Stretch="Uniform" />
                </Panel>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <local:OutlinedTextBlock Text="{Binding Details.Name}" Classes="object-name row" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Details.CategoryText}" Classes="caption" Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
              </Grid>

              <TextBlock Text="{Binding Details.Description}"
                         Classes="body"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding Details.SpellEffect}"
                         Classes="body"
                         Foreground="{StaticResource AccentBrush}"
                         TextWrapping="Wrap"
                         IsVisible="{Binding Details.SpellEffect, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </local:ModalFrameDecorator>
        </Popup>
      </Panel>
    </DataTemplate>

    <DataTemplate x:Key="SpellItemGroupTemplate" x:DataType="local:SpellItemGroupViewModel">
      <StackPanel Spacing="6" Margin="0,0,0,14">
        <Grid ColumnDefinitions="Auto,*">
          <local:OutlinedTextBlock Grid.Column="0" Text="{Binding Title}" Classes="label" VerticalAlignment="Center" />
          <Border Grid.Column="1" Classes="group-divider" Margin="12,0,0,0" />
        </Grid>
        <ItemsControl Classes="focus-group" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource SpellItemTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="4" LineSpacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Border Background="{StaticResource ModalBackdropBrush}" local:Backdrop.CloseCommand="{Binding CloseCommand}">
    <local:ModalPanel Width="560"
                      MaxHeight="640"
                      Title="{local:Text 'Scrolls and staffs'}"
                      InitialFocus="{Binding #CloseButton}"
                      PointerPressed="OnContentPointerPressed">

      <local:ModalPanel.Footer>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Text="{local:Text 'Tip: double-click an item to use it immediately'}"
                     Classes="body"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     FontStyle="Italic"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center" />
          <Button x:Name="CloseButton"
                  Grid.Column="1"
                  Content="{local:Text 'Close'}"
                  Classes="pill"
                  MinWidth="110"
                  Margin="12,0,0,0"
                  VerticalAlignment="Center"
                  Command="{Binding CloseCommand}" />
        </Grid>
      </local:ModalPanel.Footer>

      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl Margin="0,0,12,0" ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource SpellItemGroupTemplate}" />
      </ScrollViewer>

    </local:ModalPanel>
  </Border>

</UserControl>
