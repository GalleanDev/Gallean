<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Gallean.Client"
             x:Class="Gallean.Client.CampaignSelectScreenView"
             x:DataType="local:CampaignSelectScreenViewModel">

  <UserControl.Styles>
    <Style Selector="Grid.entrance">
      <Style.Animations>
        <Animation Duration="0:0:0.6" Easing="CubicEaseOut" FillMode="Backward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.X" Value="-18" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.X" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector=":is(Control).entrance-late">
      <Style.Animations>
        <Animation Delay="0:0:0.15" Duration="0:0:0.6" Easing="SineEaseOut" FillMode="Backward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="Border.entrance-divider">
      <Style.Animations>
        <Animation Delay="0:0:0.08" Duration="0:0:0.7" Easing="CubicEaseInOut" FillMode="Backward">
          <KeyFrame Cue="0%">
            <Setter Property="Width" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Width" Value="72" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="ListBox.select-list ListBoxItem Border.row.saga">
      <Setter Property="Padding" Value="16,10" />
    </Style>
    <Style Selector="ListBox.select-list ListBoxItem :is(TextBlock).saga-name">
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="LetterSpacing" Value="0.2" />
    </Style>
    <Style Selector="ListBox.select-list ListBoxItem:selected :is(TextBlock).saga-name">
      <Setter Property="Foreground" Value="{StaticResource ScenarioSelectAccentBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid Background="{StaticResource ScenarioSelectBackdropBrush}" ClipToBounds="True">

    <local:CoverBoxDecorator Classes="menu-background" DataContext="{Binding MainMenuBackground}">
      <local:MainMenuBackgroundView />
    </local:CoverBoxDecorator>

    <TransitioningContentControl Content="{Binding Background}">
      <TransitioningContentControl.PageTransition>
        <local:CrossFadePageTransition Duration="0:0:0.6" />
      </TransitioningContentControl.PageTransition>
      <TransitioningContentControl.ContentTemplate>
        <DataTemplate x:DataType="local:MenuBackgroundViewModel">
          <local:CoverBoxDecorator Classes="menu-background">
            <local:MenuBackgroundView />
          </local:CoverBoxDecorator>
        </DataTemplate>
      </TransitioningContentControl.ContentTemplate>
    </TransitioningContentControl>

    <Border Classes="menu-overlay" />

    <Grid Classes="entrance"
          Width="380"
          MaxHeight="820"
          Margin="56,32,0,32"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          RowDefinitions="Auto,Auto,*,Auto">
      <Grid.RenderTransform>
        <TranslateTransform />
      </Grid.RenderTransform>

      <local:OutlinedTextBlock Grid.Row="0" Text="{local:Text 'New saga'}" Classes="h1" Foreground="{StaticResource ScenarioSelectAccentBrush}" />

      <Border Grid.Row="1"
              Classes="entrance-divider"
              Width="72"
              Height="1"
              HorizontalAlignment="Left"
              Background="{StaticResource ScenarioSelectDividerBrush}"
              Margin="0,10,0,20" />

      <ListBox Grid.Row="2"
               Classes="select-list entrance-late"
               ItemsSource="{Binding Campaigns}"
               SelectedItem="{Binding SelectedCampaign}"
               DoubleTapped="OnCampaignDoubleTapped">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="local:CampaignSelectItemViewModel">
            <Border Classes="row saga">
              <TextBlock Text="{Binding RaceName}" Classes="h4 saga-name" TextTrimming="CharacterEllipsis" />
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Grid Grid.Row="3" Classes="focus-group entrance-late" ColumnDefinitions="*,*" Margin="0,32,0,0">
        <Button Grid.Column="0"
                Classes="pill"
                local:PlateChrome.TextureSeed="1"
                Content="{local:Text 'Back'}"
                Command="{Binding Game.ShowMainMenuCommand}"
                Margin="0,0,6,0" />
        <Button Grid.Column="1" Classes="pill primary" local:PlateChrome.TextureSeed="2" Content="{local:Text 'Start game'}" Command="{Binding StartCommand}" Margin="6,0,0,0" />
      </Grid>
    </Grid>
  </Grid>

</UserControl>
