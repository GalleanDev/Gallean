<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Gallean.Client"
             x:Class="Gallean.Client.LeaderUpgradeView"
             x:DataType="local:LeaderUpgradeViewModel">

  <Border Background="{StaticResource ModalBackdropBrush}">
    <local:ModalPanel Classes="accent" Width="560" MaxHeight="680" Padding="28,24" InitialFocus="{Binding #CloseButton}">

      <local:ModalPanel.Footer>
        <Grid ColumnDefinitions="*,Auto,Auto">
          <Button Grid.Column="1"
                  Content="{local:Text 'Learn'}"
                  Classes="pill success"
                  local:PlateChrome.TextureSeed="1"
                  MinWidth="110"
                  Margin="0,0,16,0"
                  VerticalAlignment="Center"
                  Command="{Binding LearnCommand}" />
          <Button x:Name="CloseButton"
                  Grid.Column="2"
                  Content="{local:Text 'Later'}"
                  Classes="pill"
                  local:PlateChrome.TextureSeed="2"
                  MinWidth="110"
                  VerticalAlignment="Center"
                  Command="{Binding PostponeCommand}" />
        </Grid>
      </local:ModalPanel.Footer>

      <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0"
              x:DataType="local:LeaderUpgradeHeaderViewModel"
              DataContext="{Binding Header}"
              ColumnDefinitions="Auto,*"
              RowDefinitions="Auto,Auto"
              Margin="0,0,0,16"
              Background="Transparent">
          <local:UnitPortrait Grid.Column="0"
                              Width="76"
                              Height="92"
                              Margin="0"
                              FaceKey="{Binding FaceKey}"
                              IsHitpointsVisible="False" />
          <StackPanel Grid.Column="1" Margin="18,0,0,0" Spacing="6" VerticalAlignment="Center">
            <local:AnimatedTextBlock Classes="h2"
                                     Foreground="{StaticResource PrimaryTextBrush}"
                                     TextWrapping="Wrap"
                                     Reveal="{x:Static local:AnimatedTextReveal.SmokeWords}"
                                     RevealDelay="0:0:0.2"
                                     GlowColor="{x:Static local:Theme+LeaderUpgrade.GlowColor}"
                                     SmokeColor="{x:Static local:Theme+LeaderUpgrade.SmokeColor}"
                                     Text="{Binding LevelUpText}" />
            <TextBlock Classes="prose" Foreground="{StaticResource SecondaryTextBrush}" local:TextRuns.Spans="{Binding PendingUpgradesText}" />
          </StackPanel>
          <TextBlock Grid.Row="1"
                     Grid.Column="0"
                     Grid.ColumnSpan="2"
                     Margin="0,16,0,0"
                     Classes="body"
                     FontStyle="Italic"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     Text="{local:Text 'Each new level lets the leader master one new ability.'}" />
        </Grid>

        <ScrollViewer Classes="list" Grid.Row="1">
          <ItemsControl Classes="focus-group" ItemsSource="{Binding Options}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:LeaderUpgradeItemViewModel">
                <Button Classes="row" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}">
                  <Grid ColumnDefinitions="Auto,*">
                    <local:IconVisual Grid.Column="0"
                                      Moniker="{Binding Icon}"
                                      Width="24"
                                      Height="24"
                                      Margin="0,3,12,0"
                                      VerticalAlignment="Top"
                                      Foreground="{StaticResource AccentBrush}" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <Grid ColumnDefinitions="*,Auto">
                        <local:OutlinedTextBlock Grid.Column="0"
                                                 Text="{Binding Name}"
                                                 Classes="h4"
                                                 Foreground="{StaticResource PrimaryTextBrush}"
                                                 TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Classes="caption"
                                   Foreground="{StaticResource HighlightTextBrush}"
                                   IsVisible="{Binding IsPreferred}"
                                   Text="{local:Text 'Recommended'}" />
                      </Grid>
                      <TextBlock Text="{Binding Description}"
                                 Classes="body"
                                 Foreground="{StaticResource SecondaryTextBrush}"
                                 TextWrapping="Wrap" />
                      <ContentControl Content="{Binding Status}" Classes="caption" />
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

      </Grid>

    </local:ModalPanel>
  </Border>

</UserControl>
