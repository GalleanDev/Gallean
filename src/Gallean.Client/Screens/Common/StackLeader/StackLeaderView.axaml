<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Gallean.Client"
             x:Class="Gallean.Client.StackLeaderView"
             x:DataType="local:StackLeaderViewModel"
             ClipToBounds="False">

  <Grid RowDefinitions="*,Auto,Auto,Auto,Auto">
    <Viewbox Grid.Row="0" StretchDirection="DownOnly" ClipToBounds="False">
      <Panel Width="230" Height="330" Background="Transparent">
        <Ellipse Width="340"
                 Height="340"
                 Margin="-55,-5"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Fill="{StaticResource StackPortraitGlowGradientBrush}" />
        <local:PointerTiltDecorator Classes="event-portrait" Margin="-40,-24,-40,-8">
          <local:SpriteVisual SpriteKey="{Binding PortraitKey}" Stretch="Uniform" />
        </local:PointerTiltDecorator>
      </Panel>
    </Viewbox>

    <local:OutlinedTextBlock Grid.Row="1" Margin="0,6,0,0" Text="{Binding Title}" Classes="object-name title" TextTrimming="CharacterEllipsis" />

    <local:OrnamentDivider Grid.Row="2" Margin="0,6,0,0" Classes="section" />

    <ItemsControl Grid.Row="3" Margin="0,6,0,0" Classes="stat-table" ItemsSource="{Binding Stats}" />

    <ItemsControl Grid.Row="4" Margin="0,8,0,0" Classes="leader-abilities" ItemsSource="{Binding Abilities}" IsVisible="{Binding !!Abilities.Count}" />
  </Grid>

</UserControl>
