<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Gallean.Client">
  <Styles.Resources>
    <DataTemplate x:Key="LeaderAbilityTemplate" x:DataType="local:LeaderAbilityViewModel">
      <Border Classes="leader-ability">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <local:IconVisual Classes="leader-ability-icon" Moniker="{Binding Icon}" />
          <TextBlock Classes="caption" Text="{Binding Name}" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Styles.Resources>

  <Style Selector="ItemsControl.leader-abilities">
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <WrapPanel ItemSpacing="5" LineSpacing="4" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="ItemTemplate" Value="{StaticResource LeaderAbilityTemplate}" />
  </Style>
  <Style Selector="Border.leader-ability">
    <Setter Property="Padding" Value="7,2,10,2" />
    <Setter Property="Background" Value="{StaticResource LeaderAbilityFaceGradientBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LeaderAbilityBorderGradientBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}" />
  </Style>
  <Style Selector="Border.leader-ability local|IconVisual.leader-ability-icon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource LeaderAbilityIconBrush}" />
  </Style>
  <Style Selector="Border.leader-ability TextBlock">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
  </Style>
</Styles>
