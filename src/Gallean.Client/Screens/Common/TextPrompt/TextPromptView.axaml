<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Gallean.Client"
             x:Class="Gallean.Client.TextPromptView"
             x:DataType="local:TextPromptViewModel">

  <Border Background="{StaticResource ModalBackdropBrush}">
    <local:ModalPanel Classes="accent" Width="480" Padding="28,24" Title="{Binding Title}" InitialFocus="{Binding #InputTextBox}">

      <local:ModalPanel.Footer>
        <Grid ColumnDefinitions="*,Auto,Auto,*">
          <Button Grid.Column="1"
                  Content="{local:Text 'Accept'}"
                  Classes="pill primary"
                  local:PlateChrome.TextureSeed="1"
                  Command="{Binding ConfirmCommand}"
                  MinWidth="150"
                  Margin="0,0,16,0" />
          <Button Grid.Column="2"
                  Content="{local:Text 'Cancel'}"
                  Classes="pill"
                  local:PlateChrome.TextureSeed="2"
                  Command="{Binding CloseCommand}"
                  MinWidth="150" />
        </Grid>
      </local:ModalPanel.Footer>

      <StackPanel Spacing="16">
        <TextBlock Text="{Binding Message}"
                   Classes="body"
                   Foreground="{StaticResource PrimaryTextBrush}"
                   TextWrapping="Wrap"
                   TextAlignment="Center" />
        <TextBox x:Name="InputTextBox"
                 Text="{Binding Text}"
                 MaxLength="{Binding MaxLength}"
                 PlaceholderText="{Binding Placeholder}">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
      </StackPanel>

    </local:ModalPanel>
  </Border>

</UserControl>
