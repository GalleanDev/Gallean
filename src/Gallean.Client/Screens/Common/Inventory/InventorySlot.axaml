<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Gallean.Client">
  <Styles.Resources>
    <DataTemplate x:Key="InventoryItemTemplate" x:DataType="local:InventoryItemViewModel">
      <Button Classes="socket inventory-slot">
        <Panel>
          <local:SpriteVisual SpriteKey="{Binding SpriteKey}" Stretch="Uniform">
            <ToolTip.Tip>
              <StackPanel Spacing="4">
                <local:OutlinedTextBlock Text="{Binding Name}" Classes="object-name row" />
                <TextBlock Text="{Binding Description}" />
              </StackPanel>
            </ToolTip.Tip>
          </local:SpriteVisual>
          <Panel Classes="item-count"
                 IsVisible="{Binding Count, Converter={x:Static local:GreaterThanConverter.Instance}, ConverterParameter=1}">
            <local:PlateChrome Classes="socket counter" />
            <local:OutlinedTextBlock Classes="object-name compact" Text="{Binding Count}" />
          </Panel>
        </Panel>
      </Button>
    </DataTemplate>

    <DataTemplate x:Key="InventoryDisplayItemTemplate" x:DataType="local:InventoryItemViewModel">
      <Panel Classes="inventory-slot">
        <local:PlateChrome Classes="socket" />
        <local:SpriteVisual SpriteKey="{Binding SpriteKey}" Stretch="Uniform">
          <ToolTip.Tip>
            <StackPanel Spacing="4">
              <local:OutlinedTextBlock Text="{Binding Name}" Classes="object-name row" />
              <TextBlock Text="{Binding Description}" />
            </StackPanel>
          </ToolTip.Tip>
        </local:SpriteVisual>
        <Panel Classes="item-count"
               IsVisible="{Binding Count, Converter={x:Static local:GreaterThanConverter.Instance}, ConverterParameter=1}">
          <local:PlateChrome Classes="socket counter" />
          <local:OutlinedTextBlock Classes="object-name compact" Text="{Binding Count}" />
        </Panel>
      </Panel>
    </DataTemplate>
  </Styles.Resources>

  <Style Selector="Button.inventory-slot, Panel.inventory-slot">
    <Setter Property="Width" Value="72" />
    <Setter Property="Height" Value="72" />
    <Setter Property="Margin" Value="6" />
  </Style>
  <Style Selector="local|PagedItemsControl.inventory">
    <Setter Property="MinWidth" Value="376" />
    <Setter Property="MinHeight" Value="84" />
  </Style>
  <Style Selector="Button.inventory-slot local|SpriteVisual">
    <Setter Property="Margin" Value="-15" />
  </Style>
  <Style Selector="Panel.inventory-slot local|SpriteVisual">
    <Setter Property="Margin" Value="-4" />
  </Style>
  <Style Selector="Panel.item-count">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="Panel.item-count > local|PlateChrome.counter">
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="Texture" Value="{x:Null}" />
  </Style>
  <Style Selector="Panel.item-count > local|OutlinedTextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Effect" Value="{x:Null}" />
  </Style>
  <Style Selector="Button.inventory-slot Panel.item-count">
    <Setter Property="Margin" Value="0,0,-13,-13" />
  </Style>
  <Style Selector="Panel.inventory-slot Panel.item-count">
    <Setter Property="Margin" Value="0,0,-1,-1" />
  </Style>
  <Style Selector="Button.transfer-all">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
