<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Gallean.Client">
  <Styles.Resources>
    <DataTemplate x:Key="InventoryItemTemplate" x:DataType="local:InventoryItemViewModel">
      <Button Classes="socket inventory-slot">
        <local:SpriteVisual SpriteKey="{Binding SpriteKey}" Stretch="Uniform">
          <ToolTip.Tip>
            <StackPanel Spacing="4">
              <local:OutlinedTextBlock Text="{Binding Name}" Classes="object-name row" />
              <TextBlock Text="{Binding Description}" />
            </StackPanel>
          </ToolTip.Tip>
        </local:SpriteVisual>
      </Button>
    </DataTemplate>

    <DataTemplate x:Key="InventoryDisplayItemTemplate" x:DataType="local:InventoryItemViewModel">
      <Panel Classes="inventory-slot">
        <local:PlateChrome Classes="socket" />
        <local:SpriteVisual SpriteKey="{Binding SpriteKey}" Stretch="Uniform">
          <ToolTip.Tip>
            <StackPanel Spacing="4">
              <local:OutlinedTextBlock Text="{Binding Name}" Classes="object-name row" />
              <TextBlock Text="{Binding Description}" />
            </StackPanel>
          </ToolTip.Tip>
        </local:SpriteVisual>
      </Panel>
    </DataTemplate>
  </Styles.Resources>

  <Style Selector="Button.inventory-slot, Panel.inventory-slot">
    <Setter Property="Width" Value="72" />
    <Setter Property="Height" Value="72" />
    <Setter Property="Margin" Value="6" />
  </Style>
  <Style Selector="local|PagedItemsControl.inventory">
    <Setter Property="MinWidth" Value="376" />
    <Setter Property="MinHeight" Value="84" />
  </Style>
  <Style Selector="Button.inventory-slot local|SpriteVisual">
    <Setter Property="Margin" Value="-15" />
  </Style>
  <Style Selector="Panel.inventory-slot local|SpriteVisual">
    <Setter Property="Margin" Value="-4" />
  </Style>
  <Style Selector="Button.transfer-all">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
