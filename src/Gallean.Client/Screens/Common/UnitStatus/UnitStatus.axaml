<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Gallean.Client">
  <Styles.Resources>
    <DataTemplate x:Key="UnitStatusBadgeTemplate" x:DataType="local:UnitStatusViewModel">
      <Panel Classes="status-badge" Background="Transparent">
        <ToolTip.Tip>
          <StackPanel Classes="status-tooltip">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <local:IconVisual Classes="status-tooltip-icon"
                                Moniker="{Binding Icon}"
                                Foreground="{Binding Color, Converter={x:Static local:ColorToBrushConverter.Instance}}" />
              <local:OutlinedTextBlock Text="{Binding Name}"
                                       Classes="h4"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Color, Converter={x:Static local:ColorToBrushConverter.Instance}}" />
            </StackPanel>
            <TextBlock local:TextRuns.Spans="{Binding Description}" />
          </StackPanel>
        </ToolTip.Tip>
        <local:GlowVisual Classes="status-glow" Color="{Binding Color}" IsHitTestVisible="False" />
        <Border Classes="status-face" BorderBrush="{Binding Color, Converter={x:Static local:ColorToBrushConverter.Instance}}">
          <local:IconVisual Classes="status-icon"
                            Moniker="{Binding Icon}"
                            Foreground="{Binding Color, Converter={x:Static local:ColorToBrushConverter.Instance}}" />
        </Border>
        <Border Classes="status-counter"
                IsVisible="{Binding Count, Converter={x:Static local:GreaterThanConverter.Instance}, ConverterParameter=1}"
                BorderBrush="{Binding Color, Converter={x:Static local:ColorToBrushConverter.Instance}}">
          <TextBlock Text="{Binding Count}" />
        </Border>
      </Panel>
    </DataTemplate>

    <DataTemplate x:Key="UnitStatusRowTemplate" x:DataType="local:UnitStatusViewModel">
      <Grid ColumnDefinitions="Auto,*" Classes="status-row">
        <ContentControl Grid.Column="0"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource UnitStatusBadgeTemplate}"
                        VerticalAlignment="Top"
                        ClipToBounds="False" />
        <StackPanel Grid.Column="1" Spacing="2" Margin="12,0,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Name}"
                       Classes="caption"
                       Foreground="{Binding Color, Converter={x:Static local:ColorToBrushConverter.Instance}}" />
          </StackPanel>
          <TextBlock local:TextRuns.Spans="{Binding Description}"
                     Classes="caption"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="UnitPermanentModifierTemplate" x:DataType="local:UnitPermanentModifierViewModel">
      <Border Classes="permanent-modifier">
        <ToolTip.Tip>
          <StackPanel Classes="status-tooltip">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <local:IconVisual Classes="status-tooltip-icon" Moniker="{Binding Icon}" Foreground="{StaticResource LeaderAbilityIconBrush}" />
              <local:OutlinedTextBlock Text="{Binding Name}" Classes="h4" VerticalAlignment="Center" Foreground="{StaticResource LeaderAbilityIconBrush}" />
            </StackPanel>
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Effects}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource BattleStatusEffectBoostModifierBrush}"
                       IsVisible="{Binding Effects, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <local:IconVisual Classes="permanent-modifier-icon" Moniker="{Binding Icon}" />
          <TextBlock Classes="caption" Text="{Binding Name}" VerticalAlignment="Center" />
          <TextBlock Classes="caption permanent-modifier-count"
                     Text="{Binding CountText}"
                     VerticalAlignment="Center"
                     IsVisible="{Binding Count, Converter={x:Static local:GreaterThanConverter.Instance}, ConverterParameter=1}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Styles.Resources>

  <Style Selector="ItemsControl.status-badges">
    <Setter Property="ClipToBounds" Value="False" />
  </Style>

  <Style Selector="Panel.status-badge">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
  </Style>
  <Style Selector="Panel.status-badge > local|GlowVisual.status-glow">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Panel.status-badge > Border.status-face">
    <Setter Property="Background" Value="{StaticResource BattleStatusEffectFaceBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Panel.status-badge > Border.status-face > local|IconVisual.status-icon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Panel.status-badge > Border.status-counter">
    <Setter Property="Height" Value="11" />
    <Setter Property="MinWidth" Value="11" />
    <Setter Property="Margin" Value="0,0,-2,-3" />
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Background" Value="{StaticResource BattleStatusEffectFaceBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5.5" />
  </Style>
  <Style Selector="Panel.status-badge > Border.status-counter > TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource BattleStatusEffectCounterTextBrush}" />
    <Setter Property="FontSize" Value="8" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LineHeight" Value="9" />
  </Style>

  <Style Selector=".status-large Panel.status-badge">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
  </Style>
  <Style Selector=".status-large Panel.status-badge > local|GlowVisual.status-glow">
    <Setter Property="Width" Value="50" />
    <Setter Property="Height" Value="50" />
  </Style>
  <Style Selector=".status-large Panel.status-badge > Border.status-face">
    <Setter Property="CornerRadius" Value="15" />
  </Style>
  <Style Selector=".status-large Panel.status-badge > Border.status-face > local|IconVisual.status-icon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>
  <Style Selector=".status-large Panel.status-badge > Border.status-counter">
    <Setter Property="Height" Value="15" />
    <Setter Property="MinWidth" Value="15" />
    <Setter Property="Margin" Value="0,0,-5,-3" />
    <Setter Property="Padding" Value="3,0" />
    <Setter Property="CornerRadius" Value="7.5" />
  </Style>
  <Style Selector=".status-large Panel.status-badge > Border.status-counter > TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="LineHeight" Value="11" />
  </Style>

  <Style Selector="StackPanel.status-tooltip">
    <Setter Property="MaxWidth" Value="240" />
    <Setter Property="Spacing" Value="4" />
  </Style>
  <Style Selector="local|IconVisual.status-tooltip-icon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Grid.status-row">
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="ItemsControl.permanent-modifiers">
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <WrapPanel ItemSpacing="5" LineSpacing="5" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="ItemTemplate" Value="{StaticResource UnitPermanentModifierTemplate}" />
  </Style>
  <Style Selector="Border.permanent-modifier">
    <Setter Property="Padding" Value="7,2,10,2" />
    <Setter Property="Background" Value="{StaticResource LeaderAbilityFaceGradientBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LeaderAbilityBorderGradientBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}" />
  </Style>
  <Style Selector="Border.permanent-modifier local|IconVisual.permanent-modifier-icon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource LeaderAbilityIconBrush}" />
  </Style>
  <Style Selector="Border.permanent-modifier TextBlock">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
  </Style>
  <Style Selector="Border.permanent-modifier TextBlock.permanent-modifier-count">
    <Setter Property="Foreground" Value="{StaticResource LeaderAbilityIconBrush}" />
  </Style>
</Styles>
