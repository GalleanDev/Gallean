<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Gallean.Client"
             x:Class="Gallean.Client.SpellDetailsView"
             x:DataType="local:SpellDetailsViewModel"
             ClipToBounds="False">

  <local:ModalFrameDecorator Width="400" Margin="0,60,52,0">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto">

      <StackPanel Grid.Row="0" Classes="details-header" Margin="22,20,124,0">
        <local:OutlinedTextBlock Text="{Binding Name}" Classes="object-name title" />
        <local:OutlinedTextBlock Text="{Binding LevelText}" Classes="label details-category" />
      </StackPanel>

      <Panel Grid.Row="0"
             Grid.RowSpan="2"
             Width="156"
             Height="156"
             Margin="0,-52,-44,0"
             HorizontalAlignment="Right"
             VerticalAlignment="Top">
        <local:GlowVisual Classes="details-icon-glow" />
        <local:SpriteVisual Classes="details-icon" SpriteKey="{Binding Icon.Key}" />
      </Panel>

      <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="22,14,124,0">
        <local:IconVisual Grid.Column="0" Classes="details-ornament" Moniker="OrnamentFinialSmall" />
        <TextBlock Grid.Column="1" Text="{Binding Description}" Classes="body details-flavor" />
      </Grid>

      <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Classes="details-effect" Margin="22,16,22,0">
        <Rectangle Grid.Column="0" Classes="details-bullet" />
        <TextBlock Grid.Column="1" Text="{Binding EffectText}" Classes="body" />
      </Grid>

      <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,Auto" Classes="details-effect" Margin="22,16,22,16">
        <Rectangle Grid.Column="0" Classes="details-bullet" />
        <TextBlock Grid.Column="1" Text="{local:Text 'Casting cost:'}" Classes="body" Margin="0,0,8,0" />
        <ContentControl Grid.Column="2" Content="{Binding CastingCost}" Classes="body details-value" />
      </Grid>

    </Grid>
  </local:ModalFrameDecorator>

</UserControl>
