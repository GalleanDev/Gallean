<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Gallean.Client"
             x:Class="Gallean.Client.ItemDetailsView"
             x:DataType="local:ItemDetailsViewModel"
             ClipToBounds="False">

  <UserControl.Styles>
    <Style Selector=":is(TextBlock).primary-stat">
      <Setter Property="Foreground" Value="{StaticResource UnitDetailsPrimaryStatBrush}" />
    </Style>
    <Style Selector="StackPanel.attack-line">
      <Setter Property="Orientation" Value="Horizontal" />
    </Style>
    <Style Selector="StackPanel.attack-line > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.attack-line > TextBlock.attack-source">
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>
    <Style Selector="StackPanel.attack-line > TextBlock.attack-source.open">
      <Setter Property="Margin" Value="5,0,0,0" />
    </Style>
    <Style Selector="StackPanel.attack-line > local|IconVisual.attack-source">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="Margin" Value="1,2,2,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.attack-line > TextBlock.attack-source.close">
      <Setter Property="Margin" Value="3,0,0,0" />
    </Style>
    <Style Selector="StackPanel.attack-line > TextBlock.attack-type">
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <Style Selector="Border.stat-row ContentControl.stat-icon">
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>
    <Style Selector="Border.stat-row TextBlock.stat-label">
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>
  </UserControl.Styles>

  <local:ModalFrameDecorator Width="400" Margin="0,60,52,0">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto">

      <StackPanel Grid.Row="0" Classes="details-header" Margin="22,20,124,0">
        <local:OutlinedTextBlock Text="{Binding Name}" Classes="object-name title" />
        <local:OutlinedTextBlock Text="{Binding CategoryText}" Classes="label details-category" />
      </StackPanel>

      <Panel Grid.Row="0"
             Grid.RowSpan="2"
             Width="156"
             Height="156"
             Margin="0,-52,-44,0"
             HorizontalAlignment="Right"
             VerticalAlignment="Top">
        <local:GlowVisual Classes="details-icon-glow" />
        <local:SpriteVisual Classes="details-icon" SpriteKey="{Binding IconKey}" />
      </Panel>

      <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="22,14,124,0">
        <local:IconVisual Grid.Column="0" Classes="details-ornament" Moniker="OrnamentFinialSmall" />
        <TextBlock Grid.Column="1" Text="{Binding Description}" Classes="body details-flavor" />
      </Grid>

      <StackPanel Grid.Row="2" Margin="22,16,22,0">
        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8" IsVisible="{Binding Attack, Converter={x:Static ObjectConverters.IsNotNull}}">
          <local:OutlinedTextBlock Grid.Column="0"
                                   Classes="h1 primary-stat"
                                   Margin="0,0,14,0"
                                   Text="{Binding Attack.Amount}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding Attack.Amount, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <StackPanel Grid.Column="1" Classes="attack-line" VerticalAlignment="Center">
            <TextBlock Text="{Binding Attack.Attack.Text}" Classes="body attack-type" Foreground="{StaticResource PrimaryTextBrush}" />
            <TextBlock Text="(" Classes="caption attack-source open" />
            <local:IconVisual Classes="attack-source"
                              Moniker="{Binding Attack.Attack.Source.Icon}"
                              Foreground="{Binding Attack.Attack.Source.Color, Converter={x:Static local:ColorToBrushConverter.Instance}}" />
            <TextBlock Text="{Binding Attack.Attack.Source.Text}"
                       Classes="caption attack-source"
                       Foreground="{Binding Attack.Attack.Source.Color, Converter={x:Static local:ColorToBrushConverter.Instance}}" />
            <TextBlock Text=")" Classes="caption attack-source close" />
          </StackPanel>
        </Grid>

        <ItemsControl Classes="stat-table" ItemsSource="{Binding Stats}" />

        <Border Classes="stat-row"
                Background="{StaticResource StatRowStripeBrush}"
                IsVisible="{Binding SpellEffect, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Grid ColumnDefinitions="Auto,*">
            <ContentControl Grid.Column="0" Classes="stat-icon">
              <Rectangle Classes="details-bullet" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ContentControl>
            <TextBlock Grid.Column="1" Classes="body stat-label" Text="{Binding SpellEffect}" Foreground="{StaticResource ModalEffectBrush}" TextWrapping="Wrap" />
          </Grid>
        </Border>

        <Border Classes="stat-row" IsVisible="{Binding CastingCost, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Grid ColumnDefinitions="Auto,Auto,*">
            <ContentControl Grid.Column="0" Classes="stat-icon">
              <local:IconVisual Moniker="Spellbook" />
            </ContentControl>
            <TextBlock Grid.Column="1" Classes="body stat-label" Text="{local:Text 'Casting cost'}" />
            <ContentControl Grid.Column="2" Classes="body details-value" Content="{Binding CastingCost}" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </StackPanel>

      <ContentControl Grid.Row="3"
                      Classes="body details-value"
                      Content="{Binding Value}"
                      Margin="22,18,22,16"
                      HorizontalAlignment="Right" />

    </Grid>
  </local:ModalFrameDecorator>

</UserControl>
