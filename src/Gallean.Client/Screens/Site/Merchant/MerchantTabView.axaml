<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Gallean.Client"
             x:Class="Gallean.Client.MerchantTabView"
             x:DataType="local:MerchantTabViewModel">

  <UserControl.Styles>
    <Style Selector="ContentControl.merchant-trade-price">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource DropZoneTextBrush}" />
      <Setter Property="FontFamily" Value="{StaticResource FontFamilySans}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeLg}" />
    </Style>
    <Style Selector="Border.drop-target.drag-over ContentControl.merchant-trade-price">
      <Setter Property="Foreground" Value="{StaticResource DropZoneHoverTextBrush}" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <DataTemplate x:DataType="local:MerchantTradeDropViewModel">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Classes="drop-zone-label" Text="{Binding Label}" />
        <ContentControl Classes="merchant-trade-price" Content="{Binding Price}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <UserControl.Resources>
    <DataTemplate x:Key="MerchantPurchaseItemTemplate" x:DataType="local:MerchantPurchaseItemViewModel">
      <Button Classes="row"
              Classes.selected="{Binding IsSelected}"
              Classes.unavailable="{Binding !Status.IsAvailable}"
              Command="{Binding SelectCommand}">
        <Grid ColumnDefinitions="64,*">
          <Border Grid.Column="0" Classes="frame" Width="64" Height="64" BorderThickness="2">
            <local:SpriteVisual SpriteKey="{Binding IconKey}" Stretch="Uniform" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
            <local:OutlinedTextBlock Text="{Binding Name}" Classes="object-name row" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Description}"
                       Classes="caption"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       TextWrapping="Wrap" />
            <TextBlock local:TextRuns.Spans="{Binding CountText}"
                       Classes="caption"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <ContentControl Content="{Binding Status}" Classes="caption" Foreground="{StaticResource PrimaryTextBrush}" />
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>

    <DataTemplate x:Key="MerchantSellItemTemplate" x:DataType="local:MerchantSellItemViewModel">
      <Button Classes="socket inventory-slot" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}">
        <local:SpriteVisual SpriteKey="{Binding IconKey}" Stretch="Uniform">
          <ToolTip.Tip>
            <StackPanel Spacing="4">
              <local:OutlinedTextBlock Text="{Binding Name}" Classes="object-name row" />
              <TextBlock Text="{Binding Description}" />
              <ContentControl Content="{Binding Value}" />
            </StackPanel>
          </ToolTip.Tip>
        </local:SpriteVisual>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Background="Transparent">
    <Grid ColumnDefinitions="*,24,*" MaxWidth="960" MaxHeight="720" Margin="18">

      <ContentControl Grid.Column="0" Classes="ornament-panel" Classes.highlighted="{Binding BuyZone.IsVisible}">
        <Grid RowDefinitions="40,*" Margin="6,2">
          <local:OutlinedTextBlock Grid.Row="0" Text="{local:Text 'Your goods'}" Classes="panel-title" />
          <ScrollViewer Grid.Row="1" Classes="list" VerticalScrollBarVisibility="Auto">
            <ItemsControl Classes="focus-group" ItemsSource="{Binding SellItems}" ItemTemplate="{StaticResource MerchantSellItemTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <local:Blankslate.Content>
                <TextBlock Text="{local:Text 'You have no items to sell.'}"
                           Classes="body"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           Margin="4,8" />
              </local:Blankslate.Content>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </ContentControl>

      <ContentControl Grid.Column="0" Content="{Binding BuyZone}" ContentTemplate="{StaticResource DropTargetTemplate}" />

      <ContentControl Grid.Column="2" Classes="ornament-panel" Classes.highlighted="{Binding SellZone.IsVisible}">
        <Grid RowDefinitions="40,*" Margin="6,2">
          <local:OutlinedTextBlock Grid.Row="0" Text="{Binding SiteTitle}" Classes="panel-title" />
          <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto">
            <TextBlock Grid.Row="0" Classes="body site-greeting" Text="{Binding SiteGreeting}" />

            <ScrollViewer Classes="list" Grid.Row="1">
              <ItemsControl Classes="focus-group" ItemsSource="{Binding PurchaseItems}" ItemTemplate="{StaticResource MerchantPurchaseItemTemplate}">
                <local:Blankslate.Content>
                  <TextBlock Text="{local:Text 'The merchant has no items left to sell.'}"
                             Classes="body"
                             Foreground="{StaticResource SecondaryTextBrush}"
                             TextWrapping="Wrap"
                             TextAlignment="Center"
                             Margin="12,24" />
                </local:Blankslate.Content>
              </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" Classes="site-offer">
              <Panel>
                <ContentControl Content="{Binding Offer}" ContentTemplate="{StaticResource SiteOfferTemplate}" />
                <TextBlock Classes="body site-offer-hint"
                           Text="{Binding OfferHint}"
                           IsVisible="{Binding Offer, Converter={x:Static ObjectConverters.IsNull}}" />
              </Panel>
            </Border>
          </Grid>
        </Grid>
      </ContentControl>

      <ContentControl Grid.Column="2" Content="{Binding SellZone}" ContentTemplate="{StaticResource DropTargetTemplate}" />

    </Grid>

    <Canvas x:Name="DragLayer" IsHitTestVisible="False">
      <ContentControl x:Name="DragImage" Classes="drag-image" IsVisible="False" />
    </Canvas>
  </Grid>

</UserControl>
