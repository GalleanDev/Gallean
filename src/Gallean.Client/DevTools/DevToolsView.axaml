<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Gallean.Client"
             x:Class="Gallean.Client.DevToolsView"
             x:DataType="local:DevToolsViewModel"
             IsVisible="{Binding IsActive}">

  <UserControl.Styles>
    <Style Selector="CheckBox">
      <Setter Property="Focusable" Value="False" />
    </Style>
  </UserControl.Styles>

  <Border x:Name="Frame"
          Background="{StaticResource HudPanelBrush}"
          BorderBrush="{StaticResource HudPlateBorderBrush}"
          BorderThickness="{StaticResource BorderThicknessSm}"
          CornerRadius="{StaticResource RadiusMd}"
          Padding="14,10,14,14"
          Margin="12,72,0,0"
          HorizontalAlignment="Left"
          VerticalAlignment="Top">
    <StackPanel Spacing="12">
      <local:DiagnosticsVisual />

      <Border Height="1" Background="{StaticResource DividerBrush}">
        <Border.OpacityMask>
          <LinearGradientBrush StartPoint="0,0" EndPoint="7,0" SpreadMethod="Repeat">
            <GradientStop Offset="0.0" Color="Black" />
            <GradientStop Offset="0.5714" Color="Black" />
            <GradientStop Offset="0.5714" Color="Transparent" />
            <GradientStop Offset="1.0" Color="Transparent" />
          </LinearGradientBrush>
        </Border.OpacityMask>
      </Border>

      <StackPanel x:Name="Switches" Spacing="10">
        <CheckBox IsChecked="{Binding IsHitboxOverlayEnabled}">
          <TextBlock Text="{local:Text 'Hitbox overlay'}" Classes="body" Foreground="{StaticResource DevToolsLabelBrush}" />
        </CheckBox>

        <CheckBox IsChecked="{Binding IsLightOverlayEnabled}">
          <TextBlock Text="{local:Text 'Light overlay'}" Classes="body" Foreground="{StaticResource DevToolsLabelBrush}" />
        </CheckBox>

        <CheckBox IsChecked="{Binding IsFogEnabled}">
          <TextBlock Text="{local:Text 'Map fog'}" Classes="body" Foreground="{StaticResource DevToolsLabelBrush}" />
        </CheckBox>
      </StackPanel>
    </StackPanel>
  </Border>

</UserControl>
