<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Double x:Key="SpacingXs">4</x:Double>
  <x:Double x:Key="SpacingSm">8</x:Double>
  <x:Double x:Key="SpacingMd">12</x:Double>
  <x:Double x:Key="SpacingLg">16</x:Double>
  <x:Double x:Key="SpacingXl">24</x:Double>

  <CornerRadius x:Key="RadiusSm">2</CornerRadius>
  <CornerRadius x:Key="RadiusMd">4</CornerRadius>
  <CornerRadius x:Key="RadiusLg">6</CornerRadius>
  <CornerRadius x:Key="RadiusXl">10</CornerRadius>
  <CornerRadius x:Key="RadiusPanel">8</CornerRadius>

  <Thickness x:Key="BorderThicknessSm">1</Thickness>
  <Thickness x:Key="BorderThicknessMd">2</Thickness>
  <Thickness x:Key="BorderThicknessLg">4</Thickness>
</ResourceDictionary>
