  <SolidColorBrush x:Key="HudHotkeyPillBorderBrush" Color="{x:Static local:Theme+Hud.HotkeyPillBorderColor}" />
  <SolidColorBrush x:Key="HudPlateShadowBrush" Color="{x:Static local:Theme+Hud.PlateShadowColor}" />
  <SolidColorBrush x:Key="DevToolsLabelBrush" Color="{x:Static local:Theme+DevTools.LabelColor}" />

  <SolidColorBrush x:Key="AlertDetailsBrush" Color="{x:Static local:Theme+Alert.DetailsColor}" />

  <SolidColorBrush x:Key="AssetPackErrorGlowBrush" Color="{x:Static local:Theme+AssetPackError.GlowColor}" />
  <SolidColorBrush x:Key="AssetPackErrorLocationBrush" Color="{x:Static local:Theme+AssetPackError.LocationColor}" />
  <SolidColorBrush x:Key="AssetPackErrorStepTitleBrush" Color="{x:Static local:Theme+AssetPackError.StepTitleColor}" />

  <SolidColorBrush x:Key="ModalIconInfoInkBrush" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="ModalIconErrorInkBrush" Color="{x:Static local:Theme+ModalIcon.ErrorInkColor}" />
  <SolidColorBrush x:Key="ModalIconErrorRingLightBrush" Color="{x:Static local:Theme+ModalIcon.ErrorRingLightColor}" />
  <SolidColorBrush x:Key="ModalIconErrorRingDarkBrush" Color="{x:Static local:Theme+ModalIcon.ErrorRingDarkColor}" />
  <SolidColorBrush x:Key="ModalIconInkShadowBrush" Color="{x:Static local:Theme+ModalIcon.InkShadowColor}" />
