  <LinearGradientBrush x:Key="PermanentModifierFaceGradientBrush" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="{x:Static local:Theme+PermanentModifier.FaceTopColor}" />
    <GradientStop Offset="1" Color="{x:Static local:Theme+PermanentModifier.FaceBottomColor}" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PermanentModifierBorderGradientBrush" StartPoint="50%,0%" EndPoint="50%,100%" Opacity="0.75">
    <GradientStop Offset="0" Color="{DynamicResource AccentSecondaryColor}" />
    <GradientStop Offset="1" Color="{DynamicResource AccentSecondaryDarkColor}" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="UnitDetailsPrimaryStatBrush" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="UnitDetailsWarningBrush" Color="{x:Static local:Theme+OfferStatus.ReasonColor}" />

  <SolidColorBrush x:Key="MainMenuBackdropBrush" Color="{x:Static local:Theme+MainMenu.BackdropColor}" />
