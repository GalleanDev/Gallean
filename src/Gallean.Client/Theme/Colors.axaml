  <SolidColorBrush x:Key="GameMenuOverlayBrush" Color="{x:Static local:Theme+GameMenu.OverlayColor}" />
  <SolidColorBrush x:Key="GameMenuVignetteBrush" Color="{x:Static local:Theme+GameMenu.VignetteColor}" />
  <SolidColorBrush x:Key="GameMenuVignetteFadeBrush" Color="{x:Static local:Theme+GameMenu.VignetteFadeColor}" />
  <SolidColorBrush x:Key="LogoAmbientBrush" Color="{x:Static local:Theme+Logo.AmbientColor}" />
  <SolidColorBrush x:Key="LogoGrazingBrush" Color="{x:Static local:Theme+Logo.GrazingColor}" />
  <SolidColorBrush x:Key="LogoMoonBrush" Color="{x:Static local:Theme+Logo.MoonColor}" />
  <SolidColorBrush x:Key="LogoShineBrush" Color="{x:Static local:Theme+Logo.ShineColor}" />
  <SolidColorBrush x:Key="LogoShadowBrush" Color="{x:Static local:Theme+Logo.ShadowColor}" />

  <SolidColorBrush x:Key="ScenarioSelectBackdropBrush" Color="{x:Static local:Theme+ScenarioSelect.BackdropColor}" />
  <SolidColorBrush x:Key="ScenarioSelectDividerBrush" Color="{DynamicResource AccentColor}" Opacity="0.37" />
  <SolidColorBrush x:Key="ScenarioSelectRowHoverBrush" Color="{DynamicResource AccentColor}" Opacity="0.11" />
  <SolidColorBrush x:Key="ScenarioSelectRowSelectedBrush" Color="{DynamicResource AccentColor}" Opacity="0.22" />
  <SolidColorBrush x:Key="ScenarioSelectRowFadeBrush" Color="{DynamicResource AccentFadeColor}" />
  <LinearGradientBrush x:Key="ScenarioSelectRowHoverGradientBrush" StartPoint="0%,0%" EndPoint="100%,0%" Opacity="0.11">
    <GradientStop Offset="0" Color="{DynamicResource AccentColor}" />
    <GradientStop Offset="1" Color="{DynamicResource AccentFadeColor}" />
  </LinearGradientBrush>
