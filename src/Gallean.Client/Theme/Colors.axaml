    <GradientStop Offset="0" Color="{DynamicResource AccentSecondaryColor}" />
    <GradientStop Offset="1" Color="{DynamicResource AccentSecondaryDarkColor}" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ModalIconErrorRingGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Offset="0" Color="{x:Static local:Theme+ModalIcon.ErrorRingLightColor}" />
    <GradientStop Offset="1" Color="{x:Static local:Theme+ModalIcon.ErrorRingDarkColor}" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ModalIconGradientBrush" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="{x:Static local:Theme+Modal.BodyBottomColor}" />
    <GradientStop Offset="1" Color="{x:Static local:Theme+Modal.BodyTopColor}" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="ArtworkOverlayBrush" Color="{x:Static local:Theme+Artwork.OverlayColor}" />
  <SolidColorBrush x:Key="ArtworkOverlayFadeBrush" Color="{x:Static local:Theme+Artwork.OverlayFadeColor}" />
