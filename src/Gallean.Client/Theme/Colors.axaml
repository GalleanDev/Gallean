    <GradientStop Offset="0" Color="{DynamicResource AccentColor}" />
    <GradientStop Offset="1" Color="{DynamicResource AccentFadeColor}" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ScenarioSelectAccentBrush" Color="{DynamicResource AccentColor}" />

