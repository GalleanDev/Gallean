  <SolidColorBrush x:Key="AttackSourceDeathBrush" Color="{x:Static local:Theme+AttackSource.DeathColor}" />
  <SolidColorBrush x:Key="AttackSourceFireBrush" Color="{x:Static local:Theme+AttackSource.FireColor}" />
  <SolidColorBrush x:Key="AttackSourceWaterBrush" Color="{x:Static local:Theme+AttackSource.WaterColor}" />
  <SolidColorBrush x:Key="AttackSourceEarthBrush" Color="{x:Static local:Theme+AttackSource.EarthColor}" />
  <SolidColorBrush x:Key="AttackSourceAirBrush" Color="{x:Static local:Theme+AttackSource.AirColor}" />
