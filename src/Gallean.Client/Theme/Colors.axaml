  <SolidColorBrush x:Key="LeaderUpgradeSmokeBrush" Color="{x:Static local:Theme+LeaderUpgrade.SmokeColor}" />

  <SolidColorBrush x:Key="BriefingEmberBrush" Color="{x:Static local:Theme+Briefing.EmberColor}" />
