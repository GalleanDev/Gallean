    <GradientStop Offset="0" Color="{DynamicResource AccentColor}" />
    <GradientStop Offset="1" Color="{DynamicResource AccentFadeColor}" />
  </LinearGradientBrush>
  <RadialGradientBrush x:Key="BriefingBackdropGradientBrush" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
    <GradientStop Offset="0" Color="{x:Static local:Theme+Briefing.BackdropColor}" />
    <GradientStop Offset="1" Color="{x:Static local:Theme+Briefing.BackdropFadeColor}" />
  </RadialGradientBrush>

  <SolidColorBrush x:Key="TabBarBackgroundBrush" Color="{x:Static local:Theme+TabBar.BackgroundColor}" />
