<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Gallean.Client">
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{x:Static local:Theme+Common.WindowBackgroundColor}" />
  <SolidColorBrush x:Key="WindowTranslucentBackgroundBrush" Color="{x:Static local:Theme+Common.WindowTranslucentBackgroundColor}" />
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="{x:Static local:Theme+Common.PrimaryTextColor}" />
  <SolidColorBrush x:Key="HighlightTextBrush" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="{x:Static local:Theme+Common.SecondaryTextColor}" />
  <SolidColorBrush x:Key="LabelTextBrush" Color="{DynamicResource AccentDarkColor}" />
  <SolidColorBrush x:Key="TextOutlineBrush" Color="{x:Static local:Theme+Common.TextOutlineColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="AccentLightBrush" Color="{DynamicResource AccentLightColor}" />
  <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{DynamicResource AccentSecondaryColor}" />
  <SolidColorBrush x:Key="ModalBackdropBrush" Color="{x:Static local:Theme+Common.ModalBackdropColor}" />
  <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{x:Static local:Theme+Common.PopupBackgroundColor}" />
  <SolidColorBrush x:Key="DividerBrush" Color="{x:Static local:Theme+Common.DividerColor}" />
  <SolidColorBrush x:Key="FocusRingBrush" Color="{DynamicResource AccentColor}" Opacity="0.86" />

  <SolidColorBrush x:Key="ModalBodyTopBrush" Color="{x:Static local:Theme+Modal.BodyTopColor}" />
  <SolidColorBrush x:Key="ModalBodyBottomBrush" Color="{x:Static local:Theme+Modal.BodyBottomColor}" />
  <SolidColorBrush x:Key="ModalAccentBodyBottomBrush" Color="{x:Static local:Theme+Modal.AccentBodyBottomColor}" />
  <SolidColorBrush x:Key="ModalBorderLightBrush" Color="{DynamicResource AccentSecondaryColor}" />
  <SolidColorBrush x:Key="ModalBorderDarkBrush" Color="{DynamicResource AccentSecondaryDarkColor}" />
  <SolidColorBrush x:Key="ModalBorderOutlineBrush" Color="{x:Static local:Theme+Modal.BorderOutlineColor}" />
  <SolidColorBrush x:Key="ModalPortraitFrameBrush" Color="{x:Static local:Theme+Modal.PortraitFrameColor}" />
  <SolidColorBrush x:Key="ModalOrnamentBrush" Color="{DynamicResource AccentColor}" Opacity="0.59" />
  <SolidColorBrush x:Key="ModalTitleBrush" Color="{x:Static local:Theme+Modal.TitleColor}" />
  <SolidColorBrush x:Key="ModalEffectBrush" Color="{x:Static local:Theme+Modal.EffectColor}" />
  <SolidColorBrush x:Key="ModalIconGlowBrush" Color="{DynamicResource AccentColor}" Opacity="0.22" />
  <SolidColorBrush x:Key="ModalRuleBrush" Color="{DynamicResource AccentSecondaryColor}" Opacity="0.67" />
  <SolidColorBrush x:Key="ModalRuleFadeBrush" Color="{DynamicResource AccentSecondaryFadeColor}" />
  <LinearGradientBrush x:Key="ModalRuleGradientBrush" StartPoint="0%,50%" EndPoint="100%,50%" Opacity="0.67">
    <GradientStop Offset="0" Color="{DynamicResource AccentSecondaryFadeColor}" />
    <GradientStop Offset="0.2" Color="{DynamicResource AccentSecondaryColor}" />
    <GradientStop Offset="0.8" Color="{DynamicResource AccentSecondaryColor}" />
    <GradientStop Offset="1" Color="{DynamicResource AccentSecondaryFadeColor}" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ModalBorderGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Offset="0" Color="{DynamicResource AccentSecondaryColor}" />
    <GradientStop Offset="1" Color="{DynamicResource AccentSecondaryDarkColor}" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="HeadingLitBrush" Color="{DynamicResource AccentDarkColor}" Opacity="0.18" />
  <SolidColorBrush x:Key="HeadingMiddleBrush" Color="{DynamicResource AccentDarkColor}" Opacity="0.09" />
  <SolidColorBrush x:Key="HeadingFadeBrush" Color="{DynamicResource AccentDarkFadeColor}" />
  <LinearGradientBrush x:Key="HeadingGradientBrush" StartPoint="0%,50%" EndPoint="100%,50%" Opacity="0.18">
    <GradientStop Offset="0" Color="{DynamicResource AccentDarkColor}" />
    <GradientStop Offset="1" Color="{DynamicResource AccentDarkFadeColor}" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="TextBoxSelectionBrush" Color="{DynamicResource AccentColor}" Opacity="0.43" />
  <SolidColorBrush x:Key="PagerBandBrush" Color="{x:Static local:Theme+Pager.BandColor}" />
  <SolidColorBrush x:Key="PagerBorderBrush" Color="{DynamicResource AccentSecondaryColor}" Opacity="0.67" />
  <LinearGradientBrush x:Key="ModalBodyGradientBrush" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="{x:Static local:Theme+Modal.BodyTopColor}" />
    <GradientStop Offset="1" Color="{x:Static local:Theme+Modal.BodyBottomColor}" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ModalAccentBodyGradientBrush" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="{x:Static local:Theme+Modal.BodyTopColor}" />
    <GradientStop Offset="1" Color="{x:Static local:Theme+Modal.AccentBodyBottomColor}" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="ScenarioDialogBandBrush" Color="{x:Static local:Theme+ScenarioDialog.BandColor}" />
  <SolidColorBrush x:Key="ScenarioDialogBandFadeBrush" Color="{x:Static local:Theme+ScenarioDialog.BandFadeColor}" />
  <SolidColorBrush x:Key="ScenarioDialogRuleBrush" Color="{DynamicResource AccentDarkColor}" />
  <SolidColorBrush x:Key="ScenarioDialogRuleFadeBrush" Color="{DynamicResource AccentDarkFadeColor}" />
  <SolidColorBrush x:Key="ScenarioDialogOrnamentBrush" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="ScenarioDialogOrnamentGlowBrush" Color="{x:Static local:Theme+ScenarioDialog.OrnamentGlowColor}" />
  <SolidColorBrush x:Key="ScenarioDialogDividerBrush" Color="{DynamicResource AccentDarkColor}" Opacity="0.67" />
  <SolidColorBrush x:Key="ScenarioDialogDividerFadeBrush" Color="{DynamicResource AccentDarkFadeColor}" />
  <SolidColorBrush x:Key="ScenarioDialogSpeakerBrush" Color="{x:Static local:Theme+ScenarioDialog.SpeakerColor}" />
  <SolidColorBrush x:Key="ScenarioDialogTextBrush" Color="{x:Static local:Theme+ScenarioDialog.TextColor}" />
  <SolidColorBrush x:Key="ScenarioDialogHistorySpeakerBrush" Color="{x:Static local:Theme+ScenarioDialog.HistorySpeakerColor}" />
  <SolidColorBrush x:Key="ScenarioDialogHistoryTextBrush" Color="{x:Static local:Theme+ScenarioDialog.HistoryTextColor}" />
  <SolidColorBrush x:Key="ScenarioDialogHistoryCharacterBrush" Color="{x:Static local:Theme+ScenarioDialog.HistoryCharacterColor}" />
  <SolidColorBrush x:Key="ScenarioDialogHistoryObjectBrush" Color="{x:Static local:Theme+ScenarioDialog.HistoryObjectColor}" />
  <SolidColorBrush x:Key="ScenarioDialogSmokeBrush" Color="{x:Static local:Theme+ScenarioDialog.SmokeColor}" />
  <SolidColorBrush x:Key="ScenarioTextCharacterBrush" Color="{x:Static local:Theme+ScenarioText.CharacterColor}" />
  <SolidColorBrush x:Key="ScenarioTextObjectBrush" Color="{x:Static local:Theme+ScenarioText.ObjectColor}" />
  <LinearGradientBrush x:Key="ScenarioDialogBandGradientBrush" StartPoint="0%,50%" EndPoint="100%,50%">
    <GradientStop Offset="0" Color="{x:Static local:Theme+ScenarioDialog.BandFadeColor}" />
    <GradientStop Offset="0.14" Color="{x:Static local:Theme+ScenarioDialog.BandColor}" />
    <GradientStop Offset="0.86" Color="{x:Static local:Theme+ScenarioDialog.BandColor}" />
    <GradientStop Offset="1" Color="{x:Static local:Theme+ScenarioDialog.BandFadeColor}" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ScenarioDialogRuleGradientBrush" StartPoint="0%,50%" EndPoint="100%,50%">
    <GradientStop Offset="0" Color="{DynamicResource AccentDarkFadeColor}" />
    <GradientStop Offset="0.2" Color="{DynamicResource AccentDarkColor}" />
    <GradientStop Offset="0.8" Color="{DynamicResource AccentDarkColor}" />
    <GradientStop Offset="1" Color="{DynamicResource AccentDarkFadeColor}" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ScenarioDialogDividerGradientBrush" StartPoint="0%,50%" EndPoint="100%,50%" Opacity="0.67">
    <GradientStop Offset="0" Color="{DynamicResource AccentDarkFadeColor}" />
    <GradientStop Offset="0.25" Color="{DynamicResource AccentDarkColor}" />
    <GradientStop Offset="0.75" Color="{DynamicResource AccentDarkColor}" />
    <GradientStop Offset="1" Color="{DynamicResource AccentDarkFadeColor}" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="LoadingBackdropBrush" Color="{x:Static local:Theme+Loading.BackdropColor}" />

  <SolidColorBrush x:Key="HudPlateBrush" Color="{x:Static local:Theme+Hud.PlateColor}" />
  <SolidColorBrush x:Key="HudPlateBorderBrush" Color="{x:Static local:Theme+Hud.PlateBorderColor}" />
  <SolidColorBrush x:Key="HudPanelBrush" Color="{x:Static local:Theme+Hud.PanelColor}" />
  <SolidColorBrush x:Key="HudInkBrush" Color="{x:Static local:Theme+Hud.InkColor}" />
  <SolidColorBrush x:Key="HudHoverInkBrush" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="HudDisabledInkBrush" Color="{x:Static local:Theme+Hud.DisabledInkColor}" />
  <SolidColorBrush x:Key="HudHotkeyTextBrush" Color="{x:Static local:Theme+Hud.HotkeyTextColor}" />
