  <SolidColorBrush x:Key="TabBarSelectedCellBottomBrush" Color="{x:Static local:Theme+TabBar.SelectedCellBottomColor}" />
  <SolidColorBrush x:Key="TabBarSelectedCellBorderBrush" Color="{x:Static local:Theme+TabBar.SelectedCellBorderColor}" />
  <SolidColorBrush x:Key="TabBarSelectedCellBorderShadowBrush" Color="{x:Static local:Theme+TabBar.SelectedCellBorderShadowColor}" />
  <SolidColorBrush x:Key="TabBarUnderlineBrush" Color="{x:Static local:Theme+TabBar.UnderlineColor}" />
  <SolidColorBrush x:Key="TabBarUnderlineGlowBrush" Color="{x:Static local:Theme+TabBar.UnderlineGlowColor}" />
  <SolidColorBrush x:Key="TabBarRuleBrush" Color="{x:Static local:Theme+TabBar.RuleColor}" />
  <SolidColorBrush x:Key="TabBarRuleDarkBrush" Color="{x:Static local:Theme+TabBar.RuleDarkColor}" />
