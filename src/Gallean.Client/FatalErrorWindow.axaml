<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Gallean.Client"
        x:Class="Gallean.Client.FatalErrorWindow"
        Title="{local:Text 'Gallean'}"
        Width="720"
        Height="320"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">

  <StackPanel Margin="32" Spacing="16">
    <local:OutlinedTextBlock x:Name="TitleText" Classes="h2" Foreground="{StaticResource PrimaryTextBrush}" />
    <TextBlock x:Name="MessageText" Classes="body" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
    <TextBlock x:Name="LogLocationText" Classes="body" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
    <Button Content="{local:Text 'Exit'}" Classes="pill" Click="OnExitClick" Width="220" HorizontalAlignment="Center" />
  </StackPanel>

</Window>
